d/latest/cleveland_oh/0-0-0-6305', hash: '#JD_185.13' }}">185.13</Link>&#160;&#160;&#160;Time of Award</div></div><div class="clearfix"></div><div id="rid-0-0-0-6203" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-6203"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-6308', hash: '#JD_185.14' }}">185.14</Link>&#160;&#160;&#160;Performance Bond</div></div><div class="clearfix"></div><div id="rid-0-0-0-6204" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-6204"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-6325', hash: '#JD_185.15' }}">185.15</Link>&#160;&#160;&#160;Release of Bond</div></div><div class="clearfix"></div><div id="rid-0-0-0-6205" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-6205"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-6328', hash: '#JD_185.16' }}">185.16</Link>&#160;&#160;&#160;Requirements for Contract Execution</div></div><div class="clearfix"></div><div id="rid-0-0-0-6206" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-6206"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-6331', hash: '#JD_185.17' }}">185.17</Link>&#160;&#160;&#160;Filing of Original Contract</div></div><div class="clearfix"></div><div id="rid-0-0-0-6207" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-6207"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-6334', hash: '#JD_185.18' }}">185.18</Link>&#160;&#160;&#160;General Conditions of Public Improvement Contracts</div></div><div class="clearfix"></div><div id="rid-0-0-0-6208" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-6208"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ path