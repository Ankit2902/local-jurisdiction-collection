lid #000000;border-left:0pt solid #000000;border-right:0pt solid #000000;padding-left:0.03in;border-left:1pt solid #000000;padding-top:0.03in;border-top:1pt solid #000000;padding-right:0.03in;border-right:1pt solid #000000;padding-bottom:0.03in;border-bottom:1pt solid #000000;"><div><div style="text-align:right;"><span style="font-weight: normal;font-style: normal;text-decoration:none;display: inline;">$15.00</span></div></div></td></tr><tr><td style="word-wrap:break-word;padding-left:.075in;padding-right:.075in;padding-top:.022in;padding-bottom:.022in;border-top:0pt solid #000000;border-bottom:0pt solid #000000;border-left:0pt solid #000000;border-right:0pt solid #000000;padding-left:0.03in;border-left:1pt solid #000000;padding-top:0.03in;border-top:1pt solid #000000;padding-right:0.03in;border-right:1pt solid #000000;padding-bottom:0.03in;border-bottom:1pt solid #000000;"><div><span style="font-weight: normal;font-style: normal;text-decoration:none;display: inline;">Overweight superload surcharge (over 120,000 lb.)</span></div></td><td style="word-wrap:break-word;padding-left:.075in;padding-right:.075in;padding-top:.022in;padding-bottom:.022in;border-top:0pt solid #000000;border-bottom:0pt solid #000000;border-left:0pt solid #000000;border-right:0pt solid #000000;padding-left:0.03in;border-left:1pt solid #000000;padding-top:0.03in;border-top:1pt solid #000000;padding-right:0.03in;border-right:1pt solid #000000;padding-bottom:0.03in;border-bottom:1pt solid #000000;"><div><div style="text-align:right;"><span style="font-weight: normal;font-style: normal;text-decoration:none;display: inline;">$30.00</span></div></div></td></tr><tr><td style="word-wrap:break-word;padding-left:.075in;padding-right:.075in;padding-top:.022in;padding-bottom:.022in;border-top:0pt solid #000000;border-bottom:0pt solid #000000;border-left:0pt solid #000000;border-right:0pt solid #000000;padding-left:0.03in;border-left:1pt solid #000000;padding-top:0.03in;border-top:1pt solid #000000;padding-