t solid #000000;border-left:1pt solid #000000;border-right:1pt solid #000000;"><div><div style="text-align:center;"><span style="font-weight: normal;font-style: normal;text-decoration:none;display: inline;">$8.35</span></div></div></td><td style="word-wrap:break-word;padding-left:.075in;padding-right:.075in;padding-top:.022in;padding-bottom:.022in;border-top:1pt solid #000000;border-bottom:1pt solid #000000;border-left:1pt solid #000000;border-right:1pt solid #000000;"><div><div style="text-align:center;"><span style="font-weight: normal;font-style: normal;text-decoration:none;display: inline;">$9.13</span></div></div></td></tr><tr><td style="word-wrap:break-word;padding-left:.075in;padding-right:.075in;padding-top:.022in;padding-bottom:.022in;border-top:1pt solid #000000;border-bottom:1pt solid #000000;border-left:1pt solid #000000;border-right:1pt solid #000000;"><div><div style="text-align:center;">All over 50</div></div></td><td style="word-wrap:break-word;padding-left:.075in;padding-right:.075in;padding-top:.022in;padding-bottom:.022in;border-top:1pt solid #000000;border-bottom:1pt solid #000000;border-left:1pt solid #000000;border-right:1pt solid #000000;"><div><div style="text-align:center;"><span style="font-weight: normal;font-style: normal;text-decoration:none;display: inline;">$6.92</span></div></div></td><td style="word-wrap:break-word;padding-left:.075in;padding-right:.075in;padding-top:.022in;padding-bottom:.022in;border-top:1pt solid #000000;border-bottom:1pt solid #000000;border-left:1pt solid #000000;border-right:1pt solid #000000;"><div><div style="text-align:center;"><span style="font-weight: normal;font-style: normal;text-decoration:none;display: inline;">$7.94</span></div></div></td><td style="word-wrap:break-word;padding-left:.075in;padding-right:.075in;padding-top:.022in;padding-bottom:.022in;border-top:1pt solid #000000;border-bottom:1pt solid #000000;border-left:1pt solid #000000;border-right:1pt solid #000000;"><div><div style="text-align:c