cleveland/latest/cleveland_oh/0-0-0-6885', hash: '#JD_Chapter187A' }}">187A</Link>&#160;&#160;&#160;Local Producer, Local-Food Purchaser, and Sustainable Business Preference Code</div></div><div class="clearfix"></div><div id="rid-0-0-0-1175" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1175"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-6970', hash: '#JD_Chapter188' }}">188</Link>&#160;&#160;&#160;Fannie M. Lewis Cleveland Resident Employment Law</div></div><div class="clearfix"></div><div id="rid-0-0-0-1176" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1176"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-7043', hash: '#JD_Chapter189' }}">189</Link>&#160;&#160;&#160;Cleveland Fair Employment Law</div></div><div class="clearfix"></div><div id="rid-0-0-0-50332" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-50332"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-50334', hash: '#JD_Chapter190' }}">190</Link>&#160;&#160;&#160;Wage Theft and Payroll Fraud Prevention</div></div><div class="clearfix"></div><div id="rid-0-0-0-50436" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-50436"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-50438', hash: '#JD_Chapter190A' }}">190A</Link>&#160;&#160;&#160;Community Benefits Agreements</div></div><div class="clearfix"></div><div id="rid-0-0-0-1177" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1177"></AnnotationDrawer><div class="ChapAn-center"><span style="font-weight: bold;font-style: normal;text-decoration:none;display: inline;">Title XVII:  Taxation</span></div></div><div class="clearfix"></div><div id="rid-0-0-0-1178" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1178"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-7222', hash: '#JD_Chapter191' }}">191</Link>&#160;&#160;&#160;Municipal Income Tax</div></div><div class="clearfix"></div><div id="rid-0-0-0-42423" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42423"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-42427', hash: '#JD_Chapter192' }}">192</Link>&#160;&#160;&#160;2016 Municipal Income Tax</div></div><div class="clearfix"></div><div id="rid-0-0-0-1179" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1179"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-7747', hash: '#JD_Chapter193' }}">193</Link>&#160;&#160;&#160;Transient Occupancy Tax</div></div><div class="clearfix"></div><div id="rid-0-0-0-1180" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1180"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-7834', hash: '#JD_Chapter195' }}">195</Link>&#160;&#160;&#160;Admissions Tax</div></div><div class="clearfix"></div><div id="rid-0-0-0-1181" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1181"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-8051', hash: '#JD_Chapter196' }}">196</Link>&#160;&#160;&#160;Parking Occupancy Tax</div></div><div class="clearfix"></div><div id="rid-0-0-0-1182" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1182"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-8300', hash: '#JD_Chapter197' }}">197</Link>&#160;&#160;&#160;Motor Vehicle License Tax</div></div><div class="clearfix"></div><div id="rid-0-0-0-1183" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1183"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-8321', hash: '#JD_Chapter198' }}">198</Link>&#160;&#160;&#160;Motor Vehicle Lessor Tax</div></div><div class="clearfix"></div><div id="rid-0-0-0-1184" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1184"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-8409', hash: '#JD_Chapter199' }}">199</Link>&#160;&#160;&#160;Tax on Coin Operated Amusement Devices</div></div><div class="clearfix"></div></div>
<div><div id="rid-0-0-0-1185" class="rbox Title"><AnnotationDrawer recordId="0-0-0-1185"></AnnotationDrawer><h3>TITLE I:  GENERAL PROVISIONS</h3></div><div class="clearfix"></div><div id="rid-0-0-0-1186" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1186"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1193', hash: '#JD_Chapter101' }}">101</Link>&#160;&#160;&#160;Codified Ordinances</div></div><div class="clearfix"></div><div id="rid-0-0-0-1187" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1187"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1323', hash: '#JD_Chapter103' }}">103</Link>&#160;&#160;&#160;Boundaries and Wards</div></div><div class="clearfix"></div><div id="rid-0-0-0-1188" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1188"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1459', hash: '#JD_Chapter105' }}">105</Link>&#160;&#160;&#160;Official Standards</div></div><div class="clearfix"></div><div id="rid-0-0-0-1189" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1189"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-45822', hash: '#JD_Chapter106' }}">106</Link>&#160;&#160;&#160;Democracy Day</div></div><div class="clearfix"></div><div id="rid-0-0-0-45821" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-45821"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1545', hash: '#JD_Chapter107' }}">107</Link>&#160;&#160;&#160;Military Spending and Related Tax Revenues for Military Purposes</div></div><div class="clearfix"></div><div id="rid-0-0-0-1190" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1190"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1588', hash: '#JD_Chapter109' }}">109</Link>&#160;&#160;&#160;Domestic Partnership Registry</div></div><div class="clearfix"></div><div id="rid-0-0-0-1191" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1191"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1646', hash: '#JD_Chapter110' }}">110</Link>&#160;&#160;&#160;Campaign Finance Regulation</div></div><div class="clearfix"></div><div id="rid-0-0-0-1192" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1192"></AnnotationDrawer><div class="ChapAn">&#160;&#160;&#160;Chapter <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1696', hash: '#JD_Chapter110A' }}">110A</Link>&#160;&#160;&#160;Circulation of Initiative or Referendum Petition Regulation</div></div><div class="clearfix"></div></div>
<div><div id="rid-0-0-0-1193" class="rbox Chapter"><AnnotationDrawer recordId="0-0-0-1193"></AnnotationDrawer><h4><a name="JD_Chapter101" id="JD_Chapter101" title="Chapter 101"></a>CHAPTER 101 &#8211; CODIFIED ORDINANCES</h4></div><div class="clearfix"></div><div id="rid-0-0-0-1194" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1194"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1210', hash: '#JD_101.01' }}">101.01</Link>&#160;&#160;&#160;Designation; Citation; Headings</div></div><div class="clearfix"></div><div id="rid-0-0-0-1195" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1195"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1214', hash: '#JD_101.02' }}">101.02</Link>&#160;&#160;&#160;General Definitions</div></div><div class="clearfix"></div><div id="rid-0-0-0-49717" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-49717"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-49718', hash: '#JD_101.021' }}">101.021</Link>&#160;&#160;&#160;Open Public Meetings and Hearings</div></div><div class="clearfix"></div><div id="rid-0-0-0-1196" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1196"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1250', hash: '#JD_101.03' }}">101.03</Link>&#160;&#160;&#160;Rules of Construction</div></div><div class="clearfix"></div><div id="rid-0-0-0-1197" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1197"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1273', hash: '#JD_101.04' }}">101.04</Link>&#160;&#160;&#160;Revivor; Effect of Amendment or Repeal</div></div><div class="clearfix"></div><div id="rid-0-0-0-1198" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1198"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1285', hash: '#JD_101.05' }}">101.05</Link>&#160;&#160;&#160;Construction of Section References</div></div><div class="clearfix"></div><div id="rid-0-0-0-1199" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1199"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1293', hash: '#JD_101.06' }}">101.06</Link>&#160;&#160;&#160;Conflicting Provisions</div></div><div class="clearfix"></div><div id="rid-0-0-0-1200" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1200"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1301', hash: '#JD_101.07' }}">101.07</Link>&#160;&#160;&#160;Determination of Legislative Intent</div></div><div class="clearfix"></div><div id="rid-0-0-0-1201" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1201"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1318', hash: '#JD_101.08' }}">101.08</Link>&#160;&#160;&#160;Severability</div></div><div class="clearfix"></div><div id="rid-0-0-0-1202" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1202"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1321', hash: '#JD_101.99' }}">101.99</Link>&#160;&#160;&#160;General Penalty<br></br></div></div><div class="clearfix"></div><div id="rid-0-0-0-1203" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1203"></AnnotationDrawer><div class="paragraph-Note">&#160;&#160;&#160;Note: The legislative history of this chapter, except where specifically noted at the end of a section, is as follows: Ordinance No. 63410-A, passed September 22, 1924.<br></br></div></div><div class="clearfix"></div><div id="rid-0-0-0-1205" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1205"></AnnotationDrawer><div><span style="font-weight: bold;font-style: italic;text-decoration:none;display: inline;">Charter reference:<br></br></span><span style="font-weight: normal;font-style: italic;text-decoration:none;display: inline;">&#160;&#160;&#160;Codification in book form, Charter &#167; <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-246', hash: '#JD_Chtr.Sec.34' }}">34</Link></span></div></div><div class="clearfix"></div><div id="rid-0-0-0-1209" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1209"></AnnotationDrawer><div><span style="font-weight: bold;font-style: italic;text-decoration:none;display: inline;">Statutory reference:<br></br></span><span style="font-weight: normal;font-style: italic;text-decoration:none;display: inline;">&#160;&#160;&#160;See sectional histories for similar State law<br></br>&#160;&#160;&#160;Codification in book form, RC 731.23<br></br>&#160;&#160;&#160;Imprisonment until fine and costs are paid, RC 1905.30, 2947.20</span></div></div><div class="clearfix"></div></div>
<div><span depth="6"></span><CodeOptions destID="rid-0-0-0-1210" class="Section"></CodeOptions><div id="rid-0-0-0-1210" class="Section toc-destination rbox" style="margin-top: .5rem"><AnnotationDrawer recordId="0-0-0-1210"></AnnotationDrawer><h6><a name="JD_101.01" id="JD_101.01" title="101.01"></a>&#167; 101.01  Designation; Citation; Headings</h6></div><div class="clearfix"></div><div id="rid-0-0-0-1211" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1211"></AnnotationDrawer><div>&#160;&#160;&#160;(a)&#160;&#160;&#160;All ordinances of a permanent and general nature of the City of Cleveland as revised, codified, rearranged, renumbered and consolidated into component codes, titles, chapters and sections shall be known and designated as the Codified Ordinances of Cleveland, Ohio, 1976, for which designation &#8220;Codified Ordinances&#8221; may be substituted. Code, title, chapter and section headings do not constitute any part of the law as contained in the Codified Ordinances.</div></div><div class="clearfix"></div><div id="rid-0-0-0-1212" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1212"></AnnotationDrawer><div>(RC 1.01)</div></div><div class="clearfix"></div><div id="rid-0-0-0-1213" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1213"></AnnotationDrawer><div>&#160;&#160;&#160;(b)&#160;&#160;&#160;All references to codes, titles, chapters and sections are to such components of the Codified Ordinances unless otherwise specified. Any component code may be referred to and cited by its name, such as the &#8220;Administrative Code&#8221;. Sections may be referred to and cited by the designation &#8220;Section&#8221; followed by the number, such as &#8220;Section <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1210', hash: '#JD_101.01' }}">101.01</Link>&#8221;.</div></div><div class="clearfix"></div><div class="clearfix"></div></div>
<div><span depth="6"></span><CodeOptions destID="rid-0-0-0-1214" class="Section"></CodeOptions><div id="rid-0-0-0-1214" class="Section toc-destination rbox" style="margin-top: .5rem"><AnnotationDrawer recordId="0-0-0-1214"></AnnotationDrawer><h6><a name="JD_101.02" id="JD_101.02" title="101.02"></a>&#167; 101.02  General Definitions</h6></div><div class="clearfix"></div><div id="rid-0-0-0-1249" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1249"></AnnotationDrawer><div>&#160;&#160;&#160;As used in the Codified Ordinances, unless another definition is provided or the context otherwise requires:</div></div><div class="clearfix"></div><div id="rid-0-0-0-42211" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42211"></AnnotationDrawer><div>&#160;&#160;&#160;(a)&#160;&#160;&#160;"And" may be read "or", and "or" may be read "and", if the sense requires it.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42210" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42210"></AnnotationDrawer><div>(RC 1.02(F))</div></div><div class="clearfix"></div><div id="rid-0-0-0-42208" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42208"></AnnotationDrawer><div>&#160;&#160;&#160;(b)&#160;&#160;&#160;"Another" when used to designate the owner of property which is the subject of an offense, includes not only natural persons but also every other owner of property.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42209" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42209"></AnnotationDrawer><div>(RC 1.02(B))</div></div><div class="clearfix"></div><div id="rid-0-0-0-42206" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42206"></AnnotationDrawer><div>&#160;&#160;&#160;(c)&#160;&#160;&#160;"Bond" includes an undertaking and "undertaking" includes a bond.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42207" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42207"></AnnotationDrawer><div>(RC 1.02(D), (E))</div></div><div class="clearfix"></div><div id="rid-0-0-0-42205" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42205"></AnnotationDrawer><div>&#160;&#160;&#160;(d)&#160;&#160;&#160;"Council" means the legislative authority of the City of Cleveland.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42204" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42204"></AnnotationDrawer><div>&#160;&#160;&#160;(e)&#160;&#160;&#160;"County" means Cuyahoga County, Ohio.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42203" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42203"></AnnotationDrawer><div>&#160;&#160;&#160;(f)&#160;&#160;&#160;"Keeper" or "proprietor" includes all persons, whether acting by themselves or as a servant, agent or employee.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42202" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42202"></AnnotationDrawer><div>&#160;&#160;&#160;(g)&#160;&#160;&#160;"Land" or "real estate" includes rights and easements of an incorporeal nature.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42201" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42201"></AnnotationDrawer><div>(RC 701.01(E))</div></div><div class="clearfix"></div><div id="rid-0-0-0-42200" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42200"></AnnotationDrawer><div>&#160;&#160;&#160;(h)&#160;&#160;&#160;"Municipality" or "City" means the City of Cleveland, Ohio.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42199" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42199"></AnnotationDrawer><div>&#160;&#160;&#160;(i)&#160;&#160;&#160;"Oath" includes affirmation and "swear" includes affirm.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42212" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42212"></AnnotationDrawer><div>(RC 1.59(B))</div></div><div class="clearfix"></div><div id="rid-0-0-0-42198" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42198"></AnnotationDrawer><div>&#160;&#160;&#160;(j)&#160;&#160;&#160;"Owner", when applied to property, includes any part owner, joint owner or tenant in common of the whole or part of such property.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42197" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42197"></AnnotationDrawer><div>&#160;&#160;&#160;(k)&#160;&#160;&#160;"Person" includes an individual, corporation, business trust, estate, trust, partnership and association.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42196" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42196"></AnnotationDrawer><div>(RC 1.59(C))</div></div><div class="clearfix"></div><div id="rid-0-0-0-42195" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42195"></AnnotationDrawer><div>&#160;&#160;&#160;(l)&#160;&#160;&#160;"Premises", as applied to property, includes land and buildings.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42194" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42194"></AnnotationDrawer><div>&#160;&#160;&#160;(m)&#160;&#160;&#160;"Property" means real and personal property. "Personal property" includes all property except real property. "Real property" includes lands, tenements and hereditaments.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42193" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42193"></AnnotationDrawer><div>(RC 1.59(E))</div></div><div class="clearfix"></div><div id="rid-0-0-0-42192" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42192"></AnnotationDrawer><div>&#160;&#160;&#160;(n)&#160;&#160;&#160;"Public authority" includes boards of education: the City of Cleveland, Cuyahoga County, State of Ohio, or Federal government, its officers or an agency thereof; or any duly authorized public official.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42191" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42191"></AnnotationDrawer><div>&#160;&#160;&#160;(o)&#160;&#160;&#160;"Public place" includes any street, sidewalk, park, cemetery, school yard, body of water or watercourse, public conveyance, or any other place for the sale of merchandise, public accommodation or amusement.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42190" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42190"></AnnotationDrawer><div>&#160;&#160;&#160;(p)&#160;&#160;&#160;"Registered mail" includes certified mail and "certified mail" includes registered mail.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42189" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42189"></AnnotationDrawer><div>(RC 1.02(G))</div></div><div class="clearfix"></div><div id="rid-0-0-0-42188" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42188"></AnnotationDrawer><div>&#160;&#160;&#160;(q)&#160;&#160;&#160;"Sexual orientation" means a person's actual or perceived homosexuality, bisexuality or heterosexuality, by orientation or practice, by and between consenting adults.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42187" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42187"></AnnotationDrawer><div>&#160;&#160;&#160;(r)&#160;&#160;&#160;"Sidewalk" means that portion of the street between the curb line and the adjacent property line intended for the use of pedestrians.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42185" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42185"></AnnotationDrawer><div>&#160;&#160;&#160;(s)&#160;&#160;&#160;"Street" includes alleys, avenues, boulevards, lanes, roads, highways, viaducts and all other public thoroughfares within the City of Cleveland.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42186" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42186"></AnnotationDrawer><div>&#160;&#160;&#160;(t)&#160;&#160;&#160;"Tenant" or "occupant", as applied to premises, includes any person holding a written or oral lease, or who actually occupies the whole or any part of such premises, alone or with others.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42184" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42184"></AnnotationDrawer><div>&#160;&#160;&#160;(u)&#160;&#160;&#160;"This State" or "the State" means the State of Ohio.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42183" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42183"></AnnotationDrawer><div>(RC 1.59(G))</div></div><div class="clearfix"></div><div id="rid-0-0-0-42182" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42182"></AnnotationDrawer><div>&#160;&#160;&#160;(v)&#160;&#160;&#160;"Whoever" includes all persons, natural and artificial; partners; principals, agents, and employees; and all officials, public or private.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42181" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42181"></AnnotationDrawer><div>(RC 1.02(A))</div></div><div class="clearfix"></div><div id="rid-0-0-0-42180" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42180"></AnnotationDrawer><div>&#160;&#160;&#160;(w)&#160;&#160;&#160;"Written" or "in writing" includes any representation of words, letters, symbols or figures. This provision does not affect any law relating to signatures.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42179" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42179"></AnnotationDrawer><div>(Ord. No. 979-15. Passed 9-21-15, eff. 9-23-15)</div></div><div class="clearfix"></div><div class="clearfix"></div></div>
<div><span depth="6"></span><CodeOptions destID="rid-0-0-0-49718" class="Section"></CodeOptions><div id="rid-0-0-0-49718" class="Section toc-destination rbox" style="margin-top: .5rem"><AnnotationDrawer recordId="0-0-0-49718"></AnnotationDrawer><h6><a name="JD_101.021" id="JD_101.021" title="101.021"></a>&#167; 101.021  Open Public Meetings and Hearings</h6></div><div class="clearfix"></div><div id="rid-0-0-0-49731" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-49731"></AnnotationDrawer><div>&#160;&#160;&#160;(a)&#160;&#160;&#160;<span style="font-weight: normal;font-style: italic;text-decoration:none;display: inline;">Definitions.</span> As used in this section:</div></div><div class="clearfix"></div><div id="rid-0-0-0-49730" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-49730"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(1)&#160;&#160;&#160;"Council" shall have the same meaning as defined in Section <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1214', hash: '#JD_101.02' }}">101.02</Link>.</div></div><div class="clearfix"></div><div id="rid-0-0-0-49729" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-49729"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(2)&#160;&#160;&#160;"Electronically" means by way of electronic equipment or devices, including but not limited to, live-streaming by means of internet, local radio, television, cable public access channels; call in information for a teleconference; or by means of any other similar electronic technology.</div></div><div class="clearfix"></div><div id="rid-0-0-0-49727" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-49727"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(3)&#160;&#160;&#160;"Open to the public" means that a public meeting, or hearing conducted in-person, virtually, or any combination thereof, to which the public has access to the deliberations and official actions of the public body in-person, virtually, electronically, or any combination thereof.</div></div><div class="clearfix"></div><div id="rid-0-0-0-49743" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-49743"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(4)&#160;&#160;&#160;"Public body" shall have the same meaning as defined in RC 121.22.</div></div><div class="clearfix"></div><div id="rid-0-0-0-49726" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-49726"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(5)&#160;&#160;&#160;"Virtually" means by way of teleconference, video conference, or any other similar electronic technology.</div></div><div class="clearfix"></div><div id="rid-0-0-0-49725" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-49725"></AnnotationDrawer><div>&#160;&#160;&#160;(b)&#160;&#160;&#160;<span style="font-weight: normal;font-style: italic;text-decoration:none;display: inline;">Attendance.</span> Each public body may permit its members to attend its public meetings or hearings in-person, virtually, or a combination of the two. The following shall apply if any or all of the members are permitted to attend virtually:</div></div><div class="clearfix"></div><div id="rid-0-0-0-49724" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-49724"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(1)&#160;&#160;&#160;Each member attending virtually shall be considered present as if the member is in-person at the public meeting or hearing, shall be permitted to vote, and shall be counted for purposes of determining whether a quorum is present at the public meeting or hearing;</div></div><div class="clearfix"></div><div id="rid-0-0-0-49723" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-49723"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(2)&#160;&#160;&#160;Any vote on a resolution, ordinance or formal action of any kind cast by a member attending virtually shall have the same effect as if member is in-person at the public meeting or hearing; and</div></div><div class="clearfix"></div><div id="rid-0-0-0-49722" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-49722"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(3)&#160;&#160;&#160;The public body shall ensure that the public can observe and hear the discussions and deliberations of all the members of the public body, whether members are attending in-person or virtually.</div></div><div class="clearfix"></div><div id="rid-0-0-0-49721" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-49721"></AnnotationDrawer><div>&#160;&#160;&#160;(c)&#160;&#160;&#160;<span style="font-weight: normal;font-style: italic;text-decoration:none;display: inline;">Open to the Public.</span> Each public body shall determine the method by which its meetings, or hearings are open to the public. For public hearings conducted virtually, the public body must also establish a means, through the use of electronic equipment that is widely available to the general public, to communicate with witnesses and to receive documentary testimony and physical evidence.</div></div><div class="clearfix"></div><div id="rid-0-0-0-49720" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-49720"></AnnotationDrawer><div>&#160;&#160;&#160;(d)&#160;&#160;&#160;<span style="font-weight: normal;font-style: italic;text-decoration:none;display: inline;">Notice to the Public.</span> Each public body shall provide at least twelve (12) hours' prior notification of the time, place, agenda items, and the manner by which the meeting or hearing will be held.</div></div><div class="clearfix"></div><div id="rid-0-0-0-49719" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-49719"></AnnotationDrawer><div>(Ord. No. 560-2021. Passed 7-14-21, eff. 7-16-21)</div></div><div class="clearfix"></div><div class="clearfix"></div></div>
<div><span depth="6"></span><CodeOptions destID="rid-0-0-0-1250" class="Section"></CodeOptions><div id="rid-0-0-0-1250" class="Section toc-destination rbox" style="margin-top: .5rem"><AnnotationDrawer recordId="0-0-0-1250"></AnnotationDrawer><h6><a name="JD_101.03" id="JD_101.03" title="101.03"></a>&#167; 101.03  Rules of Construction</h6></div><div class="clearfix"></div><div id="rid-0-0-0-1272" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1272"></AnnotationDrawer><div>&#160;&#160;&#160;(a)&#160;&#160;&#160;<span style="font-weight: normal;font-style: italic;text-decoration:none;display: inline;">Common and Technical Usage.</span> Words and phrases shall be read in context and construed according to the rules of grammar and common usage. Words and phrases that have acquired a technical or particular meaning, whether by legislative definition or otherwise, shall be construed accordingly.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42234" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42234"></AnnotationDrawer><div>(RC 1.42)</div></div><div class="clearfix"></div><div id="rid-0-0-0-42233" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42233"></AnnotationDrawer><div>&#160;&#160;&#160;(b)&#160;&#160;&#160;<span style="font-weight: normal;font-style: italic;text-decoration:none;display: inline;">Singular and Plural; Gender; Tense.</span> As used in the Codified Ordinances, unless the context otherwise requires:</div></div><div class="clearfix"></div><div id="rid-0-0-0-42232" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42232"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(1)&#160;&#160;&#160;The singular includes the plural, and the plural includes the singular.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42231" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42231"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(2)&#160;&#160;&#160;Words of one gender include the other genders.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42229" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42229"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(3)&#160;&#160;&#160;Words in the present tense include the future.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42230" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42230"></AnnotationDrawer><div>(RC 1.43)</div></div><div class="clearfix"></div><div id="rid-0-0-0-42227" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42227"></AnnotationDrawer><div>&#160;&#160;&#160;(c)&#160;&#160;&#160;<span style="font-weight: normal;font-style: italic;text-decoration:none;display: inline;">Calendar; Computation of Time.</span></div></div><div class="clearfix"></div><div id="rid-0-0-0-42228" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42228"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(1)&#160;&#160;&#160;<span style="font-weight: normal;font-style: italic;text-decoration:none;display: inline;">Definitions.</span></div></div><div class="clearfix"></div><div id="rid-0-0-0-42226" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42226"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;A.&#160;&#160;&#160;"Week" means seven (7) consecutive days.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42225" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42225"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;B.&#160;&#160;&#160;"Year" means twelve (12) consecutive months.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42224" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42224"></AnnotationDrawer><div>(RC 1.44)</div></div><div class="clearfix"></div><div id="rid-0-0-0-42223" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42223"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(2)&#160;&#160;&#160;If a number of months is to be computed by counting the months from a particular day, the period ends on the same numerical day in the concluding month as the day of the month from which the computation is begun, unless there are not that many days in the concluding month, in which case the period ends on the last day of that month.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42222" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42222"></AnnotationDrawer><div>(RC 1.45)</div></div><div class="clearfix"></div><div id="rid-0-0-0-42221" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42221"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(3)&#160;&#160;&#160;The time within which an act is required by law to be done shall be computed by excluding the first and including the last day, except that when the last day falls on Sunday or a legal holiday, then the act may be done on the next succeeding day which is not a Sunday or a legal holiday. When a public office, in which an act required by law is to be performed, is closed to the public for the entire day which constitutes the last day for doing such act or before its usual closing time on such day, then such act may be performed on the next succeeding day which is not a Sunday or a legal holiday. If any legal holiday falls on Sunday, the next succeeding day is a legal holiday.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42220" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42220"></AnnotationDrawer><div>(RC 1.14)</div></div><div class="clearfix"></div><div id="rid-0-0-0-42219" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42219"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(4)&#160;&#160;&#160;When legislation is to take effect or become operative from and after a day named, no part of that day shall be included. If priority of legal rights depends upon the order of events on the same day, such priority shall be determined by the times in the day at which they respectively occurred.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42218" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42218"></AnnotationDrawer><div>(RC 1.15)</div></div><div class="clearfix"></div><div id="rid-0-0-0-42217" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42217"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(5)&#160;&#160;&#160;In all cases where the law requires any act to be done in a reasonable time or reasonable notice to be given, such reasonable time or notice means such time only as may be necessary for the prompt performance of such duty or compliance with such notice.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42216" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42216"></AnnotationDrawer><div>&#160;&#160;&#160;(d)&#160;&#160;&#160;<span style="font-weight: normal;font-style: italic;text-decoration:none;display: inline;">Authority.</span> When the law requires an act to be done which may by law as well be done by an agent as by the principal, such requirement shall be construed to include all such acts when done by an authorized agent.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42215" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42215"></AnnotationDrawer><div>&#160;&#160;&#160;(e)&#160;&#160;&#160;<span style="font-weight: normal;font-style: italic;text-decoration:none;display: inline;">Joint Authority.</span> All words purporting to give joint authority to three (3) or more municipal officers or other persons shall be construed as giving such authority to a majority of such officers or other persons, unless it shall be otherwise expressly declared in the law giving the authority or inconsistent with State statute or Charter provisions.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42214" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42214"></AnnotationDrawer><div>&#160;&#160;&#160;(f)&#160;&#160;&#160;<span style="font-weight: normal;font-style: italic;text-decoration:none;display: inline;">Exceptions.</span> The rules of construction shall not apply to any law which shall contain any express provision excluding such construction, or when the subject matter or context of such law may be repugnant thereto.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42213" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42213"></AnnotationDrawer><div>(Ord. No. 979-15. Passed 9-21-15, eff. 9-23-15)</div></div><div class="clearfix"></div><div class="clearfix"></div></div>
<div><span depth="6"></span><CodeOptions destID="rid-0-0-0-1273" class="Section"></CodeOptions><div id="rid-0-0-0-1273" class="Section toc-destination rbox" style="margin-top: .5rem"><AnnotationDrawer recordId="0-0-0-1273"></AnnotationDrawer><h6><a name="JD_101.04" id="JD_101.04" title="101.04"></a>&#167; 101.04  Revivor; Effect of Amendment or Repeal</h6></div><div class="clearfix"></div><div id="rid-0-0-0-1274" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1274"></AnnotationDrawer><div>&#160;&#160;&#160;(a)&#160;&#160;&#160;The repeal of a repealing ordinance does not revive the ordinance originally repealed nor impair the effect of any saving clause therein.</div></div><div class="clearfix"></div><div id="rid-0-0-0-1275" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1275"></AnnotationDrawer><div>(RC 1.57)</div></div><div class="clearfix"></div><div id="rid-0-0-0-1276" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1276"></AnnotationDrawer><div>&#160;&#160;&#160;(b)&#160;&#160;&#160;An ordinance which is re-enacted or amended is intended to be a continuation of the prior ordinance and not a new enactment, so far as it is the same as the prior ordinance.</div></div><div class="clearfix"></div><div id="rid-0-0-0-1277" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1277"></AnnotationDrawer><div>(RC 1.54)</div></div><div class="clearfix"></div><div id="rid-0-0-0-1278" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1278"></AnnotationDrawer><div>&#160;&#160;&#160;(c)&#160;&#160;&#160;The re-enactment, amendment or repeal of an ordinance does not, except as provided in subsection (d) hereof:</div></div><div class="clearfix"></div><div id="rid-0-0-0-1279" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1279"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(1)&#160;&#160;&#160;Affect the prior operation of the ordinance or any prior action taken thereunder;</div></div><div class="clearfix"></div><div id="rid-0-0-0-1280" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1280"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(2)&#160;&#160;&#160;Affect any validation, cure, right, privilege, obligation or liability previously acquired, accrued, accorded or incurred thereunder;</div></div><div class="clearfix"></div><div id="rid-0-0-0-1281" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1281"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(3)&#160;&#160;&#160;Affect any violation thereof or penalty, forfeiture or punishment incurred in respect thereto, prior to the amendment or repeal;</div></div><div class="clearfix"></div><div id="rid-0-0-0-1282" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1282"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(4)&#160;&#160;&#160;Affect any investigation, proceeding or remedy in respect of any such privilege, obligation, liability, penalty, forfeiture or punishment; and the investigation, proceeding or remedy may be instituted, continued or enforced, and the penalty, forfeiture or punishment imposed, as if the ordinance had not been repealed or amended.</div></div><div class="clearfix"></div><div id="rid-0-0-0-1283" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1283"></AnnotationDrawer><div>&#160;&#160;&#160;(d)&#160;&#160;&#160;If the penalty, forfeiture or punishment for any offense is reduced by a re-enactment or amendment of an ordinance, the penalty, forfeiture or punishment, if not already imposed, shall be imposed according to the ordinance as amended</div></div><div class="clearfix"></div><div id="rid-0-0-0-1284" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1284"></AnnotationDrawer><div>(RC 1.58)</div></div><div class="clearfix"></div><div class="clearfix"></div></div>
<div><span depth="6"></span><CodeOptions destID="rid-0-0-0-1285" class="Section"></CodeOptions><div id="rid-0-0-0-1285" class="Section toc-destination rbox" style="margin-top: .5rem"><AnnotationDrawer recordId="0-0-0-1285"></AnnotationDrawer><h6><a name="JD_101.05" id="JD_101.05" title="101.05"></a>&#167; 101.05  Construction of Section References</h6></div><div class="clearfix"></div><div id="rid-0-0-0-1292" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1292"></AnnotationDrawer><div>&#160;&#160;&#160;(a)&#160;&#160;&#160;A reference to any portion of the Codified Ordinances applies to all re-enactments or amendments thereof.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42240" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42240"></AnnotationDrawer><div>(RC 1.55)</div></div><div class="clearfix"></div><div id="rid-0-0-0-42239" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42239"></AnnotationDrawer><div>&#160;&#160;&#160;(b)&#160;&#160;&#160;If a section refers to a series of numbers or letters, the first and the last numbers or letters are included.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42238" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42238"></AnnotationDrawer><div>(RC 1.56)</div></div><div class="clearfix"></div><div id="rid-0-0-0-42237" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42237"></AnnotationDrawer><div>&#160;&#160;&#160;(c)&#160;&#160;&#160;(1)&#160;&#160;&#160;Wherever in a penalty section reference is made to a violation of a series of sections or an inclusive group of sections, or of divisions or subdivisions of a section, such reference shall be construed to mean a violation of any section, division or subdivision included in such reference.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42236" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42236"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(2)&#160;&#160;&#160;References in the Codified Ordinances to action taken or authorized under designated sections of the Codified Ordinances include, in every case, action taken or authorized under the applicable legislative provision which is superseded by the Codified Ordinances.</div></div><div class="clearfix"></div><div id="rid-0-0-0-42235" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-42235"></AnnotationDrawer><div>(RC 1.23; Ord. No. 979-15. Passed 9-21-15, eff. 9-23-15)</div></div><div class="clearfix"></div><div class="clearfix"></div></div>
<div><span depth="6"></span><CodeOptions destID="rid-0-0-0-1293" class="Section"></CodeOptions><div id="rid-0-0-0-1293" class="Section toc-destination rbox" style="margin-top: .5rem"><AnnotationDrawer recordId="0-0-0-1293"></AnnotationDrawer><h6><a name="JD_101.06" id="JD_101.06" title="101.06"></a>&#167; 101.06  Conflicting Provisions</h6></div><div class="clearfix"></div><div id="rid-0-0-0-1294" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1294"></AnnotationDrawer><div>&#160;&#160;&#160;(a)&#160;&#160;&#160;If there is a conflict between figures and words in expressing a number, the words govern.</div></div><div class="clearfix"></div><div id="rid-0-0-0-1295" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1295"></AnnotationDrawer><div>(RC 1.46)</div></div><div class="clearfix"></div><div id="rid-0-0-0-1296" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1296"></AnnotationDrawer><div>&#160;&#160;&#160;(b)&#160;&#160;&#160;If a general provision conflicts with a special or local provision, they shall be construed, if possible, so that effect is given to both. If the conflict between the provisions is irreconcilable, the special or local provision prevails as an exception to the general provision, unless the general provision is the later adoption and the manifest intent is that the general provision prevail.</div></div><div class="clearfix"></div><div id="rid-0-0-0-1297" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1297"></AnnotationDrawer><div>(RC 1.51)</div></div><div class="clearfix"></div><div id="rid-0-0-0-1298" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1298"></AnnotationDrawer><div>&#160;&#160;&#160;(c)&#160;&#160;&#160;(1)&#160;&#160;&#160;If ordinances enacted at different meetings of Council are irreconcilable, the ordinance latest in date of enactment prevails.</div></div><div class="clearfix"></div><div id="rid-0-0-0-1299" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1299"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(2)&#160;&#160;&#160;If amendments to the same ordinance are enacted at different meetings of Council, one (1) amendment without reference to another, the amendments are to be harmonized, if possible, so that effect may be given to each. If the amendments are substantively irreconcilable, the latest in date of enactment prevails. The fact that a later amendment restates language deleted by an earlier amendment, or fails to include language inserted by an earlier amendment, does not of itself make the amendments irreconcilable. Amendments are irreconcilable only when changes made by each cannot reasonably be put into simultaneous operation.</div></div><div class="clearfix"></div><div id="rid-0-0-0-1300" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1300"></AnnotationDrawer><div>(RC 1.52)</div></div><div class="clearfix"></div><div class="clearfix"></div></div>
<div><span depth="6"></span><CodeOptions destID="rid-0-0-0-1301" class="Section"></CodeOptions><div id="rid-0-0-0-1301" class="Section toc-destination rbox" style="margin-top: .5rem"><AnnotationDrawer recordId="0-0-0-1301"></AnnotationDrawer><h6><a name="JD_101.07" id="JD_101.07" title="101.07"></a>&#167; 101.07  Determination of Legislative Intent</h6></div><div class="clearfix"></div><div id="rid-0-0-0-1302" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1302"></AnnotationDrawer><div>&#160;&#160;&#160;(a)&#160;&#160;&#160;In enacting an ordinance, it is presumed that:</div></div><div class="clearfix"></div><div id="rid-0-0-0-1303" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1303"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(1)&#160;&#160;&#160;Compliance with the constitutions of the State of Ohio and of the United States is intended;</div></div><div class="clearfix"></div><div id="rid-0-0-0-1304" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1304"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(2)&#160;&#160;&#160;The entire ordinance is intended to be effective;</div></div><div class="clearfix"></div><div id="rid-0-0-0-1305" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1305"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(3)&#160;&#160;&#160;A just and reasonable result is intended;</div></div><div class="clearfix"></div><div id="rid-0-0-0-1306" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1306"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(4)&#160;&#160;&#160;A result feasible of execution is intended.</div></div><div class="clearfix"></div><div id="rid-0-0-0-1307" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1307"></AnnotationDrawer><div>(RC 1.47)</div></div><div class="clearfix"></div><div id="rid-0-0-0-1308" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1308"></AnnotationDrawer><div>&#160;&#160;&#160;(b)&#160;&#160;&#160;An ordinance is presumed to be prospective in its operation unless expressly made retrospective.</div></div><div class="clearfix"></div><div id="rid-0-0-0-1309" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1309"></AnnotationDrawer><div>(RC 1.48)</div></div><div class="clearfix"></div><div id="rid-0-0-0-1310" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1310"></AnnotationDrawer><div>&#160;&#160;&#160;(c)&#160;&#160;&#160;If an ordinance is ambiguous, the court, in determining the intention of Council may consider among other matters:</div></div><div class="clearfix"></div><div id="rid-0-0-0-1311" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1311"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(1)&#160;&#160;&#160;The object sought to be attained;</div></div><div class="clearfix"></div><div id="rid-0-0-0-1312" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1312"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(2)&#160;&#160;&#160;The circumstances under which the ordinance was enacted;</div></div><div class="clearfix"></div><div id="rid-0-0-0-1313" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1313"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(3)&#160;&#160;&#160;The legislative history;</div></div><div class="clearfix"></div><div id="rid-0-0-0-1314" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1314"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(4)&#160;&#160;&#160;The common law or former legislative provisions, including laws upon the same or similar subjects;</div></div><div class="clearfix"></div><div id="rid-0-0-0-1315" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1315"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(5)&#160;&#160;&#160;The consequences of a particular construction;</div></div><div class="clearfix"></div><div id="rid-0-0-0-1316" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1316"></AnnotationDrawer><div>&#160;&#160;&#160;&#160;&#160;&#160;(6)&#160;&#160;&#160;The administrative construction of the ordinance.</div></div><div class="clearfix"></div><div id="rid-0-0-0-1317" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1317"></AnnotationDrawer><div>(RC 1.49)</div></div><div class="clearfix"></div><div class="clearfix"></div></div>
<div><span depth="6"></span><CodeOptions destID="rid-0-0-0-1318" class="Section"></CodeOptions><div id="rid-0-0-0-1318" class="Section toc-destination rbox" style="margin-top: .5rem"><AnnotationDrawer recordId="0-0-0-1318"></AnnotationDrawer><h6><a name="JD_101.08" id="JD_101.08" title="101.08"></a>&#167; 101.08  Severability</h6></div><div class="clearfix"></div><div id="rid-0-0-0-1319" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1319"></AnnotationDrawer><div>&#160;&#160;&#160;If any provision of a section of the Codified Ordinances or the application thereof to any person or circumstance is held invalid, the invalidity does not affect the other provisions or applications of the section or related sections which can be given effect without the invalid provision or application, and to this end the provisions are severable.</div></div><div class="clearfix"></div><div id="rid-0-0-0-1320" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1320"></AnnotationDrawer><div>(RC 1.50)</div></div><div class="clearfix"></div><div class="clearfix"></div></div>
<div><span depth="6"></span><CodeOptions destID="rid-0-0-0-1321" class="Section"></CodeOptions><div id="rid-0-0-0-1321" class="Section toc-destination rbox" style="margin-top: .5rem"><AnnotationDrawer recordId="0-0-0-1321"></AnnotationDrawer><h6><a name="JD_101.99" id="JD_101.99" title="101.99"></a>&#167; 101.99  General Penalty</h6></div><div class="clearfix"></div><div id="rid-0-0-0-1322" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1322"></AnnotationDrawer><div>&#160;&#160;&#160;Whenever, in the Codified Ordinances or in any ordinance of the City of Cleveland, any act is prohibited or is made or declared to be unlawful or an offense or a misdemeanor, or whenever the doing of any act is required or the failure to do any act is declared to be unlawful, where no specific penalty is otherwise provided, whoever violates any such provision is guilty of a minor misdemeanor and shall be fined not more than one hundred dollars ($100.00). A separate offense shall be deemed committed each day during or on which a violation continues or occurs.</div></div><div class="clearfix"></div><div class="clearfix"></div></div>
<div><div id="rid-0-0-0-1323" class="rbox Chapter"><AnnotationDrawer recordId="0-0-0-1323"></AnnotationDrawer><h4><a name="JD_Chapter103" id="JD_Chapter103" title="Chapter 103"></a>CHAPTER 103 &#8211; BOUNDARIES AND WARDS</h4></div><div class="clearfix"></div><div id="rid-0-0-0-1324" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1324"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1353', hash: '#JD_103.001' }}">103.001</Link>&#160;&#160;&#160;Boundaries of City of Cleveland</div></div><div class="clearfix"></div><div id="rid-0-0-0-1325" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1325"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1356', hash: '#JD_103.002' }}">103.002</Link>&#160;&#160;&#160;Division into Wards</div></div><div class="clearfix"></div><div id="rid-0-0-0-1326" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1326"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1359', hash: '#JD_103.01' }}">103.01</Link>&#160;&#160;&#160;Ward One</div></div><div class="clearfix"></div><div id="rid-0-0-0-1327" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1327"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1364', hash: '#JD_103.02' }}">103.02</Link>&#160;&#160;&#160;Ward Two</div></div><div class="clearfix"></div><div id="rid-0-0-0-1328" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1328"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1369', hash: '#JD_103.03' }}">103.03</Link>&#160;&#160;&#160;Ward Three</div></div><div class="clearfix"></div><div id="rid-0-0-0-1329" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1329"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1374', hash: '#JD_103.04' }}">103.04</Link>&#160;&#160;&#160;Ward Four</div></div><div class="clearfix"></div><div id="rid-0-0-0-1330" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1330"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1379', hash: '#JD_103.05' }}">103.05</Link>&#160;&#160;&#160;Ward Five</div></div><div class="clearfix"></div><div id="rid-0-0-0-1331" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1331"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1384', hash: '#JD_103.06' }}">103.06</Link>&#160;&#160;&#160;Ward Six</div></div><div class="clearfix"></div><div id="rid-0-0-0-1332" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1332"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1389', hash: '#JD_103.07' }}">103.07</Link>&#160;&#160;&#160;Ward Seven</div></div><div class="clearfix"></div><div id="rid-0-0-0-1333" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1333"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1394', hash: '#JD_103.08' }}">103.08</Link>&#160;&#160;&#160;Ward Eight</div></div><div class="clearfix"></div><div id="rid-0-0-0-1334" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1334"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1399', hash: '#JD_103.09' }}">103.09</Link>&#160;&#160;&#160;Ward Nine</div></div><div class="clearfix"></div><div id="rid-0-0-0-1335" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1335"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1404', hash: '#JD_103.10' }}">103.10</Link>&#160;&#160;&#160;Ward Ten</div></div><div class="clearfix"></div><div id="rid-0-0-0-1336" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1336"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1409', hash: '#JD_103.11' }}">103.11</Link>&#160;&#160;&#160;Ward Eleven</div></div><div class="clearfix"></div><div id="rid-0-0-0-1337" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1337"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1414', hash: '#JD_103.12' }}">103.12</Link>&#160;&#160;&#160;Ward Twelve</div></div><div class="clearfix"></div><div id="rid-0-0-0-1338" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1338"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1419', hash: '#JD_103.13' }}">103.13</Link>&#160;&#160;&#160;Ward Thirteen</div></div><div class="clearfix"></div><div id="rid-0-0-0-1339" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1339"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1424', hash: '#JD_103.14' }}">103.14</Link>&#160;&#160;&#160;Ward Fourteen</div></div><div class="clearfix"></div><div id="rid-0-0-0-1340" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1340"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1429', hash: '#JD_103.15' }}">103.15</Link>&#160;&#160;&#160;Ward Fifteen</div></div><div class="clearfix"></div><div id="rid-0-0-0-1341" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1341"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1434', hash: '#JD_103.16' }}">103.16</Link>&#160;&#160;&#160;Ward Sixteen &#8211; Repealed</div></div><div class="clearfix"></div><div id="rid-0-0-0-1342" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1342"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1439', hash: '#JD_103.17' }}">103.17</Link>&#160;&#160;&#160;Ward Seventeen &#8211; Repealed</div></div><div class="clearfix"></div><div id="rid-0-0-0-1343" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1343"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1444', hash: '#JD_103.18' }}">103.18</Link>&#160;&#160;&#160;Ward Eighteen &#8211; Repealed</div></div><div class="clearfix"></div><div id="rid-0-0-0-1344" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1344"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1449', hash: '#JD_103.19' }}">103.19</Link>&#160;&#160;&#160;Ward Nineteen &#8211; Repealed</div></div><div class="clearfix"></div><div id="rid-0-0-0-1345" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1345"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1454', hash: '#JD_103.20' }}">103.20</Link>&#160;&#160;&#160;Ward Twenty &#8211; Repealed</div></div><div class="clearfix"></div><div id="rid-0-0-0-1346" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1346"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1456', hash: '#JD_103.21' }}">103.21</Link>&#160;&#160;&#160;Ward Twenty-One &#8211; Repealed</div></div><div class="clearfix"></div><div id="rid-0-0-0-1347" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1347"></AnnotationDrawer><div class="ChapAn"><Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-1458', hash: '#JD_103.22' }}">103.22 to 103.33</Link>&#160;&#160;&#160;Reserved<br></br></div></div><div class="clearfix"></div><div id="rid-0-0-0-1348" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1348"></AnnotationDrawer><div class="paragraph-Note">&#160;&#160;&#160;Note: The legislative history of this chapter, except where specifically noted at the end of a section, is as follows: Ordinance No. 63410-A, passed September 22, 1924.<br></br></div></div><div class="clearfix"></div><div id="rid-0-0-0-1350" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1350"></AnnotationDrawer><div><span style="font-weight: bold;font-style: italic;text-decoration:none;display: inline;">Charter reference:<br></br></span><span style="font-weight: normal;font-style: italic;text-decoration:none;display: inline;">&#160;&#160;&#160;Redivision into wards; reapportionment, Charter &#167;&#167; <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-208', hash: '#JD_Chtr.Sec.25' }}">25</Link>,  <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-215', hash: '#JD_Chtr.Sec.25-1' }}">25-1</Link></span></div></div><div class="clearfix"></div><div id="rid-0-0-0-1352" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1352"></AnnotationDrawer><div><span style="font-weight: bold;font-style: italic;text-decoration:none;display: inline;">Statutory reference:<br></br></span><span style="font-weight: normal;font-style: italic;text-decoration:none;display: inline;">&#160;&#160;&#160;Division into wards, RC 731.06</span></div></div><div class="clearfix"></div></div>
<div><span depth="6"></span><CodeOptions destID="rid-0-0-0-1353" class="Section"></CodeOptions><div id="rid-0-0-0-1353" class="Section toc-destination rbox" style="margin-top: .5rem"><AnnotationDrawer recordId="0-0-0-1353"></AnnotationDrawer><h6><a name="JD_103.001" id="JD_103.001" title="103.001"></a>&#167; 103.001  Boundaries of City of Cleveland</h6></div><div class="clearfix"></div><div id="rid-0-0-0-1354" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1354"></AnnotationDrawer><div>&#160;&#160;&#160;The boundaries of the City of Cleveland are hereby established as follows:</div></div><div class="clearfix"></div><div id="rid-0-0-0-1355" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-1355"></AnnotationDrawer><div>&#160;&#160;&#160;Beginning on the southerly shore of Lake Erie at a point distant 150 feet easterly at right angles from the westerly line of original East Cleveland Township lot No. 360; thence southerly parallel with and distant 150 feet easterly at right angles from the westerly line of said original lot No. 360 to the northerly line of the Lake Shore and Michigan Southern Railway right-of-way line; thence northeasterly along said northerly right-of-way line of the L.S. &amp; M.S. Ry. to the westerly line of original lot No. 354; thence northerly along the westerly line of original lots Nos. 354 and 351 to a point which is distant southeasterly 700 feet measured at right angles from the center line of the Lake Shore Blvd.; thence northeasterly and parallel with said center line of the Lake Shore Blvd. and distant 700 feet at right angles from the center line thereof to the westerly line of E. 136th St. south of McElhattan Ave. N.E., as said E. 136th St. is laid out in subdivision of Henry C. Wick, which is recorded in Volume 28, page 16, of Cuyahoga County Records of Maps; thence northerly along the westerly line of E. 136th St. south of McElhattan Ave. N.E. and along said westerly line of E. 136th St. produced northerly to a point due west from the most southerly corner of lands, now or formerly owned by Joseph Parks, which lie northerly of Florence St.; thence east 25 feet to the westerly line of E. 136th St. north of McElhattan Ave. N.E.; thence northerly along the westerly line of E. 136th St. north of McElhattan Ave. N.E. and along the westerly line of Henry C. Wick&#8217;s subdivision to the northerly line of said Wick&#8217;s subdivision; thence easterly along the northerly line of said Wick&#8217;s subdivision to the westerly line of E. 140th St.; thence northerly along the westerly line of E. 140th St. south of Westropp Ave. N.E. and northwesterly along a line which was the westerly line of Adams Ave. north of Westropp Ave. N.E. prior to its vacation by the village of Collinwood by Ordinance No. 1260, to the southerly line of the Lake Shore Blvd. N.E.; thence southwesterly along the southerly line of the Lake Shore Blvd. N.E. to an intersection with the westerly line of lands owned by the City of Cleveland produced southerly; thence northwesterly following said westerly line of lands of the City of Cleveland produced and along said westerly line of lands of the City of Cleveland to the waters of Lake Erie; thence northeasterly along the shore of Lake Erie to the easterly line of E. 185th St.; thence southerly along the easterly line of E. 185th St. to the northerly line of original lot No. 13 in Tract 17 of Euclid Township; thence easterly along the northerly line of said original lot No. 13 to the westerly line of E. 200th St. (Cut Rd.); thence southerly along the westerly line of E. 200th St. to an angle in said E. 200th St.; thence southeasterly along the westerly line of said E. 200th St. to an angle in said E. 200th St. at the north line of Tract 14 of Euclid Township; thence southerly along the westerly line of E. 200th St. and along said westerly line before said street was diverted, to the northerly line of St. Clair Ave. N.E.; thence southwesterly along the northerly line of St. Clair Ave. N.E. to a point where the westerly line of lands conveyed to Wm. Keck by deed dated Feb. 26, 1877, and recorded in Volume 273, page 321, and by a deed dated July 11, 1877, and recorded in Volume 280, page 336, of Cuyahoga County Records, if produced would intersect said St. Clair Ave. N.E.; thence southerly along said westerly line produced and along said westerly line of lands so conveyed to Wm. Keck to the center of Euclid Creek; then southeasterly along the center of Euclid Creek to the northerly line of the right-of-way of the N.Y.C. &amp; St. L. Ry. Co.; thence southwesterly along the northerly line of the right-of-way of the N.Y.C. &amp; St. L. Ry. Co. to a point which is at right angles with the southerly line of N.Y.C. &amp; St. L. Ry. Co. right-of-way line at a point where the Euclid Railroad Company&#8217;s southwesterly line intersects said southerly right-of-way line of the N.Y.C. &amp; St. L. Ry. Co.; thence southeasterly at right angles to said southerly right-of-way line to the point of intersection of said southerly right-of-way line of the N.Y.C. &amp; St. L. Ry. Co. with the southwesterly line of the Euclid Railway Company; thence southeasterly and following said southwesterly line of lands of the Euclid Railroad Company, to the easterly line of original Euclid Township lot No. 50 in Gore tract; thence southerly along said easterly line of said original lot No. 50 to the northwesterly line of lands conveyed to John Marzel, Jr., by deed recorded in Volume 338, page 34 of Cuyahoga County Deed Records; thence southwesterly and following the northwesterly line of said lands so conveyed to said John Marzel, Jr., to the most westerly corner of lands so conveyed to said John Marzel, Jr., in Green Rd.; thence westerly in Green Rd.; to the most westerly corner of lands conveyed to Daniel R. Huling by deed recorded in Volume 1295, page 414 of Cuyahoga County Deed Records; thence southeasterly and southerly and following the westerly line of said lands so conveyed to said Daniel R. Huling to a point where a line parallel with Euclid Ave., and distant southerly 1500 feet, right angle measurement from the center line thereof, intersects said westerly line of said Huling&#8217;s land; thence southwesterly and following a line which is parallel to Euclid Ave., and is distant southerly 1500 feet, right angle measurement from the center line thereof, to its intersection with the south line of original lot No. 10 in tract No. 10; thence westerly along the south line of said original lot No. 10 to the southwesterly corner of said original lot No. 10; thence north along the west line of original Lot No. 10 to the center line of Euclid Ave.; thence northeasterly along the center line of Euclid Ave. to the center line of Ivanhoe Rd. N.E.; thence northwesterly along the center line of Ivanhoe Rd. N.E. to the southerly right-of-way line of the New York, Chicago &amp; St. Louis Railroad; thence southwesterly along the southerly right-of-way line of the N.Y.C. &amp; St. L. Ry. Company to the southerly line of original lot No. 43; thence westerly along the southerly line of original lots Nos. 43, 2 and 359 to the northeasterly corner of original lot No. 365; thence southerly along the easterly line of original lots Nos. 365 and 373 to the southeasterly corner of said original lot No. 373; thence westerly along the southerly line of original lot No. 373 to the northeasterly corner of original lot No. 380; thence southerly along the easterly line of original lots Nos. 380 and 388 to the northwesterly corner of original lot No. 397; thence easterly along the northerly line of original lot No. 397 to the northeasterly corner of said original lot No. 397; thence southerly along the easterly line of original lot No. 397 to the southeasterly corner of said original lot No. 397; thence westerly along the southerly line of original lot No. 397 to the easterly line of Walton&#8217;s subdivision as recorded in Volume 14, page 12 of Cuyahoga County records of Maps; thence southerly and southwesterly along the easterly and southeasterly line of said Walton&#8217;s subdivision to the intersection thereof with the easterly line of original lot No. 404; thence southerly along the easterly line of original lot No. 404 to the southeasterly corner of said original lot No. 404; thence westerly along the southerly line of said original lot No. 404 to the northeasterly corner of original lot No. 411; thence southerly along the easterly line of original lot No. 411, to a point about 530.18 feet northerly of the southeasterly corner of said original lot No. 411, said point being the southwesterly corner of Cleveland Heights Village; thence south 73 degrees 12 minutes 50 seconds, east along the southerly line of said Cleveland Heights Village to the intersection of said southerly line with the extension northerly of the easterly line of a ten acre parcel of land in original lot No. 421, now or formerly owned by A.F. Ditz; thence southerly along Ditz&#8217;s easterly line produced and along Ditz&#8217;s easterly line to the center line of Woodland Ave. S.E.; thence easterly along the center line of Woodland Ave. S.E. to the easterly line of original lot No. 422; thence southerly along the easterly line of original lots Nos. 422, 430 and 438 to the northwest corner of original lot No. 41; thence easterly along the northerly line of said original lot No. 41 to the northeast corner of Palmer and Boyer subdivision as recorded in Volume 30, page 14 of Cuyahoga County Map Records; thence southerly along said easterly line of the Palmer and Boyer subdivision to the southwesterly corner of sublot No. 124 in Palmer and Burnett&#8217;s subdivision as recorded in Volume 34, page 5, of Cuyahoga County Map Records; thence easterly along the southerly line of said sublot No. 124 and the southerly line of sublot No. 7 in Palmer and Burnett&#8217;s subdivision to the southeast corner of said sublot No. 7; thence southerly along the easterly line of Palmer and Burnett&#8217;s subdivision about 9.12 feet; thence easterly to a point in the easterly line of the Van Sweringen subdivision No. 19, which point is 302.97 feet northerly from the center line of Kinsman Rd.; thence southerly along the easterly line of the Van Sweringen subdivision No. 19 to the center line of Kinsman Rd; thence westerly along the center line of Kinsman Rd. about 37.32 feet to the east line of 40 acres of land, now or formerly owned by the estate of John Feig; thence southerly along said east line of said Feig&#8217;s land, which is the west line of premises now, or formerly owned by Elizabeth L. Hamlin, to the south line of original lot No. 52; thence westerly along the south line of original lot No. 52 to the east line of premises, now, or formerly owned by O.P. Van Sweringen; thence southerly along the east line of said Van Sweringen&#8217;s land to the southeast corner thereof; thence continuing southerly along the division line between premises, now, or formerly owned by Fred Axel and George F. Mills to the north line of original lot No. 72; thence west along the said north line of original lot No. 72 to the northwest corner of land, now, or formerly owned by the Cyrus Realty Co.; thence south along the west line of the said Cyrus Realty Company&#8217;s property to the southwest corner thereof; thence east along the south line of Cyrus Realty Company&#8217;s property to the northwest corner of premises, now, or formerly owned by E. Cortlett; thence south along the west line of said premises, now, or formerly owned by E. Cortlett to the north line of premises now, or formerly owned by Ellen Fitzsimmons; thence west along the northerly line of premises of said Fitzsimmons to the east line of original lot No. 71; thence south on the east line of original lot No. 71 to the southeast corner thereof; thence west along the south line of said original lot No. 71 to the east line of original lot No. 470; thence south along the east line of original lot No. 470 to the southeast corner thereof; thence westerly along the southerly line of original lots Nos. 470, 469, 468, 467 and 466 to the northeasterly corner of original lot No. 473; thence southerly along the easterly line of said original lot No. 473 to the southeasterly corner of said original lot No. 473; thence westerly along the southerly line of original lots Nos. 473, 472 and 471 to the southwesterly corner of said original lot No. 471; thence northerly along the westerly line of said original lot No. 471 to the southeasterly corner of original lot No. 311; thence westerly along the southerly line of said original lot No. 311 to the easterly line of John Deveny and Company&#8217;s Belvedere Allotment as recorded in Volume 8, page 11 of Cuyahoga County Record of Maps; thence southerly, southeasterly, northeasterly, southerly, southwesterly and southerly following the boundary line of said Deveny and Company&#8217;s Belvedere Allotment to the northeasterly corner of J.H. Breck&#8217;s allotment as recorded in Volume 15, page 35 of Cuyahoga County Records of Maps; thence southwesterly and southerly along the easterly boundary line of said J.H. Breck&#8217;s Allotment, to the center line of Oak Ave., S.E., as said Oak Ave., S.E. was laid out in said J.H. Breck&#8217;s Allotment; thence westerly along the center line of said Oak Ave. S.E. to the center line of E. 71st St. formerly known as Brecksville Rd.; thence southwesterly along the center line of E. 71st St. to the center line of Grant Ave. S.E. as said Grant Ave. was laid out in J.H. Breck&#8217;s Allotment and recorded in Volume 17, page 19 of Cuyahoga County Records of Maps; thence westerly along the center line of Grant Ave. S.E. to the westerly line of original lot No. 306; thence northerly along the westerly line of said original lot No. 306 to the southeasterly corner of original lot No. 309; thence westerly along the southerly line of original lot No. 309 to the southwesterly corner of said original lot No. 309; thence northerly along the westerly line of original lots Nos. 309 and 313 to the southerly line of a subdivision made by G.C. Barkwill, trustee, of a part of original lots Nos. 312 and 313 and recorded in Volume 12, page 26 of Cuyahoga County Records of Maps; thence westerly along the southerly line of said subdivision about 260.5 feet to the southwesterly corner of said subdivision; thence northerly along the westerly line of said subdivision about 92.7 feet to a stone monument at a southeasterly corner of Engle and Skinner&#8217;s subdivision of a part of original lot No. 312 as recorded in Volume 13, page 18 of said County maps; thence northwesterly about 594.09 feet along the southerly line of said Engle and Skinner&#8217;s subdivision, and along Cook and Barkwill&#8217;s subdivision to the southwesterly corner of Cook and Barkwill&#8217;s subdivision as recorded in Volume 16, page 14 in said County Records of Maps; thence northerly along the westerly line of said Cook and Barkwill&#8217;s subdivision to the southeasterly corner of a subdivision of a part of original lot No. 312 made by Adolphus Kershaw and recorded in Volume 19, page 20 of said County Records of Maps; thence westerly along the southerly line of Kershaw&#8217;s subdivision and its prolongation in a direct line to the westerly line of original lot No. 312; thence northerly along said westerly line of original lot No. 312 to the southeasterly corner of original lot No. 287; thence westerly along the southerly line of original lots Nos. 287, 286, 285, 277 and 276 to the center of the Cuyahoga River; thence southerly up the center line of the Cuyahoga River following its crooks and bends to the southerly line of original lot No. 88; thence westerly along the southerly line of original lots Nos. 88, 81, 76 and 63 to the center line of Broadview Rd., S.W., formerly known as Independence Rd.; thence southerly along the center line of Broadview Rd. S.W. 639 feet; thence easterly to the east line of Broadview Rd. S.W.; thence southerly along the easterly line of Broadview Rd. S.W. to the southerly line of original lot No. 78; thence westerly along the southerly line of original lots Nos. 78, 61, 60, 41 and 40 to the center line of Ridge Rd.; thence northerly along the center line of Ridge Rd. to the northerly line of the Pearl Ridge Allotment, as shown in Volume 47, page 17 of Cuyahoga County Records of Maps; thence easterly along the northerly line of said allotment to a point where the easterly line produced of a certain 8.825 acres, parcel of land, now, or formerly owned by Ella M. Estabrook, intersects said northerly line of Pearl Ridge Allotment; thence northerly along said easterly line produced to the southeasterly corner of said 8.825 acre parcel of land, now, or formerly owned by said Estabrook; thence westerly along the southerly line of said Estabrook&#8217;s land and along the southerly line of a certain 31.175 acre parcel of land, now, or formerly owned by Charles E. Pegler, trustee, to the southwesterly corner of said Pegler&#8217;s land; thence northerly along the westerly line of said Pegler&#8217;s land to the center line of the Linndale Rd.; thence westerly along the center line of the Linndale Rd. to the center line of the Ridge Rd.; thence northerly along the center line of the Ridge Rd. to the center of Big Creek; thence up the center of Big Creek to its intersection with the easterly line produced of land, now, or formerly owned by Michael Huey; thence northerly along the easterly line produced and along the easterly line of said Huey&#8217;s land to the northwest corner of land, now, or formerly owned by Frederick Shedd, trustee; thence easterly along the northerly line of said Shedd land to the center line of Ridge Rd.; thence northerly along the center line of said Ridge Rd. to the southerly line of original lot No. 27; thence westerly along the southerly line of original lot No. 27 to the northerly line of land of the Cleveland, Cincinnati, Chicago and St. Louis Railway Co.; thence southwesterly along the northerly line of land of said Cleveland, Cincinnati, Chicago and St. Louis Railway Co. to the center of Big Creek; thence northerly following the center of Big Creek to the southerly line of Bellaire Rd. S.W.; thence southwesterly along the southerly line of Bellaire Rd. S.W. to the westerly line of original lot No. 4, which is also the easterly line of section 10; thence southerly along the easterly line of sections 10 and 1 to the southeasterly corner of section 1; thence westerly along the southerly lines of sections 1, 2, 3, 4 and 5 to the center of Rocky River; thence northerly down the center line of Rocky River to the southerly line of the City of Lakewood; thence easterly, northerly, easterly and northeasterly along the southerly boundary of the City of Lakewood to the westerly line of original lot No. 8; thence northerly along the westerly line of original lots Nos. 8, 9 and 10 to the southerly shore line of Lake Erie; thence easterly along the southerly shore line of Lake Erie to the place of beginning.</div></div><div class="clearfix"></div><div class="clearfix"></div></div>
<div><span depth="6"></span><CodeOptions destID="rid-0-0-0-1356" class="Section"></CodeOptions><div id="rid-0-0-0-1356" class="Section toc-destination rbox" style="margin-top: .5rem"><AnnotationDrawer recordId="0-0-0-1356"></AnnotationDrawer><h6><a name="JD_103.002" id="JD_103.002" title="103.002"></a>&#167; 103.002  Division into Wards</h6></div><div class="clearfix"></div><div id="rid-0-0-0-40388" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-40388"></AnnotationDrawer><div>&#160;&#160;&#160;The City of Cleveland is redivided into fifteen (15) wards under the provisions of Charter Section <Link class="Jump" to="{{ pathname: '/codes/cleveland/latest/cleveland_oh/0-0-0-215', hash: '#JD_Chtr.Sec.25-1' }}">25-1</Link>, effective for purposes of nominating and electing members of City Council in the year 2025 and for all purposes on and after January 5, 2026, which wards are more particularly defined and described in this chapter.</div></div><div class="clearfix"></div><div id="rid-0-0-0-52876" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-52876"></AnnotationDrawer><div>(Ord. No. 1-2025. Passed 1-6-25, eff. 1-9-25)</div></div><div class="clearfix"></div><div class="clearfix"></div></div>
