ext-decoration:none;display: inline;">$7.85/KWD</span></div></div></td><td style="word-wrap:break-word;padding-left:.075in;padding-right:.075in;padding-top:.022in;padding-bottom:.022in;border-top:1pt solid #000000;border-bottom:1pt solid #000000;border-left:1pt solid #000000;border-right:1pt solid #000000;"><div><div style="text-align:center;"><span style="font-weight: normal;font-style: normal;text-decoration:none;display: inline;">$7.09/KWD</span></div></div></td></tr></tbody></table></div></div><div style="margin-bottom=10pt">&#160;</div></div><div class="clearfix"></div><div id="rid-0-0-0-27260" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-27260"></AnnotationDrawer><div>&#160;&#160;&#160;(b)&#160;&#160;&#160;<span style="font-weight: normal;font-style: italic;text-decoration:none;display: inline;">Reactive Charge.</span></div></div><div class="clearfix"></div><div id="rid-0-0-0-27261" class="rbox Normal-Level"><AnnotationDrawer recordId="0-0-0-27261"></AnnotationDrawer><div style="margin-bottom=10pt">&#160;<div class="xsl-table"><table cellSpacing="0" style="width: &#10;                  700px&#10;                ;"><colgroup><col width="27.429%&#10;              "></col><col width="27.429%&#10;              "></col><col width="27.429%&#10;              "></col></colgroup><tbody><tr><td style="word-wrap:break-word;padding-left:.075in;padding-right:.075in;padding-top:.022in;padding-bottom:.022in;border-top:1pt solid #000000;border-bottom:1pt solid #000000;border-left:1pt solid #000000;border-right:1pt solid #000000;"><div class="Table-Header"><div style="text-align:center;">Kilovar Per Month</div></div></td><td style="word-wrap:break-word;padding-left:.075in;padding-right:.075in;padding-top:.022in;padding-bottom:.022in;border-top:1pt solid #000000;border-bottom:1pt solid #000000;border-left:1pt solid #000000;border-right:1pt solid #000000;"><div class="Table-Header"><div style="text-align:center;">Summer
													
