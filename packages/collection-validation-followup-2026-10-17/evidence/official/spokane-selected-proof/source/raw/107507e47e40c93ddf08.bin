        			<p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-family:Calibri,sans-serif"><strong><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">CC4</span></span></strong></span></p>
        			</td>
        		</tr>
