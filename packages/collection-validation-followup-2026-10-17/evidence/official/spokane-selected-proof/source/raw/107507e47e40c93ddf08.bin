        			</td>
        			<td style="vertical-align:top">
        			<p>All Streets</p>
        			</td>
        			<td style="vertical-align:top">
        			<p>Type I, II, IV</p>
        			</td>
        			<td style="vertical-align:top">
        			<p>Type I, II, IV</p>
        			</td>
