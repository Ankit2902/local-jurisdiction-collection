        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Minimum FAR</span></span></span></p>
        			</td>
        			<td colspan="2" style="height:6.75pt; vertical-align:top; width:103.95pt">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">1</span></span></span></p>
        			</td>
        			<td colspan="2" style="height:6.75pt; vertical-align:top; width:101.65pt">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">1</span></span></span></p>
        			</td>
        			<td style="height:6.75pt; vertical-align:top; width:101.65pt">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">1</span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td colspan="2" style="height:6.75pt; vertical-align:top; width:74.05pt">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Maximum FAR</span></span></span></p>
        			</td>
        			<td colspan="2" style="height:6.75pt; vertical-align:top; width:103.95pt">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">No Maximum</span></span></span></p>
        			</td>
        			<td colspan="2" style="height:6.75pt; vertical-align:top; width:101.65pt">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">No Maximum</span></span></span></p>
        			</td>
        			<td style="height:6.75pt; vertical-align:top; width:101.65pt">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">No Maximum</span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td colspan="8" style="vertical-align:top; width:467.5pt">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">SETBACK STANDARDS</span></span></span></p>
        			</td>
        		</tr>
