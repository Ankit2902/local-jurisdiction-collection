        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol style="list-style-type:lower-alpha">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Large windows.</span></span></span></span></li>
