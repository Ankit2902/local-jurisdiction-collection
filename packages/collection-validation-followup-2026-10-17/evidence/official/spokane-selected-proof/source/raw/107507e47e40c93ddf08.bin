        			<td style="background-color:white; width:59.88%">
        			<p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Residential</span></span></span></p>
        			</td>
        			<td style="background-color:white; width:8.98%">
        			<p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">P</span></span></span></p>
        			</td>
        			<td style="background-color:white; width:9.54%">
        			<p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">P</span></span></span></p>
        			</td>
        			<td style="background-color:white; width:21.6%">
        			<p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">P</span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="background-color:white; width:59.88%">
        			<p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Hotels, including Bed and Breakfast Inns</span></span></span></p>
