        			</td>
        			<td style="vertical-align:top; width:107.75pt">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">N/A</span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="vertical-align:top; width:2.15in">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">Type</span></span></p>
        			</td>
        			<td colspan="2" style="vertical-align:top; width:204.95pt">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">4&rsquo; x 2&rsquo; scored concrete</span></span></p>
        			</td>
        			<td style="vertical-align:top; width:107.75pt">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">N/A</span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="vertical-align:top; width:2.15in">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">Clear Pedestrian Zone</span></span></p>
        			</td>
        			<td colspan="2" style="vertical-align:top; width:204.95pt">
