        		<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">E 29<sup>th</sup> Ave between S Martin St and S Fiske St</span></span></span></span></span></span></li>
