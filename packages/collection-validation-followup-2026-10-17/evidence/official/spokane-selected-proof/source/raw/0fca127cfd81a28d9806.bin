        		<li style="list-style-type:none">
        		<ol start="3" style="list-style-type:lower-alpha">
        			<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">The landscaped area counts toward parking lot interior landscaping requirements and toward any overall site landscaping requirements. However, the landscaped area does not count toward perimeter landscaping requirements.</span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
