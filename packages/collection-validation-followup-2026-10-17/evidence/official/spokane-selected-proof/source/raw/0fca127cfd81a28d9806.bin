        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="6" style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Heavy Industrial</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="7" style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Motor vehicle sales, rental, repair, or washing</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="8" style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Automotive parts and tires (with exterior storage or display)</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">No long-term bicycle parking is required for the following uses.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Park and open areas</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="2" style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Structured parking</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="3" style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Public parking lot</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="4" style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Drive-through business on pedestrian streets</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="5" style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Self-storage or warehouse</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="6" style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Mobile food vending</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="3" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Change of Use.</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">When the use of an existing building changes, bicycle parking shall be provided to meet the standards set forth in this section, except where the new number of required spaces is within ten percent of the existing number of spaces.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="4" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">The bicycle parking requirements of this section do not retroactively apply to established uses; however:</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">When increasing the floor area or other measures of bicycle parking requirements by addition or alteration, spaces, as required for the increase, shall be provided; and</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">The site to which a building is relocated must provide the required spaces.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="5" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Uses Not Mentioned.</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">In the case of a use not specifically mentioned in Table 17C.230.200-1&nbsp;or Table 17C.230.200-2, the requirements for bicycle parking shall be determined by the Planning Director.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="3" style="list-style-type:upper-alpha">
        	<li><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Short-term bicycle parking standards</span></span></span></span></li>
        </ol>
        
        <p style="margin-left:0.5in; margin-right:0in"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Short-term bicycle parking encourages shoppers, customers, and other visitors to use bicycles by providing a convenient and readily accessible place to park bicycles.</span></span></span></span></p>
        
        <ol style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Bicycle racks designed to accommodate two bicycles, such as an inverted-u rack, are considered two (2) bicycle parking spaces. </span></span></span></span></li>
        </ol>
        
        <ol start="2" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Short-term bicycle parking shall be placed on stable, firm, and slip-resistant surfaces consistent with ADA requirements.</span></span></span></span></li>
        </ol>
        
        <ol start="3" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">A bicycle rack must allow for the locking of the bicycle frame and one (1) wheel to the rack and shall support a bicycle in a stable position with a minimum of two points of contact to the bicycle frame and without damage to the wheels, frame, or components (see below for examples that meet and do not meet this requirement).</span></span></span></span></li>
        </ol>
        
        <p style="margin-left:0.5in; margin-right:0in"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><u><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><img src="data:image/png;base64," style="height:491px; width:624px" /></span></span></u></span></span></p>
        
        <ol start="4" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Short-term bicycle parking must be located:</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Within 50 feet of a main entrance; and</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">On-site or within the adjacent public right-of-way.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">If within the public right-of-way, bicycle racks must be entirely within the pedestrian buffer strip.</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="3" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Outside of a building or enclosure.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="4" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">As to not conflict with the opening of vehicle doors.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="5" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">At the same grade as the sidewalk or at a location that can be reached by an accessible route.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="6" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Short-term bicycle parking where the number of required spaces is based on the provided vehicle parking (see Basic Utilities and Parks and Open Space in Table 17C.230.200-1) shall be grouped and located within or adjacent to the vehicle parking area. </span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">If located within the vehicle parking area the bicycle racks shall be protected from vehicle interference such as the opening of car doors and potential collision by ensuring adequate space between vehicle parking stalls and bicycle parking. </span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="5" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Property owners and businesses located on the same side of the street and on the same block may establish a grouped bicycle parking area where short-term bicycle parking solutions may be implemented.</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">These areas shall be located no further than 200 feet from the main entrance of each business or property they intend to serve.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">The racks shall be at a location that can be reached by an accessible route.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="3" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Bicycle parking shall meet all other relevant standards of this section.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="6" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">If the development is unable to provide short-term bicycle parking as described, the developer may explore options such as:</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">On-site short-term bicycle parking beyond fifty (50) from the main entrance.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Bicycle parking located at the rear of the building.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="3" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Bicycle parking located within the building.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="4" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">As agreed between the applicant and the Planning Director.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="4" style="list-style-type:upper-alpha">
        	<li><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Long-term bicycle parking standards</span></span></span></span></li>
        </ol>
        
        <p style="margin-left:0.5in; margin-right:0in"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Long-term bicycle parking provides employees, students, residents, commuters, and others who generally stay at a site for several hours with a secure and weather-protected place to park bicycles.</span></span></span></span></p>
        
        <ol style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Long-term bicycle parking must be located:</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Within a building.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">On-site, including parking structures and garages; or</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="3" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Within three hundred (300) feet of the site.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="2" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">A garage dedicated exclusively to a residential unit may fulfill the requirements for one (1) long-term bicycle parking space.</span></span></span></span></li>
        </ol>
        
        <ol start="3" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Long-term bicycle parking must be provided in racks or lockers.</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">At least twenty-five percent (25%) of the racks must be horizontal to accommodate:</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Those who cannot lift a bicycle into a vertical position; and</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="2" style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Cargo, tandem, long-tailed, or similar bicycles that do not fit into vertical bicycle racks.</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="4" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Long-term bicycle parking spacing requirements.</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">For horizontal racks such as the inverted-u rack:</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">A minimum of three (3) feet parallel spacing between each rack; and </span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="2" style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">A minimum of five (5) feet perpendicular access aisle between rows of bicycle parking; and</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="3" style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">A minimum of two (2) feet six (6) inches of perpendicular spacing between bicycle racks and walls or obstructions; and</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="4" style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">A minimum of two (2) feet for user access between a wall or other obstruction and the side of the nearest parked bicycle.</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <p style="margin-left:0.5in; margin-right:0in"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><u><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><img src="data:image/png;base64," style="height:548px; width:530px" /></span></span></u></span></span></p>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">For vertical wall-mounted racks:</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">A minimum of three (3) feet parallel spacing between each rack; or, A minimum of one (1) foot six (6) inches parallel spacing combined with a minimum of an eight (8) inch vertical off-set between each rack; and</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="2" style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">A minimum of five (5) feet perpendicular access aisle between rows of bicycle parking; and</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="3" style="list-style-type:lower-roman; margin-left:40px">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">A minimum of one (1) foot six (6) inches for user access between a wall or other obstruction and the side of the nearest parked bicycle. </span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <p style="margin-left:120px; margin-right:0in"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><u><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><img src="data:image/png;base64," style="height:423px; width:557px" /></span></span></u></span></span></p>
        
        <p style="margin-left:120px; margin-right:0in"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><u><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><img src="data:image/png;base64," style="height:446px; width:557px" /></span></span></u></span></span></p>
        
        <p style="margin-left:120px; margin-right:0in"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><u><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><img src="data:image/png;base64," style="height:374px; width:532px" /></span></span></u></span></span></p>
        
        <ol start="5" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Long-term bicycle parking must be covered. The cover must be,</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Permanent; and</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Impervious.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="6" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Long-term bicycle parking shall be placed on floor and ground surfaces that are stable, firm, and slip resistant consistent with ADA requirements.</span></span></span></span></li>
        </ol>
        
        <ol start="7" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Long-term bike storage design details must be provided with site layouts to determine the number of bicycle parking spaces.</span></span></span></span></li>
        </ol>
        
        <ol start="8" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">To provide security the bicycle parking must be,</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">In a locked room; or</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">In an enclosure with a locked gate or door, the walls of the enclosure are to be at least eight (8) feet tall or be floor-to-ceiling; or</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="3" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">In a permanently anchored, enclosed, and secured bike locker.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="9" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Property owners and businesses located on the same block may establish a grouped bicycle parking area where long-term bicycle parking solutions may be implemented.</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">These areas shall be located no further than 300 feet from each site they intend to serve.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Bicycle parking shall be at a location that can be reached by an accessible route.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="3" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Bicycle parking shall meet all other relevant standards of this section.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="10" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Residential in-unit long-term bicycle parking does not count towards fulfilling the requirements of long-term bicycle parking.</span></span></span></span></li>
        </ol>
        
        <ol start="11" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">If a development is unable to meet the standards of this section, the applicant may seek relief subject to the Planning Director&rsquo;s discretion.</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">The applicant shall provide reasonable evidence as to why they are unable to fulfill the requirements of this section.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2" style="list-style-type:lower-alpha; margin-left:40px">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">The applicant and the Planning Director should first explore alternatives for locating bicycle parking prior to agreeing to full relief from the requirements of this section.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <table border="1" cellspacing="0" class="TableGridLight1" style="border-collapse:collapse; border:solid windowtext 1.0pt; width:100.0%">
        	<tbody>
        		<tr>
        			<td colspan="5" style="vertical-align:top; width:100.0%">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><strong><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">TABLE 17C.230.200-1<br />
        			BICYCLE PARKING BY USE</span></span></strong></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td colspan="5" style="background-color:#d9d9d9; width:100.0%">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><strong><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">RESIDENTIAL CATEGORIES</span></span></span></strong></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="vertical-align:top; width:15.72%">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><strong><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">USE CATEGORIES</span></span></strong></span></span></p>
        			</td>
        			<td style="vertical-align:top; width:21.46%">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><strong><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">SPECIFIC USES</span></span></strong></span></span></p>
        			</td>
        			<td style="vertical-align:top; width:21.44%">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><strong><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">REQUIRED SHORT-TERM BICYCLE PARKING [3]</span></span></strong></span></span></p>
        			</td>
        			<td style="vertical-align:top; width:21.44%">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><strong><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">BASELINE SHORT-TERM BICYCLE PARKING [3]</span></span></strong></span></span></p>
        			</td>
        			<td style="vertical-align:top; width:19.94%">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><strong><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">REQUIRED LONG-TERM BICYCLE PARKING</span></span></strong></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="width:15.72%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Group Living</span></span></span></span></p>
        			</td>
        			<td style="width:21.46%">&nbsp;</td>
        			<td style="width:21.44%">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">None</span></span></span></span></p>
        			</td>
        			<td style="width:21.44%">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">0</span></span></span></span></p>
        			</td>
        			<td style="width:19.94%">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">1 per 10 residents</span></span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="width:15.72%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Residential Household Living</span></span></span></span></p>
        			</td>
        			<td style="width:21.46%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Multifamily dwellings of ten or more units</span></span></span></span></p>
        			</td>
        			<td style="width:21.44%">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">None</span></span></span></span></p>
        			</td>
        			<td style="width:21.44%">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">0</span></span></span></span></p>
        			</td>
        			<td style="width:19.94%">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">0.5 per unit</span></span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td colspan="5" style="background-color:#d9d9d9; width:100.0%">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><strong><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">COMMERCIAL CATEGORIES</span></span></span></strong></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="vertical-align:top; width:15.72%">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><strong><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">USE CATEGORIES</span></span></strong></span></span></p>
        			</td>
        			<td style="vertical-align:top; width:21.46%">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><strong><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">SPECIFIC USES</span></span></strong></span></span></p>
        			</td>
        			<td style="vertical-align:top; width:21.44%">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><strong><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">REQUIRED SHORT-TERM BICYCLE PARKING [3]</span></span></strong></span></span></p>
