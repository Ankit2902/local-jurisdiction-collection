        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Univers,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Limited industrial</span></span></span></span></li>
        		</ol>
        		</li>
