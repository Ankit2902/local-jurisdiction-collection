        	<tbody>
        		<tr>
        			<td colspan="15" style="height:19.35pt; width:464.3pt">
        			<p style="margin-left:1.45pt; margin-right:0in; text-align:center"><strong>ADJACENT PROPERTY ZONE<br />
        			(horizontal)</strong></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="height:38.75pt; width:41.05pt">
        			<p style="margin-left:1.45pt"><strong>SUBJECT PROPERTY ZONE (vertical)</strong></p>
        			</td>
