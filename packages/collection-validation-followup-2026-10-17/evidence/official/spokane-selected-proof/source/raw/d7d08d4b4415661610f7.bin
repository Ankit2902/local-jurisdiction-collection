        			<p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">$840</span></span></span></p>
        			</td>
        			<td style="background-color:white; height:15.25pt; width:141.85pt">
        			<p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">$546</span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="background-color:white; height:15.25pt; width:148.5pt">
