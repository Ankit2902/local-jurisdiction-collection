        			<p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">$501 through $2,000</span></span></span></p>
        			</td>
