        			<p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">$210</span></span></span></p>
        			</td>
        			<td style="background-color:white; height:15.25pt; width:141.85pt">
        			<p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">$136.50</span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="background-color:white; height:15.25pt; width:148.5pt">
        			<p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">$2,001 through 5,000</span></span></span></p>
        			</td>
        			<td style="background-color:white; height:15.25pt; width:76.5pt">
        			<p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">$420</span></span></span></p>
        			</td>
        			<td style="background-color:white; height:15.25pt; width:141.85pt">
        			<p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">$273</span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="background-color:white; height:15.25pt; width:148.5pt">
        			<p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">$5,001 through $10,000</span></span></span></p>
