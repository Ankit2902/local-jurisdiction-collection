        		<script language="javascript" type="text/javascript">
        	function checkChildren(srcObj, vType) {
        		for (var i = 0; i < eval("document.formSMC." + vType + ".length"); i++) {
        			if ((eval("document.formSMC." + vType + "[i].value.substring(0, srcObj.length)") == srcObj) && (eval("document.formSMC." + vType + "[i].disabled") == false)) {
        					(eval("document.formSMC." + vType + "[i].checked")) ? eval("document.formSMC." + vType + "[i]").checked = false : eval("document.formSMC." + vType + "[i]").checked = true;
        			}
        		}
        		return false;
        	}
        function toggleRepealed(element) {
        	const rows = document.getElementById("hideRepealed").querySelectorAll('tr');
        	rows.forEach(function (row) {
        		var text = row.textContent;		
        		if (text.includes('REPEALED') && !row.classList.contains('hidden')) {
        			row.classList.add('hidden')
        		}
        		else {
        			row.classList.remove('hidden')
        		}
        	})
        }
        function HideRepealed() {
        	const rows = document.getElementById("hideRepealed").querySelectorAll('tr');
        	rows.forEach(function (row) {
        		var text = row.textContent;		
        		if (text.includes('REPEALED') && !row.classList.contains('hidden')) {
        			row.classList.add('hidden')
        		}
        	})
        }
        </script>
        <div style="padding: 15px;"><form action="/smc/" method="post" name="formSMC">
        <div id="hideRepealed">
        		<p><a href="/smc/?Title=17F">Title 17F</a> Construction Standards</p>
        				<p><a href="/smc/?Chapter=17F.080">Chapter 17F.080</a> Fire Code</p>
        					<a href="/smc/?Section=17F.080.040">Section 17F.080.040</a> Fire Marshal<br />
        <p style="margin-left:0in; margin-right:0in"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">The fire marshal is the fire official. The fire official is authorized and directed to:</span></span></span></span></span></span></p>
        
        <ol style="list-style-type:upper-alpha">
        	<li><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">inspect all premises for compliance with the fire code, and specifically all new businesses;</span></span></span></span></span></span></li>
        </ol>
        
        <ol start="2" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">initiate proceedings, including prosecutions and judicial or summary abatement actions, to enforce the fire code;</span></span></span></span></span></span></li>
        </ol>
        
        <ol start="3" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">make and promulgate rules, regulations and interpretations of the fire code and issue civil infractions to enforce any order, regulation or provision of this chapter.</span></span></span></span></span></span></li>
        </ol>
        
        <ol start="4" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">maintain records of fire safety inspections;</span></span></span></span></span></span></li>
        </ol>
        
        <ol start="5" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">administer within the City the laws regulating fireworks, with specific authority to postpone or delay a pyrotechnic display because of weather conditions or other reasons;</span></span></span></span></span></span></li>
        </ol>
        
        <ol start="6" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">seek search warrants upon a showing of probable cause specific to the dwelling unit or common area sought to be searched that criminal fire code violations exist when a tenant or landlord denies a fire official the right to search, as provided in RCW 59.18.150;</span></span></span></span></span></span></li>
        </ol>
        
        <ol start="7" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">seize explosives, improvised devices and components of explosives and improvised devices that are possessed, manufactured, delivered, imported, exported, stored, sold, purchased, transported, abandoned, detonated or used, or intended to be used, in violation of a provision of chapter 70.74 RCW.</span></span></span></span></span></span></li>
        </ol>
        
        <p>Date Passed: Monday, July 26, 2021</p><p>Effective Date: Monday, July 26, 2021</p><p>ORD C36091 Section 3</p>					<a href="/smc/?Section=17F.080.050">Section 17F.080.050</a> Fire Equipment Permit<br />
        <p style="margin-left:0in; margin-right:0in; text-align:justify">&nbsp;</p>
        
        <ol style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">In addition to any building, electrical, plumbing, or other permit issued by the Development Services Department, a person needs a permit from the fire official to install, alter, or repair required fire protection or fire detection systems or equipment that is regulated by this code.</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">The equipment to which this section applies includes, but is not limited to, any:</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol style="list-style-type:lower-alpha">
        			<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Code-required fire alarm,</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="2" style="list-style-type:lower-alpha">
        			<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Sprinkler,</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="3" style="list-style-type:lower-alpha">
        			<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Standpipe,</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="4" style="list-style-type:lower-alpha">
        			<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Range hood, or</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="5" style="list-style-type:lower-alpha">
        			<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Other extinguishing system.</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2">
        		<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Non-required systems are further defined below.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="3">
        		<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">A permit shall not be issued until payment of the permit fee, approval of plans where required, and payment of the appropriate plan check fee.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="4">
        		<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">If the&nbsp;Washington State fire marshal has charged a plan check fee for equipment he has approved, the applicant will not be charged a plan check fee for the same submittal by the City fire official.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="2" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">In order to verify, as provided in&nbsp;</span></span></span><a href="http://my.spokanecity.org/smc/?Section=08.02.034" style="color:blue; text-decoration:underline"><span style="background-color:white">SMC 8.02.034</span></a><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">, the value of the work upon which the permit and inspection fees are based, the fire official may require from the installer or from the owner of the property a verified copy of the invoice.</span></span></span></span></li>
        </ol>
        
        <ol style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Should it appear that an installer is understating the value of the work, and thereby underpaying the fees, the fire official may suspend the installer&rsquo;s right to receive a permit for up to six months.</span></span></span></span></li>
        </ol>
        
        <ol start="2" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Upon a second instance of undervaluation, suspension may be for up to one year.</span></span></span></span></li>
        </ol>
        
        <ol start="3" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Non-required fire alarm or fire sprinkler systems are those that are installed in a facility when they are not required by code. Non-required systems do not need to be submitted for review or permit, unless it is desired by the building owner.&nbsp; Non-required systems are required to be installed by a Spokane Fire Department registered contractor.</span></span></span></span></li>
        </ol>
        
        <p style="margin-left:0.5in; margin-right:0in; text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Exceptions.</span></span></span></span></p>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Fire sprinkler systems with seven or more heads.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2">
        		<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Inert gas suppression systems.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="4" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Non-required fire alarm and fire sprinkler systems that are submitted for review by the Spokane Fire Department shall be in accordance with NFPA 13, 13R, and 13D, NFPA 72, and the Spokane Municipal Code. Non-required systems will not be tracked for renewal on an annual basis unless requested by the owner or authorized representative.</span></span></span></span></li>
        </ol>
        
        <p style="margin-left:0in; margin-right:0in; text-align:justify">&nbsp;</p>
        
        <p>Date Passed: Monday, October 20, 2025</p><p>Effective Date: Friday, November 28, 2025</p><p>ORD C36753 Section 39</p>					<a href="/smc/?Section=17F.080.060">Section 17F.080.060</a> Other Permits<br />
        <p>Section 105.6 of the IFC lists the operational permits required from the fire official in connection with various occupancy uses and special processes, equipment, and subjects. Unless otherwise specified, these permits are valid for a calendar year.</p>
        <p>Date Passed: Monday, June 7, 2010</p><p>Effective Date: Thursday, July 1, 2010</p><p>ORD C34601 Section 4</p>					<a href="/smc/?Section=17F.080.070">Section 17F.080.070</a> Flammable or Combustible Liquids<br />
        <p>
        	Section 105.6.17 of the IFC is amended to read: Flammable or combustible liquids or critical materials: See chapter 57 and the City&rsquo;s aquifer protection ordinance (<a href="https://my.spokanecity.org/smc/?Chapter=17E.010">chapter 17E.010 SMC</a>). An operational permit is required.</p>
        
        <p>Date Passed: Monday, May 23, 2016</p><p>Effective Date: Thursday, June 30, 2016</p><p>ORD C35390 Section 3</p>					<a href="/smc/?Section=17F.080.080">Section 17F.080.080</a> Fire Code Appeals<br />
        <p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-size:16px"><span style="font-family:Arial,sans-serif">108.4 &ndash; Fire Code Appeals </span></span></p>
        
        <p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-size:16px"><span style="font-family:Arial,sans-serif">A decision of the fire official is final and conclusive unless an affected person files an appeal to the hearing examiner pursuant to <span style="color:#376092"><a href="https://my.spokanecity.org/smc/?Chapter=17G.050" style="color:#006699; text-decoration:none"><span style="color:#376092">Chapter 17G.050</span></a></span> within thirty days. </span></span></p>
        
        <p>Date Passed: Monday, October 14, 2019</p><p>Effective Date: Saturday, November 30, 2019</p><p>ORD C35816 Section 5</p>					<a href="/smc/?Section=17F.080.090">Section 17F.080.090</a> Additional Definitions – Section 202<br />
        <p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">There are added to IFC Section 202 the following definitions:</span></span></span></span></span></span></p>
        
        <ol start="1" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">&ldquo;Cellar&quot; is that portion of a building between floor and ceiling which is wholly or partly below grade and so located that the vertical distance from grade to the floor below is equal to or greater than the vertical distance from grade to ceiling, provided the space does not meet the definition of a basement as defined in the International Building Code.</span></span></span></span></span></span></li>
        </ol>
        
        <ol start="2" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">&quot;Central reporting system&quot; is an approved system or group of systems, the operation of which is signaled to, recorded in, maintained, and supervised from an approved central station in which there are competent and experienced observers and operators in attendance at all times whose duty it shall be, upon receipt of a signal, to call the fire department and to take such action as shall be required under the rules established for their guidance. Such systems shall be controlled and operated by a person, firm, or corporation whose principal business is the furnishing and maintaining of supervised protective signaling service and who has no interest in the protected properties. Such approved system must be listed with Underwriters Laboratories or other approved listing agency.</span></span></span></span></span></span></li>
        </ol>
        
        <ol start="3" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">&quot;Performance certificate&quot; is a statement by the installer certifying that a system has been installed as approved by the fire official and tested in accordance with manufacturer&rsquo;s specifications.</span></span></span></span></span></span></li>
        </ol>
        
        <ol start="4" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">&quot;Registered servicer&quot; is a natural person possessing a current license as provided in </span></span></span><a href="https://my.spokanecity.org/smc/?Section=17F.080.270"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">SMC 17F.080.270(A)</span></span></a><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"> and </span></span><a href="https://my.spokanecity.org/smc/?Section=10.29.060"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">SMC 10.29.060(A)</span></span></a><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">.</span></span></span></span></span></li>
        </ol>
        
        <ol start="5" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">&quot;Special areas to be protected&quot; are the following areas of a building, which present a special need for fire detection whether the space is provided with fire sprinklers or not:</span></span></span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Boiler and furnace rooms.</span></span></span></span></span></span></li>
        		<li><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Community kitchens.</span></span></span></span></span></span></li>
        		<li><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Community laundries.</span></span></span></span></span></span></li>
        		<li><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Custodial rooms.</span></span></span></span></span></span></li>
        		<li><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Locker rooms.</span></span></span></span></span></span></li>
        		<li><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Machine rooms.</span></span></span></span></span></span></li>
        		<li><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Parking garages.</span></span></span></span></span></span></li>
        		<li><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Public or community restrooms.</span></span></span></span></span></span></li>
        		<li><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Smoking rooms.</span></span></span></span></span></span></li>
        		<li><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Storage rooms.</span></span></span></span></span></span></li>
        		<li><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Supply rooms.</span></span></span></span></span></span></li>
        		<li><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Tool and shop areas.</span></span></span></span></span></span></li>
        		<li><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Trash rooms.</span></span></span></span></span></span></li>
        		<li><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Vertical shafts and adjacent spaces which convey fire.</span></span></span></span></span></span></li>
        		<li><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Public waiting areas.</span></span></span></span></span></span></li>
        		<li><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Mechanical and equipment rooms.</span></span></span></span></span></span></li>
        		<li><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Electrical, computer, and data rooms </span></span></span></span></span></span></li>
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Other rooms or spaces as the fire official may designate.</span></span></span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <p>Date Passed: Monday, December 7, 2020</p><p>Effective Date: Thursday, January 7, 2021</p><p>ORD C35989 Section 4</p>					<a href="/smc/?Section=17F.080.100">Section 17F.080.100</a> Fire Alarm System<br />
        <p>International Fire Code section 907 is augmented by Chart #907 titled "Fire Alarm System Requirements."</p>
        <p>Date Passed: Monday, June 7, 2010</p><p>Effective Date: Thursday, July 1, 2010</p><p>ORD C34601 Section 7</p>					<a href="/smc/?Section=17F.080.110">Section 17F.080.110</a> Fire Alarm System Requirements<br />
        <ol style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">The following Chart 907 depicts the minimum fire alarm system requirements for the City of Spokane. These requirements supplement the International Fire Code.</span></span></span></span></span></li>
        </ol>
        
        <ol start="2" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Where heights are noted, they are from the lowest level of fire department apparatus access to the floor elevation of the highest occupied level.</span></span></span></span></span></li>
        </ol>
        
        <ol start="3" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Existing fire alarm systems will be allowed to be used, replaced<u>,</u> and repaired without upgrade as long as they are properly maintained. Buildings that are altered or additions exceeding fifty percent of the building area will require the fire alarm system to be upgraded to the current requirements.</span></span></span></span></span></li>
        </ol>
        
        <ol start="4" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Smoke detectors will be the primary means of detection. Where environmental conditions warrant (rooms with moisture potential, outdoors, etc.) heat detectors are allowed. Smoke detectors in restrooms and janitor closets are discouraged.</span></span></span></span></span></li>
        </ol>
        
        <ol start="5" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Low frequency notification is required for sleeping areas.&nbsp; Where single/multiple station devices cannot provide a low frequency annunciation, then low frequency will be required to be provided by smoke detectors or low frequency bases.</span></span></span></span></li>
        </ol>
        
        <table align="left" border="1" class="Table" style="background:white; border:undefined; width:100.0%">
        	<tbody>
        		<tr>
        			<td colspan="2" style="background-color:white; width:99.36%">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-family:Calibri,sans-serif"><strong><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">CHART 907</span></span></strong></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="background-color:white; width:28.78%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><strong><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">OCCUPANCY</span></span></strong></span></p>
        			</td>
        			<td style="background-color:white; width:70.26%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><strong><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">REQUIREMENTS FOR FIRE ALARM</span></span></strong></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="background-color:white; width:28.78%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">All Except R3 and U</span></span></span></p>
        			</td>
        			<td style="background-color:white; width:70.26%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Atriums connecting more than two floors.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Lowest level of structure greater than sixty feet below grade.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Covered mall buildings.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Retroactive &ndash; IFC 1103.7.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#0d0d0d">Central monitoring for fire sprinkler systems with a minimum of one notification device, one manual pull station, and one smoke detector is required.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Smoke detection required in common areas and interior corridors used for required exits in occupancies required to have automatic fire alarm.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Heat detectors are not required in spaces provided with quick response sprinklers in occupancies required to have automatic fire alarm.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Special areas to be protected are required to have fire alarm in occupancies required to have automatic fire alarm &ndash; See&nbsp;</span></span><span style="color:black"><a href="https://my.spokanecity.org/smc/?Section=17F.080.090"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#006699">SMC 17F.080.090</span></span></a></span><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">.</span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="background-color:white; width:28.78%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Greater than seventy-five feet to floor</span></span></span></p>
        			</td>
        			<td style="background-color:white; width:70.26%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Tenant spaces exceeding one thousand square feet.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Voice notification is required.</span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="background-color:white; width:28.78%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Daycares</span></span></span></p>
        			</td>
        			<td style="background-color:white; width:70.26%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Less than or equal to fifty children &ndash; Single station smoke detection is required.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Greater than fifty children to ninety-nine &ndash; Automatic.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Voice notification is required if more than ninety-nine&nbsp; occupants</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Manual pull stations required at all exits of state licensed facilities.</span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="background-color:white; width:28.78%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">A1, A2, A3, A4, A5</span></span></span></p>
        			</td>
        			<td style="background-color:white; width:70.26%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Automatic if not provided with fire sprinklers, manual if provided with fire sprinklers: greater than or equal to three hundred people or more than one hundred persons above or below the lowest level of exit discharge.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Voice notification is required if occupancy is greater than or equal to one thousand people.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">No manual pull stations required if fully sprinklered.</span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="background-color:white; width:28.78%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">B</span></span></span></p>
        			</td>
        			<td style="background-color:white; width:70.26%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Automatic if greater than or equal to five hundred people.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Automatic if greater than or equal to one hundred people above or below exit level.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">No manual pull stations required if fully sprinklered.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Area contains Group B Ambulatory health care.</span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="background-color:white; width:28.78%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">E</span></span></span></p>
        			</td>
        			<td style="background-color:white; width:70.26%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Fifty-one or more occupants.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Voice notification is required if more than one hundred occupants.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Exception for manual pulls (907.2.3).</span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="background-color:white; width:28.78%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">F1, F2</span></span></span></p>
        			</td>
        			<td style="background-color:white; width:70.26%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Automatic if greater than five hundred persons above or below exit level.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">No manual pull stations required if fully sprinklered.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Automatic is required when occupancy is two or more stories in height.</span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="background-color:white; width:28.78%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">H1, H2, H3, H4</span></span></span></p>
        			</td>
        			<td style="background-color:white; width:70.26%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Not required unless other requirements apply.</span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="background-color:white; width:28.78%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">H5</span></span></span></p>
        			</td>
        			<td style="background-color:white; width:70.26%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Manual.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Automatic for highly toxic gases, organic peroxides and oxidizers.</span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="background-color:white; width:28.78%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">I1, I2, I3, I4</span></span></span></p>
        			</td>
        			<td style="background-color:white; width:70.26%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Automatic.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Manual pulls may be at staff-attended location.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Sleeping areas required to have single or multiple station smoke detection.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Manual pull stations required at all exits of State Licensed I4.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Automatic required in I4 occupancies with fifty one or more occupants.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Voice notification<u> </u>required in I4 occupancies with more than one hundred occupants.</span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="background-color:white; width:28.78%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">M</span></span></span></p>
        			</td>
        			<td style="background-color:white; width:70.26%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Automatic if greater than or equal to five hundred people.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Automatic if greater than or equal to one hundred people above or below exit level.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Automatic if greater than twelve thousand square feet.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">No manual pull stations required if fully sprinklered.</span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="background-color:white; width:28.78%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">R1, R2</span></span></span></p>
        			</td>
        			<td style="background-color:white; width:70.26%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Automatic &ndash; Five or more units/guest rooms.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Not required for less than three levels with each unit having independent (not shared) direct exit to exterior.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">One manual pull station per exit stair required if not fully sprinklered.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">ADA Type A units will be provided with accessible communications features.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">ADA Type B units will be pre-wired for building notification.</span></span></span></p>
        
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Audible signal low frequency in sleeping rooms complying with 907.5.2.1.3 of the 2021 International Fire Code.</span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="background-color:white; width:28.78%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">R3</span></span></span></p>
        			</td>
        			<td style="background-color:white; width:70.26%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Single station smoke detection in sleeping areas and in hallways outside of sleeping areas.</span></span></span></p>
        			</td>
        		</tr>
        		<tr>
        			<td style="background-color:white; width:28.78%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">S1, S2</span></span></span></p>
        			</td>
        			<td style="background-color:white; width:70.26%">
        			<p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Manual fire alarm required in Group S public and self-storage occupancies three stories or greater for interior corridors and interior common areas.</span></span></span></p>
        			</td>
        		</tr>
        	</tbody>
        </table>
        
        <p style="margin-left:0in; margin-right:0in">&nbsp;</p>
        
        <p>Date Passed: Monday, June 16, 2025</p><p>Effective Date: Wednesday, July 30, 2025</p><p>ORD C36695 Section 5</p>					<a href="/smc/?Section=17F.080.120">Section 17F.080.120</a> Elevator Shafts, Equipment Rooms, Machine Spaces, and Lobbies<br />
        <ol style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Elevator shafts and elevator equipment rooms are not required to be provided with automatic sprinklers only if:</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">they are of non-combustible construction; and</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">they meet the fire resistance ratings required by the International Building Code.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="2" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Elevator shafts, lobbies, machine space, and elevator equipment rooms shall be provided with smoke detection that will:</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">notify the building&rsquo;s fire alarm system; and</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">activate the recall operation of the elevator(s). </span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="3" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Existing elevators having a travel distance of less than twenty-five feet and with recall capabilities in buildings with a fire alarm system will be connected to the building fire alarm system to activate the recall function. At a minimum, Phase 1 recall is required to be provided with primary and alternate recall floors.</span></span></span></span></li>
        </ol>
        
        <ol start="4" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Fire Service Access elevators will be activated by any fire alarm activation device that is activated in the building.</span></span></span></span></li>
        </ol>
        
        <p>Date Passed: Monday, November 26, 2018</p><p>Effective Date: Thursday, January 3, 2019</p><p>ORD C35699 Section 6</p>					<a href="/smc/?Section=17F.080.130">Section 17F.080.130</a> Assembly Occupancies<br />
        <p>Whenever the fire official determines that an assembly occupancy without an alarm or fire sprinkler system would constitute an unreasonable risk to life because of building design, fire load, accessibility for fire fighting and rescue, location, mixed occupancy, occupant load, exit arrangement, panic potential or other considerations, the fire official may prescribe necessary fire safety measures, including an appropriate fire alarm or fire sprinkler system.</p>
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 7</p>					<a href="/smc/?Section=17F.080.140">Section 17F.080.140</a> Fire Alarm System Permits Required<br />
        <p>
        <ol type="A">
        <li>No person may install or alter a fire alarm system without an electrical permit as provided in <a href="http://my.spokanecity.org/smc/?Section=17F.050.020">SMC 17F.050.020</a>.<br />&nbsp; 
        <li>In addition, no person may install or alter a code-required fire alarm system without a fire equipment permit as provided in <a href="http://my.spokanecity.org/smc/?Section=17F.080.050">SMC 17F.080.050</a>. </li></ol>
        <p></p>
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 7</p>					<a href="/smc/?Section=17F.080.150">Section 17F.080.150</a> Installation Requirements<br />
        <p>
        	A person is required to install every fire alarm system in accordance with recognized standards mentioned in chapter 80 of the International Fire Code.</p>
        
        <p>Date Passed: Monday, May 23, 2016</p><p>Effective Date: Thursday, June 30, 2016</p><p>ORD C35390 Section 7</p>					<a href="/smc/?Section=17F.080.160">Section 17F.080.160</a> REPEALED (Dry Cell Batteries)<br />
        <p>Repealed by Ordinance C34601</p>
        <p>Date Passed: Monday, June 7, 2010</p><p>Effective Date: Thursday, July 1, 2010</p><p>ORD C34601 Section 11</p>					<a href="/smc/?Section=17F.080.170">Section 17F.080.170</a> REPEALED (Audible Signal)<br />
        <p>Repealed by Ordinance C34601</p>
        <p>Date Passed: Monday, June 7, 2010</p><p>Effective Date: Thursday, July 1, 2010</p><p>ORD C34601 Section 12</p>					<a href="/smc/?Section=17F.080.180">Section 17F.080.180</a> REPEALED (Interconnection to Sprinkler System)<br />
        <p>Repealed by Ordinance C34601</p>
        <p>Date Passed: Monday, June 7, 2010</p><p>Effective Date: Thursday, July 1, 2010</p><p>ORD C34601 Section 13</p>					<a href="/smc/?Section=17F.080.190">Section 17F.080.190</a> REPEALED (Acceptance Testing)<br />
        <p>Repealed by Ordinance C34601</p>
        <p>Date Passed: Monday, June 7, 2010</p><p>Effective Date: Thursday, July 1, 2010</p><p>ORD C34601 Section 14</p>					<a href="/smc/?Section=17F.080.200">Section 17F.080.200</a> Operating Instructions<br />
        <p>The installer must post on the premises, for convenient reference, directions for operating the alarm and for resetting the system and de-energizing the circuit after an alarm has sounded.</p>
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 7</p>					<a href="/smc/?Section=17F.080.210">Section 17F.080.210</a> REPEALED (Visual Signal)<br />
        <p>Repealed by Ordinance C34601</p>
        <p>Date Passed: Monday, June 7, 2010</p><p>Effective Date: Thursday, July 1, 2010</p><p>ORD C34601 Section 15</p>					<a href="/smc/?Section=17F.080.220">Section 17F.080.220</a> Incidental Functions<br />
        <p>
        <ol type="A">
        <li>A fire alarm system may be designed to perform incidental functions such as the release of self-opening or self-closing doors, cutting off fuel or power supplies, cutting off air-handling equipment, activating smoke control and turning on emergency lighting so long as the accomplishment of such incidental functions does not impair the effectiveness and reliability of the alarm-sounding devices in response to required sending stations.<br />&nbsp;</li>
        <li>Locking devices on stair tower or egress doors shall release upon activation of alarm system. </li></ol>
        <p></p>
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 7</p>					<a href="/smc/?Section=17F.080.230">Section 17F.080.230</a> REPEALED (Presignal Alarm)<br />
        <p>Repealed by Ordinance C34601</p>
        <p>Date Passed: Monday, June 7, 2010</p><p>Effective Date: Thursday, July 1, 2010</p><p>ORD C34601 Section 16</p>					<a href="/smc/?Section=17F.080.240">Section 17F.080.240</a> Central Reporting<br />
        <p>In addition to the qualifications for a central reporting system as provided in <a href="http://my.spokanecity.org/smc/?Section=17F.080.090">SMC 17F.080.090</a>, a central reporting agency must register with the fire department and pay the fee prescribed in <a href="http://my.spokanecity.org/smc/?Section=08.002.0226">SMC 8.02.0226</a>.</p>
        <p>Date Passed: Monday, June 4, 2007</p><p>Effective Date: Sunday, July 1, 2007</p><p>ORD C34040 Section 13</p>					<a href="/smc/?Section=17F.080.250">Section 17F.080.250</a> REPEALED (Alarm System Maintenance)<br />
        <p>Repealed by Ordinance C34601</p>
        <p>Date Passed: Monday, June 7, 2010</p><p>Effective Date: Thursday, July 1, 2010</p><p>ORD C34601 Section 17</p>					<a href="/smc/?Section=17F.080.260">Section 17F.080.260</a> Fire Protection System Verification<br />
        <ol style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">A person responsible for a fire protection system requiring inspection by a state-licensed and Spokane fire department registered fire equipment servicer must submit to the fire department the servicer&rsquo;s report and the verification fee as established in <a href="http://my.spokanecity.org/smc/?Section=08.02.034"><span style="color:blue">SMC 8.02.034(F)</span></a>. Upon receipt of the report and the fee, the fire department:</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">verifies that the service was performed by a state-licensed servicing company registered with the fire department as a fire equipment servicer;</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">reviews the servicer&rsquo;s report to determine if the service was successful with no deficiencies;</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="3">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">in the event there are deficiencies, provides an inspection, either on-site or by phone, and verifies the necessary correction; and</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="4">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">maintains service records in a databank.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="2" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Any person responsible for a fire protection system requiring inspection by a registered fire equipment servicer who fails or refuses to comply with any of the requirements of this section is subject to a civil infraction pursuant to <a href="http://my.spokanecity.org/smc/?Chapter=01.05"><span style="color:blue">chapter 1.05 SMC</span></a>.</span></span></span></span></li>
        </ol>
        
        <ol start="3" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Verification fees generated under <a href="http://my.spokanecity.org/smc/?Section=08.02.034"><span style="color:blue">SMC 8.02.034(F)</span></a> are allocated by the fire department toward the expense of enforcing fire protection system regulations.</span></span></span></span></li>
        </ol>
        
        <ol start="4" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">For purposes of this chapter, a fire protection system includes, but is not limited to, fire detection or fire suppression equipment approved by the fire department.</span></span></span></span></li>
        </ol>
        
        <p>Date Passed: Monday, June 7, 2010</p><p>Effective Date: Thursday, July 1, 2010</p><p>ORD C34601 Section 18</p>					<a href="/smc/?Section=17F.080.270">Section 17F.080.270</a> Fire Equipment Servicer Registration<br />
        <p style="margin-left:0in; margin-right:0in"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">A person proposing to engage in the occupation of installation, repair and maintenance of fire department regulated equipment or systems is required to pay the fee prescribed&nbsp;in&nbsp;</span></span><span style="color:black"><a href="https://my.spokanecity.org/smc/?Section=08.02.0226" style="color:#0563c1; text-decoration:underline"><span style="font-family:&quot;Arial&quot;,sans-serif">SMC 8.02.0226</span></a></span><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">&nbsp;and&nbsp;obtain from the fire official the appropriate registrations as follows:</span></span></span></span></p>
        
        <ol style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Portable extinguisher.</span></span></span></span></li>
        </ol>
        
        <ol start="2" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Range hood/extinguishing system.</span></span></span></span></li>
        </ol>
        
        <ol start="3" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Sprinkler system.</span></span></span></span></li>
        </ol>
        
        <ol start="4" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Standpipe system (including horizontal dry standpipes)</span></span></span></span></li>
        </ol>
        
        <ol start="5" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Underground tank decommission.</span></span></span></span></li>
        </ol>
        
        <ol start="6" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Underground tank (install, upgrade or repair); and</span></span></span></span></li>
        </ol>
        
        <ol start="7" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Underground tank test.</span></span></span></span></li>
        </ol>
        
        <ol start="8" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Private Fire Hydrants.</span></span></span></span></li>
        </ol>
        
        <ol style="list-style-type:upper-roman">
        	<li style="text-align:justify"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Aboveground tank (install, upgrade or repair).</span></span></span></span></li>
        </ol>
        
        <ol start="10" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Smoke Control.</span></span></span></span></li>
        </ol>
        
        <p>Date Passed: Monday, June 16, 2025</p><p>Effective Date: Wednesday, July 30, 2025</p><p>ORD C36695 Section 6</p>					<a href="/smc/?Section=17F.080.271">Section 17F.080.271</a> Fire Alarm Designer Registration<br />
        <p>A person proposing to engage in the occupation for the design of fire alarm systems is required to pay the fee prescribed in <a href="http://my.spokanecity.org/smc/?Section=08.02.0226">SMC 8.02.0226</a> and obtain from the fire official the appropriate registration.</p>
        <p>Date Passed: Monday, May 5, 2008</p><p>Effective Date: Sunday, June 8, 2008</p><p>ORD C34229 Section 11</p>					<a href="/smc/?Section=17F.080.275">Section 17F.080.275</a> Fire Alarm Testing Registration<br />
        <p>During the course of a fire alarm installation, including all subsequent modifications and annual testing, persons conducting programming and testing are required to pay the fee prescribed in <a href="http://my.spokanecity.org/smc/?Section=08.02.0226">SMC 8.02.0226</a> and obtain from the fire official the appropriate registration.</p>
        <p>Date Passed: Monday, July 9, 2012</p><p>Effective Date: Saturday, August 18, 2012</p><p>ORD C34884 Section 5</p>					<a href="/smc/?Section=17F.080.280">Section 17F.080.280</a> Securing Fire-damaged Buildings<br />
        <p>
        <ol type="A">
        <li>All fire-damaged buildings posing a safety issue must be immediately secured, boarded, or demolished. The fire department makes every effort to contact the owner to protect the structure as indicated.<br />&nbsp;</li>
        <li>If necessary, the fire department may utilize the services of a contractor. The cost of such boarding or demolition is the responsibility of the owner. </li></ol>
        <p></p>
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 7</p>					<a href="/smc/?Section=17F.080.290">Section 17F.080.290</a> Maintenance Records<br />
        <p>The technician performing the testing and maintenance of a fire alarm system must keep a record as prescribed by the fire official. In the case of an electrically supervised system, the owner must post the record at the alarm panel and file a copy with the fire official within five working days.</p>
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 7</p>					<a href="/smc/?Section=17F.080.300">Section 17F.080.300</a> Retail Storage and Sale of Matches and Lighters<br />
        <p>
        <ol type="A">
        <li>Disposable lighters may not be sold at retail without being child resistant.<br />&nbsp;</li>
        <li>All matches and lighters for sale at a retail outlet must be stored and displayed a minimum of four feet off the floor or in plain, constant view of retail sales clerks. </li></ol>
        <p></p>
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 7</p>					<a href="/smc/?Section=17F.080.310">Section 17F.080.310</a> Fire Department Connections<br />
        <p>Fire department connections for new standpipes shall be located no more than one hundred feet from a fire hydrant along an accessible path of travel unless where approved by the fire official. Fire department connections for new fire sprinkler system installations shall be located no more than five hundred feet from a fire hydrant along an accessible path of travel unless where approved by the fire official.</p>
        <p>Date Passed: Monday, June 17, 2013</p><p>Effective Date: Monday, July 1, 2013</p><p>ORD C34993 Section 8</p>					<a href="/smc/?Section=17F.080.320">Section 17F.080.320</a> Fire Hydrant Proximity to Access Road<br />
        <p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Fire hydrants shall be no further than fifteen feet from the edge of an approved fire department access road/lane to the pumper port, with an approved access pathway.</span></span></span></span></span></span></p>
        
        <p>Date Passed: Monday, December 7, 2020</p><p>Effective Date: Thursday, January 7, 2021</p><p>ORD C35989 Section 7</p>					<a href="/smc/?Section=17F.080.321">Section 17F.080.321</a> REPEALED (Fire Hydrant Proximity to Residential Infill Properties)<br />
        <p>
        	Repealed by ORD C35390<o:p></o:p></p>
        
        <p>Date Passed: Monday, May 23, 2016</p><p>Effective Date: Thursday, June 30, 2016</p><p>ORD C35390 Section 9</p>					<a href="/smc/?Section=17F.080.330">Section 17F.080.330</a> Reimbursement for Fire Response<br />
        <ol style="list-style-type:upper-alpha">
        	<li><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#212529">The Spokane fire department may collect reimbursement for:</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#212529">fire response and extinguishment costs of malicious or illegal fires from the perpetrators of such fires;</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2">
        		<li><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#212529">hazardous materials response and mitigation measures from responsible parties of such incidents;</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="3">
        		<li><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#212529">false alarms (initiation of an actual response to facility or residence, including);</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol>
        			<li><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#212529">Unnecessary fire response to unmaintained fire protection systems;</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="2">
        			<li><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#212529">Negligently or accidentally activated signals.</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="3">
        			<li><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#212529">Signals which are the result of faulty, malfunctioning or improperly installed, secured or maintained equipment.</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="4">
        			<li><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#212529">Signals which are the result of improperly installed, secured or maintained windows or doors or similar general areas of the building.</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="5">
        			<li><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#212529">Signals or calls which are purposely activated to summon the Fire Department in non-emergency situations.</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="6">
        			<li><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#212529">Signals being activated by persons working on the alarm system without prior notice to the Police Department and/or Fire Department,</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="7">
        			<li><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#212529">If fire response is in progress and is cancelled, the response may be considered a false alarm.</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="4">
        		<li><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#212529">fire response to and extinguishment costs of a violation of the fireworks code.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="5">
        		<li><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#212529">Special event costs for standby crews or ped-med when they are provided.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="2" style="list-style-type:upper-alpha">
        	<li><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#212529">Nuisance alarms that occur more than 3 times in any four weeks may be subject to response apparatus reimbursement costs and an additional $500 per nuisance alarm depending on the circumstance or investigation findings related to the nuisance alarm. Reimbursement costs can be waived if the dollars are spent on repairs to prevent nuisance alarms.</span></span></span></span></li>
        </ol>
        
        <ol start="3" style="list-style-type:upper-alpha">
        	<li><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#212529">Reimbursement will include, in addition to any cost of equipment damaged or destroyed, the current charge for emergency response apparatus involved in the response, as published by the Washington State Association of Fire Chiefs and the hourly rate for personnel, including wages and benefits.</span></span></span></span></li>
        </ol>
        
        <p>&nbsp;</p>
        
        <p>Date Passed: Monday, June 16, 2025</p><p>Effective Date: Wednesday, July 30, 2025</p><p>ORD C36695 Section 7</p>					<a href="/smc/?Section=17F.080.340">Section 17F.080.340</a> REPEALED (Tank Vehicle – Permit)<br />
        <p>Repealed by ORD C34488</p>
        <p>Date Passed: Monday, October 19, 2009</p><p>Effective Date: Sunday, November 22, 2009</p><p>ORD C34488 Section 39</p>					<a href="/smc/?Section=17F.080.350">Section 17F.080.350</a> REPEALED (LPG Vehicles)<br />
        <p>Repealed by ORD C34488</p>
        <p>Date Passed: Monday, October 19, 2009</p><p>Effective Date: Sunday, November 22, 2009</p><p>ORD C34488 Section 40</p>					<a href="/smc/?Section=17F.080.360">Section 17F.080.360</a> Private Hydrants – Unauthorized Use<br />
        <p>No person may operate or otherwise use a private hydrant, except in a manner and subject to such conditions as the fire official may require.</p>
        <p>Date Passed: Monday, June 7, 2010</p><p>Effective Date: Thursday, July 1, 2010</p><p>ORD C34601 Section 21</p>					<a href="/smc/?Section=17F.080.370">Section 17F.080.370</a> Private Hydrants – Inspection – Installation<br />
        <p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">All private hydrants are subject to inspection and approval by the City water department at the time of installation. A fee for inspection or other City services is charged as set forth in&nbsp;</span></span></span><a href="https://my.spokanecity.org/smc/?Section=08.02.034"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">SMC 8.02.034</span></span></a><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">.</span></span></span></span></span></p>
        
        <p>Date Passed: Monday, December 7, 2020</p><p>Effective Date: Thursday, January 7, 2021</p><p>ORD C35989 Section 8</p>					<a href="/smc/?Section=17F.080.380">Section 17F.080.380</a> Private Hydrants – Regulations<br />
        <p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">The fire official, with the assistance of the director of water, is authorized to establish regulations and design standards for private hydrants. These officials have the authority to interpret and apply the regulations and standards and to make rulings and orders consistent with the purpose of this chapter.</span></span></span></span></span></span></p>
        
        <p>Date Passed: Monday, December 7, 2020</p><p>Effective Date: Thursday, January 7, 2021</p><p>ORD C35989 Section 9</p>					<a href="/smc/?Section=17F.080.390">Section 17F.080.390</a> Private Hydrants – Semi-annual Inspection<br />
        <p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Property owners with private hydrants are responsible to obtain semi-annual, satisfactory inspection of their private hydrant(s) from a qualified inspector. Inspection procedures and forms for inspection by the City or others are set by the fire official with the assistance of the director of water. The fire official may order additional inspections as deemed necessary.</span></span></span></span></span></span></p>
        
        <p>Date Passed: Monday, December 7, 2020</p><p>Effective Date: Thursday, January 7, 2021</p><p>ORD C35989 Section 10</p>					<a href="/smc/?Section=17F.080.400">Section 17F.080.400</a> Inspection Reports of Private Hydrants<br />
        <p>
        	Inspection reports of private hydrants are the responsibility of the owner and must be submitted to the fire department within five working days.</p>
        
        <p>Date Passed: Monday, May 23, 2016</p><p>Effective Date: Thursday, June 30, 2016</p><p>ORD C35390 Section 13</p>					<a href="/smc/?Section=17F.080.410">Section 17F.080.410</a> Private Hydrants – Damage – Malfunction<br />
        <p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Property owners, their agents and tenants with private hydrants as well as registered fire hydrant servicers shall immediately contact the fire department in the event a private hydrant is damaged, malfunctions, or is otherwise out of order. &quot;Immediately&quot; means not more than forty-eight hours after a problem is noticed or should have been noticed in the exercise of reasonable care.</span></span></span></span></span></span></p>
        
        <p>Date Passed: Monday, December 7, 2020</p><p>Effective Date: Thursday, January 7, 2021</p><p>ORD C35989 Section 11</p>					<a href="/smc/?Section=17F.080.420">Section 17F.080.420</a> Private Hydrants – Maintenance and Repair<br />
        <p>All maintenance and repair of private hydrants shall be solely the responsibility of the property owner. Obligations imposed upon property owners apply also to their managers and other authorized agents.</p>
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 7</p>					<a href="/smc/?Section=17F.080.430">Section 17F.080.430</a> REPEALED (Private Hydrants – Access)<br />
        <p>
        	Repealed by ORD C35390<o:p></o:p></p>
        
        <p>Date Passed: Monday, May 23, 2016</p><p>Effective Date: Thursday, June 30, 2016</p><p>ORD C35390 Section 14</p>					<a href="/smc/?Section=17F.080.440">Section 17F.080.440</a> REPEALED (Basements)<br />
        <p>Repealed by ORD C34993.</p>
        <p>Date Passed: Monday, June 17, 2013</p><p>Effective Date: Monday, July 1, 2013</p><p>ORD C34993 Section 9</p>					<a href="/smc/?Section=17F.080.450">Section 17F.080.450</a> REPEALED (Basement Extinguishing System – Exceptions)<br />
        <p>Repealed by ORD C34229</p>
        <p>Date Passed: Monday, May 5, 2008</p><p>Effective Date: Sunday, June 8, 2008</p><p>ORD C34229 Section 13</p>					<a href="/smc/?Section=17F.080.455">Section 17F.080.455</a> Basement Extinguishing System<br />
        <p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Fire sprinklers are required in existing basements exceeding one thousand five hundred square feet.&nbsp;Fire Sprinklers are not required for the following:</span></span></span></span></span></span></p>
        
        <ol style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">A basement or cellar area that exceeds a gross floor area of one thousand five hundred square feet is divided into two areas so that one space is usable and the other space void. The usable space shall not exceed one thousand five hundred square feet. The usable space must contain an approved exit and must be separated by approved one-hour walls. The access to the void space may not exceed thirty inches by thirty inches and must be a listed and labeled access panel. No storage or other use of the void space is allowed. The occupancy of the usable space will be subject to all other provisions of the building and fire code.</span></span></span></span></span></span></li>
        </ol>
        
        <ol start="2" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">No electrical panels or equipment are allowed in the void space unless the void space is equipped with automatic fire sprinklers. </span></span></span></span></span></span></li>
        </ol>
        
        <ol start="3" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">A basement or cellar area that exceeds a gross floor area of one thousand five hundred square feet and is provided with exits directly to the exterior at floor grade that are within travel distance of 75 feet of all points in the basement.</span></span></span></span></span></span></li>
        </ol>
        
        <p>Date Passed: Monday, December 7, 2020</p><p>Effective Date: Thursday, January 7, 2021</p><p>ORD C35989 Section 12</p>					<a href="/smc/?Section=17F.080.460">Section 17F.080.460</a> REPEALED (	Basement Extinguishing System – Minimum Requirements)<br />
        <p>Repealed by ORD C34229</p>
        <p>Date Passed: Monday, May 5, 2008</p><p>Effective Date: Sunday, June 8, 2008</p><p>ORD C34229 Section 14</p>					<a href="/smc/?Section=17F.080.470">Section 17F.080.470</a> Hydraulic Calculation Design Contingency<br />
        <p>Hydraulic calculations submitted to the fire department for fire sprinkler permitting shall include a ten percent contingency for unknowns and water pressure fluctuation.</p>
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 7</p>					<a href="/smc/?Section=17F.080.471">Section 17F.080.471</a> Fire Sprinkler System Remote Test Connection<br />
        <p>Fire sprinkler systems will be provided with a remote test connection that will be located at the end of the most distant sprinkler pipe in the upper story and shall be equipped with a readily accessible shutoff valve and plug and will be capable of full flow without damage to structure or site. The remote test connection can be used in lieu of the inspector’s test connection on the riser.</p>
        <p>Date Passed: Monday, June 4, 2007</p><p>Effective Date: Sunday, July 1, 2007</p><p>ORD C34040 Section 17</p>					<a href="/smc/?Section=17F.080.472">Section 17F.080.472</a> Combined Fire Service Mains<br />
        <p>Fire service mains that also supply domestic water and other systems shall include the water demand for those systems including irrigation systems or be provided with a fire department approved method of isolating those demands.</p>
        <p>Date Passed: Monday, June 4, 2007</p><p>Effective Date: Sunday, July 1, 2007</p><p>ORD C34040 Section 18</p>					<a href="/smc/?Section=17F.080.473">Section 17F.080.473</a> Hydraulic Calculation Water Flow Test<br />
        <p>Water supply for fire department use will conform to Appendix B of the IFC. The available site fire flow for fire sprinkler hydraulic calculations shall be verified with site fire flow tests conducted no more than three years prior to permit application.</p>
        <p>Date Passed: Monday, June 4, 2007</p><p>Effective Date: Sunday, July 1, 2007</p><p>ORD C34040 Section 19</p>					<a href="/smc/?Section=17F.080.480">Section 17F.080.480</a> Standpipes<br />
        <p style="margin-left:0in; margin-right:0in"><span style="font-family:Calibri,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Where standpipes are used, the outlet pressure at the top of the riser shall be not less than one hundred PSI provided by a fire pump.</span></span></span></span></p>
        
        <p style="margin-left:0in; margin-right:0in"><span style="background-color:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><strong><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Exception:</span></span></span></strong></span></span></p>
        
        <p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="background-color:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Buildings up to and including five floors above grade (not to exceed 75 feet) will be pressurized by the fire apparatus upon arrival to the site and are not required to provide one hundred PSI at the top outlet of the riser.</span></span></span></span></span></p>
        
        <p style="margin-left:0in; margin-right:0in; text-align:justify">&nbsp;</p>
        
        <p>Date Passed: Monday, June 16, 2025</p><p>Effective Date: Wednesday, July 30, 2025</p><p>ORD C36695 Section 8</p>					<a href="/smc/?Section=17F.080.490">Section 17F.080.490</a> Licensed Cannabis Processor Extraction Requirements<br />
        <ol type="A">
        	<li>
        		<p>
        			It shall be unlawful for any person to process or manufacture cannabis<u> </u>concentrate in the City of Spokane in a manner authorized by WAC 314-55-104 who is not a processor licensed by the Washington State Liquor Control Board. Such processors shall be required to use in their processing/manufacturing process a closed loop system that utilizes equipment specifically listed for such use by a nationally recognized testing and certification company, and which has been approved and inspected by Fire Department officials to ensure compliance with all fire safety regulations and codes within the State of Washington and City of Spokane</p>
        	</li>
        	<li>
        		<p>
        			Licensed processors shall acquire an annual operating permit from the City of Spokane Fire Department for the use and maintenance of cannabis extraction systems that use hazardous or dangerous products as the medium of extraction.</p>
        	</li>
        </ol>
        
        <p>Date Passed: Monday, May 23, 2016</p><p>Effective Date: Thursday, June 30, 2016</p><p>ORD C35390 Section 16</p>				<p><a href="/smc/?Chapter=17F.090">Chapter 17F.090</a> Mechanical Code</p>
        					<a href="/smc/?Section=17F.090.010">Section 17F.090.010</a> Adoption of International Mechanical Code<br />
        <p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-size:16px"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">The current adopted Editions of the<u> </u>International Mechanical Code (IMC) and the International Fuel Gas Code (IFGC) published by the International Code Council, as modified by chapter 51-52 WAC and the additions, deletions, and amendments set forth in this chapter, are the mechanical code of the City.</span></span></span></p>
        
        <p>Date Passed: Monday, May 11, 2020</p><p>Effective Date: Sunday, June 14, 2020</p><p>ORD C35899 Section 11</p>					<a href="/smc/?Section=17F.090.020">Section 17F.090.020</a> Organization and Enforcement<br />
        <p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Section 104 of the IMC is deleted.</span></span></span></span></p>
        
        <ol style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">The mechanical inspector is the building official or a designated employee.</span></span></span></span></li>
        </ol>
        
        <ol start="2" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">The mechanical inspector has responsibility to:</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">process applications for permits;</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">inspect and test appliances, equipment and installations;</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="3">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">make and promulgate rules, regulations and interpretations for the mechanical code;</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="4">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">initiate proceedings, including prosecutions, to enforce the mechanical code;</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="5">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">maintain records of permits, licenses and other administrative activities;</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="6">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">provide clerical assistance to the board of heating mechanical examiners.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="3" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">The board of heating mechanical examiners has jurisdiction over mechanics licenses, as provided in <a href="http://my.spokanecity.org/smc/?Section=04.06.150"><span style="color:blue">SMC 4.06.150</span></a> through <a href="http://my.spokanecity.org/smc/?Section=04.06.180"><span style="color:blue">4.06.180</span></a>.</span></span></span></span></li>
        </ol>
        
        <ol start="4" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">The hearing officer and construction review board have jurisdiction over the mechanical code, except licensing, as provided in <a href="http://my.spokanecity.org/smc/?Chapter=04.06"><span style="color:blue">chapter 4.06 SMC</span></a>.</span></span></span></span></li>
        </ol>
        
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 8</p>					<a href="/smc/?Section=17F.090.030">Section 17F.090.030</a> Permits<br />
        <p>In addition to IMC Sections 106.1 and 106.2, no person may install, remove, alter, repair or replace any system regulated by the mechanical code which actively utilizes solar energy without a building, mechanical or combination building permit.</p>
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 8</p>					<a href="/smc/?Section=17F.090.040">Section 17F.090.040</a> Fees<br />
        <p>IMC Section 106.5 is deleted.</p>
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 8</p>					<a href="/smc/?Section=17F.090.050">Section 17F.090.050</a> Conversion Burners<br />
        <p style="margin-left:0in; margin-right:0in; text-align:justify">&nbsp;</p>
        
        <p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">In addition to IMC Section 107, no person may put a gas-fired conversion burner into final operation until the burners and controls have been tested and adjusted within the limits prescribed by the Development Services Department and the gas utility and until a copy of a satisfactory conversion burner test record is filed with the mechanical inspector prior to or at the time of final inspection.</span></span></span></span></p>
        
        <p style="margin-left:0in; margin-right:0in; text-align:justify">&nbsp;</p>
        
        <p>Date Passed: Monday, October 20, 2025</p><p>Effective Date: Friday, November 28, 2025</p><p>ORD C36753 Section 40</p>					<a href="/smc/?Section=17F.090.060">Section 17F.090.060</a> Inspection Following Nonuse of Gas<br />
        <p>Whenever gas has not been used in premises already piped therefor for a year or more, a new permit and inspection is required for turning on gas service.</p>
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 8</p>					<a href="/smc/?Section=17F.090.070">Section 17F.090.070</a> Unapproved Work<br />
        <ol style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Whenever the inspector finds materials used or work performed which does not conform to this code, the inspector rejects the work and orders the permittee, in person or by phone, and later in writing if requested, to make all corrections in materials and workmanship necessary to satisfy this code within fifteen days, or within such longer time as the inspector may grant for good cause, unless the permittee timely appeals to the hearing officer.</span></span></span></span></li>
        </ol>
        
        <ol start="2" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Whenever the inspector finds any fuel gas piping, venting system, mechanical appliance or equipment:</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">being used or maintained in a dangerous or unsafe condition; or</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">being installed, altered or extended without a proper permit or by an unauthorized person;</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">the inspector notifies the building official. The building official gives written notice to the owners of the premises and the contractor to take corrective action in a specified time.</span></span></span></span></p>
        
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 8</p>					<a href="/smc/?Section=17F.090.080">Section 17F.090.080</a> Miscellaneous Requirements<br />
        <p>
        <ol type="A">
        <li>A new gas appliance is considered approved if marked or labeled with a distinctive trademark or name as a means of identification, which shows approval by AGA or UL and shows the rated heat input in BTUs per hour.<br />&nbsp;</li>
        <li>Propane-fueled hot water heaters and heating appliances must be equipped with an AGA-approved complete shutoff type automatic pilot, unless the appliance is installed on the exterior of a building or in an uninhabited building when approved by the inspector.<br />&nbsp;</li>
        <li>A used gas appliance may not be installed for use on a consumer’s premises until approved by the inspector and identified accordingly.<br />&nbsp;</li>
        <li>No appliance may ever be fired or adjusted to pass a greater amount of gas than its rated capacity. </li></ol>
        <p></p>
        <p>Date Passed: Monday, June 7, 2010</p><p>Effective Date: Thursday, July 1, 2010</p><p>ORD C34600 Section 18</p>					<a href="/smc/?Section=17F.090.090">Section 17F.090.090</a> Underground Piping<br />
        <p>
        <ol type="A">
        <li>A gas line entering a building underground without first rising above ground must pass through a vented pit or encasement directly adjacent to the building or be vented by means of a curb box.<br />&nbsp;</li>
        <li>A gas line entering a building underground must be sealed gas tight at the building line in a manner approved by the building services department. </li></ol>
        <p></p>
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 8</p>					<a href="/smc/?Section=17F.090.100">Section 17F.090.100</a> Economy Devices<br />
        <p>No person may install or use any device, accessory, or addition to a gas appliance in such a manner as to reduce the effectiveness of ignition of the gas issuing from the burner or to impair combustion of the burner.</p>
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 8</p>				<p><a href="/smc/?Chapter=17F.100">Chapter 17F.100</a> Plumbing Code</p>
        					<a href="/smc/?Section=17F.100.010">Section 17F.100.010</a> Adoption of Uniform Plumbing Code<br />
        <ol style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:16px"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif">The Uniform Plumbing Code (UPC), current adopted Edition, and related standards published by the International Association of Plumbing and Mechanical Officials, as modified by chapter 51-56 WAC and the additions, deletions, and amendments set forth in this chapter, is the plumbing code of the City.</span></span></span></li>
        </ol>
        
        <ol start="2" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:16px"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif">Portions of the UPC not adopted are:</span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="text-align:justify"><span style="font-size:16px"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif">Chapters 12 and 15;</span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2">
        		<li style="text-align:justify"><span style="font-size:16px"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif">Combustion air and venting of appliances in Chapter 5; and</span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="3">
        		<li style="text-align:justify"><span style="font-size:16px"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif">Portions of the Code addressing building sewers.</span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="3" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:16px"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif">Appendices A, B, and I of the UPC are adopted as part of the code.</span></span></span></li>
        </ol>
        
        <p>Date Passed: Monday, May 11, 2020</p><p>Effective Date: Sunday, June 14, 2020</p><p>ORD C35899 Section 12</p>					<a href="/smc/?Section=17F.100.020">Section 17F.100.020</a> Permit Required<br />
        <p>In supplementation of UPC Section 103.1, a person must obtain a permit to install, alter, replace or remove any:</p>
        <ol type="A">
        <li>plumbing fixture,<br />&nbsp;</li>
        <li>waste-discharging device,<br />&nbsp;</li>
        <li>waste pipe,<br />&nbsp;</li>
        <li>special waste pipe,<br />&nbsp;</li>
        <li>soil pipe,<br />&nbsp;</li>
        <li>vent pipe,<br />&nbsp;</li>
        <li>house drain,<br />&nbsp;</li>
        <li>rainwater leader or system,<br />&nbsp;</li>
        <li>water distribution system,<br />&nbsp;</li>
        <li>lawn sprinkling system,<br />&nbsp;</li>
        <li>water softener,<br />&nbsp;</li>
        <li>electric water heater, or<br />&nbsp;</li>
        <li>medical gas station. </li></ol>
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 9</p>					<a href="/smc/?Section=17F.100.030">Section 17F.100.030</a> Permit Exemptions<br />
        <p>A permit is not required for repairs involving only the working parts of a faucet or valve, the clearing of stoppages, or the replacing of defective faucets or valves so long as no change is made in the piping of the plumbing fixtures or the plumbing or drainage system.</p>
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 9</p>					<a href="/smc/?Section=17F.100.040">Section 17F.100.040</a> Unapproved Work<br />
        <ol style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Whenever the inspector finds materials used or work performed which does not conform to this code, the inspector rejects the work and orders the permittee, in person or by phone, and later in writing if requested, to make all corrections in materials and workmanship necessary to satisfy this code within fifteen days, or within such longer time as the inspector may grant for good cause, unless the permittee timely appeals to the hearing officer.</span></span></span></span></li>
        </ol>
        
        <ol start="2" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Whenever the inspector finds any plumbing, fixture or connection:</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">being used or maintained in a dangerous or unsafe condition; or</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">being installed, altered or extended without a proper permit or by an unauthorized person;</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">the inspector notifies the building official. The building official gives written notice to the owners of the premises and the contractor to take corrective action in a specified time.</span></span></span></span></p>
        
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 9</p>					<a href="/smc/?Section=17F.100.050">Section 17F.100.050</a> Disposal of Liquid Waste<br />
        <p>No person may cause or permit the disposal of sewage, human excrement, or other liquid waste in any place or manner other than through and by means of an approved plumbing and drainage system installed and maintained in accordance with this code.</p>
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 9</p>					<a href="/smc/?Section=17F.100.060">Section 17F.100.060</a> Use of License<br />
        <p>No person may allow another to use his license or name in order to obtain a plumbing permit or to do plumbing work.</p>
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 9</p>					<a href="/smc/?Section=17F.100.070">Section 17F.100.070</a> Plumbing Inspector<br />
        <ol style="list-style-type:upper-alpha">
        	<li><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">The plumbing inspector is the building official or a designated employee.</span></span></span></span></li>
        </ol>
        
        <ol start="2" style="list-style-type:upper-alpha">
        	<li><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">The plumbing inspector has responsibility to:</span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">process applications for permits;</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2">
        		<li><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">inspect fixtures, appliances and installations;</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="3">
        		<li><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">make and promulgate rules, regulations and interpretations of the plumbing code;</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="4">
        		<li><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">initiate proceedings, including prosecutions, to enforce the plumbing code;</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="5">
        		<li><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">maintain records of permits, inspections and other administrative activities.</span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 9</p>					<a href="/smc/?Section=17F.100.080">Section 17F.100.080</a> Hearing Officer – Construction Review Board<br />
        <p>The hearing officer and construction review board have jurisdiction over the plumbing code, as provided in <a href="http://my.spokanecity.org/smc/?Chapter=04.06">chapter 4.06 SMC</a>.</p>
        <p>Date Passed: Monday, February 28, 2005</p><p>Effective Date: Saturday, April 2, 2005</p><p>ORD C33594 Section 9</p>					<a href="/smc/?Section=17F.100.090">Section 17F.100.090</a> REPEALED (Sublevel Construction Controls)<br />
        <p>Repealed by ORD C34039.</p>
        <p>Date Passed: Monday, June 4, 2007</p><p>Effective Date: Sunday, July 1, 2007</p><p>ORD C34039 Section 15</p>				<p><a href="/smc/?Chapter=17F.110">Chapter 17F.110</a> International Wildland-Urban Interface Code</p>
        					<a href="/smc/?Section=17F.110.010">Section 17F.110.010</a> Adoption of International Wildland-Urban Interface Code<br />
        <ol style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">The International Wildland-Urban Interface Code (IWUIC) including appendices and related standards, published by the International Code Council, as modified by this title, is adopted by of the City of Spokane except as otherwise provided. The edition adopted of the IWUIC shall be the same edition as the International Building Code adopted by Washington State.</span></span></span></span></span></span></span></li>
        </ol>
        
        <ol start="2" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">The following amendments are made to the International Wildland-Urban Interface Code:</span></span></span></span></span></span></span></li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Section 101.1 is modified to read as follows:</span></span></span></span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <p style="margin-left:80px; margin-right:0in; text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><strong><span style="font-size:12.0pt"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">101.1 Title</span></span></span></span></strong><span style="font-size:12.0pt"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">. These regulations shall be known as the Wildland-Urban Interface Code of the City of Spokane, hereinafter referred to as &ldquo;this code&rdquo;.</span></span></span></span></span></span></span></p>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Section 103.1 is modified to read as follows:</span></span></span></span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <p style="margin-left:80px; margin-right:0in; text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><strong><span style="font-size:12.0pt"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">103.1 Creation of enforcement agency.</span></span></span></span></strong><span style="font-size:12.0pt"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black"> The building code official and fire code official are hereby authorized to administer and enforce this code, or designated sections thereof, and all ordinances of the City of Spokane pertaining to designated wildland-urban interface areas. For such purposes, </span></span></span></span><span style="font-size:12.0pt"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">the building code official shall have authority over building specific requirements, and the fire code official shall have authority over site specific requirements.</span></span></span></span></span></span></span></p>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="3">
        		<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Section 110.4.7 is modified to read as follows:</span></span></span></span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <p style="margin-left:80px; margin-right:0in; text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><strong><span style="font-size:12.0pt"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">110.4.7 Violation penalties</span></span></span></span></strong><span style="font-size:12.0pt"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">. Persons who shall violate a provision of this code or shall fail to comply with any of the requirements thereof or who shall erect, install, alter, repair or do work in violation of the approved construction documents or directive of the code official, or of a permit or certificate used under provisions of this code, shall be guilty of a Class I civil infraction. Each day that a violation continues after due notice has been served shall be deemed a separate offense.</span></span></span></span></span></span></span></p>
        
        <p>Date Passed: Monday, April 29, 2024</p><p>Effective Date: Wednesday, June 12, 2024</p><p>ORD C36513 Section 1</p>					<a href="/smc/?Section=17F.110.020">Section 17F.110.020</a> Appendices Adopted<br />
        <p style="margin-left:0in; margin-right:0in"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">The following appendices of the International Wildland-Urban Interface Code are adopted as part of the wildland-urban interface code of the City:</span></span></span></span></span></span></span></p>
        
        <ol style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="color:black"><a href="https://codes.iccsafe.org/content/IWUIC2018P2/appendix-a-general-requirements" style="color:#0563c1; text-decoration:underline"><span style="font-size:12.0pt"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif">Appendix A &ndash; General Requirements</span></span></span></a></span></span></span></span></li>
        </ol>
        
        <ol start="2" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="color:black"><a href="https://codes.iccsafe.org/content/IWUIC2018P2/appendix-b-vegetation-management-plan" style="color:#0563c1; text-decoration:underline"><span style="font-size:12.0pt"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif">Appendix B &ndash; Vegetation Management Plan</span></span></span></a></span></span></span></span></li>
        </ol>
        
        <ol start="3" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="color:black"><a href="https://codes.iccsafe.org/content/IWUIC2018P2/appendix-c-fire-hazard-severity-form" style="color:#0563c1; text-decoration:underline"><span style="font-size:12.0pt"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif">Appendix C &ndash; Fire Hazard Severity Form</span></span></span></a></span></span></span></span></li>
        </ol>
        
        <ol start="4" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif"><span style="color:black"><a href="https://codes.iccsafe.org/content/IWUIC2018P2/appendix-d-fire-danger-rating-system" style="color:#0563c1; text-decoration:underline"><span style="font-size:12.0pt"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif">Appendix D &ndash; Fire Danger Rating System</span></span></span></a></span></span></span></span></li>
        </ol>
        
        <ol start="5" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif">&nbsp;<span style="color:black"><a href="https://codes.iccsafe.org/content/IWUIC2018P2/appendix-f-characteristics-of-fire-resistive-vegetation" style="color:#0563c1; text-decoration:underline"><span style="font-size:12.0pt"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif">Appendix F &ndash; Characteristics of Fire-Resistive vegetation</span></span></span></a></span></span></span></span></li>
        </ol>
        
        <ol start="6" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="background-color:white"><span style="font-family:Calibri,sans-serif">&nbsp;<span style="color:black"><a href="https://codes.iccsafe.org/content/IWUIC2018P2/appendix-h-international-wildland-urban-interface-code-flowchart" style="color:#0563c1; text-decoration:underline"><span style="font-size:12.0pt"><span style="background-color:white"><span style="font-family:&quot;Arial&quot;,sans-serif">Appendix H &ndash; International Wildland-Urban Interface Code Flowchart</span></span></span></a></span></span></span></span></li>
        </ol>
        
        <p>Date Passed: Monday, August 2, 2021</p><p>Effective Date: Thursday, September 9, 2021</p><p>ORD C36088 Section 2</p></form>
        </div>
        </div></td>
        	</tr>
        </table>
