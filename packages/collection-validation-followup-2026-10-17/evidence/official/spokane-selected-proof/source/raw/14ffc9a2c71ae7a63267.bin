        		<ol start="3" style="list-style-type:lower-alpha">
        			<li style="text-align:justify"><span style="font-size:12pt"><span style="background-color:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">wood from old growth forests; or</span></span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
