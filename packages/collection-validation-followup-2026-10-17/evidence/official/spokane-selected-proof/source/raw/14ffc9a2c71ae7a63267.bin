        		<li style="text-align:justify"><span style="font-size:12pt"><span style="background-color:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">landfill gas;</span></span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="6">
        		<li style="text-align:justify"><span style="font-size:12pt"><span style="background-color:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">wave, ocean, or tidal power;</span></span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="7">
        		<li style="text-align:justify"><span style="font-size:12pt"><span style="background-color:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">gas from sewage treatment facilities;</span></span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="8">
        		<li style="text-align:justify"><span style="font-size:12pt"><span style="background-color:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">biodiesel fuel as defined in RCW 82.29A.135 that is not derived from crops raised on land cleared from old growth or first-growth forests where the clearing occurred after the effective date of this section; and</span></span></span></span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
