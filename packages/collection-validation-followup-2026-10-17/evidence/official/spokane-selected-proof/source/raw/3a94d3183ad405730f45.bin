        			<p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-size:11.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">CC1, CC2, CC3, CC4</span></span></span></span></span></p>
        			</td>
