        <ol start="3">
        	<li style="text-align:justify"><span style="font-family:Calibri,sans-serif"><strong><span style="font-family:&quot;Arial&quot;,sans-serif">RCW Title 9A Washington Criminal Code</span></strong> </span></li>
        </ol>
        
