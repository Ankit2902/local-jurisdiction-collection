        			<p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-family:Arial,sans-serif"><span style="color:black">Per ton charge</span></span></p>
        			</td>
        			<td style="background-color:white; height:.2in; width:69.75pt">
        			<p style="margin-left:0in; margin-right:0in; text-align:center"><span style="font-family:Arial,sans-serif"><span style="color:black">$152.60</span></span></p>
        			</td>
