        <p style="margin-left:0in; margin-right:0in"><span style="font-size:12pt"><span style="background-color:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-size:13.5pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Repealed by Ordinance C35710 Section 1</span></span></span></span></span></span></p>
        
