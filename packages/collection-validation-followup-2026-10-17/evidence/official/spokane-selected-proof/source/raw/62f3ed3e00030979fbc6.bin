        	<ol>
        		<li style="text-align:justify"><span style="background-color:white"><span style="font-family:Univers,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Shoreline &ndash; Substantial Development Permit, Conditional Use Permit and Variance.</span></span></span></span></li>
        	</ol>
