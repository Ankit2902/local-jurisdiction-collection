        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">46.32.020 &ndash; On-Board Recording Device Info Not Available&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; CFR 395.15(g)&nbsp;&nbsp;&nbsp;&nbsp;$191</span></span></span></span></li>
