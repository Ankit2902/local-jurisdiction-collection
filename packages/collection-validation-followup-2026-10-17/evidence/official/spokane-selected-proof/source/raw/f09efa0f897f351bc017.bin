        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">46.32.020 &ndash; Violation of 60/70 Hour Rule &ndash; Passenger Possible OOSV &nbsp;&nbsp;&nbsp;&nbsp;CFR 395.5(b)&nbsp; &nbsp; &nbsp; $191</span></span></span></span></li>
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">46.32.020 &ndash; Violation of 10 Hour Rule &ndash; Passenger &nbsp;Possible OOSV&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;CFR 395.5(a)(1)&nbsp;&nbsp;$191</span></span></span></span></li>
