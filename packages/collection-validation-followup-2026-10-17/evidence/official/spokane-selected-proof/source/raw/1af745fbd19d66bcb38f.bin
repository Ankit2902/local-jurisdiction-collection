        <input type="text" name="Find" aria-label="Find Word Box" value="" style="padding: 5px; line-height: 12px; font-size: 12px;" /><input type="submit" value="Highlight Word" style="padding: 5px 15px; line-height: 12px; font-size: 12px;" /></form></td>
        			</tr>
        		</table>
        		<script language="javascript" type="text/javascript">
        	function checkChildren(srcObj, vType) {
        		for (var i = 0; i < eval("document.formSMC." + vType + ".length"); i++) {
        			if ((eval("document.formSMC." + vType + "[i].value.substring(0, srcObj.length)") == srcObj) && (eval("document.formSMC." + vType + "[i].disabled") == false)) {
        					(eval("document.formSMC." + vType + "[i].checked")) ? eval("document.formSMC." + vType + "[i]").checked = false : eval("document.formSMC." + vType + "[i]").checked = true;
        			}
        		}
        		return false;
        	}
        function toggleRepealed(element) {
        	const rows = document.getElementById("hideRepealed").querySelectorAll('tr');
        	rows.forEach(function (row) {
        		var text = row.textContent;		
        		if (text.includes('REPEALED') && !row.classList.contains('hidden')) {
        			row.classList.add('hidden')
        		}
        		else {
        			row.classList.remove('hidden')
        		}
        	})
        }
        function HideRepealed() {
        	const rows = document.getElementById("hideRepealed").querySelectorAll('tr');
        	rows.forEach(function (row) {
        		var text = row.textContent;		
        		if (text.includes('REPEALED') && !row.classList.contains('hidden')) {
        			row.classList.add('hidden')
        		}
        	})
        }
        </script>
        <div style="padding: 15px;"><form action="/smc/" method="post" name="formSMC">
        <div id="hideRepealed">
        		<p><a href="/smc/?Title=17D">Title 17D</a> City-wide Standards</p>
        				<p><a href="/smc/?Chapter=17D.010">Chapter 17D.010</a> Concurrency Certification</p>
        					<a href="/smc/?Section=17D.010.010">Section 17D.010.010</a> Applicability<br />
        <p>The following facilities and services must be evaluated for concurrency:</p>
        <ol type="A">
        <li>Transportation;<br />&nbsp;</li>
        <li>Public water;<br />&nbsp;</li>
        <li>Fire protection;<br />&nbsp;</li>
        <li>Police protection;<br />&nbsp;</li>
        <li>Parks and recreation;<br />&nbsp;</li>
        <li>Library;<br />&nbsp;</li>
        <li>Solid waste disposal and recycling;<br />&nbsp;</li>
        <li>Schools;<br />&nbsp;</li>
        <li>Public wastewater (sewer and stormwater). </li></ol>
        <p>Date Passed: Monday, February 21, 2005</p><p>Effective Date: Wednesday, March 30, 2005</p><p>ORD C33582 Section 1</p>					<a href="/smc/?Section=17D.010.020">Section 17D.010.020</a> Concurrency Review<br />
        <p style="margin-left:0in; margin-right:0in; text-align:justify">&nbsp;</p>
        
        <ol style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">Application.</span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">All development permit applications are subject to a concurrency review except those exempted in&nbsp;</span><a href="https://my.spokanecity.org/smc/?Section=17D.010.030" style="color:blue; text-decoration:underline">SMC 17D.010.030</a><span style="font-family:&quot;Arial&quot;,sans-serif">. If a concurrency review is conducted for the preliminary plat application, no concurrency review shall be required for the final plat application.</span></span></p>
        
        <ol start="2" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">Procedures.</span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">The concurrency review will be performed in the processing of the development permit and conducted by the appropriate facility and service providers.</span></span></p>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">The Planning and Economic Development Services Department shall provide the overall coordination of the concurrency review by notifying the facility and service providers of all applications (not including applications for building permits which shall be processed and coordinated by the Development Services Department in a manner consistent with this chapter) requiring a concurrency review as set forth in subsection (A) of this section; notifying the facility and service providers of all exempted applications which use capacity as set forth in&nbsp;</span><a href="https://my.spokanecity.org/smc/?Section=17G.061.120" style="color:blue; text-decoration:underline">SMC 17G.061.120(B)(3)</a><span style="font-family:&quot;Arial&quot;,sans-serif">; notifying the applicant of the review results; notifying the facility and service providers of the final outcome (approval or denial) of the development permit; and notifying the facility and service providers of any expired development permits or discontinued certificates of capacity. Failure by the notified facility and service provider to respond shall be construed as a finding that concurrency is met.</span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2">
        		<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">All facility and service providers shall be responsible for maintaining and monitoring their available and planned capacity.</span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="3">
        		<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">On an annual basis, the Integrated Capital Management Department should coordinate with facility and service providers to identify projects that may be needed in order to accommodate future development and should incorporate such projects in the annual update of the City&rsquo;s Capital Improvement Program.</span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="3" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">Review.</span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">Development applications that would result in a reduction of a level of service below the minimum level of service standard cannot be approved. For public water, public wastewater (sewer and stormwater), solid waste disposal, and recycling, only available capacity will be used in the concurrency review. For transportation, police protection, fire protection, schools, parks and recreation<u>,</u> and libraries<u>,</u> available and planned capacity will be used in conducting the concurrency review.</span></span></p>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">If the capacity of concurrency facilities, either existing or as planned, is equal to or greater than the capacity required by the development permit, the concurrency review is satisfied.</span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2">
        		<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">If the concurrency review is not passed, the applicant may accept a ninety-day reservation of concurrency facilities that exist and:</span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol style="list-style-type:lower-alpha">
        			<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">modify the application to reduce the need for concurrency facilities that do not exist;</span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="2" style="list-style-type:lower-alpha">
        			<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">demonstrate to the service provider&rsquo;s satisfaction that the development will have a lower need for capacity than usual and, therefore, capacity is adequate;</span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="3" style="list-style-type:lower-alpha">
        			<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">arrange with the service provider for the provision of the additional capacity of concurrency facilities required; or</span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="4" style="list-style-type:lower-alpha">
        			<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">appeal the results of the concurrency review to the Hearing Examiner in accordance with the provisions of&nbsp;</span><a href="https://my.spokanecity.org/smc/?Section=17D.010.050" style="color:blue; text-decoration:underline">SMC 17D.010.050</a><span style="font-family:&quot;Arial&quot;,sans-serif">. The ninety-day reservation period is tolled from the date an appeal is filed until the date the Hearing Examiner signs his written opinion.</span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol start="4" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">Concurrency Inquiry</span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">An inquiry may be made as to whether or not capacity exists within concurrency facilities without an accompanying request for a development permit.</span></span></p>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">Fee.</span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <p style="margin-left:80px; margin-right:0in; text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">As set forth in&nbsp;</span><a href="https://my.spokanecity.org/smc/?Section=08.02.0696" style="color:blue; text-decoration:underline">SMC 8.02.0696</a><span style="font-family:&quot;Arial&quot;,sans-serif">, a fee may be charged for such concurrency review. Any available capacity cannot be reserved.</span></span></p>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol start="2">
        		<li style="text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">Capacity Letter.</span></span></li>
        	</ol>
        	</li>
        </ol>
        
        <p style="margin-left:80px; margin-right:0in; text-align:justify"><span style="font-family:Aptos,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">Upon request, the Director of Engineering Services may issue a letter indicating whether capacity is available. Unless reserved through some other process or through a Development Agreement, such letter shall not be legally binding.</span></span></p>
        
        <p style="margin-left:0in; margin-right:0in; text-align:justify">&nbsp;</p>
        
        <p>Date Passed: Monday, October 20, 2025</p><p>Effective Date: Friday, November 28, 2025</p><p>ORD C36753 Section 24</p>					<a href="/smc/?Section=17D.010.030">Section 17D.010.030</a> Reservation of Capacity<br />
        <ol style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Reservation.</span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Capacity shall be reserved for a specific development at the same time the development permit is issued and upon payment of any fee and/or performance of any condition required by a service provider.</span></span></p>
        
        <ol style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Capacity shall be reserved only for the specific land uses, densities, intensities and development project described in the application and development permit.</span></span></li>
        </ol>
        
        <ol start="2" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Capacity reserved for a specific development is not transferable to other land, but may be transferred to new owners of the original land.</span></span></li>
        </ol>
        
        <ol start="2" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Expiration.</span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Capacity reserved for a specific development shall expire if the accompanying development permit expires or is revoked. If the development permit is granted an extension, the accompanying capacity shall continue to be reserved for the life of the permit. </span></span></p>
        
        <ol start="3" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Unused Capacity.</span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Any capacity that is not used because the accompanying development permit expires shall be returned to the pool of available capacity.</span></span></p>
        
        <ol start="4" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">No Impact.</span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Development permits for development which creates no additional impacts on any concurrency facility are exempt from the requirements of this chapter. Such development includes, but is not limited to:</span></span></p>
        
        <ol style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">any addition to a residence or accessory structure with no change in use or increase in the number of dwelling units;</span></span></li>
        </ol>
        
        <ol start="2" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">interior renovations with no change in use or increase in number of dwelling units;</span></span></li>
        </ol>
        
        <ol start="3" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">interior completion of a structure for use(s) with the same or less intensity as the existing use or a previously approved use;</span></span></li>
        </ol>
        
        <ol start="4" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">replacement structure with no change in use or increase in number of dwelling units;</span></span></li>
        </ol>
        
        <ol start="5" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">temporary construction trailers;</span></span></li>
        </ol>
        
        <ol start="6" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">driveway, resurfacing or parking lot paving;</span></span></li>
        </ol>
        
        <ol start="7" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">re-roofing of structures;</span></span></li>
        </ol>
        
        <ol start="8" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">demolitions.</span></span></li>
        </ol>
        
        <ol start="5" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Exempt Permits.</span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">The following development permits are exempt from the requirements of this chapter:</span></span></p>
        
        <ol style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Boundary line adjustment;</span></span></li>
        </ol>
        
        <ol start="2" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Final plats;</span></span></li>
        </ol>
        
        <ol start="3" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Temporary use permit;</span></span></li>
        </ol>
        
        <ol start="4" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Variance;</span></span></li>
        </ol>
        
        <ol start="5" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Waiver;</span></span></li>
        </ol>
        
        <ol start="6" style="margin-left:40px">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Shoreline substantial development permit/variance.</span></span></li>
        </ol>
        
        <ol start="6" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Application Filed Before Effective Date of Certificate of Capacity Ordinance.</span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Complete development permit applications that have been submitted before the effective date of the Certificate of Capacity ordinance (March 30, 2005) are exempt from the requirements of this chapter.</span></span></p>
        
        <ol start="7" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Pre-existing Use Rights.</span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Development permits that were issued before March 30, 2005 shall be considered to have capacity as long as the accompanying development permit is valid. If the accompanying development permit does not expire, capacity shall be considered to exist for three years after March 30, 2005.</span></span></p>
        
        <ol start="8" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Single-family Homes and Duplexes.</span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Building permits for a single-family home and/or a duplex are exempt from the requirements of this chapter.</span></span></p>
        
        <ol style="list-style-type:upper-roman">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Interior Renovations.</span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Interior renovations that only add one additional dwelling unit are exempt from the requirements of this chapter.</span></span></p>
        
        <ol start="10" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Accessory Dwelling Units.</span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">All accessory dwelling units, as defined in <a href="https://my.spokanecity.org/smc/?Chapter=17C.300">chapter 17C.300 SMC</a> are exempt from the requirements of this chapter.</span></span></p>
        
        <ol start="11" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">Accounting for Capacity.</span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-size:12pt"><span style="font-family:Arial,sans-serif">The capacity for development permits exempted under subsections (C), (D), (E), (F) and (G) of this section shall be taken into account.</span></span></p>
        
        <p>Date Passed: Monday, April 29, 2024</p><p>Effective Date: Wednesday, June 12, 2024</p><p>ORD C36514 Section 11</p>					<a href="/smc/?Section=17D.010.040">Section 17D.010.040</a> Existing Charges and Fees<br />
        <p>Facility and service providers may continue to charge fees based on their existing fee schedules. This chapter does not independently authorize the collection of any new fees.</p>
        <p>Date Passed: Monday, February 21, 2005</p><p>Effective Date: Wednesday, March 30, 2005</p><p>ORD C33582 Section 1</p>					<a href="/smc/?Section=17D.010.050">Section 17D.010.050</a> Appeals<br />
        <ol style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Procedures.</span></span></span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">The applicant may appeal the results of the concurrency test to the city hearing examiner. The applicant must file a notice of appeal with the planning and economic development services department within fifteen days of the notification of the test results. The notice of appeal must specify the grounds thereof, and must be submitted on the forms authorized by the planning and economic development services department. Each appeal shall be accompanied by a fee as set forth in <a href="http://my.spokanecity.org/smc/?Section=08.02.087"><span style="color:blue">SMC 8.02.087</span></a>, with said fee refunded to the appellant should the appellant prevail. Upon filing of such appeal, the planning and economic development services department shall notify the appropriate facility and service provider(s) of such appeal.</span></span></span></span></p>
        
        <ol start="2" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Hearing Scheduling and Notification.</span></span></span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">The hearing scheduling and notification shall be as set forth in <a href="http://my.spokanecity.org/smc/?Chapter=17G.050"><span style="color:blue">chapter 17G.050 SMC</span></a>, which sets forth the hearing examiner&rsquo;s procedure.</span></span></span></span></p>
        
        <ol start="3" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Record.</span></span></span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">The planning and economic development services department and appropriate service provider(s) shall transmit to the hearing examiner all papers, calculations, plans and other materials constituting the record of the concurrency test at least seven days prior to the scheduled hearing date.</span></span></span></span></p>
        
        <ol start="4" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Burden of Proof.</span></span></span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">The burden of proof shall be on the appellant to show by a preponderance of the evidence that the appeal determination was either clearly erroneous, not based upon substantial evidence or contrary to law.</span></span></span></span></p>
        
        <ol start="5" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Hearing and Decision.</span></span></span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">The examiner shall conduct the hearing and render the decision in accordance with the provisions of <a href="http://my.spokanecity.org/smc/?Chapter=17G.050"><span style="color:blue">chapter 17G.050 SMC</span></a>.</span></span></span></span></p>
        
        <ol start="6" style="list-style-type:upper-alpha">
        	<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Reconsideration and Appeal of Examiner Decision.</span></span></span></span></li>
        </ol>
        
        <p style="margin-left:40px; margin-right:0in; text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">Reconsideration of the examiner&rsquo;s decision shall be allowed as set forth in <a href="http://my.spokanecity.org/smc/?Chapter=17G.050"><span style="color:blue">chapter 17G.050 SMC</span></a>. Appeal of the examiner&rsquo;s decision shall be made pursuant to <a href="http://my.spokanecity.org/smc/?Chapter=17G.050"><span style="color:blue">chapter 17G.050 SMC</span></a>.</span></span></span></span></p>
        
        <p>Date Passed: Monday, February 21, 2005</p><p>Effective Date: Wednesday, March 30, 2005</p><p>ORD C33582 Section 1</p>				<p><a href="/smc/?Chapter=17D.020">Chapter 17D.020</a> Financial Guarantees</p>
        					<a href="/smc/?Section=17D.020.010">Section 17D.020.010</a> Financial Guarantee<br />
        <p>The director of engineering services may allow an applicant to establish a financial guarantee and obtain a certificate of occupancy or other permit or approval in advance of completing all required work or improvements if the following criteria are met:</p>
        <ol type="A">
        <li>The applicant is unable to complete the work or improvements to be covered by the financial guarantee because of unavoidable circumstances that in no way resulted from the actions or inaction of the applicant; and/or<br />&nbsp;</li>
        <li>It is reasonably certain that the applicant will be able to complete the work or improvements to be covered by the financial guarantee within a reasonable amount of time; and<br />&nbsp;</li>
        <li>Granting the certificate of occupancy or other permit or approval prior to completion of the work or improvements will not be materially detrimental to the city or the properties in the vicinity of the subject property. </li></ol>
        <p>Date Passed: Monday, February 21, 2005</p><p>Effective Date: Wednesday, March 30, 2005</p><p>ORD C33582 Section 2</p>					<a href="/smc/?Section=17D.020.020">Section 17D.020.020</a> Form of Guarantee<br />
        <p>
        <ol type="A">
        <li>Performance guarantees shall be in the form of a surety bond, cash deposit, savings account assignment, letter of credit or other suitable security as approved by the city attorney. The form and content of all performance guarantees must be approved by the city attorney.<br />&nbsp;</li>
        <li>Performance/warranty retainers shall be in the form of a cash deposit, savings account assignment or letter of credit. The form and content of all performance/warranty retainers, and any other documents referenced in this chapter, must be approved by the city attorney. </li></ol>
        <p></p>
        <p>Date Passed: Monday, February 21, 2005</p><p>Effective Date: Wednesday, March 30, 2005</p><p>ORD C33582 Section 2</p>					<a href="/smc/?Section=17D.020.030">Section 17D.020.030</a> Amount of Guarantee<br />
        <p>The director of engineering services shall determine the amount of the financial guarantee as follows:</p>
        <ol type="A">
        <li>For a performance guarantee, the amount will be one hundred ten percent of the costs of the work or improvements covered by the performance guarantee, based on estimated costs immediately following the expiration of the performance guarantee.<br />&nbsp;</li>
        <li>For a performance/warranty retainer, the amount will be seven thousand, five hundred dollars or ten percent of the performance guarantee, whichever is greater. </li></ol>
        <p>Date Passed: Monday, February 21, 2005</p><p>Effective Date: Wednesday, March 30, 2005</p><p>ORD C33582 Section 2</p>					<a href="/smc/?Section=17D.020.040">Section 17D.020.040</a> Assistance in Determining Estimated Costs<br />
        <p>The director of engineering services may consult with one or more persons with special knowledge or expertise in determining the amount of a financial guarantee under this chapter. The applicant shall pay the actual costs of this consultation prior to the director of engineering services accepting the financial guarantee and signing the project agreement under <a href="http://my.spokanecity.org/smc/?Section=17D.020.060">SMC 17D.020.060</a>.</p>
        <p>Date Passed: Monday, February 21, 2005</p><p>Effective Date: Wednesday, March 30, 2005</p><p>ORD C33582 Section 2</p>					<a href="/smc/?Section=17D.020.050">Section 17D.020.050</a> Supplemental Administrative Costs<br />
        <p>
        <ol type="A">
        <li>In addition to the financial guarantee and any consultation fees under <a href="http://my.spokanecity.org/smc/?Section=17D.020.040">SMC 17D.020.040</a>, the applicant shall post a nonrefundable cash deposit with the City as follows:</li></ol>
        <div align="center">
        <center>
        <table style="BORDER-COLLAPSE: collapse" bordercolor="#111111" cellspacing="3" cellpadding="3" width="70%" border="0">
        <tbody>
        <tr>
        <td width="50%">
        <p style="MARGIN-BOTTOM: 6px"><b>Amount of Guarantee</b></p></td>
        <td width="50%">
        <p style="MARGIN-BOTTOM: 6px"><b>Amount of Cash Deposit</b></p></td></tr>
        <tr>
        <td width="50%">
        <p style="MARGIN-BOTTOM: 6px">Up to $20,000</p></td>
        <td width="50%">
        <p style="MARGIN-BOTTOM: 6px">$250.00</p></td></tr>
        <tr>
        <td width="50%">
        <p style="MARGIN-BOTTOM: 6px">$20,001 to $50,000</p></td>
        <td width="50%">
        <p style="MARGIN-BOTTOM: 6px">$500.00</p></td></tr>
        <tr>
        <td width="50%">
        <p style="MARGIN-BOTTOM: 6px">$50,001 to $100,000</p></td>
        <td width="50%">
        <p style="MARGIN-BOTTOM: 6px">$750.00</p></td></tr>
        <tr>
        <td width="50%">$100,001 and up</td>
        <td width="50%">$1,000.00</td></tr></tbody></table></center></div>
        <ol type="A" start="2">
        <li>This nonrefundable cash deposit will be used to cover the City’s expenses of administering and, if necessary, obtaining and using the proceeds of the financial guarantee. </li></ol>
        <p></p>
        <p>Date Passed: Monday, February 21, 2005</p><p>Effective Date: Wednesday, March 30, 2005</p><p>ORD C33582 Section 2</p>					<a href="/smc/?Section=17D.020.060">Section 17D.020.060</a> Project Agreement<br />
        <p>In each case where the City requires or allows an applicant to post a financial guarantee, the applicant, the owner of the subject property, and the City shall sign a project agreement prepared by the City stating the following:</p>
        <ol type="A">
        <li>The work or improvements covered by the financial guarantee.<br />&nbsp;</li>
        <li>The amount and nature of the financial guarantee and the amount of the cash deposit.<br />&nbsp;</li>
        <li>The period of time covered by the performance/warranty retainer, which will be two years or such longer period as is required by this chapter or determined by the director of engineering services.<br />&nbsp;</li>
        <li>The rights and duties of the City and applicant as established in this chapter.</li></ol>
        <p style="MARGIN-TOP: 0px; MARGIN-BOTTOM: 0px">Following review and approval as to form by the office of the city attorney, the mayor is hereby authorized to execute such agreements on the City’s behalf without individual approval of each agreement by the city council. The city clerk is authorized to attest such signatures. The mayor may, in the mayor’s discretion, place any specific agreement on the council’s agenda for individual council authorization as he or she may see fit. </p>
        <p>Date Passed: Monday, August 4, 2008</p><p>Effective Date: Saturday, September 6, 2008</p><p>ORD C34286 Section 1</p>					<a href="/smc/?Section=17D.020.070">Section 17D.020.070</a> Irrevocable License Signed by the Owner of the Subject Property<br />
        <p style="text-align:justify">In each case where the City requires or allows an applicant to post a financial guarantee, the owner of the subject property shall give the City a signed, notarized, irrevocable license, executed and acknowledged in the form of a deed, to allow the employees, agents and contractors of the City to go on the subject property for the purpose of inspecting and, if necessary, doing the work or making the improvements covered by the financial guarantee. The applicant shall record this license with the County to run with the property, and shall provide the City with conformed copies of the recorded document within five days of posting the financial guarantee. The property owner must, in this irrevocable license, agree to indemnify and save harmless the City and its employees, agents and contractors from any liability occasioned by the good faith performance of their responsibilities under this chapter, including, but not limited to, doing the work or making the improvements for which the financial guarantee has been posted.</p>
        
        <p>Date Passed: Monday, February 21, 2005</p><p>Effective Date: Wednesday, March 30, 2005</p><p>ORD C33582 Section 2</p>					<a href="/smc/?Section=17D.020.080">Section 17D.020.080</a> Release of Financial Guarantee<br />
        <p style="text-align:justify">After the work or improvements covered by a performance guarantee have been completed, the applicant may request the City to release the performance guarantee. Upon the City&rsquo;s final inspection and acceptance of the improvements, if the applicant has complied with the project agreement and this chapter, the director of engineering services shall release the performance guarantee.</p>
        
        <p style="text-align:justify">At the end of the time covered by the performance/warranty retainer, the applicant may request the City to release the performance/warranty retainer. If the applicant has complied with the project agreement and this chapter, the director of engineering services shall release the performance/warranty retainer after any subtractions under <a href="http://my.spokanecity.org/smc/?Section=17D.020.110">SMC 17D.020.110</a>, subject to the requirements of <a href="http://my.spokanecity.org/smc/?Section=17D.020.120">SMC 17D.020.120</a>.</p>
        
        <p>Date Passed: Monday, February 21, 2005</p><p>Effective Date: Wednesday, March 30, 2005</p><p>ORD C33582 Section 2</p>					<a href="/smc/?Section=17D.020.090">Section 17D.020.090</a> Use of Proceeds – Notice to Property Owner<br />
        <p>If during the period of time covered by the performance/warranty retainer or after the date by which the required work or improvements are to be completed under a performance guarantee, the director of engineering services determines that the project agreement has not been complied with, he or she shall so notify the applicant. The notice must state:</p>
        <ol type="A">
        <li>the work that must be done or the improvements that must be made to comply with the project agreement;<br />&nbsp;</li>
        <li>the amount of time, not to exceed thirty days, that the applicant has to commence and complete the required work or improvements; and<br />&nbsp;</li>
        <li>that, if the work or improvements are not commenced and completed within the time specified, the City will use the proceeds of the financial guarantee to have the required work or improvements completed. </li></ol>
        <p>Date Passed: Monday, February 21, 2005</p><p>Effective Date: Wednesday, March 30, 2005</p><p>ORD C33582 Section 2</p>					<a href="/smc/?Section=17D.020.100">Section 17D.020.100</a> Use of Proceeds – Work by City<br />
        <p>If the work or improvements covered by the financial guarantee are not completed within the time specified in the notice given under <a href="http://my.spokanecity.org/smc/?Section=17D.020.090">SMC 17D.020.090</a>, the City shall obtain the proceeds of the financial guarantee and do the work or make the improvements covered by the financial guarantee. The City may either have employees of the City do the work or make the improvements or by using procurement procedures established by law, have a contractor do the work or make the improvements.</p>
        <p>Date Passed: Monday, February 21, 2005</p><p>Effective Date: Wednesday, March 30, 2005</p><p>ORD C33582 Section 2</p>					<a href="/smc/?Section=17D.020.110">Section 17D.020.110</a> Use of Proceeds – Refund of Excess – Charge for All Costs<br />
        <p style="text-align:justify">The applicant and property owner shall be jointly and severally responsible for all costs incurred by the City in doing the work and making the improvements covered by the financial guarantee. The City shall release or refund any proceeds of a performance guarantee remaining after subtracting all costs for doing the work or making the improvements covered by the performance guarantee. The City shall release or refund any proceeds of a performance/warranty retainer remaining at the end of the time covered by the performance/warranty retainer, after subtracting all costs for doing the work covered by the performance/warranty retainer. The owner of the subject property shall reimburse the City for any amount expended by the city that exceeds the proceeds of either financial guarantee.</p>
        
        <p>Date Passed: Monday, February 21, 2005</p><p>Effective Date: Wednesday, March 30, 2005</p><p>ORD C33582 Section 2</p>					<a href="/smc/?Section=17D.020.120">Section 17D.020.120</a> Use of Nonrefundable Cash Deposit<br />
        <p>After the work or improvements covered by a performance guarantee have been completed or at the end of the time covered by a performance/warranty retainer, the City shall determine all of its expenses incurred in administering and, if necessary, using the proceeds of the financial guarantee. If the amount of the non-refundable cash deposit is insufficient to cover the City’s costs in administering and, if necessary, using the proceeds of the performance/warranty retainer, the property owner shall pay this amount to the City prior to release of the performance/warranty retainer.</p>
        <p>Date Passed: Monday, February 21, 2005</p><p>Effective Date: Wednesday, March 30, 2005</p><p>ORD C33582 Section 2</p>					<a href="/smc/?Section=17D.020.130">Section 17D.020.130</a> Itemized Statement<br />
        <p>In each case where the City uses any proceeds of the financial guarantee or any of the cash deposit, it shall give the owner of the subject property an itemized statement of all proceeds and funds used.</p>
        <p>Date Passed: Monday, February 21, 2005</p><p>Effective Date: Wednesday, March 30, 2005</p><p>ORD C33582 Section 2</p>				<p><a href="/smc/?Chapter=17D.030">Chapter 17D.030</a> REPEALED (Interim Voluntary Transportation Impact Fees)</p>
        					<a href="/smc/?Section=17D.030.010">Section 17D.030.010</a> REPEALED (Findings and Authority)<br />
        <p>Repealed</p>
        <p>Date Passed: Monday, October 17, 2005</p><p>Effective Date: Monday, October 17, 2005</p><p>ORD C33753 Section 2</p>					<a href="/smc/?Section=17D.030.020">Section 17D.030.020</a> REPEALED (Definitions)<br />
        <p>Repealed</p>
        <p>Date Passed: Monday, October 17, 2005</p><p>Effective Date: Monday, October 17, 2005</p><p>ORD C33753 Section 2</p>					<a href="/smc/?Section=17D.030.030">Section 17D.030.030</a> REPEALED (Optional Assessment of Voluntary Impact Fees)<br />
        <p>Repealed</p>
        <p>Date Passed: Monday, October 17, 2005</p><p>Effective Date: Monday, October 17, 2005</p><p>ORD C33753 Section 2</p>					<a href="/smc/?Section=17D.030.080">Section 17D.030.080</a> REPEALED (Establishment of Voluntary Impact Fee Account)<br />
        <p>Repealed</p>
        <p>Date Passed: Monday, October 17, 2005</p><p>Effective Date: Monday, October 17, 2005</p><p>ORD C33753 Section 2</p>					<a href="/smc/?Section=17D.030.090">Section 17D.030.090</a> REPEALED (Authorization for Interlocal Agreements)<br />
        <p>Repealed</p>
        <p>Date Passed: Monday, October 17, 2005</p><p>Effective Date: Monday, October 17, 2005</p><p>ORD C33753 Section 2</p>					<a href="/smc/?Section=17D.030.100">Section 17D.030.100</a> REPEALED (Refunds (RCW 82.02.080))<br />
        <p>Repealed</p>
        <p>Date Passed: Monday, October 17, 2005</p><p>Effective Date: Monday, October 17, 2005</p><p>ORD C33753 Section 2</p>					<a href="/smc/?Section=17D.030.110">Section 17D.030.110</a> REPEALED (Use of Funds)<br />
        <p>Repealed</p>
        <p>Date Passed: Monday, October 17, 2005</p><p>Effective Date: Monday, October 17, 2005</p><p>ORD C33753 Section 2</p>					<a href="/smc/?Section=17D.030.130">Section 17D.030.130</a> REPEALED (Appeals)<br />
        <p>Repealed</p>
        <p>Date Passed: Monday, October 17, 2005</p><p>Effective Date: Monday, October 17, 2005</p><p>ORD C33753 Section 2</p>					<a href="/smc/?Section=17D.030.140">Section 17D.030.140</a> REPEALED (Existing Authority Unimpaired)<br />
        <p>Repealed</p>
        <p>Date Passed: Monday, October 17, 2005</p><p>Effective Date: Monday, October 17, 2005</p><p>ORD C33753 Section 2</p>					<a href="/smc/?Section=17D.030.150">Section 17D.030.150</a> REPEALED (Appendix A)<br />
        <p>Repealed</p>
        <p>Date Passed: Monday, October 17, 2005</p><p>Effective Date: Monday, October 17, 2005</p><p>ORD C33753 Section 2</p>				<p><a href="/smc/?Chapter=17D.040">Chapter 17D.040</a> REPEALED (Historic Preservation)</p>
        					<a href="/smc/?Section=17D.040.010">Section 17D.040.010</a> REPEALED (Findings and Purpose)<br />
        <p>
        	Repealed by ORD C35214</p>
        <p>
        	&nbsp;</p>
        
        <p>Date Passed: Monday, February 9, 2015</p><p>Effective Date: Sunday, March 15, 2015</p><p>ORD C35214 Section 4</p>					<a href="/smc/?Section=17D.040.020">Section 17D.040.020</a> REPEALED (Establishment – Membership)<br />
        <p>
        	Repealed by ORD C35214</p>
        <p>
        	&nbsp;</p>
        
        <p>Date Passed: Monday, February 9, 2015</p><p>Effective Date: Sunday, March 15, 2015</p><p>ORD C35214 Section 4</p>					<a href="/smc/?Section=17D.040.030">Section 17D.040.030</a> REPEALED (Terms – Appointment)<br />
        <p>
        	Repealed by ORD C35214</p>
        <p>
        	&nbsp;</p>
        
        <p>Date Passed: Monday, February 9, 2015</p><p>Effective Date: Sunday, March 15, 2015</p><p>ORD C35214 Section 4</p>					<a href="/smc/?Section=17D.040.050">Section 17D.040.050</a> REPEALED (Rules and Regulations)<br />
        <p>
        	Repealed by ORD C35214</p>
        <p>
        	&nbsp;</p>
        
        <p>Date Passed: Monday, February 9, 2015</p><p>Effective Date: Sunday, March 15, 2015</p><p>ORD C35214 Section 4</p>					<a href="/smc/?Section=17D.040.060">Section 17D.040.060</a> REPEALED (Funding)<br />
        <p>
        	Repealed by ORD C35214</p>
        <p>
        	&nbsp;</p>
        
        <p>Date Passed: Monday, February 9, 2015</p><p>Effective Date: Sunday, March 15, 2015</p><p>ORD C35214 Section 4</p>					<a href="/smc/?Section=17D.040.070">Section 17D.040.070</a> REPEALED (Commission Staff)<br />
        <p>
        	Repealed by ORD C35214</p>
        <p>
        	&nbsp;</p>
        
        <p>Date Passed: Monday, February 9, 2015</p><p>Effective Date: Sunday, March 15, 2015</p><p>ORD C35214 Section 4</p>					<a href="/smc/?Section=17D.040.080">Section 17D.040.080</a> REPEALED (Duties)<br />
        <p>
        	Repealed by ORD C35214</p>
        <p>
        	&nbsp;</p>
        
