        		<ol start="6" style="list-style-type:lower-alpha">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">seismic refraction survey, Five Mile Prairie by Budinger &amp; Associates dated December 22, 2000;</span></span></span></span></li>
        		</ol>
        		</li>
        	</ol>
        	</li>
        </ol>
        
        <ol>
        	<li style="list-style-type:none">
        	<ol>
        		<li style="list-style-type:none">
        		<ol start="7" style="list-style-type:lower-alpha">
        			<li style="text-align:justify"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">memorandum to county commissioners from Brenda Sims and Steve Worley, stormwater section, division of utilities, re: Five Mile Prairie refraction survey report dated January 31, 2001;</span></span></span></span></li>
        		</ol>
