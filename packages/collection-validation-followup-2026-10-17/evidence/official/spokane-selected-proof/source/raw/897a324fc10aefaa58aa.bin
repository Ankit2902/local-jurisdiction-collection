        			<td style="vertical-align:top; width:212.25pt">
        			<p style="margin-left:0in; margin-right:0in; text-align:justify"><span style="font-family:Arial,sans-serif"><strong><span style="color:black">P &ndash;</span></strong><span style="color:black"> Permitted</span></span></p>
        
