        		</tr>
        		<tr>
        			<td>Minimum Setback from R-zoned Lots [6]</td>
        			<td>10 ft.</td>
        			<td>10 ft.</td>
        			<td>10 ft.</td>
        			<td>10 ft.</td>
        			<td>10 ft.</td>
        			<td>10 ft.</td>
        		</tr>
        		<tr>
        			<td>Setback from Lot Line abutting an O, OR, NR, NMU, CB, GC, Downtown, CC or I-zoned Lot [6]</td>
        			<td>0 ft.</td>
        			<td>0 ft.</td>
        			<td>0 ft.</td>
        			<td>0 ft.</td>
        			<td>0 ft.</td>
        			<td>0 ft.</td>
        		</tr>
        		<tr>
        			<td>Minimum Front Lot Line</td>
        			<td>10 ft.</td>
        			<td>10 ft.</td>
        			<td>10 ft.</td>
        			<td>10 ft.</td>
        			<td>10 ft.</td>
        			<td>10 ft.</td>
        		</tr>
        		<tr>
        			<td>Landscaping Required [7]</td>
        			<td>Yes</td>
        			<td>Yes</td>
        			<td>Yes</td>
        			<td>Yes</td>
