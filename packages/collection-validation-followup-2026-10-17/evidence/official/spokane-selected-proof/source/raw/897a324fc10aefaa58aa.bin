        		<tr>
        			<td style="border-color:black; vertical-align:top; width:215.75pt">
        			<p style="margin-left:0.5in; margin-right:0in; text-align:justify"><span style="font-family:Arial,sans-serif">40 ft.</span></p>
        			</td>
