03C\/span\u003E\u003C\/span\u003E\u003C\/td\u003E\n\t\t\t\u003Ctd style=\u0022border-color:#000000; border-style:solid; border-width:1px; height:43px; text-align:center; vertical-align:top; width:97px\u0022\u003E\u003Cspan style=\u0022font-size:14px\u0022\u003E\u003Cspan style=\u0022font-family:Times New Roman,Times,serif\u0022\u003E\u003Cspan style=\u0022color:#000000\u0022\u003E12008\u003C\/span\u003E\u003C\/span\u003E\u003C\/span\u003E\u003C\/td\u003E\n\t\t\u003C\/tr\u003E\n\t\u003C\/tbody\u003E\n\u003C\/table\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f7bf7ca2-53a4-4d8b-9f42-e33df8a5bdaf","prev_id":null},{"path":"\/71f28b8f-3ff7-401b-b86f-c9a7cb354eb9\/9b18357b-aaab-4175-bde2-9f4a14afbf92","ref":{"parent":"71f28b8f-3ff7-401b-b86f-c9a7cb354eb9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"220-12","docId":"45","text":"Regulating Plan","id":"9b18357b-aaab-4175-bde2-9f4a14afbf92","children":[{"path":"\/71f28b8f-3ff7-401b-b86f-c9a7cb354eb9\/9b18357b-aaab-4175-bde2-9f4a14afbf92\/bd5d4279-a492-4b5d-9461-c1d1df44d225","ref":{"parent":"9b18357b-aaab-4175-bde2-9f4a14afbf92","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"220-12-11","docId":"45","text":"\u003Cp\u003E\u003Cstrong\u003ESAP BRICKELL CITY CENTRE\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003EThe Brickell City Centre is a mixed-use project in the heart of Brickell situated on seven main parcels totaling approximately 13.9 acres. The site is generally bounded by Brickell Avenue to the East, Southwest 1st Avenue to the West, Southeast 5th Street to the North and Southwest 8th Street to the South, further described in SAP-1.1.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"bd5d4279-a492-4b5d-9461-c1d1df44d225","prev_id":null},{"path":"\/71f28b8f-3ff7-401b-b86f-c9a7cb354eb9\/9b18357b-aaab-4175-bde2-9f4a14afbf92\/716355b8-fc7c-4e78-b371-79fab3b8f5f5","ref":{"parent":"9b18357b-aaab-4175-bde2-9f4a14afbf92","name":"subse