[{"path":"\/d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0","ref":{"name":"section"},"pos":"215","li_attr":{"dataTag":"section","hasChildren":1,"tag":"h2"},"docId":"45","id":"d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0","text":"ARTICLE 11. ART IN PUBLIC PLACES","children":[{"path":"\/d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0\/cb59dbe1-6414-480c-b7e6-38f1cb194e3d","ref":{"parent":"d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h3"},"pos":"215-11","docId":"45","text":"11.1 ADMINISTRATION OF THE PROGRAM","id":"cb59dbe1-6414-480c-b7e6-38f1cb194e3d","children":[{"path":"\/d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0\/cb59dbe1-6414-480c-b7e6-38f1cb194e3d\/d8c776c3-1c78-401d-ba52-d8e009177014","ref":{"parent":"cb59dbe1-6414-480c-b7e6-38f1cb194e3d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"215-11-11","docId":"45","text":"\u003Cp\u003EThe Public Art Program shall be administered by the Public Art Division, a division within the City\u2019s Planning Department.\u003C\/p\u003E","id":"d8c776c3-1c78-401d-ba52-d8e009177014","prev_id":null}]},{"path":"\/d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0\/b49df337-7ffc-458b-99ec-a294a0398742","ref":{"parent":"d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h3"},"pos":"215-12","docId":"45","text":"11.2 REFERENCES","id":"b49df337-7ffc-458b-99ec-a294a0398742","children":[{"path":"\/d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0\/b49df337-7ffc-458b-99ec-a294a0398742\/eda269d1-3406-4736-a683-aca40f501618","ref":{"parent":"b49df337-7ffc-458b-99ec-a294a0398742","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"215-12-11","docId":"45","text":"\u003Cp\u003ESee \u003Ca href=\u0022https:\/\/library.municode.com\/fl\/miami\/codes\/code_of_ordinances?nodeId=CHCO_CH62PLZO\u0022\u003EChapter 62\u003C\/a\u003E, Article XVI, of the City Code regarding the AIPBB, procedures, and other applicable requirements.\u003C\/p\u003E","id":"eda269d1-3406-4736-a683-aca40f501618","prev_id":null}]},{"path":"\/d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0\/86280f43-f70e-47ea-8370-765ad49537ec","ref":{"parent":"d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h3"},"pos":"215-13","docId":"45","text":"11.3 PUBLIC ART MASTER PLAN AND PUBLIC ART PROGRAM GUIDELINES","id":"86280f43-f70e-47ea-8370-765ad49537ec","children":[{"path":"\/d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0\/86280f43-f70e-47ea-8370-765ad49537ec\/49e707d6-cabb-4e97-874c-45b796517899","ref":{"parent":"86280f43-f70e-47ea-8370-765ad49537ec","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"215-13-11","docId":"45","text":"\u003Cp\u003EThe Public Art Division shall prepare both a Public Art Master Plan and Public Art Program Guidelines as defined in \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\\c9d65e2d-e16d-4fe6-a424-0e3b63f9c83c\\f667fd20-0441-41de-91ed-1893f5f97838\u0022 target=\u0022_blank\u0022\u003EArticle 1, Section 1.5\u003C\/a\u003E. The Public Art Master Plan and the Public Art Program Guidelines shall be prepared and subject to approval of the City Commission, pursuant to a recommendation by the AIPPB. The Commission, pursuant to a recommendation by the AIPPB, shall also review and approve amendments to the Public Art Master Plan and the Public Art Program Guidelines, as may be proposed by the Public Art Division.\u003C\/p\u003E","id":"49e707d6-cabb-4e97-874c-45b796517899","prev_id":null}]},{"path":"\/d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0\/09980ae7-01e3-464e-a244-e0ec8155deb6","ref":{"parent":"d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h3"},"pos":"215-14","docId":"45","text":"11.4 APPLICABILITY","id":"09980ae7-01e3-464e-a244-e0ec8155deb6","children":[{"path":"\/d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0\/09980ae7-01e3-464e-a244-e0ec8155deb6\/0d36ea79-4336-4acc-bef1-cf207f87adbe","ref":{"parent":"09980ae7-01e3-464e-a244-e0ec8155deb6","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"215-14-11","docId":"45","text":"\u003Col start=\u00221\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003EGovernment Development Projects including but not limited to those by the City, a Community Redevelopment Agency, the County, the State, or any other governmental agency shall comply with the provisions of \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\\d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0\\330816e8-7c58-423b-89a7-89448c5bb5f1\u0022 target=\u0022_blank\u0022\u003ESection 11.7\u003C\/a\u003E of this Article.\u003C\/li\u003E\n\t\u003Cli\u003EThe Building Department will calculate the pertinent Public Art Fee in accordance with this Article. When disputes arise in determining the Public Art Fee, the Developer(s) shall provide the Building Department and the Public Art Division a copy of the executed notarized construction services contract(s) for the Government Development Project so that the City can accurately determine the Construction Cost and properly calculate the Public Art Fee based upon the anticipated Construction Cost.\u003C\/li\u003E\n\t\u003Cli\u003EThe AIPPB, at a public hearing, may waive the following from the Public Art Program upon recommendation from the Public Art Division:\n\t\u003Col\u003E\n\t\t\u003Cli\u003EThe reconstruction of Structures which have been damaged by fire, flood, wind, or other act of God.\u003C\/li\u003E\n\t\t\u003Cli\u003EThe restoration or rehabilitation of a portion(s) of a Historic Resource as defined in \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\\c9d65e2d-e16d-4fe6-a424-0e3b63f9c83c\\f667fd20-0441-41de-91ed-1893f5f97838\u0022 target=\u0022_blank\u0022\u003EArticle 1, Section 1.5\u003C\/a\u003E. that does not alter the size or occupancy load of the Structure.\u003C\/li\u003E\n\t\t\u003Cli\u003EThe repair or rehabilitation of a Structure for the installation of fire sprinklers or improvements pursuant to the American with Disabilities Act.\u003C\/li\u003E\n\t\t\u003Cli\u003EGovernment Development Projects funded by grant(s) that prohibit the use of grant funds for purposes not specified under the grant(s).\u003C\/li\u003E\n\t\t\u003Cli\u003EAffordable Housing Developments not otherwise required to provide Public Art pursuant to Section 2-11.15 of the Miami-Dade County Code, as amended.\u003C\/li\u003E\n\t\u003C\/ol\u003E\n\t\u003C\/li\u003E\n\u003C\/ol\u003E","id":"0d36ea79-4336-4acc-bef1-cf207f87adbe","prev_id":null}]},{"path":"\/d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0\/02e10c4e-7844-4f61-8aae-23804215435c","ref":{"parent":"d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":0,"tag":"h3"},"pos":"215-15","docId":"45","text":"11.5 RESERVED","id":"02e10c4e-7844-4f61-8aae-23804215435c"},{"path":"\/d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0\/31dd0fdc-8f7d-41e1-bbf7-2380bcf58299","ref":{"parent":"d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":0,"tag":"h3"},"pos":"215-16","docId":"45","text":"11.6 RESERVED","id":"31dd0fdc-8f7d-41e1-bbf7-2380bcf58299"},{"path":"\/d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0\/330816e8-7c58-423b-89a7-89448c5bb5f1","ref":{"parent":"d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h3"},"pos":"215-17","docId":"45","text":"11.7 GOVERNMENT DEVELOPMENT PROJECTS - PUBLIC ART REQUIREMENT","id":"330816e8-7c58-423b-89a7-89448c5bb5f1","children":[{"path":"\/d4e51fd3-3d4c-4b4f-a25a-47256c6f26e0\/330816e8-7c58-423b-89a7-89448c5bb5f1\/0920237c-a713-4023-bcab-bb9bed523ecb","ref":{"parent":"330816e8-7c58-423b-89a7-89448c5bb5f1","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"215-17-11","docId":"45","text":"\u003Col start=\u00221\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003EAll Developers for Government Development Projects shall provide for the acquisition of Art equivalent in value to not less than one and one-half percent (1.5%) of the Project Cost of all Government Development Projects. Acquisition, commissioning, and selection of Art for Government Development Projects shall be in accordance with the criteria and standards set forth in the adopted Public Art Master Plan and Public Art Program Guidelines and subject to approval by the AIPPB. To the extent the total amount is not used for the acquisition, selection, or commissioning of Art, the remainder may be used for:\n\t\u003Col\u003E\n\t\t\u003Cli\u003EPublic Art Program or administrative costs, repair and maintenance of any Art acquired under this Section, or insurance for any Art; or\u003C\/li\u003E\n\t\t\u003Cli\u003ETo supplement other acquisition, commissioning, or selection of Art under this Section or the costs to transport, relocate, or remove Art in, on, or near government facilities which have already been constructed.\u003C\/li\u003E\n\t\u003C\/ol\u003E\n\t\u003C\/li\u003E\n\t\u003Cli\u003EPrivate funds used for Government Development Projects on land owned by the City, County, State, federal or any other governmental agency and on private property are subject to a one and a one-half percent (1.5%) Public Art Fee to be paid into the Fund prior to issuance of a master building permit.\u003C\/li\u003E\n\t\u003Cli\u003EThe AIPPB, upon a public hearing, may exempt the following from the Public Art Program upon recommendation from the Public Art Division:\n\t\u003Col start=\u00221\u0022 style=\u0022list-style-type:lower-roman\u0022\u003E\n\t\t\u003Cli\u003EThe requirements of Section 11.7(a) may be waived by resolution of the AIPPB when a Government Development Project is funded by grant(s) that prohibit the use of grant funds for purposes not specified under the grant(s); or\u003C\/li\u003E\n\t\t\u003Cli\u003EGovernment Development Projects or portions thereof that do not include Structures.\u003C\/li\u003E\n\t\u003C\/ol\u003E\n\t\u003C\/li\u003E\n\u003C\/ol\u003E","id":"0920237c-a713-4023-bcab-bb9bed523ecb","prev_id":null}]}]}]