a45a2e4-a329-4a33-a8a2-1bf0be6bd708","prev_id":null}]},{"path":"\/506df571-d1e3-4692-bfb3-816db47b916c\/f23cb225-70c9-4f65-a693-219d6f4933c1\/fe5e12e4-67fa-4666-a8c3-b04c28ecc6a4\/3fe2f464-1b30-4bb3-b34c-a024e8f3169b","ref":{"parent":"fe5e12e4-67fa-4666-a8c3-b04c28ecc6a4","name":"subsection"},"pos":"13-12-14-17","li_attr":{"hasChildren":2,"tag":"h3"},"docId":"94","id":"3fe2f464-1b30-4bb3-b34c-a024e8f3169b","prev_id":null,"children":[{"path":"\/506df571-d1e3-4692-bfb3-816db47b916c\/f23cb225-70c9-4f65-a693-219d6f4933c1\/fe5e12e4-67fa-4666-a8c3-b04c28ecc6a4\/3fe2f464-1b30-4bb3-b34c-a024e8f3169b\/8ae0956f-01dd-4dcf-bf07-b7a9e53d4c3f","ref":{"parent":"3fe2f464-1b30-4bb3-b34c-a024e8f3169b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-12-14-17-11","docId":"94","text":"\u003Cp\u003EThe City shall encourage and cooperate with the Miami-Dade County Public Schools in their effort for public school siting reviews to help accomplish the objectives and policies of this element and other elements of the MCNP.  The City shall cooperate with the Public Schools to establish provisions for a scoping or pre-application meeting as part of the educational facilities review process, if determined to be warranted.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"8ae0956f-01dd-4dcf-bf07-b7a9e53d4c3f","prev_id":null}]},{"path":"\/506df571-d1e3-4692-bfb3-816db47b916c\/f23cb225-70c9-4f65-a693-219d6f4933c1\/fe5e12e4-67fa-4666-a8c3-b04c28ecc6a4\/133cf43a-61c1-44dc-89fe-b791205dabfd","ref":{"parent":"fe5e12e4-67fa-4666-a8c3-b04c28ecc6a4","name":"subsection"},"pos":"13-12-14-18","li_attr":{"hasChildren":2,"tag":"h3"},"docId":"94","id":"133cf43a-61c1-44dc-89fe-b791205dabfd","prev_id":null,"children":[{"path":"\/506df571-d1e3-4692-bfb3-816db47b916c\/f23cb225-70c9-4f65-a693-219d6f4933c1\/fe5e12e4-67fa-4666-a8c3-b04c28ecc6a4\/133cf43a-61c1-44dc-89fe-b791205dabfd\/df03d942-84d8-4df2-9cb8-345f9d8cbafa","ref":{"parent":"133cf43a-61c1-44dc-89fe-b791205dabfd","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-12-14-18-11","docId":"94","text":"\u003Cp\u003EThe City will continue to cooperate with Miami-Dade County Public Schools in utilizing Miami-Dade County Public Schools as emergency shelters during county emergencies.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"df03d942-84d8-4df2-9cb8-345f9d8cbafa","prev_id":null}]}]},{"path":"\/506df571-d1e3-4692-bfb3-816db47b916c\/f23cb225-70c9-4f65-a693-219d6f4933c1\/284dd657-2350-4423-bf31-08f1b8f381f9","ref":{"parent":"f23cb225-70c9-4f65-a693-219d6f4933c1","name":"subsection"},"pos":"13-12-15","li_attr":{"hasChildren":2,"tag":"h3"},"docId":"94","id":"284dd657-2350-4423-bf31-08f1b8f381f9","prev_id":null,"children":[{"path":"\/506df571-d1e3-4692-bfb3-816db47b916c\/f23cb225-70c9-4f65-a693-219d6f4933c1\/284dd657-2350-4423-bf31-08f1b8f381f9\/27c0c888-bbc9-4b22-82e8-3fcb55313f70","ref":{"parent":"284dd657-2350-4423-bf31-08f1b8f381f9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-12-15-11","docId":"94","text":"\u003Cp\u003E\u003Cstrong\u003EThe Miami-Dade County Public Schools, in conjunction with the City of Miami and other appropriate agencies, will strive to improve security and safety for students and staff.\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"27c0c888-bbc9-4b22-82e8-3fcb55313f70","prev_id":null},{"path":"\/506df571-d1e3-4692-bfb3-816db47b916c\/f23cb225-70c9-4f65-a693-219d6f4933c1\/284dd657-2350-4423-bf31-08f1b8f381f9\/2ec010b6-c6bc-406b-9153-f25234114709","ref":{"parent":"284dd657-2350-4423-bf31-08f1b8f381f9","name":"subsection"},"pos":"13-12-15-12","li_attr":{"hasChildren":2,"tag":"h3"},"docId":"94","id":"2ec010b6-c6bc-406b-9153-f25234114709","prev_id":null,"children":[{"path":"\/506df571-d1e3-4692-bfb3-816db47b916c\/f23cb225-70c9-4f65-a693-219d6f4933c1\/284dd657-2350-4423-bf31-08f1b8f381f9\/2ec010b6-c6bc-406b-9153-f25234114709\/d1de274f-7402-4814-a2d2-3be7f8dacb8f","ref":{"parent":"2ec010b6-c6bc-406b-9153-f25234114709","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-12-15-12-11","docId":"94","text":"\u003Cp\u003EContinue to cooperate with the Miami-Dade County Public Schools to develop and\/or implement programs and policies designed to reduce the incidence of violence, weapons and vandalism on school campuses.  Encourage the design of facilities, which do not encourage criminal behavior and provide clear sight lines from the street.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d1de274f-7402-4814-a2d2-3be7f8dacb8f","prev_id":null}]},{"path":"\/506df571-d1e3-4692-bfb3-816db47b916c\/f23cb225-70c9-4f65-a693-219d6f4933c1\/284dd657-2350-4423-bf31-08f1b8f381f9\/667dbaaf-6a4b-461c-9f11-e73117540cb8","ref":{"parent":"284dd657-2350-4423-bf31-08f1b8f381f9","name":"subsection"},"pos":"13-12-15-13","li_attr":{"hasChildren":2,"tag":"h3"},"docId":"94","id":"667dbaaf-6a4b-461c-9f11-e73117540cb8","prev_id":null,"children":[{"path":"\/506df571-d1e3-4692-bfb3-816db47b916c\/f23cb225-70c9-4f65-a693-219d6f4933c1\/284dd657-2350-4423-bf31-08f1b8f381f9\/667dbaaf-6a4b-461c-9f11-e73117540cb8\/bc7efaba-7959-4f45-a195-d2633f817732","ref":{"parent":"667dbaaf-6a4b-461c-9f11-e73117540cb8","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-12-15-13-11","docId":"94","text":"\u003Cp\u003EContinue to cooperate with the Miami-Dade County Public Schools to develop and\/or implement programs and policies designed to reduce the number of incidents related to hazardous conditions as reported by the Environmental Protection Agency (EPA), the fire marshal, the State Department of Education (DOE), and other appropriate sources.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"bc7efaba-7959-4f45-a195-d2633f817732","prev_id":null}]},{"path":"\/506df571-d1e3-4692-bfb3-816db47b916c\/f23cb225-70c9-4f65-a693-219d6f4933c1\/284dd657-2350-4423-bf31-08f1b8f381f9\/d34fa3d3-4181-4d66-804f-d8e64b115c60","ref":{"parent":"284dd657-2350-4423-bf31-08f1b8f381