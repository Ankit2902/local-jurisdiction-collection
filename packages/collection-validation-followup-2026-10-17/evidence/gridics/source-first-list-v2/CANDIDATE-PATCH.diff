to continue the design and construction of educational facilities which create the perception of feeling welcome, secure and positive about the students\u0027 school environment and experiences.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"b8c1b8d0-354e-4b41-926f-c920f993f175","prev_id":null}]},{"path":"\/506df571-d1e3-4692-bfb3-816db47b916c\/f23cb225-70c9-4f65-a693-219d6f4933c1\/9c533295-02bb-4c3e-aab9-f3bed362bde5\/40c931ca-f715-409a-b6ae-d6869f715bdc","ref":{"parent":"9c533295-02bb-4c3e-aab9-f3bed362bde5","name":"subsection"},"pos":"13-12-17-13","li_attr":{"hasChildren":2,"tag":"h3"},"docId":"94","id":"40c931ca-f715-409a-b6ae-d6869f715bdc","prev_id":null,"children":[{"path":"\/506df571-d1e3-4692-bfb3-816db47b916c\/f23cb225-70c9-4f65-a693-219d6f4933c1\/9c533295-02bb-4c3e-aab9-f3bed362bde5\/40c931ca-f715-409a-b6ae-d6869f715bdc\/92f94300-3e6e-4ed0-9af0-711e3c7f55c2","ref":{"parent":"40c931ca-f715-409a-b6ae-d6869f715bdc","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-12-17-13-11","docId":"94","text":"\u003Cp\u003EThe Miami-Dade County Public Schools is encouraged to continue to design and construct facilities which better provide student access to technology designed to improve learning, such as updated media centers and science laboratories. \u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"92f94300-3e6e-4ed0-9af0-711e3c7f55c2","prev_id":null}]},{"path":"\/506df571-d1e3-4692-bfb3-816db47b916c\/f23cb225-70c9-4f65-a693-219d6f4933c1\/9c533295-02bb-4c3e-aab9-f3bed362bde5\/84b81eb5-60c2-4ff2-8bfc-bd49d62071f3","ref":{"parent":"9c533295-02bb-4c3e-aab9-f3bed362bde5","name":"subsection"},"pos":"13-12-17-14","li_attr":{"hasChildren":2,"tag":"h3"},"docId":"94","id":"84b81eb5-60c2-4ff2-8bfc-bd49d62071f3","prev_id":null,"children":[{"path":"\/506df571-d1e3-4692-bfb3-816db47b916c\/f23cb225-70c9-4f65-a693-219d6f4933c1\/9c533295-02bb-4c3e-aab9-f3bed362bde5\/84b81eb5-60c2-4ff2-8bfc-bd49d62071f3\/7c87312d-6b12-4a35-ac1e-7637c27c151e","ref":{"paren