+    def test_mislabeled_image_has_no_persistable_body(self):
+        response=Mock(headers={'content-type':'text/css'});response.body.return_value=b'\x89PNG\r\n\x1a\nbytes'
+        self.assertIsNone(read_nonimage_response(response)[0])
