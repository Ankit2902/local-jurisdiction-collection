[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5","ref":{"name":"section"},"li_attr":{"dataTag":"section","hasChildren":1,"tag":"h2"},"pos":"217","docId":"45","text":"Appendix B - Waterfront Design Guidelines","id":"80117d52-4069-4169-b7c2-9cbdb12944d5","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/4dde5808-af11-48cc-b42a-f61c1b9b7599","ref":{"parent":"80117d52-4069-4169-b7c2-9cbdb12944d5","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-11","docId":"45","text":"\u003Ctable border=\u00221\u0022 cellpadding=\u00220\u0022 cellspacing=\u00220\u0022\u003E\n\t\u003Cthead\u003E\n\t\t\u003Ctr\u003E\n\t\t\t\u003Cth colspan=\u00225\u0022 scope=\u0022col\u0022\u003E\n\t\t\t\u003Cp\u003E\u003Cstrong\u003EAMENDMENTS TO MIAMI 21\u003C\/strong\u003E\u003C\/p\u003E\n\t\t\t\u003C\/th\u003E\n\t\t\u003C\/tr\u003E\n\t\u003C\/thead\u003E\n\t\u003Ctbody\u003E\n\t\t\u003Ctr\u003E\n\t\t\t\u003Ctd\u003E\n\t\t\t\u003Cp\u003E\u003Cstrong\u003EORDINANCE\u003C\/strong\u003E\u003C\/p\u003E\n\t\t\t\u003C\/td\u003E\n\t\t\t\u003Ctd colspan=\u00222\u0022\u003E\n\t\t\t\u003Cp\u003E\u003Cstrong\u003EDATE APPROVED\u003C\/strong\u003E\u003C\/p\u003E\n\t\t\t\u003C\/td\u003E\n\t\t\t\u003Ctd\u003E\n\t\t\t\u003Cp\u003E\u003Cstrong\u003EDESCRIPTION\u003C\/strong\u003E\u003C\/p\u003E\n\t\t\t\u003C\/td\u003E\n\t\t\t\u003Ctd\u003E\n\t\t\t\u003Cp\u003E\u003Cstrong\u003ELEGISLATIVE ID\u003C\/strong\u003E\u003C\/p\u003E\n\t\t\t\u003C\/td\u003E\n\t\t\u003C\/tr\u003E\n\t\t\u003Ctr\u003E\n\t\t\t\u003Ctd\u003E\n\t\t\t\u003Cp\u003E13235\u003C\/p\u003E\n\t\t\t\u003C\/td\u003E\n\t\t\t\u003Ctd colspan=\u00222\u0022\u003E\n\t\t\t\u003Cp\u003E11-18-2010\u003C\/p\u003E\n\t\t\t\u003C\/td\u003E\n\t\t\t\u003Ctd\u003E\n\t\t\t\u003Cp\u003EMinor and non-substantial modifications throughout the Code\u003C\/p\u003E\n\t\t\t\u003C\/td\u003E\n\t\t\t\u003Ctd\u003E\n\t\t\t\u003Cp\u003E10-00956zt\u003C\/p\u003E\n\t\t\t\u003C\/td\u003E\n\t\t\u003C\/tr\u003E\n\t\t\u003Ctr\u003E\n\t\t\t\u003Ctd\u003E14016\u003C\/td\u003E\n\t\t\t\u003Ctd colspan=\u00222\u0022\u003E07-22-2021\u003C\/td\u003E\n\t\t\t\u003Ctd\u003E\n\t\t\t\u003Cp\u003EWaterfront Design Guidelines\u0022 of Miami 21 to allow flexibility for bay and river walkway design \u003C\/p\u003E\n\t\t\t\u003C\/td\u003E\n\t\t\t\u003Ctd\u003E9113\u003C\/td\u003E\n\t\t\u003C\/tr\u003E\n\t\u003C\/tbody\u003E\n\u003C\/table\u003E\u003Cp\u003E\u003C\/p\u003E","id":"4dde5808-af11-48cc-b42a-f61c1b9b7599","prev_id":null},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/06069ab0-f05f-4ed8-b0e7-efa46a00c7c3","ref":{"parent":"80117d52-4069-4169-b7c2-9cbdb12944d5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"217-12","docId":"45","text":"Section 1: Goals and Intent","id":"06069ab0-f05f-4ed8-b0e7-efa46a00c7c3","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/06069ab0-f05f-4ed8-b0e7-efa46a00c7c3\/623e4fa3-2b8b-42ff-a703-31b626c6d83c","ref":{"parent":"06069ab0-f05f-4ed8-b0e7-efa46a00c7c3","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-12-11","docId":"45","text":"\u003Cp\u003E\u003C\/p\u003E","id":"623e4fa3-2b8b-42ff-a703-31b626c6d83c","prev_id":null},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/06069ab0-f05f-4ed8-b0e7-efa46a00c7c3\/5b25f1d8-db19-4ec1-9ca7-e84d32e3f1c6","ref":{"parent":"06069ab0-f05f-4ed8-b0e7-efa46a00c7c3","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-12-12","docId":"45","text":"1.1 Background","id":"5b25f1d8-db19-4ec1-9ca7-e84d32e3f1c6","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/06069ab0-f05f-4ed8-b0e7-efa46a00c7c3\/5b25f1d8-db19-4ec1-9ca7-e84d32e3f1c6\/15817084-f85b-47b0-b653-96548acafd6d","ref":{"parent":"5b25f1d8-db19-4ec1-9ca7-e84d32e3f1c6","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-12-12-11","docId":"45","text":"\u003Cp\u003EIn 1979, the City of Miami\u2019s voters amended \u003Ca href=\u0022https:\/\/library.municode.com\/fl\/miami\/codes\/code_of_ordinances?nodeId=PTICHRELA_SPATHCH_S3PO\u0022 target=\u0022_blank\u0022\u003ESection 3(mm)(ii)\u003C\/a\u003E of the City Charter with the \u201cDan Paul Ordinance\u201d which requires new Buildings to be set back from the water\u2019s edge and to provide public access along Biscayne Bay and the Miami River. \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/cd9d9570-550f-47be-b530-33c1d29c4db3\/ce42359c-c251-47bc-abc8-7a64b3b5a237\u0022 target=\u0022_blank\u0022\u003ESection 3.11 \u003C\/a\u003Eof this Code titled \u201cWaterfront Standards\u201d further clarifies how public and private owners are required to build and maintain an approximate 25-foot Waterfront Walkway open to the public. This Appendix will provide guidelines and the \u003Ca href=\u0022http:\/\/codehub.gridics.com\/sites\/default\/files\/2021-10\/Miami_Waterfront_Materials_Index.pdf\u0022 target=\u0022_blank\u0022\u003EWaterfront Materials Index\u003C\/a\u003E will provide specifications to create a cohesive Riverwalk and Baywalk experience for those using the walkways.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"15817084-f85b-47b0-b653-96548acafd6d","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/06069ab0-f05f-4ed8-b0e7-efa46a00c7c3\/cf3a0d23-bd03-4da2-8e3e-793b2f4335f9","ref":{"parent":"06069ab0-f05f-4ed8-b0e7-efa46a00c7c3","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-12-13","docId":"45","text":"1.2 Goals and General Principles","id":"cf3a0d23-bd03-4da2-8e3e-793b2f4335f9","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/06069ab0-f05f-4ed8-b0e7-efa46a00c7c3\/cf3a0d23-bd03-4da2-8e3e-793b2f4335f9\/664d0e97-f4c6-43a1-9616-f83404b298d3","ref":{"parent":"cf3a0d23-bd03-4da2-8e3e-793b2f4335f9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-12-13-11","docId":"45","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003EGuide the overall vision for completion of the Miami Riverwalk, Baywalk, and other trails to establish a system of pedestrian-oriented connected public spaces with an established identity and character.\u003C\/li\u003E\n\t\u003Cli\u003ECreate a more resilient waterfront which provides space and opportunities to accommodate potential flooding from both stormwater and sea-level rise through sustainable practices.\u003C\/li\u003E\n\t\u003Cli\u003EEstablish a vibrant, active, high-quality, linear open space system that celebrates the City\u2019s waterfront identity and promotes civic art, educational, and cultural activities.\u003C\/li\u003E\n\t\u003Cli\u003ECreate a unified and continuous promenade experience along the City\u2019s waterfront, through the integration of consistent design components and complementary publicly oriented improvements.\u003C\/li\u003E\n\t\u003Cli\u003EIncrease mobility options and connectivity to the adjacent neighborhoods linking civic institutions, parks, plazas, landmarks, greenways, and water-related activities and amenities.\u003C\/li\u003E\n\t\u003Cli\u003EEstablish and reinforce strong visual and physical connections towards the Miami Baywalk \u0026amp; Riverwalk showcasing the City\u2019s ecology.\u003C\/li\u003E\n\u003C\/ol\u003E\u003Cp\u003E\u003C\/p\u003E","id":"664d0e97-f4c6-43a1-9616-f83404b298d3","prev_id":null}]}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/2718d38c-9c23-4284-bdfa-22f1148ea507","ref":{"parent":"80117d52-4069-4169-b7c2-9cbdb12944d5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"217-13","docId":"45","text":"Secton 2: Applicability and General Requirements","id":"2718d38c-9c23-4284-bdfa-22f1148ea507","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/2718d38c-9c23-4284-bdfa-22f1148ea507\/af9d5ed1-11d2-4c9d-81a6-9e4b9ba70317","ref":{"parent":"2718d38c-9c23-4284-bdfa-22f1148ea507","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-13-11","docId":"45","text":"\u003Cp\u003E\u003C\/p\u003E","id":"af9d5ed1-11d2-4c9d-81a6-9e4b9ba70317","prev_id":null},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/2718d38c-9c23-4284-bdfa-22f1148ea507\/3e4e805d-a5ff-42ae-a633-b20d104edfd3","ref":{"parent":"2718d38c-9c23-4284-bdfa-22f1148ea507","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-13-12","docId":"45","text":"2.1 Applicability","id":"3e4e805d-a5ff-42ae-a633-b20d104edfd3","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/2718d38c-9c23-4284-bdfa-22f1148ea507\/3e4e805d-a5ff-42ae-a633-b20d104edfd3\/54fbb13e-d8d8-4f2d-8811-de193d1f40bd","ref":{"parent":"3e4e805d-a5ff-42ae-a633-b20d104edfd3","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-13-12-11","docId":"45","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\t\u003Cli\u003EAppendix B shall apply to all properties along Waterways as identified in \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/cd9d9570-550f-47be-b530-33c1d29c4db3\/18cc51ba-3863-47a3-882e-255939a92ecb\u0022 target=\u0022_blank\u0022\u003EDiagram 1 of Section 3.11\u003C\/a\u003E of this Code as well as those meeting criteria described in \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/cd9d9570-550f-47be-b530-33c1d29c4db3\/ce42359c-c251-47bc-abc8-7a64b3b5a237\u0022 target=\u0022_blank\u0022\u003ESection 3.11\u003C\/a\u003E.b.1.\u003C\/li\u003E\t\u003Cli\u003EAdaptively reused properties fronting Waterways that introduce new Residential, Lodging, Office, Recreational, or Commercial uses shall incorporate Waterfront walkways within the limits created by existing structures.\u003C\/li\u003E\t\u003Cli\u003EMiami River greenways are required as an alternative path when industrial uses prevent waterfront pathways pursuant to the Waterfront Design Standards.\u003C\/li\u003E\t\u003Cli\u003EThe Planning Director, or designee, administers design guidelines and makes determinations regarding requests for deviations from standards pursuant to \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/cd9d9570-550f-47be-b530-33c1d29c4db3\/ce42359c-c251-47bc-abc8-7a64b3b5a237\u0022 target=\u0022_blank\u0022\u003ESection 3.11\u003C\/a\u003E.b.6.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E\u003C\/p\u003E","id":"54fbb13e-d8d8-4f2d-8811-de193d1f40bd","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/2718d38c-9c23-4284-bdfa-22f1148ea507\/55915422-e619-42c8-ac39-6a28a8312f81","ref":{"parent":"2718d38c-9c23-4284-bdfa-22f1148ea507","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-13-13","docId":"45","text":"2.2 General Requirements","id":"55915422-e619-42c8-ac39-6a28a8312f81","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/2718d38c-9c23-4284-bdfa-22f1148ea507\/55915422-e619-42c8-ac39-6a28a8312f81\/51b451ce-a0a1-402b-84ae-aa61f57754e0","ref":{"parent":"55915422-e619-42c8-ac39-6a28a8312f81","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-13-13-11","docId":"45","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003ESetbacks and dimensions are measured from the mean high-water line as defined by Florida Statute (typically the waterside face of a seawall).\u003C\/li\u003E\n\t\u003Cli\u003EWaterfront walkways shall feel public and shall be open to public access during all times, but at a minimum shall remain open to the public between 6:00 A.M. through 10:00 P.M.\u003C\/li\u003E\n\t\u003Cli\u003EThe public should feel welcome and at ease to move along the entire length of the waterfront. No one should feel, or be made to feel, as if he or she is intruding on private property.\u003C\/li\u003E\n\t\u003Cli\u003ESignage should clearly establish the public\u2019s right to use the walkway.\u003C\/li\u003E\n\t\u003Cli\u003EWaterfront walkways shall provide unobstructed visual access to the water.\u003C\/li\u003E\n\t\u003Cli\u003EWaterfront walkways shall connect to abutting public walkways, parks, transit stops, thoroughfares, publicly-accessible midblock walkways, publicly accessible plazas, neighboring walkways, and other publicly-accessible Open Spaces to allow clear pedestrian circulation along the water\u2019s edge.\u003C\/li\u003E\n\t\u003Cli\u003EWhen waterfront setback requirements are reduced pursuant to \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/cd9d9570-550f-47be-b530-33c1d29c4db3\/ce42359c-c251-47bc-abc8-7a64b3b5a237\u0022 target=\u0022_blank\u0022\u003ESection 3.11\u003C\/a\u003E.a. and sites are too narrow for full implementation of design guidelines, priority is given to:\n\t\u003Col\u003E\n\t\t\u003Cli\u003ESafety: by preserving the safety zone or providing an alternative safety barrier such as curb and railing.\u003C\/li\u003E\n\t\t\u003Cli\u003EPedestrian circulation: by preserving the minimum 12-foot-wide circulation zone.\u003C\/li\u003E\n\t\t\u003Cli\u003EPedestrian comfort: by providing shade for pedestrians.\u003C\/li\u003E\n\t\u003C\/ol\u003E\n\t\u003C\/li\u003E\n\t\u003Cli\u003EBulkheads \/ Seawalls shall be constructed pursuant to the requirements found in \u003Ca href=\u0022https:\/\/library.municode.com\/fl\/miami\/codes\/code_of_ordinances?nodeId=PTIITHCO_CH29LAWAIM_ARTIIIBUSELISHPIDOGRMARAOTSIST\u0022 target=\u0022_blank\u0022\u003EChapter 29, Article III\u003C\/a\u003E of the City Code including the ability to raise walls in the future.\u003C\/li\u003E\n\t\u003Cli\u003EThe top elevation of bulkheads, seawalls, or other barriers shall be pursuant to the requirements of \u003Ca href=\u0022https:\/\/library.municode.com\/fl\/orange_county\/codes\/code_of_ordinances?nodeId=PTIIORCOCO_CH29PARE\u0022 target=\u0022_blank\u0022\u003ESection 29\u003C\/a\u003E-89 of the City Code except those fronting the Miami River which shall be set in accordance with \u003Ca href=\u0022https:\/\/library.municode.com\/fl\/miami\/codes\/code_of_ordinances?nodeId=CHCO_CH54STSI_ARTIICOEXRE_S54-46AGBORI-WSUIMPESUPLREETCO\u0022 target=\u0022_blank\u0022\u003ESection 54-46(2)\u003C\/a\u003E of the City Code.\u003C\/li\u003E\n\t\u003Cli\u003ENatural \/ Living Shorelines\n\t\u003Col\u003E\n\t\t\u003Cli\u003EWalkways along a natural shoreline or rip rap shoreline may be set back from the edge of the shoreline and meander within the waterfront setback area.\u003C\/li\u003E\n\t\t\u003Cli\u003EAreas with natural shorelines must transition to adjacent properties in elevation and alignment to comply with circulation standards in \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f045ac65-ec84-42c2-b973-fa697f8eede0\/ecf5ec6e-4c4c-4fa0-9c5e-5650dd2f8360\u0022 target=\u0022_blank\u0022\u003EAppendix B, Section 3.3\u003C\/a\u003E.\u003C\/li\u003E\n\t\t\u003Cli\u003EProperties with natural shorelines must provide flood protection equivalent to requirements in \u003Ca href=\u0022https:\/\/library.municode.com\/fl\/miami\/codes\/code_of_ordinances?nodeId=PTIITHCO_CH29LAWAIM_ARTIIIBUSELISHPIDOGRMARAOTSIST\u0022 target=\u0022_blank\u0022\u003EChapter 29, Article III\u003C\/a\u003E of the City Code via berm, wall, or similar elements to protect rights of way and adjacent properties from flooding. Flood barriers may be setback from the shoreline if the natural area may safely accommodate flooding.\u003C\/li\u003E\n\t\u003C\/ol\u003E\n\t\u003C\/li\u003E\n\t\u003Cli\u003EIn efforts to provide more natural elements and better integration of Civic Space design and programming for Waterfront walkways into CS and T1 Transect Zones and properties that volunteer to participate in the Waterfront Edge Design Guideline (\u201cWEDG\u201d) program, standards may be adjusted by process of Waiver but shall not diminish the Circulation Zone identified within \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f045ac65-ec84-42c2-b973-fa697f8eede0\u0022 target=\u0022_blank\u0022\u003ESection 3\u003C\/a\u003E with clear path no less than fifteen (15) feet in total width provided. Nor shall WEDG participation negate the requirements of \u003Ca href=\u0022https:\/\/library.municode.com\/fl\/miami\/codes\/code_of_ordinances?nodeId=PTIITHCO_CH29LAWAIM\u0022 target=\u0022_blank\u0022\u003EChapter 29\u003C\/a\u003E of the City Code to protect neighboring properties or public right-of-ways from flooding.\n\t\u003Col\u003E\n\t\t\u003Cli\u003EWEDG is a credit system and series of guidelines beyond Appendix B, which are the result of a collaboration between government agencies, not-for-profit organizations, technical experts, and other waterfront stakeholders. This is a tool to guide and enhance projects on a voluntary basis. WEDG distills the complexities of waterfront science, engineering, and social engagement into comprehensive and easy to communicate design concepts and best practices. Where appropriate, new Developments may participate in the WEDG program to receive project certification that accomplishes waterfront resiliency, ecology, and accessibility beyond the standards required within Appendix B.\u003C\/li\u003E\n\t\u003C\/ol\u003E\n\t\u003C\/li\u003E\n\u003C\/ol\u003E\u003Cp\u003E\u003C\/p\u003E","id":"51b451ce-a0a1-402b-84ae-aa61f57754e0","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/2718d38c-9c23-4284-bdfa-22f1148ea507\/022bb73b-d4f8-4815-ab77-a2c45eecbdf1","ref":{"parent":"2718d38c-9c23-4284-bdfa-22f1148ea507","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-13-14","docId":"45","text":"2.3 General Frontage Requirements","id":"022bb73b-d4f8-4815-ab77-a2c45eecbdf1","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/2718d38c-9c23-4284-bdfa-22f1148ea507\/022bb73b-d4f8-4815-ab77-a2c45eecbdf1\/8f89ceaa-6024-4c06-b15f-a35876b605c0","ref":{"parent":"022bb73b-d4f8-4815-ab77-a2c45eecbdf1","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-13-14-11","docId":"45","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003EWaterfronts shall be Primary Frontages with parking, non-habitable structures, utilities, service, and loading areas screened from the walkway pursuant to \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/cd9d9570-550f-47be-b530-33c1d29c4db3\/cf053535-9dc9-460b-b403-eb0c43c9f517\u0022 target=\u0022_blank\u0022\u003ESection 3.3\u003C\/a\u003E of the Miami 21 Code. However, Facades may be set back from the waterfront Principal Frontage line when there is an active use adjacent to the walkway.\u003C\/li\u003E\n\t\u003Cli\u003EFor adjacent uses that serve the public (i.e. restaurants, shops, hotels, entertainment, etc.), the provision of wide, visible, and easy pedestrian access to the waterfront shall be required.\u003C\/li\u003E\n\t\u003Cli\u003ESecurity to limit public access to private property outside the Waterfront walkway footprint may be provided by fences, grade changes, or retaining walls. All fences, walls, and grade changes shall be buffered by landscaped elements or artistic treatments approved by the Planning Director to reduce negative visual impacts on walkways but shall not screen the waterfront from adjacent active uses.\u003C\/li\u003E\n\u003C\/ol\u003E\u003Cp\u003E\u003C\/p\u003E","id":"8f89ceaa-6024-4c06-b15f-a35876b605c0","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/2718d38c-9c23-4284-bdfa-22f1148ea507\/7a12f400-49b2-4350-ab3e-b470d368ef80","ref":{"parent":"2718d38c-9c23-4284-bdfa-22f1148ea507","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-13-15","docId":"45","text":"2.4 General Connection Requirements","id":"7a12f400-49b2-4350-ab3e-b470d368ef80","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/2718d38c-9c23-4284-bdfa-22f1148ea507\/7a12f400-49b2-4350-ab3e-b470d368ef80\/bb595124-2da0-4d85-b97f-2aa37dd0f0fc","ref":{"parent":"7a12f400-49b2-4350-ab3e-b470d368ef80","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-13-15-11","docId":"45","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003EPursuant to \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/cd9d9570-550f-47be-b530-33c1d29c4db3\/ce42359c-c251-47bc-abc8-7a64b3b5a237\u0022 target=\u0022_blank\u0022\u003ESection 3.11\u003C\/a\u003E.a.3 of the Miami 21 Code, Side Setbacks shall be equal in aggregate to twenty-five percent (25%) to allow public access to the Waterfront.\u003C\/li\u003E\n\t\u003Cli\u003EConsistent with \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/8ba0388c-fe18-4395-92f3-1838d1a3ff08\/e93fcc5e-8ae8-4b67-be05-f8fa2f11fbb6\/fcef9bd1-cb08-4e2a-974b-91328af767fa\u0022 target=\u0022_blank\u0022\u003ESections 5.5.1\u003C\/a\u003E and \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/8ba0388c-fe18-4395-92f3-1838d1a3ff08\/ff51b18b-70e6-4f35-90e8-a2a6b16d2013\/85aa74f4-0ae1-41c7-b4ce-abe3d2942cae\u0022\u003E5.6.1\u003C\/a\u003E of the Miami 21 Code, connections shall be a maximum of 340\u2019 apart when access to a public path or Thoroughfare is possible.\u003C\/li\u003E\n\t\u003Cli\u003EConnections through private property shall be a Civic Space Type pursuant to \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/cc66de11-c6ed-4007-a7b8-3a10fbb320c6\/26d9cbd8-b3b1-40d5-bb91-a178ecec8989\u0022 target=\u0022_blank\u0022\u003EArticle 4, Table 7\u003C\/a\u003E of the Miami 21 Code, though pedestrian passages may be as narrow as ten (10) feet.\u003C\/li\u003E\n\t\u003Cli\u003EConnections may substitute a combined passenger vehicle and pedestrian access point for the Civic Space type with the following conditions:\n\t\u003Col\u003E\n\t\t\u003Cli\u003ENo vehicular access shall be permitted within the required building setback area for all properties except those located in a D3 Transect Zone.\u003C\/li\u003E\n\t\t\u003Cli\u003EA minimum 10\u2019 wide contiguous pedestrian-only path from the right-of-way to the Waterfront walkway is provided in addition to the vehicular path.\u003C\/li\u003E\n\t\t\u003Cli\u003EThe connection shall have frequent doors and windows.\u003C\/li\u003E\n\t\u003C\/ol\u003E\n\t\u003C\/li\u003E\n\t\u003Cli\u003EConnections shall use signage, hardscape, and plant material consistent with \u003Ca href=\u0022http:\/\/codehub.gridics.com\/sites\/default\/files\/2021-10\/Miami_Waterfront_Materials_Index.pdf\u0022 target=\u0022_blank\u0022\u003EWaterfront Materials Index\u003C\/a\u003E or equivalents approved by the Planning Director.\u003C\/li\u003E\n\t\u003Cli\u003EProperties abutting a Thoroughfare or Public Frontage (i.e. a bridge or street) shall coordinate with the appropriate agencies regarding improvements and connections to Waterfront walkways required on those properties.\u003C\/li\u003E\n\t\u003Cli\u003EThoroughfares that terminate on the water\u2019s edge should be improved as a Play Street, maintaining View Corridors and creating direct connections between the walkways and the Thoroughfare network pursuant to \u003Ca href=\u0022https:\/\/library.municode.com\/fl\/orange_county\/codes\/code_of_ordinances?nodeId=PTIIORCOCO_CH35TR_ARTIINGE_S35-5ADFE\u0022 target=\u0022_blank\u0022\u003ESection 35-5\u003C\/a\u003E of the City Code and \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/cc66de11-c6ed-4007-a7b8-3a10fbb320c6\/26d9cbd8-b3b1-40d5-bb91-a178ecec8989\u0022 target=\u0022_blank\u0022\u003EArticle 4, Table 7\u003C\/a\u003E.k of the Miami 21 Code.\u003C\/li\u003E\n\u003C\/ol\u003E\u003Cp\u003E\u003C\/p\u003E","id":"bb595124-2da0-4d85-b97f-2aa37dd0f0fc","prev_id":null}]}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f045ac65-ec84-42c2-b973-fa697f8eede0","ref":{"parent":"80117d52-4069-4169-b7c2-9cbdb12944d5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"217-14","docId":"45","text":"Section 3: Zones","id":"f045ac65-ec84-42c2-b973-fa697f8eede0","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f045ac65-ec84-42c2-b973-fa697f8eede0\/375c4b2d-3c1f-499c-9856-289cfc4c9e47","ref":{"parent":"f045ac65-ec84-42c2-b973-fa697f8eede0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-14-11","docId":"45","text":"\u003Cp\u003E\u003C\/p\u003E","id":"375c4b2d-3c1f-499c-9856-289cfc4c9e47","prev_id":null},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f045ac65-ec84-42c2-b973-fa697f8eede0\/d0504af9-9698-47b4-990d-3120f9507ab5","ref":{"parent":"f045ac65-ec84-42c2-b973-fa697f8eede0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-14-12","docId":"45","text":"3.1 General","id":"d0504af9-9698-47b4-990d-3120f9507ab5","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f045ac65-ec84-42c2-b973-fa697f8eede0\/d0504af9-9698-47b4-990d-3120f9507ab5\/744fa155-6e6e-41ef-80d8-f4c7cdbdb3f2","ref":{"parent":"d0504af9-9698-47b4-990d-3120f9507ab5","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-14-12-11","docId":"45","text":"\u003Cp\u003EWalkway typologies are composed of zones including Seawall Zone, Safety Buffer Zone, Circulation Zone, and Passive Zone. Each individual zone shall serve its specific role as described within this Section.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"744fa155-6e6e-41ef-80d8-f4c7cdbdb3f2","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f045ac65-ec84-42c2-b973-fa697f8eede0\/26c111b1-2df0-43ef-8a27-215c83422cc6","ref":{"parent":"f045ac65-ec84-42c2-b973-fa697f8eede0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-14-13","docId":"45","text":"3.2 Seawall Zone","id":"26c111b1-2df0-43ef-8a27-215c83422cc6","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f045ac65-ec84-42c2-b973-fa697f8eede0\/26c111b1-2df0-43ef-8a27-215c83422cc6\/1417697b-7aca-48ca-8bc7-61131e0c82ed","ref":{"parent":"26c111b1-2df0-43ef-8a27-215c83422cc6","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-14-13-11","docId":"45","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003EThe top of the bulkhead \/ seawall shall be at a constant elevation for the length of the waterfront.\u003C\/li\u003E\n\t\u003Cli\u003EThe top of bulkheads \/ seawalls shall be a minimum of eighteen (18) inches and a maximum of twenty-four (24) inches in width.\u003C\/li\u003E\n\t\u003Cli\u003ESafety ladders of marine grade stainless steel or aluminum shall be placed a maximum of 100 feet apart along the face of the bulkhead \/ seawall to allow for climbing out of the water at low tide.\u003C\/li\u003E\n\t\u003Cli\u003EThe inside edge of the seawall \/ bulkhead shall be beveled pursuant to the illustration below.\u003C\/li\u003E\n\t\u003Cli\u003EThe top of the seawall \/ bulkhead shall be designed pursuant to selected typology in \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c\u0022 target=\u0022_blank\u0022\u003EAppendix B, Section 4\u003C\/a\u003E.\u003C\/li\u003E\n\t\u003Cli\u003EVertical flexibility which improves access to the water for purposes of providing boat or kayak launching or access is possible pursuant to the provisions in \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/80117d52-4069-4169-b7c2-9cbdb12944d5\/9308d08a-8e48-460a-8126-f45969125d35\u0022 target=\u0022_blank\u0022\u003EAppendix B, Section 5\u003C\/a\u003E.\u003C\/li\u003E\n\t\u003Cli\u003EBulkheads \/ seawalls shall meet all requirements consistent with \u003Ca href=\u0022https:\/\/library.municode.com\/fl\/miami\/codes\/code_of_ordinances?nodeId=PTIITHCO_CH29LAWAIM_ARTIIIBUSELISHPIDOGRMARAOTSIST\u0022 target=\u0022_blank\u0022\u003EChapter 29, Article III\u003C\/a\u003E and \u003Ca href=\u0022https:\/\/library.municode.com\/fl\/miami\/codes\/code_of_ordinances?nodeId=CHCO_CH54STSI_ARTIICOEXRE_S54-46AGBORI-WSUIMPESUPLREETCO\u0022 target=\u0022_blank\u0022\u003ESection 54-46 (2)\u003C\/a\u003E of the City Code.\u003C\/li\u003E\n\t\u003Cli\u003EDeviations to the requirements may be granted by the Director of the Department of Resilience and Public Works pursuant to the requirements in \u003Ca href=\u0022https:\/\/library.municode.com\/fl\/miami\/codes\/code_of_ordinances?nodeId=PTIITHCO_CH29LAWAIM\u0022 target=\u0022_blank\u0022\u003EChapter 29\u003C\/a\u003E of the City Code.\u003C\/li\u003E\n\u003C\/ol\u003E\u003Cp\u003E\u003Cimg alt=\u0022\u0022 height=\u0022301\u0022 src=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/codehub_files\/45_3308\/01miami.jpg\u0022 width=\u0022516\u0022\u003E\u003C\/p\u003E\u003Cp\u003E\u003Cem\u003E1: Seawall cap and safety buffer zone with hardscape installation, (planting is also permitted). \u003C\/em\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"1417697b-7aca-48ca-8bc7-61131e0c82ed","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f045ac65-ec84-42c2-b973-fa697f8eede0\/ecf5ec6e-4c4c-4fa0-9c5e-5650dd2f8360","ref":{"parent":"f045ac65-ec84-42c2-b973-fa697f8eede0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-14-14","docId":"45","text":"3.3 Safety Buffer Zone - Area adjacent to the seawall.","id":"ecf5ec6e-4c4c-4fa0-9c5e-5650dd2f8360","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f045ac65-ec84-42c2-b973-fa697f8eede0\/ecf5ec6e-4c4c-4fa0-9c5e-5650dd2f8360\/f26fe8c4-7494-41c4-a8e9-146dc7853ab6","ref":{"parent":"ecf5ec6e-4c4c-4fa0-9c5e-5650dd2f8360","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-14-14-11","docId":"45","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003EThe Safety Buffer Zone shall be designed in accordance with the selected typology.\u003C\/li\u003E\n\t\u003Cli\u003EThe surface of the Safety Buffer Zone shall be 6\u201d minimum below the top of bulkhead \/ seawall.\u003C\/li\u003E\n\t\u003Cli\u003EPaving within the Safety Buffer Zone shall be river rock, approximately 0.75 to 1.5 inches in diameter, set in concrete leaving a relief of 0.25 to 0.5 inches or similar aggregate pavers with ADA domes.\u003C\/li\u003E\n\t\u003Cli\u003EPlanting beds shall be a minimum five (5) feet wide with trees or palms planted at grade and low-level plantings provided at the base of the trees or palms.\u003C\/li\u003E\n\t\u003Cli\u003EPlanting beds may be narrower (minimum three (3) feet wide) if permeable pavers provide air and water to soil.\u003C\/li\u003E\n\t\u003Cli\u003EIn areas between the planting beds, a minimum of three (3) feet wide uniform exposed aggregate of river rock textured surface shall be provided.\u003C\/li\u003E\n\t\u003Cli\u003ELandscape lighting shall be provided to accentuate trees or palms in this area.\u003C\/li\u003E\n\t\u003Cli\u003ELow-level lighting (i.e. bollard, wall, or furnishing mounted) within the area adjacent to the Circulation Zone shall be installed to provide pedestrian \/ pathway lighting.\u003C\/li\u003E\n\u003C\/ol\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f26fe8c4-7494-41c4-a8e9-146dc7853ab6","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f045ac65-ec84-42c2-b973-fa697f8eede0\/c781211b-8526-4d84-aa2e-6ebaa343b174","ref":{"parent":"f045ac65-ec84-42c2-b973-fa697f8eede0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-14-15","docId":"45","text":"3.4 Circulation Zone \u2013 Unobstructed linear pedestrian walkways.","id":"c781211b-8526-4d84-aa2e-6ebaa343b174","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f045ac65-ec84-42c2-b973-fa697f8eede0\/c781211b-8526-4d84-aa2e-6ebaa343b174\/f8b83530-355b-46bf-ad25-340042804353","ref":{"parent":"c781211b-8526-4d84-aa2e-6ebaa343b174","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-14-15-11","docId":"45","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003EThe circulation zone shall be designed in accordance with typologies shown in \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c\u0022 target=\u0022_blank\u0022\u003EAppendix B, Section 4\u003C\/a\u003E.\u003C\/li\u003E\n\t\u003Cli\u003EThe circulation zone shall be constructed of non-slip paving materials with high aesthetic appearance and structural qualities pursuant to \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f73bb710-9cfb-4f23-aba3-8090ef346b86\/18e531c5-f770-43ce-9c4b-a1653d306111\u0022 target=\u0022_blank\u0022\u003EAppendix B, Section 6.3\u003C\/a\u003E.\u003C\/li\u003E\n\t\u003Cli\u003EThe walkway surface shall be accessible to disabled persons throughout the entire length of the waterfront and comply with ADA standards.\u003C\/li\u003E\n\t\u003Cli\u003EThe walkway may meander along the shoreline; however, all offsets in the alignment of the walkway shall not exceed ten (10) feet and be spaced not less than fifty (50) feet apart pursuant to \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/80117d52-4069-4169-b7c2-9cbdb12944d5\/9308d08a-8e48-460a-8126-f45969125d35\u0022 target=\u0022_blank\u0022\u003EAppendix B, Section 5\u003C\/a\u003E.\u003C\/li\u003E\n\t\u003Cli\u003EObstructions to movement (trees, bollards, lighting, etc.) within the circulation zone shall not reduce the clear width of the walkway to less than fifteen (15) feet at any point except in Typology 5 and Typology 6, where each walkway may be reduced to no less than eight (8) feet.\u003C\/li\u003E\n\u003C\/ol\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f8b83530-355b-46bf-ad25-340042804353","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f045ac65-ec84-42c2-b973-fa697f8eede0\/7ce1e8f0-b7fd-4238-a3f0-e7b510a431ac","ref":{"parent":"f045ac65-ec84-42c2-b973-fa697f8eede0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-14-16","docId":"45","text":"3.5 Transition\/Passive Zone \u2013 Area interspersed with shade trees, low level plantings, seating, lighting, and other furnishings.","id":"7ce1e8f0-b7fd-4238-a3f0-e7b510a431ac","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f045ac65-ec84-42c2-b973-fa697f8eede0\/7ce1e8f0-b7fd-4238-a3f0-e7b510a431ac\/2464d3b6-ba51-4da7-86dd-84a6b3a6964e","ref":{"parent":"7ce1e8f0-b7fd-4238-a3f0-e7b510a431ac","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-14-16-11","docId":"45","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003EThe transition\/passive zone shall be designed in accordance with the selected typology.\u003C\/li\u003E\n\t\u003Cli\u003EAccessories such as benches, trash receptacles, bicycle racks, drinking fountains, pedestrian scale light poles and landscape lighting, drinking fountains, etc. shall be confined to the passive zone.\u003C\/li\u003E\n\t\u003Cli\u003EAccessories shall be located so that no elements shall impede the circulation zone when in use i.e. benches shall be set back to accommodate users\u2019 limbs and bike racks located that attached bicycles do not obstruct circulation.\u003C\/li\u003E\n\u003C\/ol\u003E\u003Cp\u003E\u003C\/p\u003E","id":"2464d3b6-ba51-4da7-86dd-84a6b3a6964e","prev_id":null}]}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c","ref":{"parent":"80117d52-4069-4169-b7c2-9cbdb12944d5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"217-15","docId":"45","text":"Section 4: Walkway Typologies","id":"70cafb18-b3d5-437e-bbbc-caa2f2207a0c","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c\/af431bf4-cad7-421f-81ea-4aa1bdd25771","ref":{"parent":"70cafb18-b3d5-437e-bbbc-caa2f2207a0c","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-15-11","docId":"45","text":"\u003Cp\u003EThis Section presents guidelines for how promenade design components such as circulation paths, lighting, planting, public art, water access, and seating can be configured to provide continuous circulation, create a unified identity while promoting diversity of experience.\u003C\/p\u003E\u003Cp\u003EWalkway typologies are intended to allow flexibility in spatial configurations, reflecting, and adapting to adjacent conditions along the seawall, shoreline, public open space, and private development. Spacing regarding furnishings and landscape may either be at maximums shown in illustrations or based on performance and utility as described in \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f73bb710-9cfb-4f23-aba3-8090ef346b86\u0022 target=\u0022_blank\u0022\u003ESections 6\u003C\/a\u003E and \u003Ca href=\u0022https:\/\/codehub.gridics.com\/us\/fl\/miami#\/80117d52-4069-4169-b7c2-9cbdb12944d5\/5294c41e-c7b3-446c-82f9-a56b2df031e2\u0022 target=\u0022_blank\u0022\u003E7\u003C\/a\u003E. The promenade shall have the following configurations:\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"af431bf4-cad7-421f-81ea-4aa1bdd25771","prev_id":null},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c\/92ca644e-40ba-4dfc-a0ea-cafca4e61b77","ref":{"parent":"70cafb18-b3d5-437e-bbbc-caa2f2207a0c","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-15-12","docId":"45","text":"4.1. Typology 1: Central Walk","id":"92ca644e-40ba-4dfc-a0ea-cafca4e61b77","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c\/92ca644e-40ba-4dfc-a0ea-cafca4e61b77\/deb8518a-f9b1-422a-8096-1cd46bdcceb4","ref":{"parent":"92ca644e-40ba-4dfc-a0ea-cafca4e61b77","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-15-12-11","docId":"45","text":"\u003Cp\u003EWhere the walk is framed by landscape elements.\u003C\/p\u003E\u003Cp id=\u0022anchor--55417a9a-1a78-4330-88f9-0109d86b5c07\u0022\u003E\u003Cimg alt=\u0022\u0022 height=\u0022602\u0022 src=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/codehub_files\/45_3308\/02miami.jpg\u0022 width=\u0022881\u0022\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"deb8518a-f9b1-422a-8096-1cd46bdcceb4","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c\/0f9f1423-ff17-411f-9425-03326109d5a8","ref":{"parent":"70cafb18-b3d5-437e-bbbc-caa2f2207a0c","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-15-13","docId":"45","text":"4.2. Typology 2: Outside Walk with Bioswale","id":"0f9f1423-ff17-411f-9425-03326109d5a8","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c\/0f9f1423-ff17-411f-9425-03326109d5a8\/0623b72d-7a56-4cbc-8900-8ff910719d37","ref":{"parent":"0f9f1423-ff17-411f-9425-03326109d5a8","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-15-13-11","docId":"45","text":"\u003Cp\u003ESame as Typology 1 with bioswale in place of detectable river rock. \u003C\/p\u003E\u003Cp\u003E\u003Cimg alt=\u0022\u0022 height=\u0022606\u0022 src=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/codehub_files\/45_3636\/17miami.png\u0022 width=\u0022900\u0022\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0623b72d-7a56-4cbc-8900-8ff910719d37","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c\/83b63f5c-061c-484b-ab37-c9c4119b401b","ref":{"parent":"70cafb18-b3d5-437e-bbbc-caa2f2207a0c","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-15-14","docId":"45","text":"4.3. Typology 3: Inside Walk","id":"83b63f5c-061c-484b-ab37-c9c4119b401b","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c\/83b63f5c-061c-484b-ab37-c9c4119b401b\/6aa685e9-dfaf-46f9-b86f-41abf7d86350","ref":{"parent":"83b63f5c-061c-484b-ab37-c9c4119b401b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-15-14-11","docId":"45","text":"\u003Cp\u003EWhere the open or green space is adjacent to the water and the walk is on the opposite side.\u003C\/p\u003E\u003Cp\u003E\u003Cimg alt=\u0022\u0022 height=\u0022586\u0022 src=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/codehub_files\/45_3308\/04miami.jpg\u0022 width=\u0022899\u0022\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"6aa685e9-dfaf-46f9-b86f-41abf7d86350","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c\/194ed05b-43ca-4489-b47d-7fb1690489cd","ref":{"parent":"70cafb18-b3d5-437e-bbbc-caa2f2207a0c","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-15-15","docId":"45","text":"4.4. Typology 4: Meandering Walk","id":"194ed05b-43ca-4489-b47d-7fb1690489cd","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c\/194ed05b-43ca-4489-b47d-7fb1690489cd\/408d9f29-b5f3-4393-a057-58640daeedb7","ref":{"parent":"194ed05b-43ca-4489-b47d-7fb1690489cd","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-15-15-11","docId":"45","text":"\u003Cp\u003EA combination of the typologies where the main pedestrian path meanders away from the water and back towards it repetitively. (Overall walkway dimensions remain twenty-five feet (25\u2019).\u003C\/p\u003E\u003Cp\u003E\u003Cimg alt=\u0022\u0022 height=\u0022588\u0022 src=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/codehub_files\/45_3308\/05miami.jpg\u0022 width=\u0022893\u0022\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"408d9f29-b5f3-4393-a057-58640daeedb7","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c\/1aae6c9a-946a-421d-aaa7-bbc68e759a84","ref":{"parent":"70cafb18-b3d5-437e-bbbc-caa2f2207a0c","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-15-16","docId":"45","text":"4.5. Typology 5: Split Walk","id":"1aae6c9a-946a-421d-aaa7-bbc68e759a84","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c\/1aae6c9a-946a-421d-aaa7-bbc68e759a84\/953e6540-e910-4bb3-af8b-7c9354421673","ref":{"parent":"1aae6c9a-946a-421d-aaa7-bbc68e759a84","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-15-16-11","docId":"45","text":"\u003Cp\u003EThe walk is split into two and green space is in the center to allow for bikers and pedestrians to be separate or to create two different experiences: one facing the water and one facing the City.\u003C\/p\u003E\u003Cp\u003E\u003Cimg alt=\u0022\u0022 height=\u0022588\u0022 src=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/codehub_files\/45_3308\/06miami.jpg\u0022 width=\u0022903\u0022\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"953e6540-e910-4bb3-af8b-7c9354421673","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c\/0ec02bb8-0688-419f-964d-d23682b55c71","ref":{"parent":"70cafb18-b3d5-437e-bbbc-caa2f2207a0c","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-15-17","docId":"45","text":"4.6. Typology 6: Split Walk with Bioswale","id":"0ec02bb8-0688-419f-964d-d23682b55c71","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c\/0ec02bb8-0688-419f-964d-d23682b55c71\/bac3f335-7cd9-494c-8b0b-1ed6988d924e","ref":{"parent":"0ec02bb8-0688-419f-964d-d23682b55c71","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-15-17-11","docId":"45","text":"\u003Cp\u003ESame as Typology 5 with a bioswale in place of detectable river rock.\u003C\/p\u003E\u003Cp\u003E\u003Cimg alt=\u0022\u0022 height=\u0022568\u0022 src=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/codehub_files\/45_3308\/07miami.jpg\u0022 width=\u0022867\u0022\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"bac3f335-7cd9-494c-8b0b-1ed6988d924e","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c\/ce0b10e2-dea3-405b-9bf3-d0094298c7f6","ref":{"parent":"70cafb18-b3d5-437e-bbbc-caa2f2207a0c","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-15-18","docId":"45","text":"4.7. Typology 7: Amenity Walk","id":"ce0b10e2-dea3-405b-9bf3-d0094298c7f6","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c\/ce0b10e2-dea3-405b-9bf3-d0094298c7f6\/2707b13c-0de7-4e14-8b4f-380c8048d1b9","ref":{"parent":"ce0b10e2-dea3-405b-9bf3-d0094298c7f6","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-15-18-11","docId":"45","text":"\u003Cp\u003ESimilar to the Central Walk where the detectable river rock has been removed and the seawall has been raised to create a seating bench. Additional seating shall be provided in the form of half donut stone benches wrapping palm trees every fifty feet (50\u2019).\u003C\/p\u003E\u003Cp\u003E\u003Cimg alt=\u0022\u0022 height=\u0022598\u0022 src=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/codehub_files\/45_3308\/08miami.jpg\u0022 width=\u0022911\u0022\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"2707b13c-0de7-4e14-8b4f-380c8048d1b9","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c\/f8a03588-c1b6-4678-877d-d09edbc12edf","ref":{"parent":"70cafb18-b3d5-437e-bbbc-caa2f2207a0c","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-15-19","docId":"45","text":"4.8 Typology 8: On-Street Greenway layout","id":"f8a03588-c1b6-4678-877d-d09edbc12edf","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/70cafb18-b3d5-437e-bbbc-caa2f2207a0c\/f8a03588-c1b6-4678-877d-d09edbc12edf\/271d854f-8e38-48f9-a991-174baab2ca28","ref":{"parent":"f8a03588-c1b6-4678-877d-d09edbc12edf","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-15-19-11","docId":"45","text":"\u003Cp\u003EOn-Street Greenway layout shall create enhanced paths between waterfront segments.\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003ESidewalks on the waterside shall be a minimum of eight feet (8\u2019) clear and shall be broom-finished with integral colored concrete LM Scofield C-12 (Mesa Beige) or approved equivalent.\u003C\/li\u003E\n\t\u003Cli\u003ESidewalks on the waterside should meet minimum standards to qualify as an FDOT standard shared-use path whenever space permits.\u003C\/li\u003E\n\t\u003Cli\u003EStreet furnishings\n\t\u003Col\u003E\n\t\t\u003Cli\u003ELighting: FPL decorative package\u003C\/li\u003E\n\t\t\u003Cli\u003EBenches: Landscape Forms Plainwell bench or approved equivalent with Greenway custom medallion with a minimum of one (1) bench per block on both sides of the street.\u003C\/li\u003E\n\t\t\u003Cli\u003ETrash receptacles: Landscape Forms Plainwell receptacle or approved equivalent with a minimum of two (2) per intersection.\u003C\/li\u003E\n\t\t\u003Cli\u003EBicycle rack: Landscape Forms Pi rack or approved equivalent at a five hundred feet (500\u2019) minimum spacing.\u003C\/li\u003E\n\t\t\u003Cli\u003ESignage per the Design Standards.\u003C\/li\u003E\n\t\u003C\/ol\u003E\n\t\u003C\/li\u003E\n\t\u003Cli\u003ELandscape\n\t\u003Col\u003E\n\t\t\u003Cli\u003EShall be a continuous verge with continuous shade trees except at intersections where palms are permitted.\u003C\/li\u003E\n\t\t\u003Cli\u003ELandscape verge shall be seven feet (7\u2019) wide except when interrupted to allow for street furnishings or pedestrian access to crosswalks.\u003C\/li\u003E\n\t\u003C\/ol\u003E\n\t\u003C\/li\u003E\n\t\u003Cli\u003ECrosswalks on watersides connecting to Greenway shall incorporate colored concrete crosswalks, accent planting at corners, and wayfinding markers on the greenway side.\u003C\/li\u003E\n\u003C\/ol\u003E\u003Cp\u003E\u003Cimg alt=\u0022\u0022 height=\u0022422\u0022 src=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/codehub_files\/45_3308\/09miami.jpg\u0022 width=\u0022313\u0022\u003E\u003C\/p\u003E\u003Cp\u003E\u003Cem\u003E1: Typical cross section for sixty feet (60\u0027) wide right of way. \u003C\/em\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003Cimg alt=\u0022\u0022 height=\u0022410\u0022 src=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/codehub_files\/45_3308\/10miami.jpg\u0022 width=\u0022306\u0022\u003E\u003C\/p\u003E\u003Cp\u003E\u003Cem\u003E2: Typical cross section for fifty feet (50\u0027) wide right of way. \u003C\/em\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003Cimg alt=\u0022\u0022 height=\u0022432\u0022 src=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/codehub_files\/45_3308\/11miami.jpg\u0022 width=\u0022312\u0022\u003E\u003C\/p\u003E\u003Cp\u003E\u003Cem\u003E3: Typical cross section for forty foot (40\u0027) wide rights of way. \u003C\/em\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"271d854f-8e38-48f9-a991-174baab2ca28","prev_id":null}]}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/9308d08a-8e48-460a-8126-f45969125d35","ref":{"parent":"80117d52-4069-4169-b7c2-9cbdb12944d5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"217-16","docId":"45","text":"Section 5: Transitions","id":"9308d08a-8e48-460a-8126-f45969125d35","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/9308d08a-8e48-460a-8126-f45969125d35\/e0abdab4-10a3-4f14-94fa-fae4f8f85fca","ref":{"parent":"9308d08a-8e48-460a-8126-f45969125d35","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-16-11","docId":"45","text":"\u003Cp\u003E\u003C\/p\u003E","id":"e0abdab4-10a3-4f14-94fa-fae4f8f85fca","prev_id":null},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/9308d08a-8e48-460a-8126-f45969125d35\/ccc75760-4fb7-4699-99cb-ce8547a1432e","ref":{"parent":"9308d08a-8e48-460a-8126-f45969125d35","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-16-12","docId":"45","text":"Section 5.1 Horizontal Transitions between Typologies","id":"ccc75760-4fb7-4699-99cb-ce8547a1432e","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/9308d08a-8e48-460a-8126-f45969125d35\/ccc75760-4fb7-4699-99cb-ce8547a1432e\/beda1cf1-cf13-4aad-a01c-fecc12b95401","ref":{"parent":"ccc75760-4fb7-4699-99cb-ce8547a1432e","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-16-12-11","docId":"45","text":"\u003Cp\u003ETransition areas will be eight (8) to fifteen (15) feet wide where the width of the transition area (A) is equal to the width of the connecting path (B). See graphic below for transition types between the promenade typologies.\u003C\/p\u003E\u003Cp\u003ENew sections of the path shall transition seamlessly with existing sections, this may be achieved through a variety of design configurations, maintaining a continuous circulation path.\u003C\/p\u003E\u003Cp\u003E\u003Cimg alt=\u0022\u0022 height=\u0022716\u0022 src=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/codehub_files\/45_3308\/12miami.jpg\u0022 width=\u00221289\u0022\u003E\u003C\/p\u003E\u003Cp\u003E\u003Cem\u003E1\u003C\/em\u003E\u003Cem\u003E: Examples of horizontal transitions between Typologies. \u003C\/em\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"beda1cf1-cf13-4aad-a01c-fecc12b95401","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/9308d08a-8e48-460a-8126-f45969125d35\/77eccf65-a33c-4934-b015-e4b3743d5e3e","ref":{"parent":"9308d08a-8e48-460a-8126-f45969125d35","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-16-13","docId":"45","text":"Section 5.2 Vertical Transitions","id":"77eccf65-a33c-4934-b015-e4b3743d5e3e","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/9308d08a-8e48-460a-8126-f45969125d35\/77eccf65-a33c-4934-b015-e4b3743d5e3e\/931f0ae4-d7cf-4838-b5ef-9ddfb1d534c3","ref":{"parent":"77eccf65-a33c-4934-b015-e4b3743d5e3e","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-16-13-11","docId":"45","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003EUpland vertical transitions are permitted to aid circulation and visual connection between properties with high finished floor levels due to flood conditions and the public waterfront walkway.\u003C\/li\u003E\n\t\u003Cli\u003EGenerally, vertical transitions may take place by having different zones at differing elevations and may have gradual grade changes along the path of travel to ease transitions from properties to the waterfront.\n\t\u003Col\u003E\n\t\t\u003Cli\u003EThe Safety Buffer Zone must be lower than seawall to function as a curb.\u003C\/li\u003E\n\t\t\u003Cli\u003EThe Circulation Zones or Zone edges may be higher or lower than adjacent zones.\n\t\t\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\t\t\u003Cli\u003EThe Circulation Zone Path may slope in direction of travel but may not be so steep as to qualify as a ramp pursuant to ADA guidelines\u003C\/li\u003E\n\t\t\u003C\/ol\u003E\n\t\t\u003C\/li\u003E\n\t\t\u003Cli\u003EThe Passive Zone may be higher than the Circulation Zone.\n\t\t\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\t\t\u003Cli\u003ESeating walls and retaining walls are permitted though the Passive Zone must screen vertical portions of the private property.\u003C\/li\u003E\n\t\t\t\u003Cli\u003EThe Passive Zone may slope but may not drain onto circulation zones.\u003Cbr\u003E\n\t\t\t\u003Cimg alt=\u0022\u0022 height=\u0022613\u0022 src=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/codehub_files\/45_3308\/13miami.jpg\u0022 width=\u0022633\u0022\u003E\u003Cbr\u003E\n\t\t\t\u003Cem\u003E2\u003C\/em\u003E\u003Cem\u003E: Example of vertical transitions between and within zones which may be applied to all Typologies. \u003C\/em\u003E\u003Cbr\u003E\n\t\t\t \u003C\/li\u003E\n\t\t\t\u003Cli\u003EWaterside vertical transitions are appropriate to improve access to the water.\n\t\t\t\u003Col\u003E\n\t\t\t\t\u003Cli\u003EPenetrations through a seawall to accommodate boat access may occur if they are protected by deployable flood barriers and a barrier operations and storage plan are provided.\u003C\/li\u003E\n\t\t\t\t\u003Cli\u003EPublic vessel access or launch points may be provided with multiple typologies. All materials at lower portions shall be anchored and flood resistant.\u003C\/li\u003E\n\t\t\t\t\u003Cli\u003EWhen Typologies 6 and 7 are used, a portion of the Circulation Zone may be lower to improve water access.\n\t\t\t\t\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\t\t\t\t\u003Cli\u003ECirculation zones shall be maintained with clear width and Public access.\u003C\/li\u003E\n\t\t\t\t\t\u003Cli\u003EADA compliant access shall be maintained including multiple ramps when appropriate.\u003Cbr\u003E\n\t\t\t\t\t \u003C\/li\u003E\n\t\t\t\t\u003C\/ol\u003E\n\t\t\t\t\u003C\/li\u003E\n\t\t\t\u003C\/ol\u003E\n\t\t\t\u003C\/li\u003E\n\t\t\u003C\/ol\u003E\n\t\t\u003C\/li\u003E\n\t\u003C\/ol\u003E\n\t\u003C\/li\u003E\n\u003C\/ol\u003E\u003Cp\u003E\u003Cimg alt=\u0022\u0022 height=\u0022533\u0022 src=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/codehub_files\/45_3308\/14miami.jpg\u0022 width=\u0022681\u0022\u003E\u003C\/p\u003E\u003Cp\u003E\u003Cem\u003E3:Example of Type 6 or 7 pathways with split elevations. \u003C\/em\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003Cimg alt=\u0022\u0022 height=\u0022517\u0022 src=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/codehub_files\/45_3308\/15miami.jpg\u0022 width=\u0022609\u0022\u003E\u003C\/p\u003E\u003Cp\u003E\u003Cem\u003E4: Example of vessel access level. \u003C\/em\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"931f0ae4-d7cf-4838-b5ef-9ddfb1d534c3","prev_id":null}]}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f73bb710-9cfb-4f23-aba3-8090ef346b86","ref":{"parent":"80117d52-4069-4169-b7c2-9cbdb12944d5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"217-17","docId":"45","text":"Section 6: Landscape Elements","id":"f73bb710-9cfb-4f23-aba3-8090ef346b86","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f73bb710-9cfb-4f23-aba3-8090ef346b86\/c13856b4-172b-44cf-843f-5110267ad0a9","ref":{"parent":"f73bb710-9cfb-4f23-aba3-8090ef346b86","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-17-11","docId":"45","text":"\u003Cp\u003E\u003C\/p\u003E","id":"c13856b4-172b-44cf-843f-5110267ad0a9","prev_id":null},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f73bb710-9cfb-4f23-aba3-8090ef346b86\/b7cdcbb4-8759-47a3-a693-9d17ceed1bd0","ref":{"parent":"f73bb710-9cfb-4f23-aba3-8090ef346b86","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-17-12","docId":"45","text":"6.1 General Requirements","id":"b7cdcbb4-8759-47a3-a693-9d17ceed1bd0","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f73bb710-9cfb-4f23-aba3-8090ef346b86\/b7cdcbb4-8759-47a3-a693-9d17ceed1bd0\/cb4eea17-27cb-4dcb-8e8f-6f7a50512349","ref":{"parent":"b7cdcbb4-8759-47a3-a693-9d17ceed1bd0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-17-12-11","docId":"45","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003ELandscaped areas should be landscaped with plant materials listed in the \u003Ca href=\u0022http:\/\/codehub.gridics.com\/sites\/default\/files\/2021-10\/Miami_Waterfront_Materials_Index.pdf\u0022 target=\u0022_blank\u0022\u003EWaterfront Materials Index\u003C\/a\u003E. Shade trees are required within the Passive Zone and may also be planted along the Safety Buffer Zone in lieu of palms to create an all\u00e9e of trees. Shrubs, low shrubs, and groundcovers (low level plantings) should be planted at the base of trees and palms to enhance waterfront walkway aesthetics and to help buffer the walkway perimeters.\u003C\/li\u003E\n\t\u003Cli\u003ELandscape elements shall not obstruct pedestrian circulation paths.\u003C\/li\u003E\n\t\u003Cli\u003ELandscape design shall provide a consistent selection of landscape elements to unify the visual experience and contribute to the waterfront\u2019s ecological character\u003C\/li\u003E\n\t\u003Cli\u003ENo planting material shall be used that is classified as prohibited, controlled, or invasive by either State, County, or Local agencies.\u003C\/li\u003E\n\t\u003Cli\u003EAll planting areas shall have low-water use\/high efficiency irrigation systems, such as drip irrigation, low-trajectory irrigation nozzles, automatic shut-offs, and equipped with soil moisture and\/or rain sensors to regulate water use pursuant to the requirements set forth in \u003Ca href=\u0022https:\/\/library.municode.com\/fl\/miami\/codes\/code_of_ordinances?nodeId=PTIITHCO_CH22.5GRIN_ARTIVWACO_S22.5-75REPLFI\u0022 target=\u0022_blank\u0022\u003ESection 22.5-75\u003C\/a\u003E of the City Code, Miami-Dade County regulations, or South Florida Water Management District regulations, whichever is most restrictive.\u003C\/li\u003E\n\t\u003Cli\u003ERaised planters, if used, and all planter walls may double as seating walls when greater than fifteen (15) and less than thirty (30) inches in height above adjacent surface and greater than fifteen (15) inches in depth.\u003C\/li\u003E\n\u003C\/ol\u003E\u003Cp\u003E\u003C\/p\u003E","id":"cb4eea17-27cb-4dcb-8e8f-6f7a50512349","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f73bb710-9cfb-4f23-aba3-8090ef346b86\/45ea2861-1073-47bc-a97b-3ce611a10a80","ref":{"parent":"f73bb710-9cfb-4f23-aba3-8090ef346b86","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-17-13","docId":"45","text":"6.2 Tree and Palm Requirements","id":"45ea2861-1073-47bc-a97b-3ce611a10a80","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f73bb710-9cfb-4f23-aba3-8090ef346b86\/45ea2861-1073-47bc-a97b-3ce611a10a80\/93e3e0f2-d807-49f8-abbe-b2ff9f932293","ref":{"parent":"45ea2861-1073-47bc-a97b-3ce611a10a80","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-17-13-11","docId":"45","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003ETrees and palms shall be installed within the Passive and Safety Zones pursuant to the selected typology.\u003C\/li\u003E\n\t\u003Cli\u003ETrees and Palms shall provide a minimum of fifty percent (50%) immediate shade coverage with one hundred (100%) shade coverage within five (5) years.\u003C\/li\u003E\n\t\u003Cli\u003ETrees and palms shall be planted to establish a unified canopy for visual unity and pedestrian comfort.\u003C\/li\u003E\n\t\u003Cli\u003ETrees and palms shall be a minimum of fourteen feet (14\u2019) in height and have a minimum of nine feet (9\u2019) clear trunk at installation.\u003C\/li\u003E\n\t\u003Cli\u003ETree and palm selection shall be confined to the list in the \u003Ca href=\u0022http:\/\/codehub.gridics.com\/sites\/default\/files\/2021-10\/Miami_Waterfront_Materials_Index.pdf\u0022\u003EWaterfront Materials Index\u003C\/a\u003E and ninety percent (90%) of total quantity of trees and palms used shall be native or fifty percent (50%) of total trees and palms used shall be native if using Coconut Palms.\u003C\/li\u003E\n\t\u003Cli\u003EIf one hundred (100%) shade coverage is demonstrated via diagrams, flexibility regarding tree and palms spacing is permitted.\u003C\/li\u003E\n\t\u003Cli\u003ETrees and palms shall be selected for their proven resiliency, particularly for high wind and salt tolerance.\u003C\/li\u003E\n\t\u003Cli\u003ELarge canopy shade trees and palm trees shall take priority over waterfront views between ten (10) and forty (40) feet above the seawall elevation.\u003C\/li\u003E\n\t\u003Cli\u003EAvoid trees and palms with known pests and diseases that increase pesticide requirements.\u003C\/li\u003E\n\t\u003Cli\u003EAt grade planters for medium to large trees shall be a minimum of sixty (60) square feet with a minimum width dimension of five (5) feet.\u003C\/li\u003E\n\t\u003Cli\u003EAt grade planters for palms and small trees shall be a minimum of thirty (30) square feet with a minimum width dimension of four (4) feet.\u003C\/li\u003E\n\t\u003Cli\u003EProvide adequate root zone space for trees.\n\t\u003Col\u003E\n\t\t\u003Cli\u003ERoot zones must have uncompacted soil with access to air and water.\u003C\/li\u003E\n\t\t\u003Cli\u003EEither planting beds or porous pavements allow access to air and water.\u003C\/li\u003E\n\t\t\u003Cli\u003EProvide uncompacted soil volume in the following volumes:\n\t\t\u003Ctable border=\u00221\u0022 cellpadding=\u00221\u0022 cellspacing=\u00221\u0022\u003E\n\t\t\t\u003Cthead\u003E\n\t\t\t\t\u003Ctr\u003E\n\t\t\t\t\t\u003Cth scope=\u0022col\u0022\u003EMature Tree Size\u003C\/th\u003E\n\t\t\t\t\t\u003Cth scope=\u0022col\u0022\u003ESoil Volume (max. depth of 3.5\u0027)\u003C\/th\u003E\n\t\t\t\t\u003C\/tr\u003E\n\t\t\t\u003C\/thead\u003E\n\t\t\t\u003Ctbody\u003E\n\t\t\t\t\u003Ctr\u003E\n\t\t\t\t\t\u003Ctd\u003ESMALL - Height: \u0026lt;30\u0027\u003C\/td\u003E\n\t\t\t\t\t\u003Ctd\u003E300 ft\u003Csup\u003E3\u003C\/sup\u003E\u003C\/td\u003E\n\t\t\t\t\u003C\/tr\u003E\n\t\t\t\t\u003Ctr\u003E\n\t\t\t\t\t\u003Ctd\u003EMEDIUM - Height or Spread: \u0026gt;30\u0027 and \u0026lt;50\u0027\u003C\/td\u003E\n\t\t\t\t\t\u003Ctd\u003E1,200 ft\u003Csup\u003E3\u003C\/sup\u003E\u003C\/td\u003E\n\t\t\t\t\u003C\/tr\u003E\n\t\t\t\t\u003Ctr\u003E\n\t\t\t\t\t\u003Ctd\u003ELARGE - Height or Spread: \u0026gt;50\u0027\u003C\/td\u003E\n\t\t\t\t\t\u003Ctd\u003E1,800 ft\u003Csup\u003E3\u003C\/sup\u003E\u003C\/td\u003E\n\t\t\t\t\u003C\/tr\u003E\n\t\t\t\t\u003Ctr\u003E\n\t\t\t\t\t\u003Ctd\u003EWhen soil is shared between trees\u003C\/td\u003E\n\t\t\t\t\t\u003Ctd\u003E25% reduction allowed\u003C\/td\u003E\n\t\t\t\t\u003C\/tr\u003E\n\t\t\t\u003C\/tbody\u003E\n\t\t\u003C\/table\u003E\n\n\t\t\u003Cp\u003E\u003C\/p\u003E\n\t\t\u003C\/li\u003E\n\t\t\u003Cli\u003EWhen root zones are under paving, paving must be supported to allow for uncompacted soil.\n\t\t\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\t\t\u003Cli\u003ECustom support systems, structural soils, or suspended systems may support paving.\u003C\/li\u003E\n\t\t\t\u003Cli\u003ESupport system components do not apply to soil volume calculation (i.e., structural portion of structural soil or suspension system components).\u003C\/li\u003E\n\t\t\u003C\/ol\u003E\n\t\t\u003C\/li\u003E\n\t\u003C\/ol\u003E\n\t\u003C\/li\u003E\n\t\u003Cli\u003EStructural Cells shall be provided under paving when large trees are specified in planters less than 100 square feet and further than twelve (12) feet from adjacent, continuous green space areas.\u003C\/li\u003E\n\t\u003Cli\u003ERoot barriers shall be installed at pavement edges where large trees and palms are specified.\u003C\/li\u003E\n\u003C\/ol\u003E\u003Cp\u003E\u003Cimg alt=\u0022\u0022 height=\u0022562\u0022 src=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/codehub_files\/45_3308\/16miami.jpg\u0022 width=\u00221260\u0022\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"93e3e0f2-d807-49f8-abbe-b2ff9f932293","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f73bb710-9cfb-4f23-aba3-8090ef346b86\/18e531c5-f770-43ce-9c4b-a1653d306111","ref":{"parent":"f73bb710-9cfb-4f23-aba3-8090ef346b86","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-17-14","docId":"45","text":"6.3 Shrubs, Ground Cover, Mulch, and Soil Requirements","id":"18e531c5-f770-43ce-9c4b-a1653d306111","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/f73bb710-9cfb-4f23-aba3-8090ef346b86\/18e531c5-f770-43ce-9c4b-a1653d306111\/ceb2abd4-27be-473c-bc02-8a8584a69edf","ref":{"parent":"18e531c5-f770-43ce-9c4b-a1653d306111","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-17-14-11","docId":"45","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003EShrubs and groundcover selection shall be planted to establish visual unit and accentuate water views.\u003C\/li\u003E\n\t\u003Cli\u003ELandscape elements shall be installed within the Passive and Safety Zones pursuant to the selected typology.\u003C\/li\u003E\n\t\u003Cli\u003EShrubs and groundcover selection shall consist of a minimum of eighty percent (80%) native species and be salt and drought-tolerant pursuant to the list in the \u003Ca href=\u0022http:\/\/codehub.gridics.com\/sites\/default\/files\/2021-10\/Miami_Waterfront_Materials_Index.pdf\u0022 target=\u0022_blank\u0022\u003EWaterfront Materials Index\u003C\/a\u003E.\u003C\/li\u003E\n\t\u003Cli\u003ESalt-tolerant turf shall be provided in areas intended for recreation or gathering.\u003C\/li\u003E\n\t\u003Cli\u003EAll planting beds shall be covered with a minimum of three inches (3\u201d) of shredded Melaleuca, Grade B, or eucalyptus mulch. Cypress mulch shall not be permitted.\u003C\/li\u003E\n\t\u003Cli\u003EPlanting soil shall be pursuant to the \u003Ca href=\u0022http:\/\/codehub.gridics.com\/sites\/default\/files\/2021-10\/Miami_Waterfront_Materials_Index.pdf\u0022 target=\u0022_blank\u0022\u003EWaterfront Materials Index\u003C\/a\u003E.\u003C\/li\u003E\n\t\u003Cli\u003EMinimum Vegetated Area\n\t\u003Col\u003E\n\t\t\u003Cli\u003ETypology 1: 24%\u003C\/li\u003E\n\t\t\u003Cli\u003ETypology 2: 30%\u003C\/li\u003E\n\t\t\u003Cli\u003ETypology 3: 38%\u003C\/li\u003E\n\t\t\u003Cli\u003ETypology 4: 35%\u003C\/li\u003E\n\t\t\u003Cli\u003ETypology 5: 20%\u003C\/li\u003E\n\t\t\u003Cli\u003ETypology 6: 30%\u003C\/li\u003E\n\t\t\u003Cli\u003ETypology 7: 30%\u003C\/li\u003E\n\t\u003C\/ol\u003E\n\t\u003C\/li\u003E\n\u003C\/ol\u003E\u003Cp\u003E\u003C\/p\u003E","id":"ceb2abd4-27be-473c-bc02-8a8584a69edf","prev_id":null}]}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/5294c41e-c7b3-446c-82f9-a56b2df031e2","ref":{"parent":"80117d52-4069-4169-b7c2-9cbdb12944d5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"217-18","docId":"45","text":"Section 7: Hardscape Elements","id":"5294c41e-c7b3-446c-82f9-a56b2df031e2","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/5294c41e-c7b3-446c-82f9-a56b2df031e2\/4d735609-9370-449f-94ae-0eb8597469d6","ref":{"parent":"5294c41e-c7b3-446c-82f9-a56b2df031e2","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-18-11","docId":"45","text":"\u003Cp\u003E\u003C\/p\u003E","id":"4d735609-9370-449f-94ae-0eb8597469d6","prev_id":null},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/5294c41e-c7b3-446c-82f9-a56b2df031e2\/44655d6b-b8e9-44ae-8fbc-c33dab4b2af9","ref":{"parent":"5294c41e-c7b3-446c-82f9-a56b2df031e2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-18-12","docId":"45","text":"7.1 Hardscape","id":"44655d6b-b8e9-44ae-8fbc-c33dab4b2af9","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/5294c41e-c7b3-446c-82f9-a56b2df031e2\/44655d6b-b8e9-44ae-8fbc-c33dab4b2af9\/2d572384-ccf3-401e-8f3c-5717927ec64a","ref":{"parent":"44655d6b-b8e9-44ae-8fbc-c33dab4b2af9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-18-12-11","docId":"45","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003EHardscape shall create a unified visual and tactile feel throughout the walkway with seamless transitions between properties.\u003C\/li\u003E\n\t\u003Cli\u003EHardscape materials shall primarily include materials commonly used in marine environments such as concrete pavers, stone pavers, and river rock consistent with the \u003Ca href=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/2021-10\/Miami_Waterfront_Materials_Index.pdf\u0022 target=\u0022_blank\u0022\u003E\u003Cem\u003EWaterfront Materials Index\u003C\/em\u003E\u003C\/a\u003E.\u003C\/li\u003E\n\t\u003Cli\u003EHardscape materials should utilize neutral colors, primarily gray and sand with natural aggregates, such as marble chips and seashells.\u003C\/li\u003E\n\t\u003Cli\u003EPermeable Hardscape materials shall be used to reduce stormwater utility infrastructure and promote the filtration and collection of stormwater consistent with the \u003Ca href=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/2021-10\/Miami_Waterfront_Materials_Index.pdf\u0022\u003E\u003Cem\u003EWaterfront Materials Index\u003C\/em\u003E\u003C\/a\u003E.\u003C\/li\u003E\n\t\u003Cli\u003EHardscape should have a low reflectance albedo (minimum 0.3 factor) to reduce glare and heat absorption to decrease the heat-island effect.\u003C\/li\u003E\n\t\u003Cli\u003EConcrete with salt finish or shell aggregate should be used in steps adjacent to the water.\u003C\/li\u003E\n\t\u003Cli\u003EHardscape shall be laid in a running bond pattern for pedestrian areas and herringbone in areas where vehicular use is required for emergency access.\u003C\/li\u003E\n\t\u003Cli\u003ERiver rock, mortared, shall be used as a detectable paver for the waterfront edge and around benches for protection against skateboards, consistent with the selected typology.\u003C\/li\u003E\n\t\u003Cli\u003EIn proposed playground areas, poured-in-place rubberized play surface and artificial turf may be utilized.\u003C\/li\u003E\n\u003C\/ol\u003E\u003Cp\u003E\u003C\/p\u003E","id":"2d572384-ccf3-401e-8f3c-5717927ec64a","prev_id":null}]}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/64a29168-8880-4b75-b419-eace9481c48e","ref":{"parent":"80117d52-4069-4169-b7c2-9cbdb12944d5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"217-19","docId":"45","text":"Section 8: Furnishing Elements","id":"64a29168-8880-4b75-b419-eace9481c48e","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/64a29168-8880-4b75-b419-eace9481c48e\/ab35656a-bc97-40e9-ab92-0104c23fcd08","ref":{"parent":"64a29168-8880-4b75-b419-eace9481c48e","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-19-11","docId":"45","text":"\u003Cp\u003E\u003C\/p\u003E","id":"ab35656a-bc97-40e9-ab92-0104c23fcd08","prev_id":null},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/64a29168-8880-4b75-b419-eace9481c48e\/b381806d-776f-47dc-a769-2a458e1ece27","ref":{"parent":"64a29168-8880-4b75-b419-eace9481c48e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-19-12","docId":"45","text":"8.1 Lighting","id":"b381806d-776f-47dc-a769-2a458e1ece27","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/64a29168-8880-4b75-b419-eace9481c48e\/b381806d-776f-47dc-a769-2a458e1ece27\/0c1d52c4-eb61-4140-9169-a9279786e827","ref":{"parent":"b381806d-776f-47dc-a769-2a458e1ece27","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-19-12-11","docId":"45","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003ELighting shall be provided in accordance with the selected typology and shall attain safe and appropriate foot-candle necessary for pedestrian mobility, consistent with the \u003Ca href=\u0022http:\/\/codehub.gridics.com\/sites\/default\/files\/2021-10\/Miami_Waterfront_Materials_Index.pdf\u0022 target=\u0022_blank\u0022\u003EWaterfront Materials Index\u003C\/a\u003E.\u003C\/li\u003E\n\t\u003Cli\u003EAll proposed lighting elements shall be consistent with the fixture design specifications in the \u003Ca href=\u0022http:\/\/codehub.gridics.com\/sites\/default\/files\/2021-10\/Miami_Waterfront_Materials_Index.pdf\u0022\u003EWaterfront Materials Index\u003C\/a\u003E.\u003C\/li\u003E\n\t\u003Cli\u003EOverhead lighting shall be confined to the zone identified by the proposed typology.\u003C\/li\u003E\n\t\u003Cli\u003ELandscape up-lighting shall be provided to accentuate trees, palms, and other landscape elements.\u003C\/li\u003E\n\u003C\/ol\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0c1d52c4-eb61-4140-9169-a9279786e827","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/64a29168-8880-4b75-b419-eace9481c48e\/2a7ab61c-5fe6-43ee-ac8c-27b5f966afa8","ref":{"parent":"64a29168-8880-4b75-b419-eace9481c48e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-19-13","docId":"45","text":"8.2 Seating","id":"2a7ab61c-5fe6-43ee-ac8c-27b5f966afa8","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/64a29168-8880-4b75-b419-eace9481c48e\/2a7ab61c-5fe6-43ee-ac8c-27b5f966afa8\/9b0988c5-779c-40b8-8169-5ff497613b17","ref":{"parent":"2a7ab61c-5fe6-43ee-ac8c-27b5f966afa8","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-19-13-11","docId":"45","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003ESeating shall be confined to the Passive and Safety Zones pursuant to the selected typology.\u003C\/li\u003E\n\t\u003Cli\u003ESeating materials shall be consistent with the \u003Ca href=\u0022http:\/\/codehub.gridics.com\/sites\/default\/files\/2021-10\/Miami_Waterfront_Materials_Index.pdf\u0022 target=\u0022_blank\u0022\u003EWaterfront Materials Index\u003C\/a\u003E fixture design specifications and may be provided through a variety of movable, fixed, seat\/retaining walls or terraced steps.\u003C\/li\u003E\n\t\u003Cli\u003ESeating shall be provided at a minimum of one (1) linear foot of seating for every twenty (20) feet of Frontage along the water.\u003C\/li\u003E\n\t\u003Cli\u003EDistance between seating shall be no greater than fifty (50) feet or as identified pursuant to the typology.\u003C\/li\u003E\n\t\u003Cli\u003EAll seating areas shall emphasize direct water views.\u003C\/li\u003E\n\u003C\/ol\u003E\u003Cp\u003E\u003C\/p\u003E","id":"9b0988c5-779c-40b8-8169-5ff497613b17","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/64a29168-8880-4b75-b419-eace9481c48e\/41bb9e67-0b91-4499-a717-b3a94951c196","ref":{"parent":"64a29168-8880-4b75-b419-eace9481c48e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-19-14","docId":"45","text":"8.3 Amenities","id":"41bb9e67-0b91-4499-a717-b3a94951c196","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/64a29168-8880-4b75-b419-eace9481c48e\/41bb9e67-0b91-4499-a717-b3a94951c196\/5ec18b9c-e544-41bb-9658-6d247dc7d72c","ref":{"parent":"41bb9e67-0b91-4499-a717-b3a94951c196","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-19-14-11","docId":"45","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003EBicycle parking shall be provided at a minimum of one (1) space per every one hundred (100) feet of frontage and shall be consistent with the Appendix in the \u003Ca href=\u0022http:\/\/codehub.gridics.com\/sites\/default\/files\/2021-10\/Miami_Waterfront_Materials_Index.pdf\u0022 target=\u0022_blank\u0022\u003EWaterfront Materials Index\u003C\/a\u003E and may be waived if similar facilities are already provided within the vicinity.\u003C\/li\u003E\n\t\u003Cli\u003EWater fountains may be provided and shall be consistent with the fixture design standards in the \u003Ca href=\u0022http:\/\/codehub.gridics.com\/sites\/default\/files\/2021-10\/Miami_Waterfront_Materials_Index.pdf\u0022 target=\u0022_blank\u0022\u003EWaterfront Materials Index\u003C\/a\u003E and may be waived if similar facilities are already provided within the vicinity.\u003C\/li\u003E\n\t\u003Cli\u003EWaste receptacles shall be provided at a minimum of one (1) per every one hundred fifty (150) feet of frontage and shall be consistent with the fixture design standards in the \u003Ca href=\u0022http:\/\/codehub.gridics.com\/sites\/default\/files\/2021-10\/Miami_Waterfront_Materials_Index.pdf\u0022\u003EWaterfront Materials Index\u003C\/a\u003E and may be waived if similar facilities are already provided within the vicinity. Waste receptacles are selected with rain covers and removable liners to conceal waste and allow for easy maintenance. Provide separate, labeled waste receptacles for garbage and recycling. Receptacles are to be emptied and maintained by the property owner.\u003C\/li\u003E\n\u003C\/ol\u003E\u003Cp\u003E\u003C\/p\u003E","id":"5ec18b9c-e544-41bb-9658-6d247dc7d72c","prev_id":null}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/64a29168-8880-4b75-b419-eace9481c48e\/b2f5439d-3004-46b2-ab45-26e70d750ba7","ref":{"parent":"64a29168-8880-4b75-b419-eace9481c48e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"217-19-15","docId":"45","text":"8.4 Signage","id":"b2f5439d-3004-46b2-ab45-26e70d750ba7","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/64a29168-8880-4b75-b419-eace9481c48e\/b2f5439d-3004-46b2-ab45-26e70d750ba7\/a36f1397-2d6c-4b00-924a-cc6d4c59417b","ref":{"parent":"b2f5439d-3004-46b2-ab45-26e70d750ba7","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-19-15-11","docId":"45","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003EAll public access points, including park walkways, roadways, dedicated midblock walks, and public plazas shall be marked with a District Flag Directional Sign consistent with the signage standards of the \u003Ca href=\u0022http:\/\/codehub.gridics.com\/sites\/default\/files\/2021-10\/Miami_Waterfront_Materials_Index.pdf\u0022\u003EWaterfront Materials Index\u003C\/a\u003E.\u003C\/li\u003E\n\t\u003Cli\u003EDistrict Identity Sign shall be placed at property midpoint consistent with the signage standards of the \u003Ca href=\u0022http:\/\/codehub.gridics.com\/sites\/default\/files\/2021-10\/Miami_Waterfront_Materials_Index.pdf\u0022\u003EWaterfront Materials Index\u003C\/a\u003E.\u003C\/li\u003E\n\t\u003Cli\u003EAdjacent accessible publicly oriented private developments such as cafes or shops shall identify the use with signage oriented towards the waterfront walkway.\u003C\/li\u003E\n\t\u003Cli\u003EUniformly designed historic or environmental markers and descriptive plaques shall be placed in the Passive Zone.\u003C\/li\u003E\n\t\u003Cli\u003ESignage shall identify access points and adjacent activities (cafes, shops, etc.) for boaters.\u003C\/li\u003E\n\t\u003Cli\u003ESignage shall not be placed within the Circulation Zone.\u003C\/li\u003E\n\t\u003Cli\u003ERefer to \u003Ca href=\u0022http:\/\/codehub.gridics.com\/sites\/default\/files\/2021-10\/Miami_Waterfront_Materials_Index.pdf\u0022\u003EWaterfront Materials Index\u003C\/a\u003E signage standards for full logo usage guidelines.\u003C\/li\u003E\n\u003C\/ol\u003E\u003Cp\u003E\u003C\/p\u003E","id":"a36f1397-2d6c-4b00-924a-cc6d4c59417b","prev_id":null}]}]},{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/ed346e42-ab78-4093-b2db-016e18c3fc3e","ref":{"parent":"80117d52-4069-4169-b7c2-9cbdb12944d5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h3"},"pos":"217-210","docId":"45","text":"Section 9: Maintenance","id":"ed346e42-ab78-4093-b2db-016e18c3fc3e","children":[{"path":"\/80117d52-4069-4169-b7c2-9cbdb12944d5\/ed346e42-ab78-4093-b2db-016e18c3fc3e\/4426677a-fae5-4b07-bb29-8759dd449b0d","ref":{"parent":"ed346e42-ab78-4093-b2db-016e18c3fc3e","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"217-210-11","docId":"45","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\n\t\u003Cli\u003EIn addition to maintenance standards required in Chapters 2, 10, and 22 of the City Code, the property owner and their successors or assignees shall be responsible for the continued maintenance of all landscape, hardscape, and furnishing elements, as provided in the approved site plans and\/or approved landscape plans.\u003C\/li\u003E\n\t\u003Cli\u003ELandscape shall be maintained to the following standards:\n\t\u003Col\u003E\n\t\t\u003Cli\u003EThe owner shall be responsible for maintenance and replacement of trees to maintain one hundred percent (100%) shade coverage over the long-term.\u003C\/li\u003E\n\t\t\u003Cli\u003ELandscape may not impede navigable waters and vegetation and must be trimmed accordingly.\u003C\/li\u003E\n\t\t\u003Cli\u003EIn no case shall grass clippings, vegetative material, or vegetative debris be washed, swept, or blown off into stormwater drains, ditches, conveyances, water bodies, wetlands, sidewalks, or roadways. Any material that is accidentally so deposited shall be immediately removed to the maximum extent practicable as required by \u003Ca href=\u0022https:\/\/library.municode.com\/fl\/miami\/codes\/code_of_ordinances?nodeId=PTIITHCO_CH22.5GRIN_ARTVIIFLIEFEUSURLA_S22.5-138MAGRCLVEMA\u0022 target=\u0022_blank\u0022\u003ESection 22.5-138\u003C\/a\u003E of the City Code.\u003C\/li\u003E\n\t\t\u003Cli\u003ENo fertilizer is permitted pursuant to \u003Ca href=\u0022https:\/\/library.municode.com\/fl\/miami\/codes\/code_of_ordinances?nodeId=PTIITHCO_CH22.5GRIN_ARTVIIFLIEFEUSURLA_S22.5-134FEFRZO\u0022 target=\u0022_blank\u0022\u003ESection 22.5-134\u003C\/a\u003E of the City Code.\u201d\u003C\/li\u003E\n\t\u003C\/ol\u003E\n\t\u003C\/li\u003E\n\u003C\/ol\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"4426677a-fae5-4b07-bb29-8759dd449b0d","prev_id":null}]}]}]