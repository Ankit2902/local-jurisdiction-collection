[{"path":"\/d2cdbf65-126d-4964-a06c-6ebe7a91da6f","ref":{"name":"section"},"li_attr":{"dataTag":"section","hasChildren":2,"tag":"h2"},"pos":"11","docId":"75","text":"COMPREHENSIVE ORDINANCE LIST","id":"d2cdbf65-126d-4964-a06c-6ebe7a91da6f","children":[{"path":"\/d2cdbf65-126d-4964-a06c-6ebe7a91da6f\/d204fb6e-1b56-4124-b870-a0eee7974075","ref":{"parent":"d2cdbf65-126d-4964-a06c-6ebe7a91da6f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"11-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/Browse.aspx?id=14\u0026amp;dbid=0\u0026amp;repo=CityofCupertino\u0022\u003ESearch Ordinances\u003C\/a\u003E\u003C\/p\u003E\u003Ctable border=\u00221\u0022 cellpadding=\u00220\u0022 cellspacing=\u00220\u0022 style=\u0022width:1000px\u0022\u003E\u003Cthead\u003E\u003Ctr\u003E\u003Cth scope=\u0022col\u0022\u003EOrd. No.\u003C\/th\u003E\u003Cth scope=\u0022col\u0022\u003EAction\u003C\/th\u003E\u003C\/tr\u003E\u003C\/thead\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/Browse.aspx?id=1267807\u0026amp;dbid=0\u0026amp;repo=CityOfCupertino#docaccess-194f28f43d4b556a87600a392e6beb8d\u0022\u003E26-2285\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EThe Audit Committee is now called The Audit and Finance Committee \u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1273590\u0026amp;dbid=0\u0026amp;repo=CityOfCupertino\u0022\u003E26-2284\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EMiscellaneous amendments to sections 2.04.020, 3.23.020, 5.04.480, 5.32.130, 11.28.010, 11.28.050, 13.04.13\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1273589\u0026amp;dbid=0\u0026amp;repo=CityOfCupertino\u0022\u003E26-2283\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EReplaces \u0022Director of Administrative Services\u0022 with \u0022Director of Finance\u0022\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1268387\u0026amp;dbid=0\u0026amp;repo=CityOfCupertino\u0022\u003E26-2282\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003ERegulates film production\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1268436\u0026amp;dbid=0\u0026amp;repo=CityOfCupertino\u0022\u003E26-2281\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EUpdates the California Buildings Standards Code and Fire Code\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1268430\u0026amp;dbid=0\u0026amp;repo=CityOfCupertino\u0022\u003E26-2280\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003ERegulates single-use carryout bags\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1222789\u0026amp;dbid=0\u0026amp;repo=CityOfCupertino\u0022\u003E25-2278\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EUpdates multiple chapters in order to adopt the latest California building and safety codes.\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1215929\u0026amp;dbid=0\u0026amp;repo=CityOfCupertino\u0022 target=\u0022_blank\u0022\u003E25-2277\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EMinor text edits\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1219725\u0026amp;dbid=0\u0026amp;repo=CityOfCupertino\u0026amp;cr=1\u0022 target=\u0022_blank\u0022\u003E25-2276\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EAdds Chapter 14.30 Small Wireless Facilities In Public Rights-Of-Way\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1211031\u0026amp;dbid=0\u0026amp;repo=CityofCupertino\u0022 target=\u0022_blank\u0022\u003E25-2275\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EIt prohibits parking oversized vehicles for more than seventy-two hours and regulates the issuance of parking permits to residents and designated groups.\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1211030\u0026amp;dbid=0\u0026amp;repo=CityofCupertino\u0022 target=\u0022_blank\u0022\u003E25-2274\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EOrdinance regarding Accessory Dwelling Unit (ADU) laws\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1193413\u0026amp;dbid=0\u0026amp;repo=CityofCupertino\u0022 target=\u0022_blank\u0022\u003E25-2273\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003ELimit City Council EDC membership to one seat, allow a Planning Commissioner to join, and align EDC member terms with their respective commission terms.\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1179721\u0026amp;dbid=0\u0026amp;repo=CityofCupertino\u0022 target=\u0022_blank\u0022\u003E25-2272\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EThe ordinance adopts fire severity hazard zones in the local responsibility area and on chapter 16.40 updates a reference to the updated map.\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1178611\u0026amp;dbid=0\u0026amp;repo=CityofCupertino\u0022 target=\u0022_blank\u0022\u003E25-2271\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EThe City Council seeks to confirm that rescheduled meetings due to holidays or elections remain regular meetings.\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022http:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1130140\u0026amp;dbid=0\u0026amp;repo=cityofcupertino\u0026amp;searchid=816ae1b9-07d7-45ce-8635-e4c639a84bcf\u0022 target=\u0022_blank\u0022\u003E25-2269\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EThe purpose of this Ordinance is to reestablish the Economic Development Committee (EDC)\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022http:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1130140\u0026amp;dbid=0\u0026amp;repo=cityofcupertino\u0026amp;searchid=816ae1b9-07d7-45ce-8635-e4c639a84bcf\u0022 target=\u0022_blank\u0022\u003E24-2267\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003ERepeals Chapter 15.04 and amends Chapters 2.32, 2.74, 2.86, 11.08, And 13.04\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1130140\u0026amp;dbid=0\u0026amp;repo=cityofcupertino\u0026amp;searchid=816ae1b9-07d7-45ce-8635-e4c639a84bcf\u0022 target=\u0022_blank\u0022\u003E24-2266\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EAmends Chapters 19.04 (General Provisions); 19.08 (definitions); and 19.60 (General Commercial (CG) Zones)\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1128664\u0026amp;dbid=0\u0026amp;repo=CityofCupertino\u0026amp;searchid=818c6423-4803-4eca-96ad-2a7c2bdede4b\u0022 target=\u0022_blank\u0022\u003E24-2265\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003ERepeals Chapter 16.32 of the Cupertino Municipal Code in its entirety \u0026amp; Amends Chapter 16.54 of the Municipal Code (Energy Code), as set forth in Attachment A, to adopt local amendments to the California Building Energy Efficiency Standards, 2022 Edition, Title 24, Part 6 of the California Code of Regulations\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1128663\u0026amp;dbid=0\u0026amp;repo=CityofCupertino\u0026amp;searchid=c76a02db-70b2-4a73-8427-70f8aad2e614\u0022 target=\u0022_blank\u0022\u003E24-2264\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EAmends Section 11.27.145, designation of preferential parking zones\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1128662\u0026amp;dbid=0\u0026amp;repo=CityofCupertino\u0026amp;searchid=65f30319-4ce2-4eec-b759-c896986f88c2\u0022 target=\u0022_blank\u0022\u003E24-2263\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EAmending Table 11.24.150\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1109354\u0026amp;dbid=0\u0026amp;repo=CityofCupertino\u0026amp;searchid=81b45f3a-9fa1-4b86-b044-4496b367ddaf\u0022 target=\u0022_blank\u0022\u003E24-2262\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003ERezoning certain sites in the city for conformance with General Plan and Housing Element\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1109355\u0026amp;dbid=0\u0026amp;repo=CityofCupertino\u0026amp;searchid=ae282b48-2a46-4b96-bda8-fbd8c01f5c67\u0022 target=\u0022_blank\u0022\u003E24-2261\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EAmending various chapters in title 14, title 17 and title 19, including but not limited to the addition of three new chapters in title 19, to implement policies in the general plan and for clarity\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1106460\u0026amp;dbid=0\u0026amp;repo=CityofCupertino\u0022 target=\u0022_blank\u0022\u003E24-2260\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EAmend Municipal Code Chapter 19.08, Chapter 19.12, and Chapter 19.48 regarding Fences\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1096919\u0026amp;dbid=0\u0026amp;repo=CityofCupertino\u0022 target=\u0022_blank\u0022\u003E24-2257\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EAmends Section 5.50\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022https:\/\/records.cupertino.org\/WebLink\/DocView.aspx?id=1092902\u0026amp;dbid=0\u0026amp;repo=CityofCupertino\u0022 target=\u0022_blank\u0022\u003E24-2256\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EAmends Sections 2.86.020 and 2.94.010\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022http:\/\/records.cupertino.org\/WebLink\/search.aspx?startid=676\u0026amp;dbid=0\u0026amp;searchcommand=%7B%5Blegislative%5D:%5BDocument%20Number%5D=%2023-2255%22,%5BLegislative-Document%20Type%5D=%22Ordinances%22%7D\u0026amp;cr=1\u0022 target=\u0022_blank\u0022\u003E24-2255\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EAmends Chapters 3.22 and 3.23\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022http:\/\/records.cupertino.org\/WebLink\/search.aspx?startid=676\u0026amp;dbid=0\u0026amp;searchcommand=%7B%5Blegislative%5D:%5BDocument%20Number%5D=%2023-2254%22,%5BLegislative-Document%20Type%5D=%22Ordinances%22%7D\u0026amp;cr=1\u0022 target=\u0022_blank\u0022\u003E23-2254\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EAmends Sections 19.12.030; 19.12.110; 19.28.040; 19.28.110; 19.28.114; 19.112.010; 19.112.020; 19.112.030; 19.112.040.\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ca href=\u0022http:\/\/records.cupertino.org\/WebLink\/search.aspx?startid=676\u0026amp;dbid=0\u0026amp;searchcommand=%7B%5Blegislative%5D:%5BDocument%20Number%5D=%2023-2253%22,%5BLegislative-Document%20Type%5D=%22Ordinances%22%7D\u0026amp;cr=1\u0022 target=\u0022_blank\u0022\u003E23-2253\u003C\/a\u003E\u003C\/td\u003E\u003Ctd\u003EAmends Section 19.76.030\u003C\/td\u003E\u003C\/tr\u00