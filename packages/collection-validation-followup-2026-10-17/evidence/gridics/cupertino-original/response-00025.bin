[{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd","ref":{"name":"section"},"pos":"222","li_attr":{"dataTag":"section","hasChildren":1,"tag":"h2"},"docId":"75","id":"109b2355-b59f-4f46-b5a7-3ae07fd3d0dd","text":"LAND USE PLANS","children":[{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/0a11cb72-4ecc-4638-a6fd-e25630d63eeb","ref":{"parent":"109b2355-b59f-4f46-b5a7-3ae07fd3d0dd","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"16-11","docId":"75","text":"Specific Plans","id":"0a11cb72-4ecc-4638-a6fd-e25630d63eeb","children":[{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/0a11cb72-4ecc-4638-a6fd-e25630d63eeb\/1d3a6364-e7fa-4e95-bb9e-03f17ff0d0d8","ref":{"parent":"0a11cb72-4ecc-4638-a6fd-e25630d63eeb","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"16-11-11","docId":"75","text":"\u003Cp\u003ESpecific Plans are adopted for the systematic implementation of the General Plan for a defined smaller portion of a community\u0027s planning area. A specific plan must specify in detail the development standards and requirements relating to density, lot size and shape, siting of buildings, setbacks, circulation, drainage, landscaping, architecture, water, sewer, public facilities, grading, open space, financing and any other element needed for proper development of the property.\u003C\/p\u003E\u003Cp\u003EThe following is a list of Specific Plans adopted by the City.\u003C\/p\u003E","id":"1d3a6364-e7fa-4e95-bb9e-03f17ff0d0d8","prev_id":null},{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/0a11cb72-4ecc-4638-a6fd-e25630d63eeb\/5c6997ee-0790-47c6-a33f-acee750a4d23","ref":{"parent":"0a11cb72-4ecc-4638-a6fd-e25630d63eeb","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"16-11-12","docId":"75","text":"Heart of the City","id":"5c6997ee-0790-47c6-a33f-acee750a4d23","children":[{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/0a11cb72-4ecc-4638-a6fd-e25630d63eeb\/5c6997ee-0790-47c6-a33f-acee750a4d23\/e0eb8eef-d744-40ac-bf83-7d05dede89b9","ref":{"parent":"5c6997ee-0790-47c6-a33f-acee750a4d23","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"16-11-12-11","docId":"75","text":"\u003Cp\u003EThe \u003Ca href=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/2022-05\/HeartoftheCitySpecificPlan.pdf\u0022\u003EHeart of the City Specific Plan\u003C\/a\u003E provides specific development guidance for one of the most important commercial corridors in the City of Cupertino, for the purpose of creating a greater sense of place and community identity in Cupertino. The plan contains streetscape design, development standards and design guidelines for multi-unit residential and commercial\/office projects. \u003C\/p\u003E","id":"e0eb8eef-d744-40ac-bf83-7d05dede89b9","prev_id":null}]},{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/0a11cb72-4ecc-4638-a6fd-e25630d63eeb\/fe42905f-a73d-41e1-920a-9b9c3459c563","ref":{"parent":"0a11cb72-4ecc-4638-a6fd-e25630d63eeb","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"16-11-13","docId":"75","text":"Monta Vista Design Guidelines","id":"fe42905f-a73d-41e1-920a-9b9c3459c563","children":[{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/0a11cb72-4ecc-4638-a6fd-e25630d63eeb\/fe42905f-a73d-41e1-920a-9b9c3459c563\/5b1073a2-304b-48ea-93fa-2394776a4499","ref":{"parent":"fe42905f-a73d-41e1-920a-9b9c3459c563","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"16-11-13-11","docId":"75","text":"\u003Cp\u003EThe \u003Ca href=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/2022-05\/MontaVistaDesignGuidelines.pdf\u0022\u003EMonta Vista Design Guidelines\u003C\/a\u003E implement the policies of the General Plan by outlining building design details, landscaping treatment, signage and public improvement details for the Monta Vista Commercial Area. \u003C\/p\u003E\u003Cp\u003E---\u003C\/p\u003E","id":"5b1073a2-304b-48ea-93fa-2394776a4499","prev_id":null}]}]},{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/02fbaa26-33ef-4e58-8b81-f83e10c14d1d","ref":{"parent":"109b2355-b59f-4f46-b5a7-3ae07fd3d0dd","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"16-12","docId":"75","text":"Master Plans","id":"02fbaa26-33ef-4e58-8b81-f83e10c14d1d","children":[{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/02fbaa26-33ef-4e58-8b81-f83e10c14d1d\/5a4cbf05-4ca8-44ba-ab5b-b9ef58344c3b","ref":{"parent":"02fbaa26-33ef-4e58-8b81-f83e10c14d1d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"16-12-11","docId":"75","text":"\u003Cp\u003EMaster Plans describe, in narrative and with maps, an overall development concept including both present property uses as well as future land development plans, ranging from the development of property for commercial and other uses to the development of wireless facilities. The plan may be prepared by a local government to guide private and public development or by a developer on a specific project. The following is a list of master plans that have been developed by the City.\u003C\/p\u003E","id":"5a4cbf05-4ca8-44ba-ab5b-b9ef58344c3b","prev_id":null},{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/02fbaa26-33ef-4e58-8b81-f83e10c14d1d\/0c591076-9839-4ed3-84e1-3dcb95692b7f","ref":{"parent":"02fbaa26-33ef-4e58-8b81-f83e10c14d1d","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"16-12-12","docId":"75","text":"Wireless Facilities Master Plan","id":"0c591076-9839-4ed3-84e1-3dcb95692b7f","children":[{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/02fbaa26-33ef-4e58-8b81-f83e10c14d1d\/0c591076-9839-4ed3-84e1-3dcb95692b7f\/e1a25218-1eb7-4493-9493-08b218bc3cb7","ref":{"parent":"0c591076-9839-4ed3-84e1-3dcb95692b7f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"16-12-12-11","docId":"75","text":"\u003Cp\u003EThe \u003Ca href=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/2022-05\/WirelessMasterPlan.pdf\u0022\u003EWireless Facilities Master Plan\u003C\/a\u003E was developed in 2003 as a guide for the public and for wireless companies. It is an educational tool for the public and a tool to facilitate the wireless companies and their representatives.\u003C\/p\u003E","id":"e1a25218-1eb7-4493-9493-08b218bc3cb7","prev_id":null}]},{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/02fbaa26-33ef-4e58-8b81-f83e10c14d1d\/b8a4f0e9-b707-4618-98c9-c0c00163aa08","ref":{"parent":"02fbaa26-33ef-4e58-8b81-f83e10c14d1d","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"16-12-13","docId":"75","text":"South Vallco Master Plan","id":"b8a4f0e9-b707-4618-98c9-c0c00163aa08","children":[{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/02fbaa26-33ef-4e58-8b81-f83e10c14d1d\/b8a4f0e9-b707-4618-98c9-c0c00163aa08\/10b70667-f5d8-43e5-a9b5-8501882f6c75","ref":{"parent":"b8a4f0e9-b707-4618-98c9-c0c00163aa08","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"16-12-13-11","docId":"75","text":"\u003Cp\u003EThe \u003Ca href=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/2022-05\/SouthVallcoMasterPlan.pdf\u0022\u003ESouth Vallco planning area\u003C\/a\u003E is an approximately 125-acre area bounded by I-280 to the north, Stevens Creek Boulevard to the south, including Cupertino Square shopping center (formerly Vallco Fashion Park) along the east and west side of Wolfe Road and the office development along the east side of Tantau Avenue. The area also includes office properties owned by Apple, Menlo Equities, as well as the Metropolitan residential\/commercial development.\u003C\/p\u003E","id":"10b70667-f5d8-43e5-a9b5-8501882f6c75","prev_id":null}]},{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/02fbaa26-33ef-4e58-8b81-f83e10c14d1d\/91b321ec-c80c-47be-9ad2-fb05cf46e76a","ref":{"parent":"02fbaa26-33ef-4e58-8b81-f83e10c14d1d","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"16-12-14","docId":"75","text":"North Vallco Master Plan (not adopted by Council - for guidance only)","id":"91b321ec-c80c-47be-9ad2-fb05cf46e76a","children":[{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/02fbaa26-33ef-4e58-8b81-f83e10c14d1d\/91b321ec-c80c-47be-9ad2-fb05cf46e76a\/136a853b-03c4-473c-9a5e-971b1f4f5068","ref":{"parent":"91b321ec-c80c-47be-9ad2-fb05cf46e76a","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"16-12-14-11","docId":"75","text":"\u003Cp\u003EThe \u003Ca href=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/2022-05\/NorthVallcoMasterPlan.pdf\u0022\u003ENorth Vallco planning are\u003C\/a\u003Ea is the 240-acre area bounded by Homestead Road, Tantau Avenue, I-280 and Wolfe Road. It includes the 100-acre Hewlett Packard campus, 50 acres acquired by Apple Computer for a future second campus, Cupertino Village shopping center, hotel, residential and office developments.\u003Cbr\u003E\n\u003Cbr\u003E\n---\u003C\/p\u003E","id":"136a853b-03c4-473c-9a5e-971b1f4f5068","prev_id":null}]}]},{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/5e6a4f23-d66e-4831-86af-a5cea5f13cd3","ref":{"parent":"109b2355-b59f-4f46-b5a7-3ae07fd3d0dd","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"16-13","docId":"75","text":"Conceptual Plans","id":"5e6a4f23-d66e-4831-86af-a5cea5f13cd3","children":[{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/5e6a4f23-d66e-4831-86af-a5cea5f13cd3\/a4771605-f182-4c5d-86d6-756fe5d5abc5","ref":{"parent":"5e6a4f23-d66e-4831-86af-a5cea5f13cd3","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"16-13-11","docId":"75","text":"\u003Cp\u003EConceptual Plans delineate policies for the development of certain sections within the City\u0027s General Plan Area. The following is a list of Conceptual Plans adopted by the City.\u003C\/p\u003E","id":"a4771605-f182-4c5d-86d6-756fe5d5abc5","prev_id":null},{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/5e6a4f23-d66e-4831-86af-a5cea5f13cd3\/c0d7d4b3-3358-4ac3-810e-d694fa1a2564","ref":{"parent":"5e6a4f23-d66e-4831-86af-a5cea5f13cd3","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"16-13-12","docId":"75","text":"North De Anza Blvd Conceptual Plan","id":"c0d7d4b3-3358-4ac3-810e-d694fa1a2564","children":[{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/5e6a4f23-d66e-4831-86af-a5cea5f13cd3\/c0d7d4b3-3358-4ac3-810e-d694fa1a2564\/675e0fda-793e-4266-ba3c-67d55ec2eab4","ref":{"parent":"c0d7d4b3-3358-4ac3-810e-d694fa1a2564","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"16-13-12-11","docId":"75","text":"\u003Cp\u003EThe \u003Ca href=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/2022-05\/NorthDeAnzaBlvdConceptualP.pdf\u0022\u003ENorth De Anza Blvd Conceptual Plan\u003C\/a\u003E encompasses the stretch roughly between Interstate 280 and Stevens Creek Blvd. This plan provides direction on the streetscape expected of properties along North De Anza Boulevard.\u003C\/p\u003E","id":"675e0fda-793e-4266-ba3c-67d55ec2eab4","prev_id":null}]},{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/5e6a4f23-d66e-4831-86af-a5cea5f13cd3\/3055dcc2-b0dc-4fe4-bacf-b8dc0c7d94bf","ref":{"parent":"5e6a4f23-d66e-4831-86af-a5cea5f13cd3","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"16-13-13","docId":"75","text":"S. De Anza Boulevard Conceptual Plan","id":"3055dcc2-b0dc-4fe4-bacf-b8dc0c7d94bf","children":[{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/5e6a4f23-d66e-4831-86af-a5cea5f13cd3\/3055dcc2-b0dc-4fe4-bacf-b8dc0c7d94bf\/9032c13e-65ea-4b71-b780-2eca0ac8ddc9","ref":{"parent":"3055dcc2-b0dc-4fe4-bacf-b8dc0c7d94bf","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"16-13-13-11","docId":"75","text":"\u003Cp\u003E\u003Ca href=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/2022-05\/SouthDeAnzaBlvdConceptualP.pdf\u0022\u003ES. De Anza Boulevard Conceptual Plan\u003C\/a\u003E: Encompasses the stretch between Stevens Creek Blvd. and Bollinger Rd along De Anza Blvd. \u003C\/p\u003E","id":"9032c13e-65ea-4b71-b780-2eca0ac8ddc9","prev_id":null}]},{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/5e6a4f23-d66e-4831-86af-a5cea5f13cd3\/eb6b66ae-48ec-4c63-80a8-c355b0c49d12","ref":{"parent":"5e6a4f23-d66e-4831-86af-a5cea5f13cd3","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"16-13-14","docId":"75","text":"South Sunnyvale-Saratoga Conceptual Zoning Plan","id":"eb6b66ae-48ec-4c63-80a8-c355b0c49d12","children":[{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/5e6a4f23-d66e-4831-86af-a5cea5f13cd3\/eb6b66ae-48ec-4c63-80a8-c355b0c49d12\/b9545e9e-ae16-446b-acb6-4030ef900bce","ref":{"parent":"eb6b66ae-48ec-4c63-80a8-c355b0c49d12","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"16-13-14-11","docId":"75","text":"\u003Cp\u003EThe \u003Ca href=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/2022-05\/SouthSartogaSunnyvaleConce.pdf\u0022\u003ESouth Sunnyvale-Saratoga Conceptual Zoning Plan\u003C\/a\u003E covers the area south of Highway 85 along De Anza Blvd. The plan specifies the Land Uses allowed in the area and the permit approval process. It also specifies landscaping standards for the area.\u003C\/p\u003E","id":"b9545e9e-ae16-446b-acb6-4030ef900bce","prev_id":null}]},{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/5e6a4f23-d66e-4831-86af-a5cea5f13cd3\/05164da3-de02-4082-86ff-fb665d388eb0","ref":{"parent":"5e6a4f23-d66e-4831-86af-a5cea5f13cd3","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"16-13-15","docId":"75","text":"South Vallco Connectivity Plan","id":"05164da3-de02-4082-86ff-fb665d388eb0","children":[{"path":"\/109b2355-b59f-4f46-b5a7-3ae07fd3d0dd\/5e6a4f23-d66e-4831-86af-a5cea5f13cd3\/05164da3-de02-4082-86ff-fb665d388eb0\/3dfc27fb-9421-4330-94d0-3e26ee43b31a","ref":{"parent":"05164da3-de02-4082-86ff-fb665d388eb0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"16-13-15-11","docId":"75","text":"\u003Cp\u003EThe \u003Ca href=\u0022https:\/\/codehub.gridics.com\/sites\/default\/files\/2022-05\/SouthVallcoConnectivityPla.pdf\u0022\u003ESouth Vallco Connectivity Plan\u003C\/a\u003E shows how new development within the Vallco Shopping District can improve connectivity to existing and approved development, and ensure connectivity to future development within the greater area. The plan will help inform the development of the future Vallco Shopping District Specific and\/or Master Plan. \u003C\/p\u003E","id":"3dfc27fb-9421-4330-94d0-3e26ee43b31a","prev_id":null}]}]}]}]