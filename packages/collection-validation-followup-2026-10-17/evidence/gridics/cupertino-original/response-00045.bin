[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9","ref":{"name":"section"},"li_attr":{"dataTag":"section","hasChildren":1,"tag":"h2"},"pos":"216","docId":"75","text":"TITLE 15: WATER AND SEWAGE","id":"42a74925-2ecf-419e-a945-f3393ce53db9","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/93168490-fc4a-4a96-8dd7-8d2004d6dc87","ref":{"parent":"42a74925-2ecf-419e-a945-f3393ce53db9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"93168490-fc4a-4a96-8dd7-8d2004d6dc87","prev_id":null},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","ref":{"parent":"42a74925-2ecf-419e-a945-f3393ce53db9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"216-12","docId":"75","text":"CHAPTER 15.20: SEWAGE DISPOSAL SYSTEMS*","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/618a7e96-0af2-47be-a0b0-030f08b7ce6f","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E* For statutory provisions regarding municipal sewer districts, see Health and Safety Code \u00a7\u00a7 4600 et seq.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"618a7e96-0af2-47be-a0b0-030f08b7ce6f","prev_id":null},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--1a269046-3e1e-45ae-b6a4-de132016fe7d","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-12-12","docId":"75","text":"15.20.010 Purpose and Applicability.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--1a269046-3e1e-45ae-b6a4-de132016fe7d","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--1a269046-3e1e-45ae-b6a4-de132016fe7d\/d253714d-03f1-4d7a-bdf7-c82324e90bb5","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--1a269046-3e1e-45ae-b6a4-de132016fe7d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-12-11","docId":"75","text":"\u003Cp\u003EThis chapter is enacted to establish standards for the approval, installation, and operation of individual on-site sewage disposal systems consistent with the standards of the California Regional Water Quality Board as set out by the Santa Clara County Environmental Health Services and adopted by the Cupertino City Council.\u003C\/p\u003E\u003Cp\u003ESuch standards are adopted so as to preclude the creation of health hazards and nuisance conditions and to protect surface and groundwater quality.\u003C\/p\u003E\u003Cp\u003EThis chapter shall apply to all territory within the incorporated limits of the City.\u003C\/p\u003E\u003Cp\u003E(Ord. 1776, (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d253714d-03f1-4d7a-bdf7-c82324e90bb5","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--c1f3bfeb-b3cf-455f-90d7-aca44f65071d","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-12-13","docId":"75","text":"15.20.020 Definitions.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--c1f3bfeb-b3cf-455f-90d7-aca44f65071d","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--c1f3bfeb-b3cf-455f-90d7-aca44f65071d\/d81c1c38-e3df-4569-9f16-72004ba2ed3b","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--c1f3bfeb-b3cf-455f-90d7-aca44f65071d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-13-11","docId":"75","text":"\u003Cp\u003EFor the purposes of this chapter, unless otherwise stated herein, certain words and phrases used in this chapter are defined as follows:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003E\u201cHealth Officer\u201d means the Director of the County Department of Environmental Health, his assistants, or authorized deputies acting as Health Officers of the City of Cupertino.\u003C\/li\u003E\u003Cli\u003E\u201cSanitary waste\u201d means and includes, but is not limited to, the discharge from toilets, bathtubs, lavatories, dishwashers, washing machines, and any and all other plumbing fixtures connected to the building plumbing system.\u003C\/li\u003E\u003Cli\u003E\u201cSewage system standards\u201d means those standards relating to tests and studies, individual sewage disposal system design, construction, and\/or maintenance as set out by the Santa Clara County Environmental Health Services to be enforced by the Health Officer and have been adopted by resolution of the Cupertino City Council.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1776, (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d81c1c38-e3df-4569-9f16-72004ba2ed3b","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--e4a07f13-ce0c-4cb4-b9bd-4b499ad115be","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-12-14","docId":"75","text":"15.20.030 Public Sanitary Sewer Required\u2013Exceptions.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--e4a07f13-ce0c-4cb4-b9bd-4b499ad115be","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--e4a07f13-ce0c-4cb4-b9bd-4b499ad115be\/90119e50-c221-4901-b36b-51f98300d770","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--e4a07f13-ce0c-4cb4-b9bd-4b499ad115be","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-14-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EAll property which is used, or is proposed to be used, for a residence, place of business, or other use requiring a building or place where persons congregate, reside, or are employed shall upon the issuance of any permit for building or use be required to be connected to a public sanitary sewer in the most direct manner possible, each building having a separate connection. All areas designated by the General Plan of the City of Cupertino as not required to connect to a public sanitary sewer are excepted from the above requirements.\u003C\/li\u003E\u003Cli\u003EWith respect to the exception set forth in subsection A of this section, a private sewage disposal system may be installed; provided that prior to the issuance of a building permit for any new structure, or prior to a change in use of an existing structure, wherein such a private sewage disposal system is to be utilized, written approval is obtained from the Health Officer as provided in this chapter. The Health Officer shall provide the City with a copy of all written approvals for private sewage disposal systems.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1776, (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"90119e50-c221-4901-b36b-51f98300d770","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--fa13c7b0-b437-4b79-96a6-cb1d95391d4c","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-12-15","docId":"75","text":"15.20.040 Private Sewage Disposal Systems.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--fa13c7b0-b437-4b79-96a6-cb1d95391d4c","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--fa13c7b0-b437-4b79-96a6-cb1d95391d4c\/7d7125b3-0768-4b7f-bb84-f09d839df696","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--fa13c7b0-b437-4b79-96a6-cb1d95391d4c","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-15-11","docId":"75","text":"\u003Cp\u003EEvery residence, place of business, or other building or place where persons congregate, reside, or are employed that is located in an area designated in the adopted General Plan as not requiring public sanitary sewers shall be provided with a water flush toilet system; the water flush toilet system shall be connected to a private on-site sewage disposal system built or rebuilt, constructed, altered, reconstructed, or maintained in such a manner as to meet all requirements of the sewage system standards as defined in Section 15.20.020C of this chapter.\u003C\/p\u003E\u003Cp\u003E(Ord. 1776, (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"7d7125b3-0768-4b7f-bb84-f09d839df696","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--c27c92f6-4289-4270-bceb-0133db5ec148","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-12-16","docId":"75","text":"15.20.050 Soil Tests.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--c27c92f6-4289-4270-bceb-0133db5ec148","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--c27c92f6-4289-4270-bceb-0133db5ec148\/58718f8c-4c64-40f0-a7dc-6da1f088f455","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--c27c92f6-4289-4270-bceb-0133db5ec148","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-16-11","docId":"75","text":"\u003Cp\u003EThe Health Officer shall require soil percolation tests and at least one boring or excavation per site. The Health Officer may require additional tests and studies as he\/she deems necessary to establish the suitability of the site for on-site sewage disposal.\u003C\/p\u003E\u003Cp\u003E(Ord. 1776, (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"58718f8c-4c64-40f0-a7dc-6da1f088f455","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--6856a683-e303-4a5a-954e-bb40fada5eb7","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-12-17","docId":"75","text":"15.20.060 New Construction\u2013Permit Required.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--6856a683-e303-4a5a-954e-bb40fada5eb7","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--6856a683-e303-4a5a-954e-bb40fada5eb7\/5e0d8c33-67d8-4fc4-a3ab-d9d5e64405eb","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--6856a683-e303-4a5a-954e-bb40fada5eb7","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-17-11","docId":"75","text":"\u003Cp\u003EIt is unlawful for any person to construct, build or rebuild any residence or other building or place where people congregate, reside, or are employed which is not to be connected to an approved public sanitary sewer without first submitting plans of the means of sewage disposal to the Health Officer and obtaining a permit therefor.\u003C\/p\u003E\u003Cp\u003E(Ord. 1776, (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"5e0d8c33-67d8-4fc4-a3ab-d9d5e64405eb","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--89d776cf-6192-4b6e-a525-1a450895fee9","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-12-18","docId":"75","text":"15.20.070 Alteration\u2013Permit Required.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--89d776cf-6192-4b6e-a525-1a450895fee9","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--89d776cf-6192-4b6e-a525-1a450895fee9\/00f109b9-2d24-489d-9e3a-2043edd42f12","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--89d776cf-6192-4b6e-a525-1a450895fee9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-18-11","docId":"75","text":"\u003Cp\u003EIt is unlawful for any person to alter, expand, or otherwise modify an existing sewage disposal system without first submitting plans of the proposed work to the Health Officer and obtaining a permit therefor.\u003C\/p\u003E\u003Cp\u003E(Ord. 1776, (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"00f109b9-2d24-489d-9e3a-2043edd42f12","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--8b6f3fd8-ccb5-4067-a0b5-8695ae37b9a7","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-12-19","docId":"75","text":"15.20.080 Septic Tank Permits.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--8b6f3fd8-ccb5-4067-a0b5-8695ae37b9a7","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--8b6f3fd8-ccb5-4067-a0b5-8695ae37b9a7\/b6a5c140-1fc7-471c-b3cf-5886ed51a200","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--8b6f3fd8-ccb5-4067-a0b5-8695ae37b9a7","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-19-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EApplication. The application for an on-site sewage disposal system shall include plans including a contoured plot plan to a minimum scale of one inch to twenty feet. The plans shall comply with and contain all information required by the sewage system standards and any additional information the Health Officer may require. Any changes in the plans after the issuance of a permit may invalidate the permit unless the changes are first approved by the Health Officer.\u003C\/li\u003E\u003Cli\u003EFees. Permit fees for sewage disposal systems subject to this chapter and all related fees shall be in an amount as determined by the County, from time to time, and adopted by the City Council.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1776, (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"b6a5c140-1fc7-471c-b3cf-5886ed51a200","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--c750628b-7e60-4c4f-b7df-ba89b259d468","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-12-210","docId":"75","text":"15.20.090 State Contractor\u2019s License Required.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--c750628b-7e60-4c4f-b7df-ba89b259d468","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--c750628b-7e60-4c4f-b7df-ba89b259d468\/1ee666da-ba78-4408-b9fe-16d1f8a006bc","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--c750628b-7e60-4c4f-b7df-ba89b259d468","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-210-11","docId":"75","text":"\u003Cp\u003ENo person shall install, construct, alter, enlarge, reconstruct, replace, improve, recondition, or repair a private sewage system without having first having obtained a State contractor\u2019s license pursuant to the sewage system standards.\u003C\/p\u003E\u003Cp\u003E(Ord. 1776, (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"1ee666da-ba78-4408-b9fe-16d1f8a006bc","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--bfeae8d8-47e3-46b2-8ada-3034cdf542d8","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-12-211","docId":"75","text":"15.20.100 Refusal to Issue Building Permit.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--bfeae8d8-47e3-46b2-8ada-3034cdf542d8","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--bfeae8d8-47e3-46b2-8ada-3034cdf542d8\/c2f533f1-2ca9-418c-806e-26a104fd041f","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--bfeae8d8-47e3-46b2-8ada-3034cdf542d8","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-211-11","docId":"75","text":"\u003Cp\u003ENo building permit or certificate of occupancy shall be issued by the City for any building to be used as a residence, place of business, or place where people congregate, reside or are employed, that is not to be connected to an approved sanitary sewer unless the applicant has received written approval of the Health Officer for an on-site sewage disposal system.\u003C\/p\u003E\u003Cp\u003E(Ord. 1776, (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"c2f533f1-2ca9-418c-806e-26a104fd041f","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--4abdb7a4-4c0b-40f8-84e4-6570eb6bf892","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-12-212","docId":"75","text":"15.20.110 Construction Inspections.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--4abdb7a4-4c0b-40f8-84e4-6570eb6bf892","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--4abdb7a4-4c0b-40f8-84e4-6570eb6bf892\/23d0fe8f-c4a6-46a1-923f-cfd865e734d3","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--4abdb7a4-4c0b-40f8-84e4-6570eb6bf892","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-212-11","docId":"75","text":"\u003Cp\u003EInspections of new installations shall be made to ensure compliance with the sewage system standards. All inspections shall be made by the Health Officer in accordance with the sewage system standards. Noncompliance will cause a stop work order to be posted on the job site by the Health Officer. Clearance from the Health Officer must be obtained before further work is done on a posted system.\u003C\/p\u003E\u003Cp\u003E(Ord. 1776, (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"23d0fe8f-c4a6-46a1-923f-cfd865e734d3","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--bdbff167-f911-4ac2-963b-253affbe1ad9","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-12-213","docId":"75","text":"15.20.120 Sewer Wells, Cesspools, Seepage Pits Unlawful.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--bdbff167-f911-4ac2-963b-253affbe1ad9","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--bdbff167-f911-4ac2-963b-253affbe1ad9\/0258f6d3-4f6b-4171-86ec-2c4b7420081f","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--bdbff167-f911-4ac2-963b-253affbe1ad9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-213-11","docId":"75","text":"\u003Cp\u003EAll sewer wells, cesspools, seepage pits, and similar excavations are hereby declared to be a public nuisance and are prohibited.\u003C\/p\u003E\u003Cp\u003E(Ord. 1776, (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0258f6d3-4f6b-4171-86ec-2c4b7420081f","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--72833073-1e5d-4c79-8cf2-cf3881d6299a","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-12-214","docId":"75","text":"15.20.130 Failing Sewage Disposal Systems.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--72833073-1e5d-4c79-8cf2-cf3881d6299a","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--72833073-1e5d-4c79-8cf2-cf3881d6299a\/5bb368a2-7c0a-40ce-a4d8-a0ab0c7aa6e3","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--72833073-1e5d-4c79-8cf2-cf3881d6299a","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-214-11","docId":"75","text":"\u003Cp\u003EIn case of failure, malfunction or breakdown of a private sewage disposal system, if not corrected within the time designated by the Health Officer, the Health Officer may order or cause corrections to be made. The property owner will be responsible for the costs of correction. The Health Officer may also order vacation of the premises pursuant to the sewage system standards.\u003C\/p\u003E\u003Cp\u003E(Ord. 1776, (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"5bb368a2-7c0a-40ce-a4d8-a0ab0c7aa6e3","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--cd2d2c9e-8e5e-47dd-a59e-00b2bdce2195","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-12-215","docId":"75","text":"15.20.140 Abandoned Sewage Disposal Systems.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--cd2d2c9e-8e5e-47dd-a59e-00b2bdce2195","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--cd2d2c9e-8e5e-47dd-a59e-00b2bdce2195\/596a5ca1-3a72-4be5-abd8-3742da6738b4","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--cd2d2c9e-8e5e-47dd-a59e-00b2bdce2195","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-215-11","docId":"75","text":"\u003Cp\u003EEvery private sewage disposal system which has been abandoned or has been discontinued from further use or to which no waste discharge pipe from a plumbing fixture is connected shall be treated in accordance with the sewage system standards.\u003C\/p\u003E\u003Cp\u003E(Ord. 1776, (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"596a5ca1-3a72-4be5-abd8-3742da6738b4","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--19db895b-dfc8-442c-9242-806efebd64a2","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-12-216","docId":"75","text":"15.20.150 Recording Notice of Violation.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--19db895b-dfc8-442c-9242-806efebd64a2","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--19db895b-dfc8-442c-9242-806efebd64a2\/27ba9d10-466a-475e-87da-4930b4951b93","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--19db895b-dfc8-442c-9242-806efebd64a2","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-216-11","docId":"75","text":"\u003Cp\u003EThe Health Officer may record a notice of existence of a substandard sewage disposal system violation in the office of the County Recorder, and shall notify the owner of the affected real property, and any other known party responsible for the violation that such action has been taken.\u003C\/p\u003E\u003Cp\u003E(Ord. 1776, (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"27ba9d10-466a-475e-87da-4930b4951b93","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--6b2d4039-52e9-49c0-9f5d-7eb794741f8d","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-12-217","docId":"75","text":"15.20.160 Liability.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--6b2d4039-52e9-49c0-9f5d-7eb794741f8d","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--6b2d4039-52e9-49c0-9f5d-7eb794741f8d\/d46c978d-adff-40a2-bdf4-9dc629cff160","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--6b2d4039-52e9-49c0-9f5d-7eb794741f8d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-217-11","docId":"75","text":"\u003Cp\u003EThe provisions of this chapter shall not be construed as imposing upon the City any liability or responsibility for damages resulting from the defective construction of any sewage disposal system, nor shall the City, or any official or employee thereof, be held as assuming any such liability or responsibility by reason of the inspections authorized by the provisions of this chapter.\u003C\/p\u003E\u003Cp\u003E(Ord. 1776, (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d46c978d-adff-40a2-bdf4-9dc629cff160","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--0b2a45b5-0133-46e7-b963-1ee837285ab7","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-12-218","docId":"75","text":"15.20.170 Enforcement.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--0b2a45b5-0133-46e7-b963-1ee837285ab7","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--0b2a45b5-0133-46e7-b963-1ee837285ab7\/25980c2a-98bd-4854-a8be-50b3c5e59e8c","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--0b2a45b5-0133-46e7-b963-1ee837285ab7","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-218-11","docId":"75","text":"\u003Cp\u003EIt shall be the duty of the Health Officer to enforce the provisions of this chapter, and in the performance of this duty, the Health Officer, or any duly authorized agent of the Health Officer, is authorized to enter at any reasonable hour any premises as may be necessary in the enforcement of the provisions of this chapter and to make investigations, including the taking of samples and conducting dye tests.\u003C\/p\u003E\u003Cp\u003E(Ord. 1776, (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"25980c2a-98bd-4854-a8be-50b3c5e59e8c","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--b279cd71-20f5-4fab-a28a-551fd931acec","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-12-219","docId":"75","text":"15.20.180 Violations.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--b279cd71-20f5-4fab-a28a-551fd931acec","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--b279cd71-20f5-4fab-a28a-551fd931acec\/750bc27d-7020-4687-8223-1d18a40f2e1b","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--b279cd71-20f5-4fab-a28a-551fd931acec","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-219-11","docId":"75","text":"\u003Cp\u003EAny person violating or refusing or failing to comply with any of the provisions of this chapter, shall be deemed guilty of a misdemeanor and, upon conviction thereof, shall be punished as provided in Chapter 1.12 of this code.\u003C\/p\u003E\u003Cp\u003E(Ord. 1776, (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"750bc27d-7020-4687-8223-1d18a40f2e1b","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--da936c70-9769-401e-9f92-edee156c8df9","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-12-220","docId":"75","text":"15.20.190 Appeals.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--da936c70-9769-401e-9f92-edee156c8df9","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e\/87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--da936c70-9769-401e-9f92-edee156c8df9\/cb9a745f-a74c-4f6e-8072-4bba9a229afa","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--a13cab61-7576-48ac-97e5-a7830d65f29e--da936c70-9769-401e-9f92-edee156c8df9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-12-220-11","docId":"75","text":"\u003Cp\u003EAny appeal of the decision of the Health Officer pursuant to this chapter shall be made in writing to the Regional Water Quality Control Board having jurisdiction within fifteen days after any such decision is received by the applicant. A copy of such appeal shall also be filed with the Health Officer. The appeal shall specifically describe the grounds upon which it is taken. The decision issued by the Regional Water Quality Control Board shall be final.\u003C\/p\u003E\u003Cp\u003E(Ord. 1776, (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"cb9a745f-a74c-4f6e-8072-4bba9a229afa","prev_id":null}]}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6","ref":{"parent":"42a74925-2ecf-419e-a945-f3393ce53db9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"216-13","docId":"75","text":"CHAPTER 15.32: WATER CONSERVATION","id":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6\/9462750b-2f60-4b5b-bacd-34b2bd3cc223","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-13-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"9462750b-2f60-4b5b-bacd-34b2bd3cc223","prev_id":null},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--77e00a4c-dfa9-4c4c-8c3e-99ef0911354a","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-13-12","docId":"75","text":"15.32.010 Findings and Determinations.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--77e00a4c-dfa9-4c4c-8c3e-99ef0911354a","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--77e00a4c-dfa9-4c4c-8c3e-99ef0911354a\/ef68b50e-6c48-4a42-8ebf-ac70181f2f44","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--77e00a4c-dfa9-4c4c-8c3e-99ef0911354a","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-13-12-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EA reliable supply of potable water is essential to the public health, safety, and welfare of the people and economy of the City of Cupertino; and\u003C\/li\u003E\u003Cli\u003EArticle X, Section 2 of the California Constitution declares that the general welfare requires that the water resources of the State be put to beneficial use to the fullest extent of which they are capable, and that the waste or unreasonable use or unreasonable method of use of water be prevented, and that the conservation of such waters is to be exercised with a view to the reasonable and beneficial use thereof in the interest of the people and for the public welfare; and\u003C\/li\u003E\u003Cli\u003EArticle XI, Section 7 of the California Constitution declares that a city or county may make and enforce within its limits all local, police, sanitary and other ordinances and regulations not in conflict with general laws; and\u003C\/li\u003E\u003Cli\u003EThe Governor of the State of California and\/or other State regulatory agencies such as the State Water Resource Control Board may, as regional drought conditions warrant, mandate water conservation measures; and\u003C\/li\u003E\u003Cli\u003EThe Santa Clara Valley Water District, or other wholesale water supplier serving the City of Cupertino, may implement water conservation goals specific to the Cupertino area based upon drought stages identified in their Urban Water Management Plan or in other declaration or action; and\u003C\/li\u003E\u003Cli\u003ESan Jose Water Company, California Water Service Company, and any other urban water suppliers in the City of Cupertino, will coordinate water conservation measures with the Santa Clara Valley Water District and, depending on the severity of a drought, may file with the California Public Utilities Commission specific water use targets and\/or budgets along with associated tariffs and enforcement measures, consistent with its Water Shortage Contingency Plan to achieve state mandated water use reductions that may affect City of Cupertino residents and businesses; and\u003C\/li\u003E\u003Cli\u003EThe adoption and enforcement of water conservation regulations is essential to minimize the effects of drought and shortage within the City and ensure a reliable and sustainable minimum supply of water to protect public health, safety and welfare of current and future community members and to protect the environment; and\u003C\/li\u003E\u003Cli\u003EThe purpose of this Chapter is to establish water conservation measures that are intended to alter behavior related to the use of water, reduce the consumption of water, assure reasonable and beneficial use of water, prevent the waste of water, and maximize the efficient use of water across the City of Cupertino.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 15-2131, \u00a7 1 (part), 2015; Ord. 1622, (part), 1993; Ord. 1587, (part), 1992; Ord. 1580, (part), 1992; Ord. 1558, \u00a7 1, 1991; Ord. 1524, \u00a7 1, 1990; Ord. 1513, \u00a7 1, 1990)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"ef68b50e-6c48-4a42-8ebf-ac70181f2f44","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--ddb76489-9a29-4ca7-8b63-f2e3f426db3d","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-13-13","docId":"75","text":"15.32.020 Definitions.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--ddb76489-9a29-4ca7-8b63-f2e3f426db3d","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--ddb76489-9a29-4ca7-8b63-f2e3f426db3d\/158fd55e-5bd1-4a5e-ab84-9fabb3feea51","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--ddb76489-9a29-4ca7-8b63-f2e3f426db3d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-13-13-11","docId":"75","text":"\u003Cp\u003EAs used in this chapter\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003E\u0022Customer\u0022 means any person who pays for service to receive potable water.\u003C\/li\u003E\u003Cli\u003E\u0022Irrigation system\u0022 means the components of a system meant to apply water to an area for the purpose of irrigation, including, but not limited to, piping, fittings, sprinkler heads or nozzles, drip tubing, valves, and control wiring.\u003C\/li\u003E\u003Cli\u003E\u0022Landscape\u0022 means all of the outdoor planting areas, turf areas, and water features at a particular location.\u003C\/li\u003E\u003Cli\u003E\u0022Person\u0022 means any individual, firm, partnership, association, corporation, trust, governmental body or other organization or entity.\u003C\/li\u003E\u003Cli\u003E\u0022Potable water\u0022 means water which conforms to the federal and state standards for human consumption.\u003C\/li\u003E\u003Cli\u003E\u0022Runoff\u0022 means water which is not absorbed by the soil or landscape to which it is applied and flows from the landscape onto other areas.\u003C\/li\u003E\u003Cli\u003E\u0022Water\u0022 means potable water.\u003C\/li\u003E\u003Cli\u003E\u0022Water feature\u0022 means a design element where open, artificially supplied water performs an aesthetic or recreation feature, including, but not limited to, ponds, lakes, waterfalls, fountains, and streams.\u003C\/li\u003E\u003Cli\u003E\u0022Urban water supplier\u0022 means the California Water Service and\/or San Jose Water Company or any other urban water supplier as defined by Water Code Section 10617, excluding wholesale suppliers, unless the wholesale supplier is functioning in a retail capacity.\u003C\/li\u003E\u003Cli\u003E\u0022Water district\u0022 means the Santa Clara Valley Water District or other wholesale water supplier as defined by State law.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 15- 2131, \u00a7 1 (part), 2015; Ord. 1776, (part), 1998; Ord. 1622, (part), 1993: Ord. 1587, (part), 1992; Ord. 1580, (part), 1992; Ord. 1558, \u00a7 2, 1991; Ord. 1524, \u00a7 2, 1990; Ord. 1513, \u00a7 2, 1990)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"158fd55e-5bd1-4a5e-ab84-9fabb3feea51","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--db4fb130-bf0c-46ee-9d3f-9ae241606b68","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-13-14","docId":"75","text":"15.32.030 Prohibited Uses of Water.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--db4fb130-bf0c-46ee-9d3f-9ae241606b68","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--db4fb130-bf0c-46ee-9d3f-9ae241606b68\/af80be9c-36f4-44c4-9f23-1d9a96a40591","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--db4fb130-bf0c-46ee-9d3f-9ae241606b68","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-13-14-11","docId":"75","text":"\u003Cp\u003ETo prevent water waste, the unreasonable use of water, and to promote water conservation, each of the following actions are prohibited while using potable water:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ENo person shall waste water, including, but not limited to flooding or creating runoff on sidewalks or gutters, adjacent property, non-irrigated areas, private and public walkways, roadways, parking lots, or structures.\u003C\/li\u003E\u003Cli\u003ENo person shall use a hose that dispenses potable water to wash vehicles, including cars, trucks, buses, boats, aircraft, and trailers, whether motorized or not, unless the hose is fitted with a shut-off nozzle or device attached to it that causes it to cease dispensing water immediately when not in use.\u003C\/li\u003E\u003Cli\u003ENo person shall waste water by failing to repair defective plumbing, sprinkler, watering or irrigation systems.\u003C\/li\u003E\u003Cli\u003ENo person shall use water for single pass cooling process for new building construction.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 15-2131, \u00a7 1 (part), 2015; Ord. 1622, (part), 1993; Ord. 1587, (part), 1992; Ord. 1580, (part), 1992; Ord. 1558, \u00a7 3, 1991; Ord. 1524, \u00a7 3, 1990; Ord. 1513, \u00a7 3, 1990)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"af80be9c-36f4-44c4-9f23-1d9a96a40591","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--a01d693a-2585-4a69-9c46-b81b47fcf0ce","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-13-15","docId":"75","text":"15.32.040 Regulations for Restrictions on Water Use.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--a01d693a-2585-4a69-9c46-b81b47fcf0ce","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--a01d693a-2585-4a69-9c46-b81b47fcf0ce\/18e4ef20-ae64-4a65-81d9-bdbc525658c2","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--a01d693a-2585-4a69-9c46-b81b47fcf0ce","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-13-15-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe City Council may determine that additional restrictions on water use are needed as a result of drought or other water supply conditions, to achieve additional conservation goals, or for other public purposes. The City Council may adopt Regulations Restricting Water Use.\u003C\/li\u003E\u003Cli\u003EThe Regulations shall take effect as soon as practicable.\u003C\/li\u003E\u003Cli\u003EThe Regulations shall remain in effect until the City Council repeals, modifies, or amends them, or according to their own terms, whichever comes first.\u003C\/li\u003E\u003Cli\u003EThe Regulations adopted pursuant to this chapter shall have the force and effect of law.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 15-2131, \u00a7 1 (part), 2015)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"18e4ef20-ae64-4a65-81d9-bdbc525658c2","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--209eeb9d-5b39-4508-bd4e-37d5eae7581f","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-13-16","docId":"75","text":"15.32.050 Water Use at City Facilities.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--209eeb9d-5b39-4508-bd4e-37d5eae7581f","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--209eeb9d-5b39-4508-bd4e-37d5eae7581f\/5d1c4d17-82a2-4c0b-80ed-7caa8b9fa8cf","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--209eeb9d-5b39-4508-bd4e-37d5eae7581f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-13-16-11","docId":"75","text":"\u003Cp\u003EThe Director of Public Works or his\/her designee may adopt and implement water conservation measures at City facilities.\u003C\/p\u003E\u003Cp\u003E(Ord. 15-2131, \u00a7 1 (part), 2015)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"5d1c4d17-82a2-4c0b-80ed-7caa8b9fa8cf","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--46f08dee-8f4e-45d1-8aab-7844b2f40db9","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-13-17","docId":"75","text":"15.32.060 Exceptions for Public Health and Safety.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--46f08dee-8f4e-45d1-8aab-7844b2f40db9","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--46f08dee-8f4e-45d1-8aab-7844b2f40db9\/b7b3cd5e-eb50-4d7b-90cd-33cabae3882d","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--46f08dee-8f4e-45d1-8aab-7844b2f40db9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-13-17-11","docId":"75","text":"\u003Cp\u003EThe provisions of this Chapter do not apply to uses of water which are necessary to protect public health or safety, for essential government services, such as police, fire, and other similar emergency services, conveyance maintenance, or where necessary to comply with the a term or condition in a permit issued by a State or federal agency.\u003C\/p\u003E\u003Cp\u003E(Ord. 15-2131, \u00a7 1 (part), 2015)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"b7b3cd5e-eb50-4d7b-90cd-33cabae3882d","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--bde8f1c7-d252-49e5-9e5a-6e1406fc244b","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-13-18","docId":"75","text":"15.32.070 Emergency Suspension of Water Service.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--bde8f1c7-d252-49e5-9e5a-6e1406fc244b","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--bde8f1c7-d252-49e5-9e5a-6e1406fc244b\/63c5c683-d316-4e27-bc42-4163967a86c4","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--bde8f1c7-d252-49e5-9e5a-6e1406fc244b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-13-18-11","docId":"75","text":"\u003Cp\u003EIn the event of an emergency involving broken or defective plumbing, sprinkler, watering or irrigation systems where, in the opinion of the Director of Public Works or his\/her designee, water is being or will be lost in considerable quantity, the City may require that the urban water supplier immediately suspend water service without notice or hearing to any customer pending repairs. The urban water supplier shall attempt to give notice to the customer or customers affected as soon as practical. Subject to other provisions of this Chapter, service shall be restored as soon as possible.\u003C\/p\u003E\u003Cp\u003E(Ord. 15-2131, \u00a7 1 (part), 2015; Ord. 1622, (part), 1993; Ord. 1587, (part), 1992:\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"63c5c683-d316-4e27-bc42-4163967a86c4","prev_id":null}]},{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--af644edc-528a-4954-bf3d-cc153837ea2d","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"216-13-19","docId":"75","text":"15.32.080 Violation\u2013Penalty.","id":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--af644edc-528a-4954-bf3d-cc153837ea2d","children":[{"path":"\/42a74925-2ecf-419e-a945-f3393ce53db9\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6\/87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--af644edc-528a-4954-bf3d-cc153837ea2d\/b7c94b2c-b20a-4de4-8bfa-4231e4cc2eb4","ref":{"parent":"87f89ef9-4014-4b98-a255-0279989dbe24--aa150875-ae43-462a-a8ac-316a770186f6--af644edc-528a-4954-bf3d-cc153837ea2d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"216-13-19-11","docId":"75","text":"\u003Cp\u003EAny person who violates any provision of this Chapter or any regulation adopted pursuant to this Chapter shall be guilty of a misdemeanor and upon conviction thereof shall be punished as provided in Chapter 1.12 of this code. As an alternative to criminal legal punishment, any person who violates any provision of this Chapter or any regulation adopted pursuant to this Chapter shall be subject to administrative citation, fines, or penalties as provided in Chapter 1.10 of this code.\u003C\/p\u003E\u003Cp\u003E(Ord. 15-2131, \u00a7 1 (part), 2015; Ord. 1776, (part), 1998; Ord. 1622, (part), 1993; Ord. 1587, (part), 1992; Ord. 1580, (part), 1992; Ord. 1558, \u00a7 4.01, 1991; Ord. 1524, \u00a7 4.01, 1990; Ord. 1513, \u00a7 4.01, 1990)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"b7c94b2c-b20a-4de4-8bfa-4231e4cc2eb4","prev_id":null}]}]}]}]