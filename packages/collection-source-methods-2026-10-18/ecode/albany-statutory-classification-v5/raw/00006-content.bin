startcol="5" valign="top"><div class="para" style="margin-left:0px;">Ch. <a class="xref" guid="7684666" href="7684666#7684666">323</a></div></td></tr><tr class=""><td align="left" charoff="50" class="entry" colspan="3" startcol="1" valign="top"><div class="para" style="margin-left:0px;">Ch. XXIV</div></td><td align="left" charoff="50" class="entry" startcol="4" valign="top"><div class="para" style="margin-left:0px;">Trees and shrubs</div></td><td align="left" charoff="50" class="entry" startcol="5" valign="top"><div class="para" style="margin-left:0px;">Ch. <a class="xref" guid="7685173" href="7685173#7685173">345</a></div></td></tr><tr class=""><td align="left" charoff="50" class="entry" colspan="3" startcol="1" valign="top"><div class="para" style="margin-left:0px;">Ch. XXV</div></td><td align="left" charoff="50" class="entry" startcol="4" valign="top"><div class="para" style="margin-left:0px;">Vehicles</div></td><td align="left" charoff="50" class="entry" startcol="5" valign="top"><div class="para" style="margin-left:0px;"></div></td></tr><tr class=""><td align="left" charoff="50" class="entry" startcol="1" valign="top"><div class="para" style="margin-left:0px;"></div></td><td align="left" charoff="50" class="entry" colspan="2" startcol="2" valign="top"><div class="para" style="margin-left:0px;">Art. <a class="xref" guid="7678195" href="7678195#7678195">I</a></div></td><td align="left" charoff="50" class="entry" startcol="4" valign="top"><div class="para" style="margin-left:0px;"></div></td><td align="left" charoff="50" class="entry" startcol="5" valign="top"><div class="para" style="margin-left:0px;">Ch. <a class="xref" guid="7685564" href="7685564#7685564">359</a></div></td></tr><tr class=""><td align="left" charoff="50" class="entry" startcol="1" valign="top"><div class="para" style="margin-left:0px;"></div></td><td align="left" charoff="50" class="entry" colspan="2" startcol="2" valign="top"><div class="para" style="margin-left:0px;">Art. <a class="xref" guid