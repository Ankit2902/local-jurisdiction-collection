<div class="article_content content" id="7679548_content" title-footnotes="0"><div class="footnotes"></div></div>                <article>
                <header>
  <div data-component="h3"
       class="contentTitle barTitle sectionTitle 7679549 child"
      id="7679549"
      data-guid="7679549"
      data-parent-guid="7679548"
      data-position="1184"
      data-full-title="§ 42-147: Office; location and hours."
      data-code-content-type="section"
  >
    <span class="selectionBox material-icons material-symbols-outlined material-symbols-and-filled md-24"
