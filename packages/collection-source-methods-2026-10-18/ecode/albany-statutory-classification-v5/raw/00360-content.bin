           data-toc-nodes="{&quot;prefix&quot;:&quot;&quot;,&quot;tocName&quot;:&quot;City of Albany, NY&quot;,&quot;guid&quot;:&quot;AL0934&quot;,&quot;href&quot;:&quot;/AL0934&quot;,&quot;title&quot;:&quot;City of Albany, NY&quot;,&quot;number&quot;:&quot;&quot;,&quot;indexNum&quot;:&quot;&quot;,&quot;type&quot;:&quot;code&quot;,&quot;label&quot;:&quot;&quot;,&quot;hideNumber&quot;:true,&quot;children&quot;:[{&quot;prefix&quot;:&quot;&quot;,&quot;tocName&quot;:&quot;The Charter&quot;,&quot;guid&quot;:&quot;11765840&quot;,&quot;parent&quot;:&quot;AL0934&quot;,&quot;href&quot;:&quot;/11765840&quot;,&quot;title&quot;:&quot;The Charter&quot;,&quot;number&quot;:&quot;&quot;,&quot;indexNum&quot;:&quot;&quot;,&quot;type&quot;:&quot;division&quot;,&quot;label&quot;:&quot;&quot;,&quot;hideNumber&quot;:true,&quot;children&quot;:[{&quot;prefix&quot;:&quot;Ch C&quot;,&quot;tocName&quot;:&quot;Charter&quot;,&quot;guid&quot;:&quot;12064948&quot;,&quot;parent&quot;:&quot;11765840&quot;,&quot;href&quot;:&quot;/12064948&quot;,&quot;title&quot;:&quot;Charter&quot;,&quot;number&quot;:&quot;C&quot;,&quot;indexNum&quot;:&quot;Ch C&quot;,&quot;type&quot;:&quot;chapter&quot;,&quot;label&quot;:&quot;Chapter&quot;,&quot;hideNumber&quot;:false,&quot;children&quot;:[]}]},{&quot;prefix&quot;:&quot;&quot;,&quot;tocName&quot;:&quot;The Code&quot;,&quot;guid&quot;:&quot;11765841&quot;,&quot;parent&quot;:&quot;AL0934&quot;,&quot;href&quot;:&quot;/11765841&quot;,&quot;title&quot;:&quot;The Code&quot;,&quot;number&quot;:&quot;&quot;,&quot;indexNum&quot;:&quot;&quot;,&quot;type&quot;:&quot;division&quot;,&quot;label&quot;:&quot;&quot;,&quot;hideNumber&quot;:true,&quot;children&quot;:[{&quot;prefix&quot;:&quot;Pt I&quot;,&quot;tocName&quot;:&quot;Administrative Legislation&quot;,&quot;guid&quot;:&quot;11765842&quot;,&quot;parent&quot;:&quot;11765841&quot;,&quot;href&quot;:&quot;/11765842&quot;,&quot;title&quot;:&quot;Administrative Legislation&quot;,&quot;number&quot;:&quot;I&quot;,&quot;indexNum&quot;:&quot;&quot;,&quot;type&quot;:&quot;division&quot;,&quot;label&quot;:&quot;Part&quot;,&quot;hideNumber&quot;:false,&quot;children&quot;:[]},{&quot;prefix&quot;:&quot;Pt II&quot;,&quot;tocName&quot;:&quot;General Legislation&quot;,&quot;guid&quot;:&quot;11765843&quot;,&quot;parent&quot;:&quot;11765841&quot;,&quot;href&quot;:&quot;/11765843&quot;,&quot;title&quot;:&quot;General Legislation&quot;,&quot;number&quot;:&quot;II&quot;,&quot;indexNum&quot;:&quot;&quot;,&quot;type&quot;:&quot;division&quot;,&quot;label&quot;:&quot;Part&quot;,&quot;hideNumber&quot;:false,&quot;children&quot;:[]},{&quot;prefix&quot;:&quot;&quot;,&quot;tocName&quot;:&quot;Appendix&quot;,&quot;guid&quot;:&quot;11765844&quot;,&quot;parent&quot;:&quot;11765841&quot;,&quot;href&quot;:&quot;/11765844&quot;,&quot;title&quot;:&quot;Appendix&quot;,&quot;number&quot;:&quot;&quot;,&quot;indexNum&quot;:&quot;&quot;,&quot;type&quot;:&quot;division&quot;,&quot;label&quot;:&quot;&quot;,&quot;hideNumber&quot;:true,&quot;children&quot;:[]},{&quot;prefix&quot;:&quot;&quot;,&quot;tocName&quot;:&quot;Disposition List&quot;,&quot;guid&quot;:&quot;11765845&quot;,&quot;parent&quot;:&quot;11765841&quot;,&quot;href&quot;:&quot;/11765845&quot;,&quot;title&quot;:&quot;Disposition List&quot;,&quot;number&quot;:&quot;&quot;,&quot;indexNum&quot;:&quot;&quot;,&quot;type&quot;:&quot;division&quot;,&quot;label&quot;:&quot;&quot;,&quot;hideNumber&quot;:true,&quot;children&quot;:[]}]}]}" data-initial-toc-depth="1" data-type="code" data-label="" data-toc-view="enhanced"
