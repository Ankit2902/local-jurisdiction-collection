{
  "certificate_verification_required": true,
  "hostname_verification": true,
  "default_paths": {
    "cafile": "/private/etc/ssl/cert.pem",
    "capath": "/private/etc/ssl/certs",
    "openssl_cafile_env": "SSL_CERT_FILE",
    "openssl_cafile": "/private/etc/ssl/cert.pem",
    "openssl_capath_env": "SSL_CERT_DIR",
    "openssl_capath": "/private/etc/ssl/certs"
  },
  "custom_unverified_context": false
}
