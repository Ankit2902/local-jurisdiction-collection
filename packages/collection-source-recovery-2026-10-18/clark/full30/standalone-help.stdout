usage: collect.py [-h] --config CONFIG --out OUT [--resume]
                  [--max-items MAX_ITEMS] [--interrupt-after INTERRUPT_AFTER]
                  [--from-cache FROM_CACHE] [--replay-from REPLAY_FROM]

options:
  -h, --help            show this help message and exit
  --config CONFIG
  --out OUT
  --resume
  --max-items MAX_ITEMS
  --interrupt-after INTERRUPT_AFTER
  --from-cache FROM_CACHE
  --replay-from REPLAY_FROM
