                <article>
                <header>
  <div data-component="h2"
       class="contentTitle barTitle sectionTitle 7678612"
      id="7678612"
      data-guid="7678612"
      data-position="543"
      data-full-title="§ 30-195: Time for rendering judgment or decision."
      data-code-content-type="section"
  >
    <span class="selectionBox material-icons material-symbols-outlined material-symbols-and-filled md-24"
         title="Select this content"
         aria-label="Select this content"
    >
      <input type="checkbox" class="selectionBoxInput" id="7678612_input"/>
    </span>
    <label class="selectionLabel" id="7678612_label" for="7678612_input">
  <div class="titleLinkContainer">
    <a href="#7678612"
       class="titleLink"
    >
    <span class="titleNumber">
      § 30-195
    </span>
    <span class="titleTitle"
          data-guid="7678612"
    >
Time for rendering judgment or decision.    </span>
    </a>
  </div>
