ck;" valign="top"><div class="para" style="margin-left:0px;">0 feet</div></td><td align="center" class="entry borderBottom" startcol="3" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;"><span class="graphic"><a href="/attachment/336787/AL0934-375 F.tif.png" id="" target="_blank"><img class="graphicThumb&#xA; " src="/attachment/336787/AL0934-375 F.tif.SM.png"></img></a></span></div></td></tr><tr class="borderBottom "><td align="left" class="entry borderBottom" startcol="1" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;">Side build-to zone (corner), minimum</div></td><td align="left" class="entry borderBottom" startcol="2" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;">0 feet</div></td><td align="center" class="entry borderBottom" rowspan="2" startcol="3" style="border-color:black;" valign="middle"><div class="para" style="margin-left:0px;"><span class="graphic"><a href="/attachment/336787/AL0934-375 G.tif.png" id="" target="_blank"><img class="graphicThumb&#xA; " src="/attachment/336787/AL0934-375 G.tif.SM.png"></img></a></span></div></td></tr><tr class=""><td align="left" class="entry borderBottom" startcol="1" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;">Side build-to zone (corner), maximum</div></td><td align="left" class="entry borderBottom" startcol="2" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;">10 feet</div></td></tr><tr class="borderBottom "><td align="left" class="entry borderBottom" startcol="1" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;">Rear setback (lot or alley), minimum</div></td><td align="left" class="entry borderBottom" startcol="2" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;">5 feet</div></td><td align="center" class="entry borderBottom" startcol="3" style="border-color:black;" valign="t