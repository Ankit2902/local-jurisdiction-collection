="2" scope="col" startcol="1" style="color:black;background-color:white;border-color:black;" valign="top"><div class="para" style="margin-left:0px;">NOTES:</div></th></tr></thead><tbody valign="top"><tr class=""><td align="left" class="entry" startcol="1" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;">[1]</div></td><td align="left" class="entry" startcol="2" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;">Where the subject lot is adjacent to developed lots facing the same street and having a principal building located within 25 feet of the lot line, the required front setback shall be no closer nor further back from the street than the structures on the adjacent lots.</div></td></tr></tbody></table></div><div class="footnotes"></div></div></div><div class="litem breakHere" id="33431114"><a alt="375-402(2)(f)(iii)" class="litem_number" href="33431114#33431114" onclick="return false;" title="375-402(2)(f)(iii)">(iii) </a><div class="litem_content content"><div class="para">Parking location.</div><div class="codeTable " style="border-color:"><table class=" frame frameNone"><colgroup><col style="width: 100%"></col></colgroup><tbody valign="top"><tr class=""><td align="center" class="entry" startcol="1" valign="top"><div class="para" style="margin-left:0px;"><span class="graphic"><a href="/attachment/336787/375-4 B2hiii.tif.png" id="" target="_blank"><img class="graphicThumb&#xA; " src="/attachment/336787/375-4 B2hiii.tif.SM.png"></img></a></span></div></td></tr></tbody></table></div><div class="codeTable #333" style="border-color:#333"><table class=" frame frameTopBottom" style="border-color:black; " tabstyle=""><colgroup><col style="width: 41%"></col><col style="width: 36%"></col><col style="width: 23%"></col></colgroup><thead valign="bottom"><tr class=""><th align="left" class="entry borderBottom" colspan="3" scope="col" startcol="1" style="color:#ffffff;background-color:#c0c0c0;border-color:blac