k;" valign="top"><div class="para" style="margin-left:0px;"></div></td></tr><tr class=""><td align="left" class="entry" startcol="1" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;">Rear setback (street), minimum</div></td><td align="left" class="entry" startcol="2" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;">20 feet</div></td><td align="center" class="entry" startcol="3" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;"></div></td></tr></tbody></table></div><div class="codeTable #333" style="border-color:#333"><table class=" frame frameNone" style="border-color:black; " tabstyle=""><colgroup><col style="width: 6%"></col><col style="width: 94%"></col></colgroup><thead valign="bottom"><tr class=""><th align="left" class="entry" colspan="2" scope="col" startcol="1" style="color:black;background-color:white;border-color:black;" valign="top"><div class="para" style="margin-left:0px;">NOTES:</div></th></tr></thead><tbody valign="top"><tr class=""><td align="left" class="entry" startcol="1" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;">•</div></td><td align="left" class="entry" startcol="2" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;">Required parking may be located on-street or in a district parking lot or structure within 800 feet of the building's front door</div></td></tr><tr class=""><td align="left" class="entry" startcol="1" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;">•</div></td><td align="left" class="entry" startcol="2" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;">Parking shall be accessed from rear alleys or side streets whenever possible.</div></td></tr></tbody></table></div><div class="footnotes"></div></div></div><div class="litem breakHere" id="33431120"><a alt="375-402(2)(g)(iv)" class="litem_number" href="33431120#33431120" onclick="return false;" title="375-402(2)(g)(iv)">(iv) </a><div class="litem_content content"><div class="para">Frontage elements.</div><div class="codeTable " style="border-color:"><table class=" frame frameNone"><colgroup><col style="width: 100%"></col></colgroup><tbody valign="top"><tr class=""><td align="center" class="entry" startcol="1" valign="top"><div class="para" style="margin-left:0px;"><span class="graphic"><a href="/attachment/336787/375-4 B2giv.tif.png" id="" target="_blank"><img class="graphicThumb&#xA; " src="/attachment/336787/375-4 B2giv.tif.SM.png"></img></a></span></div></td></tr></tbody></table></div><div class="codeTable #333" style="border-color:#333"><table class=" frame frameTopBottom" style="border-color:black; " tabstyle=""><colgroup><col style="width: 41%"></col><col style="width: 36%"></col><col style="width: 23%"></col></colgroup><thead valign="bottom"><tr class=""><th align="left" class="entry borderBottom" colspan="3" scope="col" startcol="1" style="color:#ffffff;background-color:#c0c0c0;border-color:black;" valign="top"><div class="para" style="margin-left:0px;"><b class="bold">Frontage Elements</b></div></th></tr></thead><tbody valign="top"><tr class=""><td align="left" class="entry" startcol="1" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;">Allowed frontage elements</div></td><td align="left" class="entry" startcol="2" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;">Porch, stoop, common yard</div></td><td align="center" class="entry" startcol="3" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;"><span class="graphic"><a href="/attachment/336787/AL0934-375 M.tif.png" id="" target="_blank"><img class="graphicThumb&#xA; " src="/attachment/336787/AL0934-375 M.tif.SM.png"></img></a></span></div></td></tr></tbody></table></div><div class="codeTable #333" style="border-color:#333"><table class=" frame f