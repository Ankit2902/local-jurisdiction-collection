="para" style="margin-left:0px;">110</div></td><td align="center" class="entry borderRight borderBottom" startcol="4" valign="top"><div class="para" style="margin-left:0px;">100</div></td><td align="center" class="entry borderRight borderBottom" startcol="5" valign="top"><div class="para" style="margin-left:0px;">90</div></td><td align="center" class="entry borderRight borderBottom" startcol="6" valign="top"><div class="para" style="margin-left:0px;">55</div></td><td align="center" class="entry borderRight borderBottom" startcol="7" valign="top"><div class="para" style="margin-left:0px;">N/A</div></td><td align="center" class="entry borderBottom" startcol="8" valign="top"><div class="para" style="margin-left:0px;">N/A</div></td></tr><tr class=""><td align="left" class="entry borderRight borderBottom" colspan="2" startcol="1" style="background-color:#e2e2e2;" valign="top"><div class="para" style="margin-left:0px;"><b class="bold">Lot width, minimum</b></div><div class="para" style="margin-left:0px;"><b class="bold">(feet)</b></div></td><td align="center" class="entry borderRight borderBottom" startcol="3" valign="top"><div class="para" style="margin-left:0px;">70<sup class="superscript">[1]</sup></div></td><td align="center" class="entry borderRight borderBottom" startcol="4" valign="top"><div class="para" style="margin-left:0px;">40<sup class="superscript">[1]</sup></div></td><td align="center" class="entry borderRight borderBottom" startcol="5" valign="top"><div class="para" style="margin-left:0px;">25<sup class="superscript">[1]</sup></div></td><td align="center" class="entry borderRight borderBottom" startcol="6" valign="top"><div class="para" style="margin-left:0px;">18<sup class="superscript">[1]</sup></div></td><td align="center" class="entry borderRight borderBottom" startcol="7" valign="top"><div class="para" style="margin-left:0px;">22<sup class="superscript">[1]</sup></div></td><td align="center" class="entry borderBottom" startcol="8" valign="top"><div class="para" style="margin-left:0px;">100<sup class="superscript">[1]</sup></div></td></tr><tr class=""><td align="left" class="entry borderRight borderBottom" colspan="2" startcol="1" style="background-color:#e2e2e2;" valign="top"><div class="para" style="margin-left:0px;"><b class="bold">Impervious lot coverage, maximum</b></div></td><td align="center" class="entry borderRight borderBottom" startcol="3" valign="top"><div class="para" style="margin-left:0px;">30%</div></td><td align="center" class="entry borderRight borderBottom" startcol="4" valign="top"><div class="para" style="margin-left:0px;">40%</div></td><td align="center" class="entry borderRight borderBottom" startcol="5" valign="top"><div class="para" style="margin-left:0px;">70%</div></td><td align="center" class="entry borderRight borderBottom" startcol="6" valign="top"><div class="para" style="margin-left:0px;">80%</div></td><td align="center" class="entry borderRight borderBottom" startcol="7" valign="top"><div class="para" style="margin-left:0px;">80%</div></td><td align="center" class="entry borderBottom" startcol="8" valign="top"><div class="para" style="margin-left:0px;">50%</div></td></tr><tr class=""><td align="left" class="entry borderBottom" colspan="8" startcol="1" style="background-color:#c0c0c0;" valign="top"><div class="para" style="margin-left:0px;"><b class="bold">Setbacks</b></div></td></tr><tr class=""><td align="left" class="entry borderRight borderBottom" colspan="2" startcol="1" style="background-color:#e2e2e2;" valign="top"><div class="para" style="margin-left:0px;"><b class="bold">Front yard, minimum</b></div><div class="para" style="margin-left:0px;"><b class="bold">(feet)</b></div></td><td align="center" class="entry borderRight borderBottom" startcol="3" style="background-color:#c0c0c0;" valign="top"><div class="para" style="margin-left:0px;">25<sup class="superscript">[2]</sup></div></td><td align="center" class="entry borderRight borderBottom" startcol="4" style="background-color:#c0c0c0;" valign="top"><div class="para" style="margin-left:0px;">15<sup class="superscript">[2]</sup></div></td><td align="center" class="entry borderRight borderBottom" startcol="5" style="background-color:#c0c0c0;" valign="top"><div class="para" style="margin-left:0px;">10<sup class="superscript">[2]</sup></div></td><td align="center" class="entry borderRight borderBottom" startcol="6" style="background-color:#c0c0c0;" valign="top"><div class="para" style="margin-left:0px;">0<sup class="superscript">[2]</sup></div></td><td align="center" class="entry borderRight borderBottom" startcol="7" style="background-color:#c0c0c0;" valign="top"><div class="para" style="margin-left:0px;">0<sup class="superscript">[2]</sup></div></td><td align="center" class="entry borderBottom" startcol="8" style="background-color:#c0c0c0;" valign="top"><div class="para" style="margin-left:0px;">10<sup class="superscript">[2]</sup></div></td></tr><tr class=""><td align="left" class="entry borderRight borderBottom" colspan="2" startcol="1" style="background-color:#e2e2e2;" valign="top"><div class="para" style="margin-left:0px;"><b class="bold">Side yard, minimum</b></div><div class="para" style="margin-left:0px;"><b class="bold">(feet)</b></div></td><td align="center" class="entry borderRight borderBottom" startcol="3" style="background-color:#c0c0c0;" valign="top"><div class="para" style="margin-left:0px;">5</div></td><td align="center" class="entry borderRight borderBottom" startcol="4" style="background-color:#c0c0c0;" valign="top"><div class="para" style="margin-left:0px;">0<sup class="superscript">[3]</sup></div></td><td align="center" class="entry borderRight borderBottom" startcol="5" style="background-color:#c0c0c0;" valign="top"><div class="para" style="margin-left:0px;">0<sup class="superscript">[3]</sup></div></td><td align="center" class="entry borderRight borderBottom" startcol="6" style="background-color:#c0c0c0;" valign="top"><div class="para" style="margin-left:0px;">0</di