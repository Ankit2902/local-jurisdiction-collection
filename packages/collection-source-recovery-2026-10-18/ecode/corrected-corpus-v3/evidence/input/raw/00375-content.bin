2" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;">n/a</div></td><td align="center" class="entry" startcol="3" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;"></div></td></tr></tbody></table></div><div class="codeTable #333" style="border-color:#333"><table class=" frame frameNone" style="border-color:black; " tabstyle=""><colgroup><col style="width: 6%"></col><col style="width: 94%"></col></colgroup><thead valign="bottom"><tr class=""><th align="left" class="entry" colspan="2" scope="col" startcol="1" style="color:black;background-color:white;border-color:black;" valign="top"><div class="para" style="margin-left:0px;">NOTES:</div></th></tr></thead><tbody valign="top"><tr class=""><td align="left" class="entry" startcol="1" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;">[1]</div></td><td align="left" class="entry" startcol="2" style="border-color:black;" valign="top"><div class="para" style="margin-left:0px;">Where the subject lot is adjacent to developed lots facing the same street and having a principal building located within 25 feet of the lot line, the required front setback shall be no closer nor further back from the street than the structures on the adjacent lots.</div></td></tr></tbody></table></div><div class="footnotes"></div></div></div><div class="litem breakHere" id="33431119"><a alt="375-402(2)(g)(iii)" class="litem_number" href="33431119#33431119" onclick="return false;" title="375-402(2)(g)(iii)">(iii) </a><div class="litem_content content"><div class="para">Parking location.</div><div class="codeTable " style="border-color:"><table class=" frame frameNone"><colgroup><col style="width: 100%"></col></colgroup><tbody valign="top"><tr class=""><td align="center" class="entry" startcol="1" valign="top"><div class="para" style="margin-left:0px;"><span class="graphic"><a href="/attachment/336787/375-4 B2giii.tif.png" id="" target="_blank"><img clas