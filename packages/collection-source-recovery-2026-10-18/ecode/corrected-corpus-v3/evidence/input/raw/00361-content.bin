                <article>
                <header>
  <div data-component="h2"
       class="contentTitle barTitle sectionTitle 44813880"
      id="44813880"
      data-guid="44813880"
      data-position="8387"
      data-full-title="§ 359-139: Definitions."
      data-code-content-type="section"
  >
    <span class="selectionBox material-icons material-symbols-outlined material-symbols-and-filled md-24"
         title="Select this content"
         aria-label="Select this content"
    >
      <input type="checkbox" class="selectionBoxInput" id="44813880_input"/>
    </span>
    <label class="selectionLabel" id="44813880_label" for="44813880_input">
  <div class="titleLinkContainer">
    <a href="#44813880"
       class="titleLink"
    >
    <span class="titleNumber">
      § 359-139
    </span>
    <span class="titleTitle"
          data-guid="44813880"
    >
Definitions.    </span>
    </a>
  </div>
