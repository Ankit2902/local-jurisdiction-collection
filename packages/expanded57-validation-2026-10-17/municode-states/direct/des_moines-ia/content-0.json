{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":4,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"MUCO_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1. - Citation of Code.</div>","ShouldShowMiniToc":false,"Id":"MUCO_CH1GEPR_S1-1CICO","Title":"Sec. 1-1. - Citation of Code.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The ordinances embraced in this and the following chapters and sections shall constitute\n               and be designated as the \"Municipal Code of the City of Des Moines, Iowa,\" and may\n               be so cited. The Code may also be cited as \"Des Moines City Code, 2000.\"\n               </p>\n            <p class=\"historynote0\">\n               (C42, C54, C62, C75, C79, C85, § 1-1; O.11,549; C91, § 1-1)\n               </p>\n            <p class=\"refstatelaw0\" block_type=\"hang\"><b>State Law reference— </b>\n               Code of ordinances to be published, I.C. § 380.8.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"MUCO_CH1GEPR","Heading":"Chapter 1 - GENERAL PROVISIONS","NodeDepth":1,"HasChildren":true,"ParentId":"13242","DocOrderId":3,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"MUCO_CH1GEPR_S1-2DERUCO","Heading":"Sec. 1-2. - Definitions and rules of construction.","NodeDepth":2,"HasChildren":false,"ParentId":"MUCO_CH1GEPR","DocOrderId":5,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}