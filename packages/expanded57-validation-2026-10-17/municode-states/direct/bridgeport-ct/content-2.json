{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":221,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">1.01.030 - Reference applies to all amendments.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1.01COAD_1.01.030REAPALAM","Title":"1.01.030 - Reference applies to all amendments.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               Whenever a reference is made to this code as the \"Bridgeport Municipal Code\" or to\n               any portion thereof, or to any ordinance of the city codified herein, the reference\n               shall apply to all amendments, corrections and additions heretofore, now or hereafter\n               made.\n               </p>\n            <p class=\"historynote0\">\n               (§ 3 of ord. dated 3/18/96)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1.01COAD_1.01.020TIITEF","Heading":"1.01.020 - Title—Citation—Reference.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01COAD","DocOrderId":220,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1.01COAD_1.01.040TICHSEHE","Heading":"1.01.040 - Title, chapter and section headings.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01COAD","DocOrderId":222,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}