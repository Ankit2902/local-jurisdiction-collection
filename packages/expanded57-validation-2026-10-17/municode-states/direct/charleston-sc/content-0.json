{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":4,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"CICO_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1. - How Code designated and cited.</div>","ShouldShowMiniToc":false,"Id":"CICO_CH1GEPR_S1-1HOCODECI","Title":"Sec. 1-1. - How Code designated and cited.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The provisions in the following chapters and sections shall constitute and be designated\n               the \"Code of the City of Charleston, South Carolina,\" and may be so cited. Such Code\n               may also be cited as \"Charleston City Code.\"\n               </p>\n            <p class=\"historynote0\">\n               (Code 1975, § 1-1)\n               </p>\n            <p class=\"refstatelaw0\" block_type=\"hang\"><b>State Law reference— </b>\n               For requirement that city codify ordinances, see S.C. Code 1976, § 5-7-290.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"CICO_CH1GEPR","Heading":"Chapter 1 - GENERAL PROVISIONS","NodeDepth":1,"HasChildren":true,"ParentId":"10245","DocOrderId":3,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"CICO_CH1GEPR_S1-2DERUCOEN","Heading":"Sec. 1-2. - Definitions and rules of construction—Generally.","NodeDepth":2,"HasChildren":false,"ParentId":"CICO_CH1GEPR","DocOrderId":5,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}