{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":4,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COOR_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1. - How Code designated and cited.</div>","ShouldShowMiniToc":false,"Id":"COOR_CH1GEPR_S1-1HOCODECI","Title":"Sec. 1-1. - How Code designated and cited.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The ordinances embraced in the following chapters and sections shall constitute and\n               be designated \"The Little Rock City Code, Revised 1988\" and may be so cited. The Code\n               may also be cited as the \"Little Rock City Code\" or as the \"Little Rock Code.\"\n               </p>\n            <p class=\"historynote0\">\n               (Code 1961, § 1-1)\n               </p>\n            <p class=\"refstatelaw0\" block_type=\"hang\"><b>State Law reference— </b>\n               Authority to codify ordinances, A.C.A. § 14-55-701 et seq.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"COOR_CH1GEPR","Heading":"Chapter 1 - GENERAL PROVISIONS","NodeDepth":1,"HasChildren":true,"ParentId":"11170","DocOrderId":3,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"COOR_CH1GEPR_S1-2RUCO","Heading":"Sec. 1-2. - Rules of construction.","NodeDepth":2,"HasChildren":false,"ParentId":"COOR_CH1GEPR","DocOrderId":5,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}