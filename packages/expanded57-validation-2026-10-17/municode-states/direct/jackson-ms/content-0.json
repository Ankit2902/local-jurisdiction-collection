{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":5,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COOR_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1. - Designation and citation of Code.</div>","ShouldShowMiniToc":false,"Id":"COOR_CH1GEPR_S1-1DECICO","Title":"Sec. 1-1. - Designation and citation of Code.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The ordinances embraced in the following chapters and sections shall constitute and\n               be designated the \"Code of Ordinances, City of Jackson, Mississippi,\" and may be so\n               cited.\n               </p>\n            <p class=\"historynote0\">\n               (Code 1971, § 1-1)\n               </p>\n            <p class=\"refstatelaw0\" block_type=\"hang\"><b>State Law reference— </b>\n               Authority of municipality to codify ordinances, MCA 1972, § 21-13-15.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"COOR_CH1GEPR","Heading":"Chapter 1 - GENERAL PROVISIONS","NodeDepth":1,"HasChildren":true,"ParentId":"11036","DocOrderId":4,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"COOR_CH1GEPR_S1-2RUCODE","Heading":"Sec. 1-2. - Rules of construction and definitions.","NodeDepth":2,"HasChildren":false,"ParentId":"COOR_CH1GEPR","DocOrderId":6,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}