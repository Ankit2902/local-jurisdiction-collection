{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":2436,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"MUCO_CH98SOWA","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 98-146. - Schedule of rates.</div>","ShouldShowMiniToc":false,"Id":"MUCO_CH98SOWA_ARTIIIDIFA_S98-146SCRA","Title":"Sec. 98-146. - Schedule of rates.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               A schedule of the rates, fees, tolls, and other charges to be levied and collected\n               from city residents for the use and services of the solid waste disposal facilities\n               shall be established and put into effect whenever necessary in order for the city\n               to comply with the provisions of its solid waste disposal service contract; provided,\n               however, the city may in its discretion apply such other lawfully available moneys\n               it has on hand for such purpose.\n               </p>\n            <p class=\"historynote0\">\n               (C62, § 52B-2; O.8347; C75, C79, C91, § 16-121)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"MUCO_CH98SOWA_ARTIIIDIFA","Heading":"ARTICLE III. - DISPOSAL FACILITIES","NodeDepth":2,"HasChildren":true,"ParentId":"MUCO_CH98SOWA","DocOrderId":2435,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"MUCO_CHAPTERS_99--101RE","Heading":"Chapters 99—101 - RESERVED","NodeDepth":1,"HasChildren":false,"ParentId":"13242","DocOrderId":2437,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}