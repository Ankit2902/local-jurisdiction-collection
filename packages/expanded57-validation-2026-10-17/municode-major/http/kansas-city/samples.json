          "Id": "PTICHKAMI_ARTICONAPOBO_S101INNABO",
          "Title": "Sec. 101. - Incorporation, Name and Boundaries.",
          "Content": "<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The inhabitants of the City of Kansas City, within the corporate limits as now established\n               or as hereafter established in the manner then provided by law, shall continue to\n               be a municipal body politic and corporate in perpetuity under the name of the City\n               of Kansas City.\n               </p></div>",
          "SortDate": null,
          "Footnotes": null
        }
