{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":5,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PAI_HORUCH_ARTIINFOGO","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Section 1-101. - Incorporation.</div>","ShouldShowMiniToc":false,"Id":"PAI_HORUCH_ARTIINFOGO_S1-101IN","Title":"Section 1-101. - Incorporation.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The inhabitants of the City of New Orleans, within the boundaries now established\n               by law or as may hereafter be established, shall be and continue a body politic and\n               corporate by the name of \"City of New Orleans,\" hereinafter in this Charter called\n               \"City.\" By that name it shall have perpetual succession and enjoy all of the powers\n               hereinafter recited.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PAI_HORUCH_ARTIINFOGO","Heading":"ARTICLE I. - INCORPORATION AND FORM OF GOVERNMENT","NodeDepth":2,"HasChildren":true,"ParentId":"PAI_HORUCH","DocOrderId":4,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PAI_HORUCH_ARTIINFOGO_S1-102FOGO","Heading":"Section 1-102. - Form of Government.","NodeDepth":3,"HasChildren":false,"ParentId":"PAI_HORUCH_ARTIINFOGO","DocOrderId":6,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}