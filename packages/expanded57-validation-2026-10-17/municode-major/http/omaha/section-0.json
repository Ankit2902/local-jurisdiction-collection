{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":7,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PTICH","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Section 1.01. - Incorporation.</div>","ShouldShowMiniToc":false,"Id":"PTICH_ARTIINFOGOPOCOLI_S1.01IN","Title":"Section 1.01. - Incorporation.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The municipal corporation now existing as a metropolitan city and known as the \"City\n               of Omaha\" shall continue to be a body corporate and politic, and by that name shall\n               continue in perpetuity, with power to sue and be sued, to buy and sell real and personal\n               property, to contract, and to exercise all powers conferred by law on municipal corporations.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PTICH_ARTIINFOGOPOCOLI","Heading":"ARTICLE I. - INCORPORATION; FORM OF GOVERNMENT; POWERS OF THE CITY; CORPORATE LIMITS","NodeDepth":2,"HasChildren":true,"ParentId":"PTICH","DocOrderId":6,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PTICH_ARTIINFOGOPOCOLI_S1.02FOGO","Heading":"Section 1.02. - Form of Government.","NodeDepth":3,"HasChildren":false,"ParentId":"PTICH_ARTIINFOGOPOCOLI","DocOrderId":8,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}