          "ShouldShowMiniToc": false,
          "Id": "PTICH_ARTIINFOGOPOCOLI_S1.02FOGO",
          "Title": "Section 1.02. - Form of Government.",
          "Content": "<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The municipal government established by this charter shall be known as the Mayor-Council\n               form of government, and its essential components shall be an elected chief executive\n               to be known as the Mayor and an elected legislative body to be known as the Council.\n               \n               <p class=\"refmanual0\" block_type=\"hang\">\n                  <span class=\"bold\">Code references\u2014</span>Council, <a href=\"\" data-chunk-id=\"PTIIMUCO_CH2AD_ARTIICO_DIV1GE_S2-21COCO\" class=\"section-link\" data-product-id=\"10945\">\u00a7 2-21</a> et seq.; mayor, <a href=\"\" data-chunk-id=\"PTIIMUCO_CH2AD_ARTIVOF_DIV2MA_S2-71CO\" class=\"section-link\" data-product-id=\"10945\">\u00a7 2-71</a> et seq.\n                  </p>\n               </div>",
          "SortDate": null,
          "Footnotes": null
        }
