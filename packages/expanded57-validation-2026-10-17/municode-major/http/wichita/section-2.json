{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":251,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 1.04.023. - Criminal intent.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1.04INEN_S1.04.023CRIN","Title":"Sec. 1.04.023. - Criminal intent.","Content":"<div class=\"chunk-content\">\n            <p class=\"incr0\">\n               (a)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               A person commits a crime only if such person voluntarily engages in conduct, including\n               an act, an omission or possession.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (b)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               A person who omits to perform an act does not commit a crime unless a law provides\n               that that the omission is an offense or otherwise provides that such person has a\n               duty to perform the act.\n               </p>\n            \t\t\n            <p class=\"historynote0\">\n               (Ord. No. 49-254 § 1, 4-10-12)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1.04INEN_S1.04.020DERUCO","Heading":"Sec. 1.04.020. - Definitions and rules of construction.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.04INEN","DocOrderId":250,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1.04INEN_S1.04.025CU","Heading":"Sec. 1.04.025. - Culpability.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.04INEN","DocOrderId":252,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}