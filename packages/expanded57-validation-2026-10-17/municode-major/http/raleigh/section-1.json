{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":6,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"DIVICH_ARTIINGE","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 1.2 - INCORPORATION.</div>","ShouldShowMiniToc":false,"Id":"DIVICH_ARTIINGE_S1.2IN","Title":"Sec. 1.2 - INCORPORATION.","Content":"<div class=\"chunk-content\">\n            <p class=\"b0\">\n               The inhabitants of the City of Raleigh, within the corporate limits as now established\n               or as hereafter established by statute or otherwise as provided by law, shall be and\n               continue, as they have heretofore been, a municipal body politic and corporate, under\n               the name of \"The City of Raleigh,\" and under such name shall have perpetual succession.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"DIVICH_ARTIINGE_S1.1SHTI","Heading":"Sec. 1.1 - SHORT TITLE.","NodeDepth":3,"HasChildren":false,"ParentId":"DIVICH_ARTIINGE","DocOrderId":5,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"DIVICH_ARTIINGE_S1.3COLI","Heading":"Sec. 1.3 - CORPORATE LIMITS.","NodeDepth":3,"HasChildren":false,"ParentId":"DIVICH_ARTIINGE","DocOrderId":7,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}