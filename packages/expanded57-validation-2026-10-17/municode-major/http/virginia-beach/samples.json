          "TitleHtml": "<div class=\"chunk-title\">Sec. 1.02. - Boundaries.</div>",
          "ShouldShowMiniToc": false,
          "Id": "CH_CH1INBO_S1.02BO",
          "Title": "Sec. 1.02. - Boundaries.",
          "Content": "<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The boundaries of the City of Virginia Beach shall coincide with the outside boundaries\n               of Princess Anne County so as to include all of the territory comprising Princess\n               Anne County and the City of Virginia Beach as existing immediately preceding the effective\n               date of this Charter.\n               </p></div>",
          "SortDate": null,
          "Footnotes": null
        }
