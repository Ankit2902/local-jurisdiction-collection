{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":8,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PTICHRELA_SPACH_ART1NAPOBO","NodeDepth":4,"TitleHtml":"<div class=\"chunk-title\">Section 1-103. - Legislative powers.</div>","ShouldShowMiniToc":false,"Id":"PTICHRELA_SPACH_ART1NAPOBO_S1-103LEPO","Title":"Section 1-103. - Legislative powers.","Content":"<div class=\"chunk-content\">\n            <p class=\"incr0\">\n               (a)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               All legislative powers of the city are hereby vested in the council (hereinafter at\n               times referred to as the \"governing body\"), except those powers specifically reserved\n               in this Charter to the electors of the city. The power to levy, assess, and provide\n               for the collection of all taxes and fees authorized to be levied, assessed, and collected\n               by the city by general law and this Charter shall be vested in the council.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (b)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               The council shall adopt and provide for the execution of such ordinances, resolutions\n               and rules, not inconsistent with this Charter as shall be necessary or proper for\n               the purpose of carrying into effect the powers and duties conferred by this Charter\n               and may enforce all ordinances by imposing penalties and fines for the violation thereof\n               not to exceed a $1000 fine or six months' imprisonment, or both.\n               </p>\n            \t\t\n            <p class=\"historynote0\">\n               (1996 Ga. L. (Act No. 1019), p. 4469)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PTICHRELA_SPACH_ART1NAPOBO_S1-102PO","Heading":"Section 1-102. - Powers.","NodeDepth":4,"HasChildren":false,"ParentId":"PTICHRELA_SPACH_ART1NAPOBO","DocOrderId":7,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PTICHRELA_SPACH_ART1NAPOBO_S1-104EXPO","Heading":"Section 1-104. - Executive powers.","NodeDepth":4,"HasChildren":false,"ParentId":"PTICHRELA_SPACH_ART1NAPOBO","DocOrderId":9,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}