ntrol date-input"\n           ng-model-options="{updateOn: \'blur\' }" \n           ng-keyup="vm.keydown($event)" \n           format="MM/DD/YYYY" \n           ui-mask="99/99/9999" \n           start-view="day" \n           moment-picker \n           ng-model="ngModel" \n           type="text" \n           placeholder="MM/DD/YYYY" \n           change="vm.change(oldValue, newValue)" \n           max-date="maxDate" \n           min-date="minDate"\n           spellcheck="false" \n           \n    />\n</div>'),e.put("/library/ng-apps/library_desktop/cp-sign-in-directive.cshtml",'<div xmlns="http://www.w3.org/1999/html">\n    <div ng-if="signIn_vm.layout==\'dropdown\'">\n        <button ng-if="!$root.mccUserSvc.getUser() && $root.userIsIpBasedEzProxyCustomer === false" class="btn btn-flat" ng-click="signIn_vm.signIn()" title="Sign in" aria-label="Sign in" bootstrap-tooltip data-trigger="hover" ng-attr-data-placement="{{$root.viewportHelper.isMobile() ? \'left\': \'bottom\'}}">\n            <i class="fa fa-sign-in fa-fw"></i> <span class="visible-lg-inline visible-xl-inline">Sign In</span>\n        </button>\n        <div ng-if="$root.mccUserSvc.getUser() && $root.userIsIpBasedEzProxyCustomer === false" class="dropdown">\n            <button class="btn btn-flat dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Account menu" title="Account menu" bootstrap-tooltip data-trigger="hover" ng-attr-data-placement="{{$root.viewportHelper.isMobile() ? \'left\': \'bottom\'}}" data-container="body">\n                <i class="fa fa-user fa-fw"></i>\n                <span class="caret"></span>\n            </button>\n            <ul class="dropdown-menu dropdown-menu-right">\n                <li>\n                    <a href="" ng-href="{{signIn_vm.adminUrl}}" target="_self"> View Dashboard</a>\n                </li>\n                <li>\n                    <a href="" ng-href="{{signIn_vm.manageAccount}}" target="_blank"> Manage Account</a>\n                </li>\n                <li>\n                    <a href="{{signIn_vm.bffLogoutUrl}}" target="_self"> Sign Out</a>\n                </li>\n            </ul>\n        </div>\n    </div>\n    <div ng-if="signIn_vm.layout != \'dropdown\'">\n        <button type="button" class="dropdown-child button-unstyled btn-block" ng-if="!$root.mccUserSvc.getUser() && $root.userIsIpBasedEzProxyCustomer === false" ng-click="signIn_vm.signIn()" aria-label="Sign in" title="Sign in">\n            <i class="fa fa-sign-in fa-fw"></i> Sign In\n        </button>\n        <div ng-if="$root.mccUserSvc.getUser() && $root.userIsIpBasedEzProxyCustomer === false">\n            <li>\n                <a class="dropdown-child" href="" ng-href="{{signIn_vm.adminUrl}}" target="_self"> View Dashboard</a>\n            </li>\n            <li>\n                <a class="dropdown-child" href="" ng-href="{{signIn_vm.manageAccount}}" target="_blank"> Manage Account</a>\n            </li>\n            <li>\n                <a class="dropdown-child" href="{{signIn_vm.bffLogoutUrl}}" target="_self"> Sign Out</a>\n            </li>\n        </div>\n    </div>\n</div>'),e.put("/library/ng-apps/library_desktop/library_desktop.cshtml",'<span id="initialFocus" tabindex="-1" class="visually-hidden">{{$root.title}}</span>\n<header id="header" class="hidden-xs hidden-sm" ng-style="$root.headerTheme">\n    <span ng-if="$root.headerTheme && $root.mccStateParams.client" role="img" aria-labelledby="clientDisplayName"></span>\n    <div class="container-fluid">\n        <div class="headerbar row">\n            \x3c!-- Brand and toggle get grouped for better mobile display --\x3e\n            <div class="headerbar-left col-xs-9 col-md-4 col-lg-4 col-xl-4">\n                <mcc-skip-to-main-content-links></mcc-skip-to-main-content-links>\n                <div ng-if="!$root.mccStateParams.client || searchSvc.isInMuniproModeAndOnSearchPage()">\n                    <div style="padding: 8px 24px;">\n                        <a href="/">\n                            <img src="dist/img/cp-municode-codification-logo.svg" alt="CivicPlus Municode Codification logo">\n                            <h1 class="visually-hidden no-margin text-xl text-nowrap">Municode Codification Search</h1>\n                        </a>\n                    </div>\n                </div>\n                <div ng-if="$root.mccStateParams.client && searchSvc.isInMuniproModeAndOnSearchPage() === false">\n                    <div ng-if="!$root.headerTheme">\n                        <div style="padding: 8px 24px">\n                            <div style="height: 54px; padding: 4px;">\n                                <h1 class="cp-font cp-font-header text-truncate m-0" style="padding-bottom:8px;">{{$root.mccStateParams.client.ClientName + \', \' + $root.mccStateParams.state.StateAbbreviation}}</h1>\n                                <img src="dist/img/cp-municode-codification-logo-simple.svg" style="display:block;" alt="CivicPlus Municode Codification logo - simple"/>\n                            </div>\n                        </div>\n                    </div>\n                    <div ng-if="$root.headerTheme">\n                        <h1 id="clientDisplayName" class="visually-hidden no-margin text-xl text-nowrap">{{$root.mccStateParams.client.ClientName + \', \' + $root.mccStateParams.state.StateAbbreviation}}</h1>\n                    </div>\n                </div>\n            </div>\n            <div class="headerbar-center hidden-xs hidden-sm col-md-3 col-lg-3 col-xl-3 no-padding" id="mcc_top_center_search_box">\n                <div class="">\n                    <ul class="header-nav" style="width: 100% !important;">\n                        <li>\n                            \x3c!-- Search form --\x3e\n                            <div ui-view="headerSearch" style="width: 100%;"></div>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            \x3c!-- Collect the nav links, forms, and other content for toggling --\x3e\n            <div class="col-md-5 col-lg-5 col-xl-5 no-padding" style="right: 8px;">\n                <div class="pull-right">\n                    <div ui-view="headerRight" class="pull-left"></div>\n                    <ul class="header-nav header-nav-options pull-right">\n                        <li>\n                            <mcc-sign-in></mcc-sign-in>\n                        </li>\n                        <li class="no-padding" ng-if="$root.userHasMuniproSearchAccess && !$root.mccStateParams.client">\n                            <a ui-sref="search({ searchMode: \'MUNIPROMODE\' })"\n                               class="btn btn-flat"\n                               bootstrap-tooltip\n                               data-trigger="hover"\n                               title="Go to the MuniPro search"\n                               data-placement="bottom"\n                               data-container="body"\n                               aria-label="Go to MuniPro search">\n                                <i class="md md-search"></i> <span class="visible-lg-inline visible-xl-inline">MuniPro Search</span>\n                            </a>\n                        </li>\n                        \x3c!-- Help Dropdown --\x3e\n                        <li class="no-padding">\n                            <div class="dropdown">\n                                <button class="btn btn-flat dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Help menu" title="Help menu" bootstrap-tooltip data-trigger="hover" data-placement="bottom">\n                                    <i class="md md-help"></i>\n                                    <span class="visible-lg-inline visible-xl-inline">Help</span>\n                                    <span class="caret"></span>\n                                </button>\n                                <ul class="dropdown-menu dropdown-menu-right">\n                                    \x3c!-- Visit Help Center link --\x3e\n                                    <li>\n                                        <a ng-href="{{::$root.app.supportUrl}}" target="_blank">\n                                            <i class="fa fa-life-ring fa-fw"></i>\n                                            Visit Help Center\n                                        </a>\n                                    </li>\n                                    \x3c!-- Submit Feedback link --\x3e\n                                    <li>\n                                        <a href="{{::$root.app.submitFeedbackUrl}}" target="_blank">\n                                            <i class="fa fa-lightbulb-o fa-fw"></i>\n                                            Submit Feedback\n                                        </a>\n                                    </li>\n                                </ul>\n                            </div>\n                        </li>\n                        <li style="padding-left: 10px;">\n                            <div id="google_translate_element"></div>\n                            <script type="text/javascript">\n                                function googleTranslateElementInit() {\n                                    new google.translate.TranslateElement({\n                                        pageLanguage: \'en\', \n                                        layout: google.translate.TranslateElement.InlineLayout.VERTICAL, \n                                        gaTrack: true, \n                                        gaId: \'UA-2542375-1\'}, \n                                        \'google_translate_element\');\n                                    \n                                    // Remove Google Translate "rate this translation" element\n                                    const googleTranslateRateThisTranslation = document.getElementById(\'goog-gt-tt\');\n                                    if (googleTranslateRateThisTranslation) {\n                                        googleTranslateRateThisTranslation.remove();\n                                    }\n                                }\n                            <\/script>\n                            <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit">\n                            <\/script>\n                        </li>\n                    </ul>\x3c!--end .header-nav-options --\x3e\n                </div>\n\n            </div>\x3c!--end #header-navbar-collapse --\x3e\n        </div>\n    </div>\n</header>\n<div id="menubar" class="menubar-inverse" ng-class="{\'show\': $root.zoneMgrSvc.isTocZoneVisibleOnMobile}">\n    <div class="menubar-scroll-panel">\n        <ui-view name="mainMenu"></ui-view>\n    </div>\n    <div class="menubar-foot-panel">\n        <div class="hidden-folded no-linebreak text-sm text-center">\n            <img src="dist/img/muniball-36.png" style="width:25px; height: 25px;" alt="CivicPlus logo"> <span class="opacity-75">Copyright &copy; {{::$root.app.currentYear}}</span>    \n        </div>\n    </div>\n</div>\n<div ng-cloak ng-controller="globalMessageController" ng-show="::showGlobalMessage" class="text-center" style="position:fixed; bottom:0; left:0; right:0; z-index: 2000;">\n    <div id="globalMessageWrapper" class="alert alert-info fade in" style="border-radius:0; margin:0; background-color:whitesmoke;border: 2px solid #096fcc">\n        <div id="globalMessage" ng-bind-html="::globalMessageHtml"></div>\n        <button type="button" class="btn btn-default" data-dismiss="alert">\n            <span>Close</span>\n        </button>\n    </div>\n</div>\n\n<div id="base">\n    <div id="offCanvasLeft" class="offcanvas"></div>\n    <div id="content" class="loading-aware" ng-class="{\'loading\': $root.app.stateChanging}">\n        <ui-view class="">\n            <div style="position: absolute; left: 50%; top: 24px;">\n                <div style="transform: translate(-50%, 0); text-align: center;">\n                    <p>\n                        <img style="width: 60px;" src="dist/img/muniball-36.png" alt="CivicPlus logo"/>\n                    </p>\n                    <div role="status">\n                        <p ng-show="!$root.app.stateChangeError">\n                            Initializing application...\n                            <span>\n                                <i class="fa fa-2x fa-circle-o-notch fa-spin" aria-hidden="true"></i>\n                            </span>\n                        </p>\n                        <div ng-show="$root.app.stateChangeError" class="alert alert-info">\n                            <p>The requested content cannot be found or you are not authorized to view it.</p>\n                            <p class="text-center">\n                                <a href="/" class="alert-link">Browse the Municode Library</a>\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </ui-view>\n        <div role="status">\n            <div style="position: absolute; left: 50%;" ng-if="$root.app.stateChanging">\n                <span style="transform: translate(-50%, 0)">\n                    <span class="visually-hidden">Loading, please wait.</span>\n                    <i class="fa fa-4x fa-circle-o-notch fa-spin" aria-hidden="true"></i>\n                </span>\n            </div>\n            <div ng-if="!$root.app.stateChanging">\n                <span class="visually-hidden">Loading complete</span>\n            </div>\n        </div>\n    </div>\n    \x3c!-- BEGIN OFFCANVAS RIGHT --\x3e\n    <div id="offCanvasRight" class="offcanvas">\n\n    </div>\n</div>\n\n<div class="modal pdf-download-modal in" role="dialog" aria-modal="true" aria-labelledby="pdfDownloadTitle" tabindex="-1">\n    <div class="modal-dialog">\n        <div class="modal-content">\n            <div class="modal-header">\n                <h2 class="modal-title">\n                    <i class="fa fa-file-text-o"></i> <span id="pdfDownloadTitle">Download Publication PDF</span>\n                </h2>\n                <button type="button" class="btn btn-icon-toggle btn-default" data-dismiss="modal" aria-label="Close">\n                    <i class="md md-close"></i>\n                </button>\n            </div>\n            <div class="modal-body">\n                <div>\n                    <div class="pdf-download-container">\n                        This PDF reflects this publication as of the date shown on the document. It is not an official copy and may not include recent electronic updates.\n                    </div>\n                </div>\n            </div>\n            <div class="modal-footer">\n                <button type="button" ng-click="$rootScope.getPublicationPdf()" data-ng-class="isPreparingPdfDownload ? \'btn disabled btn-raised\' : \'btn btn-primary btn-raised get-pdf-download-btn\'"><i class="fa fa-download" data-ng-class="isPreparingPdfDownload ? \'fa-spin fa-circle-o-notch\' : \'fa-download\'"></i> DOWNLOAD PDF</button>\n                <button type="button" data-dismiss="modal" class="btn btn-cancel btn-flat"><i class="fa fa-close"></i> CANCEL</button>\n            </div>\n        </div>\n    </div>\n</div>\n'),e.put("/library/ng-apps/library_desktop/sign_in-directive.cshtml",'<div>\n    <div ng-if="signIn_vm.layout==\'dropdown\'">\n        <button type="button" ng-if="!$root.mccUserSvc.getUser()" class="btn btn-flat" ng-click="signIn_vm.signIn()" title="Sign in" aria-label="Sign in" bootstrap-tooltip data-trigger="hover" ng-attr-data-placement="{{$root.viewportHelper.isMobile() ? \'left\': \'bottom\'}}">\n            <i class="fa fa-sign-in fa-fw"></i> <span class="visible-lg-inline visible-xl-inline">Sign In</span>\n        </button>\n        <div ng-if="$root.mccUserSvc.getUser()" class="dropdown">\n            <button class="btn btn-flat dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Account menu" title="Account menu" bootstrap-tooltip data-trigger="hover" ng-attr-data-placement="{{$root.viewportHelper.isMobile() ? \'left\': \'bottom\'}}" data-container="body">\n                <i class="fa fa-user fa-fw"></i> <span class="caret"></span>\n            </button>\n            <ul class="dropdown-menu dropdown-menu-right">\n                <li>\n                    <a href="" ng-href="{{signIn_vm.adminUrl}}" target="_self"><i class="fa fa-rocket"></i> View Dashboard</a>\n                </li>\n                <li>\n                    <button type="button" ng-click="signIn_vm.logOff()" class="button-unstyled btn-block"><i class="fa fa-sign-out"></i> Sign Out</button>\n                </li>\n            </ul>\n        </div>\n    </div>\n    <div ng-if="signIn_vm.layout != \'dropdown\'">\n        <button type="button" class="button-unstyled dropdown-child btn-block" ng-if="!$root.mccUserSvc.getUser()" ng-click="signIn_vm.signIn()" aria-label="Sign In"><i class="fa fa-sign-in fa-fw"></i> Sign In</button>\n        <div ng-if="$root.mccUserSvc.getUser()">\n            <a class="dropdown-child" href="" ng-href="{{signIn_vm.adminUrl}}" target="_self"><i class="fa fa-rocket fa-fw"></i> View Dashboard</a>\n            <button type="button" class="button-unstyled dropdown-child btn-block" ng-click="signIn_vm.logOff()"><i class="fa fa-sign-out fa-fw"></i> Sign Out</button>\n        </div>\n    </div>\n</div>\n\n    \n    '),e.put("/library/ng-apps/common/components/off_canvas.cshtml",'<style>\n    mcc-off-canvas {\n        display:none;\n    }\n    \n    .offcanvas-pane:focus {\n        outline: none;\n    }\n</style>\n\n<div\n    class="offcanvas-pane"\n    role="dialog"\n    aria-labelledby="dialogTitle-{{vm.name}}"\n    tabindex="-1">\n    <section style="position:unset; padding: unset;">\n        <div class="offcanvas-head">\n            <div tabindex="0"\n                 ng-if="vm.isModal && vm.enabled"\n                 data-exclude-from-tabbables="true"\n                 ng-focus="vm.fastForwardFocus($event)"\n                 style="outline:none !important;position:absolute">\n                &nbsp;\n            </div>\n            <header>\n                <h2 mcc-focus-when="vm.enabled"\n                    tabindex="-1"\n                    style="outline:none;">\n                    <span ng-if="!vm.enabled">loading title...</span>\n                    <span ng-if="vm.iconClass" class="{{ vm.iconClass }}"></span>\n                    <span id="dialogTitle-{{vm.name}}">{{ vm.headerTitle }}</span>\n                </h2>\n            </header>\n            <div class="offcanvas-tools">\n                <button type="button" class="btn btn-icon-toggle btn-default pull-right" data-close>\n                    <span class="md md-close"></span>\n                    <span class="visually-hidden">Close</span>\n                </button>\n            </div>\n        </div>\n        <div ng-if="vm.enabled" class="offcanvas-body absolute-full" ng-class="{\'scrollable\': vm.scrollable}" ng-transclude>\n        </div>\n        <div tabindex="0"\n             ng-if="vm.isModal && vm.enabled"\n             data-exclude-from-tabbables="true"\n             ng-focus="vm.fastForwardFocus($event)"\n             aria-hidden="true"\n             style="outline:none !important;position:absolute">\n            &nbsp;\n        </div>\n    </section>\n</div>'),e.put("/library/ng-apps/common/components/popover.cshtml",'<style>\n    mcc-popover{\n        display:block;\n    }\n</style>\n<div class="popover-body">\n    <div ng-transclude ng-if="vm.enabled"></div>\n</div>\n'),e.put("/library/ng-apps/common/components/search_pager.cshtml",'<nav class="mcc-search-pager" style="text-align:center;" aria-label="Pagination navigation">\n    <ul class="pagination pagination-lg">\n        <li data-ng-if="vm.showFirst()">\n            <button type="button" data-ng-click="vm.firstClick()">\n                &laquo;&laquo;\n                <span class="visually-hidden">Go to first page</span>\n            </button>\n        </li>\n        <li data-ng-if="vm.showPrev()">\n            <button type="button" data-ng-click="vm.prevClick()">\n                &laquo;\n                <span class="visually-hidden">Go to previous page</span>\n            </button>\n        </li>\n        <li data-ng-repeat="pageNum in vm.getPageArray()" data-ng-class="{active: pageNum == vm.getCurrentPage()}">\n            <button type="button" ng-click="vm.pageNumClick(pageNum)" aria-label="Go to page {{pageNum}}">\n                <span class="visually-hidden">Go to page </span><span data-ng-bind="::pageNum"></span>\n            </button>\n        </li>\n        <li data-ng-if="vm.showNext()">\n            <button type="button" data-ng-click="vm.nextClick()">\n                &raquo;\n                <span class="visually-hidden">Go to next page</span>\n            </button>\n        </li>\n        <li data-ng-if="vm.showLast()">\n            <button type="button" data-ng-click="vm.lastClick()">\n                &raquo;&raquo;\n                <span class="visually-hidden">Go to last page</span>\n            </button>\n        </li>\n    </ul>\n</nav>\n'),e.put("/library/ng-apps/common/components/skip_to_main_content_links.cshtml",'<div id="skipToContentLinks" tabindex="-1" class="position-absolute">\n    <a ng-if="$stateParams.contentTypeId == \'codes\' &&!!$stateParams.nodeId && (!!vm.getHeading($stateParams.nodeId)) && !!vm.getTitle()"\n       class="visually-hidden-focusable btn btn-default-light"\n       ng-href="#_{{$stateParams.nodeId}}" \n        ng-click="vm.onSkipToSpecificContent()">Skip to {{vm.getTitle()}}</a>\n    <a  href="#main-content" \n        class="visually-hidden-focusable btn btn-default-light" \n        ng-click="vm.onSkipToMainContentClick()">Skip to main content</a>\n</div>'),e.put("/library/ng-apps/library_desktop/client/client_header_right.cshtml",'<ul class="header-nav">\n    <li>\n        <button type="button" class="btn btn-flat chardin_extend_width" ng-click="vm.notifyClick()" bootstrap-tooltip data-trigger="hover"  title="Sign up to get email notifications when publications update online" data-placement="bottom" data-container="body" aria-label="Sign up to get email notifications when publications update online">\n            <i class="fa fa-envelope"></i> <span class="visible-lg-inline visible-xl-inline" data-intro="Sign up to receive email notifications when a publication is updated." data-position="left">Notifications</span>\n        </button>\n    </li>\n</ul>\n\n<mcc-off-canvas class="col-xs-12 col-sm-9 col-md-8 col-lg-7" \n                name="getNotified" \n                header-title="\'Get Notified\'" \n                icon-class="fa fa-envelope-o">\n    <mcc-client-notify style="display: block; height: 100%;"></mcc-client-notify>\n</mcc-off-canvas>'),e.put("/library/ng-apps/library_desktop/client/client_menu.cshtml",'\n<nav aria-label="{{::model.client.ClientName}}">\n    <ul id="main-menu" class="gui-controls" data-intro="Use the topmost control to expand and collapse the menu.  Navigate between Codes, ordinances, and documents, or view to the Municipalities website or go back to the Municode Library start page." data-position="right">\n        <li>\n            <button id="nav-toggle" aria-expanded="false" type="button" class="button-unstyled menu-button" data-toggle="menubar" style="border-bottom: 1px solid #ccc;" aria-label="Toggle navigation menu">\n                <div class="gui-icon">\n                    <span class="menubar-toggle-icon fa fa-fw fa-caret-right"></span>\n                </div>\n            </button>\n        </li>\n        <li ng-if="::model.clientContent" \n            ng-class="{\'client-menu-active-selection\': model.currentSelection == \'home\'}">\n            <a ng-href="{{::model.getHomeHref()}}" aria-label="Home">\n                <div class="gui-icon">\n                    <span class="fa fa-home"></span>\n                </div>\n                <span class="title">Home</span>\n            </a>\n        </li>\n        <li ng-if="::model.clientContent" \n            ng-class="{\'gui-folder\': model.clientContent.codes.length > 1 , \'client-menu-active-selection\':model.currentSelection == \'codes\', \'expanded\': model.showAllFolderContents, \'disabled\': !model.hasCodes}"\n            id="client-menu-codes-option">\n            <button aria-label="This municipality has no online codes" type="button" class="button-unstyled menu-button" ng-if="::model.hasCodes == false" ng-click="model.noCodesClick()" data-bootstrap-tooltip="" data-trigger="hover" data-placement="right" title="This municipality has no online codes">\n                <div class="gui-icon">\n                    <span class="fa fa-book"></span>\n                </div>\n                <span class="title">Codes</span>\n            </button>\n            <a aria-label="Browse codes" ng-if="::model.clientContent.codes.length === 1" ng-href="{{::model.getCodeHref(model.clientContent.codes[0])}}" data-bootstrap-tooltip="" data-trigger="hover" data-placement="right" data-container="body" title="Browse codes">\n                <div class="gui-icon">\n                    <span class="fa fa-book"></span>\n                </div>\n                <span class="title">Codes</span>\n            </a>\n            <button aria-label="Browse codes" aria-expanded="false" type="button" class="menu-button button-unstyled" ng-if="::model.clientContent.codes.length > 1" data-bootstrap-tooltip="" data-trigger="hover" data-placement="right" data-container="body" title="Browse codes">\n                <div class="gui-icon">\n                    <span class="fa fa-book"></span>\n                </div>\n                <span class="title">Codes</span>\n            </button>\n            <ul ng-if="::model.clientContent.codes.length > 1">\n                <li ng-repeat="code in ::model.clientContent.codes" ng-class="{\'client-menu-active-sub-selection\': model.currentProductName == code.productName && model.currentSelection == \'codes\'}">\n                    <a ng-href="{{::model.getCodeHref(code)}}" aria-label="{{::code.productName}}">\n                        <span class="title">{{::code.productName}}</span>\n                    </a>\n                </li>\n            </ul>\n        </li>\n        <li ng-if="::model.clientContent" \n            ng-class="{\'gui-folder\': model.clientContent.codes.length > 1, \'client-menu-active-selection\':model.currentSelection == \'ordinances\', \'expanded\': model.showAllFolderContents, \'disabled\': !model.clientContent.features[1].enabled }"\n            id="client-menu-ordinances-option">\n            <button aria-label="This municipality does not host ordinances online"\n                    type="button" class="button-unstyled menu-button" ng-if="::!model.clientContent.features[1].enabled" ng-click="model.noOrdinancesClick()" \n                    data-bootstrap-tooltip="" data-trigger="hover" data-placement="right" data-container="body" title="This municipality does not host ordinances online">\n                <div class="gui-icon">\n                    <span class="fa fa-gavel"></span>\n                </div>\n                <span class="title">Ordinances</span>\n            </button>\n            <a aria-label="Browse individual ordinances"\n               ng-if="::model.clientContent.features[1].enabled && model.clientContent.codes.length === 1" ng-href="{{::model.getOrdinancesHref(model.clientContent.codes[0])}}"\n               data-bootstrap-tooltip="" data-trigger="hover" data-placement="right" data-container="body" title="Browse individual ordinances">\n                <div class="gui-icon">\n                    <span class="fa fa-gavel"></span>\n                </div>\n                <span class="title">Ordinances</span>\n            </a>\n            <button aria-label="Browse individual ordinances" aria-expanded="false" type="button" class="menu-button button-unstyled" ng-if="::model.clientContent.features[1].enabled && model.clientContent.codes.length > 1"\n                    data-bootstrap-tooltip="" data-trigger="hover" data-placement="right" data-container="body" title="Browse individual ordinances">\n                <div class="gui-icon">\n                    <span class="fa fa-gavel"></span>\n                </div>\n                <span class="title">Ordinances</span>\n            </button>\n            <ul ng-if="::model.clientContent.features[1].enabled && model.clientContent.codes.length > 1">\n                <li ng-repeat="code in ::model.clientContent.codes" ng-class="{\'client-menu-active-sub-selection\': model.currentProductName == code.productName && model.currentSelection == \'ordinances\'}">\n                    <a ng-href="{{::model.getOrdinancesHref(code)}}" aria-label="{{::code.productName}}">\n                        <span class="title">{{::code.productName}}</span>\n                    </a>\n                </li>\n            </ul>\n        </li>\n        <li ng-if="::model.clientContent" \n            ng-class="{\'gui-folder\': model.clientContent.munidocs.length > 1,\'client-menu-active-selection\':model.currentSelection == \'munidocs\', \'expanded\': model.showAllFolderContents, \'disabled\': !model.hasMunidocs}"\n            id="client-menu-munidocs-option">\n            <button aria-label="This organization does not use MuniDocs to host documents"\n                    type="button" class="button-unstyled menu-button" ng-if="::model.hasMunidocs == false" ng-click="model.noMunidocsClick()"\n                    data-bootstrap-tooltip=""\n                    data-trigger="hover"\n                    data-placement="right" data-container="body"\n                    title="This organization does not use MuniDocs to host documents">\n                <div class="gui-icon">\n                    <span class="fa fa-file-text-o"></span>\n                </div>\n                <span class="title">Documents</span>\n            </button>\n            <a aria-label="Browse additional online documents"\n               ng-if="::model.clientContent.munidocs.length === 1"\n               ng-href="{{::model.getMunidocsHref(model.clientContent.munidocs[0])}}"\n               data-bootstrap-tooltip=""\n               data-trigger="hover"\n               data-placement="right"\n               data-container="body"\n               title="Browse additional online documents">\n                <div class="gui-icon">\n                    <span class="fa fa-file-text-o"></span>\n                </div>\n                <span class="title">Documents</span>\n            </a>\n            <button aria-label="Browse additional online documents"\n                    aria-expanded="false"\n                    type="button"\n                    class="menu-button button-unstyled"\n                    ng-if="::model.clientContent.munidocs.length > 1"\n                    data-bootstrap-tooltip=""\n                    data-trigger="hover"\n                    data-placement="right"\n                    data-container="body"\n                    title="Browse additional online documents">\n                <div class="gui-icon">\n                    <span class="fa fa-file-text-o"></span>\n                </div>\n                <span class="title">Documents</span>\n            </button>\n            <ul ng-if="::model.clientContent.munidocs.length > 1">\n                <li ng-repeat="munidoc in ::model.clientContent.munidocs" ng-class="{\'client-menu-active-sub-selection\': model.currentProductName == munidoc.productName && model.currentSelection == \'munidocs\'}">\n                    <a ng-href="{{::model.getMunidocsHref(munidoc)}}" aria-label="{{::munidoc.productName}}">\n                        <span class="title">{{::munidoc.productName}}</span>\n                    </a>\n                </li>\n            </ul>\n        </li>\n        <li ng-if="::model.clientContent" \n            ng-class="{\'gui-folder\': model.showPdfDownloadList() , \'client-menu-active-selection\': model.currentSelection == \'downloads\', \'expanded\': model.showAllFolderContents, \'disabled\': model.publicationsWithPdfFeatureEnabled.length === 0}"\n            id="client-menu-download-option">\n            <button aria-label="Downloadable PDF copies are not available for this municipality" type="button" class="button-unstyled menu-button" ng-if="model.showDisabledPdfDownloadButton()" ng-click="::model.noPdfsClick()"\n                    data-bootstrap-tooltip="" data-trigger="hover" data-placement="right" data-container="body" title="Downloadable PDF copies are not available for this municipality">\n                <div class="gui-icon">\n                    <span class="fa fa-download"></span>\n                </div>\n                <span class="title">Downloads</span>\n            </button>\n            <button aria-label="Download publication PDF" type="button" ng-if="model.showSinglePdfDownloadButton()" class="button-unstyled menu-button btn-pdf-download" ng-click="model.openPdfDownloadModal(model.publicationsWithEnabledPdfs[0])" data-bootstrap-tooltip="" data-trigger="hover" data-placement="right" data-container="body" title="Download publication PDF">\n                <div class="gui-icon">\n                    <span class="fa fa-download"></span>\n                </div>\n                <span class="title">Downloads</span>\n            </button>\n            <button aria-label="Download publication PDFs" aria-expanded="false" type="button" class="menu-button button-unstyled" ng-if="model.showPdfDownloadList()" data-bootstrap-tooltip="" data-trigger="hover" data-placement="right" data-container="body" title="Download publication PDFs">\n                <div class="gui-icon">\n                    <span class="fa fa-download"></span>\n                </div>\n                <span class="title">Downloads</span>\n            </button>\n            <ul ng-if="model.showPdfDownloadList()">\n                <li ng-repeat="publication in model.publicationsWithEnabledPdfs" ng-class="{\'client-menu-active-sub-selection\': model.currentProductName == publication.productName && model.currentSelection == \'downloads\'}">\n                    <button type="button" class="button-unstyled menu-button btn-pdf-download" ng-click="model.openPdfDownloadModal(publication)" aria-label="{{::publication.productName}}">\n                        <span class="title">{{::publication.productName}}</span>\n                    </button>\n                </li>\n            </ul>\n        </li>\n        <li ng-if="::$root.mccStateParams.client.Website || $root.mccStateParams.client.theme.Links.length" class="gui-folder" style="margin-top: 40px;">\n            <button aria-label="Additional municipality links"\n                    aria-expanded="false"\n                    type="button"\n                    class="menu-button button-unstyled"\n                    data-bootstrap-tooltip=""\n                    data-trigger="hover"\n                    data-placement="right"\n                    data-container="body"\n                    title="Additional municipality links">\n                <div class="gui-icon">\n                    <span class="fa fa-external-link"></span>\n                </div>\n                <span class="title">Links</span>\n            </button>\n            <ul>\n                <li ng-if="::$root.mccStateParams.client.Website">\n                    <a ng-href="http://{{::$root.mccStateParams.client.Website}}" href="" target="_blank" aria-label="{{::$root.mccStateParams.client.Website}}">\n                        <span class="title">{{::$root.mccStateParams.client.Website}}</span>\n                    </a>\n                </li>\n                <li ng-repeat="link in ::$root.mccStateParams.client.theme.Links">\n                    <a ng-href="{{::link.Url}}" title="{{::link.Title}}" target="_blank">\n                        <span class="title">{{::link.Title}}</span>\n                    </a>\n                </li>\n            </ul>\n        </li>\n\n        <li class="gui-folder">\n            <button aria-label="Municode Library and other links"\n                    aria-expanded="false"\n                    type="button"\n                    class="menu-button button-unstyled"\n                    data-bootstrap-tooltip=""\n                    data-trigger="hover"\n                    data-placement="right"\n                    data-container="body"\n                    title="Municode Library and other links">\n                <div class="gui-icon text-center">\n                    <span class="fa fa-fw fa-ellipsis-h"></span>\n                </div>\n                <span class="title">More</span>\n            </button>\n            <ul>\n                <li>\n                    <a href="/" target="_self">\n                        <span class="title">Municode Library</span>\n                    </a>\n                </li>\n                <li>\n                    <a href="https://secure.municode.com/munistore/productspage.asp" target="_blank">\n                        <span class="title">Order a physical copy</span>\n                    </a>\n                </li>\n                <li>\n                    <a href="{{::$root.app.submitFeedbackUrl}}" target="_blank">\n                        <span class="title">Submit Feedback</span>\n                    </a>\n                </li>\n                <li>\n                    <a href="https://www.civicplus.com/terms-of-service" target="_blank">\n                        <span class="title">Terms of use</span>\n                    </a>\n                </li>\n                <li>\n                    <a href="https://www.civicplus.com/codification-software-services/" target="_blank">\n                        <span class="title">Powered by CivicPlus</span>\n                    </a>\n                </li>\n            </ul>\n        </li>\n        \n        \n    </ul>\n</nav>\n\n'),e.put("/library/ng-apps/library_desktop/client/client_mobile_logo.cshtml",'<div ng-if="!$root.mccStateParams.client || searchSvc.isInMuniproModeAndOnSearchPage()">\n    <div style="padding: 8px 24px;">\n        <a href="/">\n            <img src="dist/img/cp-municode-codification-logo.svg" alt="CivicPlus Municode Codification logo">\n            <h1 class="visually-hidden no-margin text-xl text-nowrap">Municode Codification Search</h1>\n        </a>\n    </div>\n</div>\n<div ng-if="$root.mccStateParams.client && !$root.mccStateParams.client.theme.BannerImageUrl && searchSvc.isInMuniproModeAndOnSearchPage() === false">\n    <div style="padding: 8px 24px">\n        <div style="height: 54px; padding: 4px;">\n            <h1 class="cp-font cp-font-header text-truncate m-0" style="padding-bottom:8px;">{{$root.mccStateParams.client.ClientName + \', \' + $root.mccStateParams.state.StateAbbreviation}}</h1>\n            <img src="dist/img/cp-municode-codification-logo-simple.svg" style="display:block;" alt="CivicPlus Municode Codification logo - simple"/>\n        </div>\n    </div>\n</div>\n<div ng-if="$root.mccStateParams.client && $root.mccStateParams.client.theme.BannerImageUrl && searchSvc.isInMuniproModeAndOnSearchPage() === false">\n    <img ng-src="{{$root.mccStateParams.client.theme.BannerImageUrl}}" alt="Municipality logo" class="mw-100" style="max-height:70px;" />\n    <h1 id="clientDisplayName" class="visually-hidden no-margin text-xl text-nowrap">{{$root.mccStateParams.client.ClientName + \', \' + $root.mccStateParams.state.StateAbbreviation}}</h1>\n</div>'),e.put("/library/ng-apps/library_desktop/client/client_notify.cshtml",'<style>\nmcc-codes-notify{\n    display:block;\n}\n.enotify-form {\n    height: 100%;\n}\n.enotify-container {\n    display: flex;\n    flex-direction: column;\n    height: calc(100% - 60px);\n}\n.enotify-form-footer {\n    padding: 10px;\n    text-align: right;\n}\n\n.alert-info {\n    background-color: #f2f2f3;\n    color: #313335;\n    border-color: #f2f2f3;\n}\n\n.alert-danger {\n    color: #721c24;\n}\n\n.alert-success {\n    color: #155724;\n}\n\n.has-error .validationIndicator {\n    color: #E60A15;\n}\n\n.validationIndicator {\n    color: #067F16;\n}\n\n.form-control {\n    margin-bottom: 5px;\n}\n\n.invalid {\n    color: #d0291c !important;\n}\n\na[aria-disabled="true"] {\n    pointer-events: none;\n    cursor: default;\n}\n\n</style>\n\n<div role="status">\n    <div ng-if="model.isLoading || !model.allProductsLoaded()" style="text-align: center;">\n        <span class="visually-hidden">Loading, please wait</span>\n        <img src="dist/img/ajax-loader.gif" alt="loading indicator" aria-hidden="true"/>\n    </div>\n    <span ng-if="!model.isLoading" class="visually-hidden">Loading complete</span>\n</div>\n\n<div ng-show="!model.isLoading && model.allProductsLoaded()" id="codesNotify" class="enotify-container">\n    <div class="alert alert-info">\n        <span>\n            <i class="fa fa-lightbulb-o"></i>\n        </span>\n        <span ng-if="model.isMuniproFull">\n            Remember - you can manage your subscription and sign up for bulk notifications from the\n            <a class="text-primary" data-ng-href="{{model.adminUrl}}">MuniPRO Admin Dashboard</a>.\n        </span>\n        <span ng-if="!model.isMuniproFull">\n            Interested in bulk notifications?\n            Learn how to be notified when any of our 4000+ online codes are updated or receive newly enacted legislation with the <a class="text-primary" ng-href="{{model.cpMuniproMarketingPageUrl}}" target="_blank" ng-click="model.onAdvertClick($event)">MuniPRO Municipal Law Research Tool</a>.\n        </span>\n    </div>\n\n    <div class="header" style="margin-bottom: 10px;">\n        <b>Submit the form below to receive an email notification every time the selected publication is updated online.</b>\n    </div>\n    <div role="alert">\n        <div class="alert alert-success" data-ng-if="model.form.submitStatus == \'success\'">\n            <i class="fa fa-check" aria-hidden="true"></i> {{model.isMuniproFull ? "Success! You are now signed up." : "We received your request. You should receive a confirmation email shortly."}}\n        </div>\n\n        <div class="alert alert-danger" data-ng-if="model.form.submitStatus == \'fail\'">\n            <i class="fa fa-close"></i>\n            An error occurred while processing your request.\n            If the problem persists, please contact\n            <a href="mailto:support@municode.com">\n                support@municode.com\n            </a>\n            .\n        </div>\n    </div>\n\n    <div role="alert" class="alert alert-danger" ng-repeat="error in model.form.errors">\n        <span>\n            <i class="fa fa-exclamation-triangle"></i>\n        </span>\n        {{error.text}}\n    </div>\n\n    <div class="scrollable enofity-form ps-2 pe-2">\n        <form name="codesNotifyForm">\n            <div ng-show="!model.isMuniproFull" class="form-group has-feedback" data-ng-class="{\'has-success\' : codesNotifyForm.email.$valid, \'has-error\' : codesNotifyForm.$dirty && codesNotifyForm.email.$invalid}">\n                <label class="control-label" ng-class="{\'text-success\' : codesNotifyForm.email.$valid, \'invalid\' : (codesNotifyForm.$dirty && codesNotifyForm.email.$invalid) || model.form.hasError(\'codesNotifyFormEmail\')}" for="codesNotifyFormEmail">Email</label>\n                <span class="control-label invalid" ng-show="codesNotifyForm.$dirty && codesNotifyForm.email.$invalid">Required</span>\n                <input type="email" spellcheck="false" class="form-control" name="email" id="codesNotifyFormEmail" placeholder="Enter email" data-ng-model="model.form.email" required data-ng-pattern="model.form.emailPattern"/>\n                <span data-ng-show="codesNotifyForm.email.$valid" class="glyphicon glyphicon-ok form-control-feedback" aria-hidden="true"></span>\n            </div>\n\n            <div class="form-group has-feedback" data-ng-class="{\'has-error\': !model.form.hasSelectedCodes(), \'has-success\': model.form.hasSelectedCodes()}">\n                <span id="codesLabel" ng-class="{\'invalid\': !model.form.hasSelectedCodes() }" class="control-label" for="codesNotifyFormCodes">Publications</span>\n                <span class="control-label invalid" ng-show="!model.form.hasSelectedCodes()">- Select 1 or more</span>\n                <span data-ng-show="model.form.hasSelectedCodes()" class="glyphicon glyphicon-ok" style="color:#468847;" aria-hidden="true"></span>\n\n                <section id="codesNotifyFormCodes" class="list-group">\n                    <div class="list-group-item" data-ng-repeat="product in model.products" data-once-class="{\'disabled\' : !product.hasEnotify}">\n                        <label class="checkbox-inline" aria-label="Subscribe to {{product.ProductName}}">\n                            <input type="checkbox"\n                                   mcc-aria-disabled="!product.hasEnotify"\n                                   ng-model="model.form.productSelections[product.ProductID]" />\n                            <span data-once-if="!product.hasEnotify" class="label label-danger">disabled by municipality</span>\n                            <span data-once-text="product.ProductName" class="text-default"></span>\n                        </label>\n                    </div>\n                </section>\n            </div>\n\n            <p ng-show="!model.isMuniproFull">By submitting this form you agree to allow <span data-once-text="model.clientName"></span> to use your information for informational and statistical purposes only. Your information will not be shared with any third parties by either <span data-once-text="model.clientName"></span> or CivicPlus, Inc.</p>\n\n            <label class="checkbox-inline" ng-show="!model.isMuniproFull">\n                <input type="checkbox" data-ng-model="model.form.marketing"/> \n                By checking this box, you agree to receive promotional emails and other marketing materials from CivicPlus, Inc.\n            </label>\n\n        </form>\n\n    </div>\n</div>\n\n\n<div ng-show="!model.isLoading && model.allProductsLoaded()" class="enotify-form-footer">\n    <form class="actionBarForm form-inline" name="actionBarForm" novalidate ng-submit="model.form.onSubmit()">\n        <button type="button" class="btn btn-cancel btn-flat pull-left" data-close><i class="fa fa-close"></i> Close</button>\n        <button mcc-aria-disabled="!model.form.allowSignup()" type="submit" class="btn btn-primary btn-raised"> Submit</button>\n    </form>\n</div>\n'),e.put("/library/ng-apps/library_desktop/client_listing/client_listing-partial.cshtml",'<div id="clientListingMobileHeader" class="hidden-md hidden-lg hidden-xl mobile-header d-flex align-items-center">\n    <div style="padding: 8px 24px;">\n        <img src="dist/img/cp-municode-codification-logo.svg" alt="CivicPlus Municode Codification logo"/>\n    </div>\n    <div class="ms-auto">\n        <mcc-sign-in></mcc-sign-in>\n    </div>\n    <div class="dropdown me-2">\n        <button class="btn btn-flat dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Help menu" title="Help menu" bootstrap-tooltip data-trigger="hover" data-placement="bottom">\n            <i class="md md-help"></i>\n            <span class="caret"></span>\n        </button>\n        <ul class="dropdown-menu dropdown-menu-right">\n            \x3c!-- Visit Help Center link --\x3e\n            <li>\n                <a ng-href="{{::$root.app.supportUrl}}" target="_blank">\n                    <i class="fa fa-life-ring fa-fw"></i>\n                    Visit Help Center\n                </a>\n            </li>\n            \x3c!-- Submit Feedback link --\x3e\n            <li>\n                <a href="{{::$root.app.submitFeedbackUrl}}" target="_blank">\n                    <i class="fa fa-lightbulb-o fa-fw"></i>\n                    Submit Feedback\n                </a>\n            </li>\n        </ul>\n    </div>\n</div>\n<div class="zones no-toc" mcc-zone-mgr>\n    <mcc-main-content class="primary client-list zone content-zone style-default-bright">\n        <div class="zone-body primary-zone-body">\n            <h1 class="text-primary primary-heading">{{mccStateParams.state.StateName}}</h1>\n            <div class="container-fluid">\n                <div class="text-center">\n                    <section class="mcc-btn-group no-padding" aria-label="Alphabetical index of municipalities for {{::mccStateParams.state.StateName}}">\n                        <a aria-label="Letter {{::letterGroup.heading}}" aria-describedby="heading-description" ng-repeat="letterGroup in letterGroups" class="btn btn-default-light index-link" href="" ng-href="#{{::letterGroup.heading}}">\n                            <span class="">{{::letterGroup.heading}}</span>\n                        </a>\n                        <p id="heading-description" class="visually-hidden">\n                            Jumps to municipalities starting with specified letter\n                        </p>\n                    </section>\n\n                </div>\n\n                <section class="no-padding" aria-label="Alphabetical list of municipalities for {{::mccStateParams.state.StateName}}">\n                    <div ng-repeat="letterGroup in letterGroups">\n                        <h2 class="text-divider" id="{{::letterGroup.heading}}">{{::letterGroup.heading}}</h2>\n                        <ul class="nav row">\n                            <li ng-repeat="client in letterGroup.clients" class="col-xs-12 col-sm-6 col-md-4 col-lg-3 text-center">\n                                <a class="index-link" href="" ng-href="{{::clientListing.getAnchorHref(client)}}">{{::client.ClientName}}</a>\n                            </li>\n                        </ul>\n                    </div>\n                </section>\n            </div>\n        </div>\n    </mcc-main-content>\n</div>'),e.put("/library/ng-apps/library_desktop/codes/amended_toc.cshtml",'<div class="codes-amended-toc" ng-class="{\'loading\': model.gettingData}" aria-live="polite" aria-busy="true">\n    <div role="status">\n        <div style="position: absolute; left: 50%;" ng-if="model.gettingData">\n            <span style="transform: translate(-50%, 0)"><i class="fa fa-2x fa-circle-o-notch fa-spin" aria-hidden="true"></i></span>\n            <span class="visually-hidden">Loading, please wait</span>\n        </div>\n        <div ng-if="model.amendedDocs.length > 0 && !model.gettingData" style="padding-top: 10px">\n            <span class="visually-hidden">Loading complete</span>\n        </div>\n        <div ng-if="model.amendedDocs.length === 0 && !model.gettingData" style="padding-top: 10px">\n            <p>There are no pending amendments.</p>\n        </div>\n    </div>\n    \n    <ul class="list-unstyled quick-list-docs" aria-label="List of pending amendments to code">\n        <li data-ng-repeat="doc in model.amendedDocs" class="amendedDoc quick-list-doc" data-ng-class="{\'active\': doc.NodeId == $root.$stateParams.nodeId}">\n            <span class="label label-primary pull-right">amended</span>\n            <div class="crumbs">\n                <span class="crumb text-muted" ng-repeat="ancestor in ::model.getAncestors(doc)">\n                    <a class="" href="" ng-href="{{::model.getHref(ancestor)}}">{{::ancestor.Title}}</a>\n                </span>\n            </div>\n            <a href="" ng-href="{{::model.getHref(doc)}}">{{::doc.Title}}</a>\n        </li>\n    </ul>\n</div>'),e.put("/library/ng-apps/library_desktop/codes/changes_toc.cshtml",'<div class="codes-changes-toc" ng-class="{\'loading\': model.gettingData}">\n    <div role="status">\n        <div style="position: absolute; left: 50%;" ng-if="model.gettingData">\n            <span style="transform: translate(-50%, 0)"><i class="fa fa-2x fa-circle-o-notch fa-spin" aria-hidden="true"></i></span>\n            <span class="visually-hidden">Loading, please wait</span>\n        </div>\n        <div ng-if="model.changedDocs.length > 0 && !model.gettingData" style="padding-top: 10px" >\n            <span class="visually-hidden">Loading complete</span>\n        </div>\n        <div ng-if="model.changedDocs.length === 0 && !model.gettingData">\n            <p>There are no recent changes.</p>\n        </div>\n    </div>\n    \n    <ul class="list-unstyled quick-list-docs" aria-label="List of recent changes to code">\n        <li data-ng-repeat="doc in model.changedDocs" class="changedDoc quick-list-doc" data-ng-class="{\'active\': doc.NodeId == $root.$stateParams.nodeId}">\n            <span class="label label-success pull-right" data-ng-if="::doc.CompareStatus == 0">new</span>\n            <span class="label label-primary pull-right" data-ng-if="::doc.CompareStatus == 2">modified</span>\n            <div class="crumbs">\n                <span class="crumb text-muted" ng-repeat="ancestor in ::model.getAncestors(doc)">\n                    <a class="" href="" ng-href="{{::model.getHref(ancestor)}}" ng-click="model.setNavOrigin()">{{::ancestor.Title}}</a>\n                </span>\n            </div>\n            <a href="" ng-href="{{::model.getHref(doc)}}" ng-click="model.setNavOrigin()">{{::doc.Title}}</a>\n        </li>\n    </ul>\n</div>'),e.put("/library/ng-apps/library_desktop/codes/codebank.cshtml",'<style>\n    mcc-codebank{\n        display:block;\n    }\n\n    #codebank .timeline-entry .card{\n        margin-bottom: 12px;\n    }\n\n</style>\n<div id="codebank" class="small-padding side-padding-only">\n    <div role="status">\n        <div class="text-center text-primary no-side-padding" ng-if="!vm.publicationVersions.length">\n            <span><i class="fa fa-3x fa-circle-o-notch fa-spin" aria-hidden="true"></i></span>\n            <span class="visually-hidden">Loading, please wait</span>\n        </div>\n        <span ng-if="vm.publicationVersions.length" class="visually-hidden">Loading complete</span>\n    </div>\n    <ul class="timeline collapse-lg" aria-label="List of previous versions of code">\n        <li ng-repeat="publicationVersion in ::vm.publicationVersions" ng-class="::{\'timeline-inverted\' : $odd}">\n            <div class="timeline-circ" ng-class="::{\'style-accent\': vm.activePublicationVersion === publicationVersion.id}"></div>\n            <div class="timeline-entry">\n                <div class="card style-primary">\n                    <div class="card-body smaller-padding">\n                        <a href="" ng-href="{{::vm.getPublicationVersionHref(publicationVersion)}}" ng-click="vm.publicationVersionClick($event, publicationVersion)" class="btn btn-flat ink-reaction"\n                           style="width: 100%;text-align: left;text-wrap: wrap;">\n                            <span ng-if="::publicationVersion.isPublished">{{::publicationVersion.onlineDate | date:\'MM/dd/yyyy\'}}</span>\n                            <span ng-if="::(publicationVersion && !publicationVersion.isPublished)" class="badge style-danger">Unpublished</span>\n                            <span class="text-light">{{::publicationVersion.name}}</span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </li>\n    </ul>\n</div>\n'),e.put("/library/ng-apps/library_desktop/codes/codebank_diff.cshtml",'<style>\n    mcc-codebank-dual-column-diff-control {\n        display: block;\n        height: 100%;\n    }\n\n    .animate-show {\n        -webkit-transition: 1s linear all;\n        transition: 1s linear all;\n        opacity: 1;\n    }\n\n    .animate-show.ng-hide {\n        -webkit-transition: 1s linear all;\n        transition: 1s linear all;\n        opacity: 0;\n    }\n\n    #codebank-diff {\n        height: 100%;\n        display: flex;\n        flex-direction: column;\n    }\n\n    #codebank-diff .codebank-diff-body {\n        flex: 1 1 auto;\n        overflow-y: auto;\n        padding: 0 20px 20px;\n    }\n\n    #codebank-diff .codebank-diff-footer {\n        flex: 0 0 auto;\n        display: flex;\n        align-items: center;\n        gap: 12px;\n        padding: 14px 20px 8px;\n        border-top: 1px solid #e5e7eb;\n        background: #fff;\n    }\n\n    #codebank-diff .codebank-diff-footer .footer-actions {\n        margin-left: auto;\n        display: flex;\n        align-items: center;\n    }\n\n    #codebank-diff .codebank-diff-footer .footer-note {\n        flex: 1 1 auto;\n        margin: 0;\n        text-align: right;\n        color: #4b5563;\n    }\n\n    #codebank-diff .older-versions-title {\n        margin: 24px 0 8px;\n        text-align: center;\n        font-size: 1.6em;\n    }\n\n    #codebank-diff .older-versions-description {\n        margin: 0 auto 16px;\n        max-width: 760px;\n        text-align: center;\n        color: #5b6472;\n    }\n\n    #codebank-diff .version-selection-check {\n        color: #337ab7;\n        font-size: 200%;\n    }\n\n    #codebank-diff .version-item-selected {\n        background-color: #fff;\n        border-color: #337ab7;\n        box-shadow: inset 0 0 0 1px #337ab7;\n        color: #337ab7;\n    }\n\n    #codebank-diff .version-item-selected:hover,\n    #codebank-diff .version-item-selected:focus {\n        background-color: #fff;\n        border-color: #337ab7;\n    }\n\n    #codebank-diff .version-item-selected .list-group-item-heading,\n    #codebank-diff .version-item-selected p {\n        color: #337ab7;\n    }\n\n    #codebank-diff .version-item-selected.disabled,\n    #codebank-diff .version-item-selected.disabled:hover,\n    #codebank-diff .version-item-selected.disabled:focus {\n        opacity: 1;\n        cursor: pointer;\n        background-color: #fff;\n        border-color: #337ab7;\n    }\n\n    #codebank-diff .version-item-disabled {\n        opacity: .55;\n        cursor: not-allowed;\n    }\n</style>\n\n<div id="codebank-diff">\n    <div ng-show="model.currentActivity == \'viewDiff\'" style="text-align:center; margin-bottom: 15px;font-size:120%">\n        <strong mcc-focus-when="model.currentActivity == \'viewDiff\'" tabindex="-1">{{model.basePublicationVersion.name}} vs {{model.changedPublicationVersion.name}}</strong>\n    </div>\n\n    <div class="codebank-diff-body">\n        <div ng-show="model.currentActivity == \'chooseJobs\'">\n            <h3 style="font-size:2em; text-align:center;" tabindex="-1" mcc-focus-when="model.currentActivity == \'chooseJobs\'">\n                Select Two Versions to Compare\n            </h3>\n\n            <div role="status">\n                <div ng-if="model.loading" style="text-align: center;">\n                    <span class="visually-hidden">Loading, please wait</span>\n                    <img src="dist/img/ajax-loader.gif" alt="loading indicator" aria-hidden="true" />\n                </div>\n                <span ng-if="!model.loading" class="visually-hidden">Loading complete</span>\n            </div>\n\n            <div class="list-group" style="width:100%; font-size:70%">\n                <button type="button" class="list-group-item btn btn-block"\n                        style="cursor: pointer !important"\n                        data-ng-class="{\n                            \'version-item-disabled\' : model.isPublicationVersionDisabled(publicationVersion) && !model.isPublicationVersionSelected(publicationVersion),\n                            \'version-item-selected\' : model.isPublicationVersionSelected(publicationVersion)\n                        }"\n                        mcc-aria-disabled="model.isPublicationVersionDisabled(publicationVersion) && !model.isPublicationVersionSelected(publicationVersion)"\n                        data-ng-repeat="publicationVersion in (model.hasMixedPublicationVersionTypes ? model.newerPublicationVersions : model.publicationVersions)"\n                        data-ng-click="model.selectOne(publicationVersion)">\n                    <span class="pull-right left-space">\n                        <i class="fa fa-check version-selection-check" ng-show="model.basePublicationVersion.id == publicationVersion.id || model.changedPublicationVersion.id == publicationVersion.id"></i>\n                    </span>\n                    <h4 class="list-group-item-heading" data-ng-bind="::publicationVersion.name"></h4>\n                    <p>\n                        <span ng-if="::publicationVersion.isPublished" data-ng-bind="::publicationVersion.onlineDate | date:\'MM/dd/yyyy\'"></span>\n                        <span ng-if="::!publicationVersion.isPublished" class="badge style-danger">Unpublished</span>\n                    </p>\n                </button>\n            </div>\n\n            <div ng-if="model.hasMixedPublicationVersionTypes">\n                <h4 class="older-versions-title">Older Versions</h4>\n                <p class="older-versions-description">\n                    These versions use a different format than newer versions. They cannot be compared to newer versions - only against other older versions.\n                </p>\n\n                <div class="list-group" style="width:100%; font-size:70%">\n                    <button type="button" class="list-group-item btn btn-block"\n                            style="cursor: pointer !important"\n                        data-ng-class="{\n                                \'version-item-disabled\' : model.isPublicationVersionDisabled(publicationVersion) && !model.isPublicationVersionSelected(publicationVersion),\n                                \'version-item-selected\' : model.isPublicationVersionSelected(publicationVersion)\n                            }"\n                            mcc-aria-disabled="model.isPublicationVersionDisabled(publicationVersion) && !model.isPublicationVersionSelected(publicationVersion)"\n                            data-ng-repeat="publicationVersion in model.olderPublicationVersions"\n                            data-ng-click="model.selectOne(publicationVersion)">\n                        <span class="pull-right left-space">\n                            <i class="fa fa-check version-selection-check" ng-show="model.basePublicationVersion.id == publicationVersion.id || model.changedPublicationVersion.id == publicationVersion.id"></i>\n                        </span>\n                        <h4 class="list-group-item-heading" data-ng-bind="::publicationVersion.name"></h4>\n                        <p>\n                            <span ng-if="::publicationVersion.isPublished" data-ng-bind="::publicationVersion.onlineDate | date:\'MM/dd/yyyy\'"></span>\n                            <span ng-if="::!publicationVersion.isPublished" class="badge style-danger">Unpublished</span>\n                        </p>\n                    </button>\n                </div>\n            </div>\n        </div>\n\n        <div ng-if="model.currentActivity == \'viewDiff\'">\n            <div role="status" aria-live="polite">\n                <div class="alert alert-warning" ng-if="model.loading" style="text-align: center;">\n                    <i class="fa fa-refresh fa-spin" aria-hidden="true"></i>\n                    <span>Loading... For large sections this may take a few minutes</span>\n                </div>\n                <div ng-if="!model.loading" class="visually-hidden">\n                    <span>Loading complete</span>\n                </div>\n            </div>\n            <div class="diffed-html scrollable mcc-codes">\n                <style>\n                    .chunk-title-wrapper .chunk-title {\n                        display: inline-block;\n                    }\n                </style>\n                <ul class="chunks">\n                    <li class="chunk" data-ng-repeat="chunk in model.diffChunks" id="diff_{{::chunk.Id}}"\n                        data-nodetype="" data-nodedepth="{{::model.docNodes[$index].NodeDepth}}">\n                        <div class="chunk-heading">\n                            <mcc-codes-title-wrapper\n                                mindepth="::model.diffChunks[0].NodeDepth"\n                                nodedepth="::chunk.NodeDepth"\n                                titlehtml=" ::chunk.Title">\n                            </mcc-codes-title-wrapper>\n                        </div>\n                        <div class="chunk-content-wrapper" ng-class="{\'ins\': node.Data.CompareStatus == 0}" ng-bind-html="::prepareHtml(chunk.Content)" ng-init="checkIfChunksLoaded($last)"></div>\n                    </li>\n                </ul>\n            </div>\n        </div>\n    </div>\n\n    <div class="codebank-diff-footer">\n        <button type="button" class="btn btn-primary btn-raised" ng-show="model.currentActivity == \'viewDiff\'" ng-click="changeActivity(\'chooseJobs\')">\n            <i class="fa fa-arrow-left"></i> Choose Versions\n        </button>\n\n        <p class="footer-note" ng-show="model.currentActivity == \'viewDiff\'">\n            <strong>Note:</strong> If there are no differences, there will be no <ins>highlights</ins> or <del>strikethroughs</del>.\n        </p>\n\n        <div class="footer-actions" ng-show="model.currentActivity == \'chooseJobs\'">\n            <button type="button" class="btn btn-primary btn-raised"\n                    ng-click="changeActivity(\'viewDiff\')"\n                    ng-disabled="model.isCompareButtonDisabled()">\n                View Comparison <i class="fa fa-arrow-right"></i>\n            </button>\n        </div>\n    </div>\n</div>\n'),e.put("/library/ng-apps/library_desktop/codes/codes.cshtml",'<style>\n    .table-viewer-modal {\n        height: 96%;\n        overflow-y: hidden !important;\n        padding-left: 0px !important;\n        margin: 1.5% 1.0%;\n        max-height: 96%;\n        min-height: 40%;\n    }\n\n    .table-viewer-modal > .modal-dialog {\n        width: 100%;\n        height: 100%;\n        margin: 0;\n\n    }\n\n    .fa-stack-custom {\n        width: unset !important;\n        height: unset !important;\n        line-height: unset !important;\n        vertical-align: unset !important;\n    }\n\n    .rg-bottom {\n        margin-bottom: 68px;\n    }\n\n    .table-viewer-content {\n        height: 100% !important;\n    }\n\n    .tableWrapper.scrollable > .table {\n        margin-bottom: 1px !important;\n    }\n\n    .table-viewer-modal > .modal-dialog > .modal-content > .modal-body {\n        padding: 20px;\n        overflow-y: hidden;\n        margin: 0;\n        height:calc(100% - 143px);\n    }\n\n    .tableWrapper {\n        position: relative;\n\n    }\n\n    .section-link {\n        text-decoration: underline !important;\n        color: #096fcc !important;\n    }\n\n    .expanded-table-viewer-wrapper {\n        height: 100%;\n    }\n\n    .expanded-table-viewer-wrapper > .tableWrapper {\n        max-height: calc(100% - 40px) !important;\n        overflow-y: auto;\n        overflow-x: auto;\n    }\n\n    .print-frame-content {\n        display: none;\n    }\n\n    .popover {\n        z-index: 2000 !important;\n    }\n\n    .btn-expand {\n        float: right;\n    }\n\n    .btn-expand.no-scroll {\n        top: 5px;\n        right: 5px;\n    }\n    \n    .add-note-modal > .modal-dialog {\n        width: 90% !important;\n        margin: 128px auto !important;\n    }\n\n    \n    .codes-toc-saveOrPrint-modal > .modal-dialog {\n        width: 90% !important;\n        margin: 128px auto !important;\n    }\n</style>\n\n<div id="codesMobileHeader" class="hidden-md hidden-lg hidden-xl mobile-header d-flex align-items-center" ng-class="{\'toc-visible\': $root.zoneMgrSvc.isTocZoneVisibleOnMobile}" ng-style="$root.mobileHeaderTheme">\n    <mcc-client-mobile-logo></mcc-client-mobile-logo>\n    <div class="ms-auto me-2 d-flex align-items-center" id="codes">\n        <button ng-show="!$root.zoneMgrSvc.isTocZoneVisibleOnMobile" type="button" class="btn btn-icon-toggle" ng-click="$root.zoneMgrSvc.toggleVisibleZone()" aria-label="Show table of contents" title="Show table of contents" bootstrap-tooltip data-trigger="hover" data-placement="left" data-container="body">\n            <i class="fa fa-list-ul"></i>\n        </button>\n        <button ng-show="$root.zoneMgrSvc.isTocZoneVisibleOnMobile" type="button" class="btn btn-icon-toggle" ng-click="$root.zoneMgrSvc.toggleVisibleZone()" aria-label="Hide table of contents" title="Hide table of contents" bootstrap-tooltip data-trigger="hover" data-placement="left" data-container="body">\n            <i class="fa fa-close"></i>\n        </button>\n        <mcc-mobile-search class="d-flex"></mcc-mobile-search>\n        <div class="btn-group" >\n            <button type="button" class="btn btn-icon-toggle ink-reaction dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Action menu" title="Action menu" bootstrap-tooltip data-trigger="hover" data-placement="left" data-container="body">\n                <i class="fa fa-ellipsis-v"></i>\n            </button>\n            <ul class="dropdown-menu pull-right animation-expand">\n                <li>\n                    <button type="button" class="button-unstyled btn-block" ng-click="vm.showChangedDocs()"><i class="md md-call-split"></i> Recent Changes</button>\n                </li>\n                <li>\n                    <button type="button" class="button-unstyled btn-block" ng-click="vm.codebankFlyoverClick()"><i class="md md-restore"></i> Previous Versions</button>\n                </li>\n                <li>\n                    <button type="button" class="button-unstyled btn-block" ng-click="vm.getNotifiedClick()"><i class="fa fa-envelope-o fa-fw"></i> Notifications</button>\n                </li>\n                <li class="divider"></li>\n                <li>\n                    <mcc-sign-in layout="menu"></mcc-sign-in>\n                </li>\n                <li class="divider"></li>\n                \x3c!-- Visit Help Center link --\x3e\n                <li>\n                    <a ng-href="{{::$root.app.supportUrl}}" target="_blank">\n                        <i class="fa fa-life-ring fa-fw"></i>\n                        Visit Help Center\n                    </a>\n                </li>\n                \x3c!-- Submit Feedback link --\x3e\n                <li>\n                    <a href="{{::$root.app.submitFeedbackUrl}}" target="_blank">\n                        <i class="fa fa-lightbulb-o fa-fw"></i>\n                        Submit Feedback\n                    </a>\n                </li>\n            </ul>\n        </div>\n    </div>\n</div>\n\n\n<div resizable r-directions="[\'bottom\']" r-grabber="<span><i fa fa-bars></i></span>" class="table-viewer-modal modal" tabindex="-1" role="dialog" aria-modal="true" ng-click="vm.tableViewerModalClick($event)" aria-label="Expanded table">\n    <div class="modal-dialog">\n        <div class="table-viewer-content modal-content">\n            <div class="modal-header">\n                <h2 class="modal-title">View Table</h2>\n                <button type="button" class="btn btn-icon-toggle btn-default" aria-label="Close" data-dismiss="modal">\n                    <i class="md md-close"></i>\n                </button>\n            </div>\n            <div class="modal-body" style="max-height: 100%;">\n\n            </div>\n            <div class="modal-footer">\n                <button type="button" class="btn btn-cancel btn-flat" data-dismiss="modal"><i class="fa fa-close"></i> Close</button>\n            </div>\n        </div>\n    </div>\n</div>\n\n<div class="meeting-details-modal modal" tabindex="-1" role="dialog" aria-modal="true" aria-label="Meeting details">\n    <div class="modal-dialog" style="width: 90%; height: 87%; margin: 4% auto;">\n        <div class="modal-content" style="height: 100%; width: 100%;">\n            <div class="modal-header">\n                <h2 class="modal-title">Meeting Details</h2>\n                <a ng-href="{{vm.viewAllMeetingsUrl}}" target="_blank" class="text-primary" mcc-focus-when="vm.showMeetingDetails"><i class="fa fa-external-link"></i> View All Meetings</a>\n                <button type="button" data-dismiss="modal" class="btn btn-icon-toggle btn-default" aria-label="Close">\n                    <i class="md md-close"></i>\n                </button>\n            </div>\n            <div class="modal-body" style="max-height: 100%; height: calc(100% - 142px); width: 100%;">\n                <mcc-meeting-details ng-if="vm.showMeetingDetails" data-params="{clientCode: vm.selectedMeetingClientCode, meetingId: vm.selectedMeetingId}"></mcc-meeting-details>\n            </div>\n            <div class="modal-footer">\n                <button type="button" data-dismiss="modal" class="btn btn-cancel btn-flat"><i class="fa fa-close"></i> Close</button>\n            </div>\n        </div>\n    </div>\n</div>\n\n<div class="generic-meeting-details-modal modal" tabindex="-1" role="dialog" aria-modal="true" aria-label="Meeting details">\n    <div class="modal-dialog" style="width: 90%; height: 87%; margin: 4% auto;">\n        <div class="modal-content" style="height: 100%; width: 100%;">\n            <div class="modal-header">\n                <h2 class="modal-title">Meeting Details</h2>\n                <a ng-if="$root.mccStateParams.client.MeetingsUrl" ng-href="{{$root.mccStateParams.client.MeetingsUrl}}" target="_blank" class="text-primary" mcc-focus-when="vm.showGenericMeetingDetails"><i class="fa fa-external-link"></i> View All Meetings</a>\n                <button type="button" class="btn btn-icon-toggle btn-default" aria-label="Close" data-dismiss="modal">\n                    <i class="md md-close"></i>\n                </button>\n            </div>\n            <div class="modal-body" style="max-height: 100%; height: calc(100% - 142px); width: 100%;">\n                <mcc-generic-meeting-details ng-if="vm.showGenericMeetingDetails" data-meeting-url="{{vm.tempGenericMeetingData.meetingUrl}}"></mcc-generic-meeting-details>\n            </div>\n            <div class="modal-footer">\n                <button type="button" class="btn btn-cancel btn-flat" data-dismiss="modal"><i class="fa fa-close"></i> Close</button>\n            </div>\n        </div>\n    </div>\n</div>\n\n<div class="modal codes-toc-saveOrPrint-modal in" role="dialog" aria-modal="true" aria-labelledby="printOrDownloadTocTitle" tabindex="-1">\n    <div class="modal-dialog">\n        <div class="modal-content">\n            <div class="modal-header">\n                <h2 class="modal-title">\n                    <i class="fa fa-file-text-o"></i> <span id="printOrDownloadTocTitle">Print or Download Table of Contents</span>\n                </h2>\n                <button type="button" class="btn btn-icon-toggle btn-default" data-dismiss="modal" aria-label="Close">\n                    <i class="md md-close"></i>\n                </button>\n            </div>\n            <div class="modal-body">\n                <mcc-codes-toc-save-or-print ng-if="vm.showTocSaveOrPrintModal"></mcc-codes-toc-save-or-print>\n            </div>\n            <div class="modal-footer">\n                <button type="button" data-dismiss="modal" class="btn btn-cancel btn-flat"><i class="fa fa-close"></i> Close</button>\n            </div>\n        </div>\n    </div>\n</div>\n\n<div class="modal add-note-modal" role="dialog" aria-modal="true" aria-labelledby="addNoteTitle" tabindex="-1">\n    <div class="modal-dialog">\n        <div class="modal-content">\n            <div class="modal-header">\n                <h2 class="modal-title">\n                    <i class="fa fa-file-text-o"></i> <span id="addNoteTitle">Add Note</span>\n                </h2>\n                <button type="button" class="btn btn-icon-toggle btn-default" data-dismiss="modal" aria-label="Close">\n                    <i class="md md-close"></i>\n                </button>\n            </div>\n            <div class="modal-body">\n                <mcc-munipro-add-note data-params="{activeId: vm.actionNodeId, close: OffCanvasSvc.toggleOpen, closeParams: [\'addNote\'] }" ng-if="vm.showAddNoteModal"></mcc-munipro-add-note>\n            </div>\n        </div>\n    </div>\n</div>\n\n<mcc-off-canvas class="col-xs-12 persistent-off-canvas"\n                name="recentChanges"\n                header-title="\'Recent Changes\'"\n                icon-class="md md-call-split"\n                scrollable="true"\n                options="{useBackdrop: false, canSlideContent: true, closeOnLinkClickOnMobile: true}">\n    <mcc-codes-changes-toc></mcc-codes-changes-toc>\n</mcc-off-canvas>\n\n<mcc-off-canvas class="col-xs-12 persistent-off-canvas"\n                name="pendingAmendments"\n                header-title="\'Pending Amendments\'"\n                icon-class="fa fa-gavel"\n                scrollable="true"\n                options="{useBackdrop: false, canSlideContent: true, closeOnLinkClickOnMobile: true}">\n    <mcc-codes-amended-toc></mcc-codes-amended-toc>\n</mcc-off-canvas>\n\n<mcc-off-canvas class="col-xs-12 persistent-off-canvas"\n                name="searchResults"\n                header-title="\'Search Results\'"\n                icon-class="fa fa-search"\n                scrollable="true"\n                options="{useBackdrop: false, canSlideContent: true, closeOnLinkClickOnMobile: true}">\n    <mcc-search-results></mcc-search-results>\n</mcc-off-canvas>\n\n<mcc-off-canvas class="col-xs-12 persistent-off-canvas"\n                name="codebank"\n                header-title="\'Previous Versions\'"\n                icon-class="md md-restore"\n                scrollable="true"\n                options="{useBackdrop: false, canSlideContent: true, closeOnLinkClickOnMobile: true}">\n    <mcc-codebank></mcc-codebank>\n</mcc-off-canvas>\n\n\n<mcc-off-canvas class="col-xs-12 col-sm-9 col-md-8 col-lg-6"\n                name="print"\n                header-title="\'Print\'"\n                icon-class="fa fa-print"\n                options="{keepOpenWithOthers: true}"\n                style="padding:0;">\n    <mcc-codes-print data-params="{activeId: vm.actionNodeId,close: $root.OffCanvasSvc.Close, closeParams: [\'print\']}"></mcc-codes-print>\n</mcc-off-canvas>\n\n<mcc-off-canvas class="col-xs-12 col-sm-9 col-md-8 col-lg-4"\n                name="downloaddocx"\n                header-title="\'Download (Docx)\'"\n                icon-class="fa fa-cloud-download"\n                options="{keepOpenWithOthers: true}"\n                style="padding:0;">\n    <mcc-codes-save data-params="{activeId: vm.actionNodeId, close: $root.OffCanvasSvc.Close, closeParams: [\'downloaddocx\']}"></mcc-codes-save>\n</mcc-off-canvas>\n\n<mcc-off-canvas class="col-xs-12 col-sm-9 col-md-8 col-lg-4"\n                name="email"\n                header-title="\'Email\'"\n                icon-class="fa fa-envelope"\n                options="{keepOpenWithOthers: true}"\n                style="padding:0;">\n    <mcc-codes-email data-params="{activeId: vm.actionNodeId, close: $root.OffCanvasSvc.Close, closeParams: [\'email\'] }"></mcc-codes-email>\n</mcc-off-canvas>\n\n<mcc-off-canvas class="col-xs-12 col-sm-9 col-md-8 col-lg-5"\n                name="sharelink"\n                header-title="\'Share Link\'"\n                icon-class="fa fa-link"\n                options="{keepOpenWithOthers: true}"\n                style="padding:0;">\n    <div style="height: calc(100% - 60px)" class="scrollable">\n        <mcc-share-link data-params="{activeId: vm.actionNodeId}"></mcc-share-link>\n    </div>\n    <div style="padding: 20px;">\n        <button type="button" class="btn btn-cancel btn-flat btn-block pull-left" data-close><i class="fa fa-close"></i> Close</button>\n    </div>\n</mcc-off-canvas>\n\n<mcc-off-canvas class="col-xs-12 col-sm-9 col-md-8 col-lg-7"\n                name="compare"\n                header-title="\'Compare Code Versions\'"\n                icon-class="md md-content-copy"\n                options="{keepOpenWithOthers: true}"\n                style="padding:0;">\n    <div style="height: 100%;" class="scrollable">\n        <mcc-codebank-dual-column-diff-control data-params="{activeId: vm.actionNodeId}"></mcc-codebank-dual-column-diff-control>\n    </div>\n</mcc-off-canvas>\n\n<mcc-off-canvas class="col-xs-12 col-sm-9 col-md-8 col-lg-4"\n                name="addDraft"\n                header-title="\'Add Draft\'"\n                icon-class="fa fa-file-text-o"\n                options="{keepOpenWithOthers: true}"\n                style="padding:0;">\n    <mcc-munipro-add-draft data-params="{activeId: vm.actionNodeId, close: OffCanvasSvc.toggleOpen, closeParams: [\'addDraft\'] }"></mcc-munipro-add-draft>\n</mcc-off-canvas>\n\n<section id="toolbar" class="no-padding style-default-bright" aria-label="Breadcrumbs Toolbar">\n    <div class="container-fluid">\n        <div class="row">\n            <div class="col-md-8" id="mcc_desktop_codes_breadcrumb">\n                <mcc-bread-crumb active-node-id="vm.getBreadcrumbNodeId()"/>\n            </div>\n            <div class="col-md-4 product-actions">\n                <div class="pull-right">\n                    <div class="chardin_extend_width" style="display:inline-block;" data-placement="bottom" data-intro="Show all recent changes with highlights and strikethroughs." data-position="left">\n                        <button ng-if="::$root.mccStateParams.product.Features.CodeBankCompare" type="button" class="btn btn-flat"\n                                ng-click="vm.showChangesClick()" bootstrap-tooltip data-trigger="hover" title="Easily see what\'s changed with strikethroughs and highlights"\n                                data-container="body"\n                                aria-label="Easily see what\'s changed with strikethroughs and highlights">\n                            <i class="fa fa-strikethrough"></i> <span class="visible-lg-inline visible-xl-inline">Show Changes</span>\n                            <span>\n                                <i class="fa" ng-class="$root.$stateParams.showChanges ? \'fa-toggle-on\' : \'fa-toggle-off\'"></i>\n                            </span>\n                        </button>\n                    </div>\n                    <button ng-if="::!$root.mccStateParams.product.Features.CodeBankCompare" type="button" class="btn btn-flat disabled" style="pointer-events: auto;" ng-click="vm.noShowChangesClick()" bootstrap-tooltip data-trigger="hover" title="This municipality does not subscribe to the CodeBank Compare feature" data-placement="bottom" data-container="body" aria-label="This municipality does not subscribe to the CodeBank Compare feature">\n                        <i class="fa fa-strikethrough"></i> <span class="visible-lg-inline visible-xl-inline">Show Changes</span>\n                        <span>\n                            <i class="fa fa-toggle-off"></i>\n                        </span>\n                    </button>\n                    <div style="display:inline-block;" data-placement="bottom" data-intro="">\n                        <button type="button" class="btn btn-flat" ng-click="$root.searchSvc.toggleSearchResultsPane()" bootstrap-tooltip data-trigger="hover" title="Open or close search results pane" aria-label="Open or close search results pane" data-container="body" data-position="bottom">\n                            <span ng-if="!$root.searchSvc.isResultsPaneOpen()">\n                                <i class="fa fa-caret-left"></i><i class="fa fa-search"></i>\n                            </span>\n                            <span ng-if="$root.searchSvc.isResultsPaneOpen()">\n                                <i class="fa fa-search"></i><i class="fa fa-caret-right"></i>\n                            </span>\n\n                        </button>\n                    </div>\n                    <div class="btn-group hidden-xs hidden-sm" data-intro="Expose the hide/search results.  Click more for other options" data-position="bottom">\n                        <button type="button" class="btn btn-flat dropdown-toggle" style="color: #d0291c;" data-toggle="dropdown">\n                            more <i class="fa fa-caret-down"></i>\n                        </button>\n\n                        <ul class="dropdown-menu pull-right animation-expand">\n                            <li class="smaller-padding text-default-light text-medium">{{::$root.mccStateParams.product.ProductName}}</li>\n                            <li ng-if="::$root.mccStateParams.product.Features.CodeBankCompare">\n                                <button type="button" class="button-unstyled btn-block" ng-click="vm.showChangedDocs()"><i class="md md-call-split"></i> Recent Changes</button>\n                            </li>\n                            <li ng-if="::!$root.mccStateParams.product.Features.CodeBankCompare" class="disabled">\n                                <button type="button" class="button-unstyled btn-block" ng-click="vm.noShowChangesClick()"><i class="md md-call-split"></i> Recent Changes</button>\n                            </li>\n                            <li>\n                                <button type="button" class="button-unstyled btn-block" ng-click="vm.pendingAmendmentsClick()"><i class="fa fa-gavel"></i> Pending Amendments</button>\n                            </li>\n                            <li ng-if="::$root.mccStateParams.product.Features.CodeBank">\n                                <button type="button" class="button-unstyled btn-block" ng-click="vm.codebankFlyoverClick()"><i class="md md-restore"></i> Previous Versions</button>\n                            </li>\n                            <li ng-if="::!$root.mccStateParams.product.Features.CodeBank" class="disabled">\n                                <button type="button" class="button-unstyled btn-block" ng-click="vm.codebankFlyoverClick()"><i class="md md-restore"></i> Previous Versions</button>\n                            </li>\n                            <li class="divider"></li>\n                            <li class="smaller-padding text-default-light text-medium">MuniPRO</li>\n                            <li ng-class="{disabled:!vm.munipro}">\n                                <a ng-href="{{vm.savedSearchesUrl}}"><i class="fa fa-user"></i> My Saved Searches</a>\n                            </li>\n                            <li ng-class="{disabled:!vm.munipro}">\n                                <a ng-href="{{vm.manageDraftsUrl}}"><i class="fa fa-user"></i> My Drafts</a>\n                            </li>\n                            <li ng-class="{disabled:!vm.munipro}">\n                                <a ng-href="{{vm.manageNotesUrl}}"><i class="fa fa-user"></i> My Notes</a>\n                            </li>\n                            <li class="divider"></li>\n                            <li>\n                                <button type="button" class="button-unstyled btn-block" ng-click="vm.showWalkthroughClick()"><i class="fa fa-map"></i> Show Walkthrough</button>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n\n<div class="zones" mcc-zone-mgr>\n    <nav aria-label="Table of Contents" id="toc" class="toc-zone zone secondary-zone style-default-light" ng-if="!$root.viewportHelper.isMobile() || $root.zoneMgrSvc.isTocZoneVisibleOnMobile">\n        <div class="zone-head toc-zone-head">\n            <div id="codebankToggle" class="zone-head-product hidden-xs hidden-sm" data-intro="Switch between old and current versions." data-placement="right" data-position="right">\n                <button ng-if="::$root.mccStateParams.product.Features.CodeBank"\n                        type="button"\n                        ng-click="vm.codebankClick()"\n                        class="btn btn-primary btn-flat"\n                        data-bootstrap-tooltip=""\n                        data-trigger="hover"\n                        data-container="body"\n                        title="CodeBank">\n                    <span class="text-sm text-muted">version:</span> {{::$root.mccStateParams.job.OnlineDate | date:longDate}} \n                    <span ng-if="$root.mccStateParams.publicationVersion.isLatest">(current)</span>\n                    <span ng-if="!$root.mccStateParams.publicationVersion.isLatest && $root.mccStateParams.publicationVersion.isPublished">(archive)</span>\n                    <div ng-if="!$root.mccStateParams.publicationVersion.isPublished" class="badge style-danger ng-scope">Unpublished</div>\n                    <i class="fa fa-caret-down"></i>\n                </button>\n                <button ng-if="::!$root.mccStateParams.product.Features.CodeBank"\n                        type="button"\n                        ng-click="vm.noCodebankClick()"\n                        data-bootstrap-tooltip=""\n                        data-trigger="hover"\n                        data-container="body"\n                        title="This municipality does not subscribe to the CodeBank feature."\n                        class="btn btn-primary btn-flat disabled"\n                        data-position="right"\n                        style="pointer-events: auto;">\n                    <span class="text-sm text-muted">version:</span> {{::$root.mccStateParams.publicationVersion.onlineDate | date:longDate}} \n                    <span ng-if="$root.mccStateParams.publicationVersion.isLatest">(current)</span>\n                    <span ng-if="!$root.mccStateParams.publicationVersion.isLatest && $root.mccStateParams.publicationVersion.isPublished">(archive)</span>\n                    <div ng-if="!$root.mccStateParams.publicationVersion.isPublished" class="badge style-danger ng-scope">Unpublished</div>\n                    <i class="fa fa-caret-down"></i>\n                </button>\n            </div>\n            <div class="btn-group pull-right">\n                <button type="button" class="btn btn-flat" id="print-download-toc" style="color: #464a4f;" bootstrap-tooltip data-trigger="hover" data-title="Print or download table of contents" data-placement="bottom" data-container="body" ng-click="vm.codesTocSaveOrPrintModalShow()">\n                    <span class="fa-stack fa-stack-custom">\n                        <i class="fa fa-print fa-stack fa-stack-custom" style="font-size: 11pt;"></i>\n                        <i class="btb bt-circle-arrow-down fa-stack-1x" style="left: 5px; top: 12px; font-size: 7pt;"></i>\n                    </span>\n                    <span class="visually-hidden">Print or Download Table of Contents</span>\n                </button>\n                <button type="button" aria-controls="toc" aria-expanded={{!!$root.zoneMgrSvc.isTocZoneOpen()}} ng-click="$root.zoneMgrSvc.toggleTocZone()" class="btn btn-flat opacity-75" bootstrap-tooltip data-title="Show or hide table of contents" data-placement="bottom" data-container="body" data-trigger="hover" aria-label="Show or hide table of contents">\n                    <i class="fa fa-arrows-h"></i>\n                </button>\n            </div>\n        </div>\n        <div class="zone-body toc-zone-body">\n            <div class="product-info">\n                <h2 class="product-info-heading hidden-md hidden-lg hidden-xl">\n                    <span class="client text-sm hidden-md hidden-lg hidden-xl">{{::$root.mccStateParams.client.ClientName}}, {{::$root.mccStateParams.state.StateAbbreviation}}<br/></span>\n                    <span class="product text-xs">{{::$root.mccStateParams.product.ProductName}}</span>\n                </h2>\n                <div class="text-center">\n                    <span> </span>\n                </div>\n            </div>\n            <div class="toc-wrapper">\n                <div ng-if="vm.codebankActive">\n                    <button type="button" class="btn btn-icon-toggle btn-default pull-right" ng-click="vm.codebankActive = false">\n                        <i class="md md-close"></i>\n                        <span class="visually-hidden">Close</span>\n                    </button>\n                    <h3 class="text-center timeline-header">\n                        <i class="md md-restore"> </i> Code Versions\n                    </h3>\n                    <mcc-codebank></mcc-codebank>\n                </div>\n                <mcc-codes-toc class="" ng-show="!vm.codebankActive"/>\n            </div>\n        </div>\n    </nav>\n\n    <mcc-main-content class="primary content-zone zone style-default-bright" ng-if="!$root.viewportHelper.isMobile() || !$root.zoneMgrSvc.isTocZoneVisibleOnMobile">\n        <div id="codesContentContainer" class="zone-body primary-zone-body">\n            \n            <mcc-codes-content></mcc-codes-content>\n        </div>\n        <div class="zone-foot">\n            <mcc-search-results-nav content-ready-event="\'contentReady\'"></mcc-search-results-nav>\n        </div>\n    </mcc-main-content>\n</div>\n\n<div class=\'print-frame-content\'>\n\n    <iframe id=\'tablePrintFrame\' style=\'border:none;\' height=\'0\' width=\'0\'></iframe>\n\n    <iframe id=\'tocPrintFrame\' style=\'border:none;\' height=\'0\' width=\'0\'></iframe>\n\n</div>\n'),e.put("/library/ng-apps/library_desktop/codes/codes_action_menu.cshtml",'<div>\n    \n    <div ng-if="mccStateParams.product.Features.CodeBankCompare" class="navbar-btn" style="display:inline-block" ng-click="toggleShowChanges()">\n        <input mcc-boot-strap-toggle="" data-on-if-true="$stateParams.showChanges" data-width="178" data-on="<i class=\' fa fa-strikethrough\'></i>Show Changes: ON "\n        data-off="<i class=\' fa fa-strikethrough\'></i>Show Changes: OFF "\n        type="checkbox" data-toggle="toggle" data-onstyle="success" data-offstyle="default">\n    </div>\n    <button ng-if="mccStateParams.product.Features.PublicationNotifications" type="button" class="btn btn-default navbar-btn" data-ng-click="model.notifyMeClick()"><i class="fa fa-envelope-o"></i> Notify Me <span class="label label-success">new!</span> </button>\n\n</div>\n<style>\n    mcc-codes-actions{\n        display:block;\n    }\n</style>\n<div class="tools">\n    <div class="btn-group" ng-if="model.codesParams.pageType==\'CHUNKS\'">\n        <span style="display:inline-block; float: left; line-height: 36px;">Show Changes</span>\n        <a class="btn btn-icon-toggle" ng-class="{\'disabled\' : !model.actions.canShowChanges}"><i class="fa fa-toggle-off" ng-class="{\'fa-toggle-on\' : $stateParams.showChanges, \'fa-toggle-off\': !$stateParams.showChanges}"></i></a>\n        <a class="btn btn-icon-toggle" ng-class="{\'disabled\' : !model.actions.canPrint}"><i class="fa fa-print"></i></a>\n        <a class="btn btn-icon-toggle" ng-class="{\'disabled\' : !model.actions.canShare}"><i class="fa fa-share-alt"></i></a>\n        <a class="btn btn-icon-toggle" ng-class="{\'disabled\' : !model.actions.canEmail}"><i class="fa fa-envelope-o"></i></a>\n        <a class="btn btn-icon-toggle" ng-class="{\'disabled\' : !model.actions.canDownload}"><i class="fa fa-cloud-download"></i></a>\n        <a class="btn btn-icon-toggle" ng-class="{\'disabled\' : !model.actions.canCompare}"><i class="md md-content-copy"></i></a>\n    </div>\n    <div class="btn-group" ng-if="model.codesParams.pageType==\'STATIC_DOCUMENT\'">\n        <a class="btn btn-icon-toggle" ng-class="{\'disabled\' : !model.actions.canStaticPrint}"><i class="fa fa-print"></i></a>\n        <a class="btn btn-icon-toggle" ng-class="{\'disabled\' : !model.actions.canStaticDownload}"><i class="fa fa-cloud-download"></i></a>\n    </div>\n</div>\n'),e.put("/library/ng-apps/library_desktop/codes/codes_content.cshtml",'<div id="codesContent" ng-switch="vm.pageType">\n    <div role="alert">\n        <div class="alert alert-warning" data-ng-if="vm.error" style="position:fixed;">{{ vm.error }}</div>\n    </div>\n    <div role="alert" ng-switch-when="CONTENT_NOT_FOUND">\n        <h2 class="alert alert-danger"><i class="fa fa-fighter-jet"></i> Content Not Found</h2>\n        <p class="text-lg">We\'re sorry, but we can\'t find the content you\'re looking for via this link.</p>\n        <p>Please use the table of contents or the search box to find what you\'re looking for.</p>\n        <p>\n            <button type="button" class="btn btn-primary" ng-click="$root.$state.go(\'.\', {nodeId: null})">\n                Start\n                Over\n            </button>\n        </p>\n    </div>\n    <div ng-switch-when="PRODUCT_LANDING_PAGE" class="codes-product-pg">\n        <mcc-codes-content-landing-page></mcc-codes-content-landing-page>\n    </div>\n    <div ng-switch-when="STATIC_DOCUMENT" class="codes-static-doc">\n        <div class="clearfix" tabindex="-1">\n            <h2 id="_{{vm.firstDoc.Id}}" class="pull-left" data-skip-id="_{{vm.firstDoc.Id}}" tabindex="-1">{{ vm.content.title }}</h2>\n            <div class="pull-right">\n                <div class="btn-group action-bar text-primary">\n                    <a ng-href="{{vm.content.staticUrl}}" target="_blank" class="btn btn-icon-toggle hidden-xs"\n                       data-toggle="tooltip" data-trigger="hover" title="Open document in new window">\n                        <i class="fa fa-external-link"></i>\n                    </a>\n                    <button type="button" class="btn btn-icon-toggle" ng-click="vm.shareLinkClick()"\n                            data-toggle="tooltip" data-trigger="hover" title="Share link">\n                        <i class="fa fa-link"></i>\n                    </button>\n                </div>\n            </div>\n        </div>\n\n        <div ng-if="!$root.viewportHelper.isXSmall()">\n            \n            <iframe style="width: 100%; height: calc(100vh - 192px); border: 1px solid;" id="{{\'codes_embed\'+vm.content.title}}"\n                    ng-src="{{vm.content.staticUrl}}">\n            </iframe>\n        </div>\n        <div class="visible-xs-block">\n            <p>\n                <a href="" ng-href="{{vm.getPdfDownloadUrl(vm.content.staticUrl)}}"\n                   class="btn btn-raised btn-primary">\n                    <i class="fa fa-file-pdf-o"></i> View PDF\n                </a>\n            </p>\n        </div>\n        <div ng-include="\'codesNavTemplate\'"></div>\n    </div>\n    <div ng-switch-when="STATIC_HTML" tabindex="-1">\n        <h2 id="_{{vm.firstDoc.Id}}" class="visually-hidden" data-skip-id="_{{vm.firstDoc.Id}}" tabindex="-1">\n            {{ vm.firstDoc.Title }}\n        </h2>\n        <div mcc-static-html-content-viewer="{{vm.content.staticUrl}}"></div>\n        <div ng-include="\'codesNavTemplate\'"></div>\n    </div>\n    <div ng-switch-when="TOC" class="small-padding" tabindex="-1">\n        <div ng-include="\'codesNavTemplate\'"></div>\n        <ul class="chunks list-unstyled small-padding" ng-if="vm.miniTocRootChunks.length">\n            <li data-ng-repeat="chunk in vm.miniTocRootChunks">\n                <mcc-codes-content-chunk mindepth="{{vm.miniTocRoot.NodeDepth}}" hide-compare-action="true"></mcc-codes-content-chunk>\n            </li>\n        </ul>\n        <div class="chunk-heading" tabindex="-1" ng-if="!vm.miniTocRootChunks.length">\n            <mcc-codes-title-wrapper\n                mindepth="vm.miniTocRoot.NodeDepth"\n                nodedepth="vm.miniTocRoot.NodeDepth"\n                chunkid="vm.miniTocRoot.Id"\n                titlehtml="vm.miniTocRootTitleHtml">\n            </mcc-codes-title-wrapper>\n        </div>\n        <div class="codes-toc" ng-if="vm.docs.length">\n            <ul class="codes-toc-list list-unstyled">\n                <li ng-repeat="(index, doc) in vm.docs | limitTo: vm.tocLimit track by doc.Id" id="codeToc_{{::doc.Id}}"\n                    nodedepth="{{::doc.NodeDepth}}" style="width: 100%;">\n                    <mcc-codes-content-mini-toc-item></mcc-codes-content-mini-toc-item>\n                </li>\n            </ul>\n            <p>\n                <button type="button" class="btn btn-raised btn-primary" ng-click="vm.tocLoadMoreClick()"\n                        ng-show="vm.tocLimit < vm.docs.length">\n                    Load more\n                </button>\n            </p>\n        </div>\n        <div ng-include="\'codesNavTemplate\'"></div>\n    </div>\n    <div ng-switch-when="CHUNKS" class="codes-chunks-pg">\n        <div ng-include="\'codesNavTemplate\'"></div>\n        <ul class="chunks list-unstyled small-padding">\n            <li data-ng-repeat="chunk in vm.content.chunks">\n                <mcc-codes-content-chunk mindepth="{{vm.firstDoc.NodeDepth}}"></mcc-codes-content-chunk>\n            </li>\n        </ul>\n        <div ng-include="\'codesNavTemplate\'"></div>\n    </div>\n</div>\n\n<script id="codesNavTemplate" type="text/ng-template">\n        <div class="chunk-nav clearfix text-primary">\n            <a class="pull-left text-left" href="" ng-href="{{vm.getHref(vm.content.prevNode)}}" ng-if="vm.content.prevNode"><i class="fa fa-angle-left fa-fw"></i> {{ vm.content.prevNode.Heading }}</a>\n            <a class="pull-right text-right" href="" ng-href="{{vm.getHref(vm.content.nextNode)}}" ng-if="vm.content.nextNode">{{ vm.content.nextNode.Heading }} <i class="fa fa-angle-right fa-fw"></i></a>\n        </div>\n<\/script>\n'),e.put("/library/ng-apps/library_desktop/codes/codes_content_chunk.cshtml",'<div id="c_{{::chunk.Id}}" class="chunk" data-nodetype="{{::chunk.ChunkLevel}}" data-nodedepth="{{::chunk.NodeDepth}}" ng-switch="::chunk.DocType">\n    <span id="contentAnchor_{{::chunk.Id}}" class="anchor-offset"></span>\n    <div ng-switch-when="1">\n        <div class="chunk-heading" tabindex="-1" ng-init="htmlChunkInit()">\n            <mcc-codes-title-wrapper  \n            mindepth="minDepth"\n            nodedepth="::chunk.NodeDepth"\n             chunkid="::chunk.Id"\n            titlehtml="chunkVm.titleHtml"\n            ng-class="{\'ins\': $root.mccStateParams.product.Features.CodeBankCompare && $root.$stateParams.showChanges && chunk.CompareStatus == 0}"></mcc-Codes-Title-Wrapper>\n            <div ng-if="::$root.mccStateParams.product.Features.CodeBankCompare">\n                <span class="label label-success" ng-if="::chunk.CompareStatus == 0">new</span>\n                <span class="label label-primary" ng-if="::chunk.CompareStatus == 2">modified</span>\n            </div>\n\n\n            <div class="mcc_codes_content_action_bar">\n\n                <div class="btn-group action-dropdown hidden-sm hidden-md hidden-lg hidden-xl">\n                    <button type="button" class="btn btn-icon-toggle ink-reaction dropdown-toggle btn-primary" data-toggle="dropdown" aria-hidden="true" aria-popup="true" aria-label="Document actions menu">\n                        <i class="fa fa-ellipsis-v"></i>\n                    </button>\n                    <ul class="dropdown-menu pull-right animation-expand">\n                        <li ng-if="::codesVm.docActions.sharelink.enabled">\n                            <button type="button" class="codes-action-menu-btn button-unstyled btn-block" data-actionId="sharelink"><i class="fa fa-link"></i> Share Link</button>\n                        </li>\n                        <li ng-if="::codesVm.docActions.print.enabled">\n                            <button type="button" class="codes-action-menu-btn button-unstyled btn-block" data-actionId="print"><i class="fa fa-print"></i> Print</button>\n                        </li>\n                        <li ng-if="::codesVm.docActions.downloaddocx.enabled">\n                            <button type="button" class="codes-action-menu-btn button-unstyled btn-block" data-actionId="downloaddocx"><i class="fa fa-file-word-o"></i> Download (docx)</button>\n                        </li>\n                        <li ng-if="::codesVm.docActions.email.enabled">\n                            <button type="button" class="codes-action-menu-btn button-unstyled btn-block" data-actionId="email"><i class="fa fa-envelope-o"></i> Email</button>\n                        </li>\n                        <li ng-if="::!hideCompareAction && codesVm.docActions.compare.enabled">\n                            <button type="button" class="codes-action-menu-btn button-unstyled btn-block" data-actionId="compare"><i class="fa fa-copy"></i> Compare</button>\n                        </li>\n                        <li ng-if="codesVm.docActions.addNote.enabled">\n                            <button type="button" class="codes-action-menu-btn button-unstyled btn-block" data-actionId="addNote"><i class="fa fa-pencil"></i> Add Note</button>\n                        </li>\n                        <li ng-if="codesVm.docActions.addNote.enabled">\n                            <button type="button" class="codes-action-menu-btn button-unstyled btn-block" data-actionId="addDraft"><i class="fa fa-file-text-o"></i>Add Draft</button>\n                        </li>\n                    </ul>\n                </div>\n                \x3c!--delegated listener in codesContent2--\x3e\n                <div class="btn-group action-bar text-primary hidden-xs pull-right">\n                    <button type="button" class="btn btn-icon-toggle codes-action-menu-btn" data-actionId="sharelink" ng-if="::codesVm.docActions.sharelink.enabled" data-toggle="tooltip" data-trigger="hover" title="Share link">\n                        <i class="fa fa-link"></i>\n                        <span class="sr-only">Share Link to section</span>\n                    </button>\n                    <button type="button" class="btn btn-icon-toggle codes-action-menu-btn" data-actionId="print" ng-if="::codesVm.docActions.print.enabled" data-toggle="tooltip" data-trigger="hover" title="Print">\n                        <i class="fa fa-print"></i>\n                        <span class="sr-only">Print section</span>\n                    </button>\n                    <button type="button" class="btn btn-icon-toggle codes-action-menu-btn" data-actionId="downloaddocx" ng-if="::codesVm.docActions.downloaddocx.enabled" data-toggle="tooltip" data-trigger="hover" title="Download (Docx)">\n                        <i class="fa fa-file-word-o"></i>\n                        <span class="sr-only">Download (Docx) of sections</span>\n                    </button>\n                    <button type="button" class="btn btn-icon-toggle codes-action-menu-btn" data-actionId="email" ng-if="::codesVm.docActions.email.enabled" data-toggle="tooltip" data-trigger="hover" title="Email">\n                        <i class="fa fa-envelope-o"></i>\n                        <span class="sr-only">Email section</span>\n                    </button>\n                    <button type="button" class="btn btn-icon-toggle codes-action-menu-btn" data-actionId="compare" ng-if="::!hideCompareAction && codesVm.docActions.compare.enabled" data-toggle="tooltip" data-trigger="hover" title="Compare versions">\n                        <i class="fa fa-copy"></i>\n                        <span class="sr-only">Compare versions</span>\n                    </button>\n                    <button type="button" class="btn btn-icon-toggle codes-action-menu-btn" data-actionId="addNote" ng-if="codesVm.docActions.addNote.enabled" data-toggle="tooltip" data-trigger="hover" title="Add note">\n                        <i class="fa fa-pencil"></i>\n                        <span class="sr-only">Add Note</span>\n                    </button>\n                    <button type="button" class="btn btn-icon-toggle codes-action-menu-btn" data-actionId="addDraft" ng-if="codesVm.docActions.addDraft.enabled" data-toggle="tooltip" data-trigger="hover" title="Add draft">\n                        <i class="fa fa-file-text-o"></i>\n                        <span class="sr-only">Add Draft</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n\n\n        <div ng-if="chunk.Notes.length">\n            <div data-ng-repeat="note in chunk.Notes" class="bs-callout bs-callout-info">\n                <div ng-if="codesVm.docActions.addNote.enabled && note.CanEdit">\n                    <i ng-class="{ \'fa\': true, \'fa-globe\': note.IsPublic, \'fa-lock\': !note.IsPublic}" ng-if="codesVm.contentPublisher && codesVm.productUser"></i>\n                    <strong>Note saved on {{note.RecordedDate | date: \'shortDate\'}}</strong><strong> {{ (codesVm.contentPublisher && codesVm.productUser) ? " | Visibility: " + (note.IsPublic ? "PUBLIC" : "PRIVATE") : ""}}</strong>\n                    <a class="btn btn-link btn-sm" href="" ng-href="{{codesVm.manageNotesUrl}}" target="_self">Manage</a>\n                    <button type="button" class="btn btn-flat btn-sm" ng-click="confirmDeleteNote = true"><i class="fa fa-trash"></i> Delete</button>\n                    <span ng-show="confirmDeleteNote">\n                        <button type="button" class="btn btn-flat btn-sm btn-danger" ng-click="vm.deleteNote(note)">Are you sure?</button>\n                        <button type="button" class="btn btn-flat btn-sm" ng-click="confirmDeleteNote = false">Cancel</button>\n                    </span>\n                </div>\n                <div data-ng-bind-html="note.Note"></div>\n            </div>\n        </div>\n        <div ng-if="chunk.Drafts.length">\n            <div ng-repeat="draft in chunk.Drafts" class="alert alert-callout alert-warning">\n                <strong>Draft saved on {{draft.RecordedDate | date: \'shortDate\'}}</strong> {{draft.Title}} |\n                <a class="btn btn-link btn-sm" href="" ng-href="{{codesVm.manageDraftsUrl}}" target="_self">Manage</a>\n                <button type="button" class="btn btn-flat btn-sm" ng-click="confirmDeleteDraft = true"><i class="fa fa-trash"></i> Delete</button>\n                <span ng-show="confirmDeleteDraft">\n                    <button type="button" class="btn btn-flat btn-sm btn-danger" ng-click="vm.deleteDraft(draft, chunk.Drafts)">Are you sure?</button>\n                    <button type="button" class="btn btn-flat btn-sm" ng-click="confirmDeleteDraft = false">Cancel</button>\n                </span>\n            </div>\n        </div>\n        <ul class="mcc-list amended-by" ng-if="::($root.mccStateParams.product.LandingPageID == 3 && chunk.AmendedBy.length > 0)">\n            <li data-ng-repeat="amendingOrd in chunk.AmendedBy">\n                <div class="action icon" ng-click="vm.ordClickById(amendingOrd.Id)">\n                    <span class="label label-primary">Amended by</span> <span ng-bind="::amendingOrd.Title"></span>\n                    <div class="icon">\n                        <i class="fa fa-chevron-right"></i>\n                    </div>\n                </div>\n            </li>\n        </ul>\n        <div class="chunk-content-wrapper" ng-class="{\'ins\': $root.mccStateParams.product.Features.CodeBankCompare && $root.$stateParams.showChanges && chunk.CompareStatus == 0}"></div>\n    </div>\n    <div ng-switch-when="2">\n        <div class="chunk-heading" tabindex="-1" ng-init="pdfChunkIsReady()">\n            <div class="chunk-title-wrapper">\n                <mcc-Codes-Title-Wrapper nodedepth="::chunk.NodeDepth"\n                                         titlehtml=" ::chunk.Title" \n                                         chunkid="::chunk.Id"></mcc-Codes-Title-Wrapper>\n            </div>\n        </div>\n        <div class="chunk-content-wrapper">\n            <p>\n                <a href="" ng-href="{{vm.getHref(chunk)}}" target="_self" class="btn btn-flat"><i class="fa fa-file-pdf-o"></i> View PDF</a>\n            </p>\n        </div>\n    </div>\n</div>\n'),e.put("/library/ng-apps/library_desktop/codes/codes_content_landing_page.cshtml",'<div class="row">\n    \x3c!-- Integrations - mobile view --\x3e\n    <div ng-if="vm.showIntegrations" class="visible-xs-block visible-md-block">\n        <div class="row">\n            <div class="col-xs-12" ng-repeat="integration in vm.integrations track by $index">\n                <div class="card">\n                    <div class="card-body small-padding">\n                        <div class="row">\n                            <div class="col-xs-8 text-left">\n                                <button type="button" class="button-unstyled" ng-click="integration.showContent = !integration.showContent" aria-label="{{integration.ariaLabels.icon}}" aria-expanded="{{integration.showContent}}">\n                                    <i class="fa fa-chevron-down" ng-show="integration.showContent"></i>\n                                    <i class="fa fa-chevron-right" ng-show="!integration.showContent"></i>\n                                </button>\n                                <span style="font-weight: bold; margin-left: 5px;" ng-bind="integration.name"></span>\n                            </div>\n                            <div class="col-xs-4 text-right">\n                                <a class="btn btn-success btn-raised btn-xs" role="button" ng-href="{{::integration.url}}" target="_blank" aria-label="{{integration.ariaLabels.viewButton}}" style="margin-right: 5px;" aria-describedby="integration-description-mobile-{{$index}}">\n                                    <i class="fa fa-external-link"></i> View\n                                </a>\n                            </div>\n                        </div>\n                        <div id="integration-description-mobile-{{$index}}" ng-show="integration.showContent">\n                            <p class="text-center" style="margin-top: 10px; margin-bottom: 5px;" ng-bind="integration.description"></p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    \x3c!-- Main content --\x3e\n    <div class="col-sm-9 col-md-12 col-lg-9">\n        <div id="c_{{::$root.mccStateParams.product.ProductID}}" class="doc" style="display:table; width:100%;">\n            <h2 id="_{{::$root.mccStateParams.product.ProductID}}" style="display:table-cell; vertical-align:middle;" data-skip-id="_{{::$root.mccStateParams.product.ProductID}}" tabindex="-1">\n                <span ng-bind="::$root.mccStateParams.product.ProductName"></span><br/>\n                <small ng-bind="::$root.mccStateParams.job.Name"></small><br/>\n                <small ng-if="$root.mccStateParams.product.Features.ShowLastModifiedPublicationDate" \n                       class="product-date"\n                       ng-bind="::\'Online content updated on \' + ($root.mccStateParams.job.OnlineDate | date:\'longDate\') ">\n                </small>\n            </h2>\n            <div class="mcc_codes_content_action_bar">\n                <div class="btn-group action-dropdown hidden-sm hidden-md hidden-lg hidden-xl">\n                    <button type="button" class="btn btn-icon-toggle ink-reaction dropdown-toggle btn-primary"\n                            data-toggle="dropdown" aria-hidden="true" aria-popup="true" aria-label="Document actions menu">\n                        <i class="fa fa-ellipsis-v"></i>\n                    </button>\n                    <ul class="dropdown-menu pull-right animation-expand">\n                        <li ng-if="::codesVm.docActions.sharelink.enabled">\n                            <button type="button" class="doc-action-menu-btn button-unstyled btn-block" data-actionId="sharelink">\n                                <i class="fa fa-link"></i>\n                                Share Link\n                            </button>\n                        </li>\n                        <li ng-if="codesVm.docActions.addNote.enabled">\n                            <button type="button" class="doc-action-menu-btn button-unstyled btn-block" data-actionId="addNote">\n                                <i class="fa fa-pencil"></i> Add\n                                Note\n                            </button>\n                        </li>\n                    </ul>\n                </div>\n                \x3c!--delegated listener in codesContent2--\x3e\n                <div class="btn-group action-bar text-primary hidden-xs pull-right">\n                    <button type="button" class="btn btn-icon-toggle docs-action-menu-btn" data-actionId="sharelink"\n                            ng-if="::codesVm.docActions.sharelink.enabled" data-toggle="tooltip" data-trigger="hover" title="Share link">\n                        <i class="fa fa-link"></i><span class="sr-only">Share Link to section</span>\n                    </button>\n                    <button type="button" class="btn btn-icon-toggle docs-action-menu-btn" data-actionId="addNote"\n                            ng-if="codesVm.docActions.addNote.enabled" data-toggle="tooltip" data-trigger="hover" title="Add note">\n                        <i class="fa fa-pencil"></i><span class="sr-only">Add Note</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n        <div class="bannerText">\n            <div data-ng-switch="::vm.content.bannerSource">\n                <p data-ng-switch-when="bannerText" data-ng-bind-html="::$root.mccStateParams.job.BannerText">\n                </p>\n                <p data-ng-switch-when="adoptionDate">\n                    Codified through Ordinance No. {{::vm.content.LastOrd.DocumentTitle}}, adopted\n                    {{ vm.content.LastOrd.AdoptionDate | date: \'longDate\'}}\n                </p>\n            </div>\n        </div>\n        <div class="container-fluid">\n            <div class="row">\n                <div ng-if="$root.mccStateParams.product.Features.CodeBankCompare" class="col-sm-6">\n                    <button type="button" class="btn btn-success btn-raised" ng-click="vm.showChangedDocsClick()">\n                        <i class="fa fa-strikethrough"></i> View what\'s changed\n                    </button>\n                </div>\n                <div class="col-sm-6 hidden-md hidden-lg hidden-xl" style="margin-top: 8px;">\n                    <button type="button" class="btn btn-raised btn-primary" ng-click="$root.zoneMgrSvc.toggleVisibleZone()">\n                        <i class="fa fa-list-ul"></i> Browse table of contents\n                    </button>\n                </div>\n            </div>\n        </div>\n\n        <p ng-if="$root.mccStateParams.product.Disclaimer" style="margin-top:20px; margin-bottom:20px;">\n            <em ng-bind-html="::$root.mccStateParams.product.Disclaimer"></em>\n        </p>\n\n        \x3c!-- show any private or public notes --\x3e\n        <div ng-if="vm.content.Docs[0].Notes && vm.content.Docs[0].Notes.length">\n            <div ng-repeat="note in vm.content.Docs[0].Notes track by note.Id" class="bs-callout bs-callout-info">\n                <div ng-if="codesVm.docActions.addNote.enabled && note.CanEdit">\n                    <i ng-class="{ \'fa\': true, \'fa-globe\': note.IsPublic, \'fa-lock\': !note.IsPublic}"\n                       ng-if="codesVm.contentPublisher && codesVm.productUser">\n                    </i>\n                    <strong>Note saved on {{ note.RecordedDate | date: \'shortDate\'}}</strong>\n                    <strong>\n                        {{ (codesVm.contentPublisher && codesVm.productUser) ? " | Visibility: " + (note.IsPublic ? "PUBLIC" : "PRIVATE") : ""}}\n                    </strong>\n                    <a class="btn btn-link btn-sm" href="" ng-href="{{codesVm.manageNotesUrl}}">Manage</a>\n                    <button type="button" class="btn btn-flat btn-sm" ng-click="confirmDeleteNote = true">\n                        <i class="fa fa-trash"></i> Delete\n                    </button>\n                    <span ng-show="confirmDeleteNote">\n                        <button type="button" class="btn btn-flat btn-sm btn-danger" ng-click="vm.deleteNote(note)">\n                            Are you\n                            sure?\n                        </button>\n                        <button type="button" class="btn btn-flat btn-sm"\n                                ng-click="confirmDeleteNote = false">\n                            Cancel\n                        </button>\n                    </span>\n                </div>\n                <div data-ng-bind-html="note.Note"></div>\n            </div>\n        </div>\n\n\n        <div ng-if="vm.content.NewOrds && vm.content.NewOrds.length">\n            <h3>Adopted Ordinances Not Yet Codified</h3>\n            <div class="alert alert-callout alert-info" ng-if="vm.isMeetingsClient">\n                <span class="label label-primary" style="vertical-align: middle;">new</span> Ordinances tagged with\n                <span class="label label-primary" style="vertical-align: middle;"><i class="fa fa-users"></i> meeting</span> will include extra meeting details.\n            </div>\n            <p data-once-html="$root.mccStateParams.product.WebIntro"></p>\n            <div id="new-ords" class="list-group"\n                 data-intro="Browse ordinances that have been enacted but not yet codified as part of the online code."\n                 data-position="top">\n                <a href="" ng-href="{{::vm.getOrdHref(ord)}}" class="list-group-item"\n                   ng-repeat="ord in vm.content.NewOrds">\n                    <span class="pull-right left-space">\n                        <i class="fa fa-chevron-right"></i>\n                    </span>\n                    <div style="display: flex; flex-direction: row;">\n                        <h4 class="list-group-item-heading" data-once-text="ord.Title"></h4>\n                        <div ng-if="ord.Meetings || ord.MeetingUrl" style="margin-left: 4px;">\n                            <span class="label label-primary" style="vertical-align: text-top;"><i class="fa fa-users" style="margin-right: 0px;"></i> meeting</span>\n                        </div>\n                    </div>\n                    <p data-ng-show="ord.AdoptionDate"\n                       data-once-text="\'Adopted \' + (ord.AdoptionDate | date: \'shortDate\')">\n                    </p>\n                    <p data-once-text="ord.Description"></p>\n                    <p data-once-if="ord.AmendedSections.length"\n                       data-once-text="ord.AmendedSections.length + \' section(s) amended\'">\n                    </p>\n                </a>\n            </div>\n        </div>\n    </div>\n\n    \x3c!-- Integrations - desktop view --\x3e\n    <div ng-if="vm.showIntegrations" class="col-sm-3 visible-sm-block visible-lg-block">\n        <div class="row" style="padding-left: 15px;">\n            <div class="col-xs-12 text-center" ng-repeat="integration in vm.integrations track by $index">\n                <div class="card">\n                    <div class="card-head style-default-light">\n                        <header>{{::integration.name}}</header>\n                    </div>\n                    <div class="card-body small-padding">\n                        <p id="integration-description-{{$index}}" class="text-center">\n                            {{::integration.description}}\n                        </p>\n                        <a class="btn btn-success btn-raised" role="button" ng-href="{{::integration.url}}" target="_blank" aria-label="{{::integration.ariaLabels.viewButton}}" aria-describedby="integration-description-{{$index}}">\n                            <i class="fa fa-external-link"></i> View\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n'),e.put("/library/ng-apps/library_desktop/codes/codes_content_mini_toc_item.cshtml",'<div style="display: table; width: 100%;">\n    <div class="chunk-title-wrapper" style="display: table-cell;">\n        <a id="_{{doc.Id}}" href="" ng-href="{{::vm.getHref(doc)}}" data-skip-id="_{{doc.Id}}">{{::doc.Title}}</a>\n        <span ng-if="::($root.mccStateParams.product.LandingPageID == 3 && doc.IsAmended)" class="label label-primary">amended</span>\n        <span ng-if="::($root.mccStateParams.product.Features.CodeBankCompare && doc.CompareStatus == 2)" class="label label-primary">modified</span>\n        <span ng-if="::($root.mccStateParams.product.Features.CodeBankCompare && doc.CompareStatus == 0)" class="label label-success">new</span>\n    </div>\n</div>\n'),e.put("/library/ng-apps/library_desktop/codes/codes_email.cshtml",'<style>\nmcc-codes-email{\n    display: block;\n    height: 100%;\n}\n\n.email-body{\n    height: 100%;\n}\n\n.email-footer{\n    padding: 10px;\n    text-align: right;\n}\n.has-error .validationIndicator {\n    color: #E60A15;\n}\n\n        .validationIndicator {\n   color: #067F16;\n}\n\n.auxLabel {\n    margin-right: 5px;\n}\n\n.validationIndicator {\n    position: relative;\n    top: -1px;\n    font-size: 18px;\n}\n\n.validationIndicator .fa-times { /*fa-times*/\n    position: relative;\n    top: 4px;\n}\n\n.validationIndicator .fa-check { /*fa-check*/\n    position: relative;\n    top: 4px;\n}\n\n.tag-item {\n    background: #096fcc !important;\n    border-color: #096fcc !important;\n}\n\n.remove-button, .remove-button:hover {\n    color: #fff !important;\n}\n\n.links {\n    color: #096fcc !important;\n}\n\n.extra-margin {\n    margin-top: 5px;\n    margin-bottom: 5px;\n}\n\n\ntags-input .tags .input {\n    width: 100% !important;\n    padding: 0 !important;\n    height: 37px !important;\n    border-left: none !important;\n    border-right: none !important;\n    border-top: none !important;\n    background: transparent !important;\n    color: #0c0c0c !important;\n    font-size: 16px !important;\n    border-bottom: 1px solid rgba(12, 12, 12, 0.12) !important;\n    -webkit-box-shadow: none !important;\n    box-shadow: none !important;\n}\n\ntags-input .tags .input:focus {\n    border-color: #096fcc !important;\n    outline: 0 !important;\n    box-shadow: none !important;\n}\n\ntags-input .tags {\n    border: none !important;\n    border-radius:1px !important;\n    box-shadow: none !important;\n}\n\ntags-input .tags .input.invalid-tag {\n    color: #d0291c !important;\n}\n\ntags-input.invalid .tags .input {\n    border-bottom: 1px solid #d0291c !important;\n}\n\n.invalid {\n    color: #d0291c !important;\n}\n\n.step-3 {\n    height: 100%;\n}\n\n.email-container {\n    display: flex;\n    flex-direction: column;\n    height: 100%;\n}\n\n.tags-label {\n    width: 100%;\n}\n\n.alert-info {\n    background-color: #f2f2f3;\n    color: #313335;\n    border-color: #f2f2f3;\n}\n\n.alert-danger {\n    color: #721c24;\n}\n\n.alert-success {\n    color: #155724;\n}\n\n\n</style>\n\n<div role="status">\n    <div ng-if="vm.isLoading" style="text-align: center;">\n        <span class="visually-hidden">Loading, please wait</span>\n        <img src="dist/img/ajax-loader.gif" alt="loading indicator" aria-hidden="true"/>\n    </div>\n    <span ng-if="!vm.isLoading" class="visually-hidden">Loading complete</span>\n</div>\n<div ng-show="!vm.isLoading" class="email-container">\n    <div id="address-info" class="alert alert-info" ng-if="vm.step === 2">\n        <span>\n            <i class="fa fa-lightbulb-o"></i>\n        </span> To add multiple addresses, type each address followed by a space or comma.\n    </div>\n    <div role="alert">\n        <div class="alert alert-danger" ng-repeat="error in vm.errors">\n            <span>\n                <i class="fa fa-exclamation-triangle"></i>\n            </span>\n            {{error.text}}\n        </div>\n    </div>\n\n    <div ng-class="{\'email-body\': true, \'scrollable\': true }" mcc-expandable-toc-helper>\n        <div ng-show="vm.step === 2">\n            <div>\n                <label class="tags-label">\n                    <p ng-class="{invalid: vm.hasError(\'recipients\')}">To:</p>\n                    <tags-input aria-label="Add a recipient address. To add multiple addresses, type each address followed by a space or comma." text="vm.recipientAddressText" ng-class="{invalid: vm.hasError(\'recipients\')}" ng-model="vm.recipients" type="email" placeholder="add a recipient address" allowed-tags-pattern="{{vm.allowedTagsPattern}}" add-on-blur="true" add-on-space="true" add-on-paste="true">\n                    </tags-input>\n                </label>\n            </div>\n            <div>\n                <label class="tags-label">\n                    <p ng-class="{invalid: vm.hasError(\'ccRecipients\')}">CC:</p>\n                    <tags-input aria-label="Add a CC address." id="ccAddress" text="vm.ccRecipientAddressText" ng-class="{invalid: vm.hasError(\'ccRecipients\')}" ng-model="vm.ccRecipients" type="email" placeholder="add a CC address" add-on-blur="true" allowed-tags-pattern=\'{{vm.allowedTagsPattern}}\'>\n                    </tags-input>\n\n                </label>\n            </div>\n\n            <label for="emailSubject">Subject:</label>\n            <div class="extra-margin">\n                <textarea id="emailSubject" class="form-control" ng-model="vm.messageSubject" type="text" style="width: 100%;" >\n                    </textarea>\n            </div>\n\n            <span aria-label="Message Body">Links being sent:</span>\n            <div class="extra-margin">\n                <ul class="list-group list-group-flush">\n                    <li class="list-group-item" ng-repeat="linkToSend in vm.linksToSend" ng-bind-html="linkToSend">\n\n                    </li>\n                </ul>\n\n            </div>\n        </div>\n        <div ng-show="vm.step === 1" mcc-expandable-toc="" data-params="{expToc: expToc}" aria-label="Select contents to email">\n\n        </div>\n    </div>\n    <div ng-show="!vm.isLoading" class="email-footer">\n        <div class="alert alert-info recaptcha-info" ng-if="vm.step == 2">\n            This site is protected by reCAPTCHA and the Google\n            <a href="https://policies.google.com/privacy">Privacy Policy</a> and\n            <a href="https://policies.google.com/terms">Terms of Service</a> apply.\n        </div>\n\n        <form class="actionBarForm form-inline" ng-class="{\'has-error\' : vm.actionBarForm.$invalid}" name="actionBarForm" novalidate ng-submit="vm.onSubmit($event)">\n            <button ng-show="vm.step === 2" type="button" class="btn btn-primary btn-raised pull-left" ng-click="vm.backClicked()"> Back</button>\n            <button ng-show="vm.step === 1" type="button" class="btn btn-primary btn-raised" ng-click="vm.nextClicked()"><i class="fa" ng-class=""></i> Next</button>\n            <div style="display: none" id="email-recaptcha" type="hidden" data-size="invisible"></div>\n            <button ng-show="vm.step === 2" type="submit" class="btn btn-primary btn-raised" ng-click="vm.onSubmit($event)" mcc-aria-disabled="vm.isEmailing || vm.actionBarForm.$invalid">\n                <i class="fa" ng-class="vm.isEmailing ? \'fa-spin fa-circle-o-notch\' : \'fa-envelope\'"></i> Send\n            </button>\n            <span ng-show="vm.emailError" class="label label-danger">Error</span>\n        </form>\n    </div>\n</div>\n\n\n\n\n\n\n'),e.put("/library/ng-apps/library_desktop/codes/codes_munipro_add_draft.cshtml",'<div data-mcc-expandable-toc-helper="">\n    <div id="munipro-add-draft-modal" data-mcc-modal="" data-mcc-modal-fit-height="" data-show-event="\'ADD_DRAFT_MODAL_SHOW\'" data-user-options="{ onShow: onShow, onShown: onShown, onHide: onModalHide, size: \'large\'}">\n        <div class="modal-body">\n            \x3c!--<div data-ng-if="modal.isShown">--\x3e\n            <div data-ng-show="activeStep < 2">\n                <div data-mcc-expandable-toc="" params="{expToc:expToc}" aria-label="Select contents to add to draft" \n                     tabindex="-1" mcc-focus-when="activeStep == 1"></div>\n            </div>\n            <div data-ng-show="activeStep == 2">\n                <form class="form">\n                    <div class="form-group">\n                        <label for="draftTitle">Draft Title</label>\n                        <input data-ng-model="draft.title" type="text" \n                               class="form-control" id="draftTitle" \n                               placeholder="Enter a title for the draft, e.g. Sections on electronic cigarettes"\n                               mcc-focus-when="activeStep == 2">\n                    </div>\n                    <div class="form-group">\n                        <label for="draftNote">Draft Note</label>\n                        <textarea data-ng-model="draft.note" id="draftNote" class="form-control" rows="3" placeholder="Enter anything here that will help you remember what this draft was for"></textarea>\n                    </div>\n                </form>\n            </div>\n            <div data-ng-show="activeStep == 3">\n                <p>You have now saved your draft.</p>\n                <p>You can access all your drafts on your <a href="" ng-href="{{dashboardUrl}}">Dashboard</a>.</p>\n            </div>\n            \x3c!--/div--\x3e\n        </div>\n        <div class="modal-footer" data-ng-switch="activeStep">\n            <div ng-if="activeStep < 2">\n                <button type="button" class="btn btn-primary" data-ng-click="stepClick(2)">Next <i class="fa fa-long-arrow-right"></i></button>\n            </div>\n            <div data-ng-switch-when="2">\n                <button type="button" class="btn btn-default-light pull-left" data-ng-click="stepClick(1)"><i class="fa fa-long-arrow-left"></i> Previous</button>\n                <button type="button" class="btn btn-primary" data-ng-click="saveClick()">Save <i class="fa fa-cloud-download"></i></button>\n            </div>\n            <div data-ng-switch-when="3">\n                <button type="button" class="btn btn-primary" data-ng-click_deprecated="doClose()" data-close>Close</button>\n            </div>\n        </div>\n    </div>\n</div>'),e.put("/library/ng-apps/library_desktop/codes/codes_munipro_add_note.cshtml",'<style>\n    mcc-munipro-add-note{\n        display: block;\n        height: 100%;\n}\n.toggle.ios, .toggle-on.ios, .toggle-off.ios {\n        border-radius: 20px;\n}\n.toggle.ios .toggle-handle {\n        border-radius: 20px;\n}\n\n#ck_editor1 {\n    margin-top: 5px;\n}\n\n.toggle-on-pad.btn-success:hover {\n    border: 1px solid transparent !important;\n}\n\ntoggle > div.toggle {\n    margin-top: 5px;\n}\n\n.note-body{\n        height: 100%;\n}\n\n.note-footer{\n        padding: 10px;\n        text-align: right;\n}\n.has-error .validationIndicator {\n        color: #E60A15;\n}\n\n.validationIndicator {\n        color: #067F16;\n}\n\n.validationIndicator {\n        position: relative;\n        top: -1px;\n        font-size: 18px;\n}\n\n.validationIndicator .fa-times { /*fa-times*/\n        position: relative;\n        top: 4px;\n}\n\n.validationIndicator .fa-check { /*fa-check*/\n        position: relative;\n        top: 4px;\n}\n\n.invalid {\n        color: #d0291c !important;\n        opacity: 1 !important;\n}\n\n.note-container {\n        display: flex;\n        flex-direction: column;\n        height: calc(100% - 60px);\n}\n\n.alert-info {\n        background-color: #f2f2f3;\n        color: #313335;\n        border-color: #f2f2f3;\n}\n\n.alert-danger {\n        color: #721c24;\n}\n\n.alert-success {\n        color: #155724;\n}\n\n.ckeditor-wrapper {\n    margin-top: 5px;\n}\n\n:root {\n    --ck-z-default: 100;\n    --ck-font-size-small: max(0.75em, 11px);\n}\n\n</style>\n\n<div role="status">\n    <div ng-if="vm.isLoading" style="text-align: center;">\n        <span class="visually-hidden">Loading, please wait</span>\n        <img src="dist/img/ajax-loader.gif" alt="loading indicator" aria-hidden="true"/>\n    </div>\n    <span ng-if="!vm.isLoading" class="visually-hidden">Loading complete</span>\n</div>\n<div\n    ng-show="!vm.isLoading"\n    class="note-container">\n    <div>\n        <div id="addNoteDescription" ng-if="vm.contentPublisher && vm.productUser" class="alert alert-info">\n            <span class="fa fa-lightbulb-o" aria-hidden="true"></span>\n            To make your note visible to the public, set the visibility option to "PUBLIC" in the form below.\n        </div>\n\n        <div role="alert">\n            <div class="alert alert-danger" ng-repeat="error in vm.errors">\n                <span class="fa fa-exclamation-triangle" aria-hidden="true"></span>\n                {{ error.text }}\n            </div>\n        </div>\n\n        <div ng-class="{\'note-body\': true, \'scrollable\': true }" mcc-expandable-toc-helper>\n            <div>\n                <h3>{{ expToc.activeNode.Heading }}</h3>\n                <div ng-hide="true" data-mcc-expandable-toc="" params="{expToc:expToc}"></div>\n                <form class="form add-note-form">\n                    <div class="form-group">\n                        <span ng-class="{invalid: vm.hasError(\'noteText\')}">Note</span>\n                        <div class="ckeditor-wrapper">\n                            <div id="editor">\n                            </div>\n                        </div>\n                    </div>\n                    <fieldset ng-if="vm.contentPublisher && vm.productUser">\n                        <legend>\n                            <span>Visibility</span>\n                        </legend>\n                        <div class="radio radio-styled">\n                            <label>\n                                <input type="radio" name="note-visibility" ng-model="vm.note.isPublic" ng-value="false"/>\n                                <span>Private</span>\n                            </label>\n                        </div>\n                        <div class="radio radio-styled">\n                            <label>\n                                <input type="radio" name="note-visibility" ng-model="vm.note.isPublic" ng-value="true"/>\n                                <span>Public</span>\n                            </label>\n                        </div>\n                    </fieldset>\n                </form>\n            </div>\n        </div>\n    </div>\n</div>\n\n<div ng-show="!vm.isLoading" class="note-footer">\n    <form class="actionBarForm form-inline" name="actionBarForm" ng-class="{\'has-error\' : vm.actionBarForm.$invalid}" novalidate ng-submit="vm.addClick()">\n        <button type="button" class="btn btn-default" ng-click="vm.doClose()" data-close>\n            Cancel\n        </button>\n        <button type="submit" class="btn btn-primary">\n            <i class="fa fa-plus"></i> Add Note\n        </button>\n    </form>\n</div>'),e.put("/library/ng-apps/library_desktop/codes/codes_print.cshtml",'<style>\n    mcc-codes-print{\n        display:block;\n        height: 100%;\n    }\n\n    .print-body {\n        height: calc(100% - 61px);\n    }\n\n    .print-footer{\n        padding: 20px;\n        text-align: right;\n    }\n</style>\n\n<div role="status">\n    <span ng-if="isPrinting" class="visually-hidden">Loading, please wait.</span>\n</div>\n<div class="print-body scrollable" mcc-expandable-toc-helper>\n    <div data-mcc-expandable-toc="" params="{expToc: expToc}" aria-label="Select contents to print"></div>\n    <iframe aria-hidden="true" style="border:none;" height="0" width="0" name="actionBarPrintFrame" id="actionBarPrintFrame"></iframe>\n</div>\n<div class="print-footer">\n    <button type="button" class="btn btn-cancel btn-flat pull-left" data-close><i class="fa fa-close"></i> Close</button>\n    <button type="button" class="btn btn-primary btn-raised ink-reaction" data-ng-click="doPrint(false)" mcc-aria-disabled="isPrinting"><i class="fa fa-print" data-ng-class="isPrinting ? \'fa-spin fa-circle-o-notch\' : fa-print"></i> Print</button>\n    <button type="button" ng-if="model.canShowChanges" class="btn btn-raised ink-reaction btn-primary" data-ng-click="doPrint(true)" mcc-aria-disabled="isPrinting"><i class="fa fa-print" data-ng-class="isPrinting ? \'fa-spin fa-circle-o-notch\' : fa-print"></i> Print With <strike>Strikethrough</strike></button>\n</div>'),e.put("/library/ng-apps/library_desktop/codes/codes_save.cshtml",'<style>\n    mcc-codes-save{\n        display:block;\n        height: 100%;\n    }\n\n    .download-body{\n        height: calc(100% - 78px);\n    }\n\n    .download-footer{\n        padding: 10px;\n        text-align: right;\n    }\n    .has-error .validationIndicator {\n                color: #E60A15;\n            }\n\n            .validationIndicator {\n                color: #067F16;\n            }\n\n            .auxLabel {\n                margin-right: 5px;\n            }\n\n            .validationIndicator {\n                position: relative;\n                top: -1px;\n                font-size: 18px;\n            }\n\n                .validationIndicator .fa-times { /*fa-times*/\n                    position: relative;\n                    top: 4px;\n                }\n\n                .validationIndicator .fa-check { /*fa-check*/\n                    position: relative;\n                    top: 4px;\n                }\n        .form-inline .btn{\n            margin-top: 0;\n        }\n</style>\n<div class="download-body scrollable holder" mcc-expandable-toc-helper>\n    <div ng-show="!isPreparingDownload" data-mcc-expandable-toc="" params="{expToc: expToc}" aria-label="Select contents to download"></div>\n    <div role="status">\n        <div class="alert alert-info stick-bottom-left" ng-if="isPreparingDownload">\n            <p class="text-lg">Your Word download is being prepared.</p>\n        </div>\n    </div>\n</div>\n<div class="download-footer">\n    <form class="actionBarForm form-inline" data-ng-class="{\'has-error\' : actionBarForm.$invalid}" name="actionBarForm" novalidate data-ng-submit="doSave()">\n        <div style="display:inline-block;">\n            <label class="auxLabel" for="auxInput">Filename</label>\n            <input type="text" class="form-control" id="auxInput" name="auxInput" data-ng-model="auxInput.value" data-ng-pattern="auxInputPattern" required="required" style="width:200px;"/>\n            <span class="validationIndicator"> . . . <i data-ng-class="actionBarForm.$valid ? \'fa fa-check\' : \'fa fa-times\'"></i> . . . </span>\n        </div>\n        <button type="button" class="btn btn-cancel btn-flat pull-left" data-close><i class="fa fa-close"></i> Close</button>\n        <button type="submit" class="btn btn-primary btn-raised" mcc-aria-disabled="isPreparingDownload || actionBarForm.$invalid"><i class="fa" data-ng-class="isPreparingDownload ? \'fa-spin fa-circle-o-notch\' : \'fa-cloud-download\'"></i> Download</button>\n    </form>\n</div>'),e.put("/library/ng-apps/library_desktop/codes/codes_toc.cshtml",'<mcc-product-toc toc-params="codesToc.tocParams"\n                 data-mcc-emit-dom-finished-updating="tocReady">\n</mcc-product-toc>'),e.put("/library/ng-apps/library_desktop/codes/codes_toc_save_or_print.cshtml",'<style>\n.toc-save-footer{\n        padding: 10px;\n        text-align: right;\n}\n\n.toc{\n        height: 100%;\n}\n\n.toc-save-container {\n        display: flex;\n        flex-direction: column;\n        height: calc(100% - 60px);\n}\n\n</style>\n\n<div role="status">\n    <div ng-if="model.isLoading" style="text-align: center;">\n        <span class="visually-hidden">Loading, please wait</span>\n        <img src="dist/img/ajax-loader.gif" alt="loading indicator" aria-hidden="true"/>\n    </div>\n    <span ng-if="!model.isLoading" class="visually-hidden">Loading complete</span>\n</div>\n\n<div ng-if="!model.isLoading" class="toc-save-container">\n    <div>\n        <div role="alert">\n            <div class="alert alert-danger" ng-repeat="error in vm.errors">\n                <span>\n                    <i class="fa fa-exclamation-triangle"></i>\n                </span>\n                {{ error.text }}\n            </div>\n        </div>\n\n        <div ng-class="{\'toc\': true, \'scrollable\': true }" style="max-height: 500px;">\n            <div ng-if="model.productToc != undefined" data-mcc-expandable-toc="" params="{expToc: model.productToc}" aria-label="Select contents to export or print"></div>\n        </div>\n    </div>\n</div>\n\n<div ng-show="!model.isLoading" class="toc-save-footer">\n    <form class="actionBarForm form-inline" name="actionBarForm" novalidate>\n        <button type="button" class="btn btn-primary btn-raised" title="Export to Excel" ng-click="model.doSaveAsExcel()" mcc-aria-disabled="!model.hasSelectedNodes()"><i class="fa fa-download"></i> Export (.xlsx) </button>\n        <button type="button" class="btn btn-primary btn-raised" title="Print" ng-click="model.doPrint()" mcc-aria-disabled="!model.hasSelectedNodes()"><i class="fa fa-print"></i> Print </button>\n    </form>\n</div>'),e.put("/library/ng-apps/library_desktop/codes/title_wrapper.cshtml",'    <h2 ng-if="vm.relativeNodeDepth < 1" id="_{{vm.chunkId}}" data-skip-id="_{{vm.chunkId}}" tabindex="-1" class="chunk-title-wrapper" ng-bind-html="vm.titleHtml"></h2>\n    <h3 ng-if="vm.relativeNodeDepth == 1" id="_{{vm.chunkId}}" data-skip-id="_{{vm.chunkId}}" tabindex="-1" class="chunk-title-wrapper" ng-bind-html="vm.titleHtml"></h3>\n    <h4 ng-if="vm.relativeNodeDepth == 2" id="_{{vm.chunkId}}" data-skip-id="_{{vm.chunkId}}" tabindex="-1" class="chunk-title-wrapper" ng-bind-html="vm.titleHtml"></h4>\n    <h5 ng-if="vm.relativeNodeDepth == 3" id="_{{vm.chunkId}}" data-skip-id="_{{vm.chunkId}}" tabindex="-1" class="chunk-title-wrapper" ng-bind-html="vm.titleHtml"></h5>\n    <h6 ng-if="vm.relativeNodeDepth == 4" id="_{{vm.chunkId}}" data-skip-id="_{{vm.chunkId}}" tabindex="-1" class="chunk-title-wrapper" ng-bind-html="vm.titleHtml"></h6>\n    <h6 ng-if="vm.relativeNodeDepth > 4" id="_{{vm.chunkId}}" data-skip-id="_{{vm.chunkId}}" tabindex="-1" class="chunk-title-wrapper" ng-bind-html="vm.titleHtml"\n        role="heading"\n        aria-level="{{vm.relativeNodeDepth + 2}}"></h6>'),e.put("/library/ng-apps/library_desktop/disabled_user_info/disabled_user_info-partial.cshtml",'<div id="disabledUserMobileHeader" class="hidden-md hidden-lg hidden-xl mobile-header d-flex align-items-center">\n    <div style="padding: 8px 24px;">\n        <img src="dist/img/cp-municode-codification-logo.svg" alt="CivicPlus Municode Codification logo"/>\n    </div>\n    <div class="dropdown ms-auto me-2">\n        <button class="btn btn-flat dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Help menu" title="Help menu" bootstrap-tooltip data-trigger="hover" data-placement="bottom">\n            <i class="md md-help"></i>\n            <span class="caret"></span>\n        </button>\n        <ul class="dropdown-menu dropdown-menu-right">\n            \x3c!-- Visit Help Center link --\x3e\n            <li>\n                <a ng-href="{{::$root.app.supportUrl}}" target="_blank">\n                    <i class="fa fa-life-ring fa-fw"></i>\n                    Visit Help Center\n                </a>\n            </li>\n            \x3c!-- Submit Feedback link --\x3e\n            <li>\n                <a href="{{::$root.app.submitFeedbackUrl}}" target="_blank">\n                    <i class="fa fa-lightbulb-o fa-fw"></i>\n                    Submit Feedback\n                </a>\n            </li>\n        </ul>\n    </div>\n</div>\n<div class="zones no-toc" mcc-zone-mgr>\n    <mcc-main-content class="primary zone content-zone style-default-bright">\n        <div class="zone-body primary-zone-body">\n            <h2 class="text-primary primary-heading">Account Disabled</h2>\n            <div class="container-fluid" style="max-width:450px">\n                <div class="text-justify" style="font-size:120%">\n                    <b>Your Online Code Hosting account is disabled.</b> <br/>\n                    This may be due to various reasons such as security concerns, policy violations,\n                    or account expiration. If you believe this is an error or if you wish to discuss your\n                    account status further, please\n                    <a style="color: #096fcc;text-decoration: underline;"\n                       href="https://www.civicplus.help/hc/en-us/articles/115004354793-Contact-CivicPlus-Support">\n                        contact our support team\n                    </a>. Our representatives will assist\n                    you in resolving this matter. We apologize for any inconvenience this may cause and\n                    thank you for your understanding.\n                    <br/><br/>\n                    Sincerely,\n                    The CivicPlus Team\n                    <br/>\n\n                </div>\n\n            </div>\n        </div>\n    </mcc-main-content>\n</div>'),e.put("/library/ng-apps/library_desktop/downloadarchive/download_archive-contentTypes.cshtml",'<div id="downloadArchiveContentTypesMobileHeader" class="hidden-md hidden-lg hidden-xl mobile-header d-flex align-items-center">\n    <div style="padding: 8px 24px;">\n        <img src="dist/img/cp-municode-codification-logo.svg" alt="CivicPlus Municode Codification logo"/>\n    </div>\n    <div class="ms-auto">\n        <mcc-sign-in></mcc-sign-in>\n    </div>\n    <div class="dropdown me-2">\n        <button class="btn btn-flat dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Help menu" title="Help menu" bootstrap-tooltip data-trigger="hover" data-placement="bottom">\n            <i class="md md-help"></i>\n            <span class="caret"></span>\n        </button>\n        <ul class="dropdown-menu dropdown-menu-right">\n            \x3c!-- Visit Help Center link --\x3e\n            <li>\n                <a ng-href="{{::$root.app.supportUrl}}" target="_blank">\n                    <i class="fa fa-life-ring fa-fw"></i>\n                    Visit Help Center\n                </a>\n            </li>\n            \x3c!-- Submit Feedback link --\x3e\n            <li>\n                <a href="{{::$root.app.submitFeedbackUrl}}" target="_blank">\n                    <i class="fa fa-lightbulb-o fa-fw"></i>\n                    Submit Feedback\n                </a>\n            </li>\n        </ul>\n    </div>\n</div>\n<div class="zones no-toc">\n    <mcc-main-content class="primary zone content-zone style-default-bright">\n        <div class="zone-body primary-zone-body">\n            <h2 ng-if="!noData" class="text-primary primary-heading">{{viewModel.Job.Product.Client.ClientName}}, {{viewModel.Job.Product.Client.State.StateAbbreviation}} {{viewModel.Job.Product.ProductName}} {{viewModel.Job.Name}} - {{viewModel.Job.MaxTrackingDate | date:shortDate}}</h2>\n            <h2 ng-if="noData" class="text-primary primary-heading">Download Archive:</h2>\n\n            <p>\n                <a class="btn btn-flat" href="" ui-sref="aDownloadArchive.jobs({productId: viewModel.Job.Product.ProductID})"><i class="fa fa-angle-left"></i> {{::viewModel.Job.Product.ProductName}}</a>\n            </p>\n            <div class="contain-md">\n                <ul class="nav nav-pills nav-stacked">\n                    <li mcc-auto-load-start ng-class="{\'loading\': loading}">\n                        <div role="status">\n                            <div style="position: absolute; left: 50%; top: 20px;" ng-if="loading">\n                                <span class="visually-hidden">Loading, please wait</span>\n                                <span style="transform: translate(-50%, 0)"><i class="fa fa-4x fa-circle-o-notch fa-spin" aria-hidden="true"></i></span>\n                            </div>\n                            <span ng-if="!loading" class="visually-hidden">Loading complete</span>\n                        </div>\n                    </li>\n                    <li>\n                        <ul class="nav nav-pills nav-stacked">\n                            <li ng-repeat="archivedContentItem in viewModel.ArchivedContentItems" mcc-auto-load-end>\n                                <a target="_blank" href="{{archivedContentItem.Url}}">\n                                    <i class="fa fa-cloud-download" aria-hidden="true"></i> {{archivedContentItem.DisplayName}}\n                                </a>\n                            </li>\n                            <li ng-if="noData" mcc-auto-load-end>\n                                <span class="text-xxl text-muted">No content is available to download.</span>\n                            </li>\n                        </ul>\n                    </li>\n                </ul>\n            </div>\n        </div>\n    </mcc-main-content>\n</div>\n'),e.put("/library/ng-apps/library_desktop/downloadarchive/download_archive-jobs.cshtml",'<div id="downloadArchiveJobsMobileHeader" class="hidden-md hidden-lg hidden-xl mobile-header d-flex align-items-center">\n    <div style="padding: 8px 24px;">\n        <img src="dist/img/cp-municode-codification-logo.svg" alt="CivicPlus Municode Codification logo"/>\n    </div>\n    <div class="ms-auto">\n        <mcc-sign-in></mcc-sign-in>\n    </div>\n    <div class="dropdown me-2">\n        <button class="btn btn-flat dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Help menu" title="Help menu" bootstrap-tooltip data-trigger="hover" data-placement="bottom">\n            <i class="md md-help"></i>\n            <span class="caret"></span>\n        </button>\n        <ul class="dropdown-menu dropdown-menu-right">\n            \x3c!-- Visit Help Center link --\x3e\n            <li>\n                <a ng-href="{{::$root.app.supportUrl}}" target="_blank">\n                    <i class="fa fa-life-ring fa-fw"></i>\n                    Visit Help Center\n                </a>\n            </li>\n            \x3c!-- Submit Feedback link --\x3e\n            <li>\n                <a href="{{::$root.app.submitFeedbackUrl}}" target="_blank">\n                    <i class="fa fa-lightbulb-o fa-fw"></i>\n                    Submit Feedback\n                </a>\n            </li>\n        </ul>\n    </div>\n</div>\n\n<div class="zones no-toc">\n    <mcc-main-content class="primary zone content-zone style-default-bright">\n        <div class="zone-body primary-zone-body">\n            <h2 class="text-primary primary-heading">Download Archive: <span ng-bind="::jobs[0] ? jobs[0].Product.Client.ClientName + \', \' + jobs[0].Product.Client.State.StateAbbreviation + \' \' + jobs[0].Product.ProductName : undefined"></span></h2>\n            <div class="contain-md">\n                <ul class="nav nav-pills nav-stacked">\n                    <li mcc-auto-load-start ng-class="{\'loading\': loading}">\n                        <div role="status">\n                            <div style="position: absolute; left: 50%; top: 20px;" ng-if="loading">\n                                <span class="visually-hidden">Loading, please wait</span>\n                                <span style="transform: translate(-50%, 0)"><i class="fa fa-4x fa-circle-o-notch fa-spin" aria-hidden="true"></i></span>\n                            </div>\n                            <span ng-if="!loading" class="visually-hidden">Loading complete</span>\n                        </div>\n                    </li>\n                    <li ng-repeat="job in jobs" mcc-auto-load-end>\n                        <a href="" ui-sref="aDownloadArchive.contentTypes({productId: job.Product.ProductID, jobId: job.Id})">\n\n                            {{job.Name}} - {{job.MaxTrackingDate | date:shortDate}}\n\n                        </a>\n                    </li>\n                    <li ng-if="noData" mcc-auto-load-end>\n                        <span class="text-xxl">No content is available to download.</span>\n                    </li>\n                </ul>\n            </div>\n        </div>\n    </mcc-main-content>\n</div>\n'),e.put("/library/ng-apps/library_desktop/meetings/generic_meeting_details.cshtml",'<div style="width: 100%; height: 100%;">\n    <div ng-if="vm.isMeetingDetailsIframeLoading">\n        <img src="dist/img/ajax-loader.gif" alt="loading indicator" style="position: absolute; top: 0; bottom: 0; left: 0; right: 0; margin: auto;" />\n    </div>\n    <div class="meeting-details-iframe-wrapper" style="height: 100%; width: 100%;">\n        <iframe ng-show="!vm.isMeetingDetailsIframeLoading" title=\'Meeting Details\' class=\'meeting-details-iframe\' allow=\'autoplay; fullscreen;\' ng-onload=\'vm.onMeetingDetailsIframeLoad()\' ng-src=\'{{vm.srcUrl}}\' style=\'height: 100%; width: 100%; border: none;\' ></iframe>\n    </div> \n</div>'),e.put("/library/ng-apps/library_desktop/meetings/meeting_details.cshtml",'<div style="width: 100%; height: 100%;">\n    <div ng-if="vm.isMeetingDetailsIframeLoading">\n        <img src="dist/img/ajax-loader.gif" alt="loading indicator" style="position: absolute; top: 0; bottom: 0; left: 0; right: 0; margin: auto;" />\n    </div>\n    <div class="meeting-details-iframe-wrapper" style="height: 100%; width: 100%;">\n        <iframe ng-show="!vm.isMeetingDetailsIframeLoading" title=\'Meeting Details\' class=\'meeting-details-iframe\' allow=\'autoplay; fullscreen;\' ng-onload=\'vm.onMeetingDetailsIframeLoad()\' ng-src=\'{{vm.srcUrl}}\' style=\'height: 100%; width: 100%; border: none;\' ></iframe>\n    </div> \n</div>'),e.put("/library/ng-apps/library_desktop/munidocs/munidocs.cshtml",'<div id="munidocsMobileHeader" class="hidden-md hidden-lg hidden-xl mobile-header d-flex align-items-center" ng-style="$root.mobileHeaderTheme">\n    <mcc-client-mobile-logo></mcc-client-mobile-logo>\n    <div class="ms-auto me-2 d-flex align-items-center">\n        <button ng-show="!$root.zoneMgrSvc.isTocZoneVisibleOnMobile" type="button" class="btn btn-icon-toggle" ng-click="$root.zoneMgrSvc.toggleVisibleZone()" aria-label="Show table of contents" title="Show table of contents" bootstrap-tooltip data-trigger="hover" data-placement="left">\n            <i class="fa fa-list-ul"></i>\n            <span class="visually-hidden">Show Table of Contents</span>\n        </button>\n        <button ng-show="$root.zoneMgrSvc.isTocZoneVisibleOnMobile" type="button" class="btn btn-icon-toggle" ng-click="$root.zoneMgrSvc.toggleVisibleZone()" aria-label="Hide table of contents" title="Hide table of contents" bootstrap-tooltip data-trigger="hover" data-placement="left">\n            <i class="fa fa-close"></i>\n            <span class="visually-hidden">Hide Table of Contents</span>\n        </button>\n        <mcc-mobile-search class="d-flex"></mcc-mobile-search>\n        <div class="btn-group">\n            <button type="button" class="btn btn-icon-toggle ink-reaction dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-label="Action menu" title="Action menu" bootstrap-tooltip data-trigger="hover" data-placement="left" data-container="body">\n                <i class="fa fa-ellipsis-v"></i>\n            </button>\n            <ul class="dropdown-menu pull-right animation-expand">\n                <li>\n                    <mcc-sign-in layout="menu"></mcc-sign-in>\n                </li>\n                <li class="divider"></li>\n                \x3c!-- Visit Help Center link --\x3e\n                <li>\n                    <a ng-href="{{::$root.app.supportUrl}}" target="_blank">\n                        <i class="fa fa-life-ring fa-fw"></i>\n                        Visit Help Center\n                    </a>\n                </li>\n                \x3c!-- Submit Feedback link --\x3e\n                <li>\n                    <a href="{{::$root.app.submitFeedbackUrl}}" target="_blank">\n                        <i class="fa fa-lightbulb-o fa-fw"></i>\n                        Submit Feedback\n                    </a>\n                </li>\n            </ul>\n        </div>\n    </div>\n</div>\n\n<mcc-off-canvas class="col-xs-12 persistent-off-canvas"\n                name="searchResults"\n                header-title="\'Search Results\'"\n                icon-class="fa fa-search"\n                scrollable="true"\n                options="{useBackdrop: false, canSlideContent: true, closeOnLinkClickOnMobile: true}">\n    <mcc-search-results></mcc-search-results>\n</mcc-off-canvas>\n\n<mcc-off-canvas class="col-xs-12 col-sm-9 col-md-8 col-lg-5"\n                name="sharelink"\n                header-title="\'Share Link\'"\n                icon-class="fa fa-link"\n                options="{keepOpenWithOthers: true}"\n                style="padding:0;">\n    <div style="height: calc(100% - 60px)" class="scrollable">\n        <mcc-share-link data-params="{activeId: $root.$stateParams.nodeId}"></mcc-share-link>\n    </div>\n    <div style="padding: 20px;">\n        <button type="button" class="btn btn-cancel btn-flat btn-block pull-left" data-close><i class="fa fa-close"></i> Close</button>\n    </div>\n</mcc-off-canvas>\n\n<section id="toolbar" class="no-padding style-default-bright">\n    <div class="container-fluid">\n        <div class="row">\n            <div class="col-md-8" id="mcc_desktop_codes_breadcrumb">\n                <mcc-bread-crumb active-node-id="vm.getBreadcrumbNodeId()"/>\n            </div>\n            <div class="col-md-4 product-actions">\n                <div class="pull-right">\n                    <button type="button" class="btn btn-flat" ng-click="$root.searchSvc.toggleSearchResultsPane()" bootstrap-tooltip data-trigger="hover" title="Open or close search results pane" aria-label="Open or close search results pane" data-placement="bottom" data-container="body">\n                        <span ng-if="!$root.searchSvc.isResultsPaneOpen()">\n                            <i class="fa fa-caret-left"></i><i class="fa fa-search"></i>\n                        </span>\n                        <span ng-if="$root.searchSvc.isResultsPaneOpen()">\n                            <i class="fa fa-search"></i><i class="fa fa-caret-right"></i>\n                        </span>\n\n                    </button>\n\n                    <div class="btn-group hidden-xs hidden-sm">\n                        <button type="button" class="btn btn-flat dropdown-toggle btn-accent" data-toggle="dropdown">\n                            more <i class="fa fa-caret-down"></i>\n                        </button>\n                        <ul class="dropdown-menu pull-right animation-expand">\n                            <li class="smaller-padding text-default-light text-medium">MuniPRO</li>\n                            <li ng-class="{disabled:!vm.munipro}">\n                                <a ng-href="{{vm.savedSearchesUrl}}"><i class="fa fa-user"></i> My Saved Searches</a>\n                            </li>\n                            <li ng-class="{disabled:!vm.munipro}">\n                                <a ng-href="{{vm.manageDraftsUrl}}"><i class="fa fa-user"></i> My Drafts</a>\n                            </li>\n                            <li ng-class="{disabled:!vm.munipro}">\n                                <a ng-href="{{vm.manageNotesUrl}}"><i class="fa fa-user"></i> My Notes</a>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n\n<div class="zones" mcc-zone-mgr>\n    <nav aria-label="Table of Contents" id="toc" class="toc-zone zone secondary-zone style-default-light" ng-if="!$root.viewportHelper.isMobile() || $root.zoneMgrSvc.isTocZoneVisibleOnMobile">\n        <div class="zone-head toc-zone-head">\n            <div class="zone-head-product hidden-xs hidden-sm">\n                <button type="button" class="btn btn-flat" ng-click="$root.productNameClick()">{{::$root.mccStateParams.product.ProductName}}</button>\n            </div>\n            <div class="btn-group pull-right opacity-75">\n                \n                <button type="button" aria-controls="toc" aria-expanded={{!!$root.zoneMgrSvc.isTocZoneOpen()}} ng-click="$root.zoneMgrSvc.toggleTocZone()" class="btn btn-flat" bootstrap-tooltip data-title="Show or hide table of contents" data-placement="bottom" data-container="body" data-trigger="hover" aria-label="Show or hide table of contents">\n                    <i class="fa fa-arrows-h"></i>\n                </button>\n            </div>\n        </div>\n        <div class="zone-body toc-zone-body">\n            <div class="product-info">\n                <h2 class="product-info-heading hidden-md hidden-lg hidden-xl">\n                    <span class="client text-sm hidden-md hidden-lg hidden-xl">{{::$root.mccStateParams.client.ClientName}}, {{::$root.mccStateParams.state.StateAbbreviation}}<br/></span>\n                    <span class="product text-xs">{{::$root.mccStateParams.product.ProductName}}</span>\n                </h2>\n            </div>\n            <div class="toc-wrapper">\n                <mcc-product-toc toc-params="vm.tocParams" data-mcc-emit-dom-finished-updating="tocReady"/>\n            </div>\n        </div>\n    </nav>\n\n    <mcc-main-content class="primary content-zone zone style-default-bright" ng-if="!$root.viewportHelper.isMobile() || !$root.zoneMgrSvc.isTocZoneVisibleOnMobile">\n        <div class="zone-body primary-zone-body" id="munidocsContentContainer">\n            <mcc-munidocs-content></mcc-munidocs-content>\n        </div>\n        <div class="zone-foot">\n            <mcc-search-results-nav content-ready-event="\'contentReady\'"></mcc-search-results-nav>\n        </div>\n    </mcc-main-content>\n</div>'),e.put("/library/ng-apps/library_desktop/munidocs/munidocs_content.cshtml",'<div id="munidocsContent" data-ng-switch="munidocsVm.pageType" class="loading-aware" ng-class="{\'loading\': munidocsMv.gettingData}">\n    <div role="status">\n        <div style="position: absolute; left: 50%;" ng-if="munidocsVm.gettingData">\n            <span style="transform: translate(-50%, 0)">\n                <span class="visually-hidden">Loading, please wait</span>\n                <i class="fa fa-2x fa-circle-o-notch fa-spin" aria-hidden="true"></i>\n            </span>\n        </div>\n        <span ng-if="!munidocsVm.gettingData" class="visually-hidden">Loading complete</span>\n    </div>\n    <div ng-if="munidocsVm.errorMessage">\n        <span>{{munidocsVm.errorMessage}}</span>\n    </div>\n    <div data-ng-switch-when="MUNIDOCS_LIST" class="munidocs-list" data-mcc-emit-dom-finished-updating="focusSkipReady">\n        <h2>\n            <span>{{::$root.mccStateParams.client.ClientName}}, {{::$root.mccStateParams.client.State.StateAbbreviation}} {{::$root.mccStateParams.product.ProductName}}</span>\n        </h2>\n        <p>\n            <span class="text-lg" ng-bind="::munidocsVm.docCount + \' documents\'"></span>\n        </p>\n        <p data-ng-if="$root.mccStateParams.product.Disclaimer">\n            <em ng-bind-html="::$root.mccStateParams.product.Disclaimer"></em>\n        </p>\n        <p style="margin-top: 20px;">Please use the table of contents pane to navigate to the document you\'re looking for. </p>\n        <div class="hidden-md hidden-lg hidden-xl">\n            <p>\n                <button type="button" class="btn btn-raised btn-primary btn-lg" ng-click="$root.zoneMgrSvc.toggleVisibleZone()"><i class="fa fa-list-ul"></i> Browse</button>\n            </p>\n        </div>\n        <p>Alternatively, use the application-wide search box to search.</p>\n\n    </div>\n    <div data-ng-switch-when="MUNIDOC" class="munidoc" tabindex="-1">\n        \n        <h2 id="_{{munidocsVm.currentNodeId}}" data-skip-id="_{{munidocsVm.currentNodeId}}" tabindex="-1"\n            class="visually-hidden">\n            {{munidocsVm.pdfNode.Heading}}\n        </h2>\n        <div class="clearfix">\n            <div class="pull-right product-actions">\n                <div class="btn-group action-bar text-primary">\n                    <a ng-href="{{munidocsVm.getMunidocPdfDownloadUrl(munidocsVm.pdfNode)}}" class="btn btn-icon-toggle" data-toggle="tooltip" data-trigger="hover" title="Download PDF" aria-label="Download PDF" target="_self">\n                        <i class="fa fa-file-pdf-o"></i>\n                    </a>\n                    <a ng-href="{{munidocsVm.getMunidocPdfUrl(munidocsVm.pdfNode)}}" target="_blank" class="btn btn-icon-toggle" data-toggle="tooltip" data-trigger="hover" title="Open document in new window" aria-label="Open document in new window">\n                        <i class="fa fa-external-link"></i>\n                    </a>\n                    <button type="button" class="btn btn-icon-toggle" data-toggle="tooltip" data-trigger="hover" title="Share document link" ng-click="munidocsVm.shareLinkClick()" aria-label="Share document link">\n                        <i class="fa fa-link"></i>\n                    </button>\n                </div>\n            </div>\n        </div>\n        <div ng-if="!$root.viewportHelper.isXSmall()">\n            \n\n            <iframe title="PDF viewer" style="width: 100%; height: calc(100vh - 168px); border: 1px solid;" id="{{\'munidoc_embed\'+munidocsVm.pdfNode.Id}}"\n                    ng-src="{{munidocsVm.getMunidocPdfUrl(munidocsVm.pdfNode)}}">\n            </iframe>\n        </div>\n        <div ng-if="$root.viewportHelper.isXSmall()">\n            <p>\n                <a class="btn btn-raised btn-primary btn-lg" href="" ng-href="{{munidocsVm.getMunidocPdfUrl(munidocsVm.pdfNode)}}"><i class="fa fa-file-pdf-o"></i> View PDF</a>\n            </p>\n        </div>\n    </div>\n    <div data-ng-switch-when="MUNIDOC_HTML" class="munidoc-html" tabindex="-1">\n        <h2 id="_{{munidocsVm.currentNodeId}}" data-skip-id="_{{munidocsVm.currentNodeId}}" tabindex="-1"\n            class="visually-hidden">\n            {{munidocsVm.pdfNode.Heading}}\n        </h2>\n        <div class="clearfix">\n            <div class="product-actions pull-right">\n                <div class="btn-group action-bar text-primary">\n                    <button type="button" class="btn btn-icon-toggle" data-toggle="tooltip" data-trigger="hover" title="Share link" ng-click="munidocsVm.shareLinkClick()" aria-label="Share document">\n                        <i class="fa fa-link"></i>\n                    </button>\n                </div>\n            </div>\n        </div>\n        <div id="munidocHtmlWrapper">\n            <div class="munidoc-html-chunk" id="munidocHtml" ng-bind-html="munidocsVm.processedHtml">\n\n            </div>\n        </div>\n        <iframe id="munidocPrintFrame" name="munidocPrintFrame" width="0" height="0" frameborder="0"></iframe>\n    </div>\n</div>'),e.put("/library/ng-apps/library_desktop/ordinances/ordinances.cshtml",'<div id="ordinancesMobileHeader" class="hidden-md hidden-lg hidden-xl mobile-header d-flex align-items-center" ng-style="$root.mobileHeaderTheme">\n    <mcc-client-mobile-logo></mcc-client-mobile-logo>\n    <div class="ms-auto me-2 d-flex align-items-center">\n        <button ng-show="!$root.zoneMgrSvc.isTocZoneVisibleOnMobile" type="button" class="btn btn-icon-toggle" ng-click="$root.zoneMgrSvc.toggleVisibleZone()" aria-label="Show table of contents" title="Show table of contents" bootstrap-tooltip data-trigger="hover" data-placement="left">\n            <i class="fa fa-list-ul"></i>\n            <span class="visually-hidden">Show Table of Contents</span>\n        </button>\n        <button ng-show="$root.zoneMgrSvc.isTocZoneVisibleOnMobile" type="button" class="btn btn-icon-toggle" ng-click="$root.zoneMgrSvc.toggleVisibleZone()" aria-label="Hide table of contents" title="Hide table of contents" bootstrap-tooltip data-trigger="hover" data-placement="left">\n            <i class="fa fa-close"></i>\n            <span class="visually-hidden">Hide Table of Contents</span>\n        </button>\n        <mcc-mobile-search class="d-flex"></mcc-mobile-search>\n        <div class="btn-group">\n            <button type="button" class="btn btn-icon-toggle ink-reaction dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-label="Action menu" title="Action menu" bootstrap-tooltip data-trigger="hover" data-placement="left" data-container="body">\n                <i class="fa fa-ellipsis-v"></i>\n            </button>\n            <ul class="dropdown-menu pull-right animation-expand">\n                <li>\n                    <mcc-sign-in layout="menu"></mcc-sign-in>\n                </li>\n                <li class="divider"></li>\n                \x3c!-- Visit Help Center link --\x3e\n                <li>\n                    <a ng-href="{{::$root.app.supportUrl}}" target="_blank">\n                        <i class="fa fa-life-ring fa-fw"></i>\n                        Visit Help Center\n                    </a>\n                </li>\n                \x3c!-- Submit Feedback link --\x3e\n                <li>\n                    <a href="{{::$root.app.submitFeedbackUrl}}" target="_blank">\n                        <i class="fa fa-lightbulb-o fa-fw"></i>\n                        Submit Feedback\n                    </a>\n                </li>\n            </ul>\n        </div>\n    </div>\n</div>\n\n<mcc-off-canvas class="col-xs-12 persistent-off-canvas"\n                name="searchResults"\n                header-title="\'Search Results\'"\n                icon-class="fa fa-search"\n                scrollable="true"\n                options="{useBackdrop: false, canSlideContent: false, closeOnLinkClickOnMobile: true}">\n    <mcc-search-results></mcc-search-results>\n</mcc-off-canvas>\n\n<mcc-off-canvas class="col-xs-12 col-sm-9 col-md-8 col-lg-5"\n                name="sharelink"\n                header-title="\'Share Link\'"\n                icon-class="fa fa-link"\n                options="{keepOpenWithOthers: true}"\n                style="padding:0;">\n    <div style="height: calc(100% - 60px)" class="scrollable">\n        <mcc-share-link data-params="{activeId: vm.actionNodeId}"></mcc-share-link>\n    </div>\n    <div style="padding: 20px;">\n        <button type="button" class="btn btn-cancel btn-flat btn-block pull-left" data-close><i class="fa fa-close"></i> Close</button>\n    </div>\n</mcc-off-canvas>\n\n<section id="toolbar" class="no-padding style-default-bright">\n    <div class="container-fluid">\n        <div class="row">\n            <div class="col-md-8" id="mcc_desktop_codes_breadcrumb">\n                <mcc-bread-crumb active-node-id="vm.getBreadcrumbNodeId()"/>\n            </div>\n            <div class="col-md-4 product-actions">\n                <div class="pull-right">\n                    <button type="button" class="btn btn-flat" ng-click="$root.searchSvc.toggleSearchResultsPane()" bootstrap-tooltip data-trigger="hover" title="Open or close search results pane" aria-label="Open or close search results pane" data-placement="bottom" data-container="body">\n                        <span ng-if="!$root.searchSvc.isResultsPaneOpen()">\n                            <i class="fa fa-caret-left"></i><i class="fa fa-search"></i>\n                        </span>\n                        <span ng-if="$root.searchSvc.isResultsPaneOpen()">\n                            <i class="fa fa-search"></i><i class="fa fa-caret-right"></i>\n                        </span>\n\n                    </button>\n\n                    <div class="btn-group hidden-xs hidden-sm">\n                        <button type="button" class="btn btn-flat dropdown-toggle btn-accent" data-toggle="dropdown">\n                            more <i class="fa fa-caret-down"></i>\n                        </button>\n                        <ul class="dropdown-menu pull-right animation-expand">\n                            <li class="smaller-padding text-default-light text-medium">MuniPRO</li>\n                            <li ng-class="{disabled:!vm.munipro}">\n                                <a ng-href="{{vm.savedSearchesUrl}}"><i class="fa fa-user"></i> My Saved Searches</a>\n                            </li>\n                            <li ng-class="{disabled:!vm.munipro}">\n                                <a ng-href="{{vm.manageDraftsUrl}}"><i class="fa fa-user"></i> My Drafts</a>\n                            </li>\n                            <li ng-class="{disabled:!vm.munipro}">\n                                <a ng-href="{{vm.manageNotesUrl}}"><i class="fa fa-user"></i> My Notes</a>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n\n<div class="zones" mcc-zone-mgr>\n    <nav aria-label="Table of Contents" id="toc" class="toc-zone zone secondary-zone style-default-light" ng-if="!$root.viewportHelper.isMobile() || $root.zoneMgrSvc.isTocZoneVisibleOnMobile">\n        <div class="zone-head toc-zone-head">\n            <div class="zone-head-product hidden-xs hidden-sm">\n                <button type="button" class="btn btn-flat" ng-click="$root.productNameClick()">{{::$root.mccStateParams.product.ProductName}}</button>\n            </div>\n            <div class="btn-group pull-right opacity-75">\n                \n                <button type="button" aria-controls="toc" aria-expanded={{!!$root.zoneMgrSvc.isTocZoneOpen()}} ng-click="$root.zoneMgrSvc.toggleTocZone()" class="btn btn-flat" bootstrap-tooltip data-title="Show or hide table of contents" data-placement="bottom" data-container="body" data-trigger="hover" aria-label="Show or Hide Table of Contents">\n                    <i class="fa fa-arrows-h"></i>\n                </button>\n            </div>\n        </div>\n        <div class="zone-body toc-zone-body">\n            <div class="product-info">\n                <h2 class="product-info-heading hidden-md hidden-lg hidden-xl">\n                    <span class="client text-sm hidden-md hidden-lg hidden-xl">{{::$root.mccStateParams.client.ClientName}}, {{::$root.mccStateParams.state.StateAbbreviation}}<br/></span>\n                    <span class="product text-xs">{{::$root.mccStateParams.product.ProductName}}</span>\n                </h2>\n            </div>\n            <div class="toc-wrapper">\n                <mcc-product-toc toc-params="vm.tocParams" data-mcc-emit-dom-finished-updating="tocReady"/>\n            </div>\n        </div>\n    </nav>\n\n    <mcc-main-content class="primary content-zone zone style-default-bright" ng-if="!$root.viewportHelper.isMobile() || !$root.zoneMgrSvc.isTocZoneVisibleOnMobile">\n\n        <div class="zone-body primary-zone-body" id="ordinancesContentContainer">\n            <mcc-ordinances-content></mcc-ordinances-content>\n        </div>\n    </mcc-main-content>\n</div>'),e.put("/library/ng-apps/library_desktop/ordinances/ordinances_content.cshtml",'<div class="meeting-details-modal modal" role="dialog" aria-modal="true" aria-label="Meeting details" tabindex="-1">\n    <div class="modal-dialog" style="width: 90%; height: 87%; margin: 4% auto;">\n        <div class="modal-content" style="height: 100%; width: 100%;">\n            <div class="modal-header">\n                <h2 class="modal-title">Meeting Details</h2>\n                <a ng-href="{{vm.viewAllMeetingsUrl}}" target="_blank" class="text-primary" mcc-focus-when="vm.showMeetingDetails"><i class="fa fa-external-link"></i> View All Meetings</a>\n                <button type="button" ng-click="vm.meetingDetailsModalClose()" class="btn btn-icon-toggle btn-default" data-dismiss="modal" aria-label="Close">\n                    <i class="md md-close"></i>\n                </button>\n            </div>\n            <div class="modal-body" style="max-height: 100%; height: calc(100% - 142px); width: 100%;">\n                <mcc-meeting-details ng-if="vm.showMeetingDetails" data-params="{clientCode: vm.ordinanceModel.Meetings.ClientCode, meetingId: vm.ordinanceModel.Meetings.MeetingId}"></mcc-meeting-details>\n            </div>\n            <div class="modal-footer">\n                <button type="button" ng-click="vm.meetingDetailsModalClose()" class="btn btn-cancel btn-flat" data-dismiss="modal"><i class="fa fa-close"></i> Close</button>\n            </div>\n        </div>\n    </div>\n</div>\n\n<div class="generic-meeting-details-modal modal" role="dialog" aria-modal="true" aria-label="Meeting details" tabindex="-1">\n    <div class="modal-dialog" style="width: 90%; height: 87%; margin: 4% auto;">\n        <div class="modal-content" style="height: 100%; width: 100%;">\n            <div class="modal-header">\n                <h2 class="modal-title">Meeting Details</h2>\n                <a ng-if="$root.mccStateParams.client.MeetingsUrl" ng-href="{{$root.mccStateParams.client.MeetingsUrl}}" target="_blank" class="text-primary" mcc-focus-when="vm.showGenericMeetingDetails"><i class="fa fa-external-link"></i> View All Meetings</a>\n                <button type="button" class="btn btn-icon-toggle btn-default" ng-click="vm.genericMeetingDetailsModalClose()" data-dismiss="modal" aria-label="Close">\n                    <i class="md md-close"></i>\n                </button>\n            </div>\n            <div class="modal-body" style="max-height: 100%; height: calc(100% - 142px); width: 100%;">\n                <mcc-generic-meeting-details ng-if="vm.showGenericMeetingDetails" data-meeting-url="{{vm.ordinanceModel.MeetingUrl}}"></mcc-generic-meeting-details>\n            </div>\n            <div class="modal-footer">\n                <button type="button" ng-click="vm.genericMeetingDetailsModalClose()" class="btn btn-cancel btn-flat" data-dismiss="modal"><i class="fa fa-close"></i> Close</button>\n            </div>\n        </div>\n    </div>\n</div>\n\n<div id="ordinancesContent" class="loading-aware" ng-class="{\'loading\': vm.gettingData}">\n    <div role="status">\n        <div style="position: absolute; left: 50%;" ng-if="vm.gettingData">\n            <span style="transform: translate(-50%, 0)">\n                <span class="visually-hidden">Loading, please wait</span>\n                <i aria-hidden="true" class="fa fa-2x fa-circle-o-notch fa-spin"></i>\n            </span>\n        </div>\n        <span ng-if="!vm.gettingData" class="visually-hidden">Loading complete</span>\n    </div>\n    <div data-ng-switch="vm.pageType">\n        <div role="alert">\n            <div data-ng-switch-when="ORDS_EMPTY" class="ords-empty">\n                <div class="alert alert-info">\n                    <p>There are no ordinances in OrdBank at this time.</p>\n                </div>\n            </div>\n        </div>\n        <div ng-switch-when="ORDS_ROOT" class="ords-root">\n            <h2 >\n                <span ng-bind="::\'Ordinances for \' + $root.mccStateParams.client.ClientName + \', \' + $root.mccStateParams.client.State.StateAbbreviation + \' \' + $root.mccStateParams.product.ProductName"></span>\n            </h2>\n            <p class="lead" style="font-size:18px;" ng-bind="::vm.ordinanceModel.DocCount + \' ordinances\'"></p>\n            <p ng-if="::!$root.mccStateParams.product.Features.OrdBank">\n                <b>Only Uncodified Ordinances have been made available at this time.</b>\n            </p>\n            <p>Please use the table of contents pane to navigate to the ordinance you\'re looking for. </p>\n\n            <p class="hidden-md hidden-lg hidden-xl" style="margin-top: 8px;">\n                <button type="button" class="btn btn-raised btn-primary" ng-click="$root.zoneMgrSvc.toggleVisibleZone()"><i class="fa fa-list-ul"></i> Browse table of contents</button>\n            </p>\n\n            <p>Alternatively, use the application-wide search box to search.</p>\n\n        </div>\n        <div data-ng-switch-when="ORD_LIST" class="ords-product-pg" tabindex="-1">\n            <h2 id="_{{vm.nodeId}}"\n                style="margin-bottom: 28px;"\n                data-skip-id="_{{vm.nodeId}}" tabindex="-1"\n                mcc-focus-when="!!vm.skipToContent">\n                {{ vm.currentNodeId }} Ordinances\n            </h2>\n            <div>\n                <div class="card list-group" ng-repeat="ord in vm.ordinanceModel.ords"\n                     data-mcc-emit-dom-finished-updating="contentReady">\n                    <a href="" class="card-body list-group-item" style="display:block;" ng-href="{{::vm.getOrdHref(ord)}}">\n                        <p ng-show="ord.AdoptionDate" ng-bind="::\'Adopted \' + (ord.AdoptionDate | date: \'shortDate\')" class="text-muted text-bold pull-right"></p>\n                        <div style="display: flex; flex-direction: row;">\n                            <h3 class="" ng-bind="::ord.Title"></h3>\n                            <div ng-if="ord.Meetings || ord.MeetingUrl" style="margin-left: 4px;">\n                                <span class="label label-primary" style="vertical-align: text-top;"><i class="fa fa-users" style="margin-right: 0px;"></i> meeting</span>\n                            </div>\n                        </div>\n                        <p ng-bind="::ord.Description" style="font-style:italic"></p>\n                        <p ng-if="::ord.AmendedSections.length > 0" ng-bind="::ord.AmendedSections.length + \' section(s) amended\'"></p>\n                        <span class="pull-right left-space">\n                            <i class="fa fa-chevron-right"></i>\n                        </span>\n                        <br/>\n                    </a>\n                </div>\n            </div>\n        </div>\n        <div id="_{{vm.nodeId}}"\n             data-ng-switch-when="ORD_DETAILS" class="ords-ord-detail" tabindex="-1"\n             data-skip-id="_{{vm.nodeId}}"\n             mcc-focus-when="!!vm.skipToContent">\n            <style media="(max-width: 768px)">\n                #ordDetailsDetails {\n                    display: block !important;\n                    visibility: visible !important;\n                    height: auto !important;\n                }\n            </style>\n            <style>\n                .ords-ord-detail button[aria-expanded="false"] > .fa-chevron-down {\n                    display: none;\n                }\n\n                .ords-ord-detail button[aria-expanded="true"] > .fa-chevron-right {\n                    display: none;\n                }\n\n                .btn-primary.btn-flat .badge{\n                    color: white;\n                }\n                \n                .ords-ord-detail .expanded-content {\n                    margin-top: 10px;\n                }\n            </style>\n            <h2 class="visible-xs-block no-margin" style="padding: 12px 0;">\n                <span data-ng-bind="vm.ordinanceModel.Title"></span>\n                <span ng-if="::vm.ordinanceModel.IsNewOrd" class="label label-primary">uncodified</span>\n            </h2>\n            <div class="row" style="margin-bottom:10px;"\n                 data-mcc-emit-dom-finished-updating="contentReady">\n                <div class="col-xs-8">\n\n                    <button class="btn btn-primary btn-flat hidden-xs" type="button" data-toggle="collapse" data-target="#ordDetailsDetails" aria-expanded="false" aria-controls="ordDetailsDetails">\n                        <i class="fa fa-chevron-right small" aria-hidden="true"></i>\n                        <span aria-hidden="true"></span>\x3c!-- prevent css rule from adding margin --\x3e\n                        <i class="fa fa-chevron-down small" aria-hidden="true"></i>\n                        Details <span class="label label-primary" ng-if="vm.ordinanceModel.Meetings || vm.ordinanceModel.MeetingUrl" style="text-transform: lowercase !important; margin-left: 4px; vertical-align: middle;"><i class="fa fa-users"></i> meeting</span>\n                    </button>\n                    <div class="collapse expanded-content" id="ordDetailsDetails" style="margin-bottom: 10px;">\n                        <div class="card">\n                            <div class="card-head card-head-sm style-default-light">\n                                <header>Ordinance Details</header>\n                            </div>\n                            <div class="card-body">\n                                <p>Adopted {{vm.ordinanceModel.AdoptionDate | date: \'shortDate\'}}</p>\n                                <p>{{vm.ordinanceModel.Description}}</p>\n                            </div>\n                        </div>\n                        <div class="card" ng-if="vm.ordinanceModel.Meetings">\n                            <div class="card-head card-head-sm style-default-light">\n                                <header>Meeting Details</header>\n                            </div>\n                            <div class="card-body">\n                                <div class="alert alert-callout alert-info">\n                                    <p><button class="btn btn-link btn-link-inline" style="text-transform: none; padding: 0px 0px 3px;" ng-click="vm.onViewMeetingDetailsClick()">View the Meeting Page</button> for supporting details such as agendas, minutes, audio/video recordings, and other related items. </p>\n                                </div>\n                                <p>Meeting Name: {{vm.ordinanceModel.Meetings.MeetingName}}</p>\n                                <p>Meeting Date: {{vm.ordinanceModel.Meetings.MeetingScheduledDateTime | date: \'shortDate\'}}</p>\n                            </div>\n                        </div>\n                        <div class="card" ng-if="vm.ordinanceModel.MeetingUrl">\n                            <div class="card-head card-head-sm style-default-light">\n                                <header>Meeting Details</header>\n                            </div>\n                            <div class="card-body">\n                                <div class="alert alert-callout alert-info">\n                                    <p><button class="btn btn-link btn-link-inline" style="text-transform: none; padding: 0px 0px 3px;" ng-click="vm.onViewGenericMeetingDetailsClick()">View the Meeting Page</button> for supporting details such as agendas, minutes, audio/video recordings, and other related items. </p>\n                                </div>\n                                <p>Meeting Name: {{vm.ordinanceModel.MeetingName}}</p>\n                                <p>Meeting Date: {{vm.ordinanceModel.MeetingDate | date: \'shortDate\'}}</p>\n                            </div>\n                        </div>\n                    </div>\n\n                    <button ng-if="vm.ordinanceModel.AmendedSections.length" class="btn btn-primary btn-flat" type="button" data-toggle="collapse" data-target="#ordAmendedSections" aria-expanded="false" aria-controls="ordAmendedSections">\n                        <i class="fa fa-chevron-right small" aria-hidden="true"></i>\n                        <span aria-hidden="true"></span>\x3c!-- prevent css rule from adding margin --\x3e\n                        <i class="fa fa-chevron-down small" aria-hidden="true"></i>\n                        Amended Sections\n                        <span class="badge">{{vm.ordinanceModel.AmendedSections.length}}</span>\n                    </button>\n                    <div class="collapse expanded-content" id="ordAmendedSections" ng-if="vm.ordinanceModel.AmendedSections.length" style="margin-bottom:10px;">\n                        <div class="list-group">\n                            <a href="" ng-href="{{vm.getSectionHref(section.ChunkId)}}" class="list-group-item" data-ng-repeat="section in vm.ordinanceModel.AmendedSections">\n                                <span class="pull-right left-space">\n                                    <i class="fa fa-chevron-right"></i>\n                                </span>\n                                <p>{{section.SectionTitle}}</p>\n                            </a>\n                        </div>\n                    </div>\n\n                </div>\n                <div class="col-xs-4" style="text-align: right;">\n                    <div class="btn-group action-bar text-primary">\n                        <a ng-href="{{vm.getOrdPdfDownloadUrl(vm.ordinanceModel)}}" target="_self" class="btn btn-icon-toggle" data-toggle="tooltip" data-trigger="hover" title="Download PDF" aria-label="Download PDF">\n                            <i class="fa fa-file-pdf-o"></i>\n                        </a>\n                        <a ng-href="{{vm.getOrdPdfUrl(vm.ordinanceModel)}}" target="_blank" class="btn btn-icon-toggle hidden-xs" data-toggle="tooltip" data-trigger="hover" title="Open ordinance in new window" aria-label="Open ordinance in new window">\n                            <i class="fa fa-external-link"></i>\n                        </a>\n                        <button type="button" class="btn btn-icon-toggle" ng-click="vm.shareClick()" data-toggle="tooltip" data-trigger="hover" title="Share ordinance link" aria-label="Share ordinance link">\n                            <i class="fa fa-link"></i>\n                        </button>\n                    </div>\n                </div>\n\n            </div>\n\n            <iframe class="hidden-xs" style="width: 100%; height: calc(100vh - 186px); border: 1px solid;" id="{{\'ordinance_embed\'+vm.ordinanceModel.Id}}"\n                    ng-src="{{vm.getOrdPdfUrl(vm.ordinanceModel)}}" title="{{vm.ordinanceModel.Title}}">\n            </iframe>\n        </div>\n    </div>\n\n</div>\n\n'),e.put("/library/ng-apps/library_desktop/ordinances/ordinances_header.cshtml","<span>{{::model.product.ProductName}}</span> \n<span></span>\n"),e.put("/library/ng-apps/library_desktop/ordinances/ordinances_toc.cshtml",'<mcc-product-toc toc-params="tocParams" data-mcc-emit-dom-finished-updating="tocReady"></mcc-product-toc>'),e.put("/library/ng-apps/library_desktop/product_notifications/product_notifications_confirm.cshtml",'<div role="status">\n    <div ng-if="vm.isLoading">\n        <p class="text-xxl text-center"><i class="fa fa-refresh fa-spin" aria-hidden="true"></i> Loading...</p>\n    </div>\n    <div ng-if="!vm.isLoading">\n        <div ng-if="vm.isSuccess" class="alert alert-success text-center">\n            <p><span class="text-xxl pull-left"><i class="fa fa-thumbs-o-up"></i></span> \n            Thank you for confirming your publication notifications.\n            You will receive emails when your publications are updated online.</p>\n            <p><a class="btn btn-primary" href="#" target="_self">Municode Library Home</a></p>\n        </div>\n        <div ng-if="!vm.isSuccess" class="alert alert-danger text-center">\n            <p><span class="text-xxl pull-left"><i class="fa fa-exclamation-circle"></i></span> There was an error adding your publication notification subscription. Please contact support.</p>\n            <p><a class="btn btn-primary" href="https://support.municode.com/support/home">Municode Support</a></p>\n        </div>\n    </div>\n</div>'),e.put("/library/ng-apps/library_desktop/product_notifications/product_notifications_unsubscribe.cshtml",'<div role="status">\n    <div ng-if="vm.isLoading">\n        <p class="text-xxl text-center"><i class="fa fa-refresh fa-spin" aria-hidden="true"></i> Loading...</p>\n    </div>\n    <div ng-if="!vm.isLoading">\n        <div ng-if="vm.isSuccess" class="alert alert-success text-center">\n            <p>\n                <span class="text-xxl pull-left"><i class="fa fa-thumbs-o-up"></i></span> \n                You have successfully unsubscribed. You will no longer receive emails when that publication is updated online.\n            </p>\n            <p><a class="btn btn-primary" href="#" target="_self">Municode Library Home</a></p>\n        </div>\n        <div ng-if="!vm.isSuccess" class="alert alert-danger text-center">\n            <p><span class="text-xxl pull-left"><i class="fa fa-exclamation-circle"></i></span> There was an error unsubscribing from email notifications for that publication. Please contact support.</p>\n            <p><a class="btn btn-primary" href="https://support.municode.com/support/home">Municode Support</a></p>\n        </div>\n    </div>\n</div>'),e.put("/library/ng-apps/library_desktop/search/header_search.cshtml",'<search class="navbar-search expanded inner-focus" style="width: 100%;" data-intro="Search all hosted content for any given municipality - simple or advanced" data-position="bottom">\n    <div class="form-group has-feedback">\n        <input type="search" aria-label="{{vm.placeholder}}" class="header-search-input form-control no-ms-clear" auto-complete="vm.autoCompleteOptions" autocomplete="off" spellcheck="off" name="headerSearch" id="headerSearch" placeholder="{{vm.placeholder}}" ng-model="vm.searchText">\n        <span\n            id="clearSearch"\n            ng-if="vm.searchText"\n            title="Clear search"\n            class="btn btn-icon-toggle form-control-feedback"\n            style="cursor: pointer; pointer-events: all;"\n            ng-click="vm.clearSearch()"\n            uib-tooltip="clear"\n            ng-mousedown="vm.mouseDown($event)">\n            <i class="fa fa-close text-accent"></i>\n        </span>\n    </div>\n</search>'),e.put("/library/ng-apps/library_desktop/search/mobile_search.cshtml",'<button type="button" class="btn btn-icon-toggle" ng-click="vm.searchClick()" aria-label="Search" title="Search" bootstrap-tooltip data-trigger="hover" data-placement="left"><i class="fa fa-search"></i></button>'),e.put("/library/ng-apps/library_desktop/search/saved_search.cshtml",'<div>\n    <div ng-if="!vm.isAlreadySaved()">\n        <div ng-if="!vm.isShowingSaveSearchForm">\n            <div title="This feature is available for logged-in users" ng-if="!$root.mccUserSvc.isSingleUser()">\n                <button type="button" class="btn btn-flat disabled"\n                        aria-disabled="true">\n                    <span class="fa fa-plus"></span> Save this search\n                    <span class="visually-hidden">This feature is available for logged-in users</span>\n                </button>\n            </div>\n            <button type="button" ng-if="$root.mccUserSvc.isSingleUser()" class="btn btn-flat btn-primary" ng-click="vm.isShowingSaveSearchForm = true">\n                <span class="fa fa-plus"></span> Save this search\n            </button>\n        </div>\n        <div ng-if="vm.isShowingSaveSearchForm" class="card">\n            <div class="card-body small-padding">\n                <form class="form-horizontal" ng-submit="vm.saveSearchSubmit()">\n                    <div class="form-group">\n                        <div class="col-sm-6">\n                            <label for="title" class="visually-hidden">Title</label>\n                            <input id="title" type="text" class="form-control" ng-model="vm.savedSearch.title" mcc-focus-and-select/>\n                        </div>\n                        <div class="col-sm-6">\n                            <button type="submit" class="btn btn-raised btn-sm btn-primary">\n                                <span class="fa fa-save"></span> Save\n                            </button>\n                            <button type="button" class="btn btn-flat" ng-click="vm.isShowingSaveSearchForm = false">\n                                <span class="fa fa-times"></span> Cancel\n                            </button>\n                        </div>\n                    </div>\n                </form>\n            </div>\n        </div>\n    </div>\n    <div ng-if="vm.isAlreadySaved()">\n        <span class="fa fa-check"></span> Saved\n        <button type="button" class="btn btn-flat btn-sm" ng-click="vm.deleteSavedSearch()">\n            Delete\n        </button>\n    </div>\n</div>'),e.put("/library/ng-apps/library_desktop/search/search.cshtml",'<style>    \n    search {\n        /*adding 8px of right margin, because the search button is pushed 8px to the right*/\n        margin-right: 8px;\n    }\n    \n    .card-head.collapsible {\n        cursor: pointer;\n    }\n\n    .search-result-checkbox.checkbox-styled:not(ie8) input[type="checkbox"]:not(:checked) ~ span:before {\n        border-color: #096fcc !important;\n    }\n\n    .search-result-body > ol.breadcrumb > li {\n        white-space: normal;\n        overflow: initial;\n    }\n\n    #accordion .accordion-title .fa-minus,\n    #accordion .collapsed .accordion-title .fa-plus {\n        display: inline-block;\n    }\n\n    #accordion .collapsed .accordion-title .fa-minus,\n    #accordion .accordion-title .fa-plus {\n        display: none;\n    }\n\n    .invalid {\n        color: #d0291c !important;\n    }\n\n    mcc-custom-date-picker.invalid div input {\n        color: #d0291c !important;\n        border-bottom: 1px solid #d0291c !important;\n    }\n\n    .fa.fa-minus {\n        margin-left: 0px !important;\n    }\n\n    .advancedOptionsMobile {\n        padding: 10px;\n        border: 1px solid black;\n        margin-bottom: 10px;\n    }\n\n    .slideInMuniproAdvert {\n        animation: slide-in-alert 2s forwards !important;\n    }\n\n    a.hit-selector:focus, a.hit-selector:hover {\n        text-decoration: none !important;\n    }\n\n    .results-action-bar-btn {\n        width: auto !important;\n    }\n\n    .action-box {\n        margin-left: 10px !important;\n        min-width: 206px;\n    }\n</style>\n\n<iframe class="d-none" title="Municode search bulk print" name="actionBoxPrintFrame" id="actionBoxPrintFrame" tabindex="-1"></iframe>\n\n\x3c!-- State and municipality select \'Modal\' --\x3e\n\x3c!-- Maybe add a close higher up in the DOM --\x3e\n<div id="stateSelectModal" class="modal state-select-modal" role="dialog" aria-modal="true" aria-labelledby="stateSelectModalTitle" tabindex="-1">\n    <div class="modal-dialog modal-lg">\n        <div class="modal-content">\n            <div class="modal-header">\n                <h2 class="modal-title">\n                    <i class="fa fa-file-text-o"></i> <span id="stateSelectModalTitle">State and Municipality Select</span>\n                </h2>\n                <button type="button" class="btn btn-icon-toggle btn-default" data-dismiss="modal" aria-label="Close">\n                    <i class="md md-close"></i>\n                </button>\n            </div>\n            <div class="modal-body">\n                <section class="no-padding" aria-label="State filters">\n                    <div id="stateSelectModalDescription">\n                        <p class="lead">\n                            Search over 4 million Codes, Ordinances, and Munidocs across the whole nation or narrow\n                            your search by state.\n                        </p>\n                        <p>\n                            Click the filter (<span class="fa fa-fw fa-filter"></span>) icon to select individual municipalities within\n                            a state.\n                        </p>\n                    </div>\n                    <button type="button" class="btn btn-link btn-link-inline" ng-click="vm.toggleSelectAllStates()">\n                        {{ vm.muniproForm.selectAll ? \'Select All\' : \'Deselect All\' }}<span class="visually-hidden"> States</span>\n                    </button>\n                    <div class="clearfix states">\n                        <div id="state-{{state.StateID}}" ng-repeat="state in vm.muniproForm.states" class="col-sm-4 col-xs-12">\n                            <div class="card">\n                                <div class="card-body p-4">\n                                    <div class="mcc-flex-row align-items-center">\n                                        <input id="state-is-selected-{{::state.StateID}}-checkbox" class="mt-0" type="checkbox" ng-model="state.isSelected">\n                                        <label class="mb-0" for="state-is-selected-{{::state.StateID}}-checkbox">\n                                            {{::state.StateName}}\n                                        </label>\n                                        <button id="state-{{state.StateID}}-clientButton" ng-show="state.isSelected" type="button" class="button-unstyled pull-right p-0" ng-click="vm.showClientSelect(state)" ng-class="{\'text-danger\': vm.areStateClientsModified(state)}">\n                                            <span class="fa fa-filter"></span>\n                                            <span class="visually-hidden">Filter by municipality for {{::state.StateName}}</span>\n                                            <span class="visually-hidden" ng-if="vm.areStateClientsModified(state)">At least one municipality is filtered out for this state</span>\n                                        </button>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n            </div>\n            <div class="modal-footer">\n                <section class="no-padding" aria-label="Save changes">\n                    <button type="button" class="btn btn-raised btn-primary ink-reaction" ng-click="vm.submitMuniproSearch()">\n                        Save\n                    </button>\n                </section>\n            </div>\n        </div>\n    </div>\n</div>\n\n\x3c!-- Flyout - State Municipality Selections --\x3e\n<mcc-off-canvas class="col-xs-12 col-sm-9 col-lg-6 no-padding"\n                name="clientSelect"\n                header-title="vm.selectedState.StateName">\n    <div class="d-flex flex-column h-100 gap-4">\n        <section class="d-flex flex-column h-100 scrollable align-items-start no-padding" aria-label="`Municipality filters for {{::vm.selectedState.StateName}}`">\n            <button type="button" class="btn btn-link btn-link-inline" ng-click="vm.toggleSelectAllClients(vm.selectedState)">\n                {{ vm.selectedState.selectAll ? \'Select All\' : \'Deselect All\' }} <span class="visually-hidden"> Municipalities</span>\n            </button>\n            <div>\n                <div ng-repeat="client in ::vm.selectedState.clients" class="col-sm-6 col-md-4">\n                    <div class="card">\n                        <div class="card-body small-padding mcc-flex-row">\n                            <input id="client-is-selected-{{::client.ClientID}}-checkbox" type="checkbox" ng-model="client.isSelected">\n                            <label for="client-is-selected-{{::client.ClientID}}-checkbox">{{::client.ClientName}}</label>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class="no-padding text-right" aria-label="Save changes">\n            <button type="button" class="btn btn-raised btn-primary ink-reaction" data-close>\n                Save\n            </button>\n        </section>\n    </div>\n</mcc-off-canvas>\n\n\x3c!-- Flyout - Email --\x3e\n<mcc-off-canvas class="col-xs-12 col-sm-9 col-md-8 col-lg-4 no-padding"\n                name="email"\n                header-title="\'Email\'"\n                icon-class="fa fa-envelope"\n                options="{keepOpenWithOthers: true}">\n    <mcc-search-results-email-code-links data-params="{ selectedHits: vm.selectedHits, close: $root.OffCanvasSvc.Close, closeParams: [\'email\'] }">\n    </mcc-search-results-email-code-links>\n</mcc-off-canvas>\n\n\x3c!-- Flyout - Share --\x3e\n<mcc-off-canvas class="col-xs-12 col-sm-9 col-md-8 col-lg-5 no-padding"\n                name="sharelink"\n                header-title="\'Share links\'"\n                icon-class="fa fa-link"\n                options="{keepOpenWithOthers: true}">\n    <div class="scrollable d-flex flex-column" style="height: calc(100% - 60px);">\n        <mcc-search-results-share-links data-params="{selectedHits: vm.selectedHits}">\n        </mcc-search-results-share-links>\n    </div>\n    <div style="padding: 20px;">\n        <button type="button" class="btn btn-cancel btn-flat btn-block pull-left" data-close>\n            <span class="fa fa-close"></span> Close\n        </button>\n    </div>\n</mcc-off-canvas>\n\n\x3c!-- Search Mobile Header --\x3e\n<div id="searchMobileHeader" class="hidden-md hidden-lg hidden-xl mobile-header d-flex align-items-center" ng-style="$root.mobileHeaderTheme">\n    <mcc-client-mobile-logo></mcc-client-mobile-logo>\n    <div class="ms-auto me-2 d-flex align-items-center">\n        <div class="btn-group">\n            <button type="button" class="btn btn-icon-toggle ink-reaction dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-label="Action Menu" title="Action Menu" bootstrap-tooltip data-trigger="hover" data-placement="left" data-container="body">\n                <i class="fa fa-ellipsis-v"></i>\n            </button>\n            <ul class="dropdown-menu pull-right animation-expand">\n                <li>\n                    <mcc-sign-in layout="menu"></mcc-sign-in>\n                </li>\n                <li class="divider"></li>\n                \x3c!-- Visit Help Center link --\x3e\n                <li>\n                    <a ng-href="{{::$root.app.supportUrl}}" target="_blank">\n                        <i class="fa fa-life-ring fa-fw"></i>\n                        Visit Help Center\n                    </a>\n                </li>\n                \x3c!-- Submit Feedback link --\x3e\n                <li>\n                    <a href="{{::$root.app.submitFeedbackUrl}}" target="_blank">\n                        <i class="fa fa-lightbulb-o fa-fw"></i>\n                        Submit Feedback\n                    </a>\n                </li>\n            </ul>\n        </div>\n    </div>\n</div>\n\x3c!-- Main content --\x3e\n<div class="zones no-toc">\n  \n    <div class="primary zone content-zone zone-body primary-zone-body no-padding" ng-class="vm.searchForm.mode.toLowerCase()">\n        \x3c!-- Actual content area --\x3e\n        <div class="contain-lg" style="padding: 24px;">\n            <div ng-if="vm.client && vm.searchForm.mode == \'MUNIPROMODE\'" class="mb-4">\n                <a ng-href="{{vm.getClientSearchHref(vm.client)}}">Switch to {{vm.client.ClientName}}, {{vm.client.State.StateAbbreviation}} Search</a>\n            </div>\n            <h2 class="text-primary primary-heading mb-4 mt-0">{{vm.searchHeaderText}}</h2>\n            \x3c!-- Munipro Advertisement --\x3e\n            <section class="muniproSearchAdvert no-padding" ng-if="vm.showMuniproAdvert" aria-label="MuniPRO Advertisement" aria-describedby="muniproAdvertDescription">\n                <div id="muniproAdvertDescription" ng-class="{\'slideInMuniproAdvert\': vm.slideInMuniproAdvert }" class="alert alert-callout alert-info text-center text-lg mb-4">\n                    <p>\n                        Want to simultaneously search and be notified of changes to over 4,000 municipal codes and 130,000 ordinances?\n                    </p>\n                    <p>\n                        Learn more about the\n                        <a class="text-primary muniproSignupLink" ng-href="{{ vm.cpMuniproMarketingPageUrl }}" ng-click="vm.onAdvertClick($event)" target="_blank" aria-label="Learn more about the MuniPRO Municipal Law Research Tool">\n                            MuniPRO Municipal Law Research Tool\n                        </a> today!\n                    </p>\n                </div>\n            </section>\n            \x3c!-- Ip Based Munipro Search Callout --\x3e\n            <section class="no-padding" ng-if="vm.showIpBasedMuniproSearchCallout" aria-label="IP-based Munipro search callout" aria-describedby="showIpBasedMuniproSearchCalloutDescription">\n                <div id="showIpBasedMuniproSearchCalloutDescription" class="alert alert-callout alert-info text-center text-lg mb-4">\n                    <p>\n                        <strong>Good news!</strong> Your current network, {{vm.userIpBasedOrganizationName}}, gives you access to a nationwide search with MuniPro.\n                        <span ng-if="vm.searchForm.mode !== \'MUNIPROMODE\'">\n                            Click <strong>MuniPRO Search</strong> to explore over <strong>4,000 municipal codes and 130,000 ordinances.</strong>\n                        </span>\n                    </p>\n                </div>\n            </section>\n\n            \x3c!-- Search Form --\x3e\n            <search class="contain-sm">\n                <form class="form mb-4" ng-submit="vm.submitSearch()">\n                    <div class="d-flex flex-column flex-md-row align-items-md-center gap-3">\n                        <div class="d-flex flex-grow-1" style="z-index: 1;">\n                            <label class="visually-hidden" for="searchBox">Enter search terms</label>\n                            <input ng-model="vm.searchForm.searchText"\n                                   id="searchBox" type="search" placeholder="Enter search terms"\n                                   class="form-control" ng-class="{\'dirty\': vm.searchForm.searchText}"\n                                   ng-change="vm.onSearchTextChange()"\n                                   style="padding: 0 12px; background: white; border: 1px solid #ccc;"/>\n                            <button type="submit" class="btn btn-primary">\n                                <span class="fa fa-search"></span>\n                                <span class="visually-hidden">Search</span>\n                            </button>\n                        </div>\n                        <div class="d-flex flex-wrap justify-content-center gap-3">\n                            \x3c!-- Help Button --\x3e\n                            <a ng-href="{{::$root.app.advancedSearchSupportUrl}}" class="button-styled-link btn btn-primary" aria-label="Search help" target="_blank">\n                                <span class="fa fa-question-circle"></span> Help\n                            </a>\n                            \x3c!-- Select States Button --\x3e\n                            <button style="z-index: 100" type="button" ng-if="vm.searchForm.mode == \'MUNIPROMODE\'" data-toggle="modal" data-target="#stateSelectModal" class="btn btn-primary">\n                                <span class="fa fa-fw fa-map-marker"></span> Select states\n                            </button>\n                            \x3c!-- MuniPro Search Button --\x3e\n                            <a ng-if="$root.userHasMuniproSearchAccess && vm.searchForm.mode != \'MUNIPROMODE\'"\n                               ui-sref="search({ searchMode: \'MUNIPROMODE\', contentTypeId: vm.searchForm.contentTypeId })"\n                               class="btn btn-success button-styled-link"\n                               bootstrap-tooltip\n                               data-trigger="hover"\n                               data-placement="bottom"\n                               title="Go to the MuniPro search"\n                               aria-label="Go to MuniPro search">\n                                <i class="md md-search"></i> <span>MuniPro Search</span>\n                            </a>\n                        </div>\n                    </div>\n                </form>\n            </search>\n            \x3c!-- Empty Search Message - if munipro enabled --\x3e\n            <section\n                class="contain-sm no-padding"\n                ng-if="!vm.getSearchRequest().searchText && vm.searchForm.mode == \'MUNIPROMODE\'"\n                aria-labelledby="muniproEmptySearchTitle"\n                aria-describedby="muniproEmptySearchDescription">\n                <div class="card">\n                    <div class="card-head style-default-light">\n                        <header>\n                            <h3 id="muniproEmptySearchTitle">Munipro Search</h3>\n                        </header>\n                    </div>\n                    <div id="muniproEmptySearchDescription" class="card-body">\n                        <p class="lead">\n                            Search millions of code sections, ordinances, and documents across the entire nation.\n                        </p>\n                        <p>\n                            To begin, enter search term(s) above and optionally limit your search to states or\n                            municipalities.\n                        </p>\n                    </div>\n                </div>\n            </section>\n\n            \x3c!-- Empty Search Message - if munipro disabled --\x3e\n            <section\n                class="contain-sm no-padding"\n                ng-if="!vm.getSearchRequest().searchText && vm.searchForm.mode == \'CLIENTMODE\'"\n                aria-labelledby="emptySearchTitle"\n                aria-describedby="emptySearchDescription">\n                <div class="card">\n                    <div class="card-head style-default-light">\n                        <header>\n                            <h3 id="emptySearchTitle">Search</h3>\n                        </header>\n                    </div>\n                    <div id="emptySearchDescription" class="card-body">\n                        <p class="lead">\n                            Search code sections, ordinances, and documents provided by {{::vm.client.ClientName}},\n                            {{::vm.client.State.StateAbbreviation}}.\n                        </p>\n                        <p>\n                            To begin, enter search term(s) above. Click <em>HELP</em> for assistance in constructing\n                            your search query.\n                        </p>\n                    </div>\n                </div>\n            </section>\n\n            \x3c!-- Search Results --\x3e\n            <div class="card results" ng-if="vm.getSearchRequest().searchText">\n                \x3c!-- Search Results Header --\x3e\n                <div class="card-head card-head-sm style-default-light">\n                    \x3c!-- Search Results Content Type Tabs --\x3e\n                    <ul role="tablist" class="nav nav-tabs pull-left" aria-label="Content types">\n                        <li id="CODES" role="presentation" ng-class="{\'active\': vm.getSearchRequest().contentTypeId == \'CODES\'}">\n                            <button type="button" ng-click="vm.setSearchContentType(\'CODES\')" role="tab" aria-selected="{{vm.getSearchRequest().contentTypeId == \'CODES\'}}" aria-controls="{{$root.viewportHelper.isMobile() ? \'tabpanel-mobile\' : \'tabpanel\'}}">\n                                Codes <span class="badge style-primary">{{ vm.getSearchResults().contentTypeFacets[\'code_doc\'] }}</span><span class="visually-hidden"> results</span>\n                            </button>\n                        </li>\n                        <li id="ORDINANCES" role="presentation" ng-class="{\'active\': vm.getSearchRequest().contentTypeId == \'ORDINANCES\', \'disabled\': vm.codeBankMode}">\n                            <button type="button" ng-hide="vm.codeBankMode" ng-click="vm.setSearchContentType(\'ORDINANCES\')" role="tab" aria-selected="{{vm.getSearchRequest().contentTypeId == \'ORDINANCES\'}}" aria-controls="{{$root.viewportHelper.isMobile() ? \'tabpanel-mobile\' : \'tabpanel\'}}">\n                                Ordinances <span class="badge style-primary">{{ vm.getSearchResults().contentTypeFacets[\'ordinance_doc\'] }}</span><span class="visually-hidden"> results</span>\n                            </button>\n                        </li>\n                        <li id="MUNIDOCS" role="presentation" ng-class="{\'active\': vm.getSearchRequest().contentTypeId == \'MUNIDOCS\', \'disabled\': vm.codeBankMode}">\n                            <button type="button" ng-hide="vm.codeBankMode" ng-click="vm.setSearchContentType(\'MUNIDOCS\')" role="tab" aria-selected="{{vm.getSearchRequest().contentTypeId == \'MUNIDOCS\'}}" aria-controls="{{$root.viewportHelper.isMobile() ? \'tabpanel-mobile\' : \'tabpanel\'}}">\n                                Documents <span class="badge style-primary">{{ vm.getSearchResults().contentTypeFacets[\'munidoc\'] }}</span><span class="visually-hidden"> results</span>\n                            </button>\n                        </li>\n                    </ul>\n                    \x3c!-- Search Results Sort-By Dropdown --\x3e\n                    <div class="pull-right form-inline inline-sort">\n                        <div ng-include="\'searchResultsSortTemplate\'"></div>\n                    </div>\n                </div>\n                \x3c!-- Search Results Body - Desktop --\x3e\n                <div id="tabpanel" role="tabpanel" tabindex="-1" aria-labelledby="{{vm.getSearchRequest().contentTypeId}}" class="card-body tab-content padd" ng-if="!$root.viewportHelper.isMobile()">\n                    <div class="container-fluid">\n                        <div class="row">\n                            \x3c!-- Search Results Body - Left Content - External Links - Filters  --\x3e\n                            <div class="col-md-3">\n                                <nav aria-label="External search links" ng-if="vm.searchForm.mode != \'MUNIPROMODE\' && (vm.hasIntegratedSearch || vm.hasSocialMediaArchiveSearch)">\n                                    <ul class="list-unstyled">\n                                        \x3c!-- Conditional Link for Integrated Search --\x3e\n                                        <li ng-if="vm.hasIntegratedSearch">\n                                            <a class="btn-primary btn-flat"\n                                               target="_blank"\n                                               href=""\n                                               ng-href="{{vm.getIntegratedSearchUrl()}}">\n                                                <span class="fa fa-external-link"></span>\n                                                Search Municipal Website\n                                            </a>\n                                        </li>\n\n                                        \x3c!-- Conditional Link for Social Media Archive Search --\x3e\n                                        <li ng-if="vm.hasSocialMediaArchiveSearch">\n                                            <a class="btn-primary btn-flat"\n                                               target="_blank"\n                                               href=""\n                                               ng-href="{{vm.getSocialMediaArchiveSearchUrl()}}">\n                                                <span class="fa fa-external-link"></span>\n                                                Search Social Media Archive\n                                            </a>\n                                        </li>\n                                        \x3c!-- Conditional Link for Next Request Search --\x3e\n                                        <li ng-if="vm.hasNextRequestSearch">\n                                            <a class="btn-primary btn-flat"\n                                               target="_blank"\n                                               href=""\n                                               ng-href="{{vm.getNextRequestSearchUrl()}}">\n                                                <span class="fa fa-external-link"></span>\n                                                Search Public Records Requests\n                                            </a>\n                                        </li>\n                                    </ul>\n                                </nav>\n\n                                \x3c!-- Facet Template Include --\x3e\n                                <div ng-include="\'facetTemplate\'"></div>\n                            </div>\n\n                            \x3c!-- Search Results Body - Right Content - Actual Results - Actions --\x3e\n                            <div class="col-md-9">\n\n                                \x3c!-- Date Range Accordion--\x3e\n                                <section ng-if="vm.shouldShowAdvancedOptions()" class="no-padding" id="accordion" aria-label="Date range accordion">\n                                    <div class="card" ng-class="{\'card-outlined style-primary\': vm.dateRangeFilterActive }">\n                                        <button type="button" class="card-head collapsible collapsed accordion-header" data-toggle="collapse" data-target="#dateRangeCollapse" aria-expanded="false" aria-controls="dateRangeCollapse">\n                                            <div class="accordion-title">\n                                                <span class="fa fa-plus"></span>\n                                                <span class="fa fa-minus"></span>\n                                                Filter By Date\n                                            </div>\n                                            <div id="currentDateRange" class="tools" ng-if="vm.dateRangeFilterActive">\n                                                <span class="text-lg me-3">From: {{ ::vm.getDateDescription(vm.dateRanges.startDate) }}</span>\n                                                <span class="text-lg">To: {{ ::vm.getDateDescription(vm.dateRanges.endDate) }}</span>\n                                            </div>\n                                        </button>\n                                        <div id="dateRangeCollapse" class="collapse">\n                                            <div class="card-body">\n                                                <div role="alert">\n                                                    <div class="alert alert-danger" ng-repeat="error in vm.advancedOptionsFormErrors">\n                                                        <span class="fa fa-exclamation-triangle" aria-hidden="true"></span>\n                                                        {{ error.text }}\n                                                    </div>\n                                                </div>\n                                                <ul class="list-inline" role="presentation">\n                                                    <li class="form-group">\n                                                        <label for="fromDate" ng-class="{\'control-label\': true, \'invalid\': vm.hasError(\'startDate\')}">\n                                                            From <span class="visually-hidden"> date</span>\n                                                        </label>\n                                                        <mcc-custom-date-picker id="startDate" data-input-id="fromDate" ng-class="{\'invalid\': vm.hasError(\'startDate\')}" ng-model="vm.dateRanges.startDate">\n                                                        </mcc-custom-date-picker>\n                                                    </li>\n                                                    <li class="form-group">\n                                                        <label for="toDate" ng-class="{\'control-label\': true, \'invalid\': vm.hasError(\'endDate\')}">\n                                                            To <span class="visually-hidden"> date</span>\n                                                        </label>\n                                                        <mcc-custom-date-picker id="endDate" data-input-id="toDate" ng-class="{\'invalid\': vm.hasError(\'endDate\')}" ng-model="vm.dateRanges.endDate">\n                                                        </mcc-custom-date-picker>\n                                                    </li>\n                                                </ul>\n                                                <button type="button" class="btn btn-primary" ng-click="vm.applyFilter()">\n                                                    APPLY\n                                                </button>\n                                                <button type="button" ng-if="vm.dateRanges.startDate != undefined || vm.dateRanges.endDate != undefined" class="btn btn-primary" ng-click="vm.resetDateRanges()">\n                                                    RESET\n                                                </button>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </section>\n\n                                \x3c!-- Search Results - Number of Results - Save Search --\x3e\n                                <div class="mcc-flex-row mcc-align-items-center">\n                                    <div role="status">\n                                        <h3 ng-if="!vm.isSearching()" class="text-light">{{ vm.getSearchResults().numOfHits }} results</h3>\n                                    </div>\n                                    <mcc-saved-search></mcc-saved-search>\n                                </div>\n\n                                \x3c!-- Search Results - Toggle Select All --\x3e\n                                <button type="button" class="btn btn-flat btn-link btn-link-inline mb-2" ng-if="vm.getSearchResults().numOfHits > 0" ng-click="vm.toggleSelectAllResults()">\n                                    {{vm.selectedHits.length > 0 ? "SELECT NONE" : "SELECT ALL"}}<span class="visually-hidden"> Search Results</span>\n                                </button>\n\n                                \x3c!-- Actual results --\x3e\n                                <div class="search-results clear">\n                                    <div class="d-flex">\n                                        \x3c!-- Search Results --\x3e\n                                        <mcc-main-content aria-label="Search results">\n                                            <h3 ng-if="!vm.isSearching() && vm.getSearchResults().numOfHits == 0 && vm.shouldShowSuggestions() " class="h4 text-normal text-lg result-title">\n                                                No results found. However, there are results for: <a target="_parent" ng-href="{{vm.getSuggestedUri()}}">{{vm.getSuggestedTerms()}}</a>\n                                            </h3>\n                                            <div ng-repeat="hit in vm.getSearchResults().hits" class="search-result card">\n                                                <div class="card-body">\n                                                    <div class="search-result-body">\n                                                        <div class="search-result-head">\n                                                            <label for="result-checkbox-{{::hit.nodeId}}" class="visually-hidden" ng-bind-html="::hit.title"></label>\n                                                            <input id="result-checkbox-{{::hit.nodeId}}" type="checkbox" ng-checked="vm.isHitSelected(hit)" ng-click="vm.onHitSelected(hit)"/>\n                                                            <h4 class="text-normal result-title">\n                                                                <a class="text-lg text-primary" href=""\n                                                                   ng-href="{{::vm.getHref(hit)}}"\n                                                                   ng-bind-html="::hit.title"\n                                                                   ng-click="vm.setNavOrigin()">\n                                                                </a>\n                                                            </h4>\n                                                        </div>\n                                                        <ol class="breadcrumb w200">\n                                                            <li>\n                                                                <a href="" ng-href="{{::vm.getAncestorHref(hit, {nodeId: hit.product.id})}}" ng-click="vm.setNavOrigin()">\n                                                                    <span ng-if="vm.searchForm.mode != \'CLIENTMODE\'">\n                                                                        {{::hit.client.name}}, {{::hit.stateAbbr}}\n                                                                    </span>\n                                                                    {{::hit.product.name}}\n                                                                    <span ng-if="::vm.codeBankMode">{{::vm.publicationVersion.name}}</span>\n                                                                </a>\n                                                            </li>\n                                                            <li ng-repeat="ancestor in ::vm.getAncestors(hit)">\n                                                                <a href="" ng-href="{{::vm.getAncestorHref(hit,ancestor)}}" ng-click="vm.setNavOrigin()">\n                                                                    {{::ancestor.title}}\n                                                                </a>\n                                                            </li>\n                                                        </ol>\n                                                        <div ng-bind-html="::hit.contentFragment">\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </mcc-main-content>\n                                        \x3c!-- Search Result Actions --\x3e\n                                        <section class="mcc_search_results_action_box no-padding" ng-if="vm.hasSelectedHits()" aria-label="Selected search result actions">\n                                            \x3c!-- Code Actions --\x3e\n                                            <div class="well action-box text-primary ms-2" ng-if="vm.getSearchRequest().contentTypeId == \'CODES\'">\n                                                <ul class="btn-group-vertical list-unstyled">\n                                                    <li ng-if="::vm.docActions.sharelink.enabled">\n                                                        <button data-actionId="sharelink" type="button" class="btn btn-primary btn-flat results-action-bar-btn">\n                                                            <span class="fa fa-link"></span> Share\n                                                        </button>\n                                                    </li>\n                                                    <li>\n                                                        <button data-actionId="print" type="button" class="btn btn-primary btn-flat results-action-bar-btn">\n                                                            <span class="fa fa-print"></span> Print\n                                                        </button>\n                                                    </li>\n                                                    <li>\n                                                        <button data-actionId="download" type="button" class="btn btn-primary btn-flat results-action-bar-btn">\n                                                            <span class="fa fa-arrow-down"></span> Download\n                                                        </button>\n                                                    </li>\n                                                    <li ng-if="::vm.docActions.email.enabled">\n                                                        <button data-actionId="email" type="button" class="btn btn-primary btn-flat results-action-bar-btn">\n                                                            <span class="fa fa-envelope-o"></span> Email\n                                                        </button>\n                                                    </li>\n                                                </ul>\n                                            </div>\n                                            \x3c!-- Ordinance Actions --\x3e\n                                            <div class="well action-box text-primary hidden-xs pull-right" ng-if="vm.getSearchRequest().contentTypeId == \'ORDINANCES\'">\n                                                <ul class="btn-group-vertical list-unstyled ">\n                                                    <li>\n                                                        <button data-actionId="download" type="button" class="btn btn-primary btn-flat results-action-bar-btn">\n                                                            <span class="fa fa-arrow-down"></span> Download\n                                                        </button>\n                                                    </li>\n                                                    <li ng-if="::vm.docActions.sharelink.enabled">\n                                                        <button data-actionId="sharelink" type="button" class="btn btn-primary btn-flat results-action-bar-btn">\n                                                            <span class="fa fa-link"></span> Share\n                                                        </button>\n                                                    </li>\n                                                </ul>\n                                            </div>\n                                            \x3c!-- Document Actions --\x3e\n                                            <div class="well action-box text-primary hidden-xs pull-right" ng-if="vm.getSearchRequest().contentTypeId == \'MUNIDOCS\'">\n                                                <ul class="btn-group-vertical list-unstyled ">\n                                                    <li>\n                                                        <button data-actionId="download" type="button" class="btn btn-primary btn-flat results-action-bar-btn">\n                                                            <span class="fa fa-arrow-down"></span> Download\n                                                        </button>\n                                                    </li>\n                                                    <li ng-if="::vm.docActions.sharelink.enabled">\n                                                        <button data-actionId="sharelink" type="button" class="btn btn-primary btn-flat results-action-bar-btn">\n                                                            <span class="fa fa-link"></span> Share\n                                                        </button>\n                                                    </li>\n                                                </ul>\n                                            </div>\n                                        </section>\n                                    </div>\n                                    <mcc-search-pager max-pages="10"></mcc-search-pager>\n                                    <div class="form">\n                                        <div class="form-group action-group">\n                                            <select id="pageResultsSize" aria-label="Select how many results to show on the page" class="form-control" ng-model="vm.pageSize"\n                                                    ng-change="vm.onPageSizeChange()"\n                                                    ng-options="num for num in [10,20,50]">\n                                            </select>\n                                            <label for="pageResultsSize">Results per page</label>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                \x3c!-- Search Results Body - Mobile--\x3e\n                <div id="tabpanel-mobile" role="tabpanel" tabindex="-1" aria-labelledby="{{vm.getSearchRequest().contentTypeId}}" class="card-body ps-2 pe-2" ng-if="$root.viewportHelper.isMobile()">\n\n                    \x3c!-- Search Results Body - Filter Button - Filters (also Advanced [By Date]) - Sort-By  --\x3e\n                    <div class="clearfix">\n                        \x3c!-- Filter Card --\x3e\n                        <div class="pull-right margin-bottom-xl" mcc_scope_variable_toggle="showFilterInfoCard" mcc_scope_variable_toggle_intial_state="false">\n                            <button type="button" class="btn btn-md btn-raised" ng-click="mccSimpleToggleVar.showFilterInfoCard.toggleState()" aria-expanded="{{mccSimpleToggleVar.showFilterInfoCard.value}}" aria-controls="filterCard" aria-haspopup="dialog">\n                                <span class="fa fa-filter"></span> Filters\n                            </button>\n\n                            <section class="no-padding full-screen-info-card-wrapper" id="filterCard" ng-if="mccSimpleToggleVar.showFilterInfoCard.value" aria-label="Search Filters" role="dialog">\n                                <div class="card">\n                                    <div class="card-head style-default-light">\n                                        <header>\n                                            <h3>\n                                                <span class="fa fa-filter"></span> Filters\n                                            </h3>\n                                        </header>\n                                        <div class="tools">\n                                            <button type="button" class="btn btn-icon-toggle close-right" ng-click="mccSimpleToggleVar.showFilterInfoCard.toggleState()">\n                                                <span class="fa fa-close"></span> <span class="visually-hidden">Close</span>\n                                            </button>\n                                        </div>\n                                    </div>\n                                    <div class="card-body">\n                                        \x3c!-- Advanced Options for Mobile --\x3e\n                                        <div ng-if="vm.shouldShowAdvancedOptions()" class="advancedOptionsMobile">\n                                            <span class="h4">Filter By Date</span>\n                                            \x3c!-- Error Messages --\x3e\n                                            <div role="alert">\n                                                <div class="alert alert-danger" ng-repeat="error in vm.advancedOptionsFormErrors">\n                                                    <span class="fa fa-exclamation-triangle"></span> {{ error.text }}\n                                                </div>\n                                            </div>\n                                            \x3c!-- Date Range Filters --\x3e\n                                            <ul class="list-inline" role="presentation">\n                                                \x3c!-- From Date --\x3e\n                                                <li class="form-group">\n                                                    <label for="fromDatePicker" ng-class="{\'control-label\': true, \'invalid\': vm.hasError(\'startDate\')}">\n                                                        From<span class="visually-hidden"> date</span>\n                                                    </label>\n                                                    <mcc-custom-date-picker data-input-id="fromDatePicker" ng-class="{\'invalid\': vm.hasError(\'startDate\')}" ng-model="vm.dateRanges.startDate"></mcc-custom-date-picker>\n                                                </li>\n                                                \x3c!-- To Date --\x3e\n                                                <li class="form-group">\n                                                    <label for="toDatePicker" ng-class="{\'control-label\': true, \'invalid\': vm.hasError(\'endDate\')}">\n                                                        To<span class="visually-hidden"> date</span>\n                                                    </label>\n                                                    <mcc-custom-date-picker data-input-id="toDatePicker" ng-class="{\'invalid\': vm.hasError(\'endDate\')}" ng-model="vm.dateRanges.endDate"></mcc-custom-date-picker>\n                                                </li>\n                                            </ul>\n\n                                            \x3c!-- Filter Buttons --\x3e\n                                            <button type="button" class="btn btn-primary" ng-click="vm.applyFilter()">APPLY</button>\n                                            <button type="button" ng-if="vm.dateRanges.startDate != undefined || vm.dateRanges.endDate != undefined" class="btn btn-primary" ng-click="vm.resetDateRanges()">RESET</button>\n                                        </div>\n\n                                        \x3c!-- Include Facet Template --\x3e\n                                        <div ng-include="\'facetTemplate\'"></div>\n\n                                        \x3c!-- Sorting Options --\x3e\n                                        <form class="form">\n                                            <div ng-include="\'searchResultsSortTemplate\'"></div>\n                                        </form>\n                                    </div>\n                                </div>\n                            </section>\n                        </div>\n\n                        \x3c!-- Search Results Status --\x3e\n                        <div role="status">\n                            <h3 ng-if="!vm.isSearching()" class="results-title text-light">\n                                Showing results {{ vm.getSearchResults().startNum }} to\n                                {{ vm.getSearchResults().endNum }} of {{ vm.getSearchResults().numOfHits }}\n                            </h3>\n                        </div>\n                        <div role="status" ng-if="!vm.isSearching() && vm.getSearchResults().numOfHits == 0">\n                            <h3 ng-if="!vm.isSearching()" class="text-light"> results</h3>\n                            <div ng-if="!vm.isSearching() && vm.getSearchResults().numOfHits == 0 && vm.getSuggestedTerms() != \'\'" class="text-light d-inline-block" style="font-size:24px;">\n                                <a target="_parent" ng-href="{{vm.getSuggestedUri()}}">However, there are results for: {{vm.getSuggestedTerms()}}</a>\n                            </div>\n                        </div>\n                    </div>\n\n                    \x3c!-- External Links --\x3e\n                    <nav aria-label="External search links" ng-if="vm.searchForm.mode != \'MUNIPROMODE\' && (vm.hasIntegratedSearch || vm.hasSocialMediaArchiveSearch)">\n                        \x3c!-- Conditional Link for Integrated Search --\x3e\n                        <ul class="list-unstyled">\n                            <li ng-if="vm.hasIntegratedSearch">\n                                <a class="btn-primary btn-flat" target="_blank" href=""\n                                   ng-href="{{vm.getIntegratedSearchUrl()}}">\n                                    <span class="fa fa-external-link"></span> Search Municipal Website\n                                </a>\n                            </li>\n\n                            \x3c!-- Conditional Link for Social Media Archive Search --\x3e\n                            <li ng-if="vm.hasSocialMediaArchiveSearch">\n                                <a class="btn-primary btn-flat" target="_blank" href=""\n                                   ng-href="{{vm.getSocialMediaArchiveSearchUrl()}}">\n                                    <span class="fa fa-external-link"></span> Search Social Media Archive\n                                </a>\n                            </li>\n                        </ul>\n                    </nav>\n\n                    \x3c!-- Actual Results --\x3e\n                    <div class="search-results clear">\n\n                        \x3c!-- Search Results --\x3e\n                        <section class="no-padding" style="overflow: hidden;" aria-label="Search results">\n                            <div ng-repeat="hit in vm.getSearchResults().hits" class="search-result card">\n                                <div class="card-body">\n                                    <div class="search-result-body">\n                                        <div class="search-result-head">\n                                            <label for="result-checkbox-mobile-{{::hit.nodeId}}" class="visually-hidden" ng-bind-html="::hit.title"></label>\n                                            <input id="result-checkbox-mobile-{{::hit.nodeId}}" type="checkbox" ng-checked="vm.isHitSelected(hit)" ng-click="vm.onHitSelected(hit)"/>\n                                            <h4 class="text-normal result-title">\n                                                <a class="text-lg text-primary" href=""\n                                                   ng-href="{{::vm.getHref(hit)}}"\n                                                   ng-bind-html="::hit.title"\n                                                   ng-click="vm.setNavOrigin()">\n                                                </a>\n                                            </h4>\n                                        </div>\n                                        <ol class="breadcrumb w200">\n                                            <li>\n                                                <a ng-href="{{::vm.getAncestorHref(hit, {nodeId: hit.product.id})}}" aria-label="Go to {{::hit.product.name}}" ng-click="vm.setNavOrigin()">\n                                                    <span ng-if="vm.searchForm.mode != \'CLIENTMODE\'">\n                                                        {{::hit.client.name}}, {{::hit.state.abbr}}\n                                                    </span>\n                                                    {{::hit.product.name}}\n                                                    <span ng-if="::vm.codeBankMode">{{::vm.publicationVersion.name}}</span>\n                                                </a>\n                                            </li>\n                                            <li ng-repeat="ancestor in ::vm.getAncestors(hit)">\n                                                <a ng-href="{{::vm.getAncestorHref(hit,ancestor)}}" aria-label="Go to {{::ancestor.title}}" ng-click="vm.setNavOrigin()">\n                                                    {{::ancestor.title}}\n                                                </a>\n                                            </li>\n                                        </ol>\n                                        <div ng-bind-html="::hit.contentFragment">\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </section>\n\n                        \x3c!-- Search Result Actions --\x3e\n                        <section class="mcc_search_results_action_box no-padding" hl-sticky="" anchor="bottom" ng-if="vm.hasSelectedHits()" aria-label="Selected search result actions">\n                            \x3c!-- Code Actions --\x3e\n                            <ul class="well row action-box text-primary list-unstyled" ng-if="vm.getSearchRequest().contentTypeId == \'CODES\'">\n                                <li class="col-xs-3 text-center" ng-if="::vm.docActions.sharelink.enabled">\n                                    <button data-actionId="sharelink" type="button" class="btn btn-primary btn-flat results-action-bar-btn" title="Share link">\n                                        <span class="fa fa-link"></span>\n                                    </button>\n                                </li>\n                                <li class="col-xs-3 text-center">\n                                    <button data-actionId="print" type="button" class="btn btn-primary btn-flat results-action-bar-btn" title="Print">\n                                        <span class="fa fa-print"></span>\n                                    </button>\n                                </li>\n                                <li class="col-xs-3 text-center">\n                                    <button data-actionId="download" type="button" class="btn btn-primary btn-flat results-action-bar-btn" title="Download">\n                                        <span class="fa fa-arrow-down"></span>\n                                    </button>\n                                </li>\n                                <li class="col-xs-3 text-center" ng-if="::vm.docActions.email.enabled">\n                                    <button data-actionId="email" type="button" class="btn btn-primary btn-flat results-action-bar-btn" title="Email">\n                                        <span class="fa fa-envelope-o"></span>\n                                    </button>\n                                </li>\n                            </ul>\n                            \x3c!-- Ordinance Actions --\x3e\n                            <ul class="well row action-box text-primary list-unstyled" ng-if="vm.getSearchRequest().contentTypeId == \'ORDINANCES\'">\n                                <li class="col-xs-6 text-center">\n                                    <button data-actionId="download" type="button" class="btn btn-primary btn-flat results-action-bar-btn" title="Download">\n                                        <span class="fa fa-arrow-down"></span>\n                                    </button>\n                                </li>\n                                <li class="col-xs-6 text-center" ng-if="::vm.docActions.sharelink.enabled">\n                                    <button data-actionId="sharelink" type="button" class="btn btn-primary btn-flat results-action-bar-btn" title="Share link">\n                                        <span class="fa fa-link"></span>\n                                    </button>\n                                </li>\n                            </ul>\n                            \x3c!-- Document Actions --\x3e\n                            <ul class="well row action-box text-primary list-unstyled" ng-if="vm.getSearchRequest().contentTypeId == \'MUNIDOCS\'">\n                                <li class="col-xs-6 text-center">\n                                    <button data-actionId="download" type="button" class="btn btn-primary btn-flat results-action-bar-btn" title="Download">\n                                        <span class="fa fa-arrow-down"></span>\n                                    </button>\n                                </li>\n                                <li class="col-xs-6 text-center" ng-if="::vm.docActions.sharelink.enabled">\n                                    <button data-actionId="sharelink" type="button" class="btn btn-primary btn-flat results-action-bar-btn" title="Share link">\n                                        <span class="fa fa-link"></span>\n                                    </button>\n                                </li>\n                            </ul>\n                        </section>\n                        <mcc-search-pager max-pages="10"></mcc-search-pager>\n                        <div class="form-group action-group">\n                            <label for="pageSizeSelect" class="visually-hidden">Results per page</label>\n                            <select id="pageSizeSelect" class="form-control" ng-model="vm.pageSize" ng-change="vm.onPageSizeChange()"\n                                    ng-options="num for num in [10,20,50]">\n                            </select>\n                            <span aria-hidden="true">per page</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n<div role="status">\n    <div ng-if="vm.isSearching()">\n        <div class="card searching-notification">\n            <div class="card-head style-info">\n                <header>\n                    <span class="fa fa-circle-o-notch fa-spin fa-fw"></span>\n                    Getting your results...\n                </header>\n            </div>\n            <div class="card-body" ng-show="vm.searchForm.mode==\'MUNIPROMODE\'" aria-hidden="{{vm.searchForm.mode != \'MUNIPROMODE\'}}">\n                <div class="alert alert-callout alert-info">\n                    <span class="fa fa-info-circle fa-fw"></span>\n                    Some MuniPRO queries may take up to a minute.\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<script id="facetTemplate" type="text/ng-template">\n    <section class="no-padding" aria-label="Search Filters">\n        <div ng-if="vm.isNonEmptyArray(vm.getSearchResults().munidocTypeFacets)">\n            <div class="margin-bottom-lg">\n                <h3 class="h4 no-margin">\n                    Content\n                </h3>\n                <small>\n                    <button type="button" ng-click="vm.selectAllMunidocTypeFacets()" class="btn btn-flat btn-sm btn-link btn-link-inline">\n                        <span class="visually-hidden">Content search filters </span>Select all\n                    </button> \n                    <button type="button" ng-click="vm.selectNoneMunidocTypeFacets()" class="btn btn-flat btn-sm btn-link btn-link-inline">\n                        <span class="visually-hidden">Content search filters </span>Select none\n                    </button>\n                </small>\n            </div>\n            <ul class="list-unstyled" aria-label="Content search filters">\n                <li ng-repeat="munidocTypeFacet in vm.getSearchResults().munidocTypeFacets">\n                    <div class="mcc-flex-row">\n                        <input id="munidoc-type-heading-checkbox-{{::munidocTypeFacet.munidocType.id}}" type="checkbox" ng-model="vm.universalFacets.munidocTypes[munidocTypeFacet.munidocType.id].active" ng-change="vm.onMunidocTypeFacetChange()" />\n                        <label for="munidoc-type-heading-checkbox-{{::munidocTypeFacet.munidocType.id}}">{{::munidocTypeFacet.munidocType.heading}}</label>\n                        <span class="badge style-primary">{{::munidocTypeFacet.docCount}}</span>\n                    </div>\n                </li>\n            </ul>\n        </div>\n        <div ng-if="vm.isNonEmptyArray(vm.getSearchResults().munidocFolderFacets)">\n            <div class="margin-bottom-lg">\n                <h3 class="h4 no-margin">\n                    Folders \n                </h3>\n                <small>\n                    <button type="button" ng-click="vm.selectAllMunidocFolderFacets()" class="btn btn-flat btn-sm btn-link btn-link-inline">\n                        <span class="visually-hidden">Folders search filters </span>Select all\n                    </button>\n                    <button type="button" ng-click="vm.selectNoneMunidocFolderFacets()" class="btn btn-flat btn-sm btn-link btn-link-inline">\n                        <span class="visually-hidden">Folders search filters </span>Select none\n                    </button>\n                </small>\n            </div>\n            <ul class="list-unstyled" aria-label="Folders search filters">\n                <li ng-repeat="munidocFolderFacet in vm.getSearchResults().munidocFolderFacets">\n                    <div class="mcc-flex-row">\n                        <input id="munidoc-folder-heading-checkbox-{{::munidocFolderFacet.munidocFolder.id}}" type="checkbox" ng-model="vm.universalFacets.munidocFolders[munidocFolderFacet.munidocFolder.id].active" ng-change="vm.onMunidocFolderFacetChange()" />\n                        <label for="munidoc-folder-heading-checkbox-{{::munidocFolderFacet.munidocFolder.id}}">{{::munidocFolderFacet.munidocFolder.heading}}</label>\n                        <span class="badge style-primary">{{::munidocFolderFacet.docCount}}</span>\n                    </div>\n                </li>\n            </ul>\n        </div>\n        <div ng-if="vm.searchForm.mode == \'CLIENTMODE\'">\n            <div ng-if="vm.isNonEmptyArray(vm.getSearchResults().productFacets)">\n                <div class="margin-bottom-lg">\n                    <h3 class="h4 no-margin">\n                        Products\n                    </h3>\n                    <span ng-if="vm.getSearchResults().productFacets.length > 2">\n                        <small>\n                            <button type="button" class="btn btn-sm btn-flat btn-link btn-link-inline" ng-click="vm.selectAllProductFacets()">\n                                <span class="visually-hidden">Products search filters </span>Select all\n                            </button>\n                            <button type="button" class="btn btn-sm btn-flat btn-link btn-link-inline" ng-click="vm.selectNoneProductFacets()">\n                                <span class="visually-hidden">Products search filters </span>Select none\n                            </button>\n                        </small>\n                    </span>\n                </div>\n                <ul class="list-unstyled" aria-label="Products search filters">\n                    <li ng-repeat="productFacet in vm.getSearchResults().productFacets">\n                        <div class="mcc-flex-row">\n                            <input id="product-checkbox-{{::productFacet.product.id}}" type="checkbox" ng-model="vm.clientFacets.products[productFacet.product.id].active" ng-change="vm.onProductFacetChange()" />\n                            <label for="product-checkbox-{{::productFacet.product.id}}">{{::productFacet.product.name}}</label>\n                            <span class="badge style-primary">{{::productFacet.docCount}}</span>\n                        </div>\n                    </li>\n                </ul>\n            </div>\n            <div ng-if="vm.isNonEmptyArray(vm.getSearchResults().ancestorFacets)">\n                <div class="margin-bottom-lg">\n                    <h3 class="h4 no-margin">\n                        Content \n                    </h3>\n                    <small>\n                        <button type="button" ng-click="vm.selectAllContentFacets()" class="btn btn-flat btn-sm btn-link btn-link-inline">\n                            <span class="visually-hidden">Content search filters </span>Select all\n                        </button> \n                        <button type="button" ng-click="vm.selectNoneContentFacets()" class="btn btn-flat btn-sm btn-link btn-link-inline"> \n                            <span class="visually-hidden">Content search filters </span>Select none\n                        </button>\n                    </small>\n                </div>\n                <ul class="list-unstyled" aria-label="Content search filters">\n                    <li ng-repeat="ancestorFacet in vm.getSearchResults().ancestorFacets">\n                        <div class="mcc-flex-row">\n                            <input id="ancestor-heading-checkbox-{{::ancestorFacet.ancestor.id}}" type="checkbox" ng-model="vm.clientFacets.ancestors[ancestorFacet.ancestor.id].active" ng-change="vm.onAncestorFacetChange()" />\n                            <label for="ancestor-heading-checkbox-{{::ancestorFacet.ancestor.id}}">{{::ancestorFacet.ancestor.heading}}</label>\n                            <span class="badge style-primary">{{::ancestorFacet.docCount}}</span>\n                        </div>\n                    </li>\n                </ul>\n            </div>\n        </div>\n        <div ng-if="vm.searchForm.mode == \'MUNIPROMODE\'">\n            <div class="margin-bottom-lg">\n                <h3 class="h4 no-margin" ng-if="vm.isNonEmptyArray(vm.getSearchResults().classificationFacets)">\n                    Classification\n                </h3>\n                <span ng-if="vm.getSearchResults().classificationFacets.length > 2">\n                    <small>\n                        <button type="button" class="btn btn-sm btn-flat btn-link btn-link-inline" ng-click="vm.selectAllClassificationFacets()">\n                            <span class="visually-hidden">Classification search filters </span>Select all\n                        </button>\n                        <button type="button" class="btn btn-sm btn-flat btn-link btn-link-inline" ng-click="vm.selectNoneClassificationFacets()">\n                            <span class="visually-hidden">Classification search filters </span>Select none\n                        </button>\n                    </small>\n                </span>\n            </div>\n            <ul class="list-unstyled" aria-label="Classification search filters">\n                <li ng-repeat="classificationFacet in vm.getSearchResults().classificationFacets">\n                    <div class="mcc-flex-row">\n                        <input id="classification-checkbox-{{::classificationFacet.id}}" type="checkbox" ng-model="vm.muniproFacets.classifications[classificationFacet.id].active" ng-change="vm.onClassificationFacetChange()" />\n                        <label for="classification-checkbox-{{::classificationFacet.id}}">{{::classificationFacet.name}}</label>\n                        <span class="badge style-primary">{{::classificationFacet.docCount}}</span>\n                    </div>\n                </li>\n            </ul>\n            <div class="margin-bottom-lg">\n                <h3 class="h4 no-margin" ng-if="vm.isNonEmptyArray(vm.getSearchResults().popRangeFacets)">\n                    Pop Range\n                </h3>\n                <span ng-if="vm.getSearchResults().popRangeFacets.length > 2">\n                    <small>\n                        <button type="button" class="btn btn-sm btn-flat btn-link btn-link-inline" ng-click="vm.selectAllPopRangeFacets()">\n                            <span class="visually-hidden">Population range search filters </span>Select all\n                        </button>\n                        <button type="button" class="btn btn-sm btn-flat btn-link btn-link-inline" ng-click="vm.selectNonePopRangeFacets()">\n                            <span class="visually-hidden">Population range search filters </span>Select none\n                        </button>\n                    </small>\n                </span>\n            </div>\n            <ul class="list-unstyled" aria-label="Population range search filters">\n                <li ng-repeat="popRangeFacet in vm.getSearchResults().popRangeFacets">\n                    <div class="mcc-flex-row">\n                        <input id="pop-range-checkbox-{{::popRangeFacet.popId}}" type="checkbox" ng-model="vm.muniproFacets.popRanges[popRangeFacet.popId].active" ng-change="vm.onPopRangeFacetChange()" />\n                        <label for="pop-range-checkbox-{{::popRangeFacet.popId}}">{{::popRangeFacet.popRange}}</label>\n                        <span class="badge style-primary">{{::popRangeFacet.docCount}}</span>\n                    </div>\n                </li>\n            </ul>\n        </div>\n    </section>\n<\/script>\n\n<script id="searchResultsSortTemplate" type="text/ng-template">\n    <div class="form-group">\n        <label for="searchResultsSort" class="visually-hidden">Sort search results by</label>\n        <select \n            id="searchResultsSort"\n            class="form-control"\n            ng-options="option.name for option in vm.contentTypeData[vm.getSearchRequest().contentTypeId].sortOptions track by option.value"\n            ng-model="vm.contentTypeData[vm.getSearchRequest().contentTypeId].sort"\n            ng-change="vm.onSortChange()">\n        </select>\n    </div>\n<\/script>\n\n\n<div class="visually-hidden" role="status">\n    <span ng-if="vm.hasSelectedHits()">\n        Selected search result actions landmark is available.\n    </span>\n</div>\n\n<div role="status" class="visually-hidden">\n    {{ vm.stateSelectionStatus | uppercase }}\n</div>\n\n<div role="status" class="visually-hidden">\n    {{ vm.municipalitySelectionStatus | uppercase }}\n</div>\n'),e.put("/library/ng-apps/library_desktop/search/search_left_menu.cshtml",'<mcc-client-menu ng-if="vm.showClientMenu"></mcc-client-menu>\n<mcc-default-left-menu ng-if="!vm.showClientMenu"></mcc-default-left-menu>'),e.put("/library/ng-apps/library_desktop/search/search_print_results_wrapper.cshtml",'\n\n<!DOCTYPE html>\n\n<html>\n<head>\n    <meta name="viewport" content="width=device-width" />\n    <title>Search Results | Municipal Code Corporation</title>\n    <link href=\'https://fonts.googleapis.com/css?family=Open+Sans:300,400,400italic,600,700,800\' rel=\'stylesheet\' type=\'text/css\'>\n    <link href="/library/dist/css/libs/libs.css" rel="stylesheet" />\n    <link href="/library/dist/css/library-app/library-app.css" rel="stylesheet" />\n    <style>\n        body{\n            overflow:visible !important;\n        }\n    </style>\n</head>\n<body>\n    \n</body>\n</html>\n'),e.put("/library/ng-apps/library_desktop/search/search_results.cshtml",'<div class="mini-search-results">\n    <div ng-show="!vm.searchSvc.results.numOfHits && vm.isInitialState">\n        <p>{{::vm.getNoSearchText()}}</p>\n        <p>Give it a shot:</p>\n    </div>\n    <div ng-show="!vm.searchSvc.results.numOfHits && !vm.isInitialState">\n        <h3><i class="fa fa-frown-o"></i> No Results</h3>\n        <p id="noResultsDescription" tabindex="-1">Your search returned no results. Try again?</p>\n    </div>\n    <div ng-show="!vm.searchSvc.results.numOfHits">\n        <search>\n            <form class="form" ng-submit="vm.searchSubmit()">\n                <div class="form-group" id="searchResultsText">\n                    <input type="search" id="searchResultsInput" class="form-control" ng-model="vm.searchForm.searchText"/>\n                    <label for="searchResultsInput">Search Term</label>\n                </div>\n                <button type="submit" class="btn btn-raised ink-reaction btn-primary">{{ vm.isInitialState ? \'Search\' : \'Search Again\' }}</button>\n            </form>\n        </search>\n    </div>\n    <div ng-show="vm.searchSvc.results.numOfHits > 0">\n        <h3>Results for <em>{{vm.searchSvc.request.searchText}}</em></h3>\n        <span id="resultsFoundDescription" tabindex="-1" class="visually-hidden">Results found for {{vm.searchSvc.request.searchText}}</span>\n        <button type="button" ng-click="vm.clearSearch()" class="btn btn-flat text-sm">Reset</button>\n        <a ng-href="{{ vm.getSearchPageUrl() }}" class="btn btn-flat text-sm">Advanced Search</a>\n        <ul class="list-unstyled">\n            <li ng-repeat="hit in vm.searchSvc.results.hits" class="result" ng-class="{\'active\': hit.id == $root.$stateParams.nodeId}">\n                <p>\n                    <span class="result-num">{{::vm.searchSvc.results.startNum + $index}}</span>\n                            <a class="text-primary" href="" ng-href="{{::vm.getHref(hit)}}" ng-bind-html="::hit.title" ng-click="vm.setNavOrigin()"></a>\n                    <span ng-if="::vm.searchSvc.request.mode==\'CLIENTMODE\'" class="product-name text-muted">{{::hit.product.name}}</span>\n                    <span class="crumb text-muted" ng-repeat="ancestor in ::vm.getAncestors(hit)">\n                        <a class="" href="" ng-href="{{::vm.getAncestorHref(hit,ancestor)}}" ng-click="vm.setNavOrigin()">{{::ancestor.title}}</a>\n                    </span>\n                </p>\n            </li>\n        </ul>\n        <mcc-search-pager max-pages="4"></mcc-search-pager>\n    </div>\n</div>\n<div id="searchStatusRegion" role="status" aria-live="polite" class="visually-hidden"></div>\n'),e.put("/library/ng-apps/library_desktop/search/search_results_email_code_links.cshtml",'<style>\n    mcc-codes-email {\n        display: block;\n        height: 100%;\n    }\n\n    .email-body {\n        height: 100%;\n    }\n\n    .email-footer {\n        padding: 10px;\n        text-align: right;\n    }\n\n    .has-error .validationIndicator {\n        color: #E60A15;\n    }\n\n    .validationIndicator {\n        color: #067F16;\n    }\n\n    .auxLabel {\n        margin-right: 5px;\n    }\n\n    .validationIndicator {\n        position: relative;\n        top: -1px;\n        font-size: 18px;\n    }\n\n        .validationIndicator .fa-times { /*fa-times*/\n            position: relative;\n            top: 4px;\n        }\n\n        .validationIndicator .fa-check { /*fa-check*/\n            position: relative;\n            top: 4px;\n        }\n\n    .tag-item {\n        background: #096fcc !important;\n        border-color: #096fcc !important;\n    }\n\n    .remove-button, .remove-button:hover {\n        color: #fff !important;\n    }\n\n    .links {\n        color: #096fcc !important;\n    }\n\n    .extra-margin {\n        margin: 5px;\n    }\n\n    tags-input .tags .input {\n        width: 100% !important;\n        padding: 0 !important;\n        height: 37px !important;\n        border-left: none !important;\n        border-right: none !important;\n        border-top: none !important;\n        background: transparent !important;\n        color: #0c0c0c !important;\n        font-size: 16px !important;\n        border-bottom: 1px solid rgba(12, 12, 12, 0.12) !important;\n        -webkit-box-shadow: none !important;\n        box-shadow: none !important;\n    }\n\n        tags-input .tags .input:focus {\n            border-color: #096fcc !important;\n            outline: 0 !important;\n            box-shadow: none !important;\n        }\n\n    tags-input .tags {\n        border: none !important;\n        border-radius: 1px !important;\n        box-shadow: none !important;\n    }\n\n        tags-input .tags .input.invalid-tag {\n            color: #d0291c !important;\n        }\n\n    tags-input.invalid .tags .input {\n        border-bottom: 1px solid #d0291c !important;\n    }\n\n    .invalid {\n        color: #d0291c !important;\n    }\n\n    .step-3 {\n        height: 100%;\n    }\n\n    .email-container {\n        display: flex;\n        flex-direction: column;\n        height: 100%;\n    }\n\n    .tags-label {\n        width: 100%;\n    }\n\n    .alert-info {\n        background-color: #f2f2f3;\n        color: #313335;\n        border-color: #f2f2f3;\n    }\n\n    .alert-danger {\n        color: #721c24;\n    }\n\n    .alert-success {\n        color: #155724;\n    }\n    \n    .hit {\n        background-color: #fff !important;\n    }\n</style>\n\n\n<div role="status">\n    <div ng-if="vm.isLoading" style="text-align: center;">\n        <span class="visually-hidden">Loading, please wait</span>\n        <img src="dist/img/ajax-loader.gif" alt="loading indicator" aria-hidden="true"/>\n    </div>\n    <span ng-if="!vm.isLoading" class="visually-hidden">Loading complete</span>\n</div>\n<div ng-show="!vm.isLoading" class="email-container">\n    <div>\n        <div id="address-info" class="alert alert-info">\n            <span class="fa fa-lightbulb-o"></span> To add multiple addresses, type each address followed by a space or comma.\n        </div>\n    </div>\n\n    <div role="alert">\n        <div class="alert alert-danger" ng-repeat="error in vm.errors">\n            <span class="fa fa-exclamation-triangle"></span> {{error.text}}\n        </div>\n    </div>\n\n    <div ng-class="{\'email-body\': true, \'scrollable\': true }">\n\n        <div>\n            <div>\n                <label class="tags-label">\n                    <p ng-class="{invalid: vm.hasError(\'recipients\')}">To:</p>\n                    <tags-input aria-label="Add a recipient address. To add multiple addresses, type each address followed by a space or comma." text="vm.recipientAddressText" ng-class="{invalid: vm.hasError(\'recipients\')}" ng-model="vm.recipients" type="email" placeholder="add a recipient address" allowed-tags-pattern="{{vm.allowedTagsPattern}}" add-on-blur="true" add-on-space="true" add-on-paste="true">\n                    </tags-input>\n                </label>\n            </div>\n\n            <div>\n                <label class="tags-label">\n                    <p ng-class="{invalid: vm.hasError(\'ccRecipients\')}">CC:</p>\n                    <tags-input aria-label="Add a CC address." id="ccAddress" text="vm.ccRecipientAddressText" ng-class="{invalid: vm.hasError(\'ccRecipients\')}" ng-model="vm.ccRecipients" type="email" placeholder="add a CC address" add-on-blur="true" allowed-tags-pattern=\'{{vm.allowedTagsPattern}}\'>\n                    </tags-input>\n                </label>\n            </div>\n\n            <label for="emailSubject">Subject:</label>\n            <div class="extra-margin">\n                <textarea id="emailSubject" class="form-control" ng-model="vm.messageSubject" type="text">\n                </textarea>\n            </div>\n\n            <span>Links being sent:</span>\n            <div class="extra-margin">\n                <ul class="list-group list-group-flush">\n                    <li class="list-group-item" ng-repeat="linkToSend in vm.linksToSend" ng-bind-html="linkToSend">\n                    </li>\n                </ul>\n            </div>\n        </div>\n    </div>\n    <div ng-show="!vm.isLoading" class="email-footer">\n        <div class="alert alert-info recaptcha-info">\n            This site is protected by reCAPTCHA and the Google\n            <a href="https://policies.google.com/privacy">Privacy Policy</a> and\n            <a href="https://policies.google.com/terms">Terms of Service</a> apply.\n        </div>\n        <form class="actionBarForm form-inline" ng-class="{\'has-error\' : vm.actionBarForm.$invalid}" name="actionBarForm" novalidate ng-submit="vm.onSubmit($event)">\n            <button type="submit" class="btn btn-primary btn-raised" ng-click="vm.onSubmit($event)" mcc-aria-disabled="vm.isEmailing || vm.actionBarForm.$invalid">\n                <span class="fa" ng-class="vm.isEmailing ? \'fa-spin fa-circle-o-notch\' : \'fa-envelope\'"></span> Send\n            </button>\n            <div style="display: none" id="search-email-recaptcha" type="hidden" data-size="invisible"></div>\n            <span ng-if="vm.emailError" class="label label-danger" role="status">Error</span>\n        </form>\n    </div>\n</div>\n\n\n'),e.put("/library/ng-apps/library_desktop/search/search_results_nav.cshtml",'<style>\n    mcc-search-results-nav{ display: block;}\n</style>\n<div class="results-pager-nav" ng-if="vm.jqHits.length">\n    <nav>\n        <ul class="pager">\n            <li ng-class="{\'disabled\': vm.currentHitIndex == 0}">\n                <button type="button" class="btn btn-default-bright" ng-click="vm.previousClick()">\n                    <i class="fa fa-angle-left"></i> Prev Hit\n                </button>\n            </li>\n            <li ng-class="{\'disabled\': vm.currentHitIndex == vm.jqHits.length - 1}">\n                <button type="button" class="btn btn-default-bright" ng-click="vm.nextClick()">\n                    Next Hit <i class="fa fa-angle-right"></i>\n                </button>\n            </li>\n        </ul>\n    </nav>\n</div>'),e.put("/library/ng-apps/library_desktop/search/search_results_share_links.cshtml",'<style>    \n    .alert-info {\n        background-color: #f2f2f3;\n        color: #313335;\n        border-color: #f2f2f3;\n    }\n</style>\n\n<div style="height: 100%;">\n    <section aria-label="Share Links" aria-describedby="infoHeader" class="no-padding">\n        <p class="lead">Copy the links in the list below.</p>\n        <div id="infoHeader" class="alert alert-info">\n            <p class="lead">Some things you can do with these links:</p>\n            <ol>\n                <li><mark>Share</mark> with others using Email, Facebook, Twitter, Chat, etc</li>\n                <li>Add to your <mark>browser favorites</mark> for quick access to this content later</li>\n            </ol>\n        </div>\n\n        <span id="linksHeader">Links to share:</span>\n        <div class="extra-margin">\n            <ul class="list-group" aria-labelledby="linksHeader">\n                <li class="list-group-item" ng-repeat="linkToShare in vm.linksToShare">\n                    <textarea style="cursor: text; overflow: hidden; word-break: break-all" \n                    class="form-control" \n                    ng-focus="$event.target.select();" \n                    aria-label="Copy URL, text selected." \n                    readonly>{{linkToShare.url}}</textarea>\n                </li>\n            </ul>\n        </div>\n    </section>\n</div>\n'),e.put("/library/ng-apps/library_desktop/state_listing/state_listing-partial.cshtml",'<div id="stateListingMobileHeader" class="hidden-md hidden-lg hidden-xl mobile-header d-flex align-items-center">\n    <div style="padding: 8px 24px;">\n        <img src="dist/img/cp-municode-codification-logo.svg" alt="CivicPlus Municode Codification logo" />\n    </div>\n    <div class="ms-auto">\n        <mcc-sign-in></mcc-sign-in>\n    </div>\n    <div class="dropdown me-2">\n        <button class="btn btn-flat dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Help menu" title="Help menu" bootstrap-tooltip data-trigger="hover" data-placement="bottom">\n            <i class="md md-help"></i>\n            <span class="caret"></span>\n        </button>\n        <ul class="dropdown-menu dropdown-menu-right">\n            \x3c!-- Visit Help Center link --\x3e\n            <li>\n                <a ng-href="{{::$root.app.supportUrl}}" target="_blank">\n                    <i class="fa fa-life-ring fa-fw"></i>\n                    Visit Help Center\n                </a>\n            </li>\n            \x3c!-- Submit Feedback link --\x3e\n            <li>\n                <a href="{{::$root.app.submitFeedbackUrl}}" target="_blank">\n                    <i class="fa fa-lightbulb-o fa-fw"></i>\n                    Submit Feedback\n                </a>\n            </li>\n        </ul>\n    </div>\n</div>\n<div class="zones no-toc" mcc-zone-mgr>\n    <mcc-main-content class="primary state-list zone content-zone style-default-bright">\n        <div class="zone-body primary-zone-body">\n            <h1 class="text-primary primary-heading">Find Your Municipality</h1>\n            <div class="row">\n                <div class="hidden-xs" mcc-state-map></div>\n            </div>\n            <div class="text-center">\n                <div class="mcc-btn-group">\n                    <a ng-repeat="category in groups.categories" class="btn btn-default-light index-link" style="text-transform: none" href="" ng-href="{{::stateListing.getAnchorHref(category)}}">View {{::category.StateName}}</a>\n                </div>\n            </div>\n            <h2 class="text-divider" style="white-space: nowrap">Jump To</h2>\n            <div class="container-fluid">\n                <div class="text-center">\n                    <section class="mcc-btn-group no-padding" aria-label="Alphabetical index of state and municipality groups">\n                        <a aria-label="Letter {{::stateGroup.heading}}" aria-describedby="heading-description" ng-repeat="stateGroup in groups.stateGroups" class="btn btn-default-light index-link" href="" ng-href="#{{::stateGroup.heading}}">\n                            <span class="">{{::stateGroup.heading}}</span>\n                        </a>\n                        <p id="heading-description" class="visually-hidden">\n                            Jumps to states and municipalities starting with specified letter\n                        </p>\n                    </section>\n                </div>\n                <section class="no-padding" aria-label="Alphabetical list of states and municipalities">\n                    <div ng-repeat="stateGroup in groups.stateGroups">\n                        <h2 class="text-divider" id="{{::stateGroup.heading}}">{{::stateGroup.heading}}</h2>\n                        <ul class="nav row">\n                            <li ng-repeat="state in stateGroup.states" class="col-xs-12 col-md-6 col-lg-4 text-center">\n                                <a class="index-link" href="" ng-href="{{::stateListing.getAnchorHref(state)}}">{{::state.StateName}}</a>\n                            </li>\n                        </ul>\n                    </div>\n                </section>\n            </div>\n\n        </div>\n    </mcc-main-content>\n</div>\n'),e.put("/library/ng-apps/library_desktop/state_listing/state_listing_search-view.cshtml",'<div>\n    <mcc-header-search search-params="searchParams"/> \n</div>'),e.put("/library/ng-apps/library_desktop/client_home/home_content.cshtml",'<div id="clientHomeMobileHeader" class="hidden-md hidden-lg hidden-xl mobile-header d-flex align-items-center" ng-style="$root.mobileHeaderTheme">\n    <mcc-client-mobile-logo></mcc-client-mobile-logo>\n    <div class="ms-auto me-2 d-flex align-items-center">\n        <mcc-mobile-search class="d-flex"></mcc-mobile-search>\n        <div class="btn-group">\n            <button type="button" class="btn btn-icon-toggle ink-reaction dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-label="Action menu" title="Action menu" bootstrap-tooltip data-trigger="hover" data-placement="left" data-container="body">\n                <i class="fa fa-ellipsis-v"></i>\n            </button>\n            <ul class="dropdown-menu pull-right animation-expand">\n                <li>\n                    <mcc-sign-in layout="menu"></mcc-sign-in>\n                </li>\n                <li class="divider"></li>\n                \x3c!-- Visit Help Center link --\x3e\n                <li>\n                    <a ng-href="{{::$root.app.supportUrl}}" target="_blank">\n                        <i class="fa fa-life-ring fa-fw"></i>\n                        Visit Help Center\n                    </a>\n                </li>\n                \x3c!-- Submit Feedback link --\x3e\n                <li>\n                    <a href="{{::$root.app.submitFeedbackUrl}}" target="_blank">\n                        <i class="fa fa-lightbulb-o fa-fw"></i>\n                        Submit Feedback\n                    </a>\n                </li>\n            </ul>\n        </div>\n    </div>\n</div>\n<div class="zones no-toc" mcc-zone-mgr>\n    <mcc-main-content class="primary client-home content-zone zone">\n        <div class="zone-body primary-zone-body" ng-if="::!model.clientContent">\n            <div role="alert">\n                <div class="alert alert-warning">\n                    <p>The client was not found. Municode does not host their codes.</p>\n                </div>\n            </div>\n        </div>\n        <div class="zone-body primary-zone-body" ng-if="::model.clientContent">\n            <h2 class="text-primary primary-heading">Publications</h2>\n            <div class="container-fluid">\n                <ul class="nav row">\n                    <li ng-repeat="code in model.clientContent.codes | orderBy: \'productName\'" class="col-xs-12 col-sm-6 col-lg-4 text-center" ng-class="{\'col-sm-offset-3 col-lg-offset-4\': model.clientContent.codes.length == 1, \'col-lg-offset-2\': (model.clientContent.codes.length == 2 && $index == 0) }">\n                        <div class="card height-6">\n                            <div class="card-head style-default-light">\n                                <header>{{::code.productName}}</header>\n                            </div>\n                            <div class="card-body small-padding">\n                                <div>\n                                    <p>{{::code.currentJobName}}</p>\n                                    <p ng-if="code.showLastModifiedPublicationDate && code.latestUpdatedDate">Online content updated on {{::code.latestUpdatedDate | date: \'longDate\'}}</p>\n                                    <p class="text-center">\n                                        <a class="btn btn-primary btn-raised" aria-label="Browse {{code.productName}}" href="" ng-href="{{model.productHref(code)}}"><span class="">Browse</span> »</a>\n                                        <button class="btn btn-success btn-raised btn-pdf-download" aria-label="Download PDF for {{code.productName}}" type="button" aria-disabled="false" ng-if="code.hasPdf && code.hasPdfDownloadEnabled" ng-click="model.openPdfDownloadModal(code)"><span class="">DOWNLOAD PDF <span class="fa fa-download"></span></span></button>\n                                        <button class="btn disabled btn-raised" aria-label="A downloadable PDF copy is not available for this publication" data-bootstrap-tooltip="" data-trigger="hover" data-placement="right" data-container="body" title="A downloadable PDF copy is not available for this publication" \n                                                type="button" aria-disabled="true" ng-if="!code.hasPdf && code.hasPdfDownloadEnabled"><span class="">DOWNLOAD PDF <span class="fa fa-download"></span></span></button>\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </li>\n                </ul>\n\n\n                <h3 class="text-divider">Documents</h3>\n                <div role="status">\n                    <div ng-if="!model.clientContent.munidocs.length">\n                        <div class="alert alert-callout alert-success text-center">This organization does not use MuniDocs to host documents.</div>\n                    </div>\n                </div>\n                <div ng-if="model.clientContent.munidocs.length">\n                    <ul class="nav row">\n                        <li ng-repeat="munidocProduct in model.clientContent.munidocs | orderBy: \'productName\'" class="col-xs-12 col-sm-6 col-lg-4 text-center" ng-class="{\'col-sm-offset-3 col-lg-offset-4\': model.clientContent.munidocs.length == 1, \'col-lg-offset-2\' : (model.clientContent.munidocs.length == 2 && $index == 0) }">\n                            <div class="card">\n                                <div class="card-head style-default-light">\n                                    <header>{{::munidocProduct.productName}}</header>\n                                </div>\n                                <div class="card-body small-padding">\n                                    <p class="text-center">\n                                        <a class="btn btn-success btn-raised" aria-label="Browse {{munidocProduct.productName}}" href="" ng-href="{{model.productHref(munidocProduct)}}" ><span class="">Browse</span> »</a>\n                                    </p>\n                                </div>\n                                <div style="width:75%; display:inline-block; margin-bottom:20px;">MuniDocs contains documents as designated by {{ model.client.ClientName }}.</div>\n                            </div>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n\n            <div class="row client-info">\n                <div class="col-xs-12" style="text-align: center;">\n                    <p>\n                        <i class="fa fa-map-marker"></i> <span data-ng-bind="::model.client.Address + \', \' + model.client.City + \', \' + model.client.State.StateAbbreviation + \' \' + model.client.ZipCode"></span>\n                    </p>\n                    <p>\n                        <a href="" ng-href="http://{{::model.client.Website}}" target="_blank">\n                            <i class="fa fa-external-link"></i> <span data-ng-bind="::model.client.Website"></span>\n                        </a>\n                    </p>\n                </div>\n            </div>\n        </div>\n    </mcc-main-content>\n</div>'),e.put("/library/ng-apps/library_desktop/client/common/breadcrumb.cshtml",'<style>\n    mcc-bread-crumb {\n        display:block;\n        position: relative;\n    }\n</style>\n<div class="breadcrumb-wrapper" ng-class="{\'loading\': model.gettingData}">\n    <div style="position: absolute; left: 50%;" ng-show="model.gettingData">\n        <span style="transform: translate(-50%, 0)">\n            <i class="fa fa-2x fa-circle-o-notch fa-spin" aria-hidden="true"></i>\n        </span>\n        <span class="visually-hidden">Loading, please wait</span>\n    </div>\n    <ol class="breadcrumb">\n        <li ng-style="{\'max-width\': crumbPercent + \'%\'}" class="ancestor" data-ng-repeat="ancestor in model.ancestors">\n            <a href="" ng-href="{{model.getHref(ancestor)}}" title="{{::ancestor.Heading}}">\n                <span data-ng-bind="::ancestor.Heading"></span>\n            </a>\n        </li>\n        <li ng-style="{\'max-width\': crumbPercent + \'%\'}" class="current" data-intro="Breadcrumb" data-position="right">\n            <a href="" ng-href="{{model.getHref(model.activeNode)}}" title="{{model.activeNode.Heading}}">\n                <span data-ng-bind="model.activeNode.Heading"></span>\n            </a>\n        </li>\n    </ol>\n</div>\n'),e.put("/library/ng-apps/library_desktop/client/common/product_toc.cshtml",'<style>\n    mcc-product-toc {\n        display: block;\n    }\n\n    .nav > li > .toc-item-expand {\n        padding-left: 6px;\n        padding-right: 6px;\n        float: left;\n    }\n\n    .toc-item-expand:hover, .toc-item-expand:focus {\n        background: inherit !important;\n        color: #096fcc;\n    }\n\n    .nav > li > .toc-item-heading {\n        margin-left: 30px;\n        padding-left: 6px;\n    }\n</style>\n<div class="gen-toc loading-aware" id="genToc" ng-class="{\'loading\': toc.isLoading}">\n    <div role="status">\n        <div style="position: absolute; left: 50%;" ng-if="toc.isLoading">\n            <span style="transform: translate(-50%, 0)">\n                <span class="visually-hidden">Loading, please wait</span>\n                <i class="fa fa-4x fa-circle-o-notch fa-spin" aria-hidden="true"></i>\n            </span>\n        </div>\n        <div ng-if="toc.showError" class="card style-warning">\n            <div class="card-body">\n                <p>There was an error loading the Table of Contents</p>\n            </div>\n        </div>\n    </div>\n    \n    <ul class="nav nav-pills nav-stacked gen-toc-nav" id="genTocList">\n        \n        <li ng-repeat="node in toc.topLevelNodes track by node.Id" id="genToc_{{::node.Id}}" data-ng-include="\'mccGenTocNodeTemplate\'" data-ng-class="{\'active\': toc.isActive(node)}" depth="0"></li>\n    </ul>\n    <script type="text/ng-template" id="mccGenTocNodeTemplate">\n        <span id="genTocAnchor_{{::node.Id}}" class="anchor-offset"></span>\n        <button ng-if="::node.HasChildren" \n                ng-click="toc.toggleShowChildrenClick($event, node)" \n                class="toc-item-expand btn btn-flat" \n                aria-controls="children_of_{{::node.Id}}"\n                aria-expanded="{{!!node.isExpanded}}">\n            <span><span class="visually-hidden">{{node.isExpanded ? \'Collapse \' + node.Heading : \'Expand \' + node.Heading }}</span>\n            <i class="fa-fw" ng-class="{\'fa fa-chevron-right\': !node.isExpanded, \'fa fa-chevron-down\': node.isExpanded}"></i></span>\n        </button>\n        <a href="" data-ng-href="{{::toc.getNodeHref(node)}}" \n           class="toc-item-heading"\n           ng-click="toc.setNavOrigin()">\n            <span data-ng-bind="::node.Heading" data-ng-class="{\'folderRoot\' : node.Children.length}"></span>\n            <span class="visually-hidden" ng-if="::($root.mccStateParams.product.LandingPageID == 3 && node.Data.IsAmended == true)" > (This content was amended in this version of the code.)</span>\n            <span class="label label-primary" data-ng-if="::($root.mccStateParams.product.LandingPageID == 3 && node.Data.IsAmended == true)" aria-hidden="true">amended</span>\n            <span ng-if="::$root.mccStateParams.product.Features.CodeBankCompare && node.Data.CompareStatus == 0" class="visually-hidden"> (This content was newly added in this version of the code.) </span>\n            <span ng-if="::$root.mccStateParams.product.Features.CodeBankCompare && node.Data.CompareStatus == 0" class="label label-success" aria-hidden="true">new</span>\n            <span ng-if="::$root.mccStateParams.product.Features.CodeBankCompare && node.Data.CompareStatus == 2" class="visually-hidden"> (This content was modified in this version of the code.)</span>\n            <span ng-if="::$root.mccStateParams.product.Features.CodeBankCompare && node.Data.CompareStatus == 2" class="label label-primary" aria-hidden="true">modified</span>\n            <span class="visually-hidden" ng-if="node.Data.isMeetingsOrd" > (This ordinance was created from a related meeting.)</span>\n            <span class="label label-primary" ng-if="node.Data.isMeetingsOrd" style="text-transform: lowercase !important; margin-left: 4px; vertical-align: middle;" aria-hidden="true"><i class="fa fa-users"></i> meeting</span>\n        </a>\n            <ul id="children_of_{{::node.Id}}"\n                data-ng-if="node.isExpanded && node.Children.length" \n                class="nav nav-pills nav-stacked gen-toc-nav"\n                style="margin-left:20px;">\n                <li id="genToc_{{::node.Id}}" data-ng-repeat="node in node.Children track by node.Id" data-ng-include="\'mccGenTocNodeTemplate\'" data-ng-class="{\'active\': toc.isActive(node)}" depth="{{::node.NodeDepth}}"></li>\n            </ul>\n    <\/script>\n</div>'),e.put("/library/ng-apps/library_desktop/common/components/default_left_menu.cshtml",'<nav>\n    <ul id="main-menu" class="gui-controls">\n        <li>\n            <button id="nav-toggle" aria-expanded="false" type="button" class="button-unstyled menu-button" data-toggle="menubar" style="border-bottom: 1px solid #ccc;" aria-label="Toggle navigation menu">\n                <div class="gui-icon">\n                    <span class="menubar-toggle-icon fa fa-fw fa-caret-right"></span>\n                </div>\n            </button>\n        </li>\n\n        <li class="gui-folder">\n            <button aria-label="Municode Library and other links"\n                    aria-expanded="false"\n                    type="button"\n                    class="button-unstyled menu-button"\n                    data-bootstrap-tooltip=""\n                    data-trigger="hover"\n                    data-placement="right"\n                    data-container="body"\n                    title="Municode Library and other links">\n                <div class="gui-icon text-center">\n                    <span class="fa fa-fw fa-ellipsis-h"></span>\n                </div>\n                <span class="title">More</span>\n            </button>\n            <ul>\n                <li>\n                    <a href="#" target="_self">\n                        <span class="title">Municode Library</span>\n                    </a>\n                </li>\n                <li>\n                    <a href="https://secure.municode.com/munistore/productspage.asp" target="_blank">\n                        <span class="title">Order a physical copy</span>\n                    </a>\n                </li>\n                <li>\n                    <a href="{{::$root.app.submitFeedbackUrl}}" target="_blank">\n                        <span class="title">Submit Feedback</span>\n                    </a>\n                </li>\n                <li>\n                    <a href="https://www.civicplus.com/terms-of-service" target="_blank">\n                        <span class="title">Terms of use</span>\n                    </a>\n                </li>\n                <li>\n                    <a href="https://www.civicplus.com/codification-software-services/" target="_blank">\n                        <span class="title">Powered by CivicPlus</span>\n                    </a>\n                </li>\n            </ul>\n        </li>\n\n        \n    </ul>\n</nav>'),e.put("/library/ng-apps/library_desktop/common/components/expandable_toc.cshtml",' <div role="status">\n     <div ng-if="!expToc.rootNode" style="text-align: center;">\n         <span class="visually-hidden">Loading, please wait</span>\n         <img src="dist/img/ajax-loader.gif" alt="loading indicator" aria-hidden="true"/>\n     </div>\n     <span ng-if="expToc.rootNode" class="visually-hidden">Loading complete</span>\n </div>\n<section class="exp-toc" aria-label="{{::ariaLabel}}">\n    <div data-ng-if="expToc.rootNode">\n        <div data-ng-if="!expToc.includeRootNodeInToc">\n            <h3 ng-show="!expToc.hideRootHeader" tabindex="-1" data-ng-bind="::expToc.rootNode.Heading" data-contextual-name="title"></h3>\n            <ul class="nav nav-pills nav-stacked gen-toc-nav expTocRoot">\n                <li once once-attr-data-nodeid="node.Id" ng-class="{\'disabled\': node.isDisabled}" data-ng-repeat="node in expToc.rootNode.Children track by node.Id" data-ng-include="\'mccExpTocNodeSelectorTemplate1\'">\n                </li>\n            </ul>\n        </div>\n        <div data-ng-if="expToc.includeRootNodeInToc" once once-attr-data-nodeid="expToc.rootNode.Id">\n            <button data-ng-if="::expToc.rootNode.Children.length" class="expToc-expander btn btn-link" style="padding-left: 0px;" aria-expanded="{{!!expToc.rootNode.showChildren}}" aria-controls="child-nodes-{{::expToc.rootNode.Id}}">\n                <i data-ng-class="expToc.rootNode.showChildren ? \'fa fa-minus\' : \'fa fa-plus\'"></i>\n                <span class="visually-hidden">{{!!expToc.rootNode.showChildren ? "Collapse" : "Expand"}} {{::expToc.rootNode.Heading}}</span>\n            </button>\n            <button class="expToc-selector button-unstyled" role="checkbox" aria-checked="{{!!expToc.rootNode.isSelected}}">\n                <i data-ng-class="expToc.rootNode.isSelected ? \'fa fa-check-square-o\' : \'fa fa-square-o\'"></i>\n                <span data-ng-bind="::expToc.rootNode.Heading"></span>\n                <span class="label label-primary" data-ng-if="::($root.mccStateParams.product.LandingPageID == 3 && expToc.rootNode.Data.isAmended == true)">Amended</span>\n                <span class="label label-primary" data-ng-if="::expToc.rootNode.Data.isUpdated == true">Updated</span>\n            </button>\n            <button class="btn btn-flat btn-link btn-link-inline"\n                    style="display: inline-block;"\n                    data-ng-if="(expToc.rootNode.Children.length) && (expToc.mode === \'manual-selector\')"\n                    data-ng-class="{\'text-primary\': true, \'expToc-select-all\': ((getSelectedChildNodes(expToc.rootNode) || []).length < expToc.rootNode.Children.length), \'expToc-reset-select\': ((getSelectedChildNodes(expToc.rootNode) || []).length == expToc.rootNode.Children.length) }"\n                    aria-label="{{((getSelectedChildNodes(expToc.rootNode) || []).length < expToc.rootNode.Children.length) ? \'SELECT ALL\' : \'RESET\'}} {{::expToc.rootNode.Heading}} content and all descendents content">\n                {{((getSelectedChildNodes(expToc.rootNode) || []).length < expToc.rootNode.Children.length) ? \'SELECT ALL\' : \'RESET\'}}\n            </button>\n            <ul id="child-nodes-{{::expToc.rootNode.Id}}" data-ng-if="expToc.rootNode.showChildren" style="" class="nav nav-pills nav-stacked gen-toc-nav">\n                <li once once-attr-data-nodeid="node.Id" data-ng-repeat="node in expToc.rootNode.Children track by node.Id" data-ng-include="\'mccExpTocNodeSelectorTemplate1\'">\n                </li>\n            </ul>\n        </div>\n        <script type="text/ng-template" id="mccExpTocNodeSelectorTemplate1">\n            <button data-ng-if="::node.Children.length" class="expToc-expander btn btn-link" style="float:left; width:42px;" aria-expanded="{{!!node.showChildren}}" aria-controls="child-nodes-{{::node.Id}}">\n                <i data-ng-class="node.showChildren ? \'fa fa-minus\' : \'fa fa-plus\'"></i>\n                <span class="visually-hidden">{{!!node.showChildren ? "Collapse" : "Expand"}} {{::node.Heading}}</span>\n            </button>\n            <button ng-style="{ \'margin-left\': !node.Children.length ? \'42px\' : \'0px\', \'display\': node.Children.length ? \'inline-block\' : \'block\'}" class="expToc-selector button-unstyled" role="checkbox" aria-checked="{{!!node.isSelected}}" mcc-aria-disabled="node.isDisabled">\n                <i data-ng-class="node.isSelected ? \'fa fa-check-square-o\' : \'fa fa-square-o\'"></i>\n                <span data-ng-bind="::node.Heading"></span>\n                <span class="label label-primary" data-ng-if="::($root.mccStateParams.product.LandingPageID == 3 && node.Data.isAmended == true)">Amended</span>\n                <span class="label label-primary" data-ng-if="::node.Data.isUpdated == true">Updated</span>\n            </button>\n            <button class="btn btn-flat btn-link btn-link-inline"\n                style="display: inline-block; padding: 0px;"\n                data-ng-if="(node.Children.length) && (expToc.mode === \'manual-selector\')"\n                data-ng-class="{\'text-primary\': true, \'expToc-select-all\': ((getSelectedChildNodes(node) || []).length < node.Children.length), \'expToc-reset-select\': ((getSelectedChildNodes(node) || []).length == node.Children.length) }"\n                aria-label="{{((getSelectedChildNodes(node) || []).length < node.Children.length)  ? \'SELECT ALL\' : \'RESET\'}} {{::node.Heading}} content and all descendents content">\n                {{((getSelectedChildNodes(node) || []).length < node.Children.length) ? \'SELECT ALL\' : \'RESET\'}}\n            </button>\n            <ul id="child-nodes-{{::node.Id}}" data-ng-if="node.showChildren" style="margin-left:20px;" class="nav nav-pills nav-stacked gen-toc-nav">\n                <li once once-attr-data-nodeid="node.Id" data-ng-repeat="node in node.Children track by node.Id" data-ng-include="\'mccExpTocNodeSelectorTemplate1\'">\n                </li>\n            </ul>\n        <\/script>\n    </div>\n</section>'),e.put("/library/ng-apps/library_desktop/common/components/share_link.cshtml",'<style>\n    mcc-share-link{\n        display:block;\n    }\n</style>\n\n<p class="lead">Copy the link in the text box below.</p>\n<div class="alert alert-info">\n    <strong>Tip:</strong> Click the text box and hit <kbd>ctrl + c</kbd> to copy the link to your clipboard.\n</div>\n<div class="alert alert-info"><strong>Mobile users:</strong> You can also use your browser\'s built-in Share feature to share a link to this page. Every link on our site is shareable.</div>\n\n<div style="margin-bottom: 10px;" class="well well-sm">\n    \n    <form class="form">\n        <textarea id="linkUrl" class="form-control" rows="3" onclick="this.focus();this.select()" data-ng-model="link.url" style="font-size: 14px;"></textarea>\n        <label for="linkUrl">Link for sharing</label>\n        <div class="checkbox text-right" data-ng-show="$root.$location.search().searchRequest">\n            <label>\n                <input class="" type="checkbox" data-ng-model="link.includeSearchRequest" data-ng-change="link.setUrl()"> Include search\n            </label>\n        </div>\n    </form>\n</div>\n\n<p class="lead">Some things you can do with the link:</p>\n<ol>\n    <li><mark>Share</mark> with others using Email, Facebook, Twitter, Chat, etc</li>\n    <li>Add to your <mark>browser favorites</mark> for quick access to this content later</li>\n</ol>'),e.put("/library/ng-apps/library_desktop/common/components/column_list/column_list.cshtml",'\n<style>\n    .mcccolumns {\n        overflow: hidden;\n        margin: 0 0 0 -33px;\n    }\n\n        .mcccolumns .col {\n            float: left;\n            width: 185px;\n            margin: 0 0 0 50px;\n        }\n\n            .mcccolumns .col h2 {\n                margin-bottom: 0px;\n            }\n\n        .mcccolumns ul {\n            padding: 0 0 0 5px;\n            margin: 0 0 49px;\n            list-style: none;\n        }\n\n        .mcccolumns a {\n            color: #333333;\n            text-decoration: none;\n        }\n\n            .mcccolumns a:hover {\n                text-decoration: underline;\n            }\n</style>\n\n<div ng-repeat="column in columnsOfHeadingsOfData" id="column {{$index}}" class="col"\n     ng-style="{{ {width: (parentWidth/numOfColumns) -50 + \'px\'} }}">\n    <div ng-repeat="headingGroup in column">\n        <h2>\n            {{columnHeadingFunction(headingGroup[0])}}\n        </h2>\n        <ul>\n            <li ng-repeat="item in headingGroup"><a data-ng-href="{{linkHref(item)}}" href="" ng-click="linkClickExpression(item)">{{linkTextExpression(item)}}</a></li>\n        </ul>\n\n    </div>\n\n\n</div>\n'),e.put("/library/ng-apps/library_desktop/common/components/content_collection_search/content_collection_search.cshtml",'\n\n<div id="contentCollectionSearchBox"\n     class=""\n     style="display:inline-block;\n           padding: 5px 0;\n           padding-left: 6px;\n           padding:0px;\n           margin: 2px 0 0;\n           margin-top: 36px;\n           list-style: none;\n           position:relative;\n           /*background-color: #333333;*/\n           border: 1px solid #ccc;\n           border: 1px solid rgba(0, 0, 0, 0.2);\n           *border-right-width: 2px;\n           *border-bottom-width: 2px;\n           -webkit-border-radius: 6px;\n              -moz-border-radius: 6px;\n                   border-radius: 6px;\n           -webkit-box-shadow: 0 5px 10px rgba(0, 0, 0, 0.2);\n              -moz-box-shadow: 0 5px 10px rgba(0, 0, 0, 0.2);\n                   box-shadow: 0 5px 10px rgba(0, 0, 0, 0.2);\n           -webkit-background-clip: padding-box;\n              -moz-background-clip: padding;\n                   background-clip: padding-box;\n    ">\n    <input type="text" class="span4" ng-model="searchText" placeholder=" Search by Keyword..."\n           style="margin-bottom:0px;\n               border:none;\n               height:29px;\n               top:2px;\n               width:150px;\n               left:0px;\n               position:relative;\n               z-index:1000;\n               border-bottom-right-radius:0px;\n               -moz-border-bottom-right-radius:0px;\n               -webkit-border-bottom-right-radius:0px;\n                border-top-right-radius:0px;\n               -moz-border-top-right-radius:0px;\n               -webkit-border-top-right-radius:0px;\n               -webkit-border-bottom-left-radius: 6px;\n               -moz-border-bottom-left-radius: 6px;\n                border-bottom-left-radius: 6px;\n               " /><button class="btn ladda-button"\n                           data-style="slide-left"\n                           style="position:relative;\n                z-index:1000;\n                border-bottom-left-radius:0px;\n               -moz-border-bottom-left-radius:0px;\n               -webkit-border-bottom-left-radius:0px;\n                border-top-left-radius:0px;\n               -moz-border-top-left-radius:0px;\n               -webkit-border-top-left-radius:0px;\n               ">\n        <span class="ladda-label"><i class="fa fa-search"></i></span>\n    </button>\n    <div ng-show="searchText.length > 0 " style="position:absolute;top:30px;">\n        <div ng-style="resultsLeft"\n             style="background-color:#eeeeEe;\n                    padding-top:22px;\n                    list-style-type:none;\n                    top:-12px;\n                    background-color:RGBA(238,238,238,.9);position:relative;\n                    z-index:999;\n                    width:650px;\n                    border: 1px solid #ccc;\n                    border: 1px solid rgba(0, 0, 0, 0.2);\n                    *border-right-width: 2px;\n                    *border-bottom-width: 2px;\n                    -webkit-border-radius: 6px;\n                       -moz-border-radius: 6px;\n                            border-radius: 6px;\n                    -webkit-box-shadow: 0 5px 10px rgba(0, 0, 0, 0.2);\n                       -moz-box-shadow: 0 5px 10px rgba(0, 0, 0, 0.2);\n                            box-shadow: 0 5px 10px rgba(0, 0, 0, 0.2);\n                    -webkit-background-clip: padding-box;\n                       -moz-background-clip: padding;\n                            background-clip: padding-box;">\n            <span ng-hide="searchText.trim().length > 1">Search results will  appear here once more than two characters have been typed.</span>\n            <span ng-show="searchResults.$resolved == true && searchResults.length == 0 && searchText.trim().length > 1 ">No results found that match your search Keyword<span ng-show="searchText.trim().split(\' \').length > 1">s</span></span>\n            <ul style="list-style-type:none; text-align:left; padding-left:30%">\n                <li ng-repeat="result in searchResults">\n                    <a href="" ng-click="transitionTo(\'client.Home.Content\', {stateAbbr: result.State.StateAbbreviation , clientName:result.ClientName })">{{result.ClientName}}, {{result.State.StateAbbreviation}}</a>\n                </li>\n            </ul>\n        </div>\n    </div>\n</div>'),e.put("/library/ng-apps/library_desktop/common/components/state_map/state_map.cshtml",'<div class="notranslate" id="stateMap" style="height:615px; overflow:hidden; text-align:center" aria-hidden="true">\n    <ul class="stately" id="stateMapList" style="width:687px; height:615px; font-size:667px; border:none; background-color:inherit;">\n        <li data-state="al" class="al">A</li>\n        <li data-state="ak" class="ak">B</li>\n        <li data-state="ar" class="ar">C</li>\n        <li data-state="az" class="az">D</li>\n        <li data-state="ca" class="ca">E</li>\n        <li data-state="co" class="co">F</li>\n        <li data-state="ct" class="ct">G</li>\n        <li data-state="de" class="de">H</li>\n        <li data-state="fl" class="fl">J</li>\n        <li data-state="ga" class="ga">K</li>\n        <li data-state="hi" class="hi">L</li>\n        <li data-state="id" class="id">M</li>\n        <li data-state="il" class="il">N</li>\n        <li data-state="in" class="in">O</li>\n        <li data-state="ia" class="ia">P</li>\n        <li data-state="ks" class="ks">Q</li>\n        <li data-state="ky" class="ky">R</li>\n        <li data-state="la" class="la">S</li>\n        <li data-state="me" class="me">T</li>\n        <li data-state="md" class="md">U</li>\n        <li data-state="ma" class="ma">V</li>\n        <li data-state="mi" class="mi">W</li>\n        <li data-state="mn" class="mn">X</li>\n        <li data-state="ms" class="ms">Y</li>\n        <li data-state="mo" class="mo">Z</li>\n        <li data-state="mt" class="mt">a</li>\n        <li data-state="ne" class="ne">b</li>\n        <li data-state="nv" class="nv">c</li>\n        <li data-state="nh" class="nh">d</li>\n        <li data-state="nj" class="nj">e</li>\n        <li data-state="nm" class="nm">f</li>\n        <li data-state="ny" class="ny">g</li>\n        <li data-state="nc" class="nc">h</li>\n        <li data-state="nd" class="nd">i</li>\n        <li data-state="oh" class="oh">j</li>\n        <li data-state="ok" class="ok">k</li>\n        <li data-state="or" class="or">l</li>\n        <li data-state="pa" class="pa">m</li>\n        <li data-state="ri" class="ri">n</li>\n        <li data-state="sc" class="sc">o</li>\n        <li data-state="sd" class="sd">p</li>\n        <li data-state="tn" class="tn">q</li>\n        <li data-state="tx" class="tx">r</li>\n        <li data-state="ut" class="ut">s</li>\n        <li data-state="va" class="va">t</li>\n        <li data-state="vt" class="vt">u</li>\n        <li data-state="wa" class="wa">v</li>\n        <li data-state="wv" class="wv">w</li>\n        <li data-state="wi" class="wi">x</li>\n        <li data-state="wy" class="wy">y</li>\n\n    </ul>\n\n\n    <div class="" style="width:658px; height:615px; position:relative; top:-592px; display: inline-block">\n        <img class="state-map" src="dist/img/transparent.png" style="height:583px;width:650px;position:relative;" usemap="#stateMapImageMap" alt="Map of The United States of America"/>\n        <map name="stateMapImageMap" id="stateMapImageMap" style="width:650px; height:615px;">\n            <area tabindex="-1"\n                  class="stately-area"\n                  ng-repeat="(key, state) in stateCoords"\n                  title="{{state.fullName}}"\n                  alt="{{state.fullName}}"\n                  shape="poly"\n                  ng-href="{{::getAnchorHref(state.abbreviation)}}"\n                  ng-click="onStateClick($event, state.abbreviation)"\n                  ng-blur="unhighlight(state.abbreviation)"\n                  ng-focus="highlight(state.abbreviation)"\n                  ng-mouseover="highlight(state.abbreviation)"\n                  ng-mouseout="unhighlight(state.abbreviation)"\n                  coords="{{state.coords}}">\n        </map>\n    </div>\n\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n')}]);
