{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":160,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">1.01.030 - Utility, street and railroad ordinances.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1.01COAD_1.01.030UTSTRAOR","Title":"1.01.030 - Utility, street and railroad ordinances.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               No ordinance relating to railroads or railroad crossings with streets and other public\n               ways, or relating to the conduct, duties, service or rates of public utilities, shall\n               be repealed by virtue of Section <a href=\"\" data-chunk-id=\"TIT1GEPR_CH1.01COAD_1.01.020REGEOR\" class=\"section-link\" data-product-id=\"14787\">1.01.020</a>, excepting as this Code may contain provisions for such matters, in which case the\n               provisions of this Code shall be considered as amending such ordinance or ordinances\n               in respect of such provisions only.\n               </p>\n            <p class=\"historynote0\">\n               (Ord. 2233 § 1(part), 1981: prior code § 1-2-2)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1.01COAD_1.01.020REGEOR","Heading":"1.01.020 - Repeal of general ordinances.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01COAD","DocOrderId":159,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1.01COAD_1.01.040OFVIUNFOOR","Heading":"1.01.040 - Offenses or violations under former ordinances.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01COAD","DocOrderId":161,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}