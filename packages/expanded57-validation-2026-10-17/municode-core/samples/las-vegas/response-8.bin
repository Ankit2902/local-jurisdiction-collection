{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":159,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">1.01.020 - Repeal of general ordinances.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1.01COAD_1.01.020REGEOR","Title":"1.01.020 - Repeal of general ordinances.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               All general ordinances of the City passed prior to the adoption of this Code are hereby\n               repealed, except such as are referred to herein as being still in force or are by\n               necessary implication herein reserved from repeal subject to the saving clauses contained\n               in the following Sections of this Chapter. Excluded from such repeal are the following\n               ordinances: tax levy ordinances, appropriation ordinances, ordinances relating to\n               boundaries and annexations, franchise ordinances and other ordinances granting special\n               rights to persons or corporations, contract ordinances and ordinances authorizing\n               the execution of a contract or the issuance of warrants, salary ordinances, ordinances\n               establishing, naming or vacating streets, alleys or other public places, special improvement\n               district ordinances, bond ordinances, ordinances relating to elections, ordinances\n               relating to the transfer or acceptance of real estate by or from the City, and all\n               special ordinances.\n               </p>\n            <p class=\"historynote0\">\n               (Ord. 2233 § 1(part), 1981: prior code § 1-2-1)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1.01COAD_1.01.010COADEFGE","Heading":"1.01.010 - Code adoption—Reference generally.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01COAD","DocOrderId":158,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1.01COAD_1.01.030UTSTRAOR","Heading":"1.01.030 - Utility, street and railroad ordinances.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01COAD","DocOrderId":160,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}