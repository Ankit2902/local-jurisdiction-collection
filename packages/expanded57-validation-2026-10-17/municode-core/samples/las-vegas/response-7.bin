{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":158,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">1.01.010 - Code adoption—Reference generally.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1.01COAD_1.01.010COADEFGE","Title":"1.01.010 - Code adoption—Reference generally.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               This compilation and codification of the general ordinances of the City of Las Vegas\n               is hereby declared to be and shall hereafter constitute the official Municipal Code\n               of the City of Las Vegas. Any reference to the number of any section contained herein\n               shall be understood to refer to the position of the same under its appropriate Title\n               heading, its chapter heading and its section heading and to the general penalty clause\n               relating thereto, as well as to the section itself, when reference is made to this\n               Code by title in any legal document.\n               </p>\n            <p class=\"historynote0\">\n               (Ord. 2232 § 1, 1981)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1.01COAD","Heading":"CHAPTER 1.01 - CODE ADOPTION","NodeDepth":2,"HasChildren":true,"ParentId":"TIT1GEPR","DocOrderId":157,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1.01COAD_1.01.020REGEOR","Heading":"1.01.020 - Repeal of general ordinances.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01COAD","DocOrderId":159,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}