{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":183,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COOR_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1. - How Code designated and cited.</div>","ShouldShowMiniToc":false,"Id":"COOR_CH1GEPR_S1-1HOCODECI","Title":"Sec. 1-1. - How Code designated and cited.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The ordinances embraced in the following chapters and sections shall constitute and\n               be designated the \"Code of Ordinances, City of Houston, Texas,\" and may be so cited.\n               </p>\n            <p class=\"p0\">\n               The <span class=\"ital\">Construction Code,</span> including the <span class=\"ital\">Fire Code,</span> constitutes a part of this Code and is adopted herein by reference. The <span class=\"ital\">Construction Code</span> is published by separate promulgation and is not set forth in this two-volume edition\n               of the Code. Interested persons may contact the city secretary for purchase information.\n               </p>\n            <p class=\"historynote0\">\n               (Code 1968, § 1-1; Ord. No. 2011-1168, § 3, 12-14-2011; Ord. No. <a class=\"ordinance-link\" href=\"\" data-product-id=\"10123\" data-ordinance-id=\"1127023\">2021-1037</a>, § 20(Exh. I.1, 12-1-2021, eff. 4-1-2022)\n               </p>\n            <p class=\"refcharter0\" block_type=\"hang\"><b>Charter reference— </b>\n               Printed ordinances as evidence, Art. IX, § 7; force and effect of Codes of Ordinances\n               and admission thereof into evidence, Art. IX, § 13.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"COOR_CH1GEPR","Heading":"Chapter 1 - GENERAL PROVISIONS","NodeDepth":1,"HasChildren":true,"ParentId":"10123","DocOrderId":182,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"COOR_CH1GEPR_S1-2RUCODE","Heading":"Sec. 1-2. - Rules of construction and definitions.","NodeDepth":2,"HasChildren":false,"ParentId":"COOR_CH1GEPR","DocOrderId":184,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}