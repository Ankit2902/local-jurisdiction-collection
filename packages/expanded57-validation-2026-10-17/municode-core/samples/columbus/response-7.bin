{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":344,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1ADCO_CH101CICO","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">101.01 - Designation—How cited.</div>","ShouldShowMiniToc":false,"Id":"TIT1ADCO_CH101CICO_101.01DEOWCI","Title":"101.01 - Designation—How cited.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               As set forth in the Adopting Ordinance, the provisions contained in this and the following\n               chapters shall constitute the Columbus City Codes, 1959.\n               </p>\n            <p class=\"p0\">\n               The Columbus City Codes, 1959, may be referred to as the \"city codes\"; any component\n               code of the city codes may be referred to by its name, such as the \"Traffic Code\";\n               and sections of the city codes may be cited by the designation \"C.C.\" followed by\n               the number, such as \"C.C. 101.01.\" Title, article, chapter, and section headings do\n               not constitute any part of the law as contained in the Columbus City Codes.\n               </p>\n            <p class=\"historynote0\">\n               (Ord. 877-72.)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1ADCO_CH101CICO","Heading":"Chapter 101 - CITY CODES","NodeDepth":2,"HasChildren":true,"ParentId":"TIT1ADCO","DocOrderId":343,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1ADCO_CH101CICO_101.02AMSU","Heading":"101.02 - Amendments and supplements.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1ADCO_CH101CICO","DocOrderId":345,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}