{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":345,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1ADCO_CH101CICO","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">101.02 - Amendments and supplements.</div>","ShouldShowMiniToc":false,"Id":"TIT1ADCO_CH101CICO_101.02AMSU","Title":"101.02 - Amendments and supplements.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The Columbus City Codes, 1959, may be amended or supplemented at any time and, when\n               any amendment or supplement is adopted in such form as to indicate the intention of\n               council to make the same a part thereof, such amendment or supplement shall be incorporated\n               in, and deemed a part of, the city codes, so that a reference to the city codes shall\n               be understood and construed as including the Columbus City Codes, 1959, and any and\n               all such amendments and supplements.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1ADCO_CH101CICO_101.01DEOWCI","Heading":"101.01 - Designation—How cited.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1ADCO_CH101CICO","DocOrderId":344,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1ADCO_CH101CICO_101.03IN","Heading":"101.03 - Interpretation.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1ADCO_CH101CICO","DocOrderId":346,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}