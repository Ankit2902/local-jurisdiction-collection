{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":1006,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PAIVCOCH1--20_CH1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1-2. - Definitions; rules of construction.</div>","ShouldShowMiniToc":false,"Id":"PAIVCOCH1--20_CH1GEPR_S1-1-2DERUCO","Title":"Sec. 1-1-2. - Definitions; rules of construction.","Content":"<div class=\"chunk-content\">\n            <p class=\"incr0\">\n               (a)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               For the purposes of this Code, the following words and phrases shall have the meanings\n               respectively ascribed to them by this section unless otherwise defined within the\n               text of the provision:\n               </p>\n            \t\t\n            <p class=\"p0\">\n               <span class=\"ital\">Blight violation</span> means any unlawful act, or any omission or failure to act, which is designated by\n               this Code as a blight violation pursuant to Section 41(2) of the Michigan Home Rule\n               City Act, being MCL 117.41(2).\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Charter</span> means, unless referred to as the 1918, 1974, or 1997 Charters, the 2012 Charter of\n               the City of Detroit, which was adopted by the People of the City of Detroit on November\n               8, 2011, and became effective on January 1, 2012, and shall include any amendment\n               to such Charter.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">City</span> means the City of Detroit, Michigan.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">City Council</span> or <span class=\"ital\">Council</span> means the legislative body of the City as provided for by the Charter.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Civil infraction</span> means an act or omission that is prohibited by this Code, which is not a crime as\n               defined in Section 5 of the Michigan Penal Code, being MCL 750.5, and for which civil\n               sanctions may be ordered.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Code</span> means, unless referred to as the 1954, 1964 or 1984 Detroit City Codes, the \"2019\n               Detroit City Code.\"\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">County</span> means the County of Wayne, Michigan.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Criminal offense</span> means a felony or misdemeanor as set forth in federal or state law or this Code,\n               but does not mean a blight violation or civil infraction.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Land</span> or <span class=\"ital\">real estate</span> means real property and all of the rights and interests thereto.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Loop</span> or <span class=\"ital\">loop district</span> means that section of the City bounded on the south by the south line of East Jefferson\n               Avenue and West Jefferson Avenue; on the east by the east line of St. Antoine Street;\n               on the north by the north line of Columbia Street; and on the west by the west line\n               of First Street.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Mayor</span> means the chief executive of the City as provided for by the Charter.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">MCL</span> means the Michigan Compiled Laws.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Month</span> means a calendar month.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">One-Mile Circle</span> means that area bounded by Vernor Highway on the north, the Chrysler Freeway on the\n               east, the Detroit River on the south, and the John C. Lodge Freeway on the west.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Owner</span> means, when applied to a building or land, or real estate, any part owner, joint\n               owner, tenant in common, tenant in partnership, joint tenant or tenant by the entirety\n               of the whole or of a part of such building or land.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Person</span> means an individual, association, firm, partnership, political body, and corporate\n               body, or other legal entity.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Signature</span> or <span class=\"ital\">subscription</span> means a person's name written by that person or, when the person cannot write, an\n               identifying mark made by the person.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">State</span> means the State of Michigan.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Street</span> means avenues, boulevards, roads, alleys, lanes, viaducts, and all other public highways\n               and thoroughfares in the City.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Tenant</span> or <span class=\"ital\">occupant</span> means a person who has a written or oral lease of, or who occupies, the whole or\n               a part of a building or land, either alone or with others.\n               </p>\n            <p class=\"incr0\">\n               (b)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               In the construction of this Code, the following rules of construction shall apply,\n               unless such construction would be inconsistent with the manifest intent of the Charter\n               or this Code:\n               </p>\n            \t\t\n            <p class=\"p0\">\n               <span class=\"ital\">Agency.</span> Any mention of any City, state, or federal agency shall include any successor agency.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Computation of time.</span> Unless otherwise specifically provided, the time within which an act is required\n               by this Code to be done shall be computed by excluding the first day and including\n               the last day. If the last day on which the time period runs is a Saturday, Sunday\n               or legal holiday, the time period runs until the next day that is not a Saturday,\n               Sunday, or legal holiday.\n               \n               <p class=\"refmanual0\" block_type=\"hang\">\n                  <span class=\"bold\">Case law annotation—</span>This code of construction constitutes an effective waiver of strict compliance with\n                  a statute requiring notice of damage claims against the City within a certain time.\n                  <span class=\"ital\">Murphy</span> v <span class=\"ital\">Detroit,</span> 2 Mich App 473; 140 NW2d 565 (1966). (This case construed similar language in this\n                  section contained in the 1964 Code).\n                  </p>\n               \n            <p class=\"p0\">\n               <span class=\"ital\">Gender.</span> The terms of one gender shall include the other gender as well as the neuter gender.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Generally.</span> When provisions conflict, the specific shall prevail over the general. All provisions\n               shall be liberally construed so that the intent of the City Council may be effectuated.\n               Terms and phrases shall be construed according to the common and approved usage of\n               the language, but technical terms, technical phrases, and terms and phrases that have\n               acquired peculiar and appropriate meanings in law shall be construed according to\n               such meanings.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Oath</span> shall be construed to include the term \"affirmation\" in all cases where, by this\n               Code or practice, an affirmation may be substituted for an oath.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Office, department, commission, or other City agency.</span> Whenever any office, department, commission or other City agency is referred to by\n               title only, such reference shall be construed as if followed by the words \"of the\n               City of Detroit, Michigan.\"\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Officer.</span> Whenever, by the provisions of this Code, any officer of the City is assigned any\n               duty or empowered to perform any act or duty, reference to such officer shall mean\n               and include such officer or such officer's deputy or authorized subordinate.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Plural</span> includes the singular.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Public act.</span> Any reference to a public act, whether by act number or by short title, is a reference\n               to the act as amended, or any successor statute.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Singular</span> includes the plural.\n               </p>\n            <p class=\"p0\">\n               <span class=\"ital\">Sworn</span> includes the term \"affirmed\" in all cases where, by this Code or practice, an affirmation\n               may be substituted for a swearing.\n               </p>\n            <p class=\"historynote0\">\n               (Code 1964, § 1-1-2; Code 1984, § 1-1-2; Ord. No. 20-97, § 1(1-1-2), eff. 7-25-1997)\n               </p>\n            <p class=\"refstatelaw0\" block_type=\"hang\"><b>State Law reference— </b>\n               Statutory rules of construction, MCL 8.3 <span class=\"ital\">et seq.</span>\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PAIVCOCH1--20_CH1GEPR_S1-1-1DECICOORENUNCO","Heading":"Sec. 1-1-1. - Designation and citation of the City Code and ordinances enacted under this Code.","NodeDepth":3,"HasChildren":false,"ParentId":"PAIVCOCH1--20_CH1GEPR","DocOrderId":1005,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PAIVCOCH1--20_CH1GEPR_S1-1-3HECAHINORE","Heading":"Sec. 1-1-3. - Headings, catchlines, history notes and references.","NodeDepth":3,"HasChildren":false,"ParentId":"PAIVCOCH1--20_CH1GEPR","DocOrderId":1007,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}