{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":1005,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PAIVCOCH1--20_CH1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1-1. - Designation and citation of the City Code and ordinances enacted under this Code.</div>","ShouldShowMiniToc":false,"Id":"PAIVCOCH1--20_CH1GEPR_S1-1-1DECICOORENUNCO","Title":"Sec. 1-1-1. - Designation and citation of the City Code and ordinances enacted under this Code.","Content":"<div class=\"chunk-content\">\n            <p class=\"incr0\">\n               (a)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               This Code shall be designated and cited as the \"2019 Detroit City Code.\"\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (b)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               After an ordinance is passed by the City Council in accordance with <a href=\"\" data-chunk-id=\"PTI2012DECH1963MICOMIHORUAC_SPA2012DECH_ART4THLEBR_CH1CICO_S4-108VO\" class=\"section-link\" data-product-id=\"10649\">Section 4-108</a> of the Charter and approved by the Mayor in accordance with <a href=\"\" data-chunk-id=\"PTI2012DECH1963MICOMIHORUAC_SPA2012DECH_ART4THLEBR_CH1CICO_S4-117PRAPVEMACOOVVE\" class=\"section-link\" data-product-id=\"10649\">Section 4-117</a> of the Charter, the City Clerk shall provide a numerical designation of the ordinance\n               for use in the Notice of Enactment for publication of the ordinance in accordance\n               with <a href=\"\" data-chunk-id=\"PTI2012DECH1963MICOMIHORUAC_SPA2012DECH_ART4THLEBR_CH1CICO_S4-118PUOREFDA\" class=\"section-link\" data-product-id=\"10649\">Section 4-118</a> of the Charter and in the printing of the ordinance in a loose-leaf format. After\n               enactment of the ordinance to adopt this Code, the numerical designation shall contain\n               the year and the number of the ordinance as enacted in chronological order during\n               each calendar year. As examples, the 35th ordinance enacted during Calendar Year 2019\n               shall be designated and cited as \"Ord. No. 2019-35,\" the first ordinance enacted during\n               Calendar Year 2020 shall be designated and cited as \"Ord. No. 2020-1,\" and the ninth\n               ordinance enacted during Calendar Year 2021 shall be designated and cited as \"Ord.\n               No. 2021-9.\"\n               </p>\n            \t\t\n            <p class=\"historynote0\">\n               (Code 1964, § 1-1-1; Code 1984, § 1-1-1; Ord. No. 20-97, § 1(1-1-1), eff. 7-25-1997)\n               </p>\n            <p class=\"refcharter0\" block_type=\"hang\"><b>Charter reference— </b>\n               Mandate for codification, <a href=\"\" data-chunk-id=\"PTI2012DECH1963MICOMIHORUAC_SPA2012DECH_ART4THLEBR_CH1CICO_S4-119ORAFENREAFAD\" class=\"section-link\" data-product-id=\"10649\">§ 4-119</a>.\n               </p>\n            <p class=\"refstatelaw0\" block_type=\"hang\"><b>State Law reference— </b>\n               Authority to codify, MCL 117.5b.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PAIVCOCH1--20_CH1GEPR","Heading":"Chapter 1 - GENERAL PROVISIONS","NodeDepth":2,"HasChildren":true,"ParentId":"PAIVCOCH1--20","DocOrderId":1004,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PAIVCOCH1--20_CH1GEPR_S1-1-2DERUCO","Heading":"Sec. 1-1-2. - Definitions; rules of construction.","NodeDepth":3,"HasChildren":false,"ParentId":"PAIVCOCH1--20_CH1GEPR","DocOrderId":1006,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}