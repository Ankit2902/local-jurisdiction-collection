{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":1007,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PAIVCOCH1--20_CH1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1-3. - Headings, catchlines, history notes and references.</div>","ShouldShowMiniToc":false,"Id":"PAIVCOCH1--20_CH1GEPR_S1-1-3HECAHINORE","Title":"Sec. 1-1-3. - Headings, catchlines, history notes and references.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The chapter, article, and division headings, the section catchlines and history notes,\n               and all references and notes that are contained within this Code shall be of no legal\n               import and are provided only to assist in the usage of this Code.\n               </p>\n            <p class=\"historynote0\">\n               (Code 1964, § 1-1-3; Code 1984, § 1-1-3; Ord. No. 20-97, § 1(1-1-3), eff. 7-25-1997)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PAIVCOCH1--20_CH1GEPR_S1-1-2DERUCO","Heading":"Sec. 1-1-2. - Definitions; rules of construction.","NodeDepth":3,"HasChildren":false,"ParentId":"PAIVCOCH1--20_CH1GEPR","DocOrderId":1006,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PAIVCOCH1--20_CH1GEPR_S1-1-4PRCOCOEXOR","Heading":"Sec. 1-1-4. - Provisions considered as continuation of existing ordinances.","NodeDepth":3,"HasChildren":false,"ParentId":"PAIVCOCH1--20_CH1GEPR","DocOrderId":1008,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}