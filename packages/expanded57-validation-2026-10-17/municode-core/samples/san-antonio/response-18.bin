{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":184,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PTIICO_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1. - How Code designated and cited.</div>","ShouldShowMiniToc":false,"Id":"PTIICO_CH1GEPR_S1-1HOCODECI","Title":"Sec. 1-1. - How Code designated and cited.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The ordinances embraced in this and the following chapters shall constitute and be\n               designated \"City Code of San Antonio, Texas\" and may be so cited.\n               </p>\n            <p class=\"historynote0\">\n               (Code 1959, § 1-1)\n               </p>\n            <p class=\"refcharter0\" block_type=\"hang\"><b>Charter reference— </b>\n               Authority to codify ordinances, <a href=\"\" data-chunk-id=\"PTICH_ARTIICICO_S17SAUBOR\" class=\"section-link\" data-product-id=\"11508\">§ 17</a>.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PTIICO_CH1GEPR","Heading":"Chapter 1 - GENERAL PROVISIONS","NodeDepth":1,"HasChildren":true,"ParentId":"11508","DocOrderId":183,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PTIICO_CH1GEPR_S1-2RUCO","Heading":"Sec. 1-2. - Rules of construction.","NodeDepth":2,"HasChildren":false,"ParentId":"PTIICO_CH1GEPR","DocOrderId":185,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}