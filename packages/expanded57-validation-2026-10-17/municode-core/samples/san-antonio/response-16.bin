AL OPTIONS FOR A TOTAL AMOUNT UP TO $3,400,000.00, INCLUSIVE OF RENEWALS.","IsMarkedAsNOW":true,"Tags":[],"WebViewerUrl":null,"AdoptionDate":"2026-09-03T00:00:00","ReceivedDate":"2026-09-17T00:00:00","RecordingDate":"2026-09-30T20:42:25.84","EffectiveDate":null,"PdfText":null,"IsNewOrd":true,"IsPersistent":false,"PDFBlobExists":false,"AmendedSections":[],"Meetings":null,"Include":false,"MeetingName":null,"MeetingUrl":null,"MeetingDate":null,"SortDate":"2026-09-03T00:00:00"}],"PdfUrl":null,"LastOrd":null,"PrevNode":null,"NextNode":null,"ShowToc":false}