{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":6,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TITIORAD_CH101GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 101-2. - Rules of construction.</div>","ShouldShowMiniToc":false,"Id":"TITIORAD_CH101GEPR_S101-2RUCO","Title":"Sec. 101-2. - Rules of construction.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               In the construction of this Revised Code, and of all ordinances, the following rules\n               shall be observed, unless the context clearly indicates otherwise.\n               \n               <p class=\"incr1\">\n                  (1)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">Computation of time.</span> Whenever a notice is required to be given or an act to be done a certain length of\n                  time before any proceeding shall be had, the day on which such notice is given or\n                  such act is done shall be counted in computing the time, but the day on which such\n                  proceeding is to be had shall not be counted.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (2)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">Gender.</span> A word importing the masculine gender only shall extend and be applied to females\n                  and to associations, firms, partnerships and corporations as well as to males.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (3)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">Number.</span> A word importing the singular number only may extend and be applied to several persons\n                  and things as well as to one person and thing.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (4)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">Tense.</span> Words used in the present or past tense include the future as well as the present\n                  and past.\n                  </p>\n               \t\t\n               \n            <p class=\"historynote0\">\n               (G. O. 68, 1988, § 6)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TITIORAD_CH101GEPR_S101-1HOCODECI","Heading":"Sec. 101-1. - How Code designated and cited.","NodeDepth":3,"HasChildren":false,"ParentId":"TITIORAD_CH101GEPR","DocOrderId":5,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TITIORAD_CH101GEPR_S101-3CASE","Heading":"Sec. 101-3. - Catchlines of sections.","NodeDepth":3,"HasChildren":false,"ParentId":"TITIORAD_CH101GEPR","DocOrderId":7,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}