          "ShouldShowMiniToc": false,
          "Id": "TITIORAD_CH101GEPR_S101-3CASE",
          "Title": "Sec. 101-3. - Catchlines of sections.",
          "Content": "<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The catchlines of the several sections of this Revised Code printed in boldface type\n               are intended as mere catchwords to indicate the contents of the sections and shall\n               not be deemed or taken to be the titles of such sections, nor as any part of the sections,\n               nor, unless expressly so provided, shall they be so deemed when any of such sections,\n               including the catchlines, are amended or reenacted.\n               </p>\n            <p class=\"historynote0\">\n               (G. O. 68, 1988, § 6)\n               </p></div>",
          "SortDate": null,
          "Footnotes": null
        }
