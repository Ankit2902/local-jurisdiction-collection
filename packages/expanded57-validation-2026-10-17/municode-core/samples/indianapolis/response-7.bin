{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":5,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TITIORAD_CH101GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 101-1. - How Code designated and cited.</div>","ShouldShowMiniToc":false,"Id":"TITIORAD_CH101GEPR_S101-1HOCODECI","Title":"Sec. 101-1. - How Code designated and cited.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The ordinances embraced in the following chapters and sections shall constitute and\n               be designated the \"Revised Code of the Consolidated City and County,\" and may be so\n               cited.\n               </p>\n            <p class=\"historynote0\">\n               (G. O. 68, 1988, § 6)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TITIORAD_CH101GEPR","Heading":"Chapter 101 - GENERAL PROVISIONS","NodeDepth":2,"HasChildren":true,"ParentId":"TITIORAD","DocOrderId":4,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TITIORAD_CH101GEPR_S101-2RUCO","Heading":"Sec. 101-2. - Rules of construction.","NodeDepth":3,"HasChildren":false,"ParentId":"TITIORAD_CH101GEPR","DocOrderId":6,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}