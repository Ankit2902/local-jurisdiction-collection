{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":399,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TITIGEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 1.101. - How Code designated and cited.</div>","ShouldShowMiniToc":false,"Id":"TITIGEPR_CH1COGEPRAPTH_S1.101HOCODECI","Title":"Sec. 1.101. - How Code designated and cited.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The ordinances embraced in this and the following Titles shall constitute and be designated\n               the \"Ordinance Code of the City of Jacksonville\" and may be so cited. Such ordinances\n               may also be cited as the \"Jacksonville Municipal Code,\" the \"Jacksonville Ordinance\n               Code,\" the \"Ordinance Code\" or the \"Jacksonville, Florida Code.\"\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TITIGEPR_CH1COGEPRAPTH","Heading":"Chapter 1 - CODE AND GENERAL PROVISIONS APPLICABLE THERETO","NodeDepth":2,"HasChildren":true,"ParentId":"TITIGEPR","DocOrderId":398,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TITIGEPR_CH1COGEPRAPTH_S1.102DERUCO","Heading":"Sec. 1.102. - Definitions and rules of construction.","NodeDepth":3,"HasChildren":false,"ParentId":"TITIGEPR_CH1COGEPRAPTH","DocOrderId":400,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}