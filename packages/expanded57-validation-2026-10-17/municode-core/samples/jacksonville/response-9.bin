{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":401,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TITIGEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 1.103. - Catchlines of Sections; history notes; other notes.</div>","ShouldShowMiniToc":false,"Id":"TITIGEPR_CH1COGEPRAPTH_S1.103CASEHINOOTNO","Title":"Sec. 1.103. - Catchlines of Sections; history notes; other notes.","Content":"<div class=\"chunk-content\">\n            <p class=\"incr0\">\n               (a)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               The catchlines of the several Sections of this Code printed in boldface type are intended\n               as mere catchwords to indicate the contents of the Section and are not titles of such\n               Sections, or of any part of the Section, nor unless expressly so provided shall they\n               be so deemed when any such Section, including the catchline, is amended or reenacted.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (b)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               The history or source notes appearing after Sections in this Code have no legal effect\n               and only indicate legislative history.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (c)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               Editor's notes or other notes appearing after Sections have no legal effect and are\n               not part of this Code. Annotations appearing at the end of Chapters or elsewhere in\n               the Code have no legal effect and are not part of this Code.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (d)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               Unless specified otherwise, all references to Titles, Chapters, Parts or Sections\n               are to Titles, Chapters, Parts or Sections of this Code.\n               </p>\n            \t\t</div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TITIGEPR_CH1COGEPRAPTH_S1.102DERUCO","Heading":"Sec. 1.102. - Definitions and rules of construction.","NodeDepth":3,"HasChildren":false,"ParentId":"TITIGEPR_CH1COGEPRAPTH","DocOrderId":400,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TITIGEPR_CH1COGEPRAPTH_S1.104EFREOR","Heading":"Sec. 1.104. - Effect of repeal of ordinances.","NodeDepth":3,"HasChildren":false,"ParentId":"TITIGEPR_CH1COGEPRAPTH","DocOrderId":402,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}