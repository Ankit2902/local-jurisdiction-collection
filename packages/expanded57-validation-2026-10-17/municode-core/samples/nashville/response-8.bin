{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":true,"CompareStatus":2,"DocOrderId":558,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"CD_TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">1.01.030 - General penalty for Code violations—Continuing offenses—Schedule.</div>","ShouldShowMiniToc":false,"Id":"CD_TIT1GEPR_CH1.01COAD_1.01.030GEPECOVIONOFCH","Title":"1.01.030 - General penalty for Code violations—Continuing offenses—Schedule.","Content":"<div class=\"chunk-content\">\n            <p class=\"incr0\">\n               A.\n               </p>\n            \t\t\n            <p class=\"content1\">\n               Wherever in the Code re-adopted by this ordinance codified in this chapter, or in\n               any other ordinance or resolution of the metropolitan government or in any rule, regulation\n               or order promulgated by any officer or agency of the metropolitan government under\n               authority duly vested in him or her or if any act is prohibited or is made or declared\n               to be unlawful or an offense or a misdemeanor, where no specific penalty is provided\n               therefor, the violation of any such provision of such code or any other ordinance\n               or resolution of the metropolitan government or such rule, regulation or order shall\n               be punished by a penalty not to exceed fifty dollars.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               B.\n               </p>\n            \t\t\n            <p class=\"content1\">\n               Except where otherwise provided, every day any violation of such code or any other\n               ordinance or resolution of the metropolitan government or such rule, regulation or\n               order shall continue shall constitute a separate offense.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               C.\n               </p>\n            \t\t\n            <p class=\"content1\">\n               Any person electing to plead guilty and pay a fine in lieu of appearing in court for\n               any moving metropolitan traffic violation shall pay a fifty dollar fine.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               D.\n               </p>\n            \t\t\n            <p class=\"content1\">\n               Any person electing to plead guilty and pay a fine in lieu of appearing in court for\n               any metropolitan non-moving traffic violation shall pay a thirty-five dollar fine,\n               with the exception of a violation of T.C.A. 55-9-603 (Seat Belt) charged as a metropolitan\n               violation pursuant to Section <a href=\"\" data-chunk-id=\"CD_TIT12VETR_CH12.08GEREADEN_12.08.160STOFDEMUMI\" class=\"section-link\" data-product-id=\"14214\">12.08.160</a>, for which the fine shall be twenty dollars.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               E.\n               </p>\n            \t\t\n            <p class=\"content1\">\n               Any person electing to plead guilty and pay a fine in lieu of appearing in court for\n               a violation of Section <a href=\"\" data-chunk-id=\"CD_TIT12VETR_CH12.44PAMEZO_12.44.040PAPAIMLIUS\" class=\"section-link\" data-product-id=\"14214\">12.44.040</a> subsections A. and B., as they pertain to parking meters, shall pay a fine of twenty-five\n               dollars for each violation.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               F.\n               </p>\n            \t\t\n            <p class=\"content1\">\n               Any person electing to plead guilty and pay a fine in lieu of appearing in court for\n               a violation of Section <a href=\"\" data-chunk-id=\"CD_TIT12VETR_CH12.44PAMEZO_12.44.040PAPAIMLIUS\" class=\"section-link\" data-product-id=\"14214\">12.44.040</a> subsection C., as it pertains to overtime parking at parking meters, shall pay a\n               fine of twenty-five dollars.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               G.\n               </p>\n            \t\t\n            <p class=\"content1\">\n               Any person electing to plead guilty and pay a fine in lieu of appearing in court for\n               all other parking violations shall pay a fine of twenty-five dollars unless otherwise\n               specified.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               H.\n               </p>\n            \t\t\n            <p class=\"content1\">\n               Any person eligible and electing to plead guilty and pay a fine in lieu of appearing\n               in court for any other violation of an ordinance, resolution, rule, regulation, or\n               order of the metropolitan government shall pay a fifty dollar fine for each separate\n               violation.\n               </p>\n            \t\t\n            <p class=\"historynote0\">\n               (Ord. BL2025-1074 § 3, 2025; Ord. BL2025-959 § 3, 2025; Ord. BL2025-813 § 3, 2025;\n               Ord. BL2025-745 § 3, 2025; Ord. BL2024-551 § 3, 2024; Ord. BL2024-261 § 3, 2024; Ord.\n               BL2023-3 § 3, 2023; Ord. BL2023-1862 § 3, 2023; Ord. BL2023-1685 § 3, 2023; Ord. BL2022-1476\n               § 3, 2022; Ord. BL2022-1333 § 3, 2022; Ord. BL2022-1175 § 3, 2022; Ord. BL2021-978\n               § 3, 2021; Ord. BL2021-800 § 3, 2021; Ord. BL2021-689 § 3, 2021; Ord. BL2021-596 §\n               3, 2020; Ord. BL2020-495 § 3, 2020; Ord. BL2020-383 § 3, 2020; Ord. BL2020-306 § 3,\n               2020; Ord. BL2019-113 § 3, 2020; Ord. BL2019-1 § 1, 2019; Ord. BL2019-1740 § 3, 2019;\n               Ord. BL2018-1387 § 3, 2018; Ord. BL2018-1181 § 3, 2018; Ord. BL2017-986 § 3, 2017;\n               Ord. BL2017-733 § 3, 2017; Ord. BL2016-434 § 3, 2016; Ord. BL2016-260 § 3, 2016; Ord.\n               BL2016-207 § 3, 2016; Ord. BL2015-46 § 3, 2015; Ord. BL2015-1214 § 3, 2015; Ord. BL2015-1063\n               § 3, 2015; Ord. BL2014-825 § 3, 2014; Ord. BL2013-601 § 3, 2013; Ord. BL2013-446 §\n               3, 2013; Ord. BL2013-369 § 3, 2013;Ord. BL2012-211 § 3, 2012; Ord. BL2012-130 § 3,\n               2012; Ord. BL2011-60 § 3, 2012; Ord. BL2011-955 § 3, 2011; Ord. BL2011-906 § 3, 2011;\n               Ord. BL2010-826 § 3, 2011; Ord. BL2010-793 § 1, 2010; Ord. BL2010-616 § 1, 2010; Ord.\n               BL2009-481 § 1, 2009; Ord. BL2004-420 § 3, 2004; Ord. BL2004-356 § 3, 2004; Ord. BL2004-230\n               § 3, 2004; Ord. BL2004-182 § 3, 2004; Ord. BL2003-40 § 3, 2003; Ord. BL2003-32 § 3,\n               2003; Ord. BL2003-1406 § 3, 2003; Ord. BL2003-1338 § 3, 2003; Ord. BL2003-1302 § 3,\n               2003; Ord. BL2002-1130 § 3, 2002; Ord. BL2002-1072 § 3, 2002; Ord. BL2002-1025 § 3,\n               2002; Ord. BL2002-948 § 3, 2002; Ord. BL2001-771 § 3, 2001; Ord. BL2001-693 § 3, 2001;\n               Ord. BL2001-575 § 3, 2001; Ord. BL2000-512 § 3, 2000; Ord. BL2000-329 § 3, 2000; Ord.\n               BL2000-275 § 3, 2000; Ord. 99-1776 § 3, 1999; Ord. 98-1497 §§ 2, 3, 1999; Ord. 98-1447\n               § 1, 1999; Ord. 97-729 § 1, 1997; Ord. 97-1009 § 3, 1997; Ord. 97-794 § 3, 1997; Ord.\n               96-528 § 3, 1996; Ord. 96-346 § 3, 1996; Ord. 95-103 § 3, 1995; § 3 of Amdt. 1 to\n               Ord. 95-1329, 2/21/95; Ord. 95-1329 § 1, 1995)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"CD_TIT1GEPR_CH1.01COAD_1.01.020COCOFI","Heading":"1.01.020 - Copies of Code on file.","NodeDepth":3,"HasChildren":false,"ParentId":"CD_TIT1GEPR_CH1.01COAD","DocOrderId":557,"Children":[],"Data":{"NodeKey":null,"IsUpdated":true,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":2,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"CD_TIT1GEPR_CH1.01COAD_1.01.040SE","Heading":"1.01.040 - Severability.","NodeDepth":3,"HasChildren":false,"ParentId":"CD_TIT1GEPR_CH1.01COAD","DocOrderId":559,"Children":[],"Data":{"NodeKey":null,"IsUpdated":true,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":2,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}