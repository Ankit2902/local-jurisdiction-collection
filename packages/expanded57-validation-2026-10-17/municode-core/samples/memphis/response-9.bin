{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":8,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-4-3. - Catchlines of sections.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1-4GEPR_S1-4-3CASE","Title":"Sec. 1-4-3. - Catchlines of sections.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The catchlines of the several sections of this Code printed in boldface type are intended\n               as mere catchwords to indicate the contents of the section and shall not be deemed\n               or taken to be titles of such sections, nor as any part of the section, nor, unless\n               expressly so provided, shall they be so deemed when any of such sections, including\n               the catchlines, are amended or reenacted.\n               </p>\n            <p class=\"historynote0\">\n               (Code 1967, § 1-3; Code 1985, § 1-3)\n               </p>\n            <p class=\"refstatelaw0\" block_type=\"hang\"><b>State Law reference— </b>\n               Similar provisions as to state statutes, T.C.A. § 1-3-109.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1-4GEPR_S1-4-2DERUCO","Heading":"Sec. 1-4-2. - Definitions and rules of construction.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1-4GEPR","DocOrderId":7,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1-4GEPR_S1-4-4COEV","Heading":"Sec. 1-4-4. - Code as evidence.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1-4GEPR","DocOrderId":9,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}