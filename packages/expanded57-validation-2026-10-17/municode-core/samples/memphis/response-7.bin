{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":6,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-4-1. - How Code designated and cited.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1-4GEPR_S1-4-1HOCODECI","Title":"Sec. 1-4-1. - How Code designated and cited.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The ordinances embraced in the following titles, chapters and sections shall constitute\n               and be designated as the \"Code of Ordinances, City of Memphis, Tennessee,\" and may\n               be so cited. The Code may also be cited as the \"Memphis City Code\" or \"Memphis Municipal\n               Code.\"\n               </p>\n            <p class=\"historynote0\">\n               (Code 1985, § 1-1; Editorially amended during 2004 codification)\n               </p>\n            <p class=\"refcharter0\" block_type=\"hang\"><b>Charter reference— </b>\n               Authority to codify ordinances, § 361.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1-4GEPR","Heading":"CHAPTER 1-4. - GENERAL PROVISIONS","NodeDepth":2,"HasChildren":true,"ParentId":"TIT1GEPR","DocOrderId":5,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1-4GEPR_S1-4-2DERUCO","Heading":"Sec. 1-4-2. - Definitions and rules of construction.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1-4GEPR","DocOrderId":7,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}