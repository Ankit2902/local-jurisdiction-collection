{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":126,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"OKMUCO2020_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">§ 1-1. - How Code designated and cited.</div>","ShouldShowMiniToc":false,"Id":"OKMUCO2020_CH1GEPR_S1-1HOCODECI","Title":"§ 1-1. - How Code designated and cited.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The ordinances embraced in this and the following chapters shall constitute and be\n               designated as the \"Oklahoma City Municipal Code, 2020,\" and may be cited as such.\n               </p>\n            <p class=\"historynote0\">\n               (Code 1970, § 1-1; Code 1980, § 1-1)\n               </p>\n            <p class=\"refstatelaw0\" block_type=\"hang\"><b>State Law reference— </b>\n               Codification of municipal ordinances, 11 O.S. § 14-108.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"OKMUCO2020_CH1GEPR","Heading":"Chapter 1 - GENERAL PROVISIONS","NodeDepth":1,"HasChildren":true,"ParentId":"17000","DocOrderId":125,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"OKMUCO2020_CH1GEPR_S1-2DERUCO","Heading":"§ 1-2. - Definitions and rules of construction.","NodeDepth":2,"HasChildren":false,"ParentId":"OKMUCO2020_CH1GEPR","DocOrderId":127,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}