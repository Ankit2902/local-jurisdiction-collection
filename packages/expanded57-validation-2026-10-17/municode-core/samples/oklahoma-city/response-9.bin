{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":128,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"OKMUCO2020_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">§ 1-3. - References to Code; conflicts.</div>","ShouldShowMiniToc":false,"Id":"OKMUCO2020_CH1GEPR_S1-3RECOCO","Title":"§ 1-3. - References to Code; conflicts.","Content":"<div class=\"chunk-content\">\n            <p class=\"incr0\">\n               (a)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               All references to chapters, articles, divisions, or sections are to the chapters,\n               articles, divisions and sections of this Code unless otherwise provided.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (b)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               If the provisions of different chapters or articles of this Code conflict with or\n               contravene each other, the provisions of each chapter or article shall prevail as\n               to all matters and questions growing out of the subject matter of that chapter or\n               article.\n               </p>\n            \t\t\n            <p class=\"historynote0\">\n               (Code 1980, § 1-3)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"OKMUCO2020_CH1GEPR_S1-2DERUCO","Heading":"§ 1-2. - Definitions and rules of construction.","NodeDepth":2,"HasChildren":false,"ParentId":"OKMUCO2020_CH1GEPR","DocOrderId":127,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"OKMUCO2020_CH1GEPR_S1-4CASEHINORE","Heading":"§ 1-4. - Catchlines of sections; history notes and references.","NodeDepth":2,"HasChildren":false,"ParentId":"OKMUCO2020_CH1GEPR","DocOrderId":129,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}