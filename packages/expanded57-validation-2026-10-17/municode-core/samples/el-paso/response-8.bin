{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":143,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">1.01.020 - Title—Citation—Reference.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1.01COAD_1.01.020TIITEF","Title":"1.01.020 - Title—Citation—Reference.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               This code shall be known as the El Paso Code and it shall be sufficient to refer to\n               the code as the El Paso City Code in any prosecution for the violation of any provision\n               thereof or in any proceeding at law or equity. It shall be sufficient to designate\n               any ordinance adding to, amending, correcting or repealing all or any part or portion\n               of the El Paso City Code. Further reference may be had to the title, chapters, sections\n               and subsections of the El Paso City Code and such references shall apply to that numbered\n               title, chapter, section or subsection as it appears in the code.\n               </p>\n            <p class=\"historynote0\">\n               (Ord. 8773 § 2, 1986)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1.01COAD_1.01.010AD","Heading":"1.01.010 - Adoption.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01COAD","DocOrderId":142,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1.01COAD_1.01.030REAPALAM","Heading":"1.01.030 - Reference applies to all amendments.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01COAD","DocOrderId":144,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}