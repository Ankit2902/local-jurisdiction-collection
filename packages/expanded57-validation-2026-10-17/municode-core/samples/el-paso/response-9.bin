{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":144,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">1.01.030 - Reference applies to all amendments.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1.01COAD_1.01.030REAPALAM","Title":"1.01.030 - Reference applies to all amendments.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               Whenever a reference is made to this code as the El Paso City Code or to any portion\n               thereof, or to any ordinance of the City of El Paso, Texas, codified in this code,\n               the reference shall apply to all amendments, corrections and additions heretofore,\n               now or hereafter made.\n               </p>\n            <p class=\"historynote0\">\n               (Ord. 8773 § 3, 1986)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1.01COAD_1.01.020TIITEF","Heading":"1.01.020 - Title—Citation—Reference.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01COAD","DocOrderId":143,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1.01COAD_1.01.040TICHSEHE","Heading":"1.01.040 - Title, chapter and section headings.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01COAD","DocOrderId":145,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}