{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":142,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PTIICOOR_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1. - Designation and citation of Code.</div>","ShouldShowMiniToc":false,"Id":"PTIICOOR_CH1GEPR_S1-1DECICO","Title":"Sec. 1-1. - Designation and citation of Code.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The provisions in the following chapters and sections shall constitute and be designated\n               the \"Code of Ordinances, City of Charlotte, North Carolina\" and may be so cited. Such\n               Code may also be cited as \"Charlotte Code.\"\n               </p>\n            <p class=\"historynote0\">\n               (Code 1985, § 1-1)\n               </p>\n            <p class=\"refstatelaw0\" block_type=\"hang\"><b>State Law reference— </b>\n               Codification of ordinances, G.S. 160A-77; pleading and proving city ordinances, G.S.\n               160A-79.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PTIICOOR_CH1GEPR","Heading":"Chapter 1 - GENERAL PROVISIONS","NodeDepth":1,"HasChildren":true,"ParentId":"19970","DocOrderId":141,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PTIICOOR_CH1GEPR_S1-2DERUCO","Heading":"Sec. 1-2. - Definitions and rules of construction.","NodeDepth":2,"HasChildren":false,"ParentId":"PTIICOOR_CH1GEPR","DocOrderId":143,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}