{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":144,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PTIICOOR_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-3. - Catchlines, history notes and references.</div>","ShouldShowMiniToc":false,"Id":"PTIICOOR_CH1GEPR_S1-3CAHINORE","Title":"Sec. 1-3. - Catchlines, history notes and references.","Content":"<div class=\"chunk-content\">\n            <p class=\"incr0\">\n               (a)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               The catchlines of the several sections of this Code printed in boldface type are intended\n               as mere catchwords to indicate the contents of the section and shall not be deemed\n               or taken to be titles of such sections, nor as any part of the section, nor, unless\n               expressly so provided, shall they be so deemed when any of such sections, including\n               the catchlines, are amended or reenacted.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (b)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               The history notes following sections and the references and notes scattered throughout\n               the Code are not part of the Code but are merely for the benefit of the user of the\n               Code.\n               </p>\n            \t\t\n            <p class=\"historynote0\">\n               (Code 1985, §§ 1-4, 1-11)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PTIICOOR_CH1GEPR_S1-2DERUCO","Heading":"Sec. 1-2. - Definitions and rules of construction.","NodeDepth":2,"HasChildren":false,"ParentId":"PTIICOOR_CH1GEPR","DocOrderId":143,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PTIICOOR_CH1GEPR_S1-4SE","Heading":"Sec. 1-4. - Severability.","NodeDepth":2,"HasChildren":false,"ParentId":"PTIICOOR_CH1GEPR","DocOrderId":145,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}