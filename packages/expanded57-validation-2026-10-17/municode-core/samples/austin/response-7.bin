{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":126,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">§ 1-1-1 - APPLICATION; CITATION; AND INTERNAL REFERENCES.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1-1GEPR_S1-1-1APCIINRE","Title":"§ 1-1-1 - APPLICATION; CITATION; AND INTERNAL REFERENCES.","Content":"<div class=\"chunk-content\">\n            <p class=\"incr0\">\n               (A)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               This title applies to the construction of the City Code.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (B)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               The Code may be cited as the \"Austin City Code\" or the \"City Code.\"\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (C)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               A reference to a title, chapter, article, section or subsection without further identification\n               is a reference to a title, chapter, or section of the Code.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (D)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               A reference to a title, chapter, article, section, subsection, or other numbered or\n               lettered unit without further identification is a reference to a unit of the next\n               larger unit of the Code.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (E)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               The heading of a title, chapter, article, section, subsection, or other numbered or\n               lettered unit of the Code does not limit or expand the meaning of that part of the\n               Code.\n               </p>\n            \t\t\n            <p class=\"historynote0\">\n               Source: 1992 Code Section 1-1-1; Ord. 031106-11; Ord. 031211-11.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1-1GEPR","Heading":"CHAPTER 1-1. - GENERAL PROVISIONS.","NodeDepth":2,"HasChildren":true,"ParentId":"TIT1GEPR","DocOrderId":125,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1-1GEPR_S1-1-2GEDE","Heading":"§ 1-1-2 - GENERAL DEFINITIONS.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1-1GEPR","DocOrderId":127,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}