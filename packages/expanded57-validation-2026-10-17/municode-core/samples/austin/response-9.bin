{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":128,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">§ 1-1-3 - WORDS AND PHRASES.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1-1GEPR_S1-1-3WOPH","Title":"§ 1-1-3 - WORDS AND PHRASES.","Content":"<div class=\"chunk-content\">\n            <p class=\"incr0\">\n               (A)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               Words and phrases shall be read in context and construed according to the rules of\n               grammar and common usage.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (B)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               Words and phrases that have acquired a technical or particular meaning, whether by\n               definition or otherwise, shall be construed accordingly.\n               </p>\n            \t\t\n            <p class=\"historynote0\">\n               Source: 1992 Code Section 1-1-3; Ord. 031106-11; Ord. 031211-11.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1-1GEPR_S1-1-2GEDE","Heading":"§ 1-1-2 - GENERAL DEFINITIONS.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1-1GEPR","DocOrderId":127,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1-1GEPR_S1-1-4TENUGEGR","Heading":"§ 1-1-4 - TENSE; NUMBER; GENDER; AND GRAMMAR.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1-1GEPR","DocOrderId":129,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}