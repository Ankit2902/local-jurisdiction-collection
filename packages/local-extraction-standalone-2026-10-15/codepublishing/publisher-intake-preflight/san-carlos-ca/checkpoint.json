      "provenance": [
        {
          "record_id": "08c6ee0b0e8e364657b29dc06901e569f29f92ad62c5b9d33d7454de41d89820",
          "node_id": "https://www.codepublishing.com/CA/SanCarlos/cgi/menuCompile.pl::html-id:a1x01x010",
          "publication_id": "city-code",
          "raw_artifact_path": "raw/selected-chapters.html",
          "raw_sha256": "a749f541b843d5187ce704244c52116193067c11d50483c8cf69f9e36b2497c0",
          "locator": {
            "kind": "html-id",
            "value": "a1x01x010"
          },
          "extraction_version": "cp-handoff-1.2",
          "structured_representation": "HTML fragment in full_text",
          "plain_text": "Pursuant to the provisions of Sections 50022.1 through 50022.8 and 50022.10 of the Government Code, there is hereby adopted the \"San Carlos Municipal Code,\" published by Book Publishing Company, Seattle, Washington, together with those secondary codes previously adopted by reference as authorized by the California State Legislature, save and except those portions of the secondary codes as are deleted or modified by the provisions of the \"San Carlos Municipal Code.\" (Ord. 1037 § 1, 1989)"
        },
        {
          "record_id": "5b6cca4d2e834bf3ac878ecd97081e050f5c0e042135d12e6253c8ca44b5394e",
          "node_id": "https://www.codepublishing.com/CA/SanCarlos/cgi/menuCompile.pl::html-id:a1x01x020",
          "publication_id": "city-code",
          "raw_artifact_path": "raw/selected-chapters.html",
          "raw_sha256": "a749f541b843d5187ce704244c52116193067c11d50483c8cf69f9e36b2497c0",
          "locator": {
            "kind": "html-id",
            "value": "a1x01x020"
          },
          "extraction_version": "cp-handoff-1.2",
          "structured_representation": "HTML fragment in full_text",
          "plain_text": "This Code shall be known as the \"San Carlos Municipal Code\" in any prosecution for the violation of any provision thereof or in any proceeding at law or equity. It shall be sufficient to designate any ordinance adding to, amending, correcting or repealing all or any part or portion thereof as an addition to, amendment to, correction or repeal of the \"San Carlos Municipal Code.\" Further reference may be had to the titles, chapters, sections and subsections of the \"San Carlos Municipal Code\" and such references shall apply to that numbered title, chapter, section or subsection as it appears in the Code. (Ord. 1037 § 2, 1989)"
        },
        {
          "record_id": "c1eb82e1a09f38961409123ecd4e7211ca9207f1ae6655b2bbba1ecbe1c3061f",
          "node_id": "https://www.codepublishing.com/CA/SanCarlos/cgi/menuCompile.pl::html-id:a1x01x030",
          "publication_id": "city-code",
          "raw_artifact_path": "raw/selected-chapters.html",
          "raw_sha256": "a749f541b843d5187ce704244c52116193067c11d50483c8cf69f9e36b2497c0",
          "locator": {
            "kind": "html-id",
            "value": "a1x01x030"
          },
          "extraction_version": "cp-handoff-1.2",
          "structured_representation": "HTML fragment in full_text",
          "plain_text": "This Code consists of all the regulatory and penal ordinances and certain of the administrative ordinances of the City of San Carlos, California, codified pursuant to the provisions of Sections 50022.1 through 50022.8 and 50022.10 of the Government Code. (Ord. 1037 § 3, 1989)"
        },
        {
          "record_id": "07a641da93402b3e455ae452e18f6ebf7faf2b495ff2a2c2e8c91d543b537536",
          "node_id": "https://www.codepublishing.com/CA/SanCarlos/cgi/menuCompile.pl::html-id:a1x01x040",
          "publication_id": "city-code",
          "raw_artifact_path": "raw/selected-chapters.html",
          "raw_sha256": "a749f541b843d5187ce704244c52116193067c11d50483c8cf69f9e36b2497c0",
          "locator": {
            "kind": "html-id",
            "value": "a1x01x040"
          },
          "extraction_version": "cp-handoff-1.2",
          "structured_representation": "HTML fragment in full_text",
          "plain_text": "The last ordinance included in this Code was Ordinance 1019, passed February 27, 1989. The following ordinances, passed subsequent to Ordinance 1019, but prior to adoption of this Code, are adopted and made a part of this Code: Ordinances 1020 through 1035. (Ord. 1037 § 4, 1989)"
        },
        {
          "record_id": "3f6f58ec9ef2d7b6cc9d0ec43ede81b960865be67e40829520fe522f64b95591",
          "node_id": "https://www.codepublishing.com/CA/SanCarlos/cgi/menuCompile.pl::html-id:a1x01x050",
          "publication_id": "city-code",
          "raw_artifact_path": "raw/selected-chapters.html",
          "raw_sha256": "a749f541b843d5187ce704244c52116193067c11d50483c8cf69f9e36b2497c0",
          "locator": {
            "kind": "html-id",
            "value": "a1x01x050"
          },
          "extraction_version": "cp-handoff-1.2",
          "structured_representation": "HTML fragment in full_text",
          "plain_text": "Whenever a reference is made to this Code as the \"San Carlos Municipal Code\" or to any portion thereof, or to any ordinance of the City of San Carlos, California, the reference shall apply to all amendments, corrections and additions heretofore, now or hereafter made. (Ord. 1037 § 5, 1989)"
        },
        {
          "record_id": "2cd3f41503a40f7ee983db9a149896d87c18589d004929db626129d336c00402",
          "node_id": "https://www.codepublishing.com/CA/SanCarlos/cgi/menuCompile.pl::html-id:a1x01x060",
          "publication_id": "city-code",
          "raw_artifact_path": "raw/selected-chapters.html",
          "raw_sha256": "a749f541b843d5187ce704244c52116193067c11d50483c8cf69f9e36b2497c0",
          "locator": {
            "kind": "html-id",
            "value": "a1x01x060"
          },
          "extraction_version": "cp-handoff-1.2",
          "structured_representation": "HTML fragment in full_text",
          "plain_text": "Title, chapter and section headings contained in this Code shall not be deemed to govern, limit, modify or in any manner affect the scope, meaning or intent of the provisions of any title, chapter or section hereof. (Ord. 1037 § 6, 1989)"
        },
        {
          "record_id": "8e3ee9d4f16a1a57e159eecf8130824476824368a443c0057861073aca4fed90",
          "node_id": "https://www.codepublishing.com/CA/SanCarlos/cgi/menuCompile.pl::html-id:a1x01x070",
          "publication_id": "city-code",
          "raw_artifact_path": "raw/selected-chapters.html",
          "raw_sha256": "a749f541b843d5187ce704244c52116193067c11d50483c8cf69f9e36b2497c0",
          "locator": {
            "kind": "html-id",
            "value": "a1x01x070"
          },
          "extraction_version": "cp-handoff-1.2",
          "structured_representation": "HTML fragment in full_text",
          "plain_text": "The provisions of this Code shall not in any manner affect matters of record which refer to, or are otherwise connected with ordinances which are therein specifically designated by number or otherwise and which are included within the Code, but such reference shall be construed to apply to the corresponding provisions contained within this Code. (Ord. 1037 § 7, 1989)"
        },
        {
          "record_id": "98a0334877f04c90206e90afb71c56c85a8ed943b8fa33a7be7d43a20ad69f0c",
          "node_id": "https://www.codepublishing.com/CA/SanCarlos/cgi/menuCompile.pl::html-id:a1x01x080",
          "publication_id": "city-code",
          "raw_artifact_path": "raw/selected-chapters.html",
          "raw_sha256": "a749f541b843d5187ce704244c52116193067c11d50483c8cf69f9e36b2497c0",
          "locator": {
            "kind": "html-id",
            "value": "a1x01x080"
          },
          "extraction_version": "cp-handoff-1.2",
          "structured_representation": "HTML fragment in full_text",
          "plain_text": "Neither the adoption of this Code nor the repeal or amendment hereby of any ordinance or part or portion of any ordinance of the City shall in any manner affect the prosecution for violations of ordinances, which violations were committed prior to the effective date of this Code, nor be construed as a waiver of any license, fee or penalty at said effective date due and unpaid under such ordinances, nor be construed as affecting any of the provisions of such ordinances relating to the collection of any such license, fee or penalty, or the penal validity of any bond or cash deposit in lieu thereof required to be posted, filed or deposited pursuant to any ordinance; and all rights and obligations thereunder appertaining shall continue in full force and effect. (Ord. 1037 § 8, 1989)"
        },
        {
          "record_id": "0e6c466b90920f2fd72d5da224c862798c77b6f470dd7f109b76c53613e56a1d",
          "node_id": "https://www.codepublishing.com/CA/SanCarlos/cgi/menuCompile.pl::html-id:a1x01x090",
          "publication_id": "city-code",
          "raw_artifact_path": "raw/selected-chapters.html",
          "raw_sha256": "a749f541b843d5187ce704244c52116193067c11d50483c8cf69f9e36b2497c0",
          "locator": {
            "kind": "html-id",
            "value": "a1x01x090"
          },
          "extraction_version": "cp-handoff-1.2",
          "structured_representation": "HTML fragment in full_text",
          "plain_text": "This Code shall become effective on the date the ordinance adopting this Code as the \"San Carlos Municipal Code\" becomes effective. (Ord. 1037 § 9, 1989)"
        },
        {
          "record_id": "fa8c0cc01be0e6b5587fb36d2fb05b1420460f3e1060d63617314df97ee6c891",
          "node_id": "https://www.codepublishing.com/CA/SanCarlos/cgi/menuCompile.pl::html-id:a1x01x100",
          "publication_id": "city-code",
          "raw_artifact_path": "raw/selected-chapters.html",
          "raw_sha256": "a749f541b843d5187ce704244c52116193067c11d50483c8cf69f9e36b2497c0",
          "locator": {
            "kind": "html-id",
            "value": "a1x01x100"
          },
          "extraction_version": "cp-handoff-1.2",
          "structured_representation": "HTML fragment in full_text",
          "plain_text": "If any section, subsection, sentence, clause or phrase of this Code is for any reason held to be invalid or unconstitutional, such decision shall not affect the validity of the remaining portions of this Code. The Council hereby declares that it would have passed this Code, and each section, subsection, sentence, clause and phrase thereof, irrespective of the fact that any one or more sections, subsections, sentences, clauses or phrases had been declared invalid or unconstitutional; and if for any reason this Code should be declared invalid or unconstitutional, then the original ordinance or ordinances shall be in full force and effect. (Ord. 1037 § 10, 1989)"
        }
      ]
    }
