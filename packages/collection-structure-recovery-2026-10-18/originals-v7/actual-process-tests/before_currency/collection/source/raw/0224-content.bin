                        <p class="CellBody"><span class="italic"><img class="Default" src="../images/10-50.110.110b1.272126.png" width="246" height="290"  alt="" title="" /></span></p>

          </td>
          <td style="padding: 3pt 2pt 2pt 2pt; vertical-align: top; width: 8.389pt">
                        <p class="CellBody">&nbsp;</p>

