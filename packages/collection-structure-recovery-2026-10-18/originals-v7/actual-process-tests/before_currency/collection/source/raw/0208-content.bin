        <tr>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">All other commercial uses that are allowed in a corresponding industrial zone with a GFAR limitation. (max. GFAR area)<span class="Superscript">4, 5</span></p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC">--</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC">0.25</p>

          </td>
