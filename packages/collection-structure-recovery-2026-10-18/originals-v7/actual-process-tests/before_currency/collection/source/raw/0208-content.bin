        <tr>
          <td style="background-color: transparent;border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top; width: 220.82070000000002pt" colspan="3">
                        <p class="CellBody">Automobile/Vehicle Repair Garages &ndash; Major</p>

          </td>
          <td style="background-color: transparent;border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top; width: 90.2812pt">
                        <p class="CellBodyC"><a href="../Flagstaff10/Flagstaff1040060.html#10.40.60.100">10-40.60.100</a></p>

          </td>
          <td style="background-color: transparent;border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top; width: 30.9373pt">
                        <p class="CellBodyC">--</p>

