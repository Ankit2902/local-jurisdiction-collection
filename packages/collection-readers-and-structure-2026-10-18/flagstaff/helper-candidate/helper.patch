+def rooted_file(root, name):
+    require(isinstance(name, str) and name and '\\' not in name,
+            'Unsafe relative file reference')
+    rel = PurePosixPath(name)
+    require(not rel.is_absolute() and rel.as_posix() == name
+            and all(part not in ('', '.', '..') for part in name.split('/')),
+            'Unsafe relative file reference')
+    current = root
+    for part in rel.parts:
+        current = current / part
+        require(not current.is_symlink(), 'Symlink file component is unsupported')
+    require(current.is_file() and current.resolve().is_relative_to(root),
+            'Referenced file is missing or outside its root')
+    return current
+
+
+def collector_files(root):
+    """Independent current common originals code_binding, without importing it.
+
+    Deliberately exact: a future launcher binding change requires helper review,
+    rather than accepting a supplied subset of the command's dependencies.
+    """
+    names = {'collect.py', 'collectors/ops/launcher.py',
+             'collectors/ops/browser_check.cjs', 'collectors/ops/requirements.txt',
+             'collectors/registry/collect.py', 'collectors/registry/dispatch.py',
+             'collectors/registry/catalog.py'}
+    family = root / 'collectors/originals'
+    require(family.is_dir() and not family.is_symlink(), 'Missing originals implementation')
+    for folder in (root / 'collectors/registry', family):
+        require(not folder.is_symlink(), 'Symlink source directory is unsupported')
+    for path in family.glob('*'):
+        if path.suffix in ('.py', '.cjs', '.json'):
+            names.add(path.relative_to(root).as_posix())
+    for folder in ('configs', 'policies', 'profiles'):
+        directory = family / folder
+        require(not directory.is_symlink(), 'Symlink source directory is unsupported')
+        for path in directory.rglob('*'):
+            require(not path.is_symlink(), 'Symlink collector source is unsupported')
+            if path.is_file() and path.suffix == '.json':
+                names.add(path.relative_to(root).as_posix())
+    ignored = {'source-evidence-manifest.json', 'original-source-evidence-manifest.json',
+               'readiness-source-evidence-manifest.json'}
+    for path in (root / 'collectors/registry').glob('*.json'):
+        if path.name not in ignored:
+            names.add(path.relative_to(root).as_posix())
+    return {name: sha(rooted_file(root, name)) for name in sorted(names)}
+
+
+def unchanged(call, expected):
+    try:
+        return call() == expected
+    except Exception:
+        return False
