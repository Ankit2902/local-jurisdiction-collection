    >
      <input type="checkbox" class="selectionBoxInput" id="7679999_input" aria-labelledby="7679999_label"/>
    </span>
    <label class="selectionLabel" id="7679999_label" for="7679999_input">
  <div class="titleLinkContainer">
    <a href="#7679999"
       class="titleLink"
    >
    <span class="titleNumber">
      Article XLII
    </span>
    <span class="titleTitle"
          data-guid="7679999"
    >
Establishment; Membership; Powers and Duties    </span>
    </a>
  </div>
