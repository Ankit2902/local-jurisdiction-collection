  </div>
</div>

</div>

    </div>
          <div class="views-row">
           
<div class="node--embedded">
    <h3>
        <a href="/code/14/b50/020" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">14B.50.020   Forfeiture Proceedings.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><ol class="code-list"><li>All civil forfeitures conducted pursuant to this Chapter are subject to the procedures and limitations set forth in ORS Chapter 131A except that the distribution of proceeds in ORS 131A.360 is not applicable.</li></ol></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-fc3f3bd64323cc60a0fd3c454cd61b1b924fcc16be8862e2ccbbaf0e4bcc0eb2">
  
    

  
  

  
  
  

  
  

  
