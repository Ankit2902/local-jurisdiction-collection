<div class="node--embedded">
    <h3>
        <a href="/code/14/a110/440" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">14A.110.440  Administrative Rules.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><p><span>The City Administrator may adopt administrative rules as authorized by Charter.</span></p></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-0e0c3f2baffd35b3114a0687b5b4f2e225847e0518937a0f337468751ca7e5a0">
  
    

  
  

  
  
  

  
  

  
  </div>
</div>
<div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_sections js-view-dom-id-54ffbbb79f7b0e9fdf7b4c9705808130fef6db34abce682af393c24e766c3275">
  
    

  
  

  
  
  

  
  

  
