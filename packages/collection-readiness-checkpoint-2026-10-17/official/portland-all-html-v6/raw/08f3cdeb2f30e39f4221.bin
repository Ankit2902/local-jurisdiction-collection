          <div class="views-row">
           
<div class="node--embedded">
    <h3>
        <a href="/code/14/a55/050" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">14A.55.050  Appeals to the Code Hearings Officer.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><p><span>A determination issued pursuant to Section 14A.55.040 of this Code may be appealed to the Code Hearings Officer, as provided for in Chapter 22.10 of this Code.</span></p></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-a2bf8d07162a6465967f22d08a9c4348c02634ab4fc62d75cc55e0c107e4b380">
  
    

  
  

  
  
  

  
  

  
