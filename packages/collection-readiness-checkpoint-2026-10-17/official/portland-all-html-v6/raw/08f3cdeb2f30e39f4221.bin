<div class="node--embedded">
    <h3>
        <a href="/code/14/a55/070" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">14A.55.070  Additional Regulations.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><p><span>The Portland Permitting &amp; Development is authorized to promulgate administrative rules and take other actions reasonable and necessary to enforce Chapter 14A.55 of this Code.</span></p></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-80bf28279efee2bbcae9f0927920b2101a0cd6db5100283e93e0dd8188312046">
  
    

  
  

  
  
  

  
  

  
