          <div class="views-row">
      <div class="views-field views-field-rendered-entity"><span class="field-content">    
<div class="node--embedded">
    <h2>
        <a href="/code/24/60" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">Chapter 24.60 Fences</span>
</a>
    </h2>
    <div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-0567610b6f7e7ca60b17d5379e00fb06d7db009201dd802282a8b92f1f0f4784">
  
    

  
  

  
  
  

  
  

  
  </div>
</div>
<div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_sections js-view-dom-id-c8350009aa4f370016c4dc2b2d9840d40d362eccfa61af3a06627c2f0480237d">
  
    

  
  

          <div class="views-row">
           
<div class="node--embedded">
    <h3>
        <a href="/code/24/60/020" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">24.60.020 Barbed Wire Fencing.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><p><span>It is unlawful for any person to construct or maintain a fence containing barbed wire, unless the barbed wire is placed not less than 6 inches above the top of the fence and the fence is not less than 4 feet high.</span></p></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-f06e058692db6b1a6350b0bfe731cf338c5e99f6764a25231bf8757f45b90d9a">
  
    

  
  

  
  
  

  
  

  
  </div>
</div>
<div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_sections js-view-dom-id-681bb12ed49ddbdc5fd20b4a2a45a860dc24a4239d690a7da7d8aa0689090169">
  
    

  
  

  
  
  

  
  

  
