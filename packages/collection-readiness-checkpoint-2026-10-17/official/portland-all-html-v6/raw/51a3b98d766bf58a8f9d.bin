<div class="node--embedded">
    <h2>
        <a href="/code/24/25" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">Chapter 24.25 Moving of Buildings</span>
</a>
    </h2>
    <div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-de6e3a940b7c884e66af663f35843d906e95ea16cd7466ca902d0c9976268c73">
  
    

  
  

  
  
  

  
  

  
