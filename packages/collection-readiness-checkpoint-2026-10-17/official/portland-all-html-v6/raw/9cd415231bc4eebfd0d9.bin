  </div>
</div>

</div>

    </div>
          <div class="views-row">
           
<div class="node--embedded">
    <h3>
        <a href="/code/3/40/070" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">3.40.070 Administrative Rules.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><p><span>The City Administrator may establish administrative rules for any ABC covered by this Chapter and other applicable City Code.</span></p></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-4fdde7347058290ea15ce1b0479fbe3cc1499089cabbc1b52ff87a7635c5bc57">
  
    

  
  

  
  
  

  
  

  
