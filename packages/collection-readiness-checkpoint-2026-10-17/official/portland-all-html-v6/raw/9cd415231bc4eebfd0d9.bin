          <div class="views-row">
           
<div class="node--embedded">
    <h3>
        <a href="/code/3/40/010" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">3.40.010 Purpose of Chapter.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><p><span>This Chapter establishes policies for City appointed boards, commissions, and committees (ABCs).</span></p></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-acc8181473b6624ac2a7d682ec43c3c31b0467662c475289d828f1914c123a59">
  
    

  
  

  
  
  

  
  

  
