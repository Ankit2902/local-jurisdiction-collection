<div class="node--embedded">
    <h3>
        <a href="/code/3/19/010" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">3.19.010 Community Police Oversight System.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><p><span>The Community Police Oversight System (Oversight System) is established.</span></p></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-100e68f880f5deb41aecabe08ed7837f82d52620b6f8909a24ddf3866934b25e">
  
    

  
  

  
  
  

  
  

  
