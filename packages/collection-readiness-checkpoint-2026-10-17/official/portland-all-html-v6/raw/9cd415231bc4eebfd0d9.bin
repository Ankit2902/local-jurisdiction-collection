<div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_sections js-view-dom-id-a1339f22f6ce852a5d3a5036376cc151ead46ba641ca3731dfe8a8f79de7b94e">
  
    

  
  

  
  
  

  
  

  
  </div>
</div>

</div>

    </div>
          <div class="views-row">
           
<div class="node--embedded">
    <h3>
        <a href="/code/3/40/080" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">3.40.080 Public Meetings. </span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><p><span>ABCs classified in Subsection 3.40.030 B. and created by Council must have meetings open to the public, even if they are not required to under Oregon Public Meetings Law.</span></p></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-14d33d5382f20fb19eda015b56e9b3347e6a3158901743cdff2ad4310f814df7">
  
    

  
  

  
  
  

  
  

  
  </div>
</div>
<div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_sections js-view-dom-id-8e8f2c363eebbac3a9e1fbc47406c2f0bbf70938eeb8998d81dbb421fa29e656">
  
    

  
  

  
  
  

  
  

  
