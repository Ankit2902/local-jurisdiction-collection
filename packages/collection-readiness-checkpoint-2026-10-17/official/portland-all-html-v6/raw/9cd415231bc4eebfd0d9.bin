          <div class="views-row">
           
<div class="node--embedded">
    <h3>
        <a href="/code/3/125/050" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">3.125.050  Staff Support to Disaster Policy Council.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><p><span>The Portland Bureau of Emergency Management will provide staff support to the DPC, including recording and communicating its decisions.</span></p></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-39a746c631c11d0b6c29f7baad176bbb1a0705b7adad27e76764286077509304">
  
    

  
  

  
  
  

  
  

  
