          <div class="views-row">
           
<div class="node--embedded">
    <h3>
        <a href="/code/3/19/030" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">3.19.030 Structure and Processes of the Community Police Oversight System. </span>
