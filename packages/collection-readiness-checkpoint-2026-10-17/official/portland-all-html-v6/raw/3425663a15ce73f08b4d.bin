    <h3>
        <a href="/code/25/01/010" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">25.01.010 Title.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><ol class="code-list"><li>This Title is known as the “Plumbing Regulations,” may be so cited and pleaded and will be referred to in this Title as “this Title.”</li></ol></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-89754492e78d29ad1c61dfb4abe88df661b9314c7da5b591247b7823f9795d8d">
  
    

  
  

  
  
  

  
  

  
