      <div class="views-field views-field-rendered-entity"><span class="field-content">    
<div class="node--embedded">
    <h2>
        <a href="/code/25/09" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">Chapter 25.09 Conversion or Abandonment of Nonconforming Sewers</span>
</a>
    </h2>
    <div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-16ff44e6b1f265b1f3985c37877422130e1c7151135d953687ca5c23aa06ff88">
  
    

  
  

  
  
  

  
  

  
