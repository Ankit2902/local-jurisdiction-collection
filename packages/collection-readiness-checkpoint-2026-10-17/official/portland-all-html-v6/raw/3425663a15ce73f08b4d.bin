<div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_sections js-view-dom-id-3b40df3336922acb503b4e8d91751c521fc9b83f2427a42b7ed97fc46216e95e">
  
    

  
  

          <div class="views-row">
           
<div class="node--embedded">
    <h3>
        <a href="/code/25/06/010" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">25.06.010 Compliance Agreement.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><ol class="code-list"><li>Any person applying for registration and any owner doing any plumbing work, must, in consideration of the granting of a plumbing permit therefor, agree to comply with all of the codes and ordinances of the City regulating plumbing, water, rainwater harvesting systems, sewers, and rain drain disposal, and with the provisions of the building regulations, housing regulations, health regulations, and the Oregon Plumbing Specialty Code.</li></ol></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-db8cd6f92d0701444d302827f6eb7601cb26baf547104426bd699488daa83808">
  
    

  
  

  
  
  

  
  

  
  </div>
