      <div class="views-field views-field-rendered-entity"><span class="field-content">    
<div class="node--embedded">
    <h2>
        <a href="/code/25/06" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">Chapter 25.06 Registrations</span>
