          <div class="views-row">
           
<div class="node--embedded">
    <h3>
        <a href="/code/17/34/130" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">17.34.130 Conflict.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><p><span>This Chapter supersedes all other ordinances and their elements to the extent that they are inconsistent with or conflict with any part of this Chapter.</span></p></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-3bc8bf2d1be65dd9f04f45a405ba07dea1cdcae296e7efc5c460e61b0e9d2e5d">
  
    

  
  

  
  
  

  
  

  
