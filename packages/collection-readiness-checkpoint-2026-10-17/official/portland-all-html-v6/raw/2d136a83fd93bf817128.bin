<div class="node--embedded">
    <h3>
        <a href="/code/17/32/170" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">17.32.170  Severability.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><p><span>If any provision, paragraph, word, or Section of this Chapter or associated administrative rules is invalidated by any court of competent jurisdiction, the remaining provisions, paragraphs, words, and Sections will not be affected and will continue in full force and effect.</span></p></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-af4119753f3cb665b1da83a41bc4990b679e568cee9221d8b18832b8e6e38ef2">
  
    

  
  

  
  
  

  
  

  
