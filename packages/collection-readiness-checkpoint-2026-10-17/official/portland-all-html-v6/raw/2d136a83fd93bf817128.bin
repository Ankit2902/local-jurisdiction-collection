  </div>
</div>

</div>

    </div>
          <div class="views-row">
           
<div class="node--embedded">
    <h3>
        <a href="/code/17/38/070" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">17.38.070 Conflict.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><p><span>Except as expressly provided by the City Council, this Chapter supersedes all ordinances or elements of ordinances to the extent that they are inconsistent with or conflict with any part of this Chapter.</span></p></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-b8443610330b889238f1ffba60e465016e70ca04da3a734dd9401c6d23f1db3b">
  
    

  
  

  
  
  

  
  

  
