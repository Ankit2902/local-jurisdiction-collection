<div class="node--embedded">
    <h2>
        <a href="/code/32/34" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">Chapter 32.34 Additional Regulations for Specific Uses, Overlay Zones, and Plan Districts</span>
</a>
    </h2>
    <div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-abb798fac8fa38503afdc1749c6248bf34fa723431ebd0e385632099ab5d23f8">
  
    

  
  

  
  
  

  
  

  
