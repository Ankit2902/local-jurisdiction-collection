      <div class="views-field views-field-rendered-entity"><span class="field-content">    
<div class="node--embedded">
    <h2>
        <a href="/code/7/14" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">Chapter 7.14 Utility License Law</span>
</a>
    </h2>
    <div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-3bb6b97e897dc88aa157828b2e42ebdceb68dea55cde03d4ad2ff14cab84d90d">
  
    

  
  

  
  
  

  
  

  
