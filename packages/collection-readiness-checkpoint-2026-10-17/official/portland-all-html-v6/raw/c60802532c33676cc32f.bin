<div class="node--embedded">
    <h3>
        <a href="/code/10/40/060" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">10.40.060 Public Works Projects.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><ol class="code-list"><li>Projects within the public right-of-way may not be commenced until the erosion, sediment and pollutant control plan has been accepted and controls are in place.</li></ol></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-13bdbd6d6c19d69e5b793eab540cfbd16eca2affa6cc6cd06db604b3c04a1396">
  
    

  
  

  
  
  

  
  

  
