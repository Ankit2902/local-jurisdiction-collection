  </div>
</div>

</div>

    </div>
          <div class="views-row">
           
<div class="node--embedded">
    <h3>
        <a href="/code/26/02/020" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">26.02.020 Approved.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><p><span><strong>Approved</strong> means electrical installations, equipment, product or materials acceptable under ORS 479 to the City, Portland Permitting &amp; Development.</span></p></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-4b7de1134d26d80a352379315bf833a0b21e89e2de69221caa4a1465f59cf78f">
  
    

  
  

  
  
  

  
  

  
  </div>
</div>
<div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_sections js-view-dom-id-29999d9aa42fc2d0e2f0dd245a7f8055b62ad576c0b128b6fcf4e8c6de570a14">
  
    

  
  

  
  
  

  
  

  
  </div>
