              <div class="views-row">
      <div class="views-field views-field-rendered-entity"><span class="field-content">    
<div class="node--embedded">
    <h2>
        <a href="/code/26/01" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">Chapter 26.01 Title and Scope</span>
</a>
    </h2>
    <div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-48f803b7db9e3a9a27d25f514a3b57e7ced2b6f35829b105b5a2c70e42c51200">
  
    

  
  

  
  
  

  
  

  
