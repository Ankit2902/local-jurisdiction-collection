        <div class="content">
      
  <h1 class="page-title">Title 27 Heating and Ventilating Regulations</h1>


    </div>
  </div>







<div id="block-cloudy-content" data-block-plugin-id="system_main_block" class="block block-system block-system-main-block mb-6">
      
        
        <div class="content">
      <div class="views-element-container"><div class="skip-editoria11y-check view view-city-code-list view-id-city_code_list view-display-id-page_title_all js-view-dom-id-22760a4b877169fc0628b1e7a4de403f3924f5f38cffccafcde1c458f129c130">
  
    
      <div class="view-header">
      
