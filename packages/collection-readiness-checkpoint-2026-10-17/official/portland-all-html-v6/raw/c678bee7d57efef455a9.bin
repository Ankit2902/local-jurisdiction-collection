          <div class="views-row">
           
<div class="node--embedded">
    <h3>
        <a href="/code/23/01/100" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">23.01.100 Construction.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-prefix-note field--type-text-long ck-content"><div class="field__item"><p>(Amended by Ordinance <a href="https://efiles.portlandoregon.gov/record/17087002">191973</a>, effective January 1, 2025.)</p></div></div>



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><ol class="code-list"><li>This Chapter must be broadly construed, consistent with its remedial purpose.</li></ol></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-ef9b5d09359a4c919fec49f17d0816b30b5b9eca88fe74d6a3c9536a6304d14e">
  
    

  
  

  
  
  

  
  

  
