      <div class="views-field views-field-rendered-entity"><span class="field-content">    
<div class="node--embedded">
    <h2>
        <a href="/code/23/20" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">Chapter 23.20 Sanctuary City</span>
</a>
    </h2>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-prefix-note field--type-text-long ck-content"><div class="field__item"><p>(Chapter added by Ordinance 192115, effective October 15, 2025.)</p></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-b5fb620dd93eca56278bcab8c6598d382c2825d137182fa687a04086bc90be18">
  
    

  
  

  
  
  

  
  

  
