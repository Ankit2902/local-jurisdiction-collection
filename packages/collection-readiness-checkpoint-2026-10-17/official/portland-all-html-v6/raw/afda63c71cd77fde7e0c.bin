          <div class="views-row">
           
<div class="node--embedded">
    <h3>
        <a href="/code/16/70/210" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">16.70.210 Pedestrians Must Use Crosswalks.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><ol class="code-list"><li>No pedestrian may cross a street other than within a crosswalk if within 150 feet of a crosswalk.</li></ol></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-8001decf1c22a1f2724edfa7fc71ce121efffbf38c95547b44d50f7b5c08428a">
  
    

  
  

  
  
  

  
  

  
