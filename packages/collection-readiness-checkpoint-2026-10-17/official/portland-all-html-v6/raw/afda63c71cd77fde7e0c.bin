  </div>
</div>

</div>

    </div>
          <div class="views-row">
           
<div class="node--embedded">
    <h3>
        <a href="/code/16/90/420" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">16.90.420 Utility Trailer.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><ol class="code-list"><li>A vehicle that is used to carry property, refuse, or special equipment, is 16 feet or less in length and is designed to be pulled by a motor vehicle. Boat trailers are included as utility trailers no matter what their length.</li></ol></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-7304173079862cb5687e0852d97ab7eb9c1c3aaadbcdca81e6d1c727540a4f47">
  
    

  
  

  
  
  

  
  

  
