<div class="node--embedded">
    <h3>
        <a href="/code/16/20/213" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">16.20.213 No Stopping or Parking Zone.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><ol class="code-list"><li>No vehicle may stop or park in any no parking or stopping zone.</li></ol></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-208d261ff12604ac4df48481297658723685571cab98fa6b2e3b13e1e14efcde">
  
    

  
  

  
  
  

  
  

  
