<div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_sections js-view-dom-id-6be3bce54a51922cd356a3c7f51db78b33c44c0db50ecdeba3d5911abc451971">
  
    

  
  

  
  
  

  
  

  
  </div>
</div>

</div>

    </div>
          <div class="views-row">
           
<div class="node--embedded">
    <h3>
        <a href="/code/16/90/410" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">16.90.410 Truck Trailer.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><ol class="code-list"><li>A vehicle that is not a recreational vehicle or utility trailer, is more than 16 feet in length, and is designed to be pulled by a motor vehicle.</li></ol></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-fffe0b37249d4100f307ff5ff51161b3f2d4b74f6db9b475250ac7b4aca7e610">
  
    

  
  

  
  
  

  
  

  
