  </div>
</div>

</div>

    </div>
          <div class="views-row">
           
<div class="node--embedded">
    <h3>
        <a href="/code/16/90/415" rel="bookmark"><span class="field field--name-title field--type-string field--label-hidden">16.90.415 Uncontrolled Intersection.</span>
</a>
    </h3>
    



<div class="clearfix text-formatted field field--label-hidden field--name-field-section-body field--type-text-long ck-content"><div class="field__item"><ol class="code-list"><li>Any intersection with no official traffic control device to designate vehicular right-of-way.</li></ol></div></div><div class="views-element-container">
<div class="mb-6 view view-eva view-city-code-list view-id-city_code_list view-display-id-eva_embedded_code_chapters js-view-dom-id-ee8c273277ae2b4f5a735db0093249a6aec6f186907d00eec57f1252f0264bad">
  
    

  
  

  
  
  

  
  

  
