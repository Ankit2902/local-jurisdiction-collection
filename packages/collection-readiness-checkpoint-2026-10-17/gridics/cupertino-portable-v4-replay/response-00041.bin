 \u00a7 3, 1973; Ord. 843, \u00a7 10.2, 1977; Ord. 1990, 2006; Ord. 24-2263, \u00a7 1, 2024)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"5bb366e7-5d0b-4922-aa8d-08ea39ca5238","prev_id":null}]},{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/fd33fcae-0aaf-4220-afd9-b5fae7b61586","ref":{"parent":"768def6a-9047-4624-a01e-bd6b29396fd0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"212-18-218","docId":"75","text":"TABLE 11.24.150","id":"fd33fcae-0aaf-4220-afd9-b5fae7b61586","children":[{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/fd33fcae-0aaf-4220-afd9-b5fae7b61586\/802a5873-fa39-4543-9cf3-8037e4e8a09b","ref":{"parent":"fd33fcae-0aaf-4220-afd9-b5fae7b61586","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"212-18-218-11","docId":"75","text":"\u003Ctable style=\u0022width:800px\u0022\u003E\u003Cthead\u003E\u003Ctr\u003E\u003Cth scope=\u0022col\u0022\u003E\u003Cstrong\u003EStreet\u003C\/strong\u003E\u003C\/th\u003E\u003Cth scope=\u0022col\u0022\u003E\u003Cstrong\u003ESides of Street\u003C\/strong\u003E\u003C\/th\u003E\u003Cth scope=\u0022col\u0022\u003E\u003Cstrong\u003EPortion\u003C\/strong\u003E\u003C\/th\u003E\u003C\/tr\u003E\u003C\/thead\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Ctd\u003EAdriana Avenue\u003C\/td\u003E\u003Ctd\u003ENorth and South\u003C\/td\u003E\u003Ctd\u003EBetween Mann Drive and a point 100 feet east thereof\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003EAlhambra Avenue\u003C\/td\u003E\u003Ctd\u003EEast\u003C\/td\u003E\u003Ctd\u003EBetween University Way southerly to southern terminus (approximately 1,162 feet)\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003EAnton Way\u003C\/td\u003E\u003Ctd\u003EBoth\u003C\/td\u003E\u003Ctd\u003EBetween Stevens Creek Boulevard and Alves Drive\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003EBandley Drive\u003C\/td\u003E\u003Ctd\u00