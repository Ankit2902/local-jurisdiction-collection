part), 1987; Ord. 1391, 1986; Ord. 1365, 1986; Ord. 1339, (part), 1985; Ord. 1226, 1983; Ord. 1204, 1982; Ord. 1156, 1982; Ord. 1130, (part), 1981; Ord. 1095, 1981; Ord. 1078, 1980; Ord. 1073, 1980; Ord. 1041, 1980; Ord. 1000, 1980; Ord. 975, 1980; Ord. 970, (part), 1980; Ord. 900, (part), 1978; Ord. 467 \u00a7 3.1, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"e15c9fdd-fe25-4b2e-8608-cadf24fe880e","prev_id":null}]},{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/b2ae45bc-d789-46ef-b6e3-9585e3b3e029\/267d26ad-b1ad-4f3b-a3a7-483b46848276","ref":{"parent":"b2ae45bc-d789-46ef-b6e3-9585e3b3e029","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"212-17-14","docId":"75","text":"11.20.030 All Directional Vehicular Stop Required at Certain Intersections.","id":"267d26ad-b1ad-4f3b-a3a7-483b46848276","children":[{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/b2ae45bc-d789-46ef-b6e3-9585e3b3e029\/267d26ad-b1ad-4f3b-a3a7-483b46848276\/547a192d-5c08-479d-a8d3-e28076ba5513","ref":{"parent":"267d26ad-b1ad-4f3b-a3a7-483b46848276","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"212-17-14-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe driver of any vehicle upon approaching any entrance of any of the following intersections sign-posted with a stop sign shall stop\u003Col\u003E\u003Cli\u003EAt a limit line, if marked, otherwise before entering the crosswalk on the near side of the intersection, or, if not marked, then before entering the intersection; or\u003C\/li\u003E\u003Cli\u003EAt any point within the intersection as required by a stop sign.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EAfter such stop, the driver shall yield the right-of-way to other vehicles on that part of any street protected by any stop sign which are so close as to constitute an immediate hazard, and shall continue to yield the right-of-way to such approaching vehicles until such time as he can proceed with reasonable safety. A driver having yielded may proceed, and the drivers of all other vehicles approaching on that part of the street protected by the stop sign shall yield the right-of-way to the vehicle about to enter or cross the protected part of the street:\u003C\/li\u003E\u003C\/ol\u003E\u003Ctable cellpadding=\u00220\u0022 cellspacing=\u00220\u0022 style=\u0022width:600px\u0022\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EAlves Drive\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EBandley Drive\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EBandley Drive at Mariani Avenue\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EBlaney Avenue and Clifford Drive\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EBlaney Avenue and Forest Avenue\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EBlaney Avenue and John Drive\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EBlaney Avenue and Merritt Drive\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EBlaney Avenue and Rodrigues Avenue\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EBlaney Avenue and Suisun Drive\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EBlue Jay Drive and Northwest Square\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EBubb Road and Columbus Avenue\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EBubb Road and Hyannisport Drive\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EBubb Road and Pumpkin Drive\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EBubb Road and Rainbow Drive\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EByrne Avenue and San Fernando Avenue\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003ECalvert Drive and Tilson Avenue\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EDempster Avenue, Fitzgerald Drive and Peninsula Avenue\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EDempster Avenue and Stokes Avenue\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EEast Estates Drive and Davison Avenue\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EEast Estates Drive and Glenview Avenue\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EEast Estates Drive and La Mar Drive\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EEast Estates Drive and Richwood Drive\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EFinch Avenue and Phil Lane\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EFolkstone Drive and Yorkshire Drive\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EFoothill Boulevard and Stevens Creek Boulevard\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EFort Baker Drive and Hyannisport Drive\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EGranada Avenue and Pasadena Avenue\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EHuntridge and Stelling\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EKim Street and Kirwin Lane\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EJanice Avenue and Palo Vista Road\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003ELazaneo Drive and Vista Drive\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EMerritt Drive and Portal Avenue\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EMira Vista Road and Palm Avenue\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003ENorth Portal Avenue and Wheaton Drive\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EOlive Avenue and Pasadena Avenue\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EOrion Lane and Stelling Road\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EPacifica Drive and Farallone Avenue\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EProspect Drive and Seven Springs Parkway\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EProspect Road and Stelling Road\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003ERainbow Drive and Weymouth Drive\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003ERainbow Drive and Yorkshire Drive\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003ERodrigues Avenue and Torre Avenue\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003ESanta Clara Avenue and Grand Avenue\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003ETerrace Drive and Terra Bella Drive\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022vertical-align:top\u0022\u003E\u003Cp\u003EWaterford Drive and Stelling Road.\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003C\/tbody\u003E\u003C\/table\u003E\u003Cp\u003E(Ord. 11-2078, 2011; Ord. 2036, 2008; Ord. 1855, 2000; Ord. 1765, (part), 1997; Ord. 1762, 1997; Ord. 1704, (part), 1995; Ord. 1698, (part), 1995; Ord. 1482, 1989; Ord. 1445, (part), 1988; Ord. 1429, (part), 1987; Ord. 1406, 1987; Ord. 1339, (part), 1985; Ord. 1297, 1985; Ord. 1268, 1984; Ord. 1181, 1982; Ord. 1130, (part), 1981; Ord. 1070, 1980; Ord. 994, 1980; Ord. 976, 1980; Ord. 970, (part), 1980; Ord. 942, 1979; Ord. 900 (part), 1978; Ord. 467, \u00a7 3.2, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"547a192d-5c08-479d-a8d3-e28076ba5513","prev_id":null}]}]},{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0","ref":{"parent":"ccb0cd02-0dd5-407b-bffd-162d19236255","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"212-18","docId":"75","text":"CHAPTER 11.24: STOPPING, STANDING AND PARKING--PUBLIC STREETS*","id":"768def6a-9047-4624-a01e-bd6b29396fd0","children":[{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/dd9a688d-d890-4ab1-969e-73b37b737863","ref":{"parent":"768def6a-9047-4624-a01e-bd6b29396fd0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"212-18-11","docId":"75","text":"\u003Cp\u003E* For statutory provisions relating to stopping, standing and parking, see Veh. Code \u00a7 22500 et seq. For provisions regarding the parking or leaving of vehicles in public parks, see Ch. 13.04 of this code; for provisions regarding the enforcement of parking regulations, see Ch. 2.30. Prior ordinance history: Ord. 381.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"dd9a688d-d890-4ab1-969e-73b37b737863","prev_id":null},{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/4f43c123-524c-40e9-a657-92c799e27472","ref":{"parent":"768def6a-9047-4624-a01e-bd6b29396fd0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"212-18-12","docId":"75","text":"11.24.010 Purpose.","id":"4f43c123-524c-40e9-a657-92c799e27472","children":[{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/4f43c123-524c-40e9-a657-92c799e27472\/4576238a-e03d-48b6-89c4-1e28c5c6e5ab","ref":{"parent":"4f43c123-524c-40e9-a657-92c799e27472","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"212-18-12-11","docId":"75","text":"\u003Cp\u003EThe provisions of this chapter prohibiting the stopping, standing or parking of a vehicle shall apply at all times, or at those times herein specified, except when it is necessary either to stop a vehicle to avoid conflict with other traffic, or in compliance with the directions of a law enforcement officer or official traffic-control device.\u003C\/p\u003E\u003Cp\u003E(Ord. 843, \u00a7 4.1, 1977)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"4576238a-e03d-48b6-89c4-1e28c5c6e5ab","prev_id":null}]},{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/91f1fef2-16ff-4d2a-b29a-42ccc839fce0","ref":{"parent":"768def6a-9047-4624-a01e-bd6b29396fd0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"212-18-13","docId":"75","text":"11.24.020 Scope.","id":"91f1fef2-16ff-4d2a-b29a-42ccc839fce0","children":[{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/91f1fef2-16ff-4d2a-b29a-42ccc839fce0\/02bd7d48-a695-422e-9071-2b7ef75fc2b2","ref":{"parent":"91f1fef2-16ff-4d2a-b29a-42ccc839fce0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"212-18-13-11","docId":"75","text":"\u003Cp\u003EThe provisions of this chapter imposing a time limit on stopping, standing, or parking shall not relieve any person from the duty to observe other and more restrictive provisions of the Vehicle Code of the state, or the ordinances of the City prohibiting or limiting the stopping, standing, or parking of vehicles in specified places or at specified times.\u003C\/p\u003E\u003Cp\u003E(Ord. 843, \u00a7 4.2, 1977)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"02bd7d48-a695-422e-9071-2b7ef75fc2b2","prev_id":null}]},{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/fa98cc17-4594-4f47-9a91-a488d8a55f33","ref":{"parent":"768def6a-9047-4624-a01e-bd6b29396fd0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"212-18-14","docId":"75","text":"11.24.030 Definitions.","id":"fa98cc17-4594-4f47-9a91-a488d8a55f33","children":[{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/fa98cc17-4594-4f47-9a91-a488d8a55f33\/52d9600b-2084-4bdd-af8d-74d259109df8","ref":{"parent":"fa98cc17-4594-4f47-9a91-a488d8a55f33","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"212-18-14-11","docId":"75","text":"\u003Cp\u003EThe following words and phrases when used in this chapter shall have the meanings set forth in this section:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003E\u201cEmergency\u201d means a situation in which immediate, temporary, small-scale maintenance is necessary in order to permit an otherwise operable vehicle to continue, such as changing a flat tire, jump-starting a dead battery, or adding water to an overheated radiator. An emergency situation shall not be construed to permit work on, or storage of, a vehicle which could be towed to an appropriate location for repair or servicing.\u003C\/li\u003E\u003Cli\u003E\u201cDisplay for sale\u201d means to place, store, park, or cause to be placed, stored or parked, for the primary purpose of selling such vehicle or part thereof, as opposed to parking such vehicle temporarily for the purpose of carrying out incidental errands or other temporary tasks. It shall be a rebuttable presumption affecting the burden of proof, that any vehicle, or part thereof, displaying a \u201cFor Sale\u201d Parking limited alongsign, or displaying a sign containing information about price, conditions, or telephone number, has been parked or placed for the primary purpose of sale.\u003C\/li\u003E\u003Cli\u003E\u201cHighway\u201d means a way or place of whatever nature, publicly maintained and open to the use of the public for purpose of vehicular travel. \u201cHighway\u201d includes street.\u003C\/li\u003E\u003Cli\u003E\u201cHolidays\u201d means the first day in January, Memorial Day, Independence Day, Admission Day, Labor Day, Thanksgiving Day, and Christmas.\u003C\/li\u003E\u003Cli\u003E\u201cIntersection\u201d means the area embraced within the prolongation of the lateral curblines, or, if none, then the lateral boundary lines of the roadways, of two highways which join one another at approximately right angles, or the area within which vehicles traveling upon different highways joining at any other angle may come in conflict.\u003C\/li\u003E\u003Cli\u003E\u201cPark\u201d means to stand or leave standing any vehicle, whether occupied or not, otherwise than temporarily for the purpose of and while actually engaged in loading or unloading of passengers or materials.\u003C\/li\u003E\u003Cli\u003E\u201cParkway\u201d means that portion of a street other than a roadway or sidewalk.\u003C\/li\u003E\u003Cli\u003E\u201cRoadway\u201d means that portion of a highway improved, designed, or ordinarily used for vehicular travel.\u003C\/li\u003E\u003Cli\u003E\u201cSidewalk\u201d means that portion of a highway, other than the roadway, set apart by curbs, barriers, markings, or other delineation for pedestrian travel.\u003C\/li\u003E\u003Cli\u003E\u201cStop\u201d or \u201cstopping\u201d when prohibited means any cessation of movement of a vehicle, whether occupied or not, except when necessary to avoid conflict with other traffic or in compliance with the direction of a police officer or official traffic-control device or signal.\u003C\/li\u003E\u003Cli\u003E\u201cStreet\u201d means a way or place of whatever nature, publicly maintained and open to the use of the public for purposes of vehicular travel. \u201cStreet\u201d includes highway.\u003C\/li\u003E\u003Cli\u003E\u201cVehicle\u201d means any passenger cars, trucks, vans, buses, motor homes, trailers, motorcycles, all-terrain vehicles and boats, as well as parts and accessories thereof, including but not limited to camper shells, boat trailers, tires, seats, and other similar items.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1394, \u00a7 1 (part), 1986; Ord. 843, \u00a7 2, 1977)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"52d9600b-2084-4bdd-af8d-74d259109df8","prev_id":null}]},{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/85ed6c17-0b80-4cc2-968c-b5eaa8cbfe7e","ref":{"parent":"768def6a-9047-4624-a01e-bd6b29396fd0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"212-18-15","docId":"75","text":"11.24.040 Curb Markings and Signs Designated.","id":"85ed6c17-0b80-4cc2-968c-b5eaa8cbfe7e","children":[{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/85ed6c17-0b80-4cc2-968c-b5eaa8cbfe7e\/18ba5c71-634c-4a3f-82a3-b04b9fb1edb7","ref":{"parent":"85ed6c17-0b80-4cc2-968c-b5eaa8cbfe7e","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"212-18-15-11","docId":"75","text":"\u003Cp\u003EThe City Traffic Engineer is authorized, subject to the provisions and limitations of this chapter, to place, and when required in this chapter shall place the following curb markings or curb markings and signs to indicate parking or standing regulations, and the curb markings shall have the meanings as set forth in this section.\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ENo-parking Zone. Red means no stopping, standing, or parking at any time except as permitted by the Vehicle Code, and except that a bus may stop in a red zone marked or signed as a bus zone.\u003C\/li\u003E\u003Cli\u003ELoading Zone. Yellow means no stopping, standing or parking for any purpose other than the loading or unloading of passengers or materials to and from commercial vehicles making commercial deliveries; provided, that the loading or unloading of passengers shall not consume more than three minutes, nor the loading or unloading of materials more than twenty minutes, unless the City Traffic Engineer has caused signs to be posted giving notice of different period in which the restrictions shall apply.\u003C\/li\u003E\u003Cli\u003EPassenger Loading Zone. White means no stopping, standing, or parking for any purpose other than the loading or unloading of passengers, which shall not exceed three minutes, unless the City Traffic Engineer has caused signs to be posted giving notice of a different period in which the restrictions shall apply.\u003C\/li\u003E\u003Cli\u003ERestricted Parking Zone. Green means no stopping, standing, or parking for longer than twelve minutes at any time between seven a.m. and six p.m. on any day except Sundays and holidays, unless the City Traffic Engineer has caused signs, markings, or curb markings and signs to be posted giving notice of a different period in which the restrictions apply.\u003C\/li\u003E\u003Cli\u003EHandicapped Parking Zone. Blue means no stopping, standing, or parking except for vehicles of physically handicapped persons.\u003C\/li\u003E\u003Cli\u003ETemporary Parking Zone. Notwithstanding any other curb markings or signs placed pursuant to this chapter, the Hearing Officer may designate an area or areas to be a temporary parking zone, upon compliance with the procedures set forth in Section 11.24.220. Within an area in which appropriate signs or markings have been placed indicating a temporary parking zone, the terms and provisions noted thereon shall supersede all other parking ordinances and regulations inconsistent therewith.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 903, (part), 1978; Ord. 843, \u00a7 3, 1977)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"18ba5c71-634c-4a3f-82a3-b04b9fb1edb7","prev_id":null}]},{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/d60c2fbe-1637-4b03-bb5d-b5eb65718b11","ref":{"parent":"768def6a-9047-4624-a01e-bd6b29396fd0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"212-18-16","docId":"75","text":"11.24.050 Obedience to Signs.","id":"d60c2fbe-1637-4b03-bb5d-b5eb65718b11","children":[{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/d60c2fbe-1637-4b03-bb5d-b5eb65718b11\/524621a5-082f-4833-8f54-fc94d4ee4ff7","ref":{"parent":"d60c2fbe-1637-4b03-bb5d-b5eb65718b11","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"212-18-16-11","docId":"75","text":"\u003Cp\u003EWhenever signs have been erected, pursuant to Sections 11.24.040 through 11.24.110, no person shall stop, stand, or park any vehicle in the area designated by such signs.\u003C\/p\u003E\u003Cp\u003E(Ord. 843, \u00a7 9.2, 1977)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"524621a5-082f-4833-8f54-fc94d4ee4ff7","prev_id":null}]},{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/ad5e9972-b21d-4d1d-ad30-8b6cdec533d5","ref":{"parent":"768def6a-9047-4624-a01e-bd6b29396fd0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"212-18-17","docId":"75","text":"11.24.060 Prohibited at Certain Locations.","id":"ad5e9972-b21d-4d1d-ad30-8b6cdec533d5","children":[{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/ad5e9972-b21d-4d1d-ad30-8b6cdec533d5\/b12ed181-11a4-4aed-9116-054945ae5c7a","ref":{"parent":"ad5e9972-b21d-4d1d-ad30-8b6cdec533d5","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"212-18-17-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EIt is unlawful for any person to stop, stand, or park any vehicle as defined in the Vehicle Code of California, at any time when the City Traffic Engineer has erected signs or placed markings giving notice that parking is prohibited at any place within a distance not to exceed fifty feet of:\u003Col\u003E\u003Cli\u003EAn intersection crosswalk in any commercially zoned area; or,\u003C\/li\u003E\u003Cli\u003EThe approach to any traffic signal, boulevard stop sign, or official electric flashing device; or,\u003C\/li\u003E\u003Cli\u003EEither or both sides of any driveway approach; or,\u003C\/li\u003E\u003Cli\u003EThe curb return at the intersection of any two streets.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EThe City Traffic Engineer shall give notice of the prohibition of parking at any of the places described in this section, either by erecting and maintaining signs giving notice, or by placing a curb marking consisting of red paint upon the top and face of each curb.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 843, \u00a7 9.1, 1977)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"b12ed181-11a4-4aed-9116-054945ae5c7a","prev_id":null}]},{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/fd1ea120-4a18-41d3-852e-a1643708e223","ref":{"parent":"768def6a-9047-4624-a01e-bd6b29396fd0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"212-18-18","docId":"75","text":"11.24.070 Parking Space Markings.","id":"fd1ea120-4a18-41d3-852e-a1643708e223","children":[{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/fd1ea120-4a18-41d3-852e-a1643708e223\/559df388-b04c-4734-b97d-c53f10a32064","ref":{"parent":"fd1ea120-4a18-41d3-852e-a1643708e223","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"212-18-18-11","docId":"75","text":"\u003Cp\u003EThe City Traffic Engineer is authorized to install and maintain parking space markings to indicate parking spaces adjacent to curbings where authorized parking is permitted. When such parking space markings are placed in the highway, subject to other and more restrictive limitations, no vehicle shall be stopped, left standing or parked, other than within a single space, unless the size or shape of such vehicle makes compliance impossible.\u003C\/p\u003E\u003Cp\u003E(Ord. 843, \u00a7 9.3, 1977)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"559df388-b04c-4734-b97d-c53f10a32064","prev_id":null}]},{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/e725bdcf-e164-4e66-ac93-eac7202686ac","ref":{"parent":"768def6a-9047-4624-a01e-bd6b29396fd0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"212-18-19","docId":"75","text":"11.24.080 Authority to Establish Loading Zones.","id":"e725bdcf-e164-4e66-ac93-eac7202686ac","children":[{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/e725bdcf-e164-4e66-ac93-eac7202686ac\/a6fa24e6-90af-4ccb-8297-978b5cec1f1b","ref":{"parent":"e725bdcf-e164-4e66-ac93-eac7202686ac","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"212-18-19-11","docId":"75","text":"\u003Cp\u003EThe City Traffic Engineer is authorized to determine and to mark loading zones and passenger loading zones in commercially zoned areas and elsewhere, either in front of the entrance to any place of business, or in front of any hall or place used for the purpose of public assembly.\u003C\/p\u003E\u003Cp\u003E(Ord. 843, \u00a7 9.4, 1977)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"a6fa24e6-90af-4ccb-8297-978b5cec1f1b","prev_id":null}]},{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/30fdb5b6-f169-4e8b-b156-10ac74088a02","ref":{"parent":"768def6a-9047-4624-a01e-bd6b29396fd0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"212-18-210","docId":"75","text":"11.24.090 Loading Zones\u2013Marking.","id":"30fdb5b6-f169-4e8b-b156-10ac74088a02","children":[{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/30fdb5b6-f169-4e8b-b156-10ac74088a02\/ace1cea9-334c-4234-84a5-ae7fe4e8c21d","ref":{"parent":"30fdb5b6-f169-4e8b-b156-10ac74088a02","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"212-18-210-11","docId":"75","text":"\u003Cp\u003ELoading zones shall be indicated by a yellow paint line upon the top and face of all curbs within such zones.\u003C\/p\u003E\u003Cp\u003E(Ord. 843, \u00a7 9.5, 1977)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"ace1cea9-334c-4234-84a5-ae7fe4e8c21d","prev_id":null}]},{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/b03d128c-1a8f-4c76-acf5-5557e03432b7","ref":{"parent":"768def6a-9047-4624-a01e-bd6b29396fd0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"212-18-211","docId":"75","text":"11.24.100 Passenger Loading Zones.","id":"b03d128c-1a8f-4c76-acf5-5557e03432b7","children":[{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/b03d128c-1a8f-4c76-acf5-5557e03432b7\/71926908-aab4-4e2e-9c9d-d8c2fe9afc24","ref":{"parent":"b03d128c-1a8f-4c76-acf5-5557e03432b7","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"212-18-211-11","docId":"75","text":"\u003Cp\u003EPassenger loading zones shall be indicated by a white line stenciled with black letters \u201cPASSENGER LOADING ONLY\u201d upon the top of all curbs within such zones.\u003C\/p\u003E\u003Cp\u003E(Ord. 843, \u00a7 9.6, 1977)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"71926908-aab4-4e2e-9c9d-d8c2fe9afc24","prev_id":null}]},{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/aecd6f6e-05d5-47c9-9a93-1cb7c0415847","ref":{"parent":"768def6a-9047-4624-a01e-bd6b29396fd0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"212-18-212","docId":"75","text":"11.24.110 Spaces Restricted to Handicapped Persons.","id":"aecd6f6e-05d5-47c9-9a93-1cb7c0415847","children":[{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/aecd6f6e-05d5-47c9-9a93-1cb7c0415847\/f4ea0784-2052-4bd6-8a5a-6c749f04db72","ref":{"parent":"aecd6f6e-05d5-47c9-9a93-1cb7c0415847","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"212-18-212-11","docId":"75","text":"\u003Cp\u003EThe City Traffic Engineer is authorized to determine and to mark parking spaces on public streets for the exclusive use of vehicles which display a distinguishing license plate or placard issued by the California Department of Motor Vehicles to handicapped persons or to disabled veterans pursuant to Sections 22511.5 and 9105 of the California Vehicle Code. All parking spaces so designated shall be identified by blue paint on the curb or edge of the paved portion of the street adjacent to the space. In addition to blue paint, the space may also be indicated by signs or other suitable means.\u003C\/p\u003E\u003Cp\u003E(Ord. 843, \u00a7 9.7, 1977)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f4ea0784-2052-4bd6-8a5a-6c749f04db72","prev_id":null}]},{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/c51f5056-4f80-42a9-8dd5-b92031af60a1","ref":{"parent":"768def6a-9047-4624-a01e-bd6b29396fd0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"212-18-213","docId":"75","text":"11.24.120 Prohibited in Parkways.","id":"c51f5056-4f80-42a9-8dd5-b92031af60a1","children":[{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/c51f5056-4f80-42a9-8dd5-b92031af60a1\/664adb41-6567-4e6f-9a1b-e339f8fdb028","ref":{"parent":"c51f5056-4f80-42a9-8dd5-b92031af60a1","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"212-18-213-11","docId":"75","text":"\u003Cp\u003ENo person shall stop, stand, or park a vehicle within any parkway.\u003C\/p\u003E\u003Cp\u003E(Ord. 843, \u00a7 5, 1977)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"664adb41-6567-4e6f-9a1b-e339f8fdb028","prev_id":null}]},{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/97b86560-3fc0-4590-8bd5-9280a2547b9b","ref":{"parent":"768def6a-9047-4624-a01e-bd6b29396fd0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"212-18-214","docId":"75","text":"11.24.130 Prohibited for More than Seventy-Two Hours.","id":"97b86560-3fc0-4590-8bd5-9280a2547b9b","children":[{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/97b86560-3fc0-4590-8bd5-9280a2547b9b\/f49cd4b4-f409-4ace-9463-63af71550f47","ref":{"parent":"97b86560-3fc0-4590-8bd5-9280a2547b9b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"212-18-214-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ENo person who owns or has in their possession, custody, or control any vehicle or trailer shall park such vehicle or trailer upon any public street or alley for more than a consecutive period of seventy-two (72) hours. This prohibition shall apply to all vehicles parked or left standing within City limits unless explicitly exempt from this parking restriction by this section or another section of this code.\u003C\/li\u003E\u003Cli\u003EAny vehicle that has been parked or left standing in violation of this seventy-two (72) hour parking limit may be issued a citation or removed from the street in accordance with California Vehicle Code Section 22651.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 843, \u00a7 6, 1977; Ord. 25-2275, \u00a7 1, 2025)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f49cd4b4-f409-4ace-9463-63af71550f47","prev_id":null}]},{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/24bdf0b4-600f-4c12-8d72-1e8da70600d0","ref":{"parent":"768def6a-9047-4624-a01e-bd6b29396fd0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"212-18-215","docId":"75","text":"11.24.140 Parking for Purposes of Servicing or Repairing.","id":"24bdf0b4-600f-4c12-8d72-1e8da70600d0","children":[{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/24bdf0b4-600f-4c12-8d72-1e8da70600d0\/cce0665f-cb18-4b19-a800-f656e0ac58ff","ref":{"parent":"24bdf0b4-600f-4c12-8d72-1e8da70600d0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"212-18-215-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ENo person shall park a vehicle upon any roadway or on any private property or private roadway without the express written permission of the owner of such property, for the principal purpose of servicing or repairing such vehicle, except when necessitated by an emergency.\u003C\/li\u003E\u003Cli\u003EViolation of this provision shall constitute an infraction, and shall subject the registered owner of such vehicle to the penalties as prescribed by Chapter 1.12 of the Cupertino Municipal Code. Each day the violation continues constitutes a new offense. This section shall not constitute the exclusive means of enforcement of vehicles or parts thereof which have been stored, parked, placed, or abandoned on public or private roadways and private property within the City limits.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1999, 2007; Ord. 1394, \u00a7\u00a7 1 (part), 2, 1986; Ord. 1380, \u00a7\u00a7 1, 2, 3, 4, 1986; Ord. 843, \u00a7 8, 1977)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"cce0665f-cb18-4b19-a800-f656e0ac58ff","prev_id":null}]},{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/d7177efa-144a-41ec-a9e1-b30b0478d897","ref":{"parent":"768def6a-9047-4624-a01e-bd6b29396fd0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"212-18-216","docId":"75","text":"11.24.150 Parking Prohibited along Certain Streets.","id":"d7177efa-144a-41ec-a9e1-b30b0478d897","children":[{"path":"\/ccb0cd02-0dd5-407b-bffd-162d19236255\/768def6a-9047-4624-a01e-bd6b29396fd0\/d7177efa-144a-41ec-a9e1-b30b0478d897\/01a09a33-2a4a-4987-80c3-ac0b79df3d73","ref":{"parent":"d7177efa-144a-41ec-a9e1-b30b0478d897","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"212-18-216-11","docId":"75","text":"\u003Cp\u003ENo person shall stop, stand, or park any vehicle as defined in the Vehicle Code of California on any day on any of the following streets or portions of streets within the City, as set out in Table 11.24.150.\u003C\/p\u003E\u003Cp\u003E(Ord. 20-2210, \u00a7 1, 2020; Ord. 2006, 2007; Ord. 1990, 2006; Ord. 1968, 2005; Ord. 1859, 2000; Ord. 1857, (part), 2000; Ord. 1851, 2000; Ord. 1840, (part), 1999; Ord. 1836, 1999; Ord. 1806, 1999; Ord. 1743, 1996; Ord. 1741, 1996; Ord. 1729, 1996; Ord. 1727, 1996; Ord. 1724, (part), 1996; Ord. 1683, (part), 1995; Ord. 1605, 1992; Ord. 1589, 1992; Ord. 1578, 1992; Ord. 1577, 1992; Ord. 1564, 1991; Ord. 1562, 1991; Ord. 1553, 1991; Ord. 1547, (part), 1991; Ord. 1521, 1990; Ord. 1467, 1988; Ord. 1455, 1988; Ord. 1454, 1988; Ord. 1446, 1988; Ord. 1439, 1988; Ord. 1428, 1987; Ord. 1423, 1987; Ord. 1419, (part), 1987; Ord. 1409, (part), 1987; Ord. 1405, (part), 1987; Ord. 1397, 1987; Ord. 1395, 1986; Ord. 1390, (part), 1986; Ord. 1388, 1986; Ord. 1357, 1986; Ord. 1351, 1986; Ord. 1338, 1986; Ord. 1325, 1985; Ord. 1304, 1985; Ord. 1302, 1985; Ord. 1189, (part), 1984; Ord. 1285, 1984; Ord. 1276, (part), 1984; Ord. 1266, 1984; Ord. 1245, (part), 1983; Ord. 1221, 1983; Ord. 1218, 1983; Ord. 1203, (part), 1982; Ord. 1178, 1982; Ord. 1172, (part), 1982; Ord. 1170, 1982; Ord. 1156, 1982; Ord. 1152, (part), 1981; Ord. 1151, (part), 1981; Ord. 1148, 1981; Ord. 1140, 1981; Ord. 1129, 1981; Ord. 1124, (part), 1981; Ord. 1118, (part), 1981; Ord. 1115, 1981; Ord. 1097, 1981; Ord. 1072, 1980; Ord. 1069, 1980; Ord. 1058, 1980; Ord. 1025, 1980; Ord. 1001, 1980; Ord. 993, 1980; Ord. 992, 1980; Ord. 980, 1980; Ord. 971, (part),