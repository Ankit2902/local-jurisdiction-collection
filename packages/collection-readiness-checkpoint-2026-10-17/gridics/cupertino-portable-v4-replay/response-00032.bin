[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719","ref":{"name":"section"},"li_attr":{"dataTag":"section","hasChildren":1,"tag":"h2"},"pos":"13","docId":"75","text":"TITLE 2: ADMINISTRATION AND PERSONNEL","id":"b95149d7-031e-4cc1-a046-60a61417a719","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/ce854447-320b-462f-8539-1662386dd722","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"ce854447-320b-462f-8539-1662386dd722","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/64eb89b6-a94c-4a4c-b651-f5e904edde5b","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-12","docId":"75","text":"CHAPTER 2.04: CITY COUNCIL\u2013ELECTION AND MEETINGS*","id":"64eb89b6-a94c-4a4c-b651-f5e904edde5b","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/64eb89b6-a94c-4a4c-b651-f5e904edde5b\/924dc7ea-1429-4baa-84a3-b085e8ac9e88","ref":{"parent":"64eb89b6-a94c-4a4c-b651-f5e904edde5b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-12-11","docId":"75","text":"\u003Cp\u003E* For statutory provisions regarding the scheduling of City Council meetings, see Gov. Code \u00a7\u00a7 36805\u201436809\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"924dc7ea-1429-4baa-84a3-b085e8ac9e88","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/64eb89b6-a94c-4a4c-b651-f5e904edde5b\/d09976fc-5b99-4c3c-95d2-cfb8627a24b0","ref":{"parent":"64eb89b6-a94c-4a4c-b651-f5e904edde5b","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-12-12","docId":"75","text":"2.04.005 Elections.","id":"d09976fc-5b99-4c3c-95d2-cfb8627a24b0","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/64eb89b6-a94c-4a4c-b651-f5e904edde5b\/d09976fc-5b99-4c3c-95d2-cfb8627a24b0\/f2bc47d3-a1db-4650-a9d1-90a96bda8dc8","ref":{"parent":"d09976fc-5b99-4c3c-95d2-cfb8627a24b0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-12-12-11","docId":"75","text":"\u003Cp\u003EGeneral municipal elections shall he held on the first Tuesday after the first Monday in November of even-numbered years to coincide with the statewide general elections.\u003C\/p\u003E\u003Cp\u003E(Ord. 13-2106, \u00a7 4, 2013; Ord. 1697, (part), passed - -1995)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f2bc47d3-a1db-4650-a9d1-90a96bda8dc8","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/64eb89b6-a94c-4a4c-b651-f5e904edde5b\/cf0f9ec6-95a4-44a1-a28f-066321dbf730","ref":{"parent":"64eb89b6-a94c-4a4c-b651-f5e904edde5b","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-12-13","docId":"75","text":"2.04.010 Regular Meetings.","id":"cf0f9ec6-95a4-44a1-a28f-066321dbf730","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/64eb89b6-a94c-4a4c-b651-f5e904edde5b\/cf0f9ec6-95a4-44a1-a28f-066321dbf730\/8185bb9d-8c97-4d44-88e9-8f4baed16bf8","ref":{"parent":"cf0f9ec6-95a4-44a1-a28f-066321dbf730","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-12-13-11","docId":"75","text":"\u003Cp\u003EThe City Council shall hold regular meetings on the first and third Tuesdays of each month at six forty-five p.m. and may adjourn any regular meeting to a date certain, which shall be specified in the order of adjournment and when so adjourned, such adjourned meeting shall be a regular meeting for all purposes. Such adjourned meetings may likewise be adjourned and any so adjourned meeting shall be a regular meeting for all purposes. The City Council may cancel a regular meeting by a vote of a majority of the Council.\u003C\/p\u003E\u003Cp\u003EOn regular meeting days, the City Council shall reserve the time beginning at five-thirty p.m. for closed sessions.\u003C\/p\u003E\u003Cp\u003ECity Council meetings that fall on legal holidays shall automatically be moved to the following day and shall be regular meetings.\u003C\/p\u003E\u003Cp\u003ECity Council meetings that fall on any Election Tuesday in a regular Cupertino election year shall automatically be moved to the first Monday of the month and shall be regular meetings.\u003C\/p\u003E\u003Cp\u003E(Ord. 20-2214, 2020; Ord. 15-2137, \u00a7 1, 2015; Ord. 1958, 2005; Ord. 1941, 2004; Ord. 1822, (part), passed - -1999; Ord. 1015, passed - -1980; Ord. 978, (part), passed - -1980; Ord. 189(a), \u00a7 I, passed - -1970; Ord. 389, \u00a7 3.1, passed - -1968; Ord. 25-2271, \u00a7 1, 2025)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"8185bb9d-8c97-4d44-88e9-8f4baed16bf8","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/64eb89b6-a94c-4a4c-b651-f5e904edde5b\/0029e0f5-ca6d-43fa-a456-85f1358d310f","ref":{"parent":"64eb89b6-a94c-4a4c-b651-f5e904edde5b","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-12-14","docId":"75","text":"2.04.020 Special Meetings.","id":"0029e0f5-ca6d-43fa-a456-85f1358d310f","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/64eb89b6-a94c-4a4c-b651-f5e904edde5b\/0029e0f5-ca6d-43fa-a456-85f1358d310f\/bd4964c6-ee20-4cf0-90af-c5f7a8b55c32","ref":{"parent":"0029e0f5-ca6d-43fa-a456-85f1358d310f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-12-14-11","docId":"75","text":"\u003Cp\u003ESpecial meetings may be called at any time by the mayor or by three members of the City Council by delivering written notice to each member of the City Council and to each local newspaper of general circulation, radio and television station requesting notice in writing. The notice shall be delivered at least twenty-four hours before the time of the meeting as specified in the notice. The call and notice shall specify the time and place of the special meeting and the business to be transacted or discussed. No other business shall be considered at these meetings. The written notice may also be dispensed with as to any member of the City Council who at or prior to the time the meeting convenes, files with the City Clerk a written waiver of notice. The written notice may also be dispensed with as to any member of the City Council who is actually present at the meeting at the time it convenes.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), passed 1995; Ord. 389, \u00a7 3.2, passed 1968; Ord. 26-2284, Att. A (part), 2026)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"bd4964c6-ee20-4cf0-90af-c5f7a8b55c32","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/64eb89b6-a94c-4a4c-b651-f5e904edde5b\/1436bf89-9e0a-415d-823c-a5c6ccc2c09b","ref":{"parent":"64eb89b6-a94c-4a4c-b651-f5e904edde5b","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-12-15","docId":"75","text":"2.04.025 Emergency Meetings.","id":"1436bf89-9e0a-415d-823c-a5c6ccc2c09b","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/64eb89b6-a94c-4a4c-b651-f5e904edde5b\/1436bf89-9e0a-415d-823c-a5c6ccc2c09b\/7bdd87f1-1e3d-45f5-be8a-7959d3e55264","ref":{"parent":"1436bf89-9e0a-415d-823c-a5c6ccc2c09b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-12-15-11","docId":"75","text":"\u003Cp\u003EIn the case of an emergency situation involving matters upon which prompt action is necessary due to the description or threatened disruption of public facilities, the City Council may hold an emergency meeting without complying with either the twenty-four-hour notice requirement or the twenty-tour-hour posting requirement described in Section54956 of the California Government Code. An emergency meeting called under this section shall be otherwise conducted in conformance with Section 54956.5 of the California Government Code.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), passed 1995)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"7bdd87f1-1e3d-45f5-be8a-7959d3e55264","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/64eb89b6-a94c-4a4c-b651-f5e904edde5b\/6aa22ca2-8d91-4f90-bb87-5fd366c30e59","ref":{"parent":"64eb89b6-a94c-4a4c-b651-f5e904edde5b","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-12-16","docId":"75","text":"2.04.030 Place of Meetings.","id":"6aa22ca2-8d91-4f90-bb87-5fd366c30e59","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/64eb89b6-a94c-4a4c-b651-f5e904edde5b\/6aa22ca2-8d91-4f90-bb87-5fd366c30e59\/ca723dc9-c897-41b3-a1d3-38ee0bdfb359","ref":{"parent":"6aa22ca2-8d91-4f90-bb87-5fd366c30e59","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-12-16-11","docId":"75","text":"\u003Cp\u003EThe regular meetings shall convene in the Council Chamber, Cupertino Community Hall, 10350 Torre Avenue, Cupertino, California. All other meetings unless changed in the written notice of meeting or order of adjournment shall be held in the Council Chamber of the Cupertino Community Hall, Cupertino, California.\u003C\/p\u003E\u003Cp\u003E(Ord. 978, (part), passed 1980; Ord. 189, \u00a7 1.1, passed 1968; Ord. 1952, 2004)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"ca723dc9-c897-41b3-a1d3-38ee0bdfb359","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/64eb89b6-a94c-4a4c-b651-f5e904edde5b\/6b1ca69c-dd62-40ec-b5aa-0d9037699664","ref":{"parent":"64eb89b6-a94c-4a4c-b651-f5e904edde5b","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-12-17","docId":"75","text":"2.04.040 Vacancy.","id":"6b1ca69c-dd62-40ec-b5aa-0d9037699664","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/64eb89b6-a94c-4a4c-b651-f5e904edde5b\/6b1ca69c-dd62-40ec-b5aa-0d9037699664\/0b072054-a271-4357-8d45-fc3115662761","ref":{"parent":"6b1ca69c-dd62-40ec-b5aa-0d9037699664","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-12-17-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EIf any vacancy on the City Council occurs other than by expiration of a term, the City Council shall, at its option within thirty days from the commencement of the vacancy, either fill the vacancy by appointment for the unexpired term of the former incumbent, or call a special election to fill the vacancy. The special election shall be held on the next regularly established election date not less than one hundred fourteen days from the call of the special election.\u003C\/li\u003E\u003Cli\u003ENotwithstanding any other provision of this section, the City Council may appoint any person, otherwise qualified, to fill a City Council vacancy to hold office only until the date of a special election which is called to fill the remainder of the term pursuant to subsection A of this section.\u003C\/li\u003E\u003Cli\u003ENotwithstanding any other provision of this section, an appointment shall not be made to fill a vacancy on the City Council if the appointment would result in a majority of the members serving on the Council having been appointed. The vacancy shall be filled in one of the following ways\u003Col\u003E\u003Cli\u003EThe City Council may call an election to fill the vacancy to be held on the next regularly established election date not less than one hundred fourteen days after the call;\u003C\/li\u003E\u003Cli\u003EIf the City Council does not call an election pursuant to subsection B of this section, the vacancy shall be filled at the next regularly established election date.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1697, (part), passed 1995; Ord. 1017, passed 1991; Ord. 1026, \u00a7 1, passed 1980)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0b072054-a271-4357-8d45-fc3115662761","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/64eb89b6-a94c-4a4c-b651-f5e904edde5b\/e871cf6b-0ec1-43a4-a84e-743b8df0a834","ref":{"parent":"64eb89b6-a94c-4a4c-b651-f5e904edde5b","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-12-18","docId":"75","text":"2.04.050 Term Limits.","id":"e871cf6b-0ec1-43a4-a84e-743b8df0a834","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/64eb89b6-a94c-4a4c-b651-f5e904edde5b\/e871cf6b-0ec1-43a4-a84e-743b8df0a834\/e1826bf7-fc95-46cb-b2cf-f2a0c65e0fbe","ref":{"parent":"e871cf6b-0ec1-43a4-a84e-743b8df0a834","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-12-18-11","docId":"75","text":"\u003Cp\u003EThe service of city councilmembers shall be limited to two consecutive elected terms, for a maximum possible time (appointed and elected combined) of ten years and three hundred fifty-four days, after which they would not be eligible for election or appointment to a council seat for four years. (This section was adopted by a vote of the people November 4, 1997.)\u003C\/p\u003E\u003Cp\u003E(Ord. 1775, passed 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"e1826bf7-fc95-46cb-b2cf-f2a0c65e0fbe","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb3f4eab-fbe2-4f7b-951c-433afdf1cac4","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h3"},"pos":"13-13","docId":"75","text":"CHAPTER 2.06: (RESERVED)","id":"eb3f4eab-fbe2-4f7b-951c-433afdf1cac4","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb3f4eab-fbe2-4f7b-951c-433afdf1cac4\/924574eb-8089-4109-8bf5-e65d7a4e3617","ref":{"parent":"eb3f4eab-fbe2-4f7b-951c-433afdf1cac4","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-13-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"924574eb-8089-4109-8bf5-e65d7a4e3617","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-14","docId":"75","text":"CHAPTER 2.08: CITY COUNCIL--RULES AND CONDUCT OF MEETINGS*","id":"e756630d-6648-4edd-a67a-fd85ff12300a","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/a6959dd4-7ba2-4602-b8fd-5b276c23ea6a","ref":{"parent":"e756630d-6648-4edd-a67a-fd85ff12300a","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-14-11","docId":"75","text":"\u003Cp\u003E* For statutory provisions authorizing the City Council to establish rules for the conduct of its proceedings, see Gov. Code \u00a7 36813.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"a6959dd4-7ba2-4602-b8fd-5b276c23ea6a","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/43e86875-722f-41e7-833c-13ce58cc86ef","ref":{"parent":"e756630d-6648-4edd-a67a-fd85ff12300a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-14-12","docId":"75","text":"2.08.010 Reserved.","id":"43e86875-722f-41e7-833c-13ce58cc86ef","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/43e86875-722f-41e7-833c-13ce58cc86ef\/5b46d845-b467-4d69-892e-ec279ad253fa","ref":{"parent":"43e86875-722f-41e7-833c-13ce58cc86ef","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-14-12-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"5b46d845-b467-4d69-892e-ec279ad253fa","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/7b4a0a7a-6d71-41f2-b312-5ddb308808ba","ref":{"parent":"e756630d-6648-4edd-a67a-fd85ff12300a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-14-13","docId":"75","text":"2.08.030 Petition\u2013Defined.","id":"7b4a0a7a-6d71-41f2-b312-5ddb308808ba","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/7b4a0a7a-6d71-41f2-b312-5ddb308808ba\/3129ff80-e6d2-45f5-8d1a-77dc6b019f80","ref":{"parent":"7b4a0a7a-6d71-41f2-b312-5ddb308808ba","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-14-13-11","docId":"75","text":"\u003Cp\u003EFor the purpose of Sections 2.08.030 through 2.08.070, a \u201cpetition\u201d means any written communication signed with multiple signatures and which is delivered to the City Clerk for the attention of the City Council. Such petitions so received will be processed in the same manner as written communications.\u003C\/p\u003E\u003Cp\u003E(Ord. 673, (part), 1975; Ord. 49, \u00a7 1, 1958)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"3129ff80-e6d2-45f5-8d1a-77dc6b019f80","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/274c15d8-48b6-4ab0-8647-eb041e652f07","ref":{"parent":"e756630d-6648-4edd-a67a-fd85ff12300a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-14-14","docId":"75","text":"2.08.040 Petition\u2013Hearing Notice.","id":"274c15d8-48b6-4ab0-8647-eb041e652f07","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/274c15d8-48b6-4ab0-8647-eb041e652f07\/eaf94410-b938-46d2-bbae-9b806f09f9a0","ref":{"parent":"274c15d8-48b6-4ab0-8647-eb041e652f07","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-14-14-11","docId":"75","text":"\u003Cp\u003EThe City Council after having received a petition may, at its discretion, set a time for the holding of a public hearing thereon. Unless otherwise provided by law or any other ordinances of this City, there shall be no prescribed minimum or maximum interim period between the setting of said time and the holding of such public hearing.\u003C\/p\u003E\u003Cp\u003E(Ord. 673, (part), 1975; Ord. 49, \u00a7 2, 1958)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"eaf94410-b938-46d2-bbae-9b806f09f9a0","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/beb21544-3d9d-43dd-8878-7d3e0d17d2b8","ref":{"parent":"e756630d-6648-4edd-a67a-fd85ff12300a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-14-15","docId":"75","text":"2.08.070 Petition\u2013Exception.","id":"beb21544-3d9d-43dd-8878-7d3e0d17d2b8","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/beb21544-3d9d-43dd-8878-7d3e0d17d2b8\/d1e79423-1613-4f56-bbcf-8e5fa2550e42","ref":{"parent":"beb21544-3d9d-43dd-8878-7d3e0d17d2b8","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-14-15-11","docId":"75","text":"\u003Cp\u003ESections 2.08.030 through 2.08.070 shall not apply to any petition in which there is a prescribed method of publication or notice pursuant to law or any other ordinances of this City.\u003C\/p\u003E\u003Cp\u003E(Ord. 49, \u00a7 5, 1958)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d1e79423-1613-4f56-bbcf-8e5fa2550e42","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/707dd3dc-24f3-45ac-9462-4fd159c38579","ref":{"parent":"e756630d-6648-4edd-a67a-fd85ff12300a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-14-16","docId":"75","text":"2.08.080 Method of Presenting Matters to Council.","id":"707dd3dc-24f3-45ac-9462-4fd159c38579","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/707dd3dc-24f3-45ac-9462-4fd159c38579\/01d70252-1c00-4b63-8397-6685931a7892","ref":{"parent":"707dd3dc-24f3-45ac-9462-4fd159c38579","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-14-16-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EEvery official, board, commission or other body, connected with the City government, and every citizen, individual, corporation, committee or civic group, having any reports, communications or other matters to be presented at a City Council meeting, shall be referred to the City Clerk in writing before nine a.m. of the sixth day (Sunday included) preceding the day of such meeting for it to be given consideration as an item of agenda business.\u003C\/li\u003E\u003Cli\u003EThe City Clerk shall prepare an agenda setting forth such matters and the nature thereof under their appropriate headings, and setting forth all other matters to come before such meeting under their appropriate headings. The City Clerk shall, preceding such meetings, cause one copy thereof to be delivered to each member of the City Council and shall make such other copies available for public review as is consistent with State law.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 2081, (part), 2011; Ord. 1697, (part), 1995; Ord. 1292, 1984; Ord. 822, 1977; Ord. 673, (part), 1975; Ord. 389, \u00a7 3.4, 1968)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"01d70252-1c00-4b63-8397-6685931a7892","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/e52a2bbd-0950-4764-b92e-466d38b44411","ref":{"parent":"e756630d-6648-4edd-a67a-fd85ff12300a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-14-17","docId":"75","text":"2.08.090 Order of Business.","id":"e52a2bbd-0950-4764-b92e-466d38b44411","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/e52a2bbd-0950-4764-b92e-466d38b44411\/517eb3ce-0c7c-4d75-a913-0cc86b1ee4e3","ref":{"parent":"e52a2bbd-0950-4764-b92e-466d38b44411","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-14-17-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe City Council of the City shall establish the order of business by resolution.\u003C\/li\u003E\u003Cli\u003EThe order of business to be taken up at an adjourned meeting shall be that as deemed by the Mayor and the City Council to be proper.\u003C\/li\u003E\u003Cli\u003EThe City Council may, in its discretion, establish time limitations for the presentation or discussion of any item of business; and, may establish a time after which no agenda item of business will be taken up in which case the motion for adjournment will contain the date and time for the completion of agenda business.\u003C\/li\u003E\u003Cli\u003EClosed sessions may be held as needed and scheduled by the City Attorney.\u003C\/li\u003E\u003Cli\u003ECouncil may change the order of business at any individual council meeting by majority vote.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 2081, (part), 2011; Ord. 1697, (part), 1995; Ord. 1561, 1991; Ord. 1457, 1988; Ord. 1393, 1986; Ord. 1329, 1985; Ord. 1259, 1984; Ord. 1192, 1982; Ord. 1133, 1981; Ord. 978, (part), 1980; Ord. 673, (part), 1975; Ord. 389, \u00a7 3.5, 1968)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"517eb3ce-0c7c-4d75-a913-0cc86b1ee4e3","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/750b3ad3-295c-447e-9fc9-a9fdc4d2bb3e","ref":{"parent":"e756630d-6648-4edd-a67a-fd85ff12300a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-14-18","docId":"75","text":"2.08.095 Reconsideration.","id":"750b3ad3-295c-447e-9fc9-a9fdc4d2bb3e","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/750b3ad3-295c-447e-9fc9-a9fdc4d2bb3e\/c9686c28-0782-4001-9764-910167e64245","ref":{"parent":"750b3ad3-295c-447e-9fc9-a9fdc4d2bb3e","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-14-18-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe Council may, at any time before adjournment of any council meeting, determine to reconsider an item of business previously acted upon at that council meeting. A motion to reconsider may only be made by a councilmember who was a member of the prevailing majority voting on the item. A motion to reconsider may be seconded by any councilmember.\u003C\/li\u003E\u003Cli\u003EIf a motion for reconsideration prevails, the Council is then free to reconsider the item either at the same Council meeting or at any other Council meeting established by the Council; provided, however, that the Council shall not reconsider an item at the same Council meeting, in the following instances:\u003Col\u003E\u003Cli\u003EAny action involving a public hearing which has been closed;\u003C\/li\u003E\u003Cli\u003EAny action, including appeals, regarding a zoning matter, planned development permit, use permit, subdivision map approval, variance, architectural and site approval or sign exception;\u003C\/li\u003E\u003Cli\u003EAny action involving the granting, modification or revocation of any permit issued by the City;\u003C\/li\u003E\u003Cli\u003EAny action which is quasi-judicial in nature.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EIn such cases, the Council shall reconsider the item at another council meeting date established by the Council and shall direct the City Clerk to provide notification to the relevant parties or the general public, as the case may be.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 2056, (part), 2010; Ord. 1697, (part), 1995; Ord. 1378, \u00a7 1, 1986)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"c9686c28-0782-4001-9764-910167e64245","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/33677ecd-a617-4463-9bae-496249af18f1","ref":{"parent":"e756630d-6648-4edd-a67a-fd85ff12300a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-14-19","docId":"75","text":"2.08.096 Reconsideration\u2013Sought by Interested Person.","id":"33677ecd-a617-4463-9bae-496249af18f1","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/33677ecd-a617-4463-9bae-496249af18f1\/9b0abc47-fce5-4b6f-9bd4-e64cea56dab7","ref":{"parent":"33677ecd-a617-4463-9bae-496249af18f1","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-14-19-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe City Clerk shall forthwith mail all notices of decision after the decision of the City Council. Any interested person, prior to seeking judicial review of any adjudicatory decision of the City Council, shall file a petition for reconsideration with the City Clerk within ten days of the date of the mailing of the notice of decision. Failure to file a petition for reconsideration constitutes a waiver of the right to request reconsideration and the City Council\u0027s decision shall be final for all purposes. Upon timely receipt of a petition for reconsideration, the City Clerk shall schedule a reconsideration hearing to be commenced by the City Council no later than sixty days after the filing of the petition. Mailed notices of the date, time and place of such hearing will be provided to all interested persons at least ten days prior to the hearing. At the conclusion of the hearing for reconsideration, the City Council may affirm, reverse, or modify its original decision, and may adopt additional findings of fact based upon the evidence submitted in any and all city hearings concerning the matter.\u003C\/li\u003E\u003Cli\u003EA petition for reconsideration shall specify, in detail, each and every ground for reconsideration. Failure of a petition to specify any particular ground or grounds for reconsideration, precludes that particular omitted ground or grounds from being raised or litigated in a subsequent judicial proceeding.\u003Cbr\u003E\n\u003Cbr\u003E\nThe grounds for reconsideration are limited to the following:\u003Col\u003E\u003Cli\u003EAn offer of new relevant evidence which, in the exercise of reasonable diligence, could not have been produced at any earlier city hearing.\u003C\/li\u003E\u003Cli\u003EAn offer of relevant evidence which was improperly excluded at any prior city hearing.\u003C\/li\u003E\u003Cli\u003EProof of facts which demonstrate that the City Council proceeded without, or in excess of its, jurisdiction.\u003C\/li\u003E\u003Cli\u003EProof of facts which demonstrate that the City Council failed to provide a fair hearing.\u003C\/li\u003E\u003Cli\u003EProof of facts which demonstrate that the City Council abused its discretion by:\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\u003Cli\u003ENot preceding in a manner required by law; and\/or\u003C\/li\u003E\u003Cli\u003ERendering a decision which was not supported by findings of fact; and\/or\u003C\/li\u003E\u003Cli\u003ERendering a decision in which the findings of fact were not supported by the evidence.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EA petition for reconsideration is subject to a reconsideration fee as prescribed by resolution of the City Council. At the conclusion of the reconsideration hearing, the City Council may, in its sole discretion, refund all, or a portion, of the reconsideration fee.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 2027 \u00a7 1, 2008; Ord. 2008, 2007; Ord. 1807, \u00a7 1, 1999)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"9b0abc47-fce5-4b6f-9bd4-e64cea56dab7","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/7d4d03b6-e50b-44f3-bb67-05e3b06b5675","ref":{"parent":"e756630d-6648-4edd-a67a-fd85ff12300a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-14-210","docId":"75","text":"2.08.100 Written Communications.","id":"7d4d03b6-e50b-44f3-bb67-05e3b06b5675","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/7d4d03b6-e50b-44f3-bb67-05e3b06b5675\/ce3788c4-cf28-4800-87dc-80e1ff682cd5","ref":{"parent":"7d4d03b6-e50b-44f3-bb67-05e3b06b5675","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-14-210-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EWritten communications transmitted to a majority of the members of the City Council by any person in connection with a matter which is subject to discussion or consideration at a meeting of the City Council shall be delivered by the recipient Councilperson to the City Clerk who shall retain them as public records and shall otherwise treat them as written communications to the City Council.\u003C\/li\u003E\u003Cli\u003EWritten communications addressed to the City Council and delivered to the City Clerk shall be transmitted to each City Councilperson, the City Manager, and any department director having responsibility for the subject matter of the communication. Written communications which are relevant to a matter subject to being discussed or considered at a City Council meeting shall be included as supplementary material to that agendized matter. Other written communications may be placed on the agenda, as a separate item of business under written communications, by a Councilperson, City Manager or any department director having responsibility for the subject matter of the communication.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. 673, (part), 1975; Ord. 389, \u00a7 3.6, 1968)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"ce3788c4-cf28-4800-87dc-80e1ff682cd5","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/5c35a5d6-dc58-46d4-9f62-8b33a8beb98d","ref":{"parent":"e756630d-6648-4edd-a67a-fd85ff12300a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-14-211","docId":"75","text":"2.08.105 Oral Communications.","id":"5c35a5d6-dc58-46d4-9f62-8b33a8beb98d","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/5c35a5d6-dc58-46d4-9f62-8b33a8beb98d\/165386a8-0ac6-42bc-97cb-8adfdd3688a2","ref":{"parent":"5c35a5d6-dc58-46d4-9f62-8b33a8beb98d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-14-211-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EEvery agenda for regular meetings of the City Council shall provide an opportunity for members of the public to address the council on any item of interest to the public that is within the city\u2019s jurisdiction. With respect to any such item which is already on the agenda, members of the public shall be given the opportunity to address the City Council during its consideration of the item.\u003C\/li\u003E\u003Cli\u003EWhere a member of the public raises an issue which has not yet come before the City Council, no action may be taken at that meeting concerning that item.\u003C\/li\u003E\u003Cli\u003EWith respect to all oral communications, the mayor may establish reasonable time limits for public testimony on particular issues and for each individual speaker. Preference shall be given to those who previously have notified the City Clerk in advance of their desire to speak.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1697, (part), 1995)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"165386a8-0ac6-42bc-97cb-8adfdd3688a2","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/cb9156f2-b403-469b-83a1-d3a022c1bb3b","ref":{"parent":"e756630d-6648-4edd-a67a-fd85ff12300a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-14-212","docId":"75","text":"2.08.110 Reports of Officers and Official Bodies.","id":"cb9156f2-b403-469b-83a1-d3a022c1bb3b","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/cb9156f2-b403-469b-83a1-d3a022c1bb3b\/9c5a8b3d-e5ea-4825-b8af-392002fa6f7f","ref":{"parent":"cb9156f2-b403-469b-83a1-d3a022c1bb3b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-14-212-11","docId":"75","text":"\u003Cp\u003EOfficial boards, commissions or other bodies connected with the City government may, in addition to any written report submitted, and shall, on request of the Mayor, address the City Council through its chairman or authorized representative on matters relating to their assigned functions.\u003C\/p\u003E\u003Cp\u003E(Ord. 389, \u00a7 3.7, 1968)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"9c5a8b3d-e5ea-4825-b8af-392002fa6f7f","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/bb050cef-86b4-45dd-a50c-0705a06b3a7d","ref":{"parent":"e756630d-6648-4edd-a67a-fd85ff12300a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-14-213","docId":"75","text":"2.08.130 Discussion Procedure.","id":"bb050cef-86b4-45dd-a50c-0705a06b3a7d","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/bb050cef-86b4-45dd-a50c-0705a06b3a7d\/89464ed6-b169-4cfb-864e-104654433702","ref":{"parent":"bb050cef-86b4-45dd-a50c-0705a06b3a7d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-14-213-11","docId":"75","text":"\u003Cp\u003EWhile discussing any question under consideration by the Council, it shall be the duty of the members thereof to remain seated and address their remarks to the presiding officer and their fellow members. Any remarks or orders to the audience shall be addressed by the presiding officer, or with his permission by the members of the Council.\u003C\/p\u003E\u003Cp\u003E(Ord. 389, \u00a7 3.9, 1968)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"89464ed6-b169-4cfb-864e-104654433702","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/42a506c5-880a-4c0f-990c-5bd7e806ff2b","ref":{"parent":"e756630d-6648-4edd-a67a-fd85ff12300a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-14-214","docId":"75","text":"2.08.135 Designation of Signators for Official Documents.","id":"42a506c5-880a-4c0f-990c-5bd7e806ff2b","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/42a506c5-880a-4c0f-990c-5bd7e806ff2b\/7f88455d-7b49-4264-a2c0-374cea098a33","ref":{"parent":"42a506c5-880a-4c0f-990c-5bd7e806ff2b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-14-214-11","docId":"75","text":"\u003Cp\u003EAfter Council approval of a document, when necessary to expedite processing of said document, if the Mayor or Vice-Mayor is unavailable for signature, any other Councilmember may sign the document as an official of the City.\u003C\/p\u003E\u003Cp\u003E(Ord. 1119, 1981)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"7f88455d-7b49-4264-a2c0-374cea098a33","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/812f8412-9087-4ab8-a185-3885772604da","ref":{"parent":"e756630d-6648-4edd-a67a-fd85ff12300a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-14-215","docId":"75","text":"2.08.140 Violation\u2013Penalty.","id":"812f8412-9087-4ab8-a185-3885772604da","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/812f8412-9087-4ab8-a185-3885772604da\/2cfa9142-9b21-4220-b3ca-7e41deea13ef","ref":{"parent":"812f8412-9087-4ab8-a185-3885772604da","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-14-215-11","docId":"75","text":"\u003Cp\u003EAny person in the audience who, while in attendance at any Council meeting, uses profane language, or language tending to bring the Council or any of its members into contempt, or any person who persistently interrupts the proceedings of the Council, or refuses to be seated or keep quiet when ordered to do so by the presiding officer, or refuses to leave the room or premises, shall be deemed guilty of a misdemeanor, and upon conviction thereof, shall be punished as provided in Chapter 1.12.\u003C\/p\u003E\u003Cp\u003E(Ord. 389, \u00a7 4, 1968)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"2cfa9142-9b21-4220-b3ca-7e41deea13ef","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/cc91e3bd-34ed-46c2-bd2e-eb0c1f544969","ref":{"parent":"e756630d-6648-4edd-a67a-fd85ff12300a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-14-216","docId":"75","text":"2.08.145 Call for Council Review.","id":"cc91e3bd-34ed-46c2-bd2e-eb0c1f544969","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e756630d-6648-4edd-a67a-fd85ff12300a\/cc91e3bd-34ed-46c2-bd2e-eb0c1f544969\/2fab2847-893a-4f8d-a447-eb1951673995","ref":{"parent":"cc91e3bd-34ed-46c2-bd2e-eb0c1f544969","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-14-216-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EAny Councilmember may initiate a call for Council review of any decision or matter that may be appealed to the City Council under this Code.\u003C\/li\u003E\u003Cli\u003EFiling.\u003Col\u003E\u003Cli\u003EA call for Council review shall be in writing on forms prescribed by the City and shall be filed during regular office hours. A call for Council review is subject to the same time limitations as required for an appeal for a decision. A call for Council review not filed within such time shall be barred.\u003C\/li\u003E\u003Cli\u003EA call for Council review is not subject to a fee.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003ENoticing. Notice of a hearing shall be given in the same manner as would be required in an appeal of the matter.\u003C\/li\u003E\u003Cli\u003EGrounds. If a call for Council review is made by a Councilmember, there is a presumption that the reason for the review is that the action has significant or material effects on the quality of life within Cupertino. No interference of bias shall be made or implied due to a call for Council review by a Councilmember, and the Councilmember who filed the call for Council review may participate in the hearing on the matter.\u003C\/li\u003E\u003Cli\u003EHearing body. The City Council shall decide the matter on review in accordance with the provisions of this Code.\u003C\/li\u003E\u003Cli\u003EDecision of the City Council. The decision or determination of the City Council shall be final and effective immediately.\u003C\/li\u003E\u003Cli\u003ENotice of decision. Notice of the City Council\u2019s decision shall be mailed to the original applicant and to any other person who has filed a written request with the City Clerk.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 14-2123, \u00a7 1, 2014)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"2fab2847-893a-4f8d-a447-eb1951673995","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-15","docId":"75","text":"CHAPTER 2.12: INTRODUCTION AND PASSAGE OF ORDINANCES*","id":"5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5\/a38a9c86-6796-4480-a39c-fbb2e7a8e400","ref":{"parent":"5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-15-11","docId":"75","text":"\u003Cp\u003E* For statutory provisions regarding enactment of ordinances, see Gov. Code \u00a7\u00a7 36931--36937.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"a38a9c86-6796-4480-a39c-fbb2e7a8e400","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5\/299bb71c-a645-447b-a292-f8cdc79c78d6","ref":{"parent":"5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-15-12","docId":"75","text":"2.12.010 Publication.","id":"299bb71c-a645-447b-a292-f8cdc79c78d6","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5\/299bb71c-a645-447b-a292-f8cdc79c78d6\/bc9457d0-65e3-4abd-a996-9c2fbd781839","ref":{"parent":"299bb71c-a645-447b-a292-f8cdc79c78d6","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-15-12-11","docId":"75","text":"\u003Cp\u003EWithin fifteen days after its passage, the City Clerk shall cause each ordinance to be published at least once in a newspaper of general circulation published and circulated in the City, or if there is none, shall cause it to be posted in at least three public places in the City or published in a newspaper of general circulation printed and published in the County and circulated in the City.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. 907, 1978; Ord. 578, \u00a7 1, 1973; Ord. 389, \u00a7 2.1, 1968)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"bc9457d0-65e3-4abd-a996-9c2fbd781839","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5\/e3096e2a-211e-4ca1-a907-3c638af52807","ref":{"parent":"5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-15-13","docId":"75","text":"2.12.020 Time of Passage\u2013Reading\u2013Urgency Ordinances\u2013Alterations.","id":"e3096e2a-211e-4ca1-a907-3c638af52807","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5\/e3096e2a-211e-4ca1-a907-3c638af52807\/db6c3bfe-59f3-4469-ad9e-7faee42ab1f7","ref":{"parent":"e3096e2a-211e-4ca1-a907-3c638af52807","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-15-13-11","docId":"75","text":"\u003Cp\u003EOrdinances, other than an urgency ordinance, where ordinances are required by law, and resolutions granting franchises shall not be passed within five days of their introduction, nor at other than a regular meeting. Except when further reading is waived by regular motion adopted by a majority vote of the Council present after reading of the title, ordinances shall be read in full. When ordinances, other than urgency ordinances, are altered after introduction, they shall be passed only at a regular meeting held at least five days after alteration. Corrections of a typographical or clerical error are not alterations within the meaning of this section.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. 1225, 1983; Ord. 578, \u00a7 2, 1973; Ord. 389, \u00a7 2.2, 1968)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"db6c3bfe-59f3-4469-ad9e-7faee42ab1f7","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5\/4aa03f56-a32b-4eb6-b0bd-7d6ab3a209a1","ref":{"parent":"5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-15-14","docId":"75","text":"2.12.030 Resolutions for Payment of Money\u2013Time of Adoption.","id":"4aa03f56-a32b-4eb6-b0bd-7d6ab3a209a1","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5\/4aa03f56-a32b-4eb6-b0bd-7d6ab3a209a1\/42b9aa3d-2d5a-4f83-8ade-5fb54b2a5bdd","ref":{"parent":"4aa03f56-a32b-4eb6-b0bd-7d6ab3a209a1","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-15-14-11","docId":"75","text":"\u003Cp\u003EResolutions or orders for the payment of money shall be adopted at a regular meeting or at a special meeting for which notice of such special meeting specifies the business to be transacted.\u003C\/p\u003E\u003Cp\u003E(Ord. 578, \u00a7 3, 1973; Ord. 389, \u00a7 2.3, 1968)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"42b9aa3d-2d5a-4f83-8ade-5fb54b2a5bdd","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5\/3b68af9e-5c8e-46b5-a38b-29821b2773db","ref":{"parent":"5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-15-15","docId":"75","text":"2.12.040 Vote Required.","id":"3b68af9e-5c8e-46b5-a38b-29821b2773db","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5\/3b68af9e-5c8e-46b5-a38b-29821b2773db\/4b302c32-bf65-4922-a8b1-2576b3669be2","ref":{"parent":"3b68af9e-5c8e-46b5-a38b-29821b2773db","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-15-15-11","docId":"75","text":"\u003Cp\u003EAll ordinances, resolutions, and orders for payment of money, require the votes of at least three Councilmembers for passage.\u003C\/p\u003E\u003Cp\u003E(Ord. 15-2136, \u00a7 1, 2015; Ord. 1219, 1983; Ord. 389, \u00a7 2.4, 1968)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"4b302c32-bf65-4922-a8b1-2576b3669be2","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5\/1be62271-21ae-4a9d-89af-6e338ebdfc4f","ref":{"parent":"5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-15-16","docId":"75","text":"2.12.050 Effective Date.","id":"1be62271-21ae-4a9d-89af-6e338ebdfc4f","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5\/1be62271-21ae-4a9d-89af-6e338ebdfc4f\/cc443841-cd17-45b7-b7aa-15dcc6a3e944","ref":{"parent":"1be62271-21ae-4a9d-89af-6e338ebdfc4f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-15-16-11","docId":"75","text":"\u003Cp\u003EOrdinances take effect thirty days after their final passage. An ordinance takes effect immediately, if it is an ordinance:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ERelating to an election;\u003C\/li\u003E\u003Cli\u003EFor the immediate preservation of the public peace, health or safety, containing a declaration of the facts constituting the urgency, and is passed by a four-fifths vote of the City Council;\u003C\/li\u003E\u003Cli\u003ERelating to street improvement proceedings;\u003C\/li\u003E\u003Cli\u003EFixing the amount of money to be raised by taxation, or the rate of taxes to be levied;\u003C\/li\u003E\u003Cli\u003ECovered by particular provisions of law prescribing the manner of its passage and adoption (Gov. Code 36937).\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 389, \u00a7 2.5, 1968)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"cc443841-cd17-45b7-b7aa-15dcc6a3e944","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5\/00726a51-9869-4f48-9b2d-9b1c4324f0a9","ref":{"parent":"5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-15-17","docId":"75","text":"2.12.060 Real Property Description.","id":"00726a51-9869-4f48-9b2d-9b1c4324f0a9","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5\/00726a51-9869-4f48-9b2d-9b1c4324f0a9\/afab0e78-4b9f-4636-bab3-fb2682fd6e16","ref":{"parent":"00726a51-9869-4f48-9b2d-9b1c4324f0a9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-15-17-11","docId":"75","text":"\u003Cp\u003EResolutions and ordinances containing legal descriptions of real property shall describe such property in general terms by a reference to area, streets \u201cbounded by\u201d and natural boundaries. In addition thereto, there shall be attached as \u201cExhibit A\u201d a metes and bounds description and map. Exhibit \u201cA\u201d shall not be read except on motion duly made and passed by the majority of the councilmen present. In the event of discrepancy in the description, the map shall prevail.\u003C\/p\u003E\u003Cp\u003E(Ord. 389, \u00a7 2.6, 1968)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"afab0e78-4b9f-4636-bab3-fb2682fd6e16","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5\/2c66e32e-61fa-4442-a898-709e97e092cb","ref":{"parent":"5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-15-18","docId":"75","text":"2.12.070 Official Forms.","id":"2c66e32e-61fa-4442-a898-709e97e092cb","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5f1d7f99-8e1f-41a6-8fa5-deb7d4f498c5\/2c66e32e-61fa-4442-a898-709e97e092cb\/2d48078f-8a70-4796-ba29-b2fd94543394","ref":{"parent":"2c66e32e-61fa-4442-a898-709e97e092cb","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-15-18-11","docId":"75","text":"\u003Cp\u003EResolutions duly adopted as official forms of the City shall be read by title only.\u003C\/p\u003E\u003Cp\u003E(Ord. 389, \u00a7 2.7, 1968)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"2d48078f-8a70-4796-ba29-b2fd94543394","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5762673e-0c7c-4938-9764-7f57fc04cf8e","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-16","docId":"75","text":"CHAPTER 2.16: CITY COUNCIL--SALARIES*","id":"5762673e-0c7c-4938-9764-7f57fc04cf8e","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5762673e-0c7c-4938-9764-7f57fc04cf8e\/e75d39c8-4791-43f5-9315-18ef73f379db","ref":{"parent":"5762673e-0c7c-4938-9764-7f57fc04cf8e","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-16-11","docId":"75","text":"\u003Cp\u003E* For statutory provisions regarding salary schedules for city councilmen, see Gov. Code \u00a7 36516.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"e75d39c8-4791-43f5-9315-18ef73f379db","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5762673e-0c7c-4938-9764-7f57fc04cf8e\/58b27b7b-2053-4855-9dda-766b7f2a5d9d","ref":{"parent":"5762673e-0c7c-4938-9764-7f57fc04cf8e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-16-12","docId":"75","text":"2.16.010 Statutory Basis.","id":"58b27b7b-2053-4855-9dda-766b7f2a5d9d","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5762673e-0c7c-4938-9764-7f57fc04cf8e\/58b27b7b-2053-4855-9dda-766b7f2a5d9d\/74145dd7-d0ce-4419-9df6-6b8ec7ed235f","ref":{"parent":"58b27b7b-2053-4855-9dda-766b7f2a5d9d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-16-12-11","docId":"75","text":"\u003Cp\u003ESection 36516 of the Government Code of the State authorizes the City Council to enact an ordinance providing that each member of the City Council receive a salary in accordance with a schedule set forth in said section.\u003C\/p\u003E\u003Cp\u003E(Ord. 1985, (part), 2006; Ord. 1881, (part), 2001; Ord. 1832, (part), 1999; Ord. 1792, (part), 1998; Ord. 1728, (part), 1996; Ord. 1660, (part), 1994; Ord. 393, \u00a7 1, 1969)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"74145dd7-d0ce-4419-9df6-6b8ec7ed235f","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5762673e-0c7c-4938-9764-7f57fc04cf8e\/af107172-d894-4e1f-b274-b689ff67adcc","ref":{"parent":"5762673e-0c7c-4938-9764-7f57fc04cf8e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-16-13","docId":"75","text":"2.16.020 Amount of Salary\u2013Effective Date.","id":"af107172-d894-4e1f-b274-b689ff67adcc","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5762673e-0c7c-4938-9764-7f57fc04cf8e\/af107172-d894-4e1f-b274-b689ff67adcc\/377b11af-6c88-486b-bb90-1e2c6756ec33","ref":{"parent":"af107172-d894-4e1f-b274-b689ff67adcc","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-16-13-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EEach member of the City Council shall receive a salary of six hundred, eighteen dollars and eighty-five cents per month, or fraction thereof.\u003C\/li\u003E\u003Cli\u003EUpon beginning a new term of office for a Councilmember, the Council shall receive a salary of seven hundred, thirty dollars and twenty-four cents per month, or fraction thereof.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1985, (part), 2006; Ord. 1881, (part), 2001; Ord. 1832, (part), 1999; Ord. 1792, (part), 1998; Ord. 1728, (part), 1996; Ord. 1660, (part), 1994; Ord. 1487, 1989; Ord. 1402, 1987; Ord. 1281, 1984; Ord. 977, 1980; Ord. 721, \u00a7 1, 1976; Ord. 393, \u00a7 5, 1969)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"377b11af-6c88-486b-bb90-1e2c6756ec33","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5762673e-0c7c-4938-9764-7f57fc04cf8e\/63e2ae4d-8e59-46f1-8ffd-48fc441bfa10","ref":{"parent":"5762673e-0c7c-4938-9764-7f57fc04cf8e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-16-14","docId":"75","text":"2.16.030 Reimbursement.","id":"63e2ae4d-8e59-46f1-8ffd-48fc441bfa10","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5762673e-0c7c-4938-9764-7f57fc04cf8e\/63e2ae4d-8e59-46f1-8ffd-48fc441bfa10\/6e0d2cd2-e836-428f-8b29-c42ed23ef687","ref":{"parent":"63e2ae4d-8e59-46f1-8ffd-48fc441bfa10","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-16-14-11","docId":"75","text":"\u003Cp\u003EThe salaries prescribed herein are and shall be exclusive of any amounts payable to each member of the Council as reimbursement for actual and necessary expenses incurred by him\/her in the performance of official duties for the City.\u003C\/p\u003E\u003Cp\u003E(Ord. 1985, (part), 2006; Ord. 1881, (part), 2001; Ord. 1832, (part), 1999; Ord. 1792, (part), 1998; Ord. 1728, (part), 1996; Ord. 1660, (part), 1994; Ord. 326, \u00a7 5, 1966)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"6e0d2cd2-e836-428f-8b29-c42ed23ef687","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-17","docId":"75","text":"CHAPTER 2.17: CITY COUNCIL\/CITY STAFF RELATIONSHIPS","id":"b016b52d-2d4a-4373-8b4f-24897fb0b69e","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/b67f476d-a4e1-4b5e-af48-d9ea4626a9e7","ref":{"parent":"b016b52d-2d4a-4373-8b4f-24897fb0b69e","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-17-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"b67f476d-a4e1-4b5e-af48-d9ea4626a9e7","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/1de00c7f-c898-42bf-ac72-6b124d4e9de3","ref":{"parent":"b016b52d-2d4a-4373-8b4f-24897fb0b69e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-17-12","docId":"75","text":"2.17.010 Preamble.","id":"1de00c7f-c898-42bf-ac72-6b124d4e9de3","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/1de00c7f-c898-42bf-ac72-6b124d4e9de3\/0f545775-1430-47f7-a089-bf5b024d7e68","ref":{"parent":"1de00c7f-c898-42bf-ac72-6b124d4e9de3","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-17-12-11","docId":"75","text":"\u003Cp\u003EAfter the City of Cupertino\u0027s incorporation, the City Council enacted Ordinance No. 106 creating and establishing the Council\/City Manager form of government whereby the City Council controls the administrative services of the City only through the City Manager. The Council\/Manager form of government is intended to provide the best of unencumbered professional\/technical staff input balanced with the collective oversight of elected officials. Under the Council\/Manager form of government neither the City Council, nor individual Council members, can give orders to any subordinates of the City Manager. The City Manager takes his or her orders and instructions from the City Council only when given at a duly held meeting of the City Council. No individual council member can give any orders or instructions to the City Manager. Although this provision has worked well over the years, a number of specific issues and questions have arisen from time to time regarding the respective roles of the City Council and City Manager due, in part, to the City\u0027s expanding involvement into a variety of new areas of society. It therefore has become necessary and convenient for the City Council to delineate with more specificity the respective roles of City Manager, the City Council and individual Council members.\u003C\/p\u003E\u003Cp\u003E(Ord. 2009, 2007)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0f545775-1430-47f7-a089-bf5b024d7e68","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/30ce0071-d269-4166-8fc4-57afdfcca134","ref":{"parent":"b016b52d-2d4a-4373-8b4f-24897fb0b69e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-17-13","docId":"75","text":"2.17.020 Intent and Purpose.","id":"30ce0071-d269-4166-8fc4-57afdfcca134","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/30ce0071-d269-4166-8fc4-57afdfcca134\/46423552-7623-41b8-ae51-b4ee4e0bd3f5","ref":{"parent":"30ce0071-d269-4166-8fc4-57afdfcca134","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-17-13-11","docId":"75","text":"\u003Cp\u003EThe intent of this chapter is to address and clarify the relationship between the City Council, individual Council members, and city staff by:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EMaintaining control and direction of the City by the City Council as a whole;\u003C\/li\u003E\u003Cli\u003EInsuring that City Council members have free access to the flow of any information relative to the operation of the City and insuring that such information is communicated by staff in full and with candor to the Council;\u003C\/li\u003E\u003Cli\u003EEnsuring that the Council decision making process benefits from the unencumbered input and advice from the professional staff free from undue influence in staff decision making, formation of staff recommendations, scheduling of work, and executing department priorities without intervention by individual Council members;\u003C\/li\u003E\u003Cli\u003EAllowing city staff to execute priorities given by management and the City Council and protecting city staff from undue influence from individual Council members.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 2009, 2007)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"46423552-7623-41b8-ae51-b4ee4e0bd3f5","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/7daf6ab8-2ebd-4ec4-b186-7fb13cc6dc25","ref":{"parent":"b016b52d-2d4a-4373-8b4f-24897fb0b69e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-17-14","docId":"75","text":"2.17.030 Council and Council members.","id":"7daf6ab8-2ebd-4ec4-b186-7fb13cc6dc25","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/7daf6ab8-2ebd-4ec4-b186-7fb13cc6dc25\/7a856bab-e95e-4e99-acf6-146d1e93ba15","ref":{"parent":"7daf6ab8-2ebd-4ec4-b186-7fb13cc6dc25","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-17-14-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"7a856bab-e95e-4e99-acf6-146d1e93ba15","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/6da137de-5aff-461f-b477-a971193f5ce6","ref":{"parent":"b016b52d-2d4a-4373-8b4f-24897fb0b69e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-17-15","docId":"75","text":"2.17.031 Council Power.","id":"6da137de-5aff-461f-b477-a971193f5ce6","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/6da137de-5aff-461f-b477-a971193f5ce6\/d490b6a6-8b8e-4b89-aa15-750dbfad6d6b","ref":{"parent":"6da137de-5aff-461f-b477-a971193f5ce6","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-17-15-11","docId":"75","text":"\u003Cp\u003EThe City Council retains the full power to accept, reject, amend, or otherwise guide and direct staff actions, decisions, recommendations, workloads and schedules, department priorities, and the conduct of city business through the office of the City Manager. This power cannot be delegated to individual Council members, nor to committees composed of council members consisting of less than a quorum of the City Council.\u003C\/p\u003E\u003Cp\u003E(Ord. 2009, 2007)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d490b6a6-8b8e-4b89-aa15-750dbfad6d6b","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/21b2c414-5bfd-4d5f-a3f9-95be644e0e79","ref":{"parent":"b016b52d-2d4a-4373-8b4f-24897fb0b69e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-17-16","docId":"75","text":"2.17.032 Individual Council members.","id":"21b2c414-5bfd-4d5f-a3f9-95be644e0e79","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/21b2c414-5bfd-4d5f-a3f9-95be644e0e79\/4bed7cb3-98d8-4da0-9d37-81bb27ad52c8","ref":{"parent":"21b2c414-5bfd-4d5f-a3f9-95be644e0e79","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-17-16-11","docId":"75","text":"\u003Cp\u003EIndividual Council members shall not attempt to influence staff decisions, recommendations, workloads, and schedules, and department priorities without prior knowledge and approval of the City Council.\u003C\/p\u003E\u003Cp\u003E(Ord. 2009, 2007)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"4bed7cb3-98d8-4da0-9d37-81bb27ad52c8","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/ccb09cd1-15ee-4499-93b0-3768cf86a5c7","ref":{"parent":"b016b52d-2d4a-4373-8b4f-24897fb0b69e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-17-17","docId":"75","text":"2.17.033 Council Policy.","id":"ccb09cd1-15ee-4499-93b0-3768cf86a5c7","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/ccb09cd1-15ee-4499-93b0-3768cf86a5c7\/fd814dd1-cdb0-4225-a6ca-a1a582b0ab2b","ref":{"parent":"ccb09cd1-15ee-4499-93b0-3768cf86a5c7","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-17-17-11","docId":"75","text":"\u003Cp\u003EIf a Council member wishes to influence the actions, decisions, recommendations, workloads, work schedules and priorities of staff, that member must prevail upon the City Council to do so as a matter of council policy.\u003C\/p\u003E\u003Cp\u003E(Ord. 2009, 2007)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"fd814dd1-cdb0-4225-a6ca-a1a582b0ab2b","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/e14b4233-203c-4b1a-a5fd-945b71c655d1","ref":{"parent":"b016b52d-2d4a-4373-8b4f-24897fb0b69e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-17-18","docId":"75","text":"2.17.034 Information.","id":"e14b4233-203c-4b1a-a5fd-945b71c655d1","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/e14b4233-203c-4b1a-a5fd-945b71c655d1\/d3ef4a88-899c-4ae0-897f-4733bf9e7b2b","ref":{"parent":"e14b4233-203c-4b1a-a5fd-945b71c655d1","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-17-18-11","docId":"75","text":"\u003Cp\u003EIndividual Council members as well as the City Council as a whole, have complete freedom of access to any information requested of staff (except information which is otherwise protected by law from disclosure) and will receive the full cooperation and candor of City staff in being provided with any requested information. Information sought by an individual council member may, at the discretion of the City Manager, be automatically provided to the City Council as a whole. In exercising this discretion, the City Manager will consider whether the information is significant or new or otherwise not available to the Council or is of interest to the Council.\u003C\/p\u003E\u003Cp\u003E(Ord. 2009, 2007)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d3ef4a88-899c-4ae0-897f-4733bf9e7b2b","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/2bd0f693-72ef-4d4e-a156-15d41393b17f","ref":{"parent":"b016b52d-2d4a-4373-8b4f-24897fb0b69e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-17-19","docId":"75","text":"2.17.040 Staff.","id":"2bd0f693-72ef-4d4e-a156-15d41393b17f","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/2bd0f693-72ef-4d4e-a156-15d41393b17f\/5c6ed256-c4e7-43f2-a7c6-1037f229eecb","ref":{"parent":"2bd0f693-72ef-4d4e-a156-15d41393b17f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-17-19-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"5c6ed256-c4e7-43f2-a7c6-1037f229eecb","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/0e7a3dfe-9cb8-4fa8-9aa0-afcc9c98347b","ref":{"parent":"b016b52d-2d4a-4373-8b4f-24897fb0b69e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-17-210","docId":"75","text":"2.17.041 Execution of Council Direction.","id":"0e7a3dfe-9cb8-4fa8-9aa0-afcc9c98347b","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/0e7a3dfe-9cb8-4fa8-9aa0-afcc9c98347b\/eaca3b4e-f954-4165-b1e8-3a7929f17c35","ref":{"parent":"0e7a3dfe-9cb8-4fa8-9aa0-afcc9c98347b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-17-210-11","docId":"75","text":"\u003Cp\u003EThe primary functions of City staff is the execution of Council policy and actions taken by the Council as well as keeping the Council informed regarding the general operations of the city.\u003C\/p\u003E\u003Cp\u003E(Ord. 2009, 2007)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"eaca3b4e-f954-4165-b1e8-3a7929f17c35","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/fc648900-50b4-487b-b575-6361efb086e9","ref":{"parent":"b016b52d-2d4a-4373-8b4f-24897fb0b69e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-17-211","docId":"75","text":"2.17.042 Undue Influence.","id":"fc648900-50b4-487b-b575-6361efb086e9","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/fc648900-50b4-487b-b575-6361efb086e9\/a2b9da50-ed19-4984-b647-6506654a21df","ref":{"parent":"fc648900-50b4-487b-b575-6361efb086e9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-17-211-11","docId":"75","text":"\u003Cp\u003ECity staff may take guidance and direction only from management or the City Council as a whole. Staff is prohibited from accepting direction or being unduly influenced by individual Council members to pressure staff members into making, changing or otherwise suppressing staff decisions or recommendations, or changing departmental work schedules and priorities. Staff members will report such attempts to influence them in confidence to the City Manager, who may inform the City Council as a whole of such attempts. Any staff member who violates this prohibition may be subject to disciplinary action at the discretion of the City Manager.\u003C\/p\u003E\u003Cp\u003E(Ord. 2009, 2007)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"a2b9da50-ed19-4984-b647-6506654a21df","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/537dc38d-dd69-447e-b1aa-df80900c2670","ref":{"parent":"b016b52d-2d4a-4373-8b4f-24897fb0b69e","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-17-212","docId":"75","text":"2.17.043 Timely Response.","id":"537dc38d-dd69-447e-b1aa-df80900c2670","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b016b52d-2d4a-4373-8b4f-24897fb0b69e\/537dc38d-dd69-447e-b1aa-df80900c2670\/40f1fa34-9b67-4472-a380-16269b9cdaf9","ref":{"parent":"537dc38d-dd69-447e-b1aa-df80900c2670","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-17-212-11","docId":"75","text":"\u003Cp\u003ECity staff will make every effort to respond in a timely and professional manner to all requests made by individual council members for information or assistance, provided that, in the judgment of the City Manager, the request is not of a magnitude either in terms of work load or policy, which would require that it more appropriately be assigned to staff through the collective direction of the City Council. In terms of making this judgment, the following guidelines should be considered:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EIs the request specific and limited in scope so that staff can respond without altering other priorities and with only minimal delay to other assignments?\u003C\/li\u003E\u003Cli\u003EIs the request a \u0022one time\u0022 work requirement, as opposed to an on-going work requirement?\u003C\/li\u003E\u003Cli\u003EDoes the response to a request require a significant allocation of staff resources (generally defined as consisting of more than one staff person, or a single staff person working on the request in excess of two hours)?\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 2009, 2007)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"40f1fa34-9b67-4472-a380-16269b9cdaf9","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-18","docId":"75","text":"CHAPTER 2.18: CITY ATTORNEY","id":"34c6db43-503e-4ae4-b61a-2da51fc73f7a","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/418b325e-d6a0-4bc8-a5af-7f039b2a8006","ref":{"parent":"34c6db43-503e-4ae4-b61a-2da51fc73f7a","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-18-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"418b325e-d6a0-4bc8-a5af-7f039b2a8006","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/59a0d64a-708d-495e-8972-8b5c13717f87","ref":{"parent":"34c6db43-503e-4ae4-b61a-2da51fc73f7a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-18-12","docId":"75","text":"2.18.010 Office of the City Attorney Established.","id":"59a0d64a-708d-495e-8972-8b5c13717f87","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/59a0d64a-708d-495e-8972-8b5c13717f87\/f54feb97-8f98-4d9e-8a56-67bed6a5b079","ref":{"parent":"59a0d64a-708d-495e-8972-8b5c13717f87","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-18-12-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe office of the City Attorney, as set forth in Government Code Section 36505, is established. The City Attorney shall be appointed by the City Council wholly on the basis of his or her qualifications. The City Attorney shall hold office for and during the pleasure of the City Council.\u003C\/li\u003E\u003Cli\u003EThe office of the City Attorney shall consist of the City Attorney and such assistants as may be authorized by the Council.\u003C\/li\u003E\u003Cli\u003EThe City Attorney shall administer the office, be responsible for the successful performance of its functions, and shall serve under the direct supervision and control of the Council as its legal advisor.\u003C\/li\u003E\u003Cli\u003EThe Council may retain or employ other attorneys, assistants, or special counsel as may be needed to take charge of any litigation or legal matters or to assist the City Attorney therein.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1673, \u00a7 1 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f54feb97-8f98-4d9e-8a56-67bed6a5b079","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/53d9d01d-0658-4977-8102-58ca3b0a40c8","ref":{"parent":"34c6db43-503e-4ae4-b61a-2da51fc73f7a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-18-13","docId":"75","text":"2.18.020 Function and Duties.","id":"53d9d01d-0658-4977-8102-58ca3b0a40c8","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/53d9d01d-0658-4977-8102-58ca3b0a40c8\/260e16f0-0cae-4c31-bd06-396e3ddbe963","ref":{"parent":"53d9d01d-0658-4977-8102-58ca3b0a40c8","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-18-13-11","docId":"75","text":"\u003Cp\u003EThe functions of the office of the City Attorney shall be to:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EAdvise the Council and all City officers in all matters pertaining to their offices;\u003C\/li\u003E\u003Cli\u003EFurnish legal services at all meetings of the Council, except when excused or disabled, and give advice or opinions on the legality of all matters under consideration by the Council or by any of the boards, commissions, committees or officers;\u003C\/li\u003E\u003Cli\u003EPrepare and\/or approve all ordinances, resolutions, agreements, contracts, and other legal instruments as shall be required for the proper conduct of the business of the City and approve the form of all contracts, agreements, and bonds given to the City;\u003C\/li\u003E\u003Cli\u003EProvide the necessary legal services required in connection with the acquisition of land or easements on behalf of the City;\u003C\/li\u003E\u003Cli\u003ESubject to the general direction of the Council, prosecute and defend the City, and all boards, officers and employees in their official capacities, all civil proceedings before judicial and quasi-judicial tribunals. The City Attorney shall not compromise, settle or dismiss any action for or against the City without permission of the City Council. Nor shall the City Attorney commence any civil action without the permission of the Council.\u003C\/li\u003E\u003Cli\u003EProsecute all violations of City ordinance; provided, however, that the City Attorney is not required to prosecute any misdemeanor or infraction within the City arising out of a violation of State law.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1673, \u00a7 1 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"260e16f0-0cae-4c31-bd06-396e3ddbe963","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/335d30a8-74e1-427d-bfa8-0c480c9cca58","ref":{"parent":"34c6db43-503e-4ae4-b61a-2da51fc73f7a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-18-14","docId":"75","text":"2.18.030 Council-Attorney Relations.","id":"335d30a8-74e1-427d-bfa8-0c480c9cca58","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/335d30a8-74e1-427d-bfa8-0c480c9cca58\/70dfd10c-45ed-4635-910e-eea361226f73","ref":{"parent":"335d30a8-74e1-427d-bfa8-0c480c9cca58","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-18-14-11","docId":"75","text":"\u003Cp\u003EIndividual Councilmembers may seek and obtain legal advice from the City Attorney on any matter or matters pertaining to the legal position of the City. Any such advice given to individual Councilmembers, however, may be repeated to the entire Council at any regular or special Council meeting. With respect to advice to individual Councilmembers regarding potential conflicts of interest, the City Attorney may render informal advice; provided, however, that it is understood that a Councilmember is automatically protected from potential liability for conflict of interest only upon taking action which conforms to a written opinion issued by the California Fair Political Practices Commission.\u003C\/p\u003E\u003Cp\u003E(Ord. 1673, \u00a7 1 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"70dfd10c-45ed-4635-910e-eea361226f73","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/95b2ff26-ddbe-4cd2-b35c-416470310910","ref":{"parent":"34c6db43-503e-4ae4-b61a-2da51fc73f7a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-18-15","docId":"75","text":"2.18.040 Attorney-Staff Relations.","id":"95b2ff26-ddbe-4cd2-b35c-416470310910","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/95b2ff26-ddbe-4cd2-b35c-416470310910\/ca24885a-e963-4bd4-88b1-782254254d05","ref":{"parent":"95b2ff26-ddbe-4cd2-b35c-416470310910","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-18-15-11","docId":"75","text":"\u003Cp\u003EPeriodically, but not less than once per year, the City Attorney and the City Manager will meet and confer in good faith regarding the allocation of the City Attorney\u2019s time among City departments.\u003C\/p\u003E\u003Cp\u003E(Ord. 2033, \u00a7 1, 2008; Ord. 1673, \u00a7 1 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"ca24885a-e963-4bd4-88b1-782254254d05","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/2a312fa7-390b-42c1-a972-57ef45517cc5","ref":{"parent":"34c6db43-503e-4ae4-b61a-2da51fc73f7a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-18-16","docId":"75","text":"2.18.050 Relations Between Attorney and Individual Members of the Public.","id":"2a312fa7-390b-42c1-a972-57ef45517cc5","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/2a312fa7-390b-42c1-a972-57ef45517cc5\/32f30d0f-4241-4a39-9955-bf5e18aa01e4","ref":{"parent":"2a312fa7-390b-42c1-a972-57ef45517cc5","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-18-16-11","docId":"75","text":"\u003Cp\u003EConsistent with the functions and duties of the City Attorney\u0027s office described in Section 2.18.020 of this chapter, the City Attorney or the Assistant City Attorney may, but is not required, to meet or discuss any matter with individual members of the public, legal counsel, or the media.\u003C\/p\u003E\u003Cp\u003E(Ord. 1673, \u00a7 1 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"32f30d0f-4241-4a39-9955-bf5e18aa01e4","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/98d36033-4d57-4b5e-9b38-325f528819cd","ref":{"parent":"34c6db43-503e-4ae4-b61a-2da51fc73f7a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-18-17","docId":"75","text":"2.18.060 Bond.","id":"98d36033-4d57-4b5e-9b38-325f528819cd","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/98d36033-4d57-4b5e-9b38-325f528819cd\/e62ea79f-d15b-4b2f-8982-dbd3c53ebb5d","ref":{"parent":"98d36033-4d57-4b5e-9b38-325f528819cd","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-18-17-11","docId":"75","text":"\u003Cp\u003EThe City Attorney shall furnish a corporate surety bond to be determined and approved by the City Council, and shall be conditioned upon the faithful performance of the duties imposed upon the City Attorney as prescribed in this chapter. Any premium for such bond shall be a proper charge against the City.\u003C\/p\u003E\u003Cp\u003E(Ord. 1673, \u00a7 1 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"e62ea79f-d15b-4b2f-8982-dbd3c53ebb5d","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/1a514862-31ba-4dbb-a187-44b6d02294c0","ref":{"parent":"34c6db43-503e-4ae4-b61a-2da51fc73f7a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-18-18","docId":"75","text":"2.18.070 Acting City Attorney.","id":"1a514862-31ba-4dbb-a187-44b6d02294c0","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/1a514862-31ba-4dbb-a187-44b6d02294c0\/d6bc3410-0c43-4091-bcfb-25791aec07ff","ref":{"parent":"1a514862-31ba-4dbb-a187-44b6d02294c0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-18-18-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe Assistant City Attorney shall serve as City Attorney pro tempore during any temporary absence or disability of the City Attorney.\u003C\/li\u003E\u003Cli\u003EIn the event there is no Assistant City Attorney, the Council shall appoint a qualified attorney to act as City Attorney pro tempore.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1673, \u00a7 1 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d6bc3410-0c43-4091-bcfb-25791aec07ff","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/dde2b4cb-351b-4a7d-8b1b-086ad60df9ed","ref":{"parent":"34c6db43-503e-4ae4-b61a-2da51fc73f7a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-18-19","docId":"75","text":"2.18.080 Agreements on Employment.","id":"dde2b4cb-351b-4a7d-8b1b-086ad60df9ed","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/dde2b4cb-351b-4a7d-8b1b-086ad60df9ed\/4ecff241-051e-4e0a-96db-e5f371cdf9c5","ref":{"parent":"dde2b4cb-351b-4a7d-8b1b-086ad60df9ed","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-18-19-11","docId":"75","text":"\u003Cp\u003EThe terms and conditions of employment of the City Attorney shall be established by ordinance or resolution. If the City Attorney is a full time employee, any employment agreement between the City and the City Attorney shall contain a provision for performance evaluations of the City Attorney to be conducted by the City Council at least once per calendar year. If the City Attorney is an independent contractor, the City Council shall endeavor to provide periodic feedback regarding the performance of the independent contractor.\u003C\/p\u003E\u003Cp\u003E(Ord. 2040 \u00a7 1, 2009; Ord. 2033 \u00a7 2, 2008; Ord. 1673, \u00a7 1 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"4ecff241-051e-4e0a-96db-e5f371cdf9c5","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/ce26bae6-401a-4e06-b7df-96777f773014","ref":{"parent":"34c6db43-503e-4ae4-b61a-2da51fc73f7a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-18-210","docId":"75","text":"2.18.090 Assistants and Employees.","id":"ce26bae6-401a-4e06-b7df-96777f773014","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/ce26bae6-401a-4e06-b7df-96777f773014\/9c90ce90-c45c-48b0-a6b7-63f40119d74f","ref":{"parent":"ce26bae6-401a-4e06-b7df-96777f773014","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-18-210-11","docId":"75","text":"\u003Cp\u003ENotwithstanding the provision of Section 2.52.100 of the Municipal Code, but subject to the other applicable provisions of Chapter 2.52, the City Attorney shall appoint, discipline and remove all assistants, deputies, and employees under his or her authority.\u003C\/p\u003E\u003Cp\u003E(Ord. 1673, \u00a7 1 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"9c90ce90-c45c-48b0-a6b7-63f40119d74f","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/cc238cb8-20b4-433d-b92b-0aae97ec385f","ref":{"parent":"34c6db43-503e-4ae4-b61a-2da51fc73f7a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-18-211","docId":"75","text":"2.18.100 Eligibility.","id":"cc238cb8-20b4-433d-b92b-0aae97ec385f","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/cc238cb8-20b4-433d-b92b-0aae97ec385f\/e58f04de-1a42-449d-9548-99f261a3541a","ref":{"parent":"cc238cb8-20b4-433d-b92b-0aae97ec385f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-18-211-11","docId":"75","text":"\u003Cp\u003ENo person elected or appointed as a Council-person of the City shall, subsequent to taking office as Councilperson, be eligible for appointment as City Attorney until one year has elapsed after the Councilmember has ceased to be a member of the City Council.\u003C\/p\u003E\u003Cp\u003E(Ord. 1673, \u00a7 1 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"e58f04de-1a42-449d-9548-99f261a3541a","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/891ae131-6250-4158-bb39-c300f12bdc3d","ref":{"parent":"34c6db43-503e-4ae4-b61a-2da51fc73f7a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-18-212","docId":"75","text":"2.18.110 Suspension\u2013Removal\u2013Resignation.","id":"891ae131-6250-4158-bb39-c300f12bdc3d","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/34c6db43-503e-4ae4-b61a-2da51fc73f7a\/891ae131-6250-4158-bb39-c300f12bdc3d\/c61f4fca-1bd6-4f0d-a85b-a970989bc9ea","ref":{"parent":"891ae131-6250-4158-bb39-c300f12bdc3d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-18-212-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe removal of the City Attorney shall be only on a majority vote of the entire City Council.\u003C\/li\u003E\u003Cli\u003EThe City Attorney may resign from his or her position upon at least four weeks\u2019 written notice to the City Council.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 2096, 2012; Ord. 1673, \u00a7 1 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"c61f4fca-1bd6-4f0d-a85b-a970989bc9ea","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-19","docId":"75","text":"CHAPTER 2.20: CITY CLERK*","id":"5aac7a04-fa24-4236-a21b-b460c5b56d2a","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/7cc415fa-1559-4c57-b6d1-1e835cd509a2","ref":{"parent":"5aac7a04-fa24-4236-a21b-b460c5b56d2a","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-19-11","docId":"75","text":"\u003Cp\u003E* For statutory provisions regarding the position of city clerk, see Gov. Code \u00a7\u00a7 36501 and 40801 et seq.; for the provisions regarding appointment of elective officers, see Gov. Code \u00a7 36508 et seq.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"7cc415fa-1559-4c57-b6d1-1e835cd509a2","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/9fba0673-a2a5-42f4-8b58-0fc46141f93f","ref":{"parent":"5aac7a04-fa24-4236-a21b-b460c5b56d2a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-19-12","docId":"75","text":"2.20.010 Recordkeeping Duties\u2013Closed Sessions.","id":"9fba0673-a2a5-42f4-8b58-0fc46141f93f","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/9fba0673-a2a5-42f4-8b58-0fc46141f93f\/7a80cf1d-dd41-4c01-b91b-d870ecfe4e6f","ref":{"parent":"9fba0673-a2a5-42f4-8b58-0fc46141f93f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-19-12-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EIt shall be the duty of the City Clerk to keep an accurate record of the proceedings of the City Council as provided in Government Code Section 40801.\u003C\/li\u003E\u003Cli\u003EWith respect to closed sessions of the City Council held pursuant to California Government Code Section 54950 et seq., unless otherwise ordered by the Council, the Clerk shall attend each closed session and keep and enter in a minute book a record of topics discussed and decisions made at all closed sessions. With respect to any particular closed session of the City Council, the Council may, in lieu of the City Clerk, order that minutes of any closed session be kept by another officer or employee of the City. Any minutes of a closed session taken by any person other than the City Clerk shall be retained in a separate minute book by the City Attorney.\u003C\/li\u003E\u003Cli\u003EAny minute book made pursuant to this section is not a public record subject to inspection pursuant to the California Public Records Act and shall be kept confidential. Subject to the requirements of California Government Code Section 54957.2, and 2 California Code of Regulations Section 18707 (recused members), any minute book described in this section shall be available only to members of the City Council. In addition, the City Council may authorize the City Manager and\/or the City Attorney to view the minute book for specific entries related to the City Manager\u0027s and City Attorney\u0027s respective duties.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 20-2205, \u00a7 1, 2020; Ord. 1697, (part), 1995; Ord. 1642, 1994; Ord. 16, \u00a7 1, 1956)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"7a80cf1d-dd41-4c01-b91b-d870ecfe4e6f","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/e3cd50b0-78cd-44c0-81bc-537b3a4f02a9","ref":{"parent":"5aac7a04-fa24-4236-a21b-b460c5b56d2a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-19-13","docId":"75","text":"2.20.020 Recordkeeping\u2013Financial Status of City.","id":"e3cd50b0-78cd-44c0-81bc-537b3a4f02a9","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/e3cd50b0-78cd-44c0-81bc-537b3a4f02a9\/d99dd16d-cf5b-4073-aa5f-8716d641aa23","ref":{"parent":"e3cd50b0-78cd-44c0-81bc-537b3a4f02a9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-19-13-11","docId":"75","text":"\u003Cp\u003EThe duties now and hereafter imposed upon the City Clerk by State statute for the maintenance of accounting records readily reflecting the financial condition of the City are hereby transferred to the Director Finance which office has been established by City ordinance and with the powers and duties thereof as defined by said ordinance.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. 1059, 1980; Ord. 650, (part), 1974; Ord. 16, \u00a7 2, 1956; Ord. 26-2283, Att. A \u00a7 2, 2026)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d99dd16d-cf5b-4073-aa5f-8716d641aa23","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/4a54d3fa-3513-40c1-a305-3d905ebbcc7f","ref":{"parent":"5aac7a04-fa24-4236-a21b-b460c5b56d2a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-19-14","docId":"75","text":"2.20.030 Recordkeeping\u2013Ordinances.","id":"4a54d3fa-3513-40c1-a305-3d905ebbcc7f","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/4a54d3fa-3513-40c1-a305-3d905ebbcc7f\/f836a328-d2cb-4ba9-abee-a443d71fa7b7","ref":{"parent":"4a54d3fa-3513-40c1-a305-3d905ebbcc7f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-19-14-11","docId":"75","text":"\u003Cp\u003EThe City Clerk shall keep a book marked \u201cOrdinances\u201d and record in it all City ordinances with a certificate annexed to each stating:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EIt is a true and correct copy of a City ordinance;\u003C\/li\u003E\u003Cli\u003EThe ordinance number;\u003C\/li\u003E\u003Cli\u003EIt has been published or posted pursuant to law.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1551, \u00a7 1 (part), 1991; Ord. 16, \u00a7 3, 1956)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f836a328-d2cb-4ba9-abee-a443d71fa7b7","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/13801cf9-a689-4bd0-809c-e4d5b99662e0","ref":{"parent":"5aac7a04-fa24-4236-a21b-b460c5b56d2a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-19-15","docId":"75","text":"2.20.040 Oath of Office\u2013Bond.","id":"13801cf9-a689-4bd0-809c-e4d5b99662e0","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/13801cf9-a689-4bd0-809c-e4d5b99662e0\/0d2a4998-1e1e-48a5-82c2-c339ddc0678a","ref":{"parent":"13801cf9-a689-4bd0-809c-e4d5b99662e0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-19-15-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe City Clerk, before entering upon the duties of City Clerk, shall take the oath of office provided for in the Constitution of the State of California, and shall file with the City a bond. The premium for the bond shall be paid by the City. Except as otherwise provided, the bond shall conform to the provisions of the State Government Code relating to bonds of public officers.\u003C\/li\u003E\u003Cli\u003EThe penal sum of the bond shall be in a reasonable amount recommended by the City Attorney and fixed by the City Council by resolution, and may be changed during the City Clerk\u2019s term of office. A bond in like amount shall be filed by the Deputy City Clerk, with the premium paid by the City.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1551, \u00a7 1 (part), 1991; Ord. 1371, 1986)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0d2a4998-1e1e-48a5-82c2-c339ddc0678a","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/4d18b892-b495-4fac-9cc7-171e84a8c898","ref":{"parent":"5aac7a04-fa24-4236-a21b-b460c5b56d2a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-19-16","docId":"75","text":"2.20.050 Custodian of City Seal.","id":"4d18b892-b495-4fac-9cc7-171e84a8c898","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/4d18b892-b495-4fac-9cc7-171e84a8c898\/b793f33a-dfec-4161-8408-42476c5b0c79","ref":{"parent":"4d18b892-b495-4fac-9cc7-171e84a8c898","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-19-16-11","docId":"75","text":"\u003Cp\u003EThe City Clerk shall be custodian of the City seal.\u003C\/p\u003E\u003Cp\u003E(Ord. 1551, \u00a7 1 (part), 1991; Ord. 16, \u00a7 5, 1956)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"b793f33a-dfec-4161-8408-42476c5b0c79","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/e3eb1dab-39f8-4e7f-b3c4-6c55d1048b59","ref":{"parent":"5aac7a04-fa24-4236-a21b-b460c5b56d2a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-19-17","docId":"75","text":"2.20.070 Oaths and Affirmations.","id":"e3eb1dab-39f8-4e7f-b3c4-6c55d1048b59","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/e3eb1dab-39f8-4e7f-b3c4-6c55d1048b59\/693a5455-7293-454e-83d9-bdc5e3fae4b8","ref":{"parent":"e3eb1dab-39f8-4e7f-b3c4-6c55d1048b59","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-19-17-11","docId":"75","text":"\u003Cp\u003EThe City Clerk shall administer oaths or affirmations and take and certify affidavits and depositions pertaining to City affairs and business which may be used in any court or proceedings in the State.\u003C\/p\u003E\u003Cp\u003E(Ord. 1551, \u00a7 1 (part), 1991; Ord. 16, \u00a7 7, 1956)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"693a5455-7293-454e-83d9-bdc5e3fae4b8","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/6c7b5540-41ae-481b-a520-fdcfaa459f9d","ref":{"parent":"5aac7a04-fa24-4236-a21b-b460c5b56d2a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-19-18","docId":"75","text":"2.20.080 Other Duties.","id":"6c7b5540-41ae-481b-a520-fdcfaa459f9d","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/6c7b5540-41ae-481b-a520-fdcfaa459f9d\/0c4fb92d-0dd4-4115-83a7-97eca3510f5d","ref":{"parent":"6c7b5540-41ae-481b-a520-fdcfaa459f9d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-19-18-11","docId":"75","text":"\u003Cp\u003EThe City Clerk shall perform all other duties necessary to the functions of the office of City Clerk as required by law and as assigned by the City Manager.\u003C\/p\u003E\u003Cp\u003E(Ord. 1551, \u00a7 1 (part), 1991; Ord. 16(c), \u00a7 2, 1967; Ord. 16, \u00a7 8, 1956)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0c4fb92d-0dd4-4115-83a7-97eca3510f5d","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/e4cd550f-25c0-43f8-b779-4eb901768c9e","ref":{"parent":"5aac7a04-fa24-4236-a21b-b460c5b56d2a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-19-19","docId":"75","text":"2.20.100 Appointment.","id":"e4cd550f-25c0-43f8-b779-4eb901768c9e","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/e4cd550f-25c0-43f8-b779-4eb901768c9e\/55fb610f-1eb4-4c74-9ea3-4f98ecb1ceff","ref":{"parent":"e4cd550f-25c0-43f8-b779-4eb901768c9e","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-19-19-11","docId":"75","text":"\u003Cp\u003EThe City Clerk shall be appointed by the City Manager on the basis of ability and qualifications for the position.\u003C\/p\u003E\u003Cp\u003E(Ord. 1551, \u00a7 1 (part), 1991; Ord. 650, (part), 1974; Ord. 16(c), \u00a7 4, 1967)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"55fb610f-1eb4-4c74-9ea3-4f98ecb1ceff","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/e10f9182-ae0f-4526-9083-dd733d886e16","ref":{"parent":"5aac7a04-fa24-4236-a21b-b460c5b56d2a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-19-210","docId":"75","text":"2.20.110 Deputy City Clerk.","id":"e10f9182-ae0f-4526-9083-dd733d886e16","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/e10f9182-ae0f-4526-9083-dd733d886e16\/76c9b4e2-5549-4504-ba6c-727aa1f4ccc0","ref":{"parent":"e10f9182-ae0f-4526-9083-dd733d886e16","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-19-210-11","docId":"75","text":"\u003Cp\u003EThe City Clerk may appoint a Deputy City Clerk who shall have the rights and duties of the City Clerk during the City Clerk\u2019s absence to assure the continuity of service of that office.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. 1551, \u00a7 1 (part), 1991; Ord. 650, (part), 1974; Ord. 16(c), \u00a7 5, 1967)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"76c9b4e2-5549-4504-ba6c-727aa1f4ccc0","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/259399b2-2acb-4696-af41-9a9de8b27d28","ref":{"parent":"5aac7a04-fa24-4236-a21b-b460c5b56d2a","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-19-211","docId":"75","text":"2.20.120 Electronic Filing of Campaign Statements.","id":"259399b2-2acb-4696-af41-9a9de8b27d28","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/5aac7a04-fa24-4236-a21b-b460c5b56d2a\/259399b2-2acb-4696-af41-9a9de8b27d28\/cbb60f42-81a3-4b22-9ca1-c8ae71789899","ref":{"parent":"259399b2-2acb-4696-af41-9a9de8b27d28","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-19-211-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EAny elected officer, candidate, committee or other person required to file statements, reports or other documents required by Chapter 4 (commencing with Section 84100 of the Government Code), except an elected officer, candidate, committee or other person who receives contributions totaling less than $1,000 and makes expenditures totaling less than $1,000 in a calendar year, shall file those statements, reports or other documents online or electronically with the City Clerk.\u003C\/li\u003E\u003Cli\u003EIn any instance in which an original statement, report or other document must be filed with the California Secretary of State and a copy of that statement, report or other document is required to be filed with the City Clerk, the filer may, but is not required to, file the copy electronically.\u003C\/li\u003E\u003Cli\u003EIf the City Clerk\u0027s electronic system is not capable of accepting a particular type of statement, report or other document, an elected officer, candidate, committee or other person shall file that document with the City Clerk in an alternative format.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 20-2209, \u00a7 1, 2020)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"cbb60f42-81a3-4b22-9ca1-c8ae71789899","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f2415e5a-f2dd-40e1-8f6c-bf171e9f875d","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-210","docId":"75","text":"CHAPTER 2.24: CITY TREASURER*","id":"f2415e5a-f2dd-40e1-8f6c-bf171e9f875d","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f2415e5a-f2dd-40e1-8f6c-bf171e9f875d\/d861c67d-ba77-4576-a64b-1c1c638327ce","ref":{"parent":"f2415e5a-f2dd-40e1-8f6c-bf171e9f875d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-210-11","docId":"75","text":"\u003Cp\u003E* For statutory provisions regarding the position of city treasurer, see Gov. Code \u00a7\u00a7 36501 and 41001 et seq.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d861c67d-ba77-4576-a64b-1c1c638327ce","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f2415e5a-f2dd-40e1-8f6c-bf171e9f875d\/877bb8a6-938a-4c73-8352-e5adc9331aff","ref":{"parent":"f2415e5a-f2dd-40e1-8f6c-bf171e9f875d","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-210-12","docId":"75","text":"2.24.010 City Moneys Responsibility.","id":"877bb8a6-938a-4c73-8352-e5adc9331aff","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f2415e5a-f2dd-40e1-8f6c-bf171e9f875d\/877bb8a6-938a-4c73-8352-e5adc9331aff\/e90ecf12-642e-4759-907c-b2dd571bdb45","ref":{"parent":"877bb8a6-938a-4c73-8352-e5adc9331aff","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-210-12-11","docId":"75","text":"\u003Cp\u003EIt shall be the duty of the Treasurer to receive and safely keep all moneys of the City deposited with him or her in connection with any business thereof.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. 650, (part), 1974; Ord. 17, \u00a7 1, 1956)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"e90ecf12-642e-4759-907c-b2dd571bdb45","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f2415e5a-f2dd-40e1-8f6c-bf171e9f875d\/51e61aed-3b13-4807-ad00-3db33d4c63ee","ref":{"parent":"f2415e5a-f2dd-40e1-8f6c-bf171e9f875d","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-210-13","docId":"75","text":"2.24.020 Payment Procedure.","id":"51e61aed-3b13-4807-ad00-3db33d4c63ee","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f2415e5a-f2dd-40e1-8f6c-bf171e9f875d\/51e61aed-3b13-4807-ad00-3db33d4c63ee\/91c933d3-5c61-4e21-9dbe-0f528549cb59","ref":{"parent":"51e61aed-3b13-4807-ad00-3db33d4c63ee","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-210-13-11","docId":"75","text":"\u003Cp\u003EThe Treasurer shall pay out all moneys owed by the City including obligations incurred by improvement bonds thereof on certification of the Director of Finance that such are due and owing. All payments, transfers or withdrawals of City moneys shall be by checks signed by the Mayor and Treasurer. In the event that the Mayor or Treasurer are not available, then the Vice-Mayor and\/or Deputy Treasurer are authorized to sign in their place. A facsimile signature may be used.\u003C\/p\u003E\u003Cp\u003E(Ord. 1951, 2004; Ord. 1697, (part), 1995; Ord. 946, 1979; Ord. 650, (part), 1974; Ord. 17, \u00a7 2, 1956; Ord. 26-2283, Att. A \u00a7 3, 2026)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"91c933d3-5c61-4e21-9dbe-0f528549cb59","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f2415e5a-f2dd-40e1-8f6c-bf171e9f875d\/aebb5c33-4319-49ca-a823-eadc03f94c27","ref":{"parent":"f2415e5a-f2dd-40e1-8f6c-bf171e9f875d","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-210-14","docId":"75","text":"2.24.030 Monthly Reports.","id":"aebb5c33-4319-49ca-a823-eadc03f94c27","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f2415e5a-f2dd-40e1-8f6c-bf171e9f875d\/aebb5c33-4319-49ca-a823-eadc03f94c27\/bf9dd422-5b68-4797-8ac0-1c423f5f0eda","ref":{"parent":"aebb5c33-4319-49ca-a823-eadc03f94c27","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-210-14-11","docId":"75","text":"\u003Cp\u003EThe Treasurer shall make monthly reports which conform to the requirements of Government Code Section 41004. Said reports shall be delivered to the City Council, the City Manager and made available for review by such other persons who may so request.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. 650, (part), 1974; Ord. 17, \u00a7 3, 1956)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"bf9dd422-5b68-4797-8ac0-1c423f5f0eda","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f2415e5a-f2dd-40e1-8f6c-bf171e9f875d\/e60ae89e-920a-4d1f-8a5c-e2f2d4348c6e","ref":{"parent":"f2415e5a-f2dd-40e1-8f6c-bf171e9f875d","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-210-15","docId":"75","text":"2.24.040 Oath of Office\u2013Bond.","id":"e60ae89e-920a-4d1f-8a5c-e2f2d4348c6e","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f2415e5a-f2dd-40e1-8f6c-bf171e9f875d\/e60ae89e-920a-4d1f-8a5c-e2f2d4348c6e\/16748c10-c919-4b71-85cb-01e014ee8c83","ref":{"parent":"e60ae89e-920a-4d1f-8a5c-e2f2d4348c6e","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-210-15-11","docId":"75","text":"\u003Cp\u003EThe Treasurer before entering upon his or her duties shall take the oath of office provided for in the Constitution of the State of California and shall file with the City Clerk an official bond in the amount to be set from time to time by the City Council by resolution for the faithful performance of his or her duties, payable to the City. Said bond shall be to the satisfaction of the Mayor and his or her approval shall be endorsed thereon. The premium of the bond shall be paid by the City.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. 17, \u00a7 4, 1956)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"16748c10-c919-4b71-85cb-01e014ee8c83","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f2415e5a-f2dd-40e1-8f6c-bf171e9f875d\/16baf052-e51a-4867-a462-243ac8864ccf","ref":{"parent":"f2415e5a-f2dd-40e1-8f6c-bf171e9f875d","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-210-16","docId":"75","text":"2.24.050 Investment Authority.","id":"16baf052-e51a-4867-a462-243ac8864ccf","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f2415e5a-f2dd-40e1-8f6c-bf171e9f875d\/16baf052-e51a-4867-a462-243ac8864ccf\/9ae0cfb2-d810-4d55-8b0d-944b5e0f338b","ref":{"parent":"16baf052-e51a-4867-a462-243ac8864ccf","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-210-16-11","docId":"75","text":"\u003Cp\u003EPursuant to authority granted by state statutes, there is hereby delegated to the Treasurer the authority to invest or to reinvest funds of the City, or to sell or exchange securities so purchased, and who shall thereafter assume full responsibility for such transactions until such time as the delegation of authority is revoked. The Treasurer shall make a monthly report of all such transactions to the members of the City Council, the City Manager and also make it available for review by such other persons who may so request.\u003C\/p\u003E\u003Cp\u003E(Ord. 650, (part), 1974)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"9ae0cfb2-d810-4d55-8b0d-944b5e0f338b","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-211","docId":"75","text":"CHAPTER 2.28: CITY MANAGER*","id":"61d1ff53-f9e6-46ce-8722-c2a84075d335","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335\/390ba202-caec-483d-a6ff-0deb9a604a03","ref":{"parent":"61d1ff53-f9e6-46ce-8722-c2a84075d335","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-211-11","docId":"75","text":"\u003Cp\u003E* For statutory provisions regarding the city manager form of government, see Gov. Code \u00a7\u00a7 34851--34859.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"390ba202-caec-483d-a6ff-0deb9a604a03","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335\/cd14733e-5e24-469c-ba34-797898363a9f","ref":{"parent":"61d1ff53-f9e6-46ce-8722-c2a84075d335","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-211-12","docId":"75","text":"2.28.010 Office Created.","id":"cd14733e-5e24-469c-ba34-797898363a9f","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335\/cd14733e-5e24-469c-ba34-797898363a9f\/25aec48a-79cb-4a85-9f68-3d38417839bb","ref":{"parent":"cd14733e-5e24-469c-ba34-797898363a9f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-211-12-11","docId":"75","text":"\u003Cp\u003EThe office of City Manager is created and established. The City Manager shall be appointed by the City Council on the basis of his or her experience, administrative and executive ability. He or she shall hold office at and during the pleasure of the City Council.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. 106, \u00a7 1, 1959)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"25aec48a-79cb-4a85-9f68-3d38417839bb","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335\/6bcf5ce8-8c8e-48fc-b4ae-99668f59f559","ref":{"parent":"61d1ff53-f9e6-46ce-8722-c2a84075d335","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-211-13","docId":"75","text":"2.28.020 Reserved.","id":"6bcf5ce8-8c8e-48fc-b4ae-99668f59f559","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335\/6bcf5ce8-8c8e-48fc-b4ae-99668f59f559\/9b373e1e-bc90-4f8f-b10d-bfefa7ada2c4","ref":{"parent":"6bcf5ce8-8c8e-48fc-b4ae-99668f59f559","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-211-13-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"9b373e1e-bc90-4f8f-b10d-bfefa7ada2c4","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335\/30af3e27-aff7-485c-b5fd-c327d32410e6","ref":{"parent":"61d1ff53-f9e6-46ce-8722-c2a84075d335","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-211-14","docId":"75","text":"2.28.030 Eligibility\u2013Bond.","id":"30af3e27-aff7-485c-b5fd-c327d32410e6","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335\/30af3e27-aff7-485c-b5fd-c327d32410e6\/3c53555a-b844-410e-bb08-f5aebb4d391f","ref":{"parent":"30af3e27-aff7-485c-b5fd-c327d32410e6","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-211-14-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ENo person elected or appointed as a councilman of the City shall, subsequent to taking office as councilman, be eligible for appointment as City Manager until one year has elapsed after the Council member has ceased to be a member of the City Council.\u003C\/li\u003E\u003Cli\u003EThe City Manager shall furnish a corporate surety bond to the City conditioned upon the faithful performance of his or her duties in the penal sum to be fixed by the City Council. The premium for the bond shall be paid by the City.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. 106, \u00a7 3, 1959)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"3c53555a-b844-410e-bb08-f5aebb4d391f","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335\/f54cc3a1-a8d4-4bb8-9c19-b49b0d4f1830","ref":{"parent":"61d1ff53-f9e6-46ce-8722-c2a84075d335","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-211-15","docId":"75","text":"2.28.040 Powers and Duties.","id":"f54cc3a1-a8d4-4bb8-9c19-b49b0d4f1830","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335\/f54cc3a1-a8d4-4bb8-9c19-b49b0d4f1830\/a14ffe7c-f863-4608-9545-e3de6f1fa710","ref":{"parent":"f54cc3a1-a8d4-4bb8-9c19-b49b0d4f1830","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-211-15-11","docId":"75","text":"\u003Cp\u003EThe City Manager shall be the administrative head of the City government acting under the direction and control of the City Council except as otherwise provided in this chapter. In addition to his or her general powers as Chief Administrator, and not as a limitation thereon, he or she shall have the powers and duties set forth in the following subsections:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ETo see that all laws and ordinances of the City are duly enforced and that all franchises, permits, licenses and privileges granted by the City are faithfully performed and observed;\u003C\/li\u003E\u003Cli\u003ETo control, order and give directions to all directors of departments and to subordinate officers and employees of the City under his or her jurisdiction through their department directors, and to transfer employees from one department to another;\u003C\/li\u003E\u003Cli\u003EThe services and facilities of the City Treasurer and the City Attorney shall be made available to the City Manager to the same extent and in the same manner that the services are available to the City Council;\u003C\/li\u003E\u003Cli\u003ETo appoint, discipline and dismiss any and all officers and employees of the City except those elected by the electors of the City or whose appointment or dismissal is denied to the City Manager under the laws of the state.\u003Cbr\u003E\nThe power to appoint given in the preceding paragraph does not include the power to create a new position except as provided under Chapter 2.52;\u003C\/li\u003E\u003Cli\u003ETo attend all meetings of the City Council unless excused therefrom by the City Council;\u003C\/li\u003E\u003Cli\u003ETo recommend to the City Council for adoption such measures and ordinances as he or she deems necessary or expedient;\u003C\/li\u003E\u003Cli\u003ETo keep the City Council at all times fully advised as to the financial conditions and needs of the City;\u003C\/li\u003E\u003Cli\u003ETo prepare and submit to the City Council the annual budget and to administer it after adoption;\u003C\/li\u003E\u003Cli\u003ETo purchase or cause to be purchased all supplies for all of the departments or divisions of the City. No expenditures shall be submitted or recommended to the City Council except on report and approval of the City Manager;\u003C\/li\u003E\u003Cli\u003ETo make investigation into the affairs of the City and any department or division thereof and any contract or the proper performance of any obligation running to the City;\u003C\/li\u003E\u003Cli\u003ETo investigate all complaints in relation to matters consuming the administration of the government of the City and in regard to the services maintained by public utilities in the City and to see that all franchises, permits and privileges granted by the City are faithfully observed;\u003C\/li\u003E\u003Cli\u003ETo execute general supervision over all public buildings, public parks, streets and other public property which are under the control and jurisdiction of the City Council;\u003C\/li\u003E\u003Cli\u003ETo devote his or her entire working time, thought and energy to the duties and interests of the City;\u003C\/li\u003E\u003Cli\u003ETo receive and open all official mail and communications addressed either to the Mayor or to the City Council;\u003C\/li\u003E\u003Cli\u003ETo make reports and initiate recommendations as may be desirable or as requested by the City Council;\u003C\/li\u003E\u003Cli\u003ETo sign documents specified in Cal. Gov\u2019t Code \u00a7 40602, or to delegate to another officer such authority to sign, whenever such documents have been approved by the Council for execution by the City Manager or their delegee by ordinance, resolution, motion, minute order or other appropriate action. The Purchasing Officer given approval or award authority for the documents specified in Cal. Gov\u2019t Code \u00a7 40602 in or pursuant to Chapter 3.22 may sign those documents.\u003C\/li\u003E\u003Cli\u003ETo perform such other duties and exercise such other powers as may be delegated to him or her from time to time by ordinance, resolution or other action of the City Council.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 20-2214, 2020; Ord. 2097, 2012; Ord. 1697, (part), 1995; Ord. 705, \u00a7 1, 1975; Ord. 106, \u00a7 4, 1959)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"a14ffe7c-f863-4608-9545-e3de6f1fa710","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335\/a238308b-6fc2-4a97-93f5-f142afc41aa1","ref":{"parent":"61d1ff53-f9e6-46ce-8722-c2a84075d335","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-211-16","docId":"75","text":"2.28.050 Council-Manager Relations.","id":"a238308b-6fc2-4a97-93f5-f142afc41aa1","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335\/a238308b-6fc2-4a97-93f5-f142afc41aa1\/36de5e28-dfc1-4ee2-8682-9cfafa31cd62","ref":{"parent":"a238308b-6fc2-4a97-93f5-f142afc41aa1","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-211-16-11","docId":"75","text":"\u003Cp\u003EThe City Council and its members shall deal with the administrative services of the City only through the City Manager, except for the purpose of inquiry, and neither the City Council nor any member thereof shall give orders to any subordinates of the City Manager. The City Manager shall take his or her instructions from the City Council only when given at a duly held meeting of the City Council, and no individual councilperson shall give any instructions to the City Manager.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. 106, \u00a7 5, 1959)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"36de5e28-dfc1-4ee2-8682-9cfafa31cd62","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335\/1557ecb8-7c55-4e89-a8c4-007e74dba4ba","ref":{"parent":"61d1ff53-f9e6-46ce-8722-c2a84075d335","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-211-17","docId":"75","text":"2.28.060 Attendance at Commission Meetings.","id":"1557ecb8-7c55-4e89-a8c4-007e74dba4ba","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335\/1557ecb8-7c55-4e89-a8c4-007e74dba4ba\/b2593d47-9626-410a-a462-4116ff4d5bf8","ref":{"parent":"1557ecb8-7c55-4e89-a8c4-007e74dba4ba","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-211-17-11","docId":"75","text":"\u003Cp\u003EThe City Manager may attend any and all meetings of any commission or board heretofore or hereafter created by the City Council, upon his own volition or upon direction of the City Council. At any such meetings at which the City Manager attends, he or she shall inform the members as to the status of any matter being considered by the City Council. He or she shall cooperate fully with the members of all commissions, board or committees appointed by the City Council.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. 106, \u00a7 6, 1959)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"b2593d47-9626-410a-a462-4116ff4d5bf8","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335\/eb85b7de-1184-48fe-a822-d66755ed1288","ref":{"parent":"61d1ff53-f9e6-46ce-8722-c2a84075d335","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-211-18","docId":"75","text":"2.28.070 Temporary Absence.","id":"eb85b7de-1184-48fe-a822-d66755ed1288","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335\/eb85b7de-1184-48fe-a822-d66755ed1288\/fee697f2-4cc2-47a6-a1af-0b368e0c33f9","ref":{"parent":"eb85b7de-1184-48fe-a822-d66755ed1288","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-211-18-11","docId":"75","text":"\u003Cp\u003EIn the event of the temporary absence or disability of the City Manager, the City Council may designate some duly qualified person to perform the duties of City Manager during the period of his or her absence or disability.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. 106, \u00a7 7, 1959)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"fee697f2-4cc2-47a6-a1af-0b368e0c33f9","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335\/b3588774-428e-4023-9b73-66acb8ae6737","ref":{"parent":"61d1ff53-f9e6-46ce-8722-c2a84075d335","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-211-19","docId":"75","text":"2.28.080 Compensation\u2013Reimbursement.","id":"b3588774-428e-4023-9b73-66acb8ae6737","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335\/b3588774-428e-4023-9b73-66acb8ae6737\/d0f5f115-3bc7-4cd8-b05a-65d1a6cf7072","ref":{"parent":"b3588774-428e-4023-9b73-66acb8ae6737","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-211-19-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe compensation of the City Manager, as well as provisions for his vacation time shall be determined by resolution of the City Council.\u003C\/li\u003E\u003Cli\u003EThe City Manager shall be reimbursed for all legitimate expenses paid by him in the conduct of City business, including traveling expenses outside the City limits.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 106, \u00a7 8, 1959)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d0f5f115-3bc7-4cd8-b05a-65d1a6cf7072","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335\/d8e99189-b4ca-40e6-931d-f9a7b16568b5","ref":{"parent":"61d1ff53-f9e6-46ce-8722-c2a84075d335","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-211-210","docId":"75","text":"2.28.090 Suspension\u2013Removal\u2013Resignation.","id":"d8e99189-b4ca-40e6-931d-f9a7b16568b5","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/61d1ff53-f9e6-46ce-8722-c2a84075d335\/d8e99189-b4ca-40e6-931d-f9a7b16568b5\/87ff8d5d-3473-4f11-8447-5de4edbe72dc","ref":{"parent":"d8e99189-b4ca-40e6-931d-f9a7b16568b5","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-211-210-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe removal of the City Manager shall be only upon a majority vote of the City Council.\u003C\/li\u003E\u003Cli\u003EThe City Manager may resign from his or her position upon at least four weeks\u0027 notice in writing given to the City Council.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 2093, 2012; Ord. 1697, (part), 1995; Ord. 106, \u00a7 9, 1959)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"87ff8d5d-3473-4f11-8447-5de4edbe72dc","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f2cf5c47-662b-452c-871d-f0f80a44d1ad","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-212","docId":"75","text":"CHAPTER 2.30: CODE ENFORCEMENT OFFICER","id":"f2cf5c47-662b-452c-871d-f0f80a44d1ad","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f2cf5c47-662b-452c-871d-f0f80a44d1ad\/6d26b6c9-8f8f-4259-91f4-90e1881f4e41","ref":{"parent":"f2cf5c47-662b-452c-871d-f0f80a44d1ad","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-212-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"6d26b6c9-8f8f-4259-91f4-90e1881f4e41","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f2cf5c47-662b-452c-871d-f0f80a44d1ad\/248fe861-c0d6-4236-88cf-fb9322d9f3ef","ref":{"parent":"f2cf5c47-662b-452c-871d-f0f80a44d1ad","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-212-12","docId":"75","text":"2.30.010 Office Created.","id":"248fe861-c0d6-4236-88cf-fb9322d9f3ef","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f2cf5c47-662b-452c-871d-f0f80a44d1ad\/248fe861-c0d6-4236-88cf-fb9322d9f3ef\/0dd48879-3556-4823-835d-46c26e4e6ac3","ref":{"parent":"248fe861-c0d6-4236-88cf-fb9322d9f3ef","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-212-12-11","docId":"75","text":"\u003Cp\u003EThe Code Enforcement Officer, or such person authorized to act in that capacity during his periods of absence or leave, is designated Enforcement Officer, and charged with the duty of enforcement of the ordinances of the City, and the parking regulations of the California Vehicle Code. Such designation shall not relieve any other officer of the City who, in any other ordinance of the City, is designated as the Enforcement Officer thereof, from his duty to enforce such other ordinance. With respect to any such other ordinances, the Code Enforcement Officer, or such person authorized to act in that capacity during his or her periods of absence or leave, shall discharge his or her duties under this chapter in cooperation with any such other officer.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. 830, (part), 1977; Ord. 548, \u00a7 1, 1972)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0dd48879-3556-4823-835d-46c26e4e6ac3","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f2cf5c47-662b-452c-871d-f0f80a44d1ad\/ac9f9d47-7c7e-4574-9576-542253de5dbd","ref":{"parent":"f2cf5c47-662b-452c-871d-f0f80a44d1ad","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-212-13","docId":"75","text":"2.30.020 Warrantless Arrest Power.","id":"ac9f9d47-7c7e-4574-9576-542253de5dbd","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f2cf5c47-662b-452c-871d-f0f80a44d1ad\/ac9f9d47-7c7e-4574-9576-542253de5dbd\/c317a527-a4a1-4d21-9013-c0dc53a5bb60","ref":{"parent":"ac9f9d47-7c7e-4574-9576-542253de5dbd","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-212-13-11","docId":"75","text":"\u003Cp\u003EThe Code Enforcement Officer, or such person authorized to act in that capacity during his or her periods of absence or leave, is authorized and empowered to arrest a person without a warrant whenever he has reasonable cause to believe that the person to be arrested has committed a misdemeanor in his or her presence which is a violation of any ordinance of the City or parking regulation of the California Vehicle Code, or to issue a citation in lieu thereof, as provided in Section 836.5 of the Penal Code of the State of California.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. 830, (part), 1977; Ord. 548, \u00a7 2, 1972)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"c317a527-a4a1-4d21-9013-c0dc53a5bb60","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a3cd9039-19a3-4866-b7b2-a5a0deb71c4f","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-213","docId":"75","text":"CHAPTER 2.32: PLANNING COMMISSION*","id":"a3cd9039-19a3-4866-b7b2-a5a0deb71c4f","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a3cd9039-19a3-4866-b7b2-a5a0deb71c4f\/c7db2a16-8c6c-431c-b675-950f82c8e7a6","ref":{"parent":"a3cd9039-19a3-4866-b7b2-a5a0deb71c4f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-213-11","docId":"75","text":"\u003Cp\u003E* For statutory provisions regarding the establishment of a city planning commission, see Gov. Code \u00a7 65100 et seq. -- See Title 17, Zoning.\u003C\/p\u003E\u003Cp\u003E* Prior ordinance history: Ords. 5, 5(b), 5(c), 5(d), 167, 1166, 1213, 1321, 1459, 1549 and 1697.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"c7db2a16-8c6c-431c-b675-950f82c8e7a6","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a3cd9039-19a3-4866-b7b2-a5a0deb71c4f\/6d62da79-2df2-4e8d-b11d-9a3dbad35b65","ref":{"parent":"a3cd9039-19a3-4866-b7b2-a5a0deb71c4f","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-213-12","docId":"75","text":"2.32.010 Established.","id":"6d62da79-2df2-4e8d-b11d-9a3dbad35b65","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a3cd9039-19a3-4866-b7b2-a5a0deb71c4f\/6d62da79-2df2-4e8d-b11d-9a3dbad35b65\/126938a0-02aa-4651-9c99-c5a75c62dd28","ref":{"parent":"6d62da79-2df2-4e8d-b11d-9a3dbad35b65","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-213-12-11","docId":"75","text":"\u003Cp\u003EThe City Planning Commission is established. The City Planning Commission shall consist of five members, none of whom shall be officials or employees of the City and none of whom shall cohabit with as defined by law, nor be related by blood or marriage to any other member of the Commission, the City Manager or the staff person(s) assigned to this Commission. The five members shall be appointed by the City Council. Each member shall be a qualified elector in and resident of the City. Each member shall receive compensation as established by resolution of the City Council.\u003C\/p\u003E\u003Cp\u003E(Ord. 1787, \u00a7 1 (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"126938a0-02aa-4651-9c99-c5a75c62dd28","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a3cd9039-19a3-4866-b7b2-a5a0deb71c4f\/e831fbb9-4b33-4b96-9645-9a7ae26f8999","ref":{"parent":"a3cd9039-19a3-4866-b7b2-a5a0deb71c4f","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-213-13","docId":"75","text":"2.32.020 Terms of Office.","id":"e831fbb9-4b33-4b96-9645-9a7ae26f8999","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a3cd9039-19a3-4866-b7b2-a5a0deb71c4f\/e831fbb9-4b33-4b96-9645-9a7ae26f8999\/25c75b35-b53c-47c4-8d26-9ec5e3628105","ref":{"parent":"e831fbb9-4b33-4b96-9645-9a7ae26f8999","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-213-13-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ECommissioners serve at the pleasure of the City Council. The term of office of the members of the Planning Commission shall be four years and shall end on January 30th of the year their term is due to expire. No commissioner shall serve more than two consecutive terms except that a commissioner may serve more than two consecutive terms if he or she has been appointed to the Commission to fill an unexpired term of less than two years.\u003C\/li\u003E\u003Cli\u003EThe appointment, reappointment, and rules governing incumbent members of the Commission are governed by the Resolution of the City Council which governs advisory bodies.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 1 (part), 2018; Ord. 1974, \u00a7 4 (part), 2006; Ord. 1787, \u00a7 1 (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"25c75b35-b53c-47c4-8d26-9ec5e3628105","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a3cd9039-19a3-4866-b7b2-a5a0deb71c4f\/65d57f64-0189-4473-9394-68efa38ef4ce","ref":{"parent":"a3cd9039-19a3-4866-b7b2-a5a0deb71c4f","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-213-14","docId":"75","text":"2.32.030 Vacancy or Removal.","id":"65d57f64-0189-4473-9394-68efa38ef4ce","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a3cd9039-19a3-4866-b7b2-a5a0deb71c4f\/65d57f64-0189-4473-9394-68efa38ef4ce\/8d0bc58d-32c0-498d-af1d-1230e065c611","ref":{"parent":"65d57f64-0189-4473-9394-68efa38ef4ce","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-213-14-11","docId":"75","text":"\u003Cp\u003EAny appointed member may be removed by a majority vote of the City Council. If a vacancy occurs other than by expiration of a term, it shall be filled by the Mayor\u2019s appointment for the unexpired portion of the term.\u003C\/p\u003E\u003Cp\u003E(Ord. 1787, \u00a7 1 (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"8d0bc58d-32c0-498d-af1d-1230e065c611","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a3cd9039-19a3-4866-b7b2-a5a0deb71c4f\/b32c506d-1697-48f5-b959-c2d4f1d416ca","ref":{"parent":"a3cd9039-19a3-4866-b7b2-a5a0deb71c4f","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-213-15","docId":"75","text":"2.32.040 Chairperson.","id":"b32c506d-1697-48f5-b959-c2d4f1d416ca","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a3cd9039-19a3-4866-b7b2-a5a0deb71c4f\/b32c506d-1697-48f5-b959-c2d4f1d416ca\/9f658dfa-12bf-4ba8-ad28-277309327324","ref":{"parent":"b32c506d-1697-48f5-b959-c2d4f1d416ca","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-213-15-11","docId":"75","text":"\u003Cp\u003EThe commission shall elect its Chairperson and Vice- Chairperson from among its members. The terms of the Chairperson and Vice-Chairperson shall be for one year.\u003C\/p\u003E\u003Cp\u003E(Ord. 2015, \u00a7 7, 2008; Ord. 1787, \u00a7 1 (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"9f658dfa-12bf-4ba8-ad28-277309327324","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a3cd9039-19a3-4866-b7b2-a5a0deb71c4f\/e336c9d1-e4b6-4128-9ea2-51c27da110a2","ref":{"parent":"a3cd9039-19a3-4866-b7b2-a5a0deb71c4f","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-213-16","docId":"75","text":"2.32.050 Meetings.","id":"e336c9d1-e4b6-4128-9ea2-51c27da110a2","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a3cd9039-19a3-4866-b7b2-a5a0deb71c4f\/e336c9d1-e4b6-4128-9ea2-51c27da110a2\/14a67e81-5bda-4756-b8cc-f3727ca19f25","ref":{"parent":"e336c9d1-e4b6-4128-9ea2-51c27da110a2","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-213-16-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe City Planning Commission shall hold regular meetings on the second and fourth Tuesdays of each month at six forty-five p.m. and may adjourn any regular meeting to a date certain, which shall be specified in the order of adjournment and when so adjourned, such adjourned meeting shall be a regular meeting for all purposes. Such adjourned meetings may likewise be adjourned and any so adjourned meeting shall be a regular meeting for all purposes.\u003Cbr\u003E\nCity Planning Commission meetings that fall on legal holidays shall automatically be moved to the following day.\u003C\/li\u003E\u003Cli\u003ESpecial meetings of the Commission may be called at any time by the Chairperson or by any three or more members of the Commission upon written notice being given to all members of the Commission and received by them at least twenty-four hours prior to the meeting, unless notice requirement is waived in writing by the member.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1942, 2004; Ord. 1787, \u00a7 1 (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"14a67e81-5bda-4756-b8cc-f3727ca19f25","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a3cd9039-19a3-4866-b7b2-a5a0deb71c4f\/b0561cc6-ed37-490b-8cc3-143d467c0412","ref":{"parent":"a3cd9039-19a3-4866-b7b2-a5a0deb71c4f","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-213-17","docId":"75","text":"2.32.060 Amendments\u2013Records.","id":"b0561cc6-ed37-490b-8cc3-143d467c0412","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a3cd9039-19a3-4866-b7b2-a5a0deb71c4f\/b0561cc6-ed37-490b-8cc3-143d467c0412\/f64f55a1-3c0c-4690-b834-973392192fcd","ref":{"parent":"b0561cc6-ed37-490b-8cc3-143d467c0412","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-213-17-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe affirmative vote of not less than a majority of its total voting members is required to approve a recommendation to amend the zoning ordinance; a majority vote is required to take any other action.\u003C\/li\u003E\u003Cli\u003EThe Commission shall keep an accurate record of its proceedings and transactions, and shall render such reports to the Council as may be required by ordinance or resolution, and shall submit an annual report to the Mayor. These records shall be filed with the City Clerk.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 1 (part), 2018; Ord. 1787, \u00a7 1 (part), 1998; Ord. 24-2267, Att. A (part), 2024)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f64f55a1-3c0c-4690-b834-973392192fcd","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a3cd9039-19a3-4866-b7b2-a5a0deb71c4f\/8a2ca0d6-c14e-4cf8-bb61-ca39b3b23cff","ref":{"parent":"a3cd9039-19a3-4866-b7b2-a5a0deb71c4f","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-213-18","docId":"75","text":"2.32.070 Powers and Functions.","id":"8a2ca0d6-c14e-4cf8-bb61-ca39b3b23cff","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a3cd9039-19a3-4866-b7b2-a5a0deb71c4f\/8a2ca0d6-c14e-4cf8-bb61-ca39b3b23cff\/29475ec5-f0ad-4620-a44e-0257b6db4ec6","ref":{"parent":"8a2ca0d6-c14e-4cf8-bb61-ca39b3b23cff","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-213-18-11","docId":"75","text":"\u003Cp\u003EThe powers and functions of the City Planning Commission shall be as follows:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EPrepare, periodically review, and revise as necessary, the General Plan;\u003C\/li\u003E\u003Cli\u003EImplement the General Plan through actions including, but not limited to, the administration of specific plans and zoning, subdivisions, and sign ordinances;\u003C\/li\u003E\u003Cli\u003EAnnually review the capital improvement program of the City and the local public works projects of other local agencies for their consistency with the General Plan (pursuant to Sections 65400 et seq. of the California Government Code);\u003C\/li\u003E\u003Cli\u003EEndeavor to promote public interest in, comment upon, and understanding of the General Plan, and regulation relating to it;\u003C\/li\u003E\u003Cli\u003EConsult and advise with public officials and agencies, public utility companies, civic, educational, professional, and other organizations and citizens generally concerning implementation of the General Plan;\u003C\/li\u003E\u003Cli\u003EPromote the coordination of local plans and programs with the plans and programs of other agencies;\u003C\/li\u003E\u003Cli\u003EPerform other functions as the City Council provides including conducting studies and preparing plans other than those required or authorized by state law.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 23-2247, \u00a7 1 (part), 2023; Ord. 1844, \u00a7 1 (part), 2000; Ord. 1787, \u00a7 1 (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"29475ec5-f0ad-4620-a44e-0257b6db4ec6","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a3cd9039-19a3-4866-b7b2-a5a0deb71c4f\/baca9002-52cc-47db-90e3-d8e2254c46c5","ref":{"parent":"a3cd9039-19a3-4866-b7b2-a5a0deb71c4f","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-213-19","docId":"75","text":"2.32.080 Procedural Rules.","id":"baca9002-52cc-47db-90e3-d8e2254c46c5","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a3cd9039-19a3-4866-b7b2-a5a0deb71c4f\/baca9002-52cc-47db-90e3-d8e2254c46c5\/c38a915c-e2f6-4e12-b412-e3a711328526","ref":{"parent":"baca9002-52cc-47db-90e3-d8e2254c46c5","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-213-19-11","docId":"75","text":"\u003Cp\u003EThe Planning Commission may adopt from time to time such rules of procedure as it may deem necessary to properly exercise its powers and duties. Such rules shall be subject to approval by the Council before becoming effective. All such rules shall be kept on file with the Chairperson of the Planning Commission and the Mayor and a copy thereof shall be furnished to any person upon request.\u003C\/p\u003E\u003Cp\u003E(Ord. 1844, \u00a7 1 (part), 2000; Ord. 1787, \u00a7 1 (part), 1998)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"c38a915c-e2f6-4e12-b412-e3a711328526","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-214","docId":"75","text":"CHAPTER 2.36: PARK AND RECREATION COMMISSION*","id":"527644a0-ab7b-4e91-9a55-580227135c79","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/cc30a146-3e7d-4b3e-9c89-59a9f714799b","ref":{"parent":"527644a0-ab7b-4e91-9a55-580227135c79","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-214-11","docId":"75","text":"\u003Cp\u003E* For statutory provisions regarding parks and playgrounds, see Gov. Code \u00a7 38000 et seq.; for provisions regarding municipal control of certain parks, see Public Resources Code \u00a7 5181 et seq.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"cc30a146-3e7d-4b3e-9c89-59a9f714799b","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/f36da7ed-9d29-4ff4-8a06-ca28f3f19d7d","ref":{"parent":"527644a0-ab7b-4e91-9a55-580227135c79","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-214-12","docId":"75","text":"2.36.010 Established.","id":"f36da7ed-9d29-4ff4-8a06-ca28f3f19d7d","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/f36da7ed-9d29-4ff4-8a06-ca28f3f19d7d\/e0a9f332-93dc-4924-aa11-e102def39755","ref":{"parent":"f36da7ed-9d29-4ff4-8a06-ca28f3f19d7d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-214-12-11","docId":"75","text":"\u003Cp\u003EThe Parks and Recreation Commission of the City is established. The Parks and Recreation Commission shall consist of five members who are residents of the City, none of whom shall be officials or employees of the City, nor cohabit with as defined by law, nor be related by blood or marriage to any member of the Commission, the City Manager or the staff person(s) assigned to this Commission. The five members shall be appointed by the City Council.\u003C\/p\u003E\u003Cp\u003E(Ord. 1639, (part), 1993; Ord. 1460, (part), 1988; Ord. 1083, (part), 1980; Ord. 739, (part), 1976; Ord. 303, \u00a7 2.1, 1965)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"e0a9f332-93dc-4924-aa11-e102def39755","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/765d8a7f-1b17-4632-9f46-241487da5afe","ref":{"parent":"527644a0-ab7b-4e91-9a55-580227135c79","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-214-13","docId":"75","text":"2.36.020 Terms of Office.","id":"765d8a7f-1b17-4632-9f46-241487da5afe","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/765d8a7f-1b17-4632-9f46-241487da5afe\/2ac0d421-42db-43f6-82ee-67c5d59e3faa","ref":{"parent":"765d8a7f-1b17-4632-9f46-241487da5afe","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-214-13-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ECommissioners serve at the pleasure of the City Council. The term of office of the members of the Parks and Recreation Commission shall be for four years and shall end on January 30th of the year their term is due to expire. No commissioner shall serve more than two consecutive terms except that a commissioner may serve more than two consecutive terms if he or she has been appointed to the Commission to fill an unexpired term of less than two years.\u003C\/li\u003E\u003Cli\u003EThe appointment, reappointment and rules governing incumbent members of the Commission are governed by the Resolution of the Cupertino City Council which governs advisory bodies.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 2 (part), 2018; Ord. 1974, \u00a7 4 (part), 2006; Ord. 1639, (part), 1993; Ord. 1460, (part), 1988; Ord. 1321, \u00a7 1 (part), 1985; Ord. 1166, (part), 1982; Ord. 739, (part), 1976; Ord. 303, \u00a7 3.1, 1965)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"2ac0d421-42db-43f6-82ee-67c5d59e3faa","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/b38b67d0-1005-4708-978c-72692a4af8ff","ref":{"parent":"527644a0-ab7b-4e91-9a55-580227135c79","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-214-14","docId":"75","text":"2.36.030 Members\u2013Vacancy or Removal.","id":"b38b67d0-1005-4708-978c-72692a4af8ff","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/b38b67d0-1005-4708-978c-72692a4af8ff\/f791824f-ad8c-40c6-881a-a7fc59ecd9c5","ref":{"parent":"b38b67d0-1005-4708-978c-72692a4af8ff","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-214-14-11","docId":"75","text":"\u003Cp\u003EAny appointee member may be removed by a majority vote of the total membership of the City Council. If a vacancy occurs other than by expiration of a term, it shall be filled by the appointment by the City Council for the unexpired portion of the term.\u003C\/p\u003E\u003Cp\u003E(Ord. 15-2127, \u00a7 1, 2015; Ord. 303, \u00a7 4.1, 1965)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f791824f-ad8c-40c6-881a-a7fc59ecd9c5","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/eec2f299-745c-45e1-bbd8-4acec7319897","ref":{"parent":"527644a0-ab7b-4e91-9a55-580227135c79","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-214-15","docId":"75","text":"2.36.040 Chairperson.","id":"eec2f299-745c-45e1-bbd8-4acec7319897","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/eec2f299-745c-45e1-bbd8-4acec7319897\/0e2297f6-226d-438e-81d7-9cdf163e37be","ref":{"parent":"eec2f299-745c-45e1-bbd8-4acec7319897","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-214-15-11","docId":"75","text":"\u003Cp\u003EThe Commission shall elect its Chairperson and Vice-Chairperson from among its members. The terms of the Chairperson and Vice-Chairperson shall be for one year.\u003C\/p\u003E\u003Cp\u003E(Ord. 2015, \u00a7 6, 2008; Ord. 1697, (part), 1995; Ord. 1321, \u00a7 2 (part), 1985; Ord. 1167, (part), 1982; Ord. 303, \u00a7 5.1, 1965)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0e2297f6-226d-438e-81d7-9cdf163e37be","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/7acb940d-eeed-4778-95fd-0a04c00cafe3","ref":{"parent":"527644a0-ab7b-4e91-9a55-580227135c79","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-214-16","docId":"75","text":"2.36.050 Meetings.","id":"7acb940d-eeed-4778-95fd-0a04c00cafe3","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/7acb940d-eeed-4778-95fd-0a04c00cafe3\/f510c212-6434-4035-a9f0-0687d1505b38","ref":{"parent":"7acb940d-eeed-4778-95fd-0a04c00cafe3","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-214-16-11","docId":"75","text":"\u003Cp\u003EThe City Park and Recreation Commission shall establish a regular place of meeting and rules of conduct thereof, and shall hold at least one regular meeting each month. Special meetings of the Commission may be called at any time by the Chairman or by any three or more members of the Commission upon personal notice being given to all members of the Commission. If personal notice cannot be given, written notice must be mailed to such members at least twenty-four hours prior to the meeting, unless the notice requirement is waived in writing to the member.\u003C\/p\u003E\u003Cp\u003E(Ord. 1639, (part), 1993; Ord. 739, (part), 1976; Ord. 303, \u00a7 6.1, 1965)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f510c212-6434-4035-a9f0-0687d1505b38","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/ea7e3fce-bd4a-4bcd-8a25-d28b1557f834","ref":{"parent":"527644a0-ab7b-4e91-9a55-580227135c79","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-214-17","docId":"75","text":"2.36.060 Majority Vote Required.","id":"ea7e3fce-bd4a-4bcd-8a25-d28b1557f834","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/ea7e3fce-bd4a-4bcd-8a25-d28b1557f834\/d5dd2687-0aa0-401d-9008-d7bcce7092d7","ref":{"parent":"ea7e3fce-bd4a-4bcd-8a25-d28b1557f834","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-214-17-11","docId":"75","text":"\u003Cp\u003EA majority vote is required to approve a recommendation or on any matter that is presented to the Commission which requires a vote.\u003C\/p\u003E\u003Cp\u003E(Ord. 303, \u00a7 7.1, 1965)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d5dd2687-0aa0-401d-9008-d7bcce7092d7","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/4f3e6ca2-e8b9-4f4a-a74f-808fb9705a09","ref":{"parent":"527644a0-ab7b-4e91-9a55-580227135c79","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-214-18","docId":"75","text":"2.36.070 Records.","id":"4f3e6ca2-e8b9-4f4a-a74f-808fb9705a09","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/4f3e6ca2-e8b9-4f4a-a74f-808fb9705a09\/9defb7e7-ba2a-454b-a33b-06a8a52da223","ref":{"parent":"4f3e6ca2-e8b9-4f4a-a74f-808fb9705a09","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-214-18-11","docId":"75","text":"\u003Cp\u003EThe Commission shall keep an accurate record of its proceedings and transactions, and shall render such reports to the City Council as may be required. These records shall be filed with the City Clerk.\u003C\/p\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 2 (part), 2018; Ord. 15-2127, \u00a7 2, 2015; Ord. 303, \u00a7 7.2, 1965)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"9defb7e7-ba2a-454b-a33b-06a8a52da223","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/76eecc28-e710-4ca2-9d9d-c78d64c991a3","ref":{"parent":"527644a0-ab7b-4e91-9a55-580227135c79","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-214-19","docId":"75","text":"2.36.080 Powers and Functions.","id":"76eecc28-e710-4ca2-9d9d-c78d64c991a3","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/76eecc28-e710-4ca2-9d9d-c78d64c991a3\/3d7c2457-7796-40f2-a8c6-301328645392","ref":{"parent":"76eecc28-e710-4ca2-9d9d-c78d64c991a3","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-214-19-11","docId":"75","text":"\u003Cp\u003EThe powers and functions of the City Park and Recreation Commission shall be as follows:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ETo hold hearings on matters pertaining to planning and development of parks, cultural activities, historical resources, recreation, community services (including, but not limited to schools and senior services), and capital expenditures related to community activities and facilities;\u003C\/li\u003E\u003Cli\u003ETo conduct such other hearings as are necessary and in accordance with its own rules and regulations;\u003C\/li\u003E\u003Cli\u003ETo report its decisions and recommendations in writing to the City Council;\u003C\/li\u003E\u003Cli\u003ETo consider, formulate and propose programs, activities, resources, plans and development designed to provide for, regulate and direct the future growth and development of community activities, parks and a recreation system in order to secure to the City and its inhabitants better service;\u003C\/li\u003E\u003Cli\u003ETo make investigations and reports for future acquisition of park sites;\u003C\/li\u003E\u003Cli\u003ETo make, in its advisory capacity, any and all recommendations to the City Council relating to the above matters, including the extension of the parks, recreation system and community activities to outlying areas of the City;\u003C\/li\u003E\u003Cli\u003EIn cooperation with the Director of Recreation and Community Services, the Commission will consider, review, and evaluate parks, recreation programs, and community activities;\u003C\/li\u003E\u003Cli\u003ETo consider, formulate, and propose cultural activities and historical preservation for the City and its residents.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 2 (part), 2018; Ord. 15-2127, \u00a7 3, 2015; Ord. 739, (part), 1976; Ord. 497, \u00a7 1, 1971; Ord. 303, \u00a7 8.1, 1965)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"3d7c2457-7796-40f2-a8c6-301328645392","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/f3876993-39e5-4066-98cc-65401f639e39","ref":{"parent":"527644a0-ab7b-4e91-9a55-580227135c79","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-214-210","docId":"75","text":"2.36.085 Compensation\u2013Expenses.","id":"f3876993-39e5-4066-98cc-65401f639e39","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/f3876993-39e5-4066-98cc-65401f639e39\/4a6b8d27-9f67-4742-92e2-c1d18a364e47","ref":{"parent":"f3876993-39e5-4066-98cc-65401f639e39","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-214-210-11","docId":"75","text":"\u003Cp\u003EMembers of the Park and Recreation Commission shall serve without compensation. Commissioners may be reimbursed for necessary expenses reasonably incurred by them while acting in their official capacity subject to the approval of the City Manager.\u003C\/p\u003E\u003Cp\u003E(Ord. 21-2234, Att. A (\u00a7 2, part), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"4a6b8d27-9f67-4742-92e2-c1d18a364e47","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/42dad26d-8591-47d4-9299-af088b4b4cdd","ref":{"parent":"527644a0-ab7b-4e91-9a55-580227135c79","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-214-211","docId":"75","text":"2.36.090 Procedural Rules.","id":"42dad26d-8591-47d4-9299-af088b4b4cdd","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/42dad26d-8591-47d4-9299-af088b4b4cdd\/0a7e4af2-a614-4dc7-8ed2-72f4060f04a4","ref":{"parent":"42dad26d-8591-47d4-9299-af088b4b4cdd","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-214-211-11","docId":"75","text":"\u003Cp\u003EThe City Park and Recreation Commission may adopt from time to time such rules of procedure as it may deem necessary to properly exercise its functions. Such rules shall be recommended to the Director of Recreation and Community Services and shall be subject to approval by the City Council before becoming effective. All such rules shall be kept on file with the Chairman of the City Park and Recreation Commission, the department office, and the Mayor, and a copy thereof shall be furnished each Commissioner and any other person upon request.\u003C\/p\u003E\u003Cp\u003E(Ord. 15-2127, \u00a7 4, 2015; Ord. 303, \u00a7 9.1, 1965)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0a7e4af2-a614-4dc7-8ed2-72f4060f04a4","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/2a977893-6403-436a-bc81-20176213107c","ref":{"parent":"527644a0-ab7b-4e91-9a55-580227135c79","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-214-212","docId":"75","text":"2.36.110 Effect.","id":"2a977893-6403-436a-bc81-20176213107c","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/527644a0-ab7b-4e91-9a55-580227135c79\/2a977893-6403-436a-bc81-20176213107c\/28d8c925-1228-42fd-b772-4de7331aec9f","ref":{"parent":"2a977893-6403-436a-bc81-20176213107c","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-214-212-11","docId":"75","text":"\u003Cp\u003ENothing in this chapter shall be construed as restricting or curtailing any of the powers of the City Council or City Officers, or the delegation to the Parks and Recreation Commission of any authority or discretionary powers imposed by law in such Council or officers. The City Council declares that the public interest and convenience require the appointment of a Parks and Recreation Commission to act in a purely advisory capacity to such Council.\u003C\/p\u003E\u003Cp\u003E(Ord. 1083, (part), 1980)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"28d8c925-1228-42fd-b772-4de7331aec9f","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-215","docId":"75","text":"CHAPTER 2.40: EMERGENCY MANAGEMENT PROGRAM*","id":"9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/78ce5d31-1008-4284-9047-f40b7ae1b406","ref":{"parent":"9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-215-11","docId":"75","text":"\u003Cp\u003E* For the constitutional provision that states that any city may make and enforce within its limits all such local police, sanitary and other regulations as are not in conflict with general laws, see Calif. Const. Art. 11 \u00a7 11; for statutory provisions regarding the establishment and powers of local war or disaster councils, see Gov. Code \u00a7 8610 et seq. -- See Title 9, Health and Sanitation.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"78ce5d31-1008-4284-9047-f40b7ae1b406","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/2c0cc44e-53e7-4984-bb96-1caa62a92be3","ref":{"parent":"9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-215-12","docId":"75","text":"2.40.010 Purposes.","id":"2c0cc44e-53e7-4984-bb96-1caa62a92be3","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/2c0cc44e-53e7-4984-bb96-1caa62a92be3\/ebabdc52-8679-4798-9683-d5c78576cc86","ref":{"parent":"2c0cc44e-53e7-4984-bb96-1caa62a92be3","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-215-12-11","docId":"75","text":"\u003Cp\u003EThe declared purposes of this chapter are to provide for the design of the citywide emergency management program for the City of Cupertino. The emergency management program includes the preparation and carrying out of plans for the protection of persons and property within this City in the event of an emergency, the direction of the emergency organization, and the coordination of the emergency functions of this City with all other public agencies, corporations, organizations and affected private persons.\u003C\/p\u003E\u003Cp\u003E(Ord. 20-2216, \u00a7 2, 2020; Ord. 475, \u00a7 1, 1971)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"ebabdc52-8679-4798-9683-d5c78576cc86","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/a3bd763e-d92c-4c9a-a943-e167369d81e3","ref":{"parent":"9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-215-13","docId":"75","text":"2.40.020 Definition.","id":"a3bd763e-d92c-4c9a-a943-e167369d81e3","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/a3bd763e-d92c-4c9a-a943-e167369d81e3\/a89f8dde-54a4-418d-bfea-5338cb3f2d4d","ref":{"parent":"a3bd763e-d92c-4c9a-a943-e167369d81e3","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-215-13-11","docId":"75","text":"\u003Cp\u003EAs used in this chapter, \u0022emergency\u0022 means the actual or threatened existence of conditions of disaster or of extreme peril to the safety of persons, property and the environment within this City caused by but not limited to earthquakes, technological, natural and manmade disasters, conditions resulting from war or imminent threat of war, air pollution, fire, flood, storm, epidemic, or riot, but other than conditions resulting from a labor controversy, which conditions are or are likely to be, beyond the control of the services, personnel, equipment and facilities of this City, requiring the combined forces of other political subdivisions to combat.\u003C\/p\u003E\u003Cp\u003E(Ord. 15-2129, \u00a7 1, 2015; Ord. 1912, (part), 2003; Ord. 1697, (part), 1995; Ord. 475, \u00a7 2, 1971)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"a89f8dde-54a4-418d-bfea-5338cb3f2d4d","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/fede07b3-c604-4922-b767-af9a3c6c08f7","ref":{"parent":"9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-215-14","docId":"75","text":"2.40.025 Disaster Council.","id":"fede07b3-c604-4922-b767-af9a3c6c08f7","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/fede07b3-c604-4922-b767-af9a3c6c08f7\/ba73b6b6-5922-4d2b-88b8-b0bab3c70f31","ref":{"parent":"fede07b3-c604-4922-b767-af9a3c6c08f7","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-215-14-11","docId":"75","text":"\u003Cp\u003EPursuant to California Government Code section 8610, the Cupertino Disaster Council, shall have the following voting members:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe City Manager, or their designee, shall be chair.\u003C\/li\u003E\u003Cli\u003EThe Mayor, or their designee, shall be vice chair.\u003C\/li\u003E\u003Cli\u003EThe City Department Heads or their designee.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003EIn addition to its voting members, the Disaster Council shall include such representatives of civic, business, labor, veterans, professional, or other organizations having an official emergency responsibility, as may be appointed by the chair with the advice and consent of the governing body to advise the voting members.\u003C\/p\u003E\u003Cp\u003E(Ord. 20-2216, \u00a7 3, 2020; Ord. 15-2129, \u00a7 2, 2015; Ord. 1912, (part), 2003)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"ba73b6b6-5922-4d2b-88b8-b0bab3c70f31","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/caaab1c5-aaa2-45ed-98a3-96fa7be62b38","ref":{"parent":"9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-215-15","docId":"75","text":"2.40.030 Compliance with California Emergency Services Act.","id":"caaab1c5-aaa2-45ed-98a3-96fa7be62b38","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/caaab1c5-aaa2-45ed-98a3-96fa7be62b38\/7e82a82f-ddd0-43a2-bac8-34d4ee9979a2","ref":{"parent":"caaab1c5-aaa2-45ed-98a3-96fa7be62b38","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-215-15-11","docId":"75","text":"\u003Cp\u003EThe City of Cupertino Disaster Council shall comply with the California Emergency Services Act.\u003C\/p\u003E\u003Cp\u003E(Ord. 20-2216, \u00a7 4, 2020)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"7e82a82f-ddd0-43a2-bac8-34d4ee9979a2","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/81e8b28c-8e98-4ff9-9149-e991696b2c55","ref":{"parent":"9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-215-16","docId":"75","text":"2.40.040 Disaster Council Powers and Duties.","id":"81e8b28c-8e98-4ff9-9149-e991696b2c55","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/81e8b28c-8e98-4ff9-9149-e991696b2c55\/a7fd7984-72ae-4b45-a9cc-ea2ac349dd08","ref":{"parent":"81e8b28c-8e98-4ff9-9149-e991696b2c55","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-215-16-11","docId":"75","text":"\u003Cp\u003EThe Disaster Council shall have the following duties, powers and responsibilities, and such other as they may be entrusted with by the City Council from time to time:\u003C\/p\u003E\u003Col\u003E\u003Cli\u003EMeet at the discretion of the Chair, but no less than annually.\u003C\/li\u003E\u003Cli\u003EAdvise on and recommend for adoption emergency plans and mutual aid agreements based on the Standardized Emergency Management System (SEMS) as defined in the California Code of Regulations, Title 19, Division 2, Sections 2400 - 2450.\u003C\/li\u003E\u003Cli\u003EProvide guidance to develop disaster exercises, support community participation, assist with threat assessments, identify local resources and facilitate multi-agency\/inter-agency coordination within its membership and other local governments and special districts.\u003C\/li\u003E\u003Cli\u003EProvides oversight for engaging community members in homeland security, emergency planning and response and promoting community preparedness and family safety in three principal ways; through public education and outreach; through training opportunities; and, through volunteer programs that draw on special skills and interests.\u003C\/li\u003E\u003Cli\u003EProvide oversight responsibility for the California State Disaster Service Worker Volunteer Program (DSWVP). The City Office of Emergency Management manages the DSWVP through its Citizen Corps organization as established by the California Emergency Council pursuant to the provisions of California Government Code Section 8585.5.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 20-2216, \u00a7 5, 2020; Ord. 15-2129, \u00a7 3, 2015; Ord. 1912, (part), 2003; Ord. 1697 (part), 1995; Ord. 475, \u00a7 4, 1971)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"a7fd7984-72ae-4b45-a9cc-ea2ac349dd08","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/c7ebf977-4d46-41b3-8856-62134a8d760b","ref":{"parent":"9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-215-17","docId":"75","text":"2.40.050 Director of Emergency Services\u2013Designated.","id":"c7ebf977-4d46-41b3-8856-62134a8d760b","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/c7ebf977-4d46-41b3-8856-62134a8d760b\/d49ace41-601b-4079-95e3-2bd21db49151","ref":{"parent":"c7ebf977-4d46-41b3-8856-62134a8d760b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-215-17-11","docId":"75","text":"\u003Cp\u003EThe City Manager or their designee is designated the Director of Emergency Services for the purposes of disaster management under the Standardized Management System.\u003C\/p\u003E\u003Cp\u003E(Ord. 20-2216, \u00a7 6, 2020; Ord. 15-2129, \u00a7 5, 2015; Ord. 1912, (part), 2003; Ord. 1697, (part), 1995; Ord. 475, \u00a7 5, 1971)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d49ace41-601b-4079-95e3-2bd21db49151","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/8ad0d4bc-2e97-417d-b666-508e137a8bf6","ref":{"parent":"9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-215-18","docId":"75","text":"2.40.060 Director of Emergency Services\u2013Powers and Duties.","id":"8ad0d4bc-2e97-417d-b666-508e137a8bf6","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/8ad0d4bc-2e97-417d-b666-508e137a8bf6\/488eca9a-d5c5-4fc3-adb1-1a965d2db391","ref":{"parent":"8ad0d4bc-2e97-417d-b666-508e137a8bf6","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-215-18-11","docId":"75","text":"\u003Cp\u003EThe Director is empowered to:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ERequest the City Council to proclaim the existence or threatened existence of a \u0022local emergency\u0022 if the City Council is in session, or to issue such proclamation if the City Council is not in session. Whenever a local emergency is proclaimed by the Director, the City Council shall take action to ratify the proclamation within seven days thereafter or the proclamation shall have no further force or effect;\u003C\/li\u003E\u003Cli\u003ERequest the Governor to proclaim a \u0022state of emergency\u0022 when, in the opinion of the Director, the locally available resources are inadequate to cope with the emergency;\u003C\/li\u003E\u003Cli\u003EDevelop emergency plans with the assistance of the emergency organization for consideration by the Disaster Council and manage the emergency programs of this City;\u003C\/li\u003E\u003Cli\u003EControl and direct the effort of the emergency organization for this City for the accomplishment of the purposes of this chapter;\u003C\/li\u003E\u003Cli\u003EDirect cooperation between and coordination of services and staff of the emergency organization of this City; and resolve questions of authority and responsibility that may arise between them;\u003C\/li\u003E\u003Cli\u003ERepresent this City in all dealings with public or private agencies on matters pertaining to emergencies as defined herein;\u003C\/li\u003E\u003Cli\u003EIn the event of the proclamation of a \u0022local emergency\u0022 as herein provided, the proclamation of a \u0022state of emergency\u0022 by the Governor or the Director of the State Office of Emergency Services, or the existence of a \u0022state of war emergency,\u0022 the Director is empowered to:\u003Col\u003E\u003Cli\u003EMake and issue rules and regulations on matters reasonably related to the protection of life and property as affected by such emergency; provided, however, such rules and regulations must be confirmed at the earliest practicable time by the City Council;\u003C\/li\u003E\u003Cli\u003EObtain vital supplies, equipment, and such other properties found lacking and needed for the protection of life and property and to bind the City for the fair value thereof and, if required immediately, to commandeer the same for public use;\u003C\/li\u003E\u003Cli\u003ERequire emergency services of any City officer or employee and, in the event of the proclamation of a \u0022state of emergency\u0022 in the Santa Clara County Operational Area or the existence of a \u0022state of war emergency,\u0022 to command the aid of as many citizens of this community as the Director deems necessary in the execution of their duties; such persons shall be entitled to all privileges, benefits, and immunities as are provided by State law for registered disaster services workers;\u003C\/li\u003E\u003Cli\u003ERequisition necessary personnel or material of any City department or agency; and\u003C\/li\u003E\u003Cli\u003EExecute all their ordinary power as City Manager, all of the special powers conferred upon them by this chapter or by resolution or emergency plan pursuant hereto adopted by the City Council, all powers conferred upon them by any statute, by an agreement approved by the City Council, and by any other lawful authority.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 20-2216, \u00a7 7, 2020; Ord. 15-2129, \u00a7 6, 2015; Ord. 1697, (part), 1995; Ord. 475, \u00a7 6, 1971)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"488eca9a-d5c5-4fc3-adb1-1a965d2db391","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/956d068b-92e5-4966-81eb-f6b0b5fbbf09","ref":{"parent":"9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-215-19","docId":"75","text":"2.40.070 Emergency Organization\u2013Membership.","id":"956d068b-92e5-4966-81eb-f6b0b5fbbf09","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/956d068b-92e5-4966-81eb-f6b0b5fbbf09\/49683b3a-35fd-4af0-a839-cc930e85dc3e","ref":{"parent":"956d068b-92e5-4966-81eb-f6b0b5fbbf09","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-215-19-11","docId":"75","text":"\u003Cp\u003EAll officers and employees of this City, together with Citizen Corps, programs and volunteers and other volunteer forces enrolled to aid them during an emergency, and stakeholders, all groups, organizations, and persons who may by agreement or operation of law, including persons impressed into service under the provisions of Section 2.40.060(G)(3) of this chapter, be charged with duties incident to the protection of life, property and the environment in this City during such emergency, shall constitute the emergency organization of the City.\u003C\/p\u003E\u003Cp\u003E(Ord. 15-2129, \u00a7 7, 2015; Ord. 1912, (part), 2003; Ord. 475, \u00a7 7, 1971)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"49683b3a-35fd-4af0-a839-cc930e85dc3e","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/069d6bb4-431c-4909-b211-05ed576951d0","ref":{"parent":"9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-215-210","docId":"75","text":"2.40.080 Emergency Organization\u2013Structure, Duties and Functions.","id":"069d6bb4-431c-4909-b211-05ed576951d0","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/069d6bb4-431c-4909-b211-05ed576951d0\/171eb11b-9fd7-4ac1-9c01-bd7493cf2180","ref":{"parent":"069d6bb4-431c-4909-b211-05ed576951d0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-215-210-11","docId":"75","text":"\u003Cp\u003EThe City Emergency Organization functions under the Standardized Emergency Management System. Representatives of the Emergency Organization have specific duties and responsibilities to train, plan for and participate in the City\u2019s emergency management response, as assigned by the Director of Emergency Services. These responsibilities are outlined in the Cupertino Emergency Operations Plan.\u003C\/p\u003E\u003Cp\u003EThe structure, duties, and functions of the emergency organization and the order of emergency succession to the position of Director of Emergency Services, shall be adopted by resolution of the City Council.\u003C\/p\u003E\u003Cp\u003E(Ord. 20-2216, \u00a7 8, 2020; Ord. 1912, (part), 2003; Ord. 475, \u00a7 8, 1971)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"171eb11b-9fd7-4ac1-9c01-bd7493cf2180","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/b7f567d6-87e0-4f60-a52f-affed2274696","ref":{"parent":"9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-215-211","docId":"75","text":"2.40.090 Mutual Aid.","id":"b7f567d6-87e0-4f60-a52f-affed2274696","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/b7f567d6-87e0-4f60-a52f-affed2274696\/1c961eb9-2c3a-410a-9994-ee90573131a1","ref":{"parent":"b7f567d6-87e0-4f60-a52f-affed2274696","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-215-211-11","docId":"75","text":"\u003Cp\u003EIt is the purpose of the City Council in enacting the ordinance codified herein to facilitate the rendering of mutual aid to and for the people of this City. Emergency plans adopted and approved by the City Council shall provide for the interchange of mutual aid and for coordination with the emergency plans of the Santa Clara County Operational Area.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. 475, \u00a7 9, 1971)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"1c961eb9-2c3a-410a-9994-ee90573131a1","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/7b48543a-9f75-43e6-91a6-ebcf016959d0","ref":{"parent":"9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-215-212","docId":"75","text":"2.40.100 Expenditures.","id":"7b48543a-9f75-43e6-91a6-ebcf016959d0","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/7b48543a-9f75-43e6-91a6-ebcf016959d0\/4c83f898-2a5d-4669-a9f4-17eed82a1877","ref":{"parent":"7b48543a-9f75-43e6-91a6-ebcf016959d0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-215-212-11","docId":"75","text":"\u003Cp\u003EAny expenditures made in connection with emergency activities, including mutual aid activities, shall be deemed conclusively to be for the direct protection and benefit of the inhabitants and property of the City.\u003C\/p\u003E\u003Cp\u003E(Ord. 475, \u00a7 10, 1971)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"4c83f898-2a5d-4669-a9f4-17eed82a1877","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/c50d5896-0d73-4260-ac4f-1cd8b9d4c6cf","ref":{"parent":"9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-215-213","docId":"75","text":"2.40.110 Violation\u2013Penalty.","id":"c50d5896-0d73-4260-ac4f-1cd8b9d4c6cf","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/9dd7eeba-0f0a-4205-bf1a-e819c56ae5f5\/c50d5896-0d73-4260-ac4f-1cd8b9d4c6cf\/176d7547-e02d-4502-9c40-a82590857ed8","ref":{"parent":"c50d5896-0d73-4260-ac4f-1cd8b9d4c6cf","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-215-213-11","docId":"75","text":"\u003Cp\u003EIt shall be a violation of this Chapter for any person during an emergency to:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EWillfully obstruct, hinder, or delay any member of the emergency organization in the enforcement of any lawful rule or regulation issued pursuant to this chapter, or in the performance of any duty imposed upon them by virtue of this chapter;\u003C\/li\u003E\u003Cli\u003EDo any act forbidden by any lawful rule or regulation issued pursuant to this chapter, if such act is of such a nature as to give or be likely to give assistance to the enemy or to imperil the lives or property of inhabitants of this City, or to prevent, hinder, or delay the defense or protection thereof;\u003C\/li\u003E\u003Cli\u003EWear, carry, or display without authority any means of identification specified by the emergency agency of the state.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003EThe City may address violations of this Chapter by issuing administrative citations, fines, and penalties as set forth in Chapter 1.10 of this Code. Alternatively, the City may prosecute any violation of this Chapter as a misdemeanor, punishable as provided in Chapter 1.12 of this Code. Law enforcement officers of the Santa Clara County Sheriff\u0027s Office are authorized to enforce this Chapter.\u003C\/p\u003E\u003Cp\u003E(Ord. 20-2216, \u00a7 9, 2020; Ord. 475, \u00a7 11, 1971)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"176d7547-e02d-4502-9c40-a82590857ed8","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/d73b76aa-4173-40a9-b32f-c215b046ffc8","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-216","docId":"75","text":"CHAPTER 2.48: DEPARTMENTAL ORGANIZATION","id":"d73b76aa-4173-40a9-b32f-c215b046ffc8","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/d73b76aa-4173-40a9-b32f-c215b046ffc8\/94e7c303-ee9d-419d-9a82-38821e899531","ref":{"parent":"d73b76aa-4173-40a9-b32f-c215b046ffc8","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-216-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"94e7c303-ee9d-419d-9a82-38821e899531","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/d73b76aa-4173-40a9-b32f-c215b046ffc8\/3caf5852-8b56-41e3-bd67-22f1b532d2f2","ref":{"parent":"d73b76aa-4173-40a9-b32f-c215b046ffc8","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-216-12","docId":"75","text":"2.48.010 Purpose.","id":"3caf5852-8b56-41e3-bd67-22f1b532d2f2","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/d73b76aa-4173-40a9-b32f-c215b046ffc8\/3caf5852-8b56-41e3-bd67-22f1b532d2f2\/c921a79b-77c8-4f20-81a3-f85593c1d37c","ref":{"parent":"3caf5852-8b56-41e3-bd67-22f1b532d2f2","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-216-12-11","docId":"75","text":"\u003Cp\u003EThe purpose of this chapter is to provide for a more efficient organizational structure for the City, to designate its departments and divisions, and to describe their functions.\u003C\/p\u003E\u003Cp\u003E(Ord. 484, \u00a7 1, 1971)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"c921a79b-77c8-4f20-81a3-f85593c1d37c","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/d73b76aa-4173-40a9-b32f-c215b046ffc8\/de7bef98-50d8-4b26-8b44-c685cff38349","ref":{"parent":"d73b76aa-4173-40a9-b32f-c215b046ffc8","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-216-13","docId":"75","text":"2.48.020 Departments and Divisions.","id":"de7bef98-50d8-4b26-8b44-c685cff38349","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/d73b76aa-4173-40a9-b32f-c215b046ffc8\/de7bef98-50d8-4b26-8b44-c685cff38349\/b19ebead-272a-4a01-959b-9b43a9b1acff","ref":{"parent":"de7bef98-50d8-4b26-8b44-c685cff38349","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-216-13-11","docId":"75","text":"\u003Cp\u003EThe following departments are established:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EDepartment of Finance.\u003Col\u003E\u003Cli\u003EThis department shall consist of the following divisions:\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\u003Cli\u003EAccounting Division. This division shall be responsible for the day-to-day processing of fiscal records, maintenance of the City\u2019s general ledger, preparation of financial statements, coordination of the annual audit, and ensuring compliance with applicable accounting standards and reporting requirements.\u003C\/li\u003E\u003Cli\u003EBudget Division. This division shall be responsible for the preparation and administration of the annual operating and capital budgets, long-range financial planning, monitoring of revenues and expenditures, and the preparation of financial analyses and reports.\u003C\/li\u003E\u003Cli\u003EPurchasing Division. This division shall be responsible for the administration and oversight of the City\u2019s procurement processes, including the development and implementation of purchasing policies and procedures, coordination of formal solicitations, ensuring compliance with applicable laws and regulations, while also supporting grant management. This hybrid approach requires purchasing activities to be carried out by departments, with the Purchasing Division providing guidance, review, and oversight to promote consistency, efficiency, and accountability.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EThe Director of Finance shall be head of this department, being responsible for all divisions within the Department.\u003C\/li\u003E\u003Cli\u003EThe Director of Finance also shall be appointed Treasurer and also shall act as ex officio Assessor and shall assess and collect all City taxes save and except for those collected by State and County officers for the City.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EDepartment of Public Works.\u003Col\u003E\u003Cli\u003EThis department shall have the following divisions:\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\u003Cli\u003EAdministrative Division. This division shall be responsible for providing general administration for the Department of Public Works, including general oversight and management of the municipal water system lease.\u003C\/li\u003E\u003Cli\u003EDevelopment Services Division. This division shall be responsible for all coordination of reviews for private development applications as well as permitting for encroachments into the public right of way.\u003C\/li\u003E\u003Cli\u003EStreets Division. This division shall be responsible for the maintenance of all streets, storm drains, street lights, sidewalks, curbs, gutters, easements and medians.\u003C\/li\u003E\u003Cli\u003EFacilities and Fleet Division. This division shall be responsible for all buildings, and the maintenance of the city\u2019s vehicle and equipment fleet.\u003C\/li\u003E\u003Cli\u003EGrounds Division. This division shall be responsible for the maintenance of all park sites, leased school sites and grounds around other City owned properties.\u003C\/li\u003E\u003Cli\u003ETrees and Right of Way Division. This division shall be responsible for public trees, street medians, and other landscaped areas within the public right of way.\u003C\/li\u003E\u003Cli\u003ETransportation Division. This division shall be responsible for the planning and design of transportation facilities, oversight of the Safe Routes to Schools Program, and the operation and maintenance of the city\u2019s traffic signals.\u003C\/li\u003E\u003Cli\u003EEnvironmental Programs Division. This division shall be responsible for the garbage and recycling franchised hauler contract and provides garbage and recycling customer service for residents and business owners, as well as overseeing compliance with the state stormwater permit.\u003C\/li\u003E\u003Cli\u003ECapital Improvement Program (CIP) Division. This division shall be responsible for the design and construction administration for all capital improvement projects including streets, storm drainage, buildings, parks, and other public facilities.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EThe Director of Public Works shall be the head of this department.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EDepartment of Parks and Recreation.\u003Col\u003E\u003Cli\u003EThis department shall be responsible for:\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\u003Cli\u003EAll recreational programs and services sponsored by the City;\u003C\/li\u003E\u003Cli\u003EManagement of all recreation facilities including Quinlan Community Center, Sports Center, Senior Center, and Monta Vista Recreation Center;\u003C\/li\u003E\u003Cli\u003EOperation and management of Blackberry Farm golf course and picnic grounds;\u003C\/li\u003E\u003Cli\u003EPlanning and development of existing and future park sites.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EThe Director of Parks and Recreation shall be the head of this department.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EDepartment of Public Safety.\u003Col\u003E\u003Cli\u003EThis department shall be responsible for law enforcement and fire protection services. However, since these services are presently contracted for or provided by a special district, this department shall not be implemented, and the Director of Public Safety shall not be appointed, until the City Council, by appropriate ordinance, resolution, or other action, determines to administer its own law enforcement and\/or fire protection services.\u003C\/li\u003E\u003Cli\u003EThe Director of Public Safety shall be the head of this department. He shall also be appointed Chief of Police and Fire Chief.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EDepartment of Innovation \u0026amp; Technology.\u003Col\u003E\u003Cli\u003EThis department shall have the following divisions:\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\u003Cli\u003EApplications Division. This division is responsible for development, procurement, project management, implementation and ongoing maintenance of all enterprise-level and online applications, and the maintenance of the City\u2019s website.\u003C\/li\u003E\u003Cli\u003EInfrastructure Division. This division provides for all technology-related expenses for the citywide management of information technology services.\u003C\/li\u003E\u003Cli\u003EGIS Division. This division captures, manages, analyzes, and displays all forms of geographically referenced information for the City.\u003C\/li\u003E\u003Cli\u003EInnovation Technology Division. This division is responsible for strategic planning, governance, policy setting, and overall administration of the department.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EThe Chief Technology Officer shall be the head of this department.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 21-2234, Att. A (\u00a7 3), 2021; Ord. 18-2173, 2018; Ord. 2056, (part), 2010; Ord. 1697, (part), 1995; Ord. 1678, 1995; Ord. 1623, 1993; Ord. 1480, 1989: Ord. 1065, 1980; Ord. 484, \u00a7 2, 1971; Ord. 26-2283, Att. A \u00a7 4, 2026)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"b19ebead-272a-4a01-959b-9b43a9b1acff","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/d73b76aa-4173-40a9-b32f-c215b046ffc8\/a3b807db-3058-4a24-ae73-9db51ee94b24","ref":{"parent":"d73b76aa-4173-40a9-b32f-c215b046ffc8","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-216-14","docId":"75","text":"2.48.030 Authority of City Manager.","id":"a3b807db-3058-4a24-ae73-9db51ee94b24","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/d73b76aa-4173-40a9-b32f-c215b046ffc8\/a3b807db-3058-4a24-ae73-9db51ee94b24\/da793873-c199-48d3-93fa-8380ac4fcab7","ref":{"parent":"a3b807db-3058-4a24-ae73-9db51ee94b24","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-216-14-11","docId":"75","text":"\u003Cp\u003EAll department heads, without limitation, shall be appointed by, and responsible to, the City Manager. The City Manager shall have authority to eliminate any division, to add new divisions, to alter their functions, and to reassign personnel from one division or department to another division or department.\u003C\/p\u003E\u003Cp\u003E(Ord. 484, \u00a7 3, 1971)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"da793873-c199-48d3-93fa-8380ac4fcab7","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/d73b76aa-4173-40a9-b32f-c215b046ffc8\/8779316e-aa37-4ceb-a672-f0101c580cac","ref":{"parent":"d73b76aa-4173-40a9-b32f-c215b046ffc8","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-216-15","docId":"75","text":"2.48.040 Authority of Director of Public Works and City Engineer to Approve Plans and Designs.","id":"8779316e-aa37-4ceb-a672-f0101c580cac","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/d73b76aa-4173-40a9-b32f-c215b046ffc8\/8779316e-aa37-4ceb-a672-f0101c580cac\/a07631eb-2eb5-4226-8706-77fb1bbc8d70","ref":{"parent":"8779316e-aa37-4ceb-a672-f0101c580cac","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-216-15-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe Director of Public Works if a licensed professional engineer designated by the State of California, and the City Engineer as a licensed professional engineer designated by the State of California, are delegated the authority to exercise discretionary approval (\u201cDesign Approval\u201d) of plans, designs and any design amendments or addenda for any public improvement or subdivision improvement project of the City of Cupertino (\u201cPublic Improvements\u201d). The Director of Public Works or the City Engineer shall sign the plans and designs to attest their approval.\\\u003C\/li\u003E\u003Cli\u003EDesign Approval of Public Improvements shall be exercised broadly, in accordance with state law, and shall include the authority to approve modifications to plans or designs previously accepted by the City; approval of City standard details and specifications for design and construction of Public Improvements; acceptance of Public Improvements on behalf of the City; and issuance of notices of completion, cessation notices, and any other instruments and documents related to the exercise of Design Approval of Public Improvements.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 18-2173, 2018)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"a07631eb-2eb5-4226-8706-77fb1bbc8d70","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-217","docId":"75","text":"CHAPTER 2.52: PERSONNEL CODE","id":"b251f995-30d9-4d2a-aff3-8ec07415be31","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/52bee0b7-261a-486c-8edd-7c1d943354f2","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"52bee0b7-261a-486c-8edd-7c1d943354f2","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/464cb608-06b5-4fbd-93ed-29d2bc8fe2d1","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-12","docId":"75","text":"2.52.010 Purpose.","id":"464cb608-06b5-4fbd-93ed-29d2bc8fe2d1","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/464cb608-06b5-4fbd-93ed-29d2bc8fe2d1\/d131f565-fd34-483e-a49a-3335de9d90f6","ref":{"parent":"464cb608-06b5-4fbd-93ed-29d2bc8fe2d1","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-12-11","docId":"75","text":"\u003Cp\u003EThe purpose of this chapter is to establish for the City a system of personnel administration creating equitable and uniform procedures applicable to all employees, supervisors, officers and citizens of the City and to assure the recruitment and retention of the most competent persons available.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 1, Art. 1 \u00a7 12:1.11, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d131f565-fd34-483e-a49a-3335de9d90f6","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/19df94d7-e93a-4ab8-8c18-99117397add9","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-13","docId":"75","text":"2.52.020 Adoption of System.","id":"19df94d7-e93a-4ab8-8c18-99117397add9","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/19df94d7-e93a-4ab8-8c18-99117397add9\/0367c4e5-8c13-453d-935c-c44f08fa0f3f","ref":{"parent":"19df94d7-e93a-4ab8-8c18-99117397add9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-13-11","docId":"75","text":"\u003Cp\u003EThe system of personnel administration referred to in Section 2.52.010 and as hereinafter more specifically described and cited as the Personnel Code is adopted.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 1, Art. 1 \u00a7 12:1.12, 1970).\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0367c4e5-8c13-453d-935c-c44f08fa0f3f","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/7ad74c8f-7af1-457e-a147-be7ef8b51f77","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-14","docId":"75","text":"2.52.030 Legislative Intent.","id":"7ad74c8f-7af1-457e-a147-be7ef8b51f77","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/7ad74c8f-7af1-457e-a147-be7ef8b51f77\/92bb9918-2218-4b25-b5a1-ddfbe10b21c3","ref":{"parent":"7ad74c8f-7af1-457e-a147-be7ef8b51f77","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-14-11","docId":"75","text":"\u003Cp\u003EThe City Council declares its intent that this Personnel Code shall be the enabling act under which administrative rules and regulations may be formulated, adopted, amended, enforced and repealed with the same force and effectiveness as if said administrative rules and regulations were set forth herein; the reason being that the quality of personnel administration is dependent upon employer-employee flexibility to meet all aspects of the evolutionary processes inherent in interpersonal relationships.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 1, Art. 1 \u00a7 12:1.13, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"92bb9918-2218-4b25-b5a1-ddfbe10b21c3","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/e82bc32f-1ba7-45a8-9f84-80c39fe2bce2","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-15","docId":"75","text":"2.52.040 Jurisdictions\u2013Designated.","id":"e82bc32f-1ba7-45a8-9f84-80c39fe2bce2","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/e82bc32f-1ba7-45a8-9f84-80c39fe2bce2\/0d28d5f6-d0d3-4188-89eb-b60ee6c6c4fe","ref":{"parent":"e82bc32f-1ba7-45a8-9f84-80c39fe2bce2","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-15-11","docId":"75","text":"\u003Cp\u003EThere are created four jurisdictions, as defined in this section, to which all officers and employees of the City shall be subject, except as otherwise excluded under Section 2.52.050 or as exempted under Section 2.52.060; Jurisdiction A: classification and pay; Jurisdiction B: merit and fitness; Jurisdiction C: conditions of employment; and Jurisdiction D: employer-employee relations.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. V, Art. 2 \u00a7 12:1.21, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0d28d5f6-d0d3-4188-89eb-b60ee6c6c4fe","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/a05ccdf8-9c01-4fd9-b3f6-5f51876739e1","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-16","docId":"75","text":"2.52.050 Jurisdictions\u2013Exclusions.","id":"a05ccdf8-9c01-4fd9-b3f6-5f51876739e1","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/a05ccdf8-9c01-4fd9-b3f6-5f51876739e1\/f325bc25-e8e8-42bb-a69a-ff0e2921a5e5","ref":{"parent":"a05ccdf8-9c01-4fd9-b3f6-5f51876739e1","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-16-11","docId":"75","text":"\u003Cp\u003EThe following offices, positions and employees are excluded from jurisdictions A, B, C and D:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EAll elected officers;\u003C\/li\u003E\u003Cli\u003ECity Manager;\u003C\/li\u003E\u003Cli\u003ECity Attorney;\u003C\/li\u003E\u003Cli\u003EChairmen and members of appointed boards, commissions and committees;\u003C\/li\u003E\u003Cli\u003EPersons engaged under contract to supply expert, professional, technical or other services.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. XII, Ch. 1, Art. 2 \u00a7 12:1.22, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f325bc25-e8e8-42bb-a69a-ff0e2921a5e5","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/69665f28-2451-43b0-b79e-0e2b2696ebf7","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-17","docId":"75","text":"2.52.060 Jurisdictions\u2013Exemptions.","id":"69665f28-2451-43b0-b79e-0e2b2696ebf7","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/69665f28-2451-43b0-b79e-0e2b2696ebf7\/42d02edd-d99a-40a6-93ed-9e364f2038fe","ref":{"parent":"69665f28-2451-43b0-b79e-0e2b2696ebf7","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-17-11","docId":"75","text":"\u003Cp\u003EThe following offices, positions and employees are exempt from Jurisdiction B:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EDepartment directors, designated as such by resolution of the City Council;\u003C\/li\u003E\u003Cli\u003EEmployees serving under appointments of provisional, exempt, temporary or emergency status;\u003C\/li\u003E\u003Cli\u003EThe Secretary to the City Manager;\u003C\/li\u003E\u003Cli\u003EThe Secretary to the City Attorney.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. 701, \u00a7 1, 1975; Ord. XII, Ch. 1, Art. 2 \u00a7 12:1.23, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"42d02edd-d99a-40a6-93ed-9e364f2038fe","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/094f5fd0-5749-4f43-a304-e60f89ddce78","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-18","docId":"75","text":"2.52.070 Repeal of Provisions Not Specifically Included.","id":"094f5fd0-5749-4f43-a304-e60f89ddce78","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/094f5fd0-5749-4f43-a304-e60f89ddce78\/f2d35063-35ac-4ee9-9b6f-5fd530986fa8","ref":{"parent":"094f5fd0-5749-4f43-a304-e60f89ddce78","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-18-11","docId":"75","text":"\u003Cp\u003EAll provisions and conditions of ordinances or resolutions of the City Council relating to the employment of persons by the City are negated and superseded by this chapter and the rules and regulations derived therefrom.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 1, Art. 3 \u00a7 12:1.31, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f2d35063-35ac-4ee9-9b6f-5fd530986fa8","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/a452a7e7-2811-466e-8c9e-1ee80ee8d966","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-19","docId":"75","text":"2.52.080 Retention of Accruals and Credits.","id":"a452a7e7-2811-466e-8c9e-1ee80ee8d966","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/a452a7e7-2811-466e-8c9e-1ee80ee8d966\/f29bec1e-e301-4194-a216-e9d5a88fe919","ref":{"parent":"a452a7e7-2811-466e-8c9e-1ee80ee8d966","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-19-11","docId":"75","text":"\u003Cp\u003ENothing contained in this chapter shall be construed so as to deprive any employee of those benefit accruals and credits earned by or granted to him prior to the effective date of the ordinance codified herein.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 1, Art. 3 \u00a7 12:1.32, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f29bec1e-e301-4194-a216-e9d5a88fe919","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/f52453aa-7b33-425d-81ad-cafc184e8bca","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-210","docId":"75","text":"2.52.090 City Council Authority.","id":"f52453aa-7b33-425d-81ad-cafc184e8bca","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/f52453aa-7b33-425d-81ad-cafc184e8bca\/da476e40-35e3-4485-be46-6f15ba342ce1","ref":{"parent":"f52453aa-7b33-425d-81ad-cafc184e8bca","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-210-11","docId":"75","text":"\u003Cp\u003EThe City Council specifically retains all power and obligations vested in it by law but for purposes of this personnel code has the following specific duties and responsibilities:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ETo approve the resolutions, rules and regulations and any amendments thereto by which the Personnel Code is administered;\u003C\/li\u003E\u003Cli\u003ETo receive and take appropriate action on recommendations submitted to it by the City Manager or other interested persons or groups;\u003C\/li\u003E\u003Cli\u003ETo conduct on its own initiative any investigation of the Personnel Code.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 601, \u00a7\u00a7 2.1, 2.2, 1973; Ord. XII, Ch. 2, Art. 1 \u00a7 12:2.11, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"da476e40-35e3-4485-be46-6f15ba342ce1","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/7a521a51-e669-4a86-9fd7-e6a1cceca66d","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-211","docId":"75","text":"2.52.100 City Manager Authority.","id":"7a521a51-e669-4a86-9fd7-e6a1cceca66d","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/7a521a51-e669-4a86-9fd7-e6a1cceca66d\/aa09c50a-7c6b-45a7-9c6c-5cdc006699b4","ref":{"parent":"7a521a51-e669-4a86-9fd7-e6a1cceca66d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-211-11","docId":"75","text":"\u003Cp\u003EThe City Manager shall be the appointing authority and Chief Administrative Officer of the Personnel Code and as such shall have the following duties and responsibilities:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ETo appoint persons to and remove persons from positions subject to the provisions of this chapter;\u003C\/li\u003E\u003Cli\u003ETo appoint or employ such technical and professional assistants as may be necessary to assist him in the proper discharge of his duties in administering this chapter;\u003C\/li\u003E\u003Cli\u003ETo prepare and submit to the City Council such proposed resolutions, rules and regulations to effect a pay plan, a classification plan, rules governing conditions of employment and, at any time subsequent thereto, such amendments as in his opinion are necessary or desirable for the orderly administration of this Personnel Code;\u003C\/li\u003E\u003Cli\u003ETo prepare and adopt such administrative regulations as he may deem desirable to supplement, but not to exceed or supplant the provisions of the immediately preceding subsection C;\u003C\/li\u003E\u003Cli\u003ETo promote harmonious employer-employee relations as being in the best interest of the City and to administer appropriate disciplinary action when he deems such action to be necessary;\u003C\/li\u003E\u003Cli\u003ETo prepare and provide to the City Council such reports on personnel matters as may be requested by the Council or as he may otherwise wish to do on his own volition.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. 601, \u00a7 2.3, 1973; Ord. XII, Ch. 2, Art. 1 \u00a7 12:2.12, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"aa09c50a-7c6b-45a7-9c6c-5cdc006699b4","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/3dc9a575-6bad-43b8-bc88-7de56dc40db2","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-212","docId":"75","text":"2.52.120 Rules and Regulations\u2013Scope and Applicability.","id":"3dc9a575-6bad-43b8-bc88-7de56dc40db2","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/3dc9a575-6bad-43b8-bc88-7de56dc40db2\/eb4ee3b9-dc4e-4535-a302-da7b8876cfb0","ref":{"parent":"3dc9a575-6bad-43b8-bc88-7de56dc40db2","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-212-11","docId":"75","text":"\u003Cp\u003EThe regulatory and permissive provisions by which this Personnel Code will be governed shall be by resolutions of the City Council and duly adopted administrative rules and regulations.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 2, Art. 2 \u00a7 12:2.21, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"eb4ee3b9-dc4e-4535-a302-da7b8876cfb0","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/230f5fa4-eba3-48c2-a739-af762a360f75","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-213","docId":"75","text":"2.52.130 Rules and Regulations\u2013Adoption and Effectiveness.","id":"230f5fa4-eba3-48c2-a739-af762a360f75","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/230f5fa4-eba3-48c2-a739-af762a360f75\/b39701fb-5bc5-4057-9177-aa95d69ff2d9","ref":{"parent":"230f5fa4-eba3-48c2-a739-af762a360f75","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-213-11","docId":"75","text":"\u003Cp\u003EResolutions of the City Council and administrative rules and regulations formulated under this Personnel Code shall be filed with the City Clerk after having been duly adopted and on the filing shall become effective the same as if having been incorporated herein.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 2, Art. 2 \u00a7 12:2.22, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"b39701fb-5bc5-4057-9177-aa95d69ff2d9","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/b4eb3098-89c5-4d63-9af3-210553535352","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-214","docId":"75","text":"2.52.140 Jurisdiction A\u2013Classification Plan\u2013Purpose.","id":"b4eb3098-89c5-4d63-9af3-210553535352","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/b4eb3098-89c5-4d63-9af3-210553535352\/27e3cc51-e938-4299-9a96-ed95575f497d","ref":{"parent":"b4eb3098-89c5-4d63-9af3-210553535352","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-214-11","docId":"75","text":"\u003Cp\u003EThere shall be a classification plan covering all positions subject to Jurisdiction A to provide for the establishment of groups of positions substantially similar with respect to duties, responsibilities and working conditions so that the same schedules of compensation may be applied with equity to all positions in the same class.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 3, Art. 1 \u00a7 12:3.11, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"27e3cc51-e938-4299-9a96-ed95575f497d","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/a3baf3e7-1512-43ab-bd78-1a43b8a7114b","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-215","docId":"75","text":"2.52.150 Jurisdiction A\u2013Classification Plan\u2013Adoption.","id":"a3baf3e7-1512-43ab-bd78-1a43b8a7114b","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/a3baf3e7-1512-43ab-bd78-1a43b8a7114b\/66c330bc-ebe5-47fa-a448-2e0ba6e3b1e8","ref":{"parent":"a3baf3e7-1512-43ab-bd78-1a43b8a7114b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-215-11","docId":"75","text":"\u003Cp\u003EThe classification plan shall be adopted in its effective form as a resolution of the City Council.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. XII, Ch. 3, Art. 1 \u00a7 12:3.12, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"66c330bc-ebe5-47fa-a448-2e0ba6e3b1e8","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/31155de3-23d4-447f-b314-73d8f0048de3","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-216","docId":"75","text":"2.52.160 Jurisdiction A\u2013Classification Plan\u2013Provisions Included.","id":"31155de3-23d4-447f-b314-73d8f0048de3","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/31155de3-23d4-447f-b314-73d8f0048de3\/638e1427-4676-4e5e-a88b-54b47aeec64b","ref":{"parent":"31155de3-23d4-447f-b314-73d8f0048de3","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-216-11","docId":"75","text":"\u003Cp\u003EThe classification plan shall include a job description for each position; class titles and specifications; and an allocation listing of positions to classifications.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. XII, Ch. 3, Art. 1 \u00a7 12:3.13, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"638e1427-4676-4e5e-a88b-54b47aeec64b","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/910d04ef-de36-424f-b201-606d5d8cd7ed","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-217","docId":"75","text":"2.52.180 Jurisdiction A\u2013Pay Plan\u2013Purpose.","id":"910d04ef-de36-424f-b201-606d5d8cd7ed","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/910d04ef-de36-424f-b201-606d5d8cd7ed\/0c2dfb2d-857c-4ccf-81fc-6443b5ce9efa","ref":{"parent":"910d04ef-de36-424f-b201-606d5d8cd7ed","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-217-11","docId":"75","text":"\u003Cp\u003EThere shall be a pay plan governing the rates and methods of compensation for all employees subject to Jurisdiction A so as to provide for equitable salary ranges or schedules of pay and the amounts so paid to employees as a result thereof.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 3 Art. 2 \u00a7 12.3.21, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0c2dfb2d-857c-4ccf-81fc-6443b5ce9efa","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/9389956a-dc7e-4a9f-846f-be4a583b7bf3","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-218","docId":"75","text":"2.52.220 Jurisdiction B\u2013Purpose.","id":"9389956a-dc7e-4a9f-846f-be4a583b7bf3","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/9389956a-dc7e-4a9f-846f-be4a583b7bf3\/f9f9f398-b19a-4c09-abfc-9c551d8a227b","ref":{"parent":"9389956a-dc7e-4a9f-846f-be4a583b7bf3","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-218-11","docId":"75","text":"\u003Cp\u003EThere shall be included in the rules, provisions and conditions for the appointment, employment and retention of those employees who are subject to Jurisdiction B to be on a basis of merit and fitness.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. XII, Ch. 4, Art. 2 \u00a7 12:4.11, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f9f9f398-b19a-4c09-abfc-9c551d8a227b","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/dd8c82b8-9dd0-49c3-9bc0-12fc4ffd1f63","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-219","docId":"75","text":"2.52.230 Jurisdiction B\u2013Scope of Coverage and Adoption.","id":"dd8c82b8-9dd0-49c3-9bc0-12fc4ffd1f63","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/dd8c82b8-9dd0-49c3-9bc0-12fc4ffd1f63\/70a81ed9-94e7-4cb3-bdd6-074ceb543f88","ref":{"parent":"dd8c82b8-9dd0-49c3-9bc0-12fc4ffd1f63","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-219-11","docId":"75","text":"\u003Cp\u003EThe rules referred to in Section 2.52.220, shall provide the basis of a merit system by which the personnel program will be administered; provided, however, that the term \u201cmerit system\u201d shall not be construed as being limited in connotation to that commonly associated with civil service. Adoption shall be by resolution of the City Council.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 4, Art. 1 \u00a7 12:4.12, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"70a81ed9-94e7-4cb3-bdd6-074ceb543f88","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/801e301a-0455-47c9-8be9-9316d271a1bc","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-220","docId":"75","text":"2.52.240 Jurisdiction B\u2013Provisions Included.","id":"801e301a-0455-47c9-8be9-9316d271a1bc","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/801e301a-0455-47c9-8be9-9316d271a1bc\/54993aef-0f80-4b20-a89f-18521b4bbb80","ref":{"parent":"801e301a-0455-47c9-8be9-9316d271a1bc","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-220-11","docId":"75","text":"\u003Cp\u003EThe rules shall include provision for the establishment of lists of eligible applicants by one or more examination processes that in the opinion of the appointing authority best determines the qualifications of applicants in correlation with the needs of the City; for the selection of persons from said lists; for discharge of employees; and for such other provisions deemed necessary or desirable to administer fairly the personnel program on a merit basis as hereinafter defined.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995: Ord. XII, Ch. 4, Art. 1 \u00a7 12:4.13, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"54993aef-0f80-4b20-a89f-18521b4bbb80","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/83b32505-a985-4999-83eb-d8c80d2e72fb","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-221","docId":"75","text":"2.52.250 Jurisdiction C\u2013Purpose.","id":"83b32505-a985-4999-83eb-d8c80d2e72fb","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/83b32505-a985-4999-83eb-d8c80d2e72fb\/30f1e177-a67e-4ac2-94f3-8deb257a9c59","ref":{"parent":"83b32505-a985-4999-83eb-d8c80d2e72fb","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-221-11","docId":"75","text":"\u003Cp\u003EThere shall be rules covering all positions subject to Jurisdiction C to provide the basis of common understanding between supervisors and employees as to terms and conditions of employment.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 5, Art. 1 \u00a7 12:5.11, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"30f1e177-a67e-4ac2-94f3-8deb257a9c59","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/45003b0b-88a9-4545-93ec-0e5a7e53df08","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-222","docId":"75","text":"2.52.260 Jurisdiction C\u2013Scope of Coverage and Adoption.","id":"45003b0b-88a9-4545-93ec-0e5a7e53df08","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/45003b0b-88a9-4545-93ec-0e5a7e53df08\/17001615-5cb0-4b57-861c-f28123ee5fe5","ref":{"parent":"45003b0b-88a9-4545-93ec-0e5a7e53df08","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-222-11","docId":"75","text":"\u003Cp\u003EThe rules shall be adopted by resolution of the City Council.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995: Ord. XII, Ch. 5, Art. 1 \u00a7 12:5.12, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"17001615-5cb0-4b57-861c-f28123ee5fe5","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/1cbb0188-713c-45e7-85e1-ec697be1a90a","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-223","docId":"75","text":"2.52.270 Jurisdiction C\u2013Provisions Included.","id":"1cbb0188-713c-45e7-85e1-ec697be1a90a","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/1cbb0188-713c-45e7-85e1-ec697be1a90a\/c2792e57-ea05-4470-b28c-7934e351cc32","ref":{"parent":"1cbb0188-713c-45e7-85e1-ec697be1a90a","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-223-11","docId":"75","text":"\u003Cp\u003EThe rules shall include the following subject matter for which provisions and conditions shall be set forth and may include such other topics, provisions and conditions not in conflict with this Personnel Code as may be necessary or desirable to carry out the purpose and intent of this chapter:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ERecruitment and retention:\u003Col\u003E\u003Cli\u003E(Repealed),\u003C\/li\u003E\u003Cli\u003EExaminations to test fairly the fitness of applicants, or such other methods as can best serve the purpose of determining excellence, qualification or fitness,\u003C\/li\u003E\u003Cli\u003EEligible lists of names of successful applicants from which merit appointments will be made,\u003C\/li\u003E\u003Cli\u003ESelection of employees for appointment which process may include, among others, one from the three highest ranking eligibles available, one from among those in the highest category when eligible lists are so constructed or from successful applicants on a pass-fail basis,\u003C\/li\u003E\u003Cli\u003ECertified status for all employees successfully completing their probationary period when appointed under the conditions of Jurisdiction B,\u003C\/li\u003E\u003Cli\u003EProbationary status for all employees appointed from eligibility lists or as a result of having successfully completed an examination, the duration of which is to be predetermined for each class,\u003C\/li\u003E\u003Cli\u003EProvisional status for employees appointed to positions subject to Jurisdiction B and for which no eligible lists exist, such appointments to be terminated no later than one hundred eighty days,\u003C\/li\u003E\u003Cli\u003ETemporary status for all employees appointed to seasonal, part-time or other nonpermanent work,\u003C\/li\u003E\u003Cli\u003EExempt status for all employees occupying positions not subject to Jurisdiction B;\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EDisciplinary actions and appeals: Consistent with the provisions of law, the rules shall include procedures concerning disciplinary actions and appeals.\u003C\/li\u003E\u003Cli\u003ETerms and conditions of employment: Terms and conditions of employment including but not limited to absence, group insurance, and performance evaluation, are set forth in memoranda of understanding or resolution adopted by the City Council.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. XII, Ch. 5, Art. 1 \u00a7 12:5.13, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"c2792e57-ea05-4470-b28c-7934e351cc32","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/e08c09da-0d54-474b-ba59-1443be335758","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-224","docId":"75","text":"2.52.280 Employer-Employee Relations\u2013Purpose.","id":"e08c09da-0d54-474b-ba59-1443be335758","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/e08c09da-0d54-474b-ba59-1443be335758\/25464350-4d21-4902-bc47-32716e349009","ref":{"parent":"e08c09da-0d54-474b-ba59-1443be335758","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-224-11","docId":"75","text":"\u003Cp\u003EThe purpose of this chapter is to implement Chapter 10, Division 4, Title 1 of the Government Code of the state of California (Sections 3500 et seq.) captioned \u201cPublic Employee Organizations,\u201d by providing orderly procedures for the administration of employer-employee relations between the City and its employee organizations and for resolving disputes regarding wages, hours, and other terms and conditions of employment.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 6, Art. 1 \u00a7 12:6.11, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"25464350-4d21-4902-bc47-32716e349009","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/61ead606-eaeb-45f7-ab1f-15099f0dbb47","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-225","docId":"75","text":"2.52.290 Employer-Employee Relations\u2013Definitions.","id":"61ead606-eaeb-45f7-ab1f-15099f0dbb47","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/61ead606-eaeb-45f7-ab1f-15099f0dbb47\/cd09b1eb-562e-457c-8929-40d59f117de8","ref":{"parent":"61ead606-eaeb-45f7-ab1f-15099f0dbb47","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-225-11","docId":"75","text":"\u003Cp\u003EAs used in this chapter the following terms shall have the meanings indicated:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003E\u201cAppropriate unit\u201d means a unit established pursuant to Section 2.52.470 of this chapter;\u003C\/li\u003E\u003Cli\u003E\u201cCity\u201d means the City of Cupertino, a municipal corporation, and where appropriate herein, \u201cCity\u201d refers to the City Council, the governing body of the City, or any duly authorized management employee as herein defined;\u003C\/li\u003E\u003Cli\u003E\u201cConsult or consultation in good faith\u201d means to communicate verbally or in writing for the purpose of presenting and obtaining views or advising of intended actions;\u003C\/li\u003E\u003Cli\u003E\u201cEmployee\u201d means any person regularly employed by the City except those persons elected by popular vote;\u003C\/li\u003E\u003Cli\u003E\u201cEmployee, confidential\u201d means an employee who is privy to decisions of City management affecting employer-employee relations;\u003C\/li\u003E\u003Cli\u003E\u201cEmployee, management\u201d means:\u003Col\u003E\u003Cli\u003EAny employee having significant responsibilities for formulating and administering City policies and programs, including but not limited to the chief executive officer and department heads, and\u003C\/li\u003E\u003Cli\u003EAny employee having authority to exercise independent judgment to hire, transfer, suspend, lay-off, recall, promote, discharge, assign, reward, or discipline other employees, or having the responsibility to direct them, or to adjust their grievances, or effectively to recommend such action if in connection with the foregoing, the exercise of such authority is not of a merely routine or clerical nature, but requires the use of independent judgment;\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003E\u201cEmployee, professional\u201d means employees engaged in work requiring specialized knowledge and skills attained through completion of a recognized course of instruction, including, but not limited to, attorneys, physicians, registered nurses, engineers, architects, teachers, and various types of physical, chemical, and biological scientists;\u003C\/li\u003E\u003Cli\u003E\u201cEmployee organization\u201d means any organization which includes employees of the City and which has as one of its primary purposes representing such employees in their employment relations with the City;\u003C\/li\u003E\u003Cli\u003E\u201cEmployer-employee relations\u201d means the relationship between the City and its employees and their employee organization, or when used in a general sense, the relationship between City management and employees or employee organizations;\u003C\/li\u003E\u003Cli\u003E\u201cGrievance\u201d means as this term is defined in Section 2.52.420;\u003C\/li\u003E\u003Cli\u003E\u201cImpasse\u201d means:\u003Col\u003E\u003Cli\u003EA deadlock in the annual (or periodic) discussions between a majority representative and the City over any matters concerning which they are required to meet and confer in good faith, or over the scope of such subject matter, or\u003C\/li\u003E\u003Cli\u003EAny unresolved complaint by an affected employee organization, advanced in good faith, concerning a decision of the municipal employee relations officer made pursuant to Sections 2.52.450 through 2.52.480 of this chapter;\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003E\u201cExclusive representative\u201d means an employee organization, or its duly authorized representative, that has been granted formal recognition by the municipal employee relations officer following a secret ballot election as representing the employees in an appropriate unit;\u003C\/li\u003E\u003Cli\u003E\u201cMediation or conciliation\u201d means the efforts of an impartial third person, or persons, functioning as intermediaries, to assist the parties in reaching a voluntary resolution to an impasse, through interpretation, suggestion and advice. Mediation and conciliation are interchangeable terms;\u003C\/li\u003E\u003Cli\u003E\u201cMeet and confer in good faith\u201d (sometimes referred to herein as \u201cmeet and confer\u201d or \u201cmeeting and conferring\u201d) means performance by duly authorized City representatives and duly authorized representatives of an employee organization recognized as the exclusive representative of their mutual obligation to meet at reasonable times and to confer in good faith regarding matters within the scope of representation, including wages, hours, and other terms and conditions of employment, in an effort to:\u003Col\u003E\u003Cli\u003EReach agreement on those matters within the authority of such representatives, and\u003C\/li\u003E\u003Cli\u003EReach agreement on what will be recommended to the City Council on those matters within the decision-making authority of the City Council. This does not require either party to agree to a proposal or to make a concession;\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003E\u201cMunicipal Employee Relations Officer\u201d means the City\u2019s principal representative in all matters of employer-employee relations designated pursuant to Section 2.52.320, or his duly authorized representative;\u003C\/li\u003E\u003Cli\u003E\u201cOrdinance\u201d means, unless the context indicates otherwise, the employer-employee relations chapter of the Personnel Code of the City;\u003C\/li\u003E\u003Cli\u003E\u201cPeace Officer\u201d means as this term is defined in Section 817, California Penal Code;\u003C\/li\u003E\u003Cli\u003E\u201cRecognized employee organization\u201d means an employee organization which has been acknowledged by the Municipal Employee Relations Officer as an employee organization that represents employees of the City. The rights accompanying recognition are either:\u003Col\u003E\u003Cli\u003EFormal recognition, which is the right to meet and confer in good faith as the exclusive representative in an appropriate unit, or\u003C\/li\u003E\u003Cli\u003EInformal recognition, which is the right to meet and confer in good faith as a recognized employee organization;\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003E\u201cScope of representation\u201d means all matters relating to employment conditions and employer-employee relations, including, but not limited to, wages, hours and other terms and conditions of employment. City rights (Section 2.52.310) are excluded from the scope of representation.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1697 (part), 1995; Ord. XII, Ch. 6, Art. 1 \u00a7 12:6.12, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"cd09b1eb-562e-457c-8929-40d59f117de8","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/c475ed98-a821-46cf-88d4-0ddcc25e0a73","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-226","docId":"75","text":"2.52.300 Employee Rights.","id":"c475ed98-a821-46cf-88d4-0ddcc25e0a73","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/c475ed98-a821-46cf-88d4-0ddcc25e0a73\/8333fbef-fcac-4312-a2a3-bdde5e48be9e","ref":{"parent":"c475ed98-a821-46cf-88d4-0ddcc25e0a73","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-226-11","docId":"75","text":"\u003Cp\u003EEmployees of the City shall have the right to form, join and participate in the activities of employee organizations of their own choosing for the purpose of representation on all matters of employer-employee relations including but not limited to wages, hours, and other terms and conditions of employment. Employees of the City also shall have the right to refuse to join or participate in the activities of employee organizations and shall have the right to represent themselves individually in their employment relations with the City. No employee shall be interfered with, intimidated, restrained, coerced or discriminated against because of his exercise of these rights.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 6, Art. 1 \u00a7 12:6.13, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"8333fbef-fcac-4312-a2a3-bdde5e48be9e","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/13be8638-bdad-4bb4-8bf0-597a138729f3","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-227","docId":"75","text":"2.52.310 City Rights.","id":"13be8638-bdad-4bb4-8bf0-597a138729f3","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/13be8638-bdad-4bb4-8bf0-597a138729f3\/a26175cc-b281-48cf-a8fa-ff5b1bf3d672","ref":{"parent":"13be8638-bdad-4bb4-8bf0-597a138729f3","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-227-11","docId":"75","text":"\u003Cp\u003EThe rights of the City include, but are not limited to, the exclusive right to determine the mission of its constituent departments, commissions and boards; set standards of service; determine the procedures and standards of selection for employment and promotion; direct its employees; take disciplinary action; relieve its employees from duty because of lack of work or for other legitimate reasons; maintain the efficiency of governmental operations; determine the content of job classifications; take all necessary actions to carry out its mission in emergencies; and exercise complete control and discretion over its organization and the technology of performing its work.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 6, Art. 1 \u00a7 12:6.14, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"a26175cc-b281-48cf-a8fa-ff5b1bf3d672","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/eb28cd59-9492-45c0-9af2-1dbdcce1999b","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-228","docId":"75","text":"2.52.320 Municipal Employee Relations Officer\u2013Designated.","id":"eb28cd59-9492-45c0-9af2-1dbdcce1999b","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/eb28cd59-9492-45c0-9af2-1dbdcce1999b\/99d6eaab-bb8a-4417-8d22-e371055c2fcd","ref":{"parent":"eb28cd59-9492-45c0-9af2-1dbdcce1999b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-228-11","docId":"75","text":"\u003Cp\u003EThe City Council shall designate, by resolution, a Municipal Employee Relations Officer who shall be the City\u0027s principal representative in all matters of employer-employee relations, with authority to meet and confer in good faith on matters within the scope of representation including wages, hours and other terms and conditions of employment.\u003C\/p\u003E\u003Cp\u003EThe Municipal Employee Relations Officer so designated is authorized to delegate these duties and responsibilities.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 6, Art. 1 \u00a7 12:6.15, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"99d6eaab-bb8a-4417-8d22-e371055c2fcd","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/f98396e6-9f44-4f50-8328-a59e929ae05a","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-229","docId":"75","text":"2.52.330 Rules and Regulations\u2013Adoption.","id":"f98396e6-9f44-4f50-8328-a59e929ae05a","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/f98396e6-9f44-4f50-8328-a59e929ae05a\/9abb1d57-c335-41fc-a830-c270fa080dac","ref":{"parent":"f98396e6-9f44-4f50-8328-a59e929ae05a","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-229-11","docId":"75","text":"\u003Cp\u003EThe City Council may adopt such rules and regulations necessary or convenient to implement the provisions of this chapter and Chapter 10, Division 4, Title 1 of the Government Code of the state of California (Section 3500, et seq.).\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 6, Art. 1 \u00a7 12:6.16, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"9abb1d57-c335-41fc-a830-c270fa080dac","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/0ad4d61d-be7c-443f-8bb0-3eebb4168917","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-230","docId":"75","text":"2.52.340 Federal, State and City Laws\u2013Authority.","id":"0ad4d61d-be7c-443f-8bb0-3eebb4168917","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/0ad4d61d-be7c-443f-8bb0-3eebb4168917\/bc8e8ebd-4102-4df7-9254-07358cee6519","ref":{"parent":"0ad4d61d-be7c-443f-8bb0-3eebb4168917","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-230-11","docId":"75","text":"\u003Cp\u003ENothing in this chapter shall be construed to deny any person or employee the rights granted by Federal and state laws and City Charter provisions.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 6, Art. 1 \u00a7 12:6.17.1, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"bc8e8ebd-4102-4df7-9254-07358cee6519","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/3385bd0f-ce26-43e8-ace4-8b6b4d990a6f","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-231","docId":"75","text":"2.52.350 City Council\u2013Rights and Powers.","id":"3385bd0f-ce26-43e8-ace4-8b6b4d990a6f","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/3385bd0f-ce26-43e8-ace4-8b6b4d990a6f\/926ebb6b-0e60-4e6e-ba5d-849f84b75c6b","ref":{"parent":"3385bd0f-ce26-43e8-ace4-8b6b4d990a6f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-231-11","docId":"75","text":"\u003Cp\u003EThe rights, powers and authority of the City Council in all matters, including the right to maintain any legal action, shall not be modified or restricted by this chapter.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 6, Art. 1 \u00a7 12:6.17.2, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"926ebb6b-0e60-4e6e-ba5d-849f84b75c6b","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/b9559a3f-4625-4e42-99bc-1dff27fe6ed4","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-232","docId":"75","text":"2.52.360 Written Agreements.","id":"b9559a3f-4625-4e42-99bc-1dff27fe6ed4","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/b9559a3f-4625-4e42-99bc-1dff27fe6ed4\/2cb31cbb-c506-41e8-b1c3-74106303a1e3","ref":{"parent":"b9559a3f-4625-4e42-99bc-1dff27fe6ed4","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-232-11","docId":"75","text":"\u003Cp\u003ENothing contained in this chapter shall abrogate any written agreement between any employee organization and the City in effect on the effective date of the ordinance codified herein. All such agreements shall continue in effect for the duration of the term specified therein unless modified or rescinded by mutual agreement of the parties thereto.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 6, Art. 1 \u00a7 12:6.17.3, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"2cb31cbb-c506-41e8-b1c3-74106303a1e3","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/0d569c6e-76e4-45d0-8afe-195a8fb4e23c","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-233","docId":"75","text":"2.52.370 State Law Applicability.","id":"0d569c6e-76e4-45d0-8afe-195a8fb4e23c","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/0d569c6e-76e4-45d0-8afe-195a8fb4e23c\/2f75c192-e283-42c0-9678-c515a90ad2df","ref":{"parent":"0d569c6e-76e4-45d0-8afe-195a8fb4e23c","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-233-11","docId":"75","text":"\u003Cp\u003EThe provisions of this chapter are not intended to conflict with the provisions of Chapter 10, Division 4, Title 1 of the Government Code of the state of California (Section 3500, et seq.) as amended in 1968.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 6, Art. 1 \u00a7 12:6.17.4, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"2f75c192-e283-42c0-9678-c515a90ad2df","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/558f3e28-b50f-4c68-8314-e67678058579","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-234","docId":"75","text":"2.52.380 Meeting and Conferring in Good Faith\u2013Scope.","id":"558f3e28-b50f-4c68-8314-e67678058579","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/558f3e28-b50f-4c68-8314-e67678058579\/cc08e5c2-9802-4aee-965f-d6180c90922d","ref":{"parent":"558f3e28-b50f-4c68-8314-e67678058579","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-234-11","docId":"75","text":"\u003Cp\u003EThe City, through its representative, shall meet and confer in good faith with representatives of formally recognized employee organizations regarding matters within the scope of representation including wages, hours and other terms and conditions of employment.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. XII, Ch. 6, Art. 2 \u00a7 12:6.21, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"cc08e5c2-9802-4aee-965f-d6180c90922d","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/e94514f6-be3a-49e2-b946-6ba0be403d83","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-235","docId":"75","text":"2.52.400 Meeting and conferring in good faith\u2013Exclusions.","id":"e94514f6-be3a-49e2-b946-6ba0be403d83","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/e94514f6-be3a-49e2-b946-6ba0be403d83\/0cef015d-4657-4153-997e-c8edd9868b6b","ref":{"parent":"e94514f6-be3a-49e2-b946-6ba0be403d83","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-235-11","docId":"75","text":"\u003Cp\u003EThe City shall not be required to meet and confer in good faith on any subject preempted by Federal or state law nor shall it be required to meet and confer in good faith on employee or City rights as defined in Sections 2.52.300 and 2.52.310. Proposed amendments to this chapter are excluded from the scope of meeting and conferring.\u003C\/p\u003E\u003Cp\u003E(Ord. XII, Ch. 6, Art. 2 \u00a7 12:6.23, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0cef015d-4657-4153-997e-c8edd9868b6b","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/fea32257-9e23-4a75-a0de-e1ca2adad50b","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-236","docId":"75","text":"2.52.410 Impasses.","id":"fea32257-9e23-4a75-a0de-e1ca2adad50b","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/fea32257-9e23-4a75-a0de-e1ca2adad50b\/ed4e32b6-c9fc-4c12-be80-a2c4e552c3d6","ref":{"parent":"fea32257-9e23-4a75-a0de-e1ca2adad50b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-236-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EImpasse procedures may be invoked only after the possibility of settlement by direct discussion has been exhausted. The impasse procedures are as follows:\u003Col\u003E\u003Cli\u003EMediation (or conciliation). (Defined in Section 2.52.290) All mediation proceedings shall be private. The mediator shall make no public recommendations nor take any public position concerning the issue;\u003C\/li\u003E\u003Cli\u003EA determination by the City Council after a hearing on the merits of the dispute;\u003C\/li\u003E\u003Cli\u003EAny other dispute resolving procedures to which the parties mutually agree or which the City Council may order.\u003Cbr\u003E\n\u003Cbr\u003E\nAny party may initiate the impasse procedure by filing with the other party (or parties) affected a written request for an impasse meeting together with a statement of its position on all disputed issues. An impasse meeting shall then be scheduled by the municipal employee relations officer forthwith after the date of filing of the written request for such meeting, with written notice to all parties affected. The purpose of such impasse meeting is twofold:\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\u003Cli\u003ETo permit a review of the position of all parties in a final effort to reach agreement on the disputed issues, and\u003C\/li\u003E\u003Cli\u003EIf agreement is not concluded, to mutually select the specific impasse procedure to which the dispute shall be submitted; in the absence of agreement between the parties on this point, the matter shall be referred to the City Council.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EThe fees and expenses, if any, of mediators or of any other impasse procedure, shall be payable one-half by the City and one-half by the employee organization or employee organizations.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. XII, Ch. 6, Art. 2 \u00a7 12:6.24, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"ed4e32b6-c9fc-4c12-be80-a2c4e552c3d6","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/4e019148-caac-40d6-a9af-fa6d3d808c07","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-237","docId":"75","text":"2.52.420 Grievances.","id":"4e019148-caac-40d6-a9af-fa6d3d808c07","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/4e019148-caac-40d6-a9af-fa6d3d808c07\/93ed526f-2e4c-459f-9636-e3ac26558081","ref":{"parent":"4e019148-caac-40d6-a9af-fa6d3d808c07","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-237-11","docId":"75","text":"\u003Cp\u003EA \u201cgrievance\u201d is any good-faith dispute concerning the interpretation or application of a memorandum of understanding or of terms and conditions of employment as set forth in any resolution adopted by the City Council.\u003C\/p\u003E\u003Cp\u003EGrievances shall be processed in accordance with procedures established by the City.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. XII, Ch. 6, Art. 2 \u00a7 12:6.25, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"93ed526f-2e4c-459f-9636-e3ac26558081","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/bded8f1e-c73c-4d9a-a6a3-ba17050fb61e","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-238","docId":"75","text":"2.52.430 Meeting and Conferring\u2013Memorandum of Understanding.","id":"bded8f1e-c73c-4d9a-a6a3-ba17050fb61e","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/bded8f1e-c73c-4d9a-a6a3-ba17050fb61e\/c0578b11-291f-42cb-9c76-ac969583cf95","ref":{"parent":"bded8f1e-c73c-4d9a-a6a3-ba17050fb61e","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-238-11","docId":"75","text":"\u003Cp\u003EWhen the meeting and conferring process is concluded between the City and a formally recognized employee organization, all agreed-upon matters shall be incorporated in a written memorandum of understanding signed by the duly authorized City and employee representatives.\u003C\/p\u003E\u003Cp\u003EAs to those matters within the authority of the City Council, the memorandum of understanding shall be submitted to the City Council for determination.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. XII, Ch. 6, Art. 2 \u00a7 12:6.26, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"c0578b11-291f-42cb-9c76-ac969583cf95","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/0d658b88-d2cf-4281-bd4a-312e4568f54d","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-239","docId":"75","text":"2.52.440 Meeting and Conferring\u2013Advance Notice Required.","id":"0d658b88-d2cf-4281-bd4a-312e4568f54d","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/0d658b88-d2cf-4281-bd4a-312e4568f54d\/48c219b9-6411-48c4-b083-2d5101950721","ref":{"parent":"0d658b88-d2cf-4281-bd4a-312e4568f54d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-239-11","docId":"75","text":"\u003Cp\u003EReasonable written notice shall be given to each recognized employee organization affected of any ordinance, rule, resolution or regulation directly relating to matters within the scope of representation proposed to be adopted by the City Council or by any board or commission of the City, and each shall be given the opportunity to meet with the Municipal Employee Relations Officer prior to adoption.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. XII, Ch. 6, Art. 2 \u00a7 12:6.27, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"48c219b9-6411-48c4-b083-2d5101950721","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/46a60cd7-87ab-4f44-830e-c8acec8efa4c","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-240","docId":"75","text":"2.52.450 Employee Organization\u2013Petition for Formal Recognition.","id":"46a60cd7-87ab-4f44-830e-c8acec8efa4c","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/46a60cd7-87ab-4f44-830e-c8acec8efa4c\/14d3127f-9b97-4905-ba54-5b2acafeeabe","ref":{"parent":"46a60cd7-87ab-4f44-830e-c8acec8efa4c","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-240-11","docId":"75","text":"\u003Cp\u003EAn employee organization that seeks formal recognition for purposes of meeting and conferring in good faith as the exclusive representative of employees in an appropriate unit shall file a petition with the Municipal Employee Relations Officer containing the following information and documentation:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EName and address of the employee organization;\u003C\/li\u003E\u003Cli\u003ENames and titles of its officers;\u003C\/li\u003E\u003Cli\u003ENames of employee organization representatives who are authorized to speak on behalf of its members;\u003C\/li\u003E\u003Cli\u003EA statement that the employee organization has, as one of its primary purposes, representing employees in their employment relations with the City;\u003C\/li\u003E\u003Cli\u003EA statement whether the employee organization is a chapter or local of, or affiliated directly or indirectly in any manner with, a regional or state, or national or international organization, and, if so, the name and address of each such regional, state or international organization;\u003C\/li\u003E\u003Cli\u003ECertified copies of the employee organizations\u0027 constitution and bylaws;\u003C\/li\u003E\u003Cli\u003EA designation of those persons, not exceeding two in number, and their addresses, to whom notice sent by regular United States mail will be deemed sufficient notice on the employee organization for any purpose;\u003C\/li\u003E\u003Cli\u003EA statement that the employee organization recognizes that the provisions of Section 923 of the Labor Code are not applicable to City employees;\u003C\/li\u003E\u003Cli\u003EA statement that the employee organization has no restriction on membership based on race, color, creed, sex, or national origin;\u003C\/li\u003E\u003Cli\u003EThe job classification or titles of employees in the unit claimed to be appropriate;\u003C\/li\u003E\u003Cli\u003EA statement that the employee organization has in its possession written proof, dated within six months of the date upon which the petition is filed, to establish that at least forty percent of the employees in the unit claimed to be appropriate have designated the employee organization to represent them in their employment relations with the City. Such written proof shall be submitted for confirmation to the Municipal Employee Relations Officer or to a mutually agreed upon disinterested third party;\u003C\/li\u003E\u003Cli\u003EA request that the Municipal Employee Relations Officer conduct a secret ballot election to determine if the petitioning employee organization will be recognized as the exclusive representative of the employees in the unit claimed to be appropriate for the purpose of meeting and conferring in good faith on all matters within the scope of representation.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. XII, Ch. 6, Art. 3 \u00a7 12:6.31, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"14d3127f-9b97-4905-ba54-5b2acafeeabe","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/4d1e74df-63a5-418f-893f-f0916757986f","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-241","docId":"75","text":"2.52.470 Employee Organization\u2013Appropriate Unit Determination.","id":"4d1e74df-63a5-418f-893f-f0916757986f","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/4d1e74df-63a5-418f-893f-f0916757986f\/0ac98ab5-7d2d-4d0e-a7de-c03085428c21","ref":{"parent":"4d1e74df-63a5-418f-893f-f0916757986f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-241-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe Municipal Employee Relations Officer, after reviewing the petitions filed by an employee organization seeking formal recognition as the exclusive representative, shall determine whether the proposed unit is an appropriate unit. The principal criterion in making this determination is whether there is a community of interest among such employees. The following factors, among others, are to be considered in making such determination:\u003Col\u003E\u003Cli\u003EWhich unit will assure employees the fullest freedom in the exercise of rights set forth under this chapter;\u003C\/li\u003E\u003Cli\u003EThe history of employee relations:\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\u003Cli\u003EIn the unit,\u003C\/li\u003E\u003Cli\u003EAmong other employees of the City, and\u003C\/li\u003E\u003Cli\u003EIn similar public employment;\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EThe effect of the unit on the efficient operation of the City and sound employer-employee relations;\u003C\/li\u003E\u003Cli\u003EThe extent to which employees have common skills, working conditions, job duties or similar educational requirements.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EIn the establishment of appropriate units:\u003Col\u003E\u003Cli\u003EProfessional employees shall not be denied the right to be represented separately from nonprofessional employees; and\u003C\/li\u003E\u003Cli\u003EManagement and confidential employees who are included in the same unit with nonmanagement or nonconfidential employees may not represent such employees on matters within the scope of representation.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. XII, Ch. 6, Art. 3 \u00a7 12:6.33, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0ac98ab5-7d2d-4d0e-a7de-c03085428c21","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/274136b3-c740-4d63-8991-83588877bc6a","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-242","docId":"75","text":"2.52.480 Employee Organization\u2013Determination of Exclusive Representative.","id":"274136b3-c740-4d63-8991-83588877bc6a","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/274136b3-c740-4d63-8991-83588877bc6a\/7d737c55-da13-4f23-9c7e-58c4b42612eb","ref":{"parent":"274136b3-c740-4d63-8991-83588877bc6a","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-242-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe Municipal Employee Relations Officer shall:\u003Col\u003E\u003Cli\u003EDetermine the exclusive representative or City employees in an appropriate unit by arranging for a secret ballot election. The employee organization found to represent a majority of the employees in an appropriate unit shall be granted formal recognition and is the only employee organization entitled to meet and confer in good faith on matters within the scope of representation for employees in such unit. This shall not preclude other recognized employee organizations from meeting with management representatives or employer-employee relations matters of concern to them;\u003C\/li\u003E\u003Cli\u003ERevoke the recognition rights of an employee organization which has been found by secret ballot election no longer to be the exclusive representative.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EThe recognition rights of the exclusive representative, designated in accordance with subsection A of this section, shall not be subject to challenge for a period of twelve months following the date of such recognition.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. XII, Ch. 6, Art. 3 \u00a7 12:6.34, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"7d737c55-da13-4f23-9c7e-58c4b42612eb","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/245c6d13-9cac-4dbc-9ad7-47e90c54277f","ref":{"parent":"b251f995-30d9-4d2a-aff3-8ec07415be31","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-217-243","docId":"75","text":"2.52.490 Employment Continuation\u2013Intent.","id":"245c6d13-9cac-4dbc-9ad7-47e90c54277f","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/b251f995-30d9-4d2a-aff3-8ec07415be31\/245c6d13-9cac-4dbc-9ad7-47e90c54277f\/70372be5-6de7-4b56-b040-f14fed797750","ref":{"parent":"245c6d13-9cac-4dbc-9ad7-47e90c54277f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-217-243-11","docId":"75","text":"\u003Cp\u003ENo provision or condition contained herein shall be construed as denying the continued employment of any employee who is on the payroll as of the effective date of the ordinance codified herein.\u003C\/p\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. XII, Ch. 7, Art. 1 \u00a7 12:7.11, 1970)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"70372be5-6de7-4b56-b040-f14fed797750","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/7d14c566-9e64-4f7c-bb39-99f17c0d2402","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-218","docId":"75","text":"CHAPTER 2.60: PUBLIC SAFETY COMMISSION","id":"7d14c566-9e64-4f7c-bb39-99f17c0d2402","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/7d14c566-9e64-4f7c-bb39-99f17c0d2402\/7842c600-a6fd-4786-b0f4-44bb56e6bf08","ref":{"parent":"7d14c566-9e64-4f7c-bb39-99f17c0d2402","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-218-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"7842c600-a6fd-4786-b0f4-44bb56e6bf08","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/7d14c566-9e64-4f7c-bb39-99f17c0d2402\/14617771-15aa-48f1-9321-a65cf809cb96","ref":{"parent":"7d14c566-9e64-4f7c-bb39-99f17c0d2402","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-218-12","docId":"75","text":"2.60.010 Established.","id":"14617771-15aa-48f1-9321-a65cf809cb96","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/7d14c566-9e64-4f7c-bb39-99f17c0d2402\/14617771-15aa-48f1-9321-a65cf809cb96\/e68ad399-ba96-49c4-8049-beb3dec903a5","ref":{"parent":"14617771-15aa-48f1-9321-a65cf809cb96","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-218-12-11","docId":"75","text":"\u003Cp\u003EThe Public Safety Commission of the City is established. The Public Safety Commission shall consist of five members, all of whom shall reside within the City and shall be appointed by the City Council. None shall be officials or employees of the City, members of the Sheriff\u2019s Department of the County, either regular or reserve, nor shall they be members of the Central Fire Protection District. No members of the Public Safety Commission shall cohabit with, as defined by law, nor be related by blood or marriage to any member of the Commission, the City Manager or the staff person(s) assigned to this Commission.\u003C\/p\u003E\u003Cp\u003E(Ord. 1463, (part), 1988; Ord. 1432, 1988; Ord. 574, \u00a7 1, 1973)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"e68ad399-ba96-49c4-8049-beb3dec903a5","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/7d14c566-9e64-4f7c-bb39-99f17c0d2402\/61c68f08-ed1b-4f10-9674-c85799f34719","ref":{"parent":"7d14c566-9e64-4f7c-bb39-99f17c0d2402","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-218-13","docId":"75","text":"2.60.020 Terms of Office.","id":"61c68f08-ed1b-4f10-9674-c85799f34719","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/7d14c566-9e64-4f7c-bb39-99f17c0d2402\/61c68f08-ed1b-4f10-9674-c85799f34719\/8c12198c-64fc-46dd-97e8-385c6abdab50","ref":{"parent":"61c68f08-ed1b-4f10-9674-c85799f34719","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-218-13-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ECommissioners serve at the pleasure of the City Council. The term of office of the members of the Public Safety Commission shall be for four years and shall end on January 30th of the year their term is due to expire. No commissioner shall serve more than two consecutive terms except that a commissioner may serve more than two consecutive terms if he or she has been appointed to the Commission to fill an unexpired term of less than two years.\u003C\/li\u003E\u003Cli\u003EThe appointment, reappointment and rules governing incumbent members of the Commission are governed by the Resolution of the Cupertino City Council which governs advisory bodies.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 4 (part), 2018; Ord. 2015, \u00a7 8, 2008; Ord. 1463, (part), 1988; Ord. 1321, \u00a7 1 (part), 1985; Ord. 1166, (part), 1982; Ord. 574, \u00a7 2, 1973)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"8c12198c-64fc-46dd-97e8-385c6abdab50","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/7d14c566-9e64-4f7c-bb39-99f17c0d2402\/5ab276b3-cd8d-488a-ab0b-9ef6853d8349","ref":{"parent":"7d14c566-9e64-4f7c-bb39-99f17c0d2402","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-218-14","docId":"75","text":"2.60.030 Vacancy\u2013Removal.","id":"5ab276b3-cd8d-488a-ab0b-9ef6853d8349","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/7d14c566-9e64-4f7c-bb39-99f17c0d2402\/5ab276b3-cd8d-488a-ab0b-9ef6853d8349\/677bc4e1-6f83-43fd-8900-3553450824b7","ref":{"parent":"5ab276b3-cd8d-488a-ab0b-9ef6853d8349","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-218-14-11","docId":"75","text":"\u003Cp\u003EAny appointee member may be removed by a majority vote of the total membership of the City Council. Vacancies shall be filled by appointment by the City Council, and shall be for the unexpired portion of the term of office vacated.\u003C\/p\u003E\u003Cp\u003E(Ord. 574, \u00a7 3, 1973)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"677bc4e1-6f83-43fd-8900-3553450824b7","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/7d14c566-9e64-4f7c-bb39-99f17c0d2402\/e2bd393d-3aff-4992-b955-ed935424d9ad","ref":{"parent":"7d14c566-9e64-4f7c-bb39-99f17c0d2402","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-218-15","docId":"75","text":"2.60.040 Meetings\u2013Quorum\u2013Officers\u2013Staff.","id":"e2bd393d-3aff-4992-b955-ed935424d9ad","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/7d14c566-9e64-4f7c-bb39-99f17c0d2402\/e2bd393d-3aff-4992-b955-ed935424d9ad\/09ebf3f8-53b5-4f6d-9a81-3953eff795a6","ref":{"parent":"e2bd393d-3aff-4992-b955-ed935424d9ad","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-218-15-11","docId":"75","text":"\u003Cp\u003EThe Public Safety Commission shall hold regular meetings at least once every other month, and, at the discretion of the Commission, such other meetings as may be necessary or expedient. A majority of the Public Safety Commission shall constitute a quorum for the purpose of transacting the business of the Commission. The Public Safety Commission shall elect a chairperson and a vice-chairperson, both of whom shall serve at the pleasure of the Commission. Terms of the chairperson and vice-chairperson shall be for one year. Upon approval of the City Council, the City Manger may appoint a secretary who need not be a member of the Commission. Staff services as required shall be provided to the Commission by the City Manager.\u003C\/p\u003E\u003Cp\u003E(Ord. 2015, \u00a7 8, 2008; Ord. 1964, \u00a7 1, 2005; Ord. 1321, \u00a7 2 (part), 1985; Ord. 1167, (part), 1982; Ord. 574, \u00a7 4, 1973)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"09ebf3f8-53b5-4f6d-9a81-3953eff795a6","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/7d14c566-9e64-4f7c-bb39-99f17c0d2402\/0708e62a-3ea8-4062-b327-14586f709305","ref":{"parent":"7d14c566-9e64-4f7c-bb39-99f17c0d2402","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-218-16","docId":"75","text":"2.60.050 Compensation\u2013Expenses.","id":"0708e62a-3ea8-4062-b327-14586f709305","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/7d14c566-9e64-4f7c-bb39-99f17c0d2402\/0708e62a-3ea8-4062-b327-14586f709305\/70c0dfd8-1712-4bb5-980d-f7e74dcf5866","ref":{"parent":"0708e62a-3ea8-4062-b327-14586f709305","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-218-16-11","docId":"75","text":"\u003Cp\u003EMembers of the Public Safety Commission shall serve without compensation. Commissioners may be reimbursed for necessary expenses reasonably incurred by them while acting in their official capacity subject to the approval of the City Manager.\u003C\/p\u003E\u003Cp\u003E(Ord. 21-2234, Att. A (\u00a7 2, part), 2021; Ord. 574, \u00a7 5, 1973)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"70c0dfd8-1712-4bb5-980d-f7e74dcf5866","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/7d14c566-9e64-4f7c-bb39-99f17c0d2402\/91c63617-910f-4766-9425-9204bce5f03f","ref":{"parent":"7d14c566-9e64-4f7c-bb39-99f17c0d2402","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-218-17","docId":"75","text":"2.60.060 Records.","id":"91c63617-910f-4766-9425-9204bce5f03f","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/7d14c566-9e64-4f7c-bb39-99f17c0d2402\/91c63617-910f-4766-9425-9204bce5f03f\/be0a6b48-537c-4118-8942-1a5577a63f52","ref":{"parent":"91c63617-910f-4766-9425-9204bce5f03f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-218-17-11","docId":"75","text":"\u003Cp\u003EThe Commission shall keep a record of its proceedings and transactions, and shall render such reports to the City Council as may be required. These records shall be filed with the City Clerk.\u003C\/p\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 4 (part), 2018; Ord. 574, \u00a7 6, 1973)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"be0a6b48-537c-4118-8942-1a5577a63f52","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/7d14c566-9e64-4f7c-bb39-99f17c0d2402\/9e6174a2-335d-43c8-9081-ff3420a0d756","ref":{"parent":"7d14c566-9e64-4f7c-bb39-99f17c0d2402","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-218-18","docId":"75","text":"2.60.070 Duties\u2013Responsibilities.","id":"9e6174a2-335d-43c8-9081-ff3420a0d756","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/7d14c566-9e64-4f7c-bb39-99f17c0d2402\/9e6174a2-335d-43c8-9081-ff3420a0d756\/eff84e7e-9cc3-4680-9c3d-5f59e384f0b3","ref":{"parent":"9e6174a2-335d-43c8-9081-ff3420a0d756","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-218-18-11","docId":"75","text":"\u003Cp\u003EThe duties and responsibilities of the Public Safety Commission shall be to:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EAct in an advisory capacity to the City Council in all matters pertaining to safety, traffic, police, fire and other areas wherein the matter of public safety may be of concern;\u003C\/li\u003E\u003Cli\u003EHold hearings and formulate policies and procedures with respect to the foregoing for approval by the City Council;\u003C\/li\u003E\u003Cli\u003EPerform such other tasks as may be expressly requested of it by the City Council.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 574, \u00a7 7, 1973)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"eff84e7e-9cc3-4680-9c3d-5f59e384f0b3","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/7d14c566-9e64-4f7c-bb39-99f17c0d2402\/d854c879-2862-4985-816c-82d3acd1bacc","ref":{"parent":"7d14c566-9e64-4f7c-bb39-99f17c0d2402","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-218-19","docId":"75","text":"2.60.080 Effect.","id":"d854c879-2862-4985-816c-82d3acd1bacc","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/7d14c566-9e64-4f7c-bb39-99f17c0d2402\/d854c879-2862-4985-816c-82d3acd1bacc\/d9254c0b-e1db-4132-9aac-05d1e5d4d2ff","ref":{"parent":"d854c879-2862-4985-816c-82d3acd1bacc","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-218-19-11","docId":"75","text":"\u003Cp\u003ENothing in this chapter shall be construed as restricting or curtailing any of the powers of the City Council or City officers, or the delegation to the Public Safety Commission of any authority or discretionary powers imposed by law in such council or officers. The City Council declares that the public interest, convenience, welfare and necessity require the appointment of a Public Safety Commission to act in a purely advisory capacity to such Council, for the purpose enumerated in this chapter.\u003C\/p\u003E\u003Cp\u003E(Ord. 574, \u00a7 8, 1973)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d9254c0b-e1db-4132-9aac-05d1e5d4d2ff","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/6c1c17bd-1084-4a58-b9ac-88c0ca3a9012","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h3"},"pos":"13-219","docId":"75","text":"CHAPTER 2.64: RESERVED","id":"6c1c17bd-1084-4a58-b9ac-88c0ca3a9012","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/6c1c17bd-1084-4a58-b9ac-88c0ca3a9012\/d28118d9-30cf-4637-8a10-5b5f96c83741","ref":{"parent":"6c1c17bd-1084-4a58-b9ac-88c0ca3a9012","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-219-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"d28118d9-30cf-4637-8a10-5b5f96c83741","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a96f0bc3-e5de-4f15-a950-f81cb83f8100","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-220","docId":"75","text":"CHAPTER 2.68: LIBRARY COMMISSION","id":"a96f0bc3-e5de-4f15-a950-f81cb83f8100","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a96f0bc3-e5de-4f15-a950-f81cb83f8100\/8c851c95-2499-47c2-aabe-e5febe16a439","ref":{"parent":"a96f0bc3-e5de-4f15-a950-f81cb83f8100","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-220-11","docId":"75","text":"\u003Cp\u003EThe Library Commission of the City is established. The Library Commission shall consist of five members, at least three of whom must be residents of the City of Cupertino and none of whom shall be officials or employees of the City, nor cohabit with, as defined by law, nor be related by blood or marriage to any member of the Commission, the City Manager or the staff person(s) assigned to this Commission. Members of the Library Commission shall be appointed by the City Council.\u003C\/p\u003E\u003Cp\u003E(Ord. 1464, (part), 1988; Ord. 679, (part), 1975)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"8c851c95-2499-47c2-aabe-e5febe16a439","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a96f0bc3-e5de-4f15-a950-f81cb83f8100\/b00778f7-0bd6-44f2-b76b-0b847961baeb","ref":{"parent":"a96f0bc3-e5de-4f15-a950-f81cb83f8100","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-220-12","docId":"75","text":"2.68.020 Terms of Office.","id":"b00778f7-0bd6-44f2-b76b-0b847961baeb","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a96f0bc3-e5de-4f15-a950-f81cb83f8100\/b00778f7-0bd6-44f2-b76b-0b847961baeb\/1db62470-a7ef-4cde-aed7-93020a80331f","ref":{"parent":"b00778f7-0bd6-44f2-b76b-0b847961baeb","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-220-12-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ECommission members serve at the pleasure of the City Council. The term of office of the members of the Library Commission shall be for four years and shall end on January 30th of the year their term is due to expire. No commissioner shall serve more than two consecutive terms except that a commissioner may serve more than two consecutive terms if he or she has been appointed to the Commission to fill an unexpired term of less than two years.\u003C\/li\u003E\u003Cli\u003EThe appointment, reappointment and rules governing incumbent members of the Commission are governed by the Resolution of the Cupertino City Council which governs advisory bodies.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 5 (part), 2018; Ord. 1974, \u00a7 4 (part), 2006; Ord. 1464, (part), 1988; Ord. 1321, \u00a7 1 (part), 1985; Ord. 1166, (part), 1982; Ord. 679, (part), 1975)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"1db62470-a7ef-4cde-aed7-93020a80331f","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a96f0bc3-e5de-4f15-a950-f81cb83f8100\/00e5e4fa-295f-4511-9bf5-e42bc30e641d","ref":{"parent":"a96f0bc3-e5de-4f15-a950-f81cb83f8100","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-220-13","docId":"75","text":"2.68.030 Vacancy\u2013Removal.","id":"00e5e4fa-295f-4511-9bf5-e42bc30e641d","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a96f0bc3-e5de-4f15-a950-f81cb83f8100\/00e5e4fa-295f-4511-9bf5-e42bc30e641d\/e7198d2d-6c67-4eff-b88c-59448d3083c5","ref":{"parent":"00e5e4fa-295f-4511-9bf5-e42bc30e641d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-220-13-11","docId":"75","text":"\u003Cp\u003EAny appointee member may be removed by a majority vote of the total membership of the City Council. Vacancies shall be filled by appointment by the City Council, and shall be for the unexpired portion of the term of office vacated.\u003C\/p\u003E\u003Cp\u003E(Ord. 679, (part), 1975)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"e7198d2d-6c67-4eff-b88c-59448d3083c5","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a96f0bc3-e5de-4f15-a950-f81cb83f8100\/89feddde-950c-40f6-8bde-dd1cad25eb27","ref":{"parent":"a96f0bc3-e5de-4f15-a950-f81cb83f8100","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-220-14","docId":"75","text":"2.68.040 Meetings\u2013Quorum\u2013Officers\u2013Staff.","id":"89feddde-950c-40f6-8bde-dd1cad25eb27","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a96f0bc3-e5de-4f15-a950-f81cb83f8100\/89feddde-950c-40f6-8bde-dd1cad25eb27\/00b869cb-fac0-44f3-848b-3a3caf981a12","ref":{"parent":"89feddde-950c-40f6-8bde-dd1cad25eb27","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-220-14-11","docId":"75","text":"\u003Cp\u003EThe Library Commission shall hold regular meetings at least once every other month, and, at the discretion of the Commission, such other meetings as may be necessary or expedient. A majority of the Library Commission shall constitute a quorum for purposes of transacting the business of the Commission. The Library Commission shall elect a chairperson and a vice-chairperson, both of whom shall serve at the pleasure of the Commission. Terms of office for the chairperson and vice-chairperson shall be for one year. Staff services as required shall be provided to the Commission by the City Manager.\u003C\/p\u003E\u003Cp\u003E(Ord. 2015, \u00a7 5, 2008; Ord. 1964, \u00a7 2, 2005; Ord. 1321, \u00a7 2 (part), 1985; Ord. 1167, (part), 1982; Ord. 679, (part), 1975)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"00b869cb-fac0-44f3-848b-3a3caf981a12","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a96f0bc3-e5de-4f15-a950-f81cb83f8100\/2a03111f-6d35-46c0-984b-6da866dafced","ref":{"parent":"a96f0bc3-e5de-4f15-a950-f81cb83f8100","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-220-15","docId":"75","text":"2.68.050 Compensation\u2013Expenses.","id":"2a03111f-6d35-46c0-984b-6da866dafced","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a96f0bc3-e5de-4f15-a950-f81cb83f8100\/2a03111f-6d35-46c0-984b-6da866dafced\/ffc448d4-f1c9-4087-aa20-687c4f92c189","ref":{"parent":"2a03111f-6d35-46c0-984b-6da866dafced","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-220-15-11","docId":"75","text":"\u003Cp\u003EMembers of the Library Commission shall serve without compensation. Commissioners may be reimbursed for necessary expenses reasonably incurred by them while acting in their official capacity subject to the approval of the City Manager. (Ord. 21-2234, Att. A (\u00a7 2, part), 2021; Ord. 679, (part), 1975)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"ffc448d4-f1c9-4087-aa20-687c4f92c189","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a96f0bc3-e5de-4f15-a950-f81cb83f8100\/9d4b5e08-f996-4464-a21b-036528c7086b","ref":{"parent":"a96f0bc3-e5de-4f15-a950-f81cb83f8100","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-220-16","docId":"75","text":"2.68.060 Records.","id":"9d4b5e08-f996-4464-a21b-036528c7086b","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a96f0bc3-e5de-4f15-a950-f81cb83f8100\/9d4b5e08-f996-4464-a21b-036528c7086b\/734c2358-7fe9-4426-9903-41477c1d1bcb","ref":{"parent":"9d4b5e08-f996-4464-a21b-036528c7086b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-220-16-11","docId":"75","text":"\u003Cp\u003EThe Commission shall keep a record of its proceedings and transactions, and shall render such reports to the City Council as may be required. These records shall be filed with the City Clerk.\u003C\/p\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 5 (part), 2018; Ord. 679, (part), 1975)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"734c2358-7fe9-4426-9903-41477c1d1bcb","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a96f0bc3-e5de-4f15-a950-f81cb83f8100\/2d88f2a7-be47-4689-a22d-a0bfdf7cd73a","ref":{"parent":"a96f0bc3-e5de-4f15-a950-f81cb83f8100","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-220-17","docId":"75","text":"2.68.070 Duties\u2013Powers\u2013Responsibilities.","id":"2d88f2a7-be47-4689-a22d-a0bfdf7cd73a","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a96f0bc3-e5de-4f15-a950-f81cb83f8100\/2d88f2a7-be47-4689-a22d-a0bfdf7cd73a\/0c2dfdf1-1d23-4362-8ef3-115fb432c456","ref":{"parent":"2d88f2a7-be47-4689-a22d-a0bfdf7cd73a","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-220-17-11","docId":"75","text":"\u003Cp\u003EThe Library Commission shall have the following duties, powers and responsibilities, and such other as they may be entrusted with by the City Council from time to time:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EConsult with the City Council, the City staff and the Santa Clara County Library Joint Powers Authority and staff regarding the functioning of the physical facilities of the Cupertino Library and shall make recommendations from time to time for improvement or modification thereof;\u003C\/li\u003E\u003Cli\u003EConsult with the City Council, the City staff and the Santa Clara County Library Joint Powers Authority and staff regarding the Cupertino Library programs and services to the community and shall make recommendations from time to time for improvements or modifications thereof;\u003C\/li\u003E\u003Cli\u003EConsult with and act as liaison with private community groups supportive of the library program;\u003C\/li\u003E\u003Cli\u003EConsult with the architect and the City Council in the planning of any main or branch library building facilities, including locations, building layout, architecture, landscaping and furnishings;\u003C\/li\u003E\u003Cli\u003EHold hearings, formulate policies and make rules and procedures with respect to the foregoing for approval by the City Council;\u003C\/li\u003E\u003Cli\u003EPerform such other tasks as may be expressly requested of it by the City Council.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1697, (part), 1995; Ord. 679, (part), 1975)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0c2dfdf1-1d23-4362-8ef3-115fb432c456","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a96f0bc3-e5de-4f15-a950-f81cb83f8100\/a99a8e0f-fbf7-47ca-9f3b-b72b7ecf45ff","ref":{"parent":"a96f0bc3-e5de-4f15-a950-f81cb83f8100","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-220-18","docId":"75","text":"2.68.080 Effect.","id":"a99a8e0f-fbf7-47ca-9f3b-b72b7ecf45ff","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/a96f0bc3-e5de-4f15-a950-f81cb83f8100\/a99a8e0f-fbf7-47ca-9f3b-b72b7ecf45ff\/b547d659-8524-4bc2-835c-d79186281f3e","ref":{"parent":"a99a8e0f-fbf7-47ca-9f3b-b72b7ecf45ff","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-220-18-11","docId":"75","text":"\u003Cp\u003ENothing in this chapter shall be construed as restricting or curtailing any of the powers of the City Council or City officers, or the delegation to the Library Commission of any authority or discretionary powers imposed by law in such council or officers. The City Council declares that the public interest, convenience, welfare and necessity require the appointment of a Library Commission to act in a purely advisory capacity to such Council, for the purpose enumerated in this chapter.\u003C\/p\u003E\u003Cp\u003E(Ord. 679, (part), 1975)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"b547d659-8524-4bc2-835c-d79186281f3e","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-221","docId":"75","text":"CHAPTER 2.74: CUPERTINO TECHNOLOGY, INFORMATION, AND COMMUNICATIONS COMMISSION*","id":"af89ac79-b23a-4967-8dcc-ffe51e849508","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508\/0ff09a7b-0463-4d02-beeb-246388b5a676","ref":{"parent":"af89ac79-b23a-4967-8dcc-ffe51e849508","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-221-11","docId":"75","text":"\u003Cp\u003E* Prior ordinance history: Ords. 1099, 1166, 1167, 1233, 1280, 1321, 1465 and 1697.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0ff09a7b-0463-4d02-beeb-246388b5a676","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508\/685eb80a-ec15-462d-9e87-d176b4d967bc","ref":{"parent":"af89ac79-b23a-4967-8dcc-ffe51e849508","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-221-12","docId":"75","text":"2.74.010 Established.","id":"685eb80a-ec15-462d-9e87-d176b4d967bc","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508\/685eb80a-ec15-462d-9e87-d176b4d967bc\/c0146d8b-84dc-4378-ba8d-b0d7b8ad3c1f","ref":{"parent":"685eb80a-ec15-462d-9e87-d176b4d967bc","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-221-12-11","docId":"75","text":"\u003Cp\u003EThe Technology, Information, and Communications Commission ( formerly Telecommunications Commission of the City) is established and shall consist of five members, none of whom shall be officials or employees of the City, nor cohabit with, as defined by law, nor be related by blood or marriage to any member of the Commission, the City Manager or the staff person( s) assigned to this Commission. All members shall be City of Cupertino residents. Members of the Technology, Information, and Communications Commission shall be appointed by the City Council.\u003C\/p\u003E\u003Cp\u003E(Ord. 2010, 2007; Ord. 1995, (part), 2007; Ord. 1965, (part), 2005; Ord. 1722, (part), 1996; Ord. 1714, (part), 1996; Ord. 24-2267, Att. A (part), 2024)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"c0146d8b-84dc-4378-ba8d-b0d7b8ad3c1f","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508\/64e4b79f-e92b-4412-9ac8-cb2774903fec","ref":{"parent":"af89ac79-b23a-4967-8dcc-ffe51e849508","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-221-13","docId":"75","text":"2.74.020 Terms of Office.","id":"64e4b79f-e92b-4412-9ac8-cb2774903fec","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508\/64e4b79f-e92b-4412-9ac8-cb2774903fec\/c37bb6bc-6971-480d-b30a-b95d65a2443a","ref":{"parent":"64e4b79f-e92b-4412-9ac8-cb2774903fec","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-221-13-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ECommissioners serve at the pleasure of the City Council. The term of office of the members of the Technology, Information, and Communications Commission shall be for four years and shall end on January 30th of the year their term is due to expire. No commissioner shall serve more than two consecutive terms except that a commissioner may serve more than two consecutive terms if he or she has been appointed to the Commission to fill an unexpired term of less than two years.\u003C\/li\u003E\u003Cli\u003EThe appointment, reappointment and rules governing incumbent members of the Commission are governed by the Resolution of the Cupertino City Council which governs advisory bodies.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 6 (part), 2018; Ord. 1974, \u00a7 4 (part), 2006; Ord. 1965, (part), 2005; Ord. 1722, (part), 1996; Ord. 1714, (part), 1996)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"c37bb6bc-6971-480d-b30a-b95d65a2443a","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508\/b84d14f1-fb5c-4ea5-88be-d5fdece4eb63","ref":{"parent":"af89ac79-b23a-4967-8dcc-ffe51e849508","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-221-14","docId":"75","text":"2.74.030 Vacancy\u2013Removal.","id":"b84d14f1-fb5c-4ea5-88be-d5fdece4eb63","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508\/b84d14f1-fb5c-4ea5-88be-d5fdece4eb63\/d2db62c2-887f-4d43-a87a-f2579bbde8ec","ref":{"parent":"b84d14f1-fb5c-4ea5-88be-d5fdece4eb63","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-221-14-11","docId":"75","text":"\u003Cp\u003EAny member may be removed by a majority vote of the City Council. If a vacancy occurs other than by expiration of a term vacancies shall be filled by appointment of the City Council and shall be for the unexpired portion of the term of office vacated.\u003C\/p\u003E\u003Cp\u003E(Ord. 1965, (part), 2005; Ord. 1714, (part), 1996)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d2db62c2-887f-4d43-a87a-f2579bbde8ec","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508\/b3b7aa12-5920-41db-92c1-800979d686ac","ref":{"parent":"af89ac79-b23a-4967-8dcc-ffe51e849508","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-221-15","docId":"75","text":"2.74.040 Meeting\u2013Quorum\u2013Officers\u2013Staff.","id":"b3b7aa12-5920-41db-92c1-800979d686ac","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508\/b3b7aa12-5920-41db-92c1-800979d686ac\/c089daf5-7061-4060-9b79-3fd8c6ed2732","ref":{"parent":"b3b7aa12-5920-41db-92c1-800979d686ac","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-221-15-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe Technology, Information, and Communications Commission shall hold regular meetings at least once every three months and at the discretion of the Commission shall hold other meetings as may be necessary or expedient. A majority of the Commission shall constitute a quorum for the purpose of transacting the business of the Commission.\u003C\/li\u003E\u003Cli\u003EThe Commission shall elect a chairperson and a vice chairperson, both of whom shall serve at the pleasure of the Commission. The terms of office shall be for one year.\u003C\/li\u003E\u003Cli\u003EThe City Manager shall appoint a staff member to attend Commission meetings and to provide liaison and support as needed. (Ord. 21-2234, Att. A (\u00a7 4), 2021; Ord. 1965, (part), 2005; Ord. 1722, (part), 1996; Ord. 1714, (part), 1996)\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E\u003C\/p\u003E","id":"c089daf5-7061-4060-9b79-3fd8c6ed2732","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508\/aab27dc4-526a-457d-8eb2-d14ac4d6277b","ref":{"parent":"af89ac79-b23a-4967-8dcc-ffe51e849508","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-221-16","docId":"75","text":"2.74.050 Records.","id":"aab27dc4-526a-457d-8eb2-d14ac4d6277b","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508\/aab27dc4-526a-457d-8eb2-d14ac4d6277b\/e7436cde-4df8-4274-8521-801a3f8c9c4d","ref":{"parent":"aab27dc4-526a-457d-8eb2-d14ac4d6277b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-221-16-11","docId":"75","text":"\u003Cp\u003EThe Commission shall keep an accurate record of its proceedings and transactions, and shall render such reports to the City Council as may be required. These records shall be filed with the City Clerk.\u003C\/p\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 6 (part), 2018; Ord. 1965, (part), 2005; Ord. 1722, (part), 1996; Ord. 1714, (part), 1996)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"e7436cde-4df8-4274-8521-801a3f8c9c4d","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508\/90101dff-2a6e-4ca5-a482-29e27f3f1aae","ref":{"parent":"af89ac79-b23a-4967-8dcc-ffe51e849508","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-221-17","docId":"75","text":"2.74.060 Duties, Powers and Responsibilities.","id":"90101dff-2a6e-4ca5-a482-29e27f3f1aae","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508\/90101dff-2a6e-4ca5-a482-29e27f3f1aae\/5c5889ac-bed5-48f0-a8c8-a67f36d6da6f","ref":{"parent":"90101dff-2a6e-4ca5-a482-29e27f3f1aae","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-221-17-11","docId":"75","text":"\u003Cp\u003EThe Cupertino Technology, Information, and Communications Commission shall have the following duties, powers and responsibilities, and such others as the members shall be entrusted with by the City Council from time to time. The commission shall:\u003C\/p\u003E\u003Col\u003E\u003Cli\u003EAdvise the City Council and City Manager on all matters relating to technology, information, and communications within the City of Cupertino;\u003C\/li\u003E\u003Cli\u003EServe as a liaison between the City, the public and the technology, information, and communications providers in enhancing information and education. Such activities include providing an opportunity for input to residents and disseminating noncommercial, educational materials about technology, information, and communications services;\u003C\/li\u003E\u003Cli\u003EProvide support for community access television, especially public and educational access, and give guidance when needed for development and implementation of access channels and programming;\u003C\/li\u003E\u003Cli\u003ERecommend ways to foster the City\u2019s best use of technology, information, and communications infrastructure and services for the maximum benefit of the community; and\u003C\/li\u003E\u003Cli\u003EProvide education to the community on the responsible and safe use of technology, information, and communications infrastructure and services, including cybersecurity education and best practices.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1965, (part), 2005: Ord. 1722, (part), 1996; Ord. 1714, (part), 1996; Ord. 24-2267, Att. A (part), 2024)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"5c5889ac-bed5-48f0-a8c8-a67f36d6da6f","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508\/5cc4e70c-5417-4e51-9bac-0a54b83e1adf","ref":{"parent":"af89ac79-b23a-4967-8dcc-ffe51e849508","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-221-18","docId":"75","text":"2.74.070 Budget.","id":"5cc4e70c-5417-4e51-9bac-0a54b83e1adf","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508\/5cc4e70c-5417-4e51-9bac-0a54b83e1adf\/ad3f8e43-91d9-4cd7-9277-e8cc4d020f30","ref":{"parent":"5cc4e70c-5417-4e51-9bac-0a54b83e1adf","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-221-18-11","docId":"75","text":"\u003Cp\u003EThe Technology, Information, and Communications Commission shall submit an annual budget to the City Council for its review and approval. All expenditures require the approval of the City Manager or his designee. Any grants for program production or other purposes require the approval of the City Council.\u003C\/p\u003E\u003Cp\u003E(Ord. 1965, (part), 2005; Ord. 1722, (part), 1996; Ord. 1714, (part), 1996)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"ad3f8e43-91d9-4cd7-9277-e8cc4d020f30","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508\/fcde69c9-dd6e-4a0d-a25d-1d88ccac6344","ref":{"parent":"af89ac79-b23a-4967-8dcc-ffe51e849508","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-221-19","docId":"75","text":"2.74.075 Compensation\u2013Expenses.","id":"fcde69c9-dd6e-4a0d-a25d-1d88ccac6344","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508\/fcde69c9-dd6e-4a0d-a25d-1d88ccac6344\/6553a4bb-a88c-44df-b5c3-6a9ad99df0b5","ref":{"parent":"fcde69c9-dd6e-4a0d-a25d-1d88ccac6344","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-221-19-11","docId":"75","text":"\u003Cp\u003EMembers of the Technology, Information, and Communications Commission shall serve without compensation. Commissioners may be reimbursed for necessary expenses reasonably incurred by them while acting in their official capacity subject to the approval of the City Manager.\u003C\/p\u003E\u003Cp\u003E(Ord. 21-2234, Att. A (\u00a7 2, part), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"6553a4bb-a88c-44df-b5c3-6a9ad99df0b5","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508\/2ac92e4f-e256-4ba4-a2de-245f859f6c93","ref":{"parent":"af89ac79-b23a-4967-8dcc-ffe51e849508","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-221-210","docId":"75","text":"2.74.080 Effect.","id":"2ac92e4f-e256-4ba4-a2de-245f859f6c93","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/af89ac79-b23a-4967-8dcc-ffe51e849508\/2ac92e4f-e256-4ba4-a2de-245f859f6c93\/eb4b35cb-1730-4b28-ae34-d0d5d459b151","ref":{"parent":"2ac92e4f-e256-4ba4-a2de-245f859f6c93","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-221-210-11","docId":"75","text":"\u003Cp\u003ENothing in this chapter shall be construed as restricting or curtailing any of the powers of the City Council or City officers or the delegation to the Technology, Information, and Communications Commission of any authority or discretionary powers empowered by law on such Council or officers.\u003C\/p\u003E\u003Cp\u003E(Ord. 1965, (part), 2005; Ord. 1722, (part), 1996; Ord. 1714, (part), 1996)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"eb4b35cb-1730-4b28-ae34-d0d5d459b151","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-222","docId":"75","text":"CHAPTER 2.78: LANDLORD-TENANT MEDIATION\u2013ISSUANCE OF SUBPOENAS","id":"29123335-8323-4562-98b6-351df287a137","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137\/ed468583-82f8-4ffd-99f6-fc6eef12eed5","ref":{"parent":"29123335-8323-4562-98b6-351df287a137","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-222-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"ed468583-82f8-4ffd-99f6-fc6eef12eed5","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137\/ce411b5b-d12e-4c14-a671-47b9a6e7e06d","ref":{"parent":"29123335-8323-4562-98b6-351df287a137","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-222-12","docId":"75","text":"2.78.010 Purpose.","id":"ce411b5b-d12e-4c14-a671-47b9a6e7e06d","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137\/ce411b5b-d12e-4c14-a671-47b9a6e7e06d\/1d46605f-442f-448a-aadb-c56eed4cc1c1","ref":{"parent":"ce411b5b-d12e-4c14-a671-47b9a6e7e06d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-222-12-11","docId":"75","text":"\u003Cp\u003EThe City sponsors a landlord-tenant mediation program designed to provide a mechanism to resolve disputes between landlords and tenants in the rental of residential property. The purpose of this chapter is to establish a procedure for the issuance of subpoenas to compel the attendance of relevant parties before a mediator assigned pursuant to that program. It is the intent of the City that to the greatest degree possible the mediation process be entirely voluntary. The use of the subpoena power established hereunder should be limited and should be exercised only in those cases where the findings set forth in this chapter are made. Nothing contained in this chapter shall be deemed to limit or supersede any authority otherwise vested in the City Council or other City officer.\u003C\/p\u003E\u003Cp\u003E(Ord. 1306, \u00a7 1 (part), 1985)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"1d46605f-442f-448a-aadb-c56eed4cc1c1","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137\/4332b9a0-ff6e-497e-898d-a32c8e6df5ca","ref":{"parent":"29123335-8323-4562-98b6-351df287a137","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-222-13","docId":"75","text":"2.78.020 Authority to Issue Subpoenas.","id":"4332b9a0-ff6e-497e-898d-a32c8e6df5ca","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137\/4332b9a0-ff6e-497e-898d-a32c8e6df5ca\/c9d56608-3483-4b0a-a2af-d44919f635d4","ref":{"parent":"4332b9a0-ff6e-497e-898d-a32c8e6df5ca","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-222-13-11","docId":"75","text":"\u003Cp\u003EPursuant to the provisions of this chapter, the City Attorney is authorized to issue subpoenas to compel relevant parties to a rental dispute which is the subject of a request for mediation pursuant to the City\u2019s landlord-tenant mediation program to appear before the mediator assigned and to compel the production of testimony before the mediator. To the extent required by law, such mediators shall be authorized to administer oaths and receive testimony. The authority granted to the City Attorney hereunder shall not be delegated to any other person. A subpoena may only be issued upon application therefor made pursuant to this chapter.\u003C\/p\u003E\u003Cp\u003E(Ord. 1306, \u00a7 1 (part), 1985)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"c9d56608-3483-4b0a-a2af-d44919f635d4","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137\/504a223d-9c2c-408a-a86a-5dba709bf4cc","ref":{"parent":"29123335-8323-4562-98b6-351df287a137","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-222-14","docId":"75","text":"2.78.030 Limitations on Authority.","id":"504a223d-9c2c-408a-a86a-5dba709bf4cc","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137\/504a223d-9c2c-408a-a86a-5dba709bf4cc\/1061b856-1bda-4273-8909-0c61121ac1fc","ref":{"parent":"504a223d-9c2c-408a-a86a-5dba709bf4cc","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-222-14-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EAn application for a subpoena may be made only by a party to a rental dispute who has made a request for mediation of the dispute pursuant to the City\u2019s landlord-tenant mediation program.\u003C\/li\u003E\u003Cli\u003ESubpoenas may be issued hereunder only to compel the attendance of a relevant party directly related to the dispute which is the subject of the request for mediation. Subpoenas may not be issued to compel the attendance of third parties not directly related to the dispute. For purposes of this subsection, a relevant party directly related to a dispute includes the occupant, tenant, owner or manager of the premises which is the subject of the dispute, or any agent, representative or contractor of such parties.\u003C\/li\u003E\u003Cli\u003ESubpoenas may be issued pursuant to this chapter only to compel the attendance of parties before the mediator. Subpoenas duces tecum requiring the production of records or other things are not authorized pursuant to this chapter.\u003C\/li\u003E\u003Cli\u003ENo subpoena shall be issued pursuant to this chapter unless a request for mediation has been made pursuant to the City\u2019s landlord-tenant mediation program, the person to whom the requested subpoena is directed has been advised of the request for mediation and has either expressly declined to appear for such mediation or has failed to appear at a scheduled mediation session.\u003C\/li\u003E\u003Cli\u003ESubpoenas issued pursuant to this chapter may compel attendance of the person subpoenaed only at Cupertino City Hall, 10300 Torre Avenue, Cupertino, California, or at the offices of the mediation service designated by the City to administer the mediation program, except that nothing contained in this subsection shall prevent the parties to a dispute and the mediator assigned from agreeing to an alternate location after issuance of the subpoena.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1306, \u00a7 1(part), 1985)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"1061b856-1bda-4273-8909-0c61121ac1fc","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137\/0ec9c2b9-593d-4914-933a-fb24e2cfcbf9","ref":{"parent":"29123335-8323-4562-98b6-351df287a137","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-222-15","docId":"75","text":"2.78.040 Application Procedure.","id":"0ec9c2b9-593d-4914-933a-fb24e2cfcbf9","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137\/0ec9c2b9-593d-4914-933a-fb24e2cfcbf9\/bcaa77bc-7835-4e08-bd52-af2de5da7944","ref":{"parent":"0ec9c2b9-593d-4914-933a-fb24e2cfcbf9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-222-15-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EAn application for subpoena must be in writing and filed with the City Attorney in such form as may be prescribed by the City Attorney. Applications shall be accompanied by such declarations, affidavits and materials as may be required by this chapter or by the City Attorney. All factual matters upon which the application is based shall be supported by affidavits or declarations executed under penalty of perjury. The determinations made by the City Attorney under this chapter shall be made based on the application, declarations, affidavits and supporting materials submitted with the application or in opposition to it. No hearing shall be held by the City Attorney prior to a determination on the application. Time limits established in this chapter for the performance of any act by the City or an officer thereof may be extended by the City with the consent of the affected party or parties, or without such consent in the event of the incapacity or unavailability of the officer required to perform the act. Failure of any party to actually receive any notices or materials provided by the City in accordance with the terms of this chapter shall not affect the validity of any action taken hereunder. Where any written notice is required, the City Attorney may, in addition, attempt to give telephone notice to the parties as a matter of convenience to the parties. Any material which may or is required to be mailed to any party by City, if such person has provided a mailing, business or residence address to City in the course of the application process, may be mailed to the person at that address in lieu of any other address which may be provided herein.\u003C\/li\u003E\u003Cli\u003E\u003Col\u003E\u003Cli\u003EThe City Attorney shall forward a copy of any application received, along with supporting materials, to the person as to whom a subpoena is being sought. The material may be delivered in person or may be mailed by first class mail. If delivered, the material need not be personally served but may be delivered in such fashion as is reasonably calculated to result in its receipt by the intended person such as delivering it to the person\u2019s residence, place of business or agent for purposes of conducting the rental operations. If mailed, the material shall be addressed as follows in the listed priority:\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\u003Cli\u003ETo the current residence or business address of the person, if known;\u003C\/li\u003E\u003Cli\u003EIf a mailing address is shown for the person on the most recent application for a Cupertino business license for the operation of the rental property which is the subject of the mediation, then to the person at that address. Such address may be used where the person sought to be subpoenaed is an individual known to be an owner, officer or employee of a business entity for whom the address is given;\u003C\/li\u003E\u003Cli\u003ETo the person at the mailing address shown for the person on the most recent application for any other Cupertino business license;\u003C\/li\u003E\u003Cli\u003EIf the person is a tenant in the rental premises which is the subject of the mediation, then to the person at the address of the premises;\u003C\/li\u003E\u003Cli\u003ETo the person at the last known residence or business address.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EThe City Attorney shall forward with said materials a notice of the filing of the application which shall contain a written summary of the procedures applicable to issuance of a subpoena. If upon preliminary review of the application and supporting materials the City Attorney determines to deny the application, the notice shall so state and shall constitute the notice of determination required pursuant to subsection D of this section. Such notice shall also be forwarded to the applicant.\u003C\/li\u003E\u003Cli\u003EIf upon such preliminary review the City Attorney determines that the application may support issuance of a subpoena, the notice shall advise the person of his or her rights under subsection C of this section.\u003C\/li\u003E\u003Cli\u003ESuch preliminary review shall be completed not more than five working days from the filing of the application.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EIf upon preliminary review the City Attorney determines the application may support issuance of a subpoena, then on or before a date specified in the notice, which date shall not be less than five calendar days after the delivery or mailing of the notice, the person to whom the notice is directed may file with the City Attorney declarations, affidavits or other material in opposition to the application. Such material must be received by the City Attorney by the date specified to be considered. The notice shall specify the date by which the material must be filed.\u003C\/li\u003E\u003Cli\u003EWithin five working days after the submittal of material opposing the application, or of the expiration of the time for such submittal, whichever is earlier, the City Attorney shall determine whether to issue the requested subpoena. Written notice of the determination shall be given to both parties in the manner specified in subsection B of this section. If an appeal is filed pursuant to Section 2.78.090, action by the City Attorney shall be stayed. If no appeal is filed, the action of the City Attorney shall be final. The notice shall state the date by which an appeal must be filed.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1306, \u00a7 1(part), 1985)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"bcaa77bc-7835-4e08-bd52-af2de5da7944","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137\/31a47f4d-ccbd-4697-84a4-1720fad1e051","ref":{"parent":"29123335-8323-4562-98b6-351df287a137","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-222-16","docId":"75","text":"2.78.050 Application Contents.","id":"31a47f4d-ccbd-4697-84a4-1720fad1e051","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137\/31a47f4d-ccbd-4697-84a4-1720fad1e051\/b370379d-3f79-4e11-9861-44e46bb3c613","ref":{"parent":"31a47f4d-ccbd-4697-84a4-1720fad1e051","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-222-16-11","docId":"75","text":"\u003Cp\u003EAn application for subpoena shall be filed in such form as may be prescribed by the City Attorney. The City Attorney is authorized to require the submittal of such material or information as may be deemed necessary. An applicant may submit such declarations, affidavits and other supporting materials as may be desired by the applicant. The application shall, at a minimum, be accompanied by:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EA declaration or affidavit of the applicant setting forth:\u003Col\u003E\u003Cli\u003EA factual description of the dispute which is the subject of the mediation, sufficient to allow the determinations required by Section 2.78.070;\u003C\/li\u003E\u003Cli\u003EA statement of any facts necessary to allow a determination of whether the application complied with the procedural requirements of this chapter;\u003C\/li\u003E\u003Cli\u003EA general description of the information considered relevant to the mediation process known or believed to be in the possession of the person sought to be subpoenaed;\u003C\/li\u003E\u003Cli\u003EThe status of the person sought to be subpoenaed and his or her relationship to the dispute which is the subject of the mediation;\u003C\/li\u003E\u003Cli\u003EThe business and residence address of the person sought to be subpoenaed, if known;\u003C\/li\u003E\u003Cli\u003EA statement that the subpoena is not being sought for the purpose of harassing any person; and\u003C\/li\u003E\u003Cli\u003ESuch other information as may be required by the City Attorney.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EA declaration or affidavit of the mediator assigned to the dispute or of a representative of the mediation service responsible for the administration of the City\u2019s rental mediation program containing a statement of any facts necessary to allow a determination of whether the application complies with the procedural requirements of this chapter.\u003C\/li\u003E\u003Cli\u003EA recommendation from the assigned mediator or from a representative of the mediation service as to whether the findings required by Section 2.78.070 can be made and whether the requested subpoena should be issued. This recommendation may be incorporated in the declaration or affidavit required by subsection B of this section.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003EThe City Attorney shall not be bound by the recommendation.\u003C\/p\u003E\u003Cp\u003E(Ord. 1306, \u00a7 1(part), 1985)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"b370379d-3f79-4e11-9861-44e46bb3c613","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137\/a4fa338f-133d-4fd6-892e-b4737d4855a0","ref":{"parent":"29123335-8323-4562-98b6-351df287a137","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-222-17","docId":"75","text":"2.78.060 Form of Subpoena\u2013Service of Process.","id":"a4fa338f-133d-4fd6-892e-b4737d4855a0","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137\/a4fa338f-133d-4fd6-892e-b4737d4855a0\/13db61f6-2f71-4542-b67d-7caa53b72b4e","ref":{"parent":"a4fa338f-133d-4fd6-892e-b4737d4855a0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-222-17-11","docId":"75","text":"\u003Cp\u003ESubpoenas shall be issued in the name of the City and attested by the City Clerk. Subpoenas shall be in such form as may be prescribed by the City Attorney and shall include the date, time and place at which attendance of the party is compelled. Nothing contained herein shall prevent the parties from agreeing, subsequent to the issuance of the subpoena, to a revised time or place for the mediation. Subpoenas issued under this chapter shall be served in the same manner as subpoenas issued in civil actions pursuant to the California Code of Civil Procedure, except that such subpoenas shall be served not less than seven calendar days prior to the required date of appearance, unless for good cause shown the City Attorney shall authorize a shorter period. Payment of fees or mileage shall not be required in connection with the service or enforcement of a subpoena issued pursuant to this chapter. The person requesting the subpoena shall be responsible for its service.\u003C\/p\u003E\u003Cp\u003E(Ord. 1306, \u00a7 1(part), 1985)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"13db61f6-2f71-4542-b67d-7caa53b72b4e","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137\/eb76131f-995f-4d7e-8d11-14cc372298e0","ref":{"parent":"29123335-8323-4562-98b6-351df287a137","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-222-18","docId":"75","text":"2.78.070 Findings.","id":"eb76131f-995f-4d7e-8d11-14cc372298e0","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137\/eb76131f-995f-4d7e-8d11-14cc372298e0\/2db0df31-cde2-4e56-b45e-5f89475d991d","ref":{"parent":"eb76131f-995f-4d7e-8d11-14cc372298e0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-222-18-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe City Attorney may issue a subpoena pursuant to this chapter if all of the following findings are made:\u003Col\u003E\u003Cli\u003EIssuance of the subpoena would comply with all provisions of this chapter, including but not limited to the provisions of Section 2.78.030;\u003C\/li\u003E\u003Cli\u003EThe attendance and testimony of the party sought pursuant to the subpoena is material and relevant to the dispute which is the subject of the request for mediation;\u003C\/li\u003E\u003Cli\u003EThe issue which is the subject of the mediation is, or may be, of such nature as to involve issues of fact either in dispute or which may be the basis of the conflict between the parties which, if resolved or clarified, may promote the mediation process;\u003C\/li\u003E\u003Cli\u003EThe application for subpoena is not being made for the purpose of harassing the person as to whom the subpoena is being requested;\u003C\/li\u003E\u003Cli\u003EThe applicant has submitted the materials required by Section 2.78.050;\u003C\/li\u003E\u003Cli\u003EThe issuance of the requested subpoena would not be contrary to the purposes of the City\u0027s rental mediation program.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EThe City Attorney shall not issue a subpoena if he is unable to make all of the findings set forth in subsection A of this section or if he makes any of the following findings:\u003Col\u003E\u003Cli\u003EIssuance of a subpoena would constitute an undue hardship on the person being subpoenaed;\u003C\/li\u003E\u003Cli\u003EIssuance of a subpoena would be ineffectual in light of the nature or timing of the dispute which is the subject of the mediation;\u003C\/li\u003E\u003Cli\u003EIssuance of a subpoena would be detrimental to the mediation process or the City\u2019s rental mediation program.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EThe determination of the City Attorney to issue or not to issue a subpoena shall be based on his review and evaluation of the material submitted in light of the purposes of this chapter and the required findings. The City Attorney shall exercise his judgment in making the determinations required. The City Attorney may take into consideration, but shall not be bound by, the recommendation submitted pursuant to subsection C of Section 2.78.050. A subpoena shall not be issued pursuant to this chapter if the City Attorney finds that such issuance would be in conflict with any applicable provision of law.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1306, \u00a7 1(part), 1985)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"2db0df31-cde2-4e56-b45e-5f89475d991d","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137\/b2d2e89e-049c-4f49-b4ca-cdc073d8fd39","ref":{"parent":"29123335-8323-4562-98b6-351df287a137","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-222-19","docId":"75","text":"2.78.080 Appeal to City Council.","id":"b2d2e89e-049c-4f49-b4ca-cdc073d8fd39","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137\/b2d2e89e-049c-4f49-b4ca-cdc073d8fd39\/77468741-d1c0-4ec7-ad74-d2869d650ecf","ref":{"parent":"b2d2e89e-049c-4f49-b4ca-cdc073d8fd39","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-222-19-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EWithin five working days after the delivery or mailing of the notice determination required under subsection D of Section 2.78.040, either party may appeal the determination of the City Attorney to the City Council by filing a written appeal with the City Clerk. Upon receipt of an appeal, the City Clerk shall schedule the appeal for consideration by the City Council at a regular meeting within fourteen days of the filing of the appeal, if a regular meeting is held during that period and not less than five calendar days from the filing of the appeal. Written notice of the time and place of the meeting at which the City Council will consider the appeal shall be mailed to the parties within two working days after receipt of the appeal. The City Council may continue its consideration from time to time.\u003C\/li\u003E\u003Cli\u003EThe City Attorney shall forward to the City Council all materials which were filed with and considered by the City Attorney with respect to the application. Either party may provide additional material for consideration by the City Council; provided, that the City Council shall not be obligated to consider written material submitted to the City Clerk less than five calendar days prior to the City Council meeting. At the time the appeal is considered, both parties shall be entitled to address the City Council orally concerning the appeal.\u003C\/li\u003E\u003Cli\u003EUpon consideration of the appeal, the City Council shall either grant the application and issue the requested subpoena or deny the application. The Council\u2019s determination shall be based on its consideration of the materials submitted by the City Attorney, such additional materials as may be submitted by any of the parties, and such other information or material as may be submitted during or prior to its consideration. The City Council shall exercise its independent judgment in reaching its determination and shall base its determination upon the same criteria as are set forth in this chapter with respect to the determination by the City Attorney.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1306, \u00a7 1(part), 1985)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"77468741-d1c0-4ec7-ad74-d2869d650ecf","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137\/807a862e-013e-47c9-b7ad-115c6eb4cbc8","ref":{"parent":"29123335-8323-4562-98b6-351df287a137","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-222-210","docId":"75","text":"2.78.090 Enforcement.","id":"807a862e-013e-47c9-b7ad-115c6eb4cbc8","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/29123335-8323-4562-98b6-351df287a137\/807a862e-013e-47c9-b7ad-115c6eb4cbc8\/312c30ec-81e1-4224-8f36-b33d5b7957d4","ref":{"parent":"807a862e-013e-47c9-b7ad-115c6eb4cbc8","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-222-210-11","docId":"75","text":"\u003Cp\u003EIn addition to any other remedy provided by law, the party at whose request a subpoena has been issued, the City or the mediation service designated to administer the City\u2019s rental mediation program shall be authorized to bring an action in a court of appropriate jurisdiction for the enforcement of any subpoena issued pursuant to this chapter.\u003C\/p\u003E\u003Cp\u003E(Ord. 1306, \u00a7 1(part), 1985)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"312c30ec-81e1-4224-8f36-b33d5b7957d4","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-223","docId":"75","text":"CHAPTER 2.80: ARTS AND CULTURE COMMISSION","id":"eb6ec29b-3097-4bc0-90d5-da3f92d8e065","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/abc781eb-c798-455c-a58c-7542443348b4","ref":{"parent":"eb6ec29b-3097-4bc0-90d5-da3f92d8e065","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-223-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"abc781eb-c798-455c-a58c-7542443348b4","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/bb62ffe7-b9a7-43ad-9b83-169b4714d06b","ref":{"parent":"eb6ec29b-3097-4bc0-90d5-da3f92d8e065","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-223-12","docId":"75","text":"2.80.010 Established.","id":"bb62ffe7-b9a7-43ad-9b83-169b4714d06b","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/bb62ffe7-b9a7-43ad-9b83-169b4714d06b\/8a30d34d-3ce6-4345-bf1c-f80ceaaf9304","ref":{"parent":"bb62ffe7-b9a7-43ad-9b83-169b4714d06b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-223-12-11","docId":"75","text":"\u003Cp\u003EThe Arts and Culture Commission of the City is established. The Arts and Culture Commission shall consist of five members, none of whom shall be officials or employees of the City, nor cohabit with as defined by law, nor be related by blood or marriage to any member of the Commission, the City Manager or the staff person(s) assigned to this Commission. At least three members shall be City of Cupertino residents. Members of the Arts and Culture Commission shall be appointed by the City Council. Membership will be drawn to represent the arts, citizens and business community on an approximately equal basis.\u003C\/p\u003E\u003Cp\u003E(Ord. 22-2241, \u00a7 2, 2022; Ord. 19-2182, \u00a7 1, (part), 2019; Ord. 18-2171, 2018; Ord. 1934, (part), 2004; Ord. 1466, (part), 1988; Ord. 1401, (part), 1987)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"8a30d34d-3ce6-4345-bf1c-f80ceaaf9304","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/27c936c8-d49a-446a-af6a-a27d69d13134","ref":{"parent":"eb6ec29b-3097-4bc0-90d5-da3f92d8e065","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-223-13","docId":"75","text":"2.80.020 Terms of Office.","id":"27c936c8-d49a-446a-af6a-a27d69d13134","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/27c936c8-d49a-446a-af6a-a27d69d13134\/d4fddb40-cfdd-4afe-872d-4ab18c4bd461","ref":{"parent":"27c936c8-d49a-446a-af6a-a27d69d13134","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-223-13-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ECommissioners serve at the pleasure of the City Council. The term of office of the members of the Arts and Culture Commission shall be for four years and shall end on January 30th of the year their term is due to expire. No commissioner shall serve more than two consecutive terms, except that a commissioner may serve more than two consecutive terms if he or she has been appointed to the Commission to fill an unexpired term of less than two years.\u003C\/li\u003E\u003Cli\u003EThe appointment, reappointment and rules governing incumbent members of the Commission are governed by the Resolution of the Cupertino City Council which governs advisory bodies.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 22-2241, \u00a7 3, 2022; Ord. 18-2180, \u00a7 7 (part), 2018; Ord. 1974, \u00a7 2, 2006; Ord. 1705, (part), 1995; Ord. 1466, (part), 1988; Ord. 1401, (part), 1987)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d4fddb40-cfdd-4afe-872d-4ab18c4bd461","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/92d91051-754d-449c-a820-1c6aa294aecf","ref":{"parent":"eb6ec29b-3097-4bc0-90d5-da3f92d8e065","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-223-14","docId":"75","text":"2.80.030 Members\u2013Vacancy or Removal.","id":"92d91051-754d-449c-a820-1c6aa294aecf","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/92d91051-754d-449c-a820-1c6aa294aecf\/204c3823-0b0c-420c-8342-619eed785b18","ref":{"parent":"92d91051-754d-449c-a820-1c6aa294aecf","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-223-14-11","docId":"75","text":"\u003Cp\u003EAny appointee member may be removed by a majority vote of the City Council. If a vacancy occurs other than by expiration of a term, it shall be filled by the City Council\u0027s appointment for the unexpired portion of the term.\u003C\/p\u003E\u003Cp\u003E(Ord. 1401, (part), 1987)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"204c3823-0b0c-420c-8342-619eed785b18","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/e01dca78-d705-4188-af4a-cfd25e511647","ref":{"parent":"eb6ec29b-3097-4bc0-90d5-da3f92d8e065","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-223-15","docId":"75","text":"2.80.040 Chairperson.","id":"e01dca78-d705-4188-af4a-cfd25e511647","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/e01dca78-d705-4188-af4a-cfd25e511647\/fe7d0b1d-b581-4bce-94aa-4876f99dcddd","ref":{"parent":"e01dca78-d705-4188-af4a-cfd25e511647","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-223-15-11","docId":"75","text":"\u003Cp\u003EThe Commission shall elect its chairperson and vice-chairperson from among its members and shall appoint a secretary. Terms of the chair and vice-chair shall be for one year. Upon approval of the City Council, the City Manager may appoint a secretary who need not be a member of the Commission.\u003C\/p\u003E\u003Cp\u003E(Ord. 2015, \u00a7 3, 2008; Ord. 1401, (part), 1987)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"fe7d0b1d-b581-4bce-94aa-4876f99dcddd","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/0c813f57-8c9c-422a-826b-8222d34dce30","ref":{"parent":"eb6ec29b-3097-4bc0-90d5-da3f92d8e065","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-223-16","docId":"75","text":"2.80.050 Meetings\u2013Quorum.","id":"0c813f57-8c9c-422a-826b-8222d34dce30","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/0c813f57-8c9c-422a-826b-8222d34dce30\/e85e4b97-944e-402e-9e4c-7397171a6099","ref":{"parent":"0c813f57-8c9c-422a-826b-8222d34dce30","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-223-16-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe Arts and Culture Commission shall establish a regular place of meeting and rules of conduct thereof and shall hold at least one regular meeting every other month.\u003C\/li\u003E\u003Cli\u003EA majority of the Arts and Culture Commission shall constitute a quorum for the purpose of transacting the business of the Commission. (Ord. 22-2241, \u00a7 4, 2022; Ord. 1964, \u00a7 3, 2005; Ord. 1401, (part), 1987)\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E\u003C\/p\u003E","id":"e85e4b97-944e-402e-9e4c-7397171a6099","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/37e95748-8516-4190-a95a-c5e104179d23","ref":{"parent":"eb6ec29b-3097-4bc0-90d5-da3f92d8e065","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-223-17","docId":"75","text":"2.80.060 Majority Vote Required.","id":"37e95748-8516-4190-a95a-c5e104179d23","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/37e95748-8516-4190-a95a-c5e104179d23\/03b834be-d0cf-4254-bc06-1c925d9ff7d8","ref":{"parent":"37e95748-8516-4190-a95a-c5e104179d23","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-223-17-11","docId":"75","text":"\u003Cp\u003EA majority vote is required to approve a recommendation on any matter that is presented to the Commission which requires a vote.\u003C\/p\u003E\u003Cp\u003E(Ord. 1401, (part), 1987)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"03b834be-d0cf-4254-bc06-1c925d9ff7d8","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/77452b55-9a23-4231-8425-cae0c20b374b","ref":{"parent":"eb6ec29b-3097-4bc0-90d5-da3f92d8e065","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-223-18","docId":"75","text":"2.80.070 Records.","id":"77452b55-9a23-4231-8425-cae0c20b374b","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/77452b55-9a23-4231-8425-cae0c20b374b\/392c5ab3-33ae-4ca4-b363-7261179c32ae","ref":{"parent":"77452b55-9a23-4231-8425-cae0c20b374b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-223-18-11","docId":"75","text":"\u003Cp\u003EThe Commission shall keep an accurate record of its proceedings and transactions and shall render such reports to the City Council as may be required. These records shall be filed with the City Clerk.\u003C\/p\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 7 (part), 2018; Ord. 1401, (part), 1987)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"392c5ab3-33ae-4ca4-b363-7261179c32ae","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/d91e44ed-f9cf-4ba9-a1f0-5f9d3c833d04","ref":{"parent":"eb6ec29b-3097-4bc0-90d5-da3f92d8e065","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-223-19","docId":"75","text":"2.80.080 Powers and Functions.","id":"d91e44ed-f9cf-4ba9-a1f0-5f9d3c833d04","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/d91e44ed-f9cf-4ba9-a1f0-5f9d3c833d04\/3c1deb45-bdfe-46bb-9767-8888bb37a7d0","ref":{"parent":"d91e44ed-f9cf-4ba9-a1f0-5f9d3c833d04","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-223-19-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe powers and functions of the Arts and Culture Commission shall be to foster, encourage and assist the realization, preservation and advancement of arts and culture for the benefit of the citizens of Cupertino.\u003C\/li\u003E\u003Cli\u003ETo fulfill their mission, the Commission may involve itself in the following activities:\u003Col\u003E\u003Cli\u003EAct as a catalyst for the promotion of arts and culture activities;\u003C\/li\u003E\u003Cli\u003EKeep current on potential arts and culture activities which would be available to the community;\u003C\/li\u003E\u003Cli\u003EProvide liaison between various arts and culture activities;\u003C\/li\u003E\u003Cli\u003EProvide a means for coordination for arts and culture groups or facilities which may exist within the community;\u003C\/li\u003E\u003Cli\u003EMaintain an inventory of facilities available for related arts and culture activities within the community;\u003C\/li\u003E\u003Cli\u003EProvide screening and\/or review for arts and culture activities wishing to obtain city funds or utilize public facilities;\u003C\/li\u003E\u003Cli\u003EProvide information to the community relating to the arts;\u003C\/li\u003E\u003Cli\u003EFoster the development of public art within the community;\u003C\/li\u003E\u003Cli\u003EBe vigilant in exploring and advancing the range of arts and culture activities available to the community;\u003C\/li\u003E\u003Cli\u003EEnhance the interaction between arts and business;\u003C\/li\u003E\u003Cli\u003EAny other activity which may be deemed appropriate and necessary.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 22-2241, \u00a7 5, 2022; Ord. 1401, (part), 1987)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"3c1deb45-bdfe-46bb-9767-8888bb37a7d0","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/beb778e4-5d0e-4769-ba3d-92f555265650","ref":{"parent":"eb6ec29b-3097-4bc0-90d5-da3f92d8e065","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-223-210","docId":"75","text":"2.80.090 Compensation\u2013Expenses.","id":"beb778e4-5d0e-4769-ba3d-92f555265650","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/beb778e4-5d0e-4769-ba3d-92f555265650\/563c498f-f47d-4ab5-990f-6242263b20ce","ref":{"parent":"beb778e4-5d0e-4769-ba3d-92f555265650","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-223-210-11","docId":"75","text":"\u003Cp\u003EMembers of the Fine Arts Commission shall serve without compensation. Commissioners may be reimbursed for necessary expenses reasonably incurred by them while acting in their official capacity subject to the approval of the City Manager.\u003C\/p\u003E\u003Cp\u003E(Ord. 21-2234, Att. A (\u00a7 2, part), 2021; Ord. 1401, (part), 1987)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"563c498f-f47d-4ab5-990f-6242263b20ce","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/0a37193d-02e0-4278-a50f-41a6aa8bcd0f","ref":{"parent":"eb6ec29b-3097-4bc0-90d5-da3f92d8e065","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-223-211","docId":"75","text":"2.80.100 Effect.","id":"0a37193d-02e0-4278-a50f-41a6aa8bcd0f","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/eb6ec29b-3097-4bc0-90d5-da3f92d8e065\/0a37193d-02e0-4278-a50f-41a6aa8bcd0f\/721f9c35-6d8c-41fc-9ca8-68a0e89a8d69","ref":{"parent":"0a37193d-02e0-4278-a50f-41a6aa8bcd0f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-223-211-11","docId":"75","text":"\u003Cp\u003ENothing in this chapter shall be construed as restricting or curtailing any powers of the City Council or City officers.\u003C\/p\u003E\u003Cp\u003E(Ord. 1401, (part), 1987)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"721f9c35-6d8c-41fc-9ca8-68a0e89a8d69","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f31f76f4-7562-4b1c-a902-b751e5ed89b2","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h3"},"pos":"13-224","docId":"75","text":"CHAPTER 2.84: RESERVED","id":"f31f76f4-7562-4b1c-a902-b751e5ed89b2","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/f31f76f4-7562-4b1c-a902-b751e5ed89b2\/7bb69295-549b-43e1-bd15-00a443249197","ref":{"parent":"f31f76f4-7562-4b1c-a902-b751e5ed89b2","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-224-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"7bb69295-549b-43e1-bd15-00a443249197","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-225","docId":"75","text":"CHAPTER 2.86: HOUSING COMMISSION*","id":"e6750b5a-e006-4e17-909c-010a6deb8fa2","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/a036cc46-f602-4eda-bcd5-2115c23b7d94","ref":{"parent":"e6750b5a-e006-4e17-909c-010a6deb8fa2","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-225-11","docId":"75","text":"\u003Cp\u003E* Editor\u2019s note: The title of this chapter was amended from Housing Committee by Ord. 1892, and from Affordable Housing Committee by Ord. 1722.\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"a036cc46-f602-4eda-bcd5-2115c23b7d94","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/a1230e39-2921-40af-8d9c-dc70315e0339","ref":{"parent":"e6750b5a-e006-4e17-909c-010a6deb8fa2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-225-12","docId":"75","text":"2.86.010 Established\u2013Composition.","id":"a1230e39-2921-40af-8d9c-dc70315e0339","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/a1230e39-2921-40af-8d9c-dc70315e0339\/ac77366a-a494-411d-9acb-1d04f298d67b","ref":{"parent":"a1230e39-2921-40af-8d9c-dc70315e0339","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-225-12-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe Housing Commission of the City is established. The Housing Commission shall consist of five members as follows:\u003Col\u003E\u003Cli\u003ERepresentative from a Cupertino business,\u003C\/li\u003E\u003Cli\u003EFour community members,\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EThe representatives from a Cupertino business and the community members shall not be officials or employees of the City, nor cohabit with, as defined by law, nor be related by blood or marriage, to any member of the Commission, the City Manager or the staff person(s) assigned to this Commission. All members except the Cupertino business representative shall be City of Cupertino residents. Members of the Housing Commission shall be appointed by the City Council.\u003C\/li\u003E\u003Cli\u003EThe Director of Community Development or their designee shall provide technical assistance to the Commission\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 2185, (part), 2019; Ord. 2062, (part), 2010; Ord. 1892, (part), 2002; Ord. 1722, (part), 1996; Ord. 1641, \u00a7 1 (part), 1994; Ord. 1576, \u00a7 1 (part), 1992; Ord. 24-2267, Att. A (part), 2024)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"ac77366a-a494-411d-9acb-1d04f298d67b","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/65ead0fd-893e-4c01-bef3-08baef8883b7","ref":{"parent":"e6750b5a-e006-4e17-909c-010a6deb8fa2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-225-13","docId":"75","text":"2.86.020 Members\u2013Residency\u2013Selection.","id":"65ead0fd-893e-4c01-bef3-08baef8883b7","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/65ead0fd-893e-4c01-bef3-08baef8883b7\/6e2ab059-ce98-471a-ba9f-169dac67893a","ref":{"parent":"65ead0fd-893e-4c01-bef3-08baef8883b7","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-225-13-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe Housing Commission members must be residents of Cupertino.\u003C\/li\u003E\u003Cli\u003EIn selection of commissioners, the City Council may give priority to:\u003Col\u003E\u003Cli\u003EApplicants who represent the Community Development Block Grant (CDBG) target areas as described in the city\u0027s Consolidated Plan.\u003C\/li\u003E\u003Cli\u003EApplicants who are familiar with the operation of affordable housing;\u003C\/li\u003E\u003Cli\u003EApplicants who represent non-profit community organizations; and\u003C\/li\u003E\u003Cli\u003EApplicants who are knowledgeable about the housing needs of groups targeted for affordable housing development which include, but are not limited to, the following:\u003Col\u003E\u003Cli\u003ESeniors,\u003C\/li\u003E\u003Cli\u003ESingle parent families,\u003C\/li\u003E\u003Cli\u003EHomeless persons,\u003C\/li\u003E\u003Cli\u003EFamilies of low income,\u003C\/li\u003E\u003Cli\u003EDisabled persons,\u003C\/li\u003E\u003Cli\u003ERenters,\u003C\/li\u003E\u003Cli\u003EFirst time homebuyers.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 2185, (part), 2019; Ord. 2062, (part), 2010; Ord. 1892, (part), 2002; Ord. 1722, (part), 1996; Ord. 1641, \u00a7 1 (part), 1994; Ord. 1576, \u00a7 1 (part), 1992; Ord. 24-2256, Att. B \u00a7 2, 2024)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"6e2ab059-ce98-471a-ba9f-169dac67893a","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/6284ee3b-1df3-4aca-b456-c453c2164860","ref":{"parent":"e6750b5a-e006-4e17-909c-010a6deb8fa2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-225-14","docId":"75","text":"2.86.030 Terms of Office.","id":"6284ee3b-1df3-4aca-b456-c453c2164860","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/6284ee3b-1df3-4aca-b456-c453c2164860\/0deabba8-be69-4484-be33-cd20db0b88de","ref":{"parent":"6284ee3b-1df3-4aca-b456-c453c2164860","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-225-14-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EHousing commissioners serve at the pleasure of the City Council. The term of office of the members of the Housing Commission shall be for four years commencing on the date of their respective appointments to the Housing Commission or its predecessor Commission and shall end on January 30th of the year their terms are due to expire. No member shall serve more than two consecutive terms except that a member may serve more than two consecutive terms if he or she has been appointed to the Commission to fill an unexpired term of less than two years.\u003C\/li\u003E\u003Cli\u003EThe appointment, reappointment and rules governing incumbent members of the Commission are governed by the Resolution of the Cupertino City Council which governs advisory bodies.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 9 (part), 2018; Ord. 2062, (part), 2010; Ord. 1974, \u00a7 3, 2006; Ord. 1892, (part), 2002; Ord. 1722, (part), 1996; Ord. 1641, \u00a7 1 (part), 1994; Ord. 1576, \u00a7 1 (part), 1992)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0deabba8-be69-4484-be33-cd20db0b88de","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/b00d920b-b849-4dcc-96dd-7f4d4da4ba24","ref":{"parent":"e6750b5a-e006-4e17-909c-010a6deb8fa2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-225-15","docId":"75","text":"2.86.040 Members\u2013Vacancy Prior to Expiration of a Term.","id":"b00d920b-b849-4dcc-96dd-7f4d4da4ba24","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/b00d920b-b849-4dcc-96dd-7f4d4da4ba24\/ad35d900-504f-4d2a-8e89-77b7e53e7efa","ref":{"parent":"b00d920b-b849-4dcc-96dd-7f4d4da4ba24","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-225-15-11","docId":"75","text":"\u003Cp\u003EIf a vacancy occurs other than by expiration of a term, it shall be filled by the City Council\u2019s appointment for the unexpired portion of the term.\u003C\/p\u003E\u003Cp\u003E(Ord. 2062, (part), 2010; Ord. 1892, (part), 2002; Ord. 1641, \u00a7 1 (part), 1994; Ord. 1576, \u00a7 1 (part), 1992)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"ad35d900-504f-4d2a-8e89-77b7e53e7efa","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/62160c59-b59a-41dd-8fa7-21a551a87d8c","ref":{"parent":"e6750b5a-e006-4e17-909c-010a6deb8fa2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-225-16","docId":"75","text":"2.86.050 Chairperson.","id":"62160c59-b59a-41dd-8fa7-21a551a87d8c","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/62160c59-b59a-41dd-8fa7-21a551a87d8c\/d5ececcd-7c72-4d1c-9c0e-e96a4e83c657","ref":{"parent":"62160c59-b59a-41dd-8fa7-21a551a87d8c","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-225-16-11","docId":"75","text":"\u003Cp\u003EThe Chairperson and Vice Chairperson shall be elected from among Commission members. Terms shall be for one year.\u003C\/p\u003E\u003Cp\u003E(Ord. 2062, (part), 2010; Ord. 2015, \u00a7 4, 2008; Ord. 1892, (part), 2002; Ord. 1641, \u00a7 1 (part), 1994; Ord. 1576, \u00a7 1 (part), 1992)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d5ececcd-7c72-4d1c-9c0e-e96a4e83c657","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/c2199d8d-9770-4317-a3e5-de1371b8b88e","ref":{"parent":"e6750b5a-e006-4e17-909c-010a6deb8fa2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-225-17","docId":"75","text":"2.86.060 Meetings.","id":"c2199d8d-9770-4317-a3e5-de1371b8b88e","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/c2199d8d-9770-4317-a3e5-de1371b8b88e\/ae6d2e24-bad4-4746-ba91-9b13bf1e3ba9","ref":{"parent":"c2199d8d-9770-4317-a3e5-de1371b8b88e","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-225-17-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe Housing Commission shall establish a regular time and place of meeting and rules of conduct thereof and shall hold at least one regular meeting each quarter.\u003C\/li\u003E\u003Cli\u003EA majority of the Housing Commission shall constitute a quorum for the purpose of transacting the business of the Commission.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 2062, (part), 2010; Ord. 1892, (part), 2002; Ord. 1722, (part), 1996; Ord. 1697, (part), 1995; Ord. 1641, \u00a7 1 (part), 1994; Ord. 1576, \u00a7 1 (part), 1992)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"ae6d2e24-bad4-4746-ba91-9b13bf1e3ba9","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/0ae6a5b7-b199-41fc-8aa6-6820490e4f08","ref":{"parent":"e6750b5a-e006-4e17-909c-010a6deb8fa2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-225-18","docId":"75","text":"2.86.070 Compensation\u2013Expenses.","id":"0ae6a5b7-b199-41fc-8aa6-6820490e4f08","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/0ae6a5b7-b199-41fc-8aa6-6820490e4f08\/606397ca-fe8e-42c5-943c-1c4ef9e524ca","ref":{"parent":"0ae6a5b7-b199-41fc-8aa6-6820490e4f08","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-225-18-11","docId":"75","text":"\u003Cp\u003EMembers of the Housing Commission shall serve without compensation. Commissioners may be reimbursed for necessary expenses reasonably incurred by them while acting in their official capacity subject to the approval of the City Manager.\u003C\/p\u003E\u003Cp\u003E(Ord. 21-2234, Att. A (\u00a7 2, part), 2021; Ord. 2062, (part), 2010; Ord. 1892, (part), 2002; Ord. 1722, (part), 1996; Ord. 1697, (part), 1995; Ord. 1641, \u00a7 1 (part), 1994; Ord. 1576, \u00a7 1 (part), 1992)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"606397ca-fe8e-42c5-943c-1c4ef9e524ca","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/f547ed27-a151-4886-ab49-15bb97b05a8d","ref":{"parent":"e6750b5a-e006-4e17-909c-010a6deb8fa2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-225-19","docId":"75","text":"2.86.080 Majority Vote Required.","id":"f547ed27-a151-4886-ab49-15bb97b05a8d","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/f547ed27-a151-4886-ab49-15bb97b05a8d\/c7243c2d-128b-469e-bd5d-d5eb070b867f","ref":{"parent":"f547ed27-a151-4886-ab49-15bb97b05a8d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-225-19-11","docId":"75","text":"\u003Cp\u003EA majority vote of the quorum is required to approve a recommendation on any matter that is presented to the Commission which requires a vote.\u003C\/p\u003E\u003Cp\u003E(Ord. 2062, (part), 2010; Ord. 1892, (part), 2002; Ord. 1641, \u00a7 1 (part), 1994; Ord. 1576, \u00a7 1 (part), 1992)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"c7243c2d-128b-469e-bd5d-d5eb070b867f","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/91810847-8b86-48a9-b4a8-42b8f8f03838","ref":{"parent":"e6750b5a-e006-4e17-909c-010a6deb8fa2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-225-210","docId":"75","text":"2.86.090 Records.","id":"91810847-8b86-48a9-b4a8-42b8f8f03838","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/91810847-8b86-48a9-b4a8-42b8f8f03838\/b821e699-41df-445b-8eaf-99642f3c82d1","ref":{"parent":"91810847-8b86-48a9-b4a8-42b8f8f03838","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-225-210-11","docId":"75","text":"\u003Cp\u003EThe Commission shall keep an accurate record of its proceedings and transactions and shall render such reports to the City Council and Planning Commission as may be required. These records shall be filed with the City Clerk.\u003C\/p\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 9 (part), 2018; Ord. 2062, (part), 2010; Ord. 1892, (part), 2002; Ord. 1641, \u00a7 1 (part), 1994; Ord. 1576, \u00a7 1 (part), 1992)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"b821e699-41df-445b-8eaf-99642f3c82d1","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/59f082ba-9fad-49d1-bd78-15940c240cff","ref":{"parent":"e6750b5a-e006-4e17-909c-010a6deb8fa2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-225-211","docId":"75","text":"2.86.100 Duties\u2013Powers\u2013Responsibilities.","id":"59f082ba-9fad-49d1-bd78-15940c240cff","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/59f082ba-9fad-49d1-bd78-15940c240cff\/e6cc2968-13ba-4027-987c-dc2739ed932a","ref":{"parent":"59f082ba-9fad-49d1-bd78-15940c240cff","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-225-211-11","docId":"75","text":"\u003Cp\u003EThe powers and functions of the Housing Commission shall be as follows:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ETo assist the Planning Commission and the City Council in developing housing policies and strategies for implementation of general plan housing element goals;\u003C\/li\u003E\u003Cli\u003ETo recommend policies for implementation and monitoring of affordable housing projects;\u003C\/li\u003E\u003Cli\u003ETo facilitate innovative approaches to affordable housing development and to generate ideas and interest in pursuing a variety of housing options;\u003C\/li\u003E\u003Cli\u003EWhen requested by the Director of Community Development or the City Council, to make recommendations to the Planning Commission and the City Council regarding affordable housing proposals in connection with applications for development including, but not limited to, recommendations for possible fee waivers, other incentives, the number and type of affordable units and the target groups to be served. Any referral to the Housing Commission shall be limited to consideration of affordable housing proposals which exceed normal housing requirements under the applicable provisions of the City\u2019s general plan or ordinances related thereto;\u003C\/li\u003E\u003Cli\u003ETo make recommendations regarding requests for money from the CDBG and Affordable Housing Funds;\u003C\/li\u003E\u003Cli\u003ETo provide information about affordable housing;\u003C\/li\u003E\u003Cli\u003ETo meet with neighborhood, community, regional and business groups as necessary to receive input and assist in generating affordable housing;\u003C\/li\u003E\u003Cli\u003ETo help identify sources of funds to develop and build affordable housing;\u003C\/li\u003E\u003Cli\u003ETo perform any other advisory functions authorized by the City Council.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 2062, (part), 2010; Ord. 1892, (part), 2002; Ord. 1722, (part), 1996; Ord. 1641, \u00a7 1 (part), 1994; Ord. 1576, \u00a7 1 (part), 1992)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"e6cc2968-13ba-4027-987c-dc2739ed932a","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/8bd75887-6eb3-40ea-92c5-ee89bafcecca","ref":{"parent":"e6750b5a-e006-4e17-909c-010a6deb8fa2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-225-212","docId":"75","text":"2.86.110 City Staff Assistance.","id":"8bd75887-6eb3-40ea-92c5-ee89bafcecca","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/8bd75887-6eb3-40ea-92c5-ee89bafcecca\/8021ae25-e506-4dc4-bcf2-f5333dede0fb","ref":{"parent":"8bd75887-6eb3-40ea-92c5-ee89bafcecca","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-225-212-11","docId":"75","text":"\u003Cp\u003EThe Housing Commission shall have available to it such assistance of City staff as may be required to perform its functions, the staff assignments and administrative procedures to be under the general direction and supervision of the Director of Community Development.\u003C\/p\u003E\u003Cp\u003E(Ord. 2062, (part), 2010; Ord. 1892, (part), 2002; Ord. 1722, (part), 1996; Ord. 1641, \u00a7 1 (part), 1994; Ord. 1576, \u00a7 1 (part), 1992)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"8021ae25-e506-4dc4-bcf2-f5333dede0fb","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/84ba5314-8a64-435d-8dae-587c3bc9359b","ref":{"parent":"e6750b5a-e006-4e17-909c-010a6deb8fa2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-225-213","docId":"75","text":"2.86.120 Procedural Rules.","id":"84ba5314-8a64-435d-8dae-587c3bc9359b","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/84ba5314-8a64-435d-8dae-587c3bc9359b\/0c4c9763-7141-4197-80e6-5adf14b94eac","ref":{"parent":"84ba5314-8a64-435d-8dae-587c3bc9359b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-225-213-11","docId":"75","text":"\u003Cp\u003EThe Housing Commission may adopt from time to time such rules of procedure as it may deem necessary to properly exercise its powers and duties. Such rules shall be kept on file with the chairperson of the Housing Commission, the Mayor, and the City Clerk, and a copy thereof shall be furnished to any person upon request.\u003C\/p\u003E\u003Cp\u003E(Ord. 2062, (part), 2010; Ord. 1892, (part), 2002; Ord. 1722, (part), 1996; Ord. 1641, \u00a7 1 (part), 1994; Ord. 1576, \u00a7 1 (part), 1992)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0c4c9763-7141-4197-80e6-5adf14b94eac","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/eb022d8c-6acf-479b-9a55-bb90b91ac66e","ref":{"parent":"e6750b5a-e006-4e17-909c-010a6deb8fa2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-225-214","docId":"75","text":"2.86.130 Effect.","id":"eb022d8c-6acf-479b-9a55-bb90b91ac66e","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/e6750b5a-e006-4e17-909c-010a6deb8fa2\/eb022d8c-6acf-479b-9a55-bb90b91ac66e\/30a2dc51-e162-4576-9b30-4b8416f64d4b","ref":{"parent":"eb022d8c-6acf-479b-9a55-bb90b91ac66e","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-225-214-11","docId":"75","text":"\u003Cp\u003ENothing in this chapter shall be construed as restricting or curtailing any powers of the City Council, Planning Commission or City officers.\u003C\/p\u003E\u003Cp\u003E(Ord. 2062, (part), 2010; Ord. 1892, (part), 2002; Ord. 1641, \u00a7 1 (part), 1994; Ord. 1576, \u00a7 1 (part), 1992)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"30a2dc51-e162-4576-9b30-4b8416f64d4b","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-226","docId":"75","text":"CHAPTER 2.88: AUDIT AND FINANCE COMMITTEE","id":"889a3b5d-8d42-4f12-8e5b-846bd0580364","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/86e27ab0-9076-4501-b786-b9cfb99e82ef","ref":{"parent":"889a3b5d-8d42-4f12-8e5b-846bd0580364","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-226-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"86e27ab0-9076-4501-b786-b9cfb99e82ef","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/5a73977c-fd5b-43d8-97b1-26a61851d363","ref":{"parent":"889a3b5d-8d42-4f12-8e5b-846bd0580364","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-226-12","docId":"75","text":"2.88.010 Established\u2013Composition.","id":"5a73977c-fd5b-43d8-97b1-26a61851d363","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/5a73977c-fd5b-43d8-97b1-26a61851d363\/25a58031-cf6e-4c60-83a0-7c898197b131","ref":{"parent":"5a73977c-fd5b-43d8-97b1-26a61851d363","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-226-12-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe Audit and Finance Committee of the City is established. The Audit and Finance Committee shall consist of five members as follows:\u003Col\u003E\u003Cli\u003ETwo City Council members;\u003C\/li\u003E\u003Cli\u003EA minimum of Two and a maximum of three at large members who are not officials or employees of the City nor cohabit with, as defined by law, nor be related by blood or marriage to, any member of the committee, the City Manager or the staff person or persons assigned to the committee.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1913, (part), 2003; Ord. 1874, \u00a7 1 (part), 2001; Ord. 1679, \u00a7 1 (part), 1995; Ord. 26-2285, Att. A, 2026)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"25a58031-cf6e-4c60-83a0-7c898197b131","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/e6b2adb2-7198-4422-b281-97c14630770a","ref":{"parent":"889a3b5d-8d42-4f12-8e5b-846bd0580364","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-226-13","docId":"75","text":"2.88.020 At Large Member\u2013Qualifications.","id":"e6b2adb2-7198-4422-b281-97c14630770a","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/e6b2adb2-7198-4422-b281-97c14630770a\/8d2251bd-59ee-4390-b46a-117edbca39c7","ref":{"parent":"e6b2adb2-7198-4422-b281-97c14630770a","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-226-13-11","docId":"75","text":"\u003Cp\u003EAn Audit and Finance Committee at large member is not required to be a Cupertino resident. In selecting an at large member, the City Council shall give priority to individuals who have substantial accounting, audit, or investment experience, preferably in connection with a governmental agency.\u003C\/p\u003E\u003Cp\u003E(Ord. 1913, (part), 2003; Ord. 1874, \u00a7 1 (part), 2001; Ord. 1679, \u00a7 1 (part), 1995; Ord. 26-2285, Att. A, 2026)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"8d2251bd-59ee-4390-b46a-117edbca39c7","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/7c5c927f-325d-4594-83b8-e5b43db0d837","ref":{"parent":"889a3b5d-8d42-4f12-8e5b-846bd0580364","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-226-14","docId":"75","text":"2.88.030 Terms of Office.","id":"7c5c927f-325d-4594-83b8-e5b43db0d837","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/7c5c927f-325d-4594-83b8-e5b43db0d837\/eeb7e9aa-5c5e-48e1-babf-ed7ae893e2c3","ref":{"parent":"7c5c927f-325d-4594-83b8-e5b43db0d837","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-226-14-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EAudit and Finance Committee members serve at the pleasure of the City Council. The term of office of the members of the Audit and Finance Committee shall be for four years commencing on the date of their respective appointments to the Audit and Finance Committee and shall end on January 30th of the year the terms are due to expire. No Audit and Finance Committee member shall serve more than two consecutive terms unless he or she has been appointed to the committee to fill an unexpired term of less than two years.\u003C\/li\u003E\u003Cli\u003EThe appointment, reappointment and rules governing incumbent members of the Audit and Finance Committee are governed by the Resolution of the City Council which governs advisory bodies.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 10 (part), 2018; Ord. 1974, \u00a7 1, 2006; Ord. 1679, \u00a7 1 (part), 1995; Ord. 26-2285, Att. A, 2026)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"eeb7e9aa-5c5e-48e1-babf-ed7ae893e2c3","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/313e97ab-1dce-4630-9f54-78b431ca5083","ref":{"parent":"889a3b5d-8d42-4f12-8e5b-846bd0580364","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-226-15","docId":"75","text":"2.88.040 Members\u2013Vacancy Prior to Expiration of a Term.","id":"313e97ab-1dce-4630-9f54-78b431ca5083","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/313e97ab-1dce-4630-9f54-78b431ca5083\/5d8c61e0-fc32-4e3b-b91d-7758cc74add6","ref":{"parent":"313e97ab-1dce-4630-9f54-78b431ca5083","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-226-15-11","docId":"75","text":"\u003Cp\u003EIf a vacancy occurs other than by expiration of a term, it shall be filled by the City Council\u2019s appointment for the unexpired portion of the term.\u003C\/p\u003E\u003Cp\u003E(Ord. 1679, \u00a7 1 (part), 1995)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"5d8c61e0-fc32-4e3b-b91d-7758cc74add6","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/ad4e6563-03e5-4631-aa82-42663dac8547","ref":{"parent":"889a3b5d-8d42-4f12-8e5b-846bd0580364","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-226-16","docId":"75","text":"2.88.050 Chairperson.","id":"ad4e6563-03e5-4631-aa82-42663dac8547","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/ad4e6563-03e5-4631-aa82-42663dac8547\/178bd07e-1f8e-480b-8c77-9d7dd5fafd60","ref":{"parent":"ad4e6563-03e5-4631-aa82-42663dac8547","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-226-16-11","docId":"75","text":"\u003Cp\u003EThe committee shall elect its chairperson and vice chairperson from among its members and shall appoint a secretary. Terms of the chairperson and vice chairperson shall be for one year. Upon approval of the City Council, the City Manager may appoint a secretary who need not be a member of the committee.\u003C\/p\u003E\u003Cp\u003E(Ord. 2015, \u00a7 1, 2008; Ord. 1679, \u00a7 1 (part), 1995)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"178bd07e-1f8e-480b-8c77-9d7dd5fafd60","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/178923fe-1cb1-4e8f-899f-fbe67032d326","ref":{"parent":"889a3b5d-8d42-4f12-8e5b-846bd0580364","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-226-17","docId":"75","text":"2.88.060 Meetings.","id":"178923fe-1cb1-4e8f-899f-fbe67032d326","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/178923fe-1cb1-4e8f-899f-fbe67032d326\/7bb32896-f400-4a65-89e5-97f794ee389b","ref":{"parent":"178923fe-1cb1-4e8f-899f-fbe67032d326","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-226-17-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe Audit and Finance Committee shall establish a regular time and place of meeting and rules of conduct thereof and shall hold at least one regular meeting quarterly.\u003C\/li\u003E\u003Cli\u003EA majority of the Audit and Finance Committee shall constitute a quorum for the purpose of transacting the business of the committee.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1679, \u00a7 1 (part), 1995; Ord. 26-2285, Att. A, 2026)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"7bb32896-f400-4a65-89e5-97f794ee389b","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/4eedf44e-1a2c-4104-bbe9-280cda94255b","ref":{"parent":"889a3b5d-8d42-4f12-8e5b-846bd0580364","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-226-18","docId":"75","text":"2.88.070 Compensation\u2013Expenses.","id":"4eedf44e-1a2c-4104-bbe9-280cda94255b","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/4eedf44e-1a2c-4104-bbe9-280cda94255b\/3a7ea160-03a0-4f8c-aab8-b3e2f40fbe7f","ref":{"parent":"4eedf44e-1a2c-4104-bbe9-280cda94255b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-226-18-11","docId":"75","text":"\u003Cp\u003EMembers shall serve on the Audit and Finance Committee without compensation, but all necessary expenses reasonably incurred by them while acting in their official capacity shall be paid by appropriate action of the City Council.\u003C\/p\u003E\u003Cp\u003E(Ord. 1679, \u00a7 1 (part), 1995; Ord. 26-2285, Att. A, 2026)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"3a7ea160-03a0-4f8c-aab8-b3e2f40fbe7f","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/26db636b-6e68-49c8-8833-e89b52ef6e74","ref":{"parent":"889a3b5d-8d42-4f12-8e5b-846bd0580364","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-226-19","docId":"75","text":"2.88.080 Majority Vote Required.","id":"26db636b-6e68-49c8-8833-e89b52ef6e74","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/26db636b-6e68-49c8-8833-e89b52ef6e74\/b5eae5fe-9da0-4d05-91e3-ae4e3b36c437","ref":{"parent":"26db636b-6e68-49c8-8833-e89b52ef6e74","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-226-19-11","docId":"75","text":"\u003Cp\u003EA majority vote of the quorum is required to approve a recommendation on any matter that is presented to the committee which requires a vote.\u003C\/p\u003E\u003Cp\u003E(Ord. 1679, \u00a7 1 (part), 1995)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"b5eae5fe-9da0-4d05-91e3-ae4e3b36c437","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/29fb478d-b851-493b-8232-33a9a7413214","ref":{"parent":"889a3b5d-8d42-4f12-8e5b-846bd0580364","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-226-210","docId":"75","text":"2.88.090 Records.","id":"29fb478d-b851-493b-8232-33a9a7413214","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/29fb478d-b851-493b-8232-33a9a7413214\/db3e2ab8-b559-4bec-8a16-32a39d5d2051","ref":{"parent":"29fb478d-b851-493b-8232-33a9a7413214","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-226-210-11","docId":"75","text":"\u003Cp\u003EThe committee shall keep an accurate record of its proceedings and transactions and shall render such reports to the City Council and Planning Commission as may be required. These records shall be filed with the City Clerk.\u003C\/p\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 10 (part), 2018; Ord. 1679, \u00a7 1 (part), 1995)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"db3e2ab8-b559-4bec-8a16-32a39d5d2051","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/84c995ea-c21d-44c3-9935-64bebf2754bf","ref":{"parent":"889a3b5d-8d42-4f12-8e5b-846bd0580364","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-226-211","docId":"75","text":"2.88.100 Duties\u2013Powers\u2013Responsibilities.","id":"84c995ea-c21d-44c3-9935-64bebf2754bf","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/84c995ea-c21d-44c3-9935-64bebf2754bf\/2eefcda5-cb34-4514-98a5-62f014f94be2","ref":{"parent":"84c995ea-c21d-44c3-9935-64bebf2754bf","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-226-211-11","docId":"75","text":"\u003Cp\u003EThe powers and functions of the Audit and Finance Committee shall be as follows:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ETo review the annual audit report and management letter;\u003C\/li\u003E\u003Cli\u003ETo recommend appointment of auditors;\u003C\/li\u003E\u003Cli\u003ETo review the Quarterly Treasurer\u2019s investment report;\u003C\/li\u003E\u003Cli\u003ETo recommend a budget format;\u003C\/li\u003E\u003Cli\u003ETo review City investment policies and internal controls of such policies;\u003C\/li\u003E\u003Cli\u003ETo recommend appointment of internal auditors;\u003C\/li\u003E\u003Cli\u003ETo review the City\u2019s internal controls and internal audit reports;\u003C\/li\u003E\u003Cli\u003ETo review quarterly Fraud, Waste, and Abuse Program reports;\u003C\/li\u003E\u003Cli\u003ETo review the use of emerging technologies such as artificial intelligence in the City\u2019s financial reporting, internal controls over financial reporting, risk management, and compliance.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 23-2247, \u00a7 1 (part), 2023; Ord. 22-2243, \u00a7 1, 2022; Ord. 20- 2208, \u00a7 1, 2020; Ord. 1679, \u00a7 1 (part), 1995; Ord. 26-2285, Att. A, 2026)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"2eefcda5-cb34-4514-98a5-62f014f94be2","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/a703ef32-e594-4c5d-84bd-9c2fafff68f3","ref":{"parent":"889a3b5d-8d42-4f12-8e5b-846bd0580364","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-226-212","docId":"75","text":"2.88.110 City Staff Assistance.","id":"a703ef32-e594-4c5d-84bd-9c2fafff68f3","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/a703ef32-e594-4c5d-84bd-9c2fafff68f3\/4eb9aa9d-22b4-4283-8b53-229ad64cbffc","ref":{"parent":"a703ef32-e594-4c5d-84bd-9c2fafff68f3","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-226-212-11","docId":"75","text":"\u003Cp\u003EThe Audit and Finance Committee shall have available to it such assistance of City staff as may be required to perform its functions, the staff assignments and administrative procedures to be under the general direction and supervision of the Director of Finance.\u003C\/p\u003E\u003Cp\u003E(Ord. 1679, \u00a7 1 (part), 1995; Ord. 26-2283, Att. A \u00a7 5, 2026; Ord. 26-2285, Att. A, 2026)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"4eb9aa9d-22b4-4283-8b53-229ad64cbffc","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/9c0203a2-e2d5-4362-a76c-574eadab4b84","ref":{"parent":"889a3b5d-8d42-4f12-8e5b-846bd0580364","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-226-213","docId":"75","text":"2.88.120 Procedural Rules.","id":"9c0203a2-e2d5-4362-a76c-574eadab4b84","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/9c0203a2-e2d5-4362-a76c-574eadab4b84\/9e3460fc-0b06-4953-b725-987d515de41b","ref":{"parent":"9c0203a2-e2d5-4362-a76c-574eadab4b84","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-226-213-11","docId":"75","text":"\u003Cp\u003EThe Audit and Finance Committee may adopt from time to time such rules of procedure as it may deem necessary to properly exercise its powers and duties. Such rules shall be subject to approval by the Council before becoming effective. All such rules shall be kept on file with the chairperson of the Audit and Finance Committee, the Mayor, and the City Clerk and a copy thereof shall be furnished to any person upon request.\u003C\/p\u003E\u003Cp\u003E(Ord. 1679, \u00a7 1 (part), 1995; Ord. 26-2285, Att. A, 2026)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"9e3460fc-0b06-4953-b725-987d515de41b","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/5c948d8c-6c0a-4da3-af98-348196fa7fd5","ref":{"parent":"889a3b5d-8d42-4f12-8e5b-846bd0580364","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-226-214","docId":"75","text":"2.88.130 Effect.","id":"5c948d8c-6c0a-4da3-af98-348196fa7fd5","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/889a3b5d-8d42-4f12-8e5b-846bd0580364\/5c948d8c-6c0a-4da3-af98-348196fa7fd5\/fa7d25c8-9f19-4874-880a-0893301abb2f","ref":{"parent":"5c948d8c-6c0a-4da3-af98-348196fa7fd5","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-226-214-11","docId":"75","text":"\u003Cp\u003ENothing in this chapter shall be construed as restricting or curtailing any powers of the City Council or City officers.\u003C\/p\u003E\u003Cp\u003E(Ord. 1679, \u00a7 1 (part), 1995)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"fa7d25c8-9f19-4874-880a-0893301abb2f","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/57289056-b8e4-4297-9914-70b64cad74d4","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h3"},"pos":"13-227","docId":"75","text":"CHAPTER 2.90: RESERVED","id":"57289056-b8e4-4297-9914-70b64cad74d4","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/57289056-b8e4-4297-9914-70b64cad74d4\/b8dabbca-ad1b-4095-9c0d-e2b32effdd07","ref":{"parent":"57289056-b8e4-4297-9914-70b64cad74d4","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-227-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"b8dabbca-ad1b-4095-9c0d-e2b32effdd07","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-228","docId":"75","text":"CHAPTER 2.92: BICYCLE PEDESTRIAN COMMISSION","id":"96b1dafc-7e28-495a-9aae-4cc0a399432f","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/78fbfaca-8126-4117-9d51-578a8cb0bb84","ref":{"parent":"96b1dafc-7e28-495a-9aae-4cc0a399432f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-228-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"78fbfaca-8126-4117-9d51-578a8cb0bb84","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/8192deda-7a23-40ee-828a-5456a0d7d593","ref":{"parent":"96b1dafc-7e28-495a-9aae-4cc0a399432f","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-228-12","docId":"75","text":"2.92.010 Established\u2013Composition.","id":"8192deda-7a23-40ee-828a-5456a0d7d593","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/8192deda-7a23-40ee-828a-5456a0d7d593\/2554c502-3461-4e2d-a369-2c4d6d48eff9","ref":{"parent":"8192deda-7a23-40ee-828a-5456a0d7d593","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-228-12-11","docId":"75","text":"\u003Cp\u003EThe Bicycle Pedestrian Commission of the City is established. The Bicycle Pedestrian Commission shall consist of five members, none of whom shall be officials or employees of the City, nor cohabit with as defined by law, nor be related by blood or marriage to any member of the Commission, the City Manager or any staff person(s) who may be assigned by the City Manager to assist this Commission. All members shall be City of Cupertino residents. Members of the Bicycle Pedestrian Commission shall be appointed by the City Council. (Ord. 1895, (part), 2002)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"2554c502-3461-4e2d-a369-2c4d6d48eff9","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/562e438a-d21e-449a-aeeb-64e570d1db69","ref":{"parent":"96b1dafc-7e28-495a-9aae-4cc0a399432f","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-228-13","docId":"75","text":"2.92.020 Terms of Office.","id":"562e438a-d21e-449a-aeeb-64e570d1db69","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/562e438a-d21e-449a-aeeb-64e570d1db69\/5884008c-74ab-4d09-98a2-90fbeb755f34","ref":{"parent":"562e438a-d21e-449a-aeeb-64e570d1db69","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-228-13-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ECommissioners serve at the pleasure of the City Council. The term of office of the members of the Bicycle Pedestrian Commission shall be for four years and shall end on January 30th of the year their term is due to expire. No commissioner shall serve more than two consecutive terms, except that a commissioner may serve more than two consecutive terms if he or she has been appointed to the Commission to fill an unexpired term of less than two years.\u003C\/li\u003E\u003Cli\u003EThe appointment, reappointment and rules governing incumbent members of the Commission are governed by the Resolution of the Cupertino City Council which governs advisory bodies.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 12 (part), 2018; Ord. 2015, \u00a7 2, 2008; Ord. 1895, (part), 2002)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"5884008c-74ab-4d09-98a2-90fbeb755f34","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/96659a96-2032-4d55-b2e9-fd38309f42aa","ref":{"parent":"96b1dafc-7e28-495a-9aae-4cc0a399432f","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-228-14","docId":"75","text":"2.92.030 Members\u2013Vacancy and Removal.","id":"96659a96-2032-4d55-b2e9-fd38309f42aa","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/96659a96-2032-4d55-b2e9-fd38309f42aa\/ed720d56-41ff-401c-82de-a93976ef2ac9","ref":{"parent":"96659a96-2032-4d55-b2e9-fd38309f42aa","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-228-14-11","docId":"75","text":"\u003Cp\u003EAny appointee member may be removed by a majority vote of the City Council. If a vacancy occurs other than by expiration of a term, it shall be filled by the City Council\u2019s appointment for the unexpired portion of the term.\u003C\/p\u003E\u003Cp\u003E(Ord. 1895, (part), 2002)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"ed720d56-41ff-401c-82de-a93976ef2ac9","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/3004233a-7363-4d71-806c-782a5cdcdfcd","ref":{"parent":"96b1dafc-7e28-495a-9aae-4cc0a399432f","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-228-15","docId":"75","text":"2.92.040 Chairperson.","id":"3004233a-7363-4d71-806c-782a5cdcdfcd","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/3004233a-7363-4d71-806c-782a5cdcdfcd\/dc59cb77-0825-4d5f-b9bd-91500940d504","ref":{"parent":"3004233a-7363-4d71-806c-782a5cdcdfcd","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-228-15-11","docId":"75","text":"\u003Cp\u003EThe Commission shall elect its chairperson and vice-chairperson from among its members and shall appoint a secretary. Terms of the chair and vice-chair shall be for one year.\u003C\/p\u003E\u003Cp\u003E(Ord. 2015, \u00a7 2, 2008; Ord. 1895, (part), 2002)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"dc59cb77-0825-4d5f-b9bd-91500940d504","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/ba9ec149-c215-4bbb-b256-cac68956c0d9","ref":{"parent":"96b1dafc-7e28-495a-9aae-4cc0a399432f","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-228-16","docId":"75","text":"2.92.050 Meetings\u2013Quorum.","id":"ba9ec149-c215-4bbb-b256-cac68956c0d9","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/ba9ec149-c215-4bbb-b256-cac68956c0d9\/cdd7f213-8dd8-48f9-ab18-d1f5d8d61580","ref":{"parent":"ba9ec149-c215-4bbb-b256-cac68956c0d9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-228-16-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe Bicycle Pedestrian Commission shall establish a regular place of meeting and rules of conduct thereof and shall hold at least one regular meeting every other month, unless a regular meeting is cancelled by direction of the Commission chairperson.\u003C\/li\u003E\u003Cli\u003EA majority of the Bicycle Pedestrian Commission shall constitute a quorum for the purpose of transacting the business of the Commission.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1964, \u00a7 4, 2005; Ord. 1895, (part), 2002)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"cdd7f213-8dd8-48f9-ab18-d1f5d8d61580","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/237c1a67-7ddf-400b-b1e9-3bd0264aa273","ref":{"parent":"96b1dafc-7e28-495a-9aae-4cc0a399432f","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-228-17","docId":"75","text":"2.92.060 Majority Vote Required.","id":"237c1a67-7ddf-400b-b1e9-3bd0264aa273","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/237c1a67-7ddf-400b-b1e9-3bd0264aa273\/4882f7f2-f5a4-44e6-b5a3-aa6c2af3b69f","ref":{"parent":"237c1a67-7ddf-400b-b1e9-3bd0264aa273","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-228-17-11","docId":"75","text":"\u003Cp\u003EA majority vote is required to approve a recommendation on any matter that is presented to the Commission that requires a vote.\u003C\/p\u003E\u003Cp\u003E(Ord. 1895, (part), 2002)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"4882f7f2-f5a4-44e6-b5a3-aa6c2af3b69f","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/905e0dc8-db74-410a-ad47-ee42e666b91e","ref":{"parent":"96b1dafc-7e28-495a-9aae-4cc0a399432f","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-228-18","docId":"75","text":"2.92.070 Records.","id":"905e0dc8-db74-410a-ad47-ee42e666b91e","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/905e0dc8-db74-410a-ad47-ee42e666b91e\/76d3578d-04cc-440c-b291-290e78b82c77","ref":{"parent":"905e0dc8-db74-410a-ad47-ee42e666b91e","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-228-18-11","docId":"75","text":"\u003Cp\u003EThe Commission shall keep an accurate record of its proceedings and transactions and shall render such reports to the City Council as may be required. These records shall be filed with the City Clerk.\u003C\/p\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 12 (part), 2018; Ord. 1895, (part), 2002)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"76d3578d-04cc-440c-b291-290e78b82c77","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/c168c4fe-7339-4cfe-849e-6ea1ca8d3c9b","ref":{"parent":"96b1dafc-7e28-495a-9aae-4cc0a399432f","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-228-19","docId":"75","text":"2.92.080 Powers and Functions.","id":"c168c4fe-7339-4cfe-849e-6ea1ca8d3c9b","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/c168c4fe-7339-4cfe-849e-6ea1ca8d3c9b\/83aa9b5a-6446-4829-91b6-95686ea283c6","ref":{"parent":"c168c4fe-7339-4cfe-849e-6ea1ca8d3c9b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-228-19-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe powers and functions of the Bicycle Pedestrian Commission shall be to review, monitor and suggest recommendations for City transportation matters including, but not limited to, bicycle and pedestrian traffic, parking, education and recreation within Cupertino.\u003C\/li\u003E\u003Cli\u003ETo fulfill their mission, the Commission may involve itself in the following activities:\u003Col\u003E\u003Cli\u003ETo monitor and update the bicycle transportation plan and pedestrian transportation guidelines;\u003C\/li\u003E\u003Cli\u003ETo suggest recommendations, review and monitor the City\u2019s general plan transportation element;\u003C\/li\u003E\u003Cli\u003ETo receive public input pertaining to bicycle and pedestrian transportation and infrastructure issues;\u003C\/li\u003E\u003Cli\u003ETo make recommendations regarding the implementation of roadway and transportation improvements as it pertains to bicycle and pedestrian needs;\u003C\/li\u003E\u003Cli\u003ETo make recommendations regarding the allocation of funds for capital expenditures relating to bicycle and pedestrian transportation;\u003C\/li\u003E\u003Cli\u003EAny other activity that may be deemed appropriate and necessary.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1895, (part), 2002)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"83aa9b5a-6446-4829-91b6-95686ea283c6","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/c016595b-e3ab-4d49-bef9-4fdc60eb0407","ref":{"parent":"96b1dafc-7e28-495a-9aae-4cc0a399432f","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-228-210","docId":"75","text":"2.92.090 Compensation\u2013Expenses.","id":"c016595b-e3ab-4d49-bef9-4fdc60eb0407","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/c016595b-e3ab-4d49-bef9-4fdc60eb0407\/7aecc4ef-857d-4b54-bd20-bc2b7c2a3e8e","ref":{"parent":"c016595b-e3ab-4d49-bef9-4fdc60eb0407","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-228-210-11","docId":"75","text":"\u003Cp\u003EMembers of the Bicycle Pedestrian Commission shall serve without compensation. Commissioners may be reimbursed for necessary expenses reasonably incurred by them while acting in their official capacity subject to the approval of the City Manager.\u003C\/p\u003E\u003Cp\u003E(Ord. 21-2234, Att. A (\u00a7 2, part), 2021; Ord. 1895, (part), 2002)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"7aecc4ef-857d-4b54-bd20-bc2b7c2a3e8e","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/877bceb7-b749-4419-9e87-9d5c04b62092","ref":{"parent":"96b1dafc-7e28-495a-9aae-4cc0a399432f","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-228-211","docId":"75","text":"2.92.100 Procedural Rules.","id":"877bceb7-b749-4419-9e87-9d5c04b62092","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/877bceb7-b749-4419-9e87-9d5c04b62092\/18366692-511a-444f-95a6-5dfbb7abd1bf","ref":{"parent":"877bceb7-b749-4419-9e87-9d5c04b62092","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-228-211-11","docId":"75","text":"\u003Cp\u003EThe Commission may adopt from time to time such rules of procedure as it may deem necessary to properly exercise its powers and duties. Such rules shall be kept on file with the chairperson of the Commission, the Mayor and the City Clerk, and a copy thereof shall be furnished to any person on request.\u003C\/p\u003E\u003Cp\u003E(Ord. 1895, (part), 2002)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"18366692-511a-444f-95a6-5dfbb7abd1bf","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/23f7844f-f7d8-4936-bd91-4d043f156b59","ref":{"parent":"96b1dafc-7e28-495a-9aae-4cc0a399432f","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-228-212","docId":"75","text":"2.92.110 Effect.","id":"23f7844f-f7d8-4936-bd91-4d043f156b59","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/96b1dafc-7e28-495a-9aae-4cc0a399432f\/23f7844f-f7d8-4936-bd91-4d043f156b59\/27258fb0-b469-498e-be2d-3a380c3e51f3","ref":{"parent":"23f7844f-f7d8-4936-bd91-4d043f156b59","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-228-212-11","docId":"75","text":"\u003Cp\u003ENothing in this chapter shall be construed as restricting any powers of the City Council or City officers.\u003C\/p\u003E\u003Cp\u003E(Ord. 1895, (part), 2002)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"27258fb0-b469-498e-be2d-3a380c3e51f3","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-229","docId":"75","text":"CHAPTER 2.94: SUSTAINABILITY COMMISSION","id":"626328dc-50c3-4ffc-a20e-67e9ccb29ac6","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/bdc7bbd9-1c3e-499b-8805-8f7345505a2b","ref":{"parent":"626328dc-50c3-4ffc-a20e-67e9ccb29ac6","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-229-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"bdc7bbd9-1c3e-499b-8805-8f7345505a2b","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/a1d6c884-f99a-49aa-a6be-f2bc5dc046da","ref":{"parent":"626328dc-50c3-4ffc-a20e-67e9ccb29ac6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-229-12","docId":"75","text":"2.94.010 Established\u2013Composition.","id":"a1d6c884-f99a-49aa-a6be-f2bc5dc046da","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/a1d6c884-f99a-49aa-a6be-f2bc5dc046da\/8f1b2412-7c3b-4073-b204-c3fa1f2c8fb1","ref":{"parent":"a1d6c884-f99a-49aa-a6be-f2bc5dc046da","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-229-12-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe Sustainability Commission of the City of Cupertino is established. The Sustainability Commission (hereinafter referred to in this Chapter as \u0022Commission\u0022) shall consist of five members as follows:\u003Col\u003E\u003Cli\u003EOne representative from a Cupertino-based primary, secondary, or higher educational institution;\u003C\/li\u003E\u003Cli\u003EFour community members.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003ECommission members who are representatives of an educational institution are not required to be Cupertino residents, but the educational institution must be located in Cupertino. The four community members must be residents of Cupertino.\u003C\/li\u003E\u003Cli\u003EIn selection of community members, the City Council may give priority to:\u003Col\u003E\u003Cli\u003EApplicants who represent the target sectors and partners as described in the Cupertino Climate Action Plan (hereinafter referred to in this Chapter as \u0022CAP\u0022).\u003C\/li\u003E\u003Cli\u003EApplicants who are familiar with climate change mitigation and adaptation strategies, greenhouse gas emissions inventories, resource and utility conservation, sustainability and behavior change.\u003C\/li\u003E\u003Cli\u003EApplicants who represent non-profit community organizations and environmental interest groups.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003ENone of these representatives shall be officials or employees of the City, nor cohabit with, as defined by law, nor be related by blood or marriage to any other member of the Commission, to the City Manager or to any staff person(s) who may be assigned to assist this Commission.\u003C\/li\u003E\u003Cli\u003EMembers of the Commission shall be appointed by the City Council.\u003C\/li\u003E\u003Cli\u003EThe Sustainability Manager, or his or her designee, shall provide technical assistance to the Commission.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 2132, \u00a7 1 (part), 2015; Ord. 24-2256, Att. B \u00a7 2, 2024)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"8f1b2412-7c3b-4073-b204-c3fa1f2c8fb1","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/cab8365c-ef5f-4d06-8976-886ca9743d97","ref":{"parent":"626328dc-50c3-4ffc-a20e-67e9ccb29ac6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-229-13","docId":"75","text":"2.94.020 Terms of Office.","id":"cab8365c-ef5f-4d06-8976-886ca9743d97","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/cab8365c-ef5f-4d06-8976-886ca9743d97\/c5fd0dec-f444-4804-bc46-155392c6ce98","ref":{"parent":"cab8365c-ef5f-4d06-8976-886ca9743d97","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-229-13-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ECommissioners serve at the pleasure of the City Council. The initial term of office of two of the members of the Commission selected from among the community members shall be for two years. The initial term of the remaining Commissioners shall be for a four year period. All subsequent terms shall be for a four year period. All terms shall end on January 30th of the year the term is due to expire. No Commissioner shall serve more than two consecutive terms, except that a Commissioner may serve more than two consecutive terms if he or she has been appointed to the Commission to fill an unexpired term of less than two years.\u003C\/li\u003E\u003Cli\u003EThe appointment, reappointment and rules governing incumbent members of the Commission are governed by the Resolution of the Cupertino City Council which governs advisory bodies.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 13 (part), 2018; Ord. 2132, \u00a7 1 (part), 2015)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"c5fd0dec-f444-4804-bc46-155392c6ce98","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/6ecc8624-af8c-4503-9079-4fa154e84f93","ref":{"parent":"626328dc-50c3-4ffc-a20e-67e9ccb29ac6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-229-14","docId":"75","text":"2.94.030 Members\u2013Vacancy or Removal.","id":"6ecc8624-af8c-4503-9079-4fa154e84f93","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/6ecc8624-af8c-4503-9079-4fa154e84f93\/afeec060-c423-4169-8aae-d3035c73a7e4","ref":{"parent":"6ecc8624-af8c-4503-9079-4fa154e84f93","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-229-14-11","docId":"75","text":"\u003Cp\u003EAny Commissioner may be removed by a majority vote of the City Council. If a vacancy occurs, other than by expiration of a term, it shall be filled by the City Council\u0027s appointment for the unexpired portion of the term.\u003C\/p\u003E\u003Cp\u003E(Ord. 2132, \u00a7 1 (part), 2015)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"afeec060-c423-4169-8aae-d3035c73a7e4","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/5e6e956b-3ed8-42a6-a78e-e75206367848","ref":{"parent":"626328dc-50c3-4ffc-a20e-67e9ccb29ac6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-229-15","docId":"75","text":"2.94.040 Chairperson.","id":"5e6e956b-3ed8-42a6-a78e-e75206367848","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/5e6e956b-3ed8-42a6-a78e-e75206367848\/588d0add-83d8-4934-aee3-0451a5c92442","ref":{"parent":"5e6e956b-3ed8-42a6-a78e-e75206367848","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-229-15-11","docId":"75","text":"\u003Cp\u003EThe Commission shall elect its chairperson and vice-chairperson from among its members and shall appoint a secretary. Terms of the chair and vice-chair shall be for one year and shall be complete on January 30th.\u003C\/p\u003E\u003Cp\u003E(Ord. 2132, \u00a7 1 (part), 2015)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"588d0add-83d8-4934-aee3-0451a5c92442","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/9a90c42c-eb10-469f-bd2c-2bcd86400811","ref":{"parent":"626328dc-50c3-4ffc-a20e-67e9ccb29ac6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-229-16","docId":"75","text":"2.94.050 Meetings\u2013Quorum.","id":"9a90c42c-eb10-469f-bd2c-2bcd86400811","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/9a90c42c-eb10-469f-bd2c-2bcd86400811\/1fe24554-bd17-481f-b6c0-9f2e25c4b9a9","ref":{"parent":"9a90c42c-eb10-469f-bd2c-2bcd86400811","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-229-16-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe Commission shall hold regular meetings at least once every three months and at the discretion of the Commission shall hold other meetings as may be necessary or expedient.\u003C\/li\u003E\u003Cli\u003EA majority of the Sustainability Commission shall constitute a quorum for the purpose of transacting the business of the Commission.\u003C\/li\u003E\u003Cli\u003EA special meeting may be called at any time by the chairperson or by a majority of the Commissioners upon notice being given in advance in accordance with the provisions of the Ralph M. Brown Act or successor statute in effect at the time.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 2132, \u00a7 1 (part), 2015)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"1fe24554-bd17-481f-b6c0-9f2e25c4b9a9","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/d7ddaa54-025e-48df-9fbe-55b84aed6013","ref":{"parent":"626328dc-50c3-4ffc-a20e-67e9ccb29ac6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-229-17","docId":"75","text":"2.94.060 Majority Vote Required.","id":"d7ddaa54-025e-48df-9fbe-55b84aed6013","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/d7ddaa54-025e-48df-9fbe-55b84aed6013\/cb590274-5bbd-443e-a135-ffd9451083f2","ref":{"parent":"d7ddaa54-025e-48df-9fbe-55b84aed6013","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-229-17-11","docId":"75","text":"\u003Cp\u003EA majority vote is required to approve a recommendation on any matter that is presented to the Commission that requires a vote.\u003C\/p\u003E\u003Cp\u003E(Ord. 2132, \u00a7 1 (part), 2015)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"cb590274-5bbd-443e-a135-ffd9451083f2","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/dcf20158-b512-43a7-9042-536c2ad819dc","ref":{"parent":"626328dc-50c3-4ffc-a20e-67e9ccb29ac6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-229-18","docId":"75","text":"2.94.070 Records.","id":"dcf20158-b512-43a7-9042-536c2ad819dc","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/dcf20158-b512-43a7-9042-536c2ad819dc\/7fc43584-5b95-4df9-b451-9dde472ca98d","ref":{"parent":"dcf20158-b512-43a7-9042-536c2ad819dc","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-229-18-11","docId":"75","text":"\u003Cp\u003EThe Commission shall keep an accurate record of its proceedings and transactions, and shall render such reports to the City Council as may be required. These records shall be filed with the City Clerk.\u003C\/p\u003E\u003Cp\u003E(Ord. 18-2180, \u00a7 13 (part), 2018; Ord. 2132, \u00a7 1 (part), 2015)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"7fc43584-5b95-4df9-b451-9dde472ca98d","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/a915ebab-3add-43b7-aeca-3e892e0b3e34","ref":{"parent":"626328dc-50c3-4ffc-a20e-67e9ccb29ac6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-229-19","docId":"75","text":"2.94.080 Powers and Functions.","id":"a915ebab-3add-43b7-aeca-3e892e0b3e34","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/a915ebab-3add-43b7-aeca-3e892e0b3e34\/bff096ce-0bda-43cd-9859-e6d81173e74e","ref":{"parent":"a915ebab-3add-43b7-aeca-3e892e0b3e34","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-229-19-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe powers and functions of the Commission shall be to serve in an advisory capacity to the City Council to provide expertise and guidance on major policy and programmatic areas related to the environmental, economic and societal goals noted within Cupertino\u0027s CAP and General Plan Environmental Resources\/Sustainability Element.\u003C\/li\u003E\u003Cli\u003ETo fulfill their mission, the Commission may involve itself in the following activities:\u003Col\u003E\u003Cli\u003EMonitor and update the CAP based upon quantified metrics to measure and evaluate mitigated impacts and community benefits.\u003C\/li\u003E\u003Cli\u003ESuggest recommendations, review, and monitor the City\u0027s General Plan Environmental Resources\/Sustainability Element and its intersections with the CAP.\u003C\/li\u003E\u003Cli\u003EAdvise the City Council how to strategically accelerate Cupertino\u0027s progress towards sustainability and recommend priorities to promote continued regional leadership in sustainability.\u003C\/li\u003E\u003Cli\u003EPeriodically review policies governing specific practices and programs, such as greenhouse gas emissions reduction, water conservation, renewable energy, energy efficiency, materials management, and urban forestry. Illustrative examples include creation of infrastructure for low emissions vehicles, installation of renewable energy or energy efficiency technologies, drafting of water conservation or waste reduction policies, delivery of habitat restoration and conservation programs, design and roll-out of pollution prevention campaigns, etc.\u003C\/li\u003E\u003Cli\u003EMake recommendations regarding the allocation of funds for infrastructure and technology improvements to elevate operational performance of City facilities, businesses, educational institutions and homes by reducing costs, improving public health, and serving community needs.\u003C\/li\u003E\u003Cli\u003EAccept public input on the subject areas noted above and advise the City Council on ways to drive community awareness, behavior change, education and participation in City programs modeled upon the field\u0027s best practices.\u003C\/li\u003E\u003Cli\u003EReview and make recommendations to the City Council on Federal, State and regional policies related to sustainability that have the potential to impact City Council\u0027s goals and policies.\u003C\/li\u003E\u003Cli\u003EPursue any other activity or scope that may be deemed appropriate and necessary by the City Council.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 2132, \u00a7 1 (part), 2015)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"bff096ce-0bda-43cd-9859-e6d81173e74e","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/37d6842b-2d49-4337-bf31-04fb471fa0ca","ref":{"parent":"626328dc-50c3-4ffc-a20e-67e9ccb29ac6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-229-210","docId":"75","text":"2.94.090 Compensation\u2013Expenses.","id":"37d6842b-2d49-4337-bf31-04fb471fa0ca","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/37d6842b-2d49-4337-bf31-04fb471fa0ca\/0eeb1c9e-4cc9-4e4a-a08d-c6a4b72503b3","ref":{"parent":"37d6842b-2d49-4337-bf31-04fb471fa0ca","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-229-210-11","docId":"75","text":"\u003Cp\u003EMembers of the Commission shall serve without compensation. Commissioners may be reimbursed for necessary expenses reasonably incurred by them while acting in their official capacity subject to the approval of the City Manager.\u003C\/p\u003E\u003Cp\u003E(Ord. 2132, \u00a7 1 (part), 2015)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0eeb1c9e-4cc9-4e4a-a08d-c6a4b72503b3","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/9430ad1e-d853-4c7a-8368-d1b129ff3d72","ref":{"parent":"626328dc-50c3-4ffc-a20e-67e9ccb29ac6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-229-211","docId":"75","text":"2.94.100 Procedural Rules.","id":"9430ad1e-d853-4c7a-8368-d1b129ff3d72","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/9430ad1e-d853-4c7a-8368-d1b129ff3d72\/a0f643e0-6fd8-4955-99a6-ec9157ee6fc4","ref":{"parent":"9430ad1e-d853-4c7a-8368-d1b129ff3d72","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-229-211-11","docId":"75","text":"\u003Cp\u003EThe Commission may adopt from time to time such rules of procedure as it may deem necessary to properly exercise its powers and duties. Such rules shall be kept on file with the Chairperson of the Commission, the Mayor, and the City Clerk, and a copy thereof shall be furnished to any person on request.\u003C\/p\u003E\u003Cp\u003E(Ord. 2132, \u00a7 1 (part), 2015)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"a0f643e0-6fd8-4955-99a6-ec9157ee6fc4","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/c9364415-2aca-47a1-aae1-bf18aed2c3a0","ref":{"parent":"626328dc-50c3-4ffc-a20e-67e9ccb29ac6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-229-212","docId":"75","text":"2.94.110 Effect.","id":"c9364415-2aca-47a1-aae1-bf18aed2c3a0","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/626328dc-50c3-4ffc-a20e-67e9ccb29ac6\/c9364415-2aca-47a1-aae1-bf18aed2c3a0\/4b19a7f3-01c6-4ef7-bfd5-680c72dc59d6","ref":{"parent":"c9364415-2aca-47a1-aae1-bf18aed2c3a0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-229-212-11","docId":"75","text":"\u003Cp\u003ENothing in this Chapter shall be construed as restricting or curtailing any powers of the City Council or City officers.\u003C\/p\u003E\u003Cp\u003E(Ord. 2132, \u00a7 1 (part), 2015)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"4b19a7f3-01c6-4ef7-bfd5-680c72dc59d6","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-230","docId":"75","text":"CHAPTER 2.95: TEEN COMMISSION","id":"342d826f-a91b-4a8a-a829-cc29f0a54a16","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/4f886ec7-82ee-4f93-a567-82b07b94bb6f","ref":{"parent":"342d826f-a91b-4a8a-a829-cc29f0a54a16","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-230-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"4f886ec7-82ee-4f93-a567-82b07b94bb6f","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/115e737c-a003-46e9-ba61-c2cb27455b4c","ref":{"parent":"342d826f-a91b-4a8a-a829-cc29f0a54a16","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-230-12","docId":"75","text":"2.95.010 Established.","id":"115e737c-a003-46e9-ba61-c2cb27455b4c","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/115e737c-a003-46e9-ba61-c2cb27455b4c\/3a19511a-363c-475e-bf0c-df6cf080cd8a","ref":{"parent":"115e737c-a003-46e9-ba61-c2cb27455b4c","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-230-12-11","docId":"75","text":"\u003Cp\u003EThe Teen Commission of the City is established. The Teen Commission (hereinafter referred to in this Chapter as \u0022Commission\u0022) will be comprised of nine members, at least one person from each public middle school and public high school in Cupertino, if possible. Membership on the Commission will be limited to Cupertino residents. Members may attend schools outside of the City limits, or be schooled at home. Commissioners must be in the 8th through 11th grade at time of appointment. None of the Teen Commissioners shall be otherwise officials or employees of the City of Cupertino nor be related by blood or marriage to any official or employee of the City. Commissioners should reflect the broadest possible representation of Cupertino youth.\u003C\/p\u003E\u003Cp\u003E(Ord. 18-2181, \u00a7 1 (part), 2018)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"3a19511a-363c-475e-bf0c-df6cf080cd8a","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/2f837dce-f2c8-4977-8037-3670d67e4b95","ref":{"parent":"342d826f-a91b-4a8a-a829-cc29f0a54a16","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-230-13","docId":"75","text":"2.95.020 Terms of Office.","id":"2f837dce-f2c8-4977-8037-3670d67e4b95","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/2f837dce-f2c8-4977-8037-3670d67e4b95\/46cbc4bb-d8fc-4979-b101-8b8ea3b06f32","ref":{"parent":"2f837dce-f2c8-4977-8037-3670d67e4b95","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-230-13-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ECommission members serve at the pleasure of the City Council. The term of office of Teen Commission members shall be for two years. Five appointments will be made in odd-numbered years and four appointments in even-numbered years. The terms will begin on September 1st and end on August 31st of the year their term is due to expire. Commissioners shall not serve consecutive terms unless there is a vacancy for which there is no eligible applicant, at which time the City Council may waive this restriction.\u003C\/li\u003E\u003Cli\u003EThe appointment, reappointment and rules governing incumbent members of the Commission are governed by the Resolution of the Cupertino City Council which governs advisory bodies and the Resolution of the Cupertino City Council which governs the Teen Commission specifically.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 18-2181, \u00a7 1 (part), 2018)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"46cbc4bb-d8fc-4979-b101-8b8ea3b06f32","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/088f45ea-0e72-4366-92c2-6b12c57c0707","ref":{"parent":"342d826f-a91b-4a8a-a829-cc29f0a54a16","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-230-14","docId":"75","text":"2.95.030 Vacancy\u2014Removal.","id":"088f45ea-0e72-4366-92c2-6b12c57c0707","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/088f45ea-0e72-4366-92c2-6b12c57c0707\/e00a31ee-518f-4962-beb3-3f17b7a57262","ref":{"parent":"088f45ea-0e72-4366-92c2-6b12c57c0707","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-230-14-11","docId":"75","text":"\u003Cp\u003EAny appointee member may be removed by a majority vote of the City Council. Vacancies shall be filled by appointment by the City Council, and shall be for the unexpired portion of the term of office vacated.\u003C\/p\u003E\u003Cp\u003E(Ord. 18-2181, \u00a7 1 (part), 2018)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"e00a31ee-518f-4962-beb3-3f17b7a57262","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/539f98bf-5d34-4790-992e-578eb5bbb915","ref":{"parent":"342d826f-a91b-4a8a-a829-cc29f0a54a16","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-230-15","docId":"75","text":"2.95.040 Chairperson.","id":"539f98bf-5d34-4790-992e-578eb5bbb915","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/539f98bf-5d34-4790-992e-578eb5bbb915\/0112636c-149c-4e51-af7f-66375040e795","ref":{"parent":"539f98bf-5d34-4790-992e-578eb5bbb915","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-230-15-11","docId":"75","text":"\u003Cp\u003EThe Commission shall elect its Chairperson and Vice-Chairperson from among its members who shall serve in these capacities for one year.\u003C\/p\u003E\u003Cp\u003E(Ord. 18-2181, \u00a7 1 (part), 2018)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0112636c-149c-4e51-af7f-66375040e795","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/deb6d0da-e528-4421-b8bf-ddb4dc4f3cb3","ref":{"parent":"342d826f-a91b-4a8a-a829-cc29f0a54a16","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-230-16","docId":"75","text":"2.95.050 Meetings\u2014Quorum.","id":"deb6d0da-e528-4421-b8bf-ddb4dc4f3cb3","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/deb6d0da-e528-4421-b8bf-ddb4dc4f3cb3\/9e0cc372-b44a-4167-afd4-e6c6dd188640","ref":{"parent":"deb6d0da-e528-4421-b8bf-ddb4dc4f3cb3","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-230-16-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe Teen Commission shall hold regular meetings at least every other month, and, at the discretion of the Commission, such other meetings as may be necessary or expedient.\u003C\/li\u003E\u003Cli\u003EA majority of the Commission shall constitute a quorum for the purpose of transacting the business of the Commission.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 18-2181, \u00a7 1 (part), 2018)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"9e0cc372-b44a-4167-afd4-e6c6dd188640","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/240141c1-276c-4918-b3c4-fccc84cca823","ref":{"parent":"342d826f-a91b-4a8a-a829-cc29f0a54a16","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-230-17","docId":"75","text":"2.95.060 Majority Vote Required.","id":"240141c1-276c-4918-b3c4-fccc84cca823","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/240141c1-276c-4918-b3c4-fccc84cca823\/5e54e74b-54ad-48e4-82e9-0822e65a136e","ref":{"parent":"240141c1-276c-4918-b3c4-fccc84cca823","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-230-17-11","docId":"75","text":"\u003Cp\u003EA majority vote is required to approve a recommendation or on any matter that is presented to the Commission which requires a vote.\u003C\/p\u003E\u003Cp\u003E(Ord. 18-2181, \u00a7 1 (part), 2018)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"5e54e74b-54ad-48e4-82e9-0822e65a136e","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/7b77a6a3-8f4d-4d9b-b786-4ec0d3f2231b","ref":{"parent":"342d826f-a91b-4a8a-a829-cc29f0a54a16","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-230-18","docId":"75","text":"2.95.070 Records.","id":"7b77a6a3-8f4d-4d9b-b786-4ec0d3f2231b","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/7b77a6a3-8f4d-4d9b-b786-4ec0d3f2231b\/7b4a9cdb-72d5-4f65-a6fb-dc9fa7461e39","ref":{"parent":"7b77a6a3-8f4d-4d9b-b786-4ec0d3f2231b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-230-18-11","docId":"75","text":"\u003Cp\u003EThe Commission shall keep an accurate record of its proceedings and transactions, and shall render such reports to the City Council as may be required. These records shall be filed with the City Clerk.\u003C\/p\u003E\u003Cp\u003E(Ord. 18-2181, \u00a7 1 (part), 2018)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"7b4a9cdb-72d5-4f65-a6fb-dc9fa7461e39","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/8ad20664-74e0-4247-a1a6-8c70bffa29d9","ref":{"parent":"342d826f-a91b-4a8a-a829-cc29f0a54a16","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-230-19","docId":"75","text":"2.95.080 Powers and Functions.","id":"8ad20664-74e0-4247-a1a6-8c70bffa29d9","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/8ad20664-74e0-4247-a1a6-8c70bffa29d9\/a1170131-6db8-48e3-a208-c8790320d6fb","ref":{"parent":"8ad20664-74e0-4247-a1a6-8c70bffa29d9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-230-19-11","docId":"75","text":"\u003Cp\u003EThe powers and functions of the Teen Commission shall be as follows:\u003C\/p\u003E\u003Cp\u003EA. Advise the City Council and staff on issues and projects important to youth.\u003C\/p\u003E\u003Cp\u003EB. Perform such other tasks as may be expressly requested of it by the City Council.\u003C\/p\u003E\u003Cp\u003E(Ord. 18-2181, \u00a7 1 (part), 2018)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"a1170131-6db8-48e3-a208-c8790320d6fb","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/20947be4-2bd4-4e26-bb46-74aac89f8f31","ref":{"parent":"342d826f-a91b-4a8a-a829-cc29f0a54a16","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-230-210","docId":"75","text":"2.95.090 Compensation\u2014Expenses.","id":"20947be4-2bd4-4e26-bb46-74aac89f8f31","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/20947be4-2bd4-4e26-bb46-74aac89f8f31\/55c6e2c6-e6b5-494b-afef-eb74a412b198","ref":{"parent":"20947be4-2bd4-4e26-bb46-74aac89f8f31","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-230-210-11","docId":"75","text":"\u003Cp\u003EMembers of the Commission shall serve without compensation. Commissioners may be reimbursed for necessary expenses reasonably incurred by them while acting in their official capacity subject to the approval of the City Manager.\u003C\/p\u003E\u003Cp\u003E(Ord. 18-2181, \u00a7 1 (part), 2018)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"55c6e2c6-e6b5-494b-afef-eb74a412b198","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/76c69f0e-13ea-481d-9958-fb3380cd35c9","ref":{"parent":"342d826f-a91b-4a8a-a829-cc29f0a54a16","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-230-211","docId":"75","text":"2.95.100 Procedural Rules.","id":"76c69f0e-13ea-481d-9958-fb3380cd35c9","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/76c69f0e-13ea-481d-9958-fb3380cd35c9\/f01794fc-fc21-4a35-8e5b-421ddd1a7acc","ref":{"parent":"76c69f0e-13ea-481d-9958-fb3380cd35c9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-230-211-11","docId":"75","text":"\u003Cp\u003EThe Commission may adopt from time to time such rules of procedure as it may deem necessary to properly exercise its powers and duties. Such rules shall be subject to the approval by the City Council and shall be kept on file with the Chairperson of the Commission and the City Clerk, and a copy thereof shall be furnished to any person on request.\u003C\/p\u003E\u003Cp\u003E(Ord. 18-2181, \u00a7 1 (part), 2018)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f01794fc-fc21-4a35-8e5b-421ddd1a7acc","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/74f0f05d-5e3a-4519-99d2-a7b21e7ad526","ref":{"parent":"342d826f-a91b-4a8a-a829-cc29f0a54a16","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-230-212","docId":"75","text":"2.95.110 Effect.","id":"74f0f05d-5e3a-4519-99d2-a7b21e7ad526","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/342d826f-a91b-4a8a-a829-cc29f0a54a16\/74f0f05d-5e3a-4519-99d2-a7b21e7ad526\/afd86720-ea10-4533-b53c-cdfe7109f249","ref":{"parent":"74f0f05d-5e3a-4519-99d2-a7b21e7ad526","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-230-212-11","docId":"75","text":"\u003Cp\u003ENothing in this Chapter shall be construed as restricting or curtailing any powers of the City Council or City officers.\u003C\/p\u003E\u003Cp\u003E(Ord. 18-2181, \u00a7 1 (part), 2018)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"afd86720-ea10-4533-b53c-cdfe7109f249","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-231","docId":"75","text":"CHAPTER 2.96: ECONOMIC DEVELOPMENT COMMITTEE","id":"22fecff5-a905-49f1-971d-fc0fc2d32a50","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/bb0bcab4-57dd-41d9-b079-2167b8774eef","ref":{"parent":"22fecff5-a905-49f1-971d-fc0fc2d32a50","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-231-11","docId":"75","text":"2.96. 010 Established\u2013 Composition.","id":"bb0bcab4-57dd-41d9-b079-2167b8774eef","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/bb0bcab4-57dd-41d9-b079-2167b8774eef\/9aa29668-fa56-4f09-b083-17a24bf9888a","ref":{"parent":"bb0bcab4-57dd-41d9-b079-2167b8774eef","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-231-11-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe Economic Development Committee of the City of Cupertino is re-established. The Economic Development Committee (hereinafter referred to in this Chapter as Committee\u201d) shall consist of nine (9) members as follows:\u003Col\u003E\u003Cli\u003ECity Councilmember\u003C\/li\u003E\u003Cli\u003ETechnology Sector Business Representative\u003C\/li\u003E\u003Cli\u003ERetail\/ Small Business Representative\u003C\/li\u003E\u003Cli\u003EHospitality\/ Tourism Sector Representative\u003C\/li\u003E\u003Cli\u003EEducation Sector Representative\u003C\/li\u003E\u003Cli\u003ECommercial Real Estate Representative\u003C\/li\u003E\u003Cli\u003ESustainability Commissioner\u003C\/li\u003E\u003Cli\u003ETechnology, Information, and Communications Commissioner\u003C\/li\u003E\u003Cli\u003EPlanning Commissioner\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EThe Committee shall be comprised of: (1) one Councilmember; (2) one representative from each of the following industry sectors \u2013 Technology, Retail, Hospitality, Education, and Commercial Real Estate; (3) one member who is currently serving on the Sustainability Commission; ( 4) one member who is currently serving on the Technology, Information, and Communications Commissions; and (5) one member who is currently serving on the Planning Commission. Industry sector representatives must work for an organization located within the City or be residents of the City, or both.\u003C\/li\u003E\u003Cli\u003ENone of the industry sector representative Committee Members shall be officials or employees of the City. No member of the Committee shall cohabit with, as defined by law, nor be related by blood or marriage, to any other member of the Committee, to the City Manager, or to any staff person(s) who may be assigned to assist this Committee.\u003C\/li\u003E\u003Cli\u003EMembers of the Committee shall be appointed by the City Council.\u003C\/li\u003E\u003C\/ol\u003E","id":"9aa29668-fa56-4f09-b083-17a24bf9888a","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/3f5fec37-aacd-49e3-aadd-7cd75689f0df","ref":{"parent":"22fecff5-a905-49f1-971d-fc0fc2d32a50","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-231-12","docId":"75","text":"2.96. 020 Terms of Office.","id":"3f5fec37-aacd-49e3-aadd-7cd75689f0df","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/3f5fec37-aacd-49e3-aadd-7cd75689f0df\/bf4d17da-dc71-462a-95b2-72e96280013a","ref":{"parent":"3f5fec37-aacd-49e3-aadd-7cd75689f0df","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-231-12-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ECommittee Members serve at the pleasure of the City Council.  The term of office for the Committee\u2019s  Members industry sector representatives shall be staggered with the initial appointment of two members to terms expiring January 30, 2027, and three  two-year terms and four members to four-year terms expiring January 30, 2029..  Following the initial appointment, all of the Committee\u2019s industry sector representatives members shall be appointed to four-year terms.  The initial term of office of the City Councilmember, Sustainability Commissioner, Technology, Information, and Communications Commissioner and Planning Commissioner shall be for a term expiring January 30, 2026. Following the initial appointment, the term of office for the City Councilmember, Sustainability Commissioner, Technology Information, and Communications Commissioner and Planning Commissioner shall be for a term of one year, expiring on January 30 of each year, or until a successor is duly appointed. If a Committee Member is replaced or removed by Council, resigns, or is no longer eligible to serve on the Committee, Council shall appoint a replacement to serve the remaining period of the Committee Member\u2019s term.  All terms shall end on January 30 of the year the term is due to expire.  No Committee Member shall serve more than two consecutive terms, except that a Committee Member may serve more than two consecutive terms if he or she has been appointed to the Committee to fill an unexpired term of less than two years.\u003C\/li\u003E\u003Cli\u003EThe appointment, reappointment, and rules governing industry sector representative Committee Members are governed by the Resolution of the Cupertino City Council which governs advisory bodies.\u003C\/li\u003E\u003Cli\u003EThe City Council may in its discretion adopt different policies, procedures, and terms of service for the appointment of City Councilmembers and Commissioners to serve on the Committee.\u003C\/li\u003E\u003C\/ol\u003E","id":"bf4d17da-dc71-462a-95b2-72e96280013a","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/8a11657d-5db5-41c9-b148-d62099bfdb08","ref":{"parent":"22fecff5-a905-49f1-971d-fc0fc2d32a50","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-231-13","docId":"75","text":"2.96.030 Members\u2013 Vacancy or Removal.","id":"8a11657d-5db5-41c9-b148-d62099bfdb08","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/8a11657d-5db5-41c9-b148-d62099bfdb08\/6ae757e6-b76f-415b-8e85-7f06a717515a","ref":{"parent":"8a11657d-5db5-41c9-b148-d62099bfdb08","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-231-13-11","docId":"75","text":"\u003Cp\u003EAny Committee Member may be removed by a majority vote of the City Council. If a vacancy occurs, other than by expiration of a term, it shall be filled by the City Council\u2019 s appointment for the unexpired portion of the term.\u003C\/p\u003E","id":"6ae757e6-b76f-415b-8e85-7f06a717515a","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/a6defc61-b8df-494b-ac2b-6cc46828f277","ref":{"parent":"22fecff5-a905-49f1-971d-fc0fc2d32a50","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-231-14","docId":"75","text":"2.96. 040 Chairperson.","id":"a6defc61-b8df-494b-ac2b-6cc46828f277","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/a6defc61-b8df-494b-ac2b-6cc46828f277\/50175764-be50-4afb-9a39-8eb1a04433a7","ref":{"parent":"a6defc61-b8df-494b-ac2b-6cc46828f277","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-231-14-11","docId":"75","text":"\u003Cp\u003EThe Committee shall elect its Chairperson and Vice Chairperson from among its Members. The Chairperson shall appoint a secretary. Terms of the Chair and Vice Chair shall be for one year.\u003C\/p\u003E","id":"50175764-be50-4afb-9a39-8eb1a04433a7","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/e40559c9-aab7-4693-a65e-9a33239b1ef9","ref":{"parent":"22fecff5-a905-49f1-971d-fc0fc2d32a50","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-231-15","docId":"75","text":"2.96. 050 Meetings\u2013 Quorum.","id":"e40559c9-aab7-4693-a65e-9a33239b1ef9","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/e40559c9-aab7-4693-a65e-9a33239b1ef9\/76161748-0f72-419b-ad96-7a02d906dbaf","ref":{"parent":"e40559c9-aab7-4693-a65e-9a33239b1ef9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-231-15-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe Committee shall hold regular meetings on a quarterly basis and at the discretion of the Committee shall hold other meetings as may be necessary or expedient.\u003C\/li\u003E\u003Cli\u003EA majority of the Committee shall constitute a quorum for the purpose of transacting the business of the Committee.\u003C\/li\u003E\u003Cli\u003EA special meeting may be called at any time by the Chairperson or by a majority of the Committee Members upon notice being given in advance in accordance with the provisions of the Ralph M. Brown Act or successor statute in effect at the time.\u003C\/li\u003E\u003C\/ol\u003E","id":"76161748-0f72-419b-ad96-7a02d906dbaf","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/e1a474b6-ec42-416f-a3d7-0ab162c58e7b","ref":{"parent":"22fecff5-a905-49f1-971d-fc0fc2d32a50","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-231-16","docId":"75","text":"2.96.060 Majority Vote Required.","id":"e1a474b6-ec42-416f-a3d7-0ab162c58e7b","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/e1a474b6-ec42-416f-a3d7-0ab162c58e7b\/38a10dcb-c9a2-46ef-a14d-cf5185b98bf9","ref":{"parent":"e1a474b6-ec42-416f-a3d7-0ab162c58e7b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-231-16-11","docId":"75","text":"\u003Cp\u003EA majority vote of Committee Members present and voting is required to approve a recommendation on any matter that is presented to the Committee that requires a vote.\u003C\/p\u003E","id":"38a10dcb-c9a2-46ef-a14d-cf5185b98bf9","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/8b709648-e4c1-45b4-87f3-d0345e9774d4","ref":{"parent":"22fecff5-a905-49f1-971d-fc0fc2d32a50","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-231-17","docId":"75","text":"2.96.070 Records.","id":"8b709648-e4c1-45b4-87f3-d0345e9774d4","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/8b709648-e4c1-45b4-87f3-d0345e9774d4\/c630e2e3-3ed5-495c-92c8-25c90dbb704a","ref":{"parent":"8b709648-e4c1-45b4-87f3-d0345e9774d4","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-231-17-11","docId":"75","text":"\u003Cp\u003EThe Committee shall keep an accurate record of its proceedings and transactions and shall render such reports to the City Council as may be required. These records shall be filed with the City Clerk.\u003C\/p\u003E","id":"c630e2e3-3ed5-495c-92c8-25c90dbb704a","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/c4887ca4-0f81-4ce1-ab9d-881e4187c95c","ref":{"parent":"22fecff5-a905-49f1-971d-fc0fc2d32a50","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-231-18","docId":"75","text":"2.96.080 Powers and Functions.","id":"c4887ca4-0f81-4ce1-ab9d-881e4187c95c","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/c4887ca4-0f81-4ce1-ab9d-881e4187c95c\/358e488a-f0b1-49d0-a453-ce6535444680","ref":{"parent":"c4887ca4-0f81-4ce1-ab9d-881e4187c95c","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-231-18-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe powers and functions of the Committee shall be to serve in an advisory capacity to the City Council and to provide expertise and guidance on policy related to economic development. The Committee shall also actively promote Cupertino as a location of choice for current and prospective businesses.\u003C\/li\u003E\u003Cli\u003ETo fulfill their mission, the Committee may involve itself in the following activities:\u003Col\u003E\u003Cli\u003EMake recommendations to the City Council on a broad range of strategic matters broadly applicable to the City\u2019 s economic development goals;\u003C\/li\u003E\u003Cli\u003EServe as an ambassador to shed a positive light on the City by sharing economic development resources and information to prospective businesses and stakeholders, thus positioning the City as a location of choice; and\u003C\/li\u003E\u003Cli\u003EEncourage public\/ private partnerships to further the City\u2019 s economic development goals by identifying potential resources.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003C\/ol\u003E","id":"358e488a-f0b1-49d0-a453-ce6535444680","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/b3f2e23c-323a-46b3-9820-ce4470074b03","ref":{"parent":"22fecff5-a905-49f1-971d-fc0fc2d32a50","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-231-19","docId":"75","text":"2.96.090 City Staff Assistance.","id":"b3f2e23c-323a-46b3-9820-ce4470074b03","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/b3f2e23c-323a-46b3-9820-ce4470074b03\/81e16de1-cbfd-46d0-9e88-ff016e89aed4","ref":{"parent":"b3f2e23c-323a-46b3-9820-ce4470074b03","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-231-19-11","docId":"75","text":"\u003Cp\u003EThe Committee shall have available to it such assistance of City staff as may be required to perform its functions, the staff assignments and administrative procedures to be under the general direction and supervision of the Economic Development Manager.\u003C\/p\u003E","id":"81e16de1-cbfd-46d0-9e88-ff016e89aed4","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/310fbd4f-3fab-4cbd-bccb-5a90c50bf5bb","ref":{"parent":"22fecff5-a905-49f1-971d-fc0fc2d32a50","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-231-210","docId":"75","text":"2.96. 100 Compensation\u2013 Expenses.","id":"310fbd4f-3fab-4cbd-bccb-5a90c50bf5bb","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/310fbd4f-3fab-4cbd-bccb-5a90c50bf5bb\/91973fd9-b395-4ad0-97a7-dd60ee99d4c2","ref":{"parent":"310fbd4f-3fab-4cbd-bccb-5a90c50bf5bb","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-231-210-11","docId":"75","text":"\u003Cp\u003ECommittee Members shall serve without compensation. Committee Members may be reimbursed for necessary expenses reasonably incurred by them while acting in their official capacity subject to the approval of the City Manager.\u003C\/p\u003E","id":"91973fd9-b395-4ad0-97a7-dd60ee99d4c2","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/056060bd-ed63-4417-b177-7d854b67ba04","ref":{"parent":"22fecff5-a905-49f1-971d-fc0fc2d32a50","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-231-211","docId":"75","text":"2.96. 110 Procedural Rules.","id":"056060bd-ed63-4417-b177-7d854b67ba04","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/056060bd-ed63-4417-b177-7d854b67ba04\/2f8c2c88-fd25-455a-8d86-d0f1b3eb90e5","ref":{"parent":"056060bd-ed63-4417-b177-7d854b67ba04","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-231-211-11","docId":"75","text":"\u003Cp\u003EThe Committee may adopt from time to time such rules of procedure as it may deem necessary to properly exercise its powers and duties. Such rules shall be kept on file with the Chairperson of the Committee, the Mayor, and the City Clerk, and a copy thereof shall be furnished to any person on request.\u003C\/p\u003E","id":"2f8c2c88-fd25-455a-8d86-d0f1b3eb90e5","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/d6bede59-cb52-49f0-8244-aa90a544317d","ref":{"parent":"22fecff5-a905-49f1-971d-fc0fc2d32a50","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-231-212","docId":"75","text":"2.96.120 Effect.","id":"d6bede59-cb52-49f0-8244-aa90a544317d","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/22fecff5-a905-49f1-971d-fc0fc2d32a50\/d6bede59-cb52-49f0-8244-aa90a544317d\/a16460e5-75c0-40ba-a1cd-31b6167fe85c","ref":{"parent":"d6bede59-cb52-49f0-8244-aa90a544317d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-231-212-11","docId":"75","text":"\u003Cp\u003ENothing in this Chapter shall be construed as restricting or curtailing any powers of the City Council or City officers.\u003C\/p\u003E\u003Cp\u003E(Ord. 25-2269, 2025; Ord. 25-2273, Att. A, 2025)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"a16460e5-75c0-40ba-a1cd-31b6167fe85c","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-232","docId":"75","text":"CHAPTER 2.100: REGULATION OF LOBBYING ACTIVITIES*","id":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/6a43b715-4235-41df-99fd-03501e43b533","ref":{"parent":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-232-11","docId":"75","text":"\u003Cp\u003E* Editor\u2019s note: Pursuant to Ord. 21-2222, \u00a7 4, \u201cthe provisions of Chapter 2.100 (\u201cRegulation of Lobbying Activities\u201d) shall not become operative until July 1, 2021. The City, or its designee, will not begin to enforce the provisions of Chapter 2.100 until that date.\u201d\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"6a43b715-4235-41df-99fd-03501e43b533","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/1424841b-d647-4f2f-b978-b7756766a0ec","ref":{"parent":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-232-12","docId":"75","text":"2.100.010 Purpose.","id":"1424841b-d647-4f2f-b978-b7756766a0ec","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/1424841b-d647-4f2f-b978-b7756766a0ec\/aade5582-7e2b-4db2-bc66-bc0fe1117873","ref":{"parent":"1424841b-d647-4f2f-b978-b7756766a0ec","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-232-12-11","docId":"75","text":"\u003Cp\u003EThe purpose of this chapter is to impose registration and disclosure requirements on those engaged in efforts to influence the decisions of City policy makers for Compensation. Disclosure of Lobbyists\u0027 identities and activities fosters public confidence in government officials by making government decision-making more transparent to the public. Additionally, the disclosure and registration requirements ensure that City Officials are made aware of the interests that Lobbyists represent when the officials are lobbied.\u003C\/p\u003E\u003Cp\u003E(Ord. 23-2249, Att. A (part), 2023; Ord. 21-2222, \u00a7 1 (part), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"aade5582-7e2b-4db2-bc66-bc0fe1117873","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/b434f345-98c2-42c2-8b88-b00e889c9370","ref":{"parent":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-232-13","docId":"75","text":"2.100.020 Interpretation.","id":"b434f345-98c2-42c2-8b88-b00e889c9370","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/b434f345-98c2-42c2-8b88-b00e889c9370\/87b5732c-64c5-4933-af37-dcb256151877","ref":{"parent":"b434f345-98c2-42c2-8b88-b00e889c9370","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-232-13-11","docId":"75","text":"\u003Cp\u003EUnless the term is otherwise specifically defined in this chapter or the contrary is stated, this chapter is intended to be interpreted consistently with the Political Reform Act of 1974, Government Code Section 81000 et seq., as amended from time to time.\u003C\/p\u003E\u003Cp\u003E(Ord. 23-2249, Att. A (part), 2023; Ord. 21-2222, \u00a7 1 (part), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"87b5732c-64c5-4933-af37-dcb256151877","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/b80bea7e-4eeb-408c-b42a-0bccd5634511","ref":{"parent":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-232-14","docId":"75","text":"2.100.030 Definitions.","id":"b80bea7e-4eeb-408c-b42a-0bccd5634511","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/b80bea7e-4eeb-408c-b42a-0bccd5634511\/22a2163d-366a-40d2-aa89-d3dcbc300994","ref":{"parent":"b80bea7e-4eeb-408c-b42a-0bccd5634511","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-232-14-11","docId":"75","text":"\u003Cp\u003EFor the purposes of this chapter, the following definitions shall be applicable:\u003C\/p\u003E\u003Col class=\u0022paren-value-paren\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\u003Cli\u003E\u0022Activity Expense\u0022 means any payment made by a Lobbyist to or directly benefiting any City Official, City Official-elect or member of his or her immediate family. Activity Expenses include Gifts, honoraria, consulting fees, salaries and any other form of Compensation, but do not include campaign contributions.\u003C\/li\u003E\u003Cli\u003E\u0022Administrative Action\u0022 means the proposal, drafting, development, consideration, advocacy or recommendation of any rule, regulation, agreement or contract, permit, license or hiring action.\u003C\/li\u003E\u003Cli\u003E\u0022At the behest\u0022 means at the specific direction of, or at the personal request or suggestion of, or with the express prior consent of, any elective City Official, City Official-elect or candidate for elective City office.\u003C\/li\u003E\u003Cli\u003E\u0022City Official\u0022 means any public official, or City employee who participates in the consideration of any Legislative Action or Administrative Action other than in a purely clerical, secretarial or ministerial capacity. It shall also include any City board or commission member, or City representative to any joint powers authority to which the City is a party, and any person working in a capacity as a consultant to the City.\u003C\/li\u003E\u003Cli\u003E\u0022Client\u0022 means a Person who is represented by a Contract Lobbyist, but shall not include the employer, if any, of the Contract Lobbyist.\u003C\/li\u003E\u003Cli\u003E\u0022Compensation\u0022 includes, but is not limited to, money of any denomination or origin; goods or services or anything of value, delivered or rendered; or promises to perform or provide services or contractual arrangements or awards.\u003C\/li\u003E\u003Cli\u003E\u0022Contact\u0022 means attendance at a meeting with a City Official or City Official-elect, or any direct communication with a City Official or City Official-elect, whether oral, electronic or in writing, including, but not limited to communication through an agent, associate or employee, for the purpose of Lobbying.\u003C\/li\u003E\u003Cli\u003E\u0022Fundraising Activity\u0022 means soliciting a contribution; hosting or sponsoring a fundraising event; or hiring a fundraiser or contractor to conduct any event designed for political fundraising at which contributions for any City Official, candidate for elective City office or any controlled committee of an elected City Official or candidate for City office or for any political action committee, political party or candidate for elective office of a governmental Organization are solicited, delivered or made.\u003C\/li\u003E\u003Cli\u003E\u0022Gift\u0022 has the definition provided by the California Political Reform Act of 1974, Government Code Section 82028, as amended from time to time.\u003C\/li\u003E\u003Cli\u003E\u0022Independent Expenditure\u0022 has the definition provided by the California Political Reform Act of 1974, Government Code Section 82031, as amended from time to time.\u003C\/li\u003E\u003Cli\u003E\u0022Influencing\u0022 or \u0022to Influence\u0022 means the purposeful communication, either directly or through agents, promoting, supporting, modifying, opposing, causing the delay or abandonment of conduct, or otherwise intentionally affecting the behavior of a City Official or official-elect, by any means, including, but not limited to, providing or using persuasion, information, incentives, statistics, studies or analyses.\u003C\/li\u003E\u003Cli\u003E\u0022Intermediary\u0022 means a Person who makes a campaign or officeholder contribution on behalf of another Person. A Person is an Intermediary for a contribution if the recipient of the contribution would consider that Person to be the contributor without the disclosure of the identity of the true source of the contribution. A Lobbyist acts as an Intermediary if the Lobbyist makes a contribution on behalf of another Person, and that other Person is acknowledged as the contributor, and the Lobbyist is reimbursed for the contribution.\u003C\/li\u003E\u003Cli\u003E\u0022Legislative Action\u0022 means the drafting, introduction, consideration, modification, enactment or defeat of any resolution, ordinance, amendment thereto, report, nomination, or other action of the Mayor, City Council, any City board, committee, or commission or any joint powers authority of which the City is a party, acting in its official capacity, or the granting, approval, or amendment of contracts or agreements to which the City is a party by any of the foregoing.\u003C\/li\u003E\u003Cli\u003E\u0022Lobbying\u0022 means making a Contact with a City Official for the purpose of Influencing or attempting to Influence, whether or not successful, a Legislative Action or Administrative Action of the City on behalf of his or her employer or client, except as provided in section 2.100.031.\u003C\/li\u003E\u003Cli\u003E\u0022Lobbyist\u0022 means a Contract Lobbyist or Organization Lobbyist as follows:\u003Col class=\u0022paren-value-paren\u0022 style=\u0022list-style-type:decimal\u0022\u003E\u003Cli\u003EContract Lobbyist: A Person who engages in Lobbying on behalf of one or more Clients (acting individually or through agents, associates, employees or contractors) and who has received or has entered into an agreement for Compensation of five thousand dollars ($5,000.00) or more, or equivalent nonmonetary Compensation (\u0022threshold Compensation\u0022) for engaging in Lobbying during any calendar quarter during the preceding twenty-four months; or\u003C\/li\u003E\u003Cli\u003EOrganization Lobbyist: Any Organization that hires an employee for Compensation to engage in Lobbying on its behalf with the City, provided that the employee is paid five thousand dollars ($5,000.00) or more, or equivalent nonmonetary Compensation (\u0022threshold Compensation\u0022), during any calendar quarter during the preceding twenty-four months specifically for engaging in Lobbying or for time during which Lobbying was the employee\u0027s primary duty. Individuals employed by an Organization Lobbyist to engage in Lobbying are not themselves Lobbyists unless they meet the definition of Contract Lobbyist.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003E\u0022Organization\u0022 means any Person that is not an individual.\u003C\/li\u003E\u003Cli\u003E\u0022Person\u0022 means any individual, domestic or foreign corporation, for-profit or nonprofit entity, firm, association, syndicate, union, chamber of commerce, joint-stock company, partnership of any kind, limited liability company, common-law trust, society, or any other group of Persons acting in concert.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 23-2249, Att. A (part), 2023; Ord. 21-2222, \u00a7 1 (part), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"22a2163d-366a-40d2-aa89-d3dcbc300994","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/f7338556-3f3b-4e45-b643-586290132c99","ref":{"parent":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-232-15","docId":"75","text":"2.100.031 Excluded activities.","id":"f7338556-3f3b-4e45-b643-586290132c99","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/f7338556-3f3b-4e45-b643-586290132c99\/5a054822-eb43-4589-9df5-44ac0f61d49c","ref":{"parent":"f7338556-3f3b-4e45-b643-586290132c99","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-232-15-11","docId":"75","text":"\u003Col class=\u0022paren-value-paren\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\u003Cli\u003EFor the purposes of this chapter, the following activities shall not be considered Lobbying, and the performance of such activities shall not be considered in determining whether a Person is a Lobbyist:\u003Col class=\u0022paren-value-paren\u0022 style=\u0022list-style-type:decimal\u0022\u003E\u003Cli\u003EAny actions taken by a public official acting in his or her official capacity or acting within the scope of his or her employment or appointment;\u003C\/li\u003E\u003Cli\u003EAny actions taken by a Person hired by the City for work performed on behalf of the City, or a Person who prepares documents for consideration by the City under the California Environmental Quality Act, when acting in that capacity;\u003C\/li\u003E\u003Cli\u003EWith respect only to Persons who do not otherwise qualify as Lobbyists, appearing at or submitting testimony for any public meeting held by the City or any of its agencies, offices, or departments, as long as the communications thereto are public records available for public review;\u003C\/li\u003E\u003Cli\u003EProviding oral or written information pursuant to a subpoena or otherwise compelled by law or regulation, or in response to an official request;\u003C\/li\u003E\u003Cli\u003ECommunicating with City Officials in connection with the administration of an existing contract or agreement between the Person (or its employer) and the City;\u003C\/li\u003E\u003Cli\u003EMeeting with the City Attorney, or City staff regarding any claim or litigation matter, negotiation of any agreements or contracts where the City is a party, or the requirements or interpretation of this chapter;\u003C\/li\u003E\u003Cli\u003ECommunications by designated representatives of a recognized employee Organization to City Officials or their representatives regarding (A) wages, hours and other terms or conditions of employment, or (B) the administration, implementation or interpretation of an existing employment agreement;\u003C\/li\u003E\u003Cli\u003ESubmitting bids or responding to requests for proposals while directly communicating with the official or department specifically designated to receive such information;\u003C\/li\u003E\u003Cli\u003EFor purposes of the definition of Organization Lobbyist, actions taken by the owners or employees of a business seeking to obtain a permit or other entitlement, license, or similar Administrative Action generally available to qualifying members of the public. This exemption shall not apply to actions taken on behalf of, or for the benefit of, a Client by a Contract Lobbyist;\u003C\/li\u003E\u003Cli\u003EFor purposes of the definition of Organization Lobbyist, actions taken by the Media in the ordinary course of news gathering, reporting, or editorial activity, as generally carried out by members of the professional or amateur press. \u0022Media\u0022 shall mean the publishers of newspapers or any other regularly published periodical or newsletter, a radio or television station or network, and Persons who publish information on the Internet. This exemption shall not apply to actions taken on behalf of, or for the benefit of, a Client by a Contract Lobbyist;\u003C\/li\u003E\u003Cli\u003ECommunications by individuals who are professionally licensed by a State licensing Organization pursuant to the California Business and Professions Code, including, but not limited to, attorneys, architects and engineers, and whose communications are made in the course of professional activity under such license;\u003C\/li\u003E\u003Cli\u003EActions taken by individuals whose only Compensation for the actions is reimbursement of their own reasonable travel, meals, or incidental expenses; and\u003C\/li\u003E\u003Cli\u003EActions taken by a nonprofit Organization, or its officers or employees.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 23-2249, Att. A (part), 2023)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"5a054822-eb43-4589-9df5-44ac0f61d49c","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/4a300e99-c6a5-4ae3-8646-ab9f9dcacbd0","ref":{"parent":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-232-16","docId":"75","text":"2.100.040 Registration.","id":"4a300e99-c6a5-4ae3-8646-ab9f9dcacbd0","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/4a300e99-c6a5-4ae3-8646-ab9f9dcacbd0\/aef379b4-54d3-4531-ae09-739e310447f2","ref":{"parent":"4a300e99-c6a5-4ae3-8646-ab9f9dcacbd0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-232-16-11","docId":"75","text":"\u003Cp\u003ELobbyists shall register with the City Clerk within fifteen (15) days after qualifying as a Lobbyist under CMC 2.100.030. Should a Lobbyist have a change to its registration information, including, but not limited to, the City Legislative Action or Administrative Action as to which the Lobbyist has been engaged, after the annual registration\u003C\/p\u003E\u003Cp\u003Eperiod, such Lobbyist shall file an amended registration with the City Clerk within fifteen (15) days of such change with the changed information.\u003C\/p\u003E\u003Cp\u003E(Ord. 23-2249, Att. A (part), 2023; Ord. 21-2222, \u00a7 1 (part), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"aef379b4-54d3-4531-ae09-739e310447f2","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/691ef953-86dc-488b-a97c-2e08e127c12f","ref":{"parent":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-232-17","docId":"75","text":"2.100.050 Annual registration renewal.","id":"691ef953-86dc-488b-a97c-2e08e127c12f","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/691ef953-86dc-488b-a97c-2e08e127c12f\/84336219-9f97-4cc6-a1c7-477c9e0c8ef8","ref":{"parent":"691ef953-86dc-488b-a97c-2e08e127c12f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-232-17-11","docId":"75","text":"\u003Cp\u003EA Lobbyist shall renew their registration by January 15th of each year unless they have terminated their status as a Lobbyist pursuant to CMC 2.100.060 by such date.\u003C\/p\u003E\u003Cp\u003E(Ord. 23-2249, Att. A (part), 2023; Ord. 21-2222, \u00a7 1 (part), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"84336219-9f97-4cc6-a1c7-477c9e0c8ef8","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/81d05dce-e394-4b77-9685-9a0b5fabebc1","ref":{"parent":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-232-18","docId":"75","text":"2.100.060 Termination of Lobbyist status.","id":"81d05dce-e394-4b77-9685-9a0b5fabebc1","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/81d05dce-e394-4b77-9685-9a0b5fabebc1\/33a13862-aa49-4602-889e-739357de81c0","ref":{"parent":"81d05dce-e394-4b77-9685-9a0b5fabebc1","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-232-18-11","docId":"75","text":"\u003Cp\u003EAfter initial registration, annual registration renewal will not be required if a declaration attesting to the termination of Lobbying services within the City has been filed with the City Clerk no later than January 15th.\u003C\/p\u003E\u003Cp\u003E(Ord. 23-2249, Att. A (part), 2023; Ord. 21-2222, \u00a7 1 (part), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"33a13862-aa49-4602-889e-739357de81c0","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/b81a552c-483d-41f4-b6b0-47625cf34586","ref":{"parent":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-232-19","docId":"75","text":"2.100.070 Active status.","id":"b81a552c-483d-41f4-b6b0-47625cf34586","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/b81a552c-483d-41f4-b6b0-47625cf34586\/fd029453-5d74-44fc-80bf-ac0dfbf5ea82","ref":{"parent":"b81a552c-483d-41f4-b6b0-47625cf34586","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-232-19-11","docId":"75","text":"\u003Cp\u003EAll registrations, renewals and terminations will be deemed filed on the date received by the City Clerk. A Lobbyist shall be deemed active for the duration of the year of registration ending December 31st, unless a declaration attesting to termination of Lobbying services within the City is filed.\u003C\/p\u003E\u003Cp\u003E(Ord. 23- 2249, Att. A (part), 2023; Ord. 21-2222, \u00a7 1 (part), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"fd029453-5d74-44fc-80bf-ac0dfbf5ea82","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/09ba6047-9c16-410a-b324-7480447f1741","ref":{"parent":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-232-210","docId":"75","text":"2.100.080 Registration fees.","id":"09ba6047-9c16-410a-b324-7480447f1741","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/09ba6047-9c16-410a-b324-7480447f1741\/a8f05965-90e5-442e-b71a-380481ae8dcc","ref":{"parent":"09ba6047-9c16-410a-b324-7480447f1741","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-232-210-11","docId":"75","text":"\u003Cp\u003EPersons subject to the registration requirements of this chapter shall pay an annual fee set by resolution of the City Council.\u003C\/p\u003E\u003Col class=\u0022paren-value-paren\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\u003Cli\u003EThe applicable registration fee is due at the time of registration or registration renewal. Payment will be deemed delinquent thereafter. Delinquency fees may be assessed as specified in subsection (c) of this section, if payment occurs after the due date.\u003C\/li\u003E\u003Cli\u003EIn addition to the annual fee, each registrant who is a Contract Lobbyist shall pay a fee set by resolution of the City Council per Client for whom Lobbying is undertaken for Compensation in excess of five hundred dollars ($500.00). The fees for Clients as of the date of initial registration shall be submitted with the registration. The fees for subsequent Clients shall be due and submitted within fifteen (15) days of such change with the changed information pursuant to CMC 2.100.040.\u003C\/li\u003E\u003Cli\u003EAn administrative penalty of twenty-five dollars ($25.00) per day for delinquent fees, up to a maximum of five hundred dollars ($500.00) in total penalties, will be assessed until in compliance with the registration provisions herein.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 23-2249, Att. A (part), 2023; Ord. 21-2222, \u00a7 1 (part), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"a8f05965-90e5-442e-b71a-380481ae8dcc","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/5193e895-d83e-4519-b0bf-6f2625e7af6d","ref":{"parent":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-232-211","docId":"75","text":"2.100.090 Required registration information.","id":"5193e895-d83e-4519-b0bf-6f2625e7af6d","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/5193e895-d83e-4519-b0bf-6f2625e7af6d\/a6f265a8-92fd-458b-915c-3f16e05fe374","ref":{"parent":"5193e895-d83e-4519-b0bf-6f2625e7af6d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-232-211-11","docId":"75","text":"\u003Cp\u003EThe initial registration shall contain the name, business address, telephone, email addresses and, if applicable, business license of all Persons required to register pursuant to this chapter, including the names of all owners of sole proprietorships and partnerships of fewer than ten Persons. If the registrant is a corporation, it shall also include the names of the president, secretary, chief financial officer, and agent for service of process, if any. In addition to this information, the report shall contain the following:\u003C\/p\u003E\u003Col class=\u0022paren-value-paren\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\u003Cli\u003EContract Lobbyists: The name, business address, and telephone number of each Client and the item(s) of Legislative Action or Administrative Action the Lobbyist is seeking to influence on behalf of the Client; and the name of each Person employed or retained by the Lobbyist to lobby on behalf of each Client.\u003C\/li\u003E\u003Cli\u003EOrganization Lobbyists: The names of owners, officers, or employees engaged in Lobbying on behalf of the Organization, and the item(s) of Legislative Action or Administrative Action that those owners, officers, or employees are seeking to influence.\u003C\/li\u003E\u003Cli\u003EPayment received by the reporting Lobbyist for services as a consultant or in any other capacity for services rendered to a City agency, any City Official or any City Official-elect or their controlled committees, or ballot measure committee within the previous calendar year. The dates of payment and name of each payer shall be included.\u003C\/li\u003E\u003Cli\u003EContacts made with City Officials or City Officials-elect during the preceding calendar year for the purpose of to influence Lobbying, which shall describe the matter that the Lobbyist sought to influence.\u003C\/li\u003E\u003Cli\u003EActivity Expenses such as payments that directly benefit any City Official, City Official-elect or member of his or her immediate family or domestic partner made during the preceding calendar year. Activity Expenses include Gifts, honoraria, consulting fees, salaries and other forms of Compensation, but do not include campaign contributions.\u003C\/li\u003E\u003Cli\u003EThe name, address, title and telephone number of the Person responsible for preparing the report, together with that individual\u0027s signature attesting to the authority of the signatory and the accuracy and truthfulness of the information submitted.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 23-2249, Att. A (part), 2023; Ord. 21-2222, \u00a7 1 (part), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"a6f265a8-92fd-458b-915c-3f16e05fe374","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/207d6395-89f2-4088-8b79-2817ddd115a7","ref":{"parent":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-232-212","docId":"75","text":"2.100.100 Semi-annual reports.","id":"207d6395-89f2-4088-8b79-2817ddd115a7","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/207d6395-89f2-4088-8b79-2817ddd115a7\/524d5590-b70f-48b7-9689-42f8b7f90c63","ref":{"parent":"207d6395-89f2-4088-8b79-2817ddd115a7","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-232-212-11","docId":"75","text":"\u003Cp\u003ESemi-annual reports for the prior six-month period are to be filed with the City Clerk by each Lobbyist on or before July 15th and January 15th of each year, whether or not any Lobbying activities have occurred during such period. Electronic reporting may also be permitted by the City Clerk. Each semi-annual report shall contain the same information as required to be disclosed in the initial registration, for those activities occurring in that period. If a Lobbyist has terminated all Lobbying activities during such period, the Lobbyist may file a declaration of termination with the semi-annual report. The final semi-annual report shall include disclosure of any Lobbying activities during the period of termination.\u003C\/p\u003E\u003Cp\u003E(Ord. 23-2249, Att. A (part), 2023; Ord. 21-2222, \u00a7 1 (part), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"524d5590-b70f-48b7-9689-42f8b7f90c63","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/9ad1b22a-9718-4373-8a00-8b9598e58fb0","ref":{"parent":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-232-213","docId":"75","text":"2.100.110 Records retention.","id":"9ad1b22a-9718-4373-8a00-8b9598e58fb0","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/9ad1b22a-9718-4373-8a00-8b9598e58fb0\/0cc8e17e-3c2f-4875-ba42-84ed6853b89e","ref":{"parent":"9ad1b22a-9718-4373-8a00-8b9598e58fb0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-232-213-11","docId":"75","text":"\u003Cp\u003EAll information, reports and statements required to be filed under the provisions of this chapter shall be compiled and preserved by the City pursuant to the City\u0027s records retention schedule and shall be open to public inspection. Copies of the records pertaining to the above-required reports shall be preserved by the Lobbyist for inspection and audit for a period of four years from date of production.\u003C\/p\u003E\u003Cp\u003E(Ord. 23-2249, Att. A (part), 2023; Ord. 21-2222, \u00a7 1 (part), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0cc8e17e-3c2f-4875-ba42-84ed6853b89e","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/b0610b4f-84d5-43e5-8c85-ea2d94b259b6","ref":{"parent":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-232-214","docId":"75","text":"2.100.120 Lobbyist identification.","id":"b0610b4f-84d5-43e5-8c85-ea2d94b259b6","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/b0610b4f-84d5-43e5-8c85-ea2d94b259b6\/473350af-98ec-4bb3-900a-748c31e776a3","ref":{"parent":"b0610b4f-84d5-43e5-8c85-ea2d94b259b6","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-232-214-11","docId":"75","text":"\u003Cp\u003EWhen appearing in a Lobbying capacity at any meeting with a City Official or at a public meeting of the City Council or any other City board, commission or hearing, a Contract Lobbyist shall identify themself and the Client(s) on whose behalf they are appearing, and an individual representing an individual representing an Organization Lobbyist shall identify themself and the Organization they represent.\u003C\/p\u003E\u003Cp\u003E(Ord. 23-2249, Att. A (part), 2023; Ord. 21-2222, \u00a7 1 (part), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"473350af-98ec-4bb3-900a-748c31e776a3","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/709bb4d9-98e0-40ad-b763-de010a98fae6","ref":{"parent":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-232-215","docId":"75","text":"2.100.130 Prohibitions.","id":"709bb4d9-98e0-40ad-b763-de010a98fae6","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/709bb4d9-98e0-40ad-b763-de010a98fae6\/efdf82a5-e038-4b54-b6f4-114aa7f2fa5e","ref":{"parent":"709bb4d9-98e0-40ad-b763-de010a98fae6","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-232-215-11","docId":"75","text":"\u003Cp\u003EIt shall be unlawful for any Person to knowingly or willfully (as those terms are defined in Penal Code section 7) commit any of the following acts:\u003C\/p\u003E\u003Col class=\u0022paren-value-paren\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\u003Cli\u003EActing as a Lobbyist in the City without having registered in compliance with this chapter, or knowingly to employ a Person or entity to serve as a Lobbyist when such Person is not registered pursuant to this chapter.\u003C\/li\u003E\u003Cli\u003EAttempting to evade the requirements of this chapter through indirect efforts or through the use of agents, associates, intermediaries or employees.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 23-2249, Att. A (part), 2023; Ord. 21-2222, \u00a7 1 (part), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"efdf82a5-e038-4b54-b6f4-114aa7f2fa5e","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/10868f2e-febf-46f9-8e47-07e1d1bcda79","ref":{"parent":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-232-216","docId":"75","text":"2.100.140 Gifts.","id":"10868f2e-febf-46f9-8e47-07e1d1bcda79","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/10868f2e-febf-46f9-8e47-07e1d1bcda79\/621701c0-9fab-4921-82bf-9c526543ede5","ref":{"parent":"10868f2e-febf-46f9-8e47-07e1d1bcda79","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-232-216-11","docId":"75","text":"\u003Cp\u003EIt shall be unlawful for any Lobbyist to deliver or cause to be delivered any Gift to any City Official, and for any City Official to accept any Gift from a Lobbyist. This provision shall be interpreted consistently with Government Code Section 86203.\u003C\/p\u003E\u003Cp\u003E(Ord. 23-2249, Att. A (part), 2023; Ord. 21-2222, \u00a7 1 (part), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"621701c0-9fab-4921-82bf-9c526543ede5","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/9e4a6307-867c-4129-9515-32c8a9c9d8bc","ref":{"parent":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-232-217","docId":"75","text":"2.100.150 Enforcement.","id":"9e4a6307-867c-4129-9515-32c8a9c9d8bc","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/9e4a6307-867c-4129-9515-32c8a9c9d8bc\/3a643d39-4637-4789-a990-fd2e232c85ba","ref":{"parent":"9e4a6307-867c-4129-9515-32c8a9c9d8bc","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-232-217-11","docId":"75","text":"\u003Cp\u003EPersons or entities that violate this chapter may be subject to penalties as set forth in CMC 1.10.150 and 1.12.010.\u003C\/p\u003E\u003Cp\u003E(Ord. 23-2249, Att. A (part), 2023; Ord. 21-2222, \u00a7 1 (part), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"3a643d39-4637-4789-a990-fd2e232c85ba","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/b0d01f71-ed28-433f-991a-3ddf0c9a1ec0","ref":{"parent":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-232-218","docId":"75","text":"2.100.160 Injunction.","id":"b0d01f71-ed28-433f-991a-3ddf0c9a1ec0","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/b0d01f71-ed28-433f-991a-3ddf0c9a1ec0\/20a854bc-990f-4213-b4e9-d74ad141ef5c","ref":{"parent":"b0d01f71-ed28-433f-991a-3ddf0c9a1ec0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-232-218-11","docId":"75","text":"\u003Cp\u003EThe City Attorney may seek injunctive relief in the courts to enjoin violations of or to compel compliance with the provisions of this chapter.\u003C\/p\u003E\u003Cp\u003E(Ord. 21-2222, \u00a7 1 (part), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"20a854bc-990f-4213-b4e9-d74ad141ef5c","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/e4c23dea-164b-4951-99a9-cf239decc7eb","ref":{"parent":"3715dc82-57c1-4a42-a7d0-0a2b2fdfe751","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-232-219","docId":"75","text":"2.100.170 Exemptions.","id":"e4c23dea-164b-4951-99a9-cf239decc7eb","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/3715dc82-57c1-4a42-a7d0-0a2b2fdfe751\/e4c23dea-164b-4951-99a9-cf239decc7eb\/805bc0d1-6f5e-4d2d-8704-cc2c528866c5","ref":{"parent":"e4c23dea-164b-4951-99a9-cf239decc7eb","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-232-219-11","docId":"75","text":"\u003Cp\u003EAny Person who in good faith and on reasonable grounds believes that he or she is not required to comply with the provisions of CMC 2.100.040 by reason of his or her being excluded under CMC 2.100.031 shall not be deemed to have violated the provisions of this chapter if, within fifteen (15) days after notice from the City, he or she either complies or furnishes satisfactory evidence to the City that he or she is exempt from registration.\u003C\/p\u003E\u003Cp\u003E(Ord. 23-2249, Att. A (part), 2023; Ord. 21-2222, \u00a7 1 (part), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"805bc0d1-6f5e-4d2d-8704-cc2c528866c5","prev_id":null}]}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/65d1155f-fa76-4b22-81e0-c47727648816","ref":{"parent":"b95149d7-031e-4cc1-a046-60a61417a719","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"13-233","docId":"75","text":"CHAPTER 2.110: TELECONFERENCE MEETINGS","id":"65d1155f-fa76-4b22-81e0-c47727648816","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/65d1155f-fa76-4b22-81e0-c47727648816\/8b126978-6f95-4939-a85a-98c7c281fbdf","ref":{"parent":"65d1155f-fa76-4b22-81e0-c47727648816","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-233-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"8b126978-6f95-4939-a85a-98c7c281fbdf","prev_id":null},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/65d1155f-fa76-4b22-81e0-c47727648816\/d6d8ae83-06cf-417a-bb6d-501a5f5a0e20","ref":{"parent":"65d1155f-fa76-4b22-81e0-c47727648816","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-233-12","docId":"75","text":"2.110.010 Teleconference meetings.","id":"d6d8ae83-06cf-417a-bb6d-501a5f5a0e20","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/65d1155f-fa76-4b22-81e0-c47727648816\/d6d8ae83-06cf-417a-bb6d-501a5f5a0e20\/35102eb8-62e6-4e68-854b-29b6fe705d6e","ref":{"parent":"d6d8ae83-06cf-417a-bb6d-501a5f5a0e20","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-233-12-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"35102eb8-62e6-4e68-854b-29b6fe705d6e","prev_id":null}]},{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/65d1155f-fa76-4b22-81e0-c47727648816\/22a5bc24-0573-43a6-88fe-6f61c0d8ce77","ref":{"parent":"65d1155f-fa76-4b22-81e0-c47727648816","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"13-233-13","docId":"75","text":"2.110.010 Teleconference Meetings.","id":"22a5bc24-0573-43a6-88fe-6f61c0d8ce77","children":[{"path":"\/b95149d7-031e-4cc1-a046-60a61417a719\/65d1155f-fa76-4b22-81e0-c47727648816\/22a5bc24-0573-43a6-88fe-6f61c0d8ce77\/41fc6eb7-678c-4ac4-8288-8c3e64c2f64b","ref":{"parent":"22a5bc24-0573-43a6-88fe-6f61c0d8ce77","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"13-233-13-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ENotwithstanding Section 2.04.030 or any other provision of this Title, the City Council may meet by teleconference without providing a physical meeting location if it complies with the requirements of Government Code Section 54593(e).\u003C\/li\u003E\u003Cli\u003EThe City Council may by resolution require or permit any other commission, board, or committee organized under this Title to meet by teleconference without providing a physical meeting location, provided that the requirements of Government Code Section 54593(e) are satisfied.\u003C\/li\u003E\u003Cli\u003EFor meetings where a physical location is provided, the City Council may adopt rules, policies, and procedures to allow for public access to the meeting via teleconference.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 21-2234, Att. A (\u00a7 5), 2021)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"41fc6eb7-678c-4ac4-8288-8c3e64c2f64b","prev_id":null}]}]}]}]