[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6","ref":{"name":"section"},"li_attr":{"dataTag":"section","hasChildren":1,"tag":"h2"},"pos":"19","docId":"75","text":"TITLE 8: ANIMALS","id":"04eb8158-de18-4e01-842e-004517c865c6","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/d1493cf4-934e-4531-8bdd-e1dfa557cd76","ref":{"parent":"04eb8158-de18-4e01-842e-004517c865c6","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"d1493cf4-934e-4531-8bdd-e1dfa557cd76","prev_id":null},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9","ref":{"parent":"04eb8158-de18-4e01-842e-004517c865c6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"19-12","docId":"75","text":"CHAPTER 8.01: GENERAL PROVISIONS","id":"7cafebcc-6a40-4de7-8a80-84f761cc59d9","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/ccde0af7-3b39-4939-b2c8-9c25113ecd71","ref":{"parent":"7cafebcc-6a40-4de7-8a80-84f761cc59d9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-12-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"ccde0af7-3b39-4939-b2c8-9c25113ecd71","prev_id":null},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/40c8ebfe-aa4a-43a3-b7a2-391c203c8a93","ref":{"parent":"7cafebcc-6a40-4de7-8a80-84f761cc59d9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-12-12","docId":"75","text":"8.01.010 Definitions.","id":"40c8ebfe-aa4a-43a3-b7a2-391c203c8a93","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/40c8ebfe-aa4a-43a3-b7a2-391c203c8a93\/02234df6-9fdd-43b3-b68a-b60f2e6e6647","ref":{"parent":"40c8ebfe-aa4a-43a3-b7a2-391c203c8a93","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-12-12-11","docId":"75","text":"\u003Cp style=\u0022margin-left:0px\u0022\u003EThe words and terms used in this chapter shall have the following meanings unless the context clearly indicates otherwise.\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u201cAnimal\u201d means any live vertebrate creature, domestic or wild, except fish.\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u201cAnimal control officer\u201d means any person authorized to act on behalf of the City Manager in the enforcement of this chapter, and on behalf of the County Health Officer in the enforcement of rabies control laws.\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u201cAnimal menagerie\u201d means any place where dangerous animals are kept or maintained for any purpose, including places where dangerous animals are boarded, exhibited, trained, or kept for hire.\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u201cAnimal shelter\u201d means a facility operated by a public jurisdiction or by an accredited tax-exempt humane organization for the purpose of impounding, harboring, selling, placing, or destroying seized, stray, distressed, homeless, abandoned, or unwanted animals.\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u201cCat\u201d means a domestic cat.\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u201cCommercial kennel\u201d means any person engaged in the commercial breeding of dogs and\/or cats, or both, for sale, individually or in litter lots; or in the boarding, training, sale or hire of dogs and\/or cats for compensation, except that animal hospitals maintained by a veterinarian licensed by the State of California as part of the practice of veterinary medicine, animal shelters, or private kennels shall not be considered commercial kennels.\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u201cDangerous animal\u201d means any wild, exotic, or venomous animal, or other animal which because of its size, disposition, or other characteristic would constitute a danger to persons or property.\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u201cDog\u201d means a domestic dog.\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u201cGrooming parlor\u201d means any commercial place where animals are trimmed, bathed, or groomed.\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u201cHealth officer\u201d means the director of public health or any person authorized to act on his or her behalf.\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u201cHorse establishment\u201d any person keeping three or more horses, donkeys, mules, jack, hinny, jenny burros, or ponies for any or all of the following purposes:\u003Col\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003EFor hire to be ridden or driven;\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003EFor giving riding instructions;\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003EFor boarding with compensation.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u201cOwner\u201d means any person who acknowledges ownership of an animal or who harbors or keeps an animal for five or more consecutive days.\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u201cManager or City Manager\u201d means the City Manager of Cupertino or any person authorized or designated by the City Manager to act on the City Manager\u2019s behalf.\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u201cPerson\u201d means any individual, establishment, firm, association, organization, partnership, trust, corporation, or company.\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u201cPet shop\u201d means a person who obtains animals for sale, exchange, barter, or hire to the general public as a principal or agent, or on consignment, or who holds himself or herself out to be so engaged.\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u201cPrivate kennel\u201d means a person who maintains within or adjoining his or her private residence three or more dogs over four months of age, or three or more cats over four months of age, but no more than a combined total of five dogs and cats; such animals to be for that person\u2019s recreational use or for exhibition in conformation shows, field or obedience trials and where the sale of offspring is not the primary function of the kennel. The maintenance of more than two male dogs or cats used for breeding purposes for which compensation is received, or the parturition and rearing of more than two litters of dogs or cats in any one calendar year from the total number of females owned or maintained by that person on the premises, shall be a rebuttable presumption that such animals are owned or maintained for the purposes of commercial breeding; and the owner of the premises shall be subject to the permit requirements of a commercial kennel.\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u201cQuarantine\u201d means isolation of an animal in a place and manner approved by the health officer.\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u003Cspan style=\u0022color:#ffffff\u0022\u003Eghfgh\u003C\/span\u003E\u003Col\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u201cPotentially dangerous dog\u201d means any dog, except a dog assisting a peace officer engaged in law enforcement duties, that:\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003EWithout provocation, inflicts bites on a human, or a domestic animal while on public or private property;\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003EWithout provocation, chases or approaches humans or domestic animals or livestock on the streets, sidewalks or any public grounds in a threatening manner or apparent attitude of attack;\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003EHas a known propensity, tendency or disposition for unprovoked attack, causing injury and threatening the safety of humans or domestic animals; or\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003EHas been specifically trained to guard persons and\/or property.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003E\u201cDangerous dog\u201d means any dog, except a dog assisting a peace officer engaged in law enforcement duties, that:\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-alpha\u0022\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003EHas inflicted severe injury on a human or domestic animal on public or private property; or\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003EHas, after having been designated potentially dangerous, engaged in the same behavior that resulted in that designation.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003C\/ol\u003E\u003Cp style=\u0022margin-left:0px\u0022\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp style=\u0022margin-left:0px\u0022\u003E\u003C\/p\u003E","id":"02234df6-9fdd-43b3-b68a-b60f2e6e6647","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/ba6ac6b0-f41f-4de6-8d77-231c5c164752","ref":{"parent":"7cafebcc-6a40-4de7-8a80-84f761cc59d9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-12-13","docId":"75","text":"8.01.020 Chapter Not to Regulate Use of Land.","id":"ba6ac6b0-f41f-4de6-8d77-231c5c164752","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/ba6ac6b0-f41f-4de6-8d77-231c5c164752\/2ed5036b-1ec4-468d-a5bd-8769febb24ca","ref":{"parent":"ba6ac6b0-f41f-4de6-8d77-231c5c164752","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-12-13-11","docId":"75","text":"\u003Cp\u003EThis chapter is not intended to regulate the use of land. Other provisions of the Cupertino Municipal Code regulate the number and types of animals and animal establishments that may be maintained in specific zoning districts. Nothing in this chapter is intended to supersede any provision of the City\u2019s Zoning Regulations.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"2ed5036b-1ec4-468d-a5bd-8769febb24ca","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/8f15fd46-ee53-4c2d-aae4-f5164d292018","ref":{"parent":"7cafebcc-6a40-4de7-8a80-84f761cc59d9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-12-14","docId":"75","text":"8.01.030 Animals Running at Large.","id":"8f15fd46-ee53-4c2d-aae4-f5164d292018","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/8f15fd46-ee53-4c2d-aae4-f5164d292018\/e0a73886-78a8-402d-9cbf-fd3cd5a46849","ref":{"parent":"8f15fd46-ee53-4c2d-aae4-f5164d292018","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-12-14-11","docId":"75","text":"\u003Cp\u003ENo person owning or having control of any animal shall permit such animal to stray or run at large upon any public street or other public place, or common area of any planned development, cluster, townhouse or condominium project, or upon any private property without the consent of the owner or person in control thereof. Any person who violates the provisions of this section shall be guilty of an infraction and upon conviction thereof shall be punished as provided in Chapter 1.12.\u003Cbr\u003E (Ord. 09-2041, 2009; Ord. 1886, (part), 2001; Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"e0a73886-78a8-402d-9cbf-fd3cd5a46849","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/93e42abf-4a6d-4f12-a466-516772919dd7","ref":{"parent":"7cafebcc-6a40-4de7-8a80-84f761cc59d9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-12-15","docId":"75","text":"8.01.040 Conditions Related Only to Seizures of Dogs Running at Large.","id":"93e42abf-4a6d-4f12-a466-516772919dd7","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/93e42abf-4a6d-4f12-a466-516772919dd7\/91c889d1-3d65-46dc-8911-a42e0c3a5474","ref":{"parent":"93e42abf-4a6d-4f12-a466-516772919dd7","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-12-15-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EAn animal control officer shall not seize or impound a dog for running at large in violation of Section 8.03.010 when the dog has not strayed from and is upon private property owned by the dog owner or the person who has a right to control the dog, or upon private property to which the dog owner or person who has a right to control the dog has a right of possession.\u003C\/li\u003E\u003Cli\u003EA dog that has strayed from but then returned to the private property of its owner or the person who has a right to control the dog shall not be seized or impounded merely for violation of Section 8.03.010, but in such a case a citation for such violation may be issued; provided, however, that if in such a situation, the owner or the person who has a right to control the dog is not at home, the dog may be impounded, but the officer shall post a notice of such impoundment on the front door of the living unit of the owner or person who has a right to control the dog. This notice shall state the following: that the dog has been impounded, where the dog is being held, the name, address and telephone number of the agency or person to be contacted regarding release of the dog, and an indication of the ultimate disposition of the dog if no action to regain it is taken within a specified period of time by its owner or by the person who has a right to control the dog.\u003C\/li\u003E\u003Cli\u003EThis section shall not otherwise affect the authority of an animal control officer to sell or impound a dog or issue citations as a result of the violation of Title 8 other than Section 8.01.040.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"91c889d1-3d65-46dc-8911-a42e0c3a5474","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/161e826b-1c94-4947-bae0-f9c9a10daed9","ref":{"parent":"7cafebcc-6a40-4de7-8a80-84f761cc59d9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-12-16","docId":"75","text":"8.01.050 Animal Bites, Quarantine, Violation and Examinations.","id":"161e826b-1c94-4947-bae0-f9c9a10daed9","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/161e826b-1c94-4947-bae0-f9c9a10daed9\/fd4dc69c-ef6f-4764-b4df-ccabe8fa0eb7","ref":{"parent":"161e826b-1c94-4947-bae0-f9c9a10daed9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-12-16-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EAny person having knowledge that any animal is known to have or is suspected of having bitten any person shall immediately report that fact to the animal control division or health officer with full information with regard to the incident\u003C\/li\u003E\u003Cli\u003EUpon receipt of such a report, an animal control officer will seize and quarantine such animal for a period of fourteen days or such other period as may be prescribed by the State Department of Health. The health officer may order the owner to quarantine the animal on the owner\u2019s premises.\u003C\/li\u003E\u003Cli\u003EAny person who fails, refuses or neglects to quarantine any animal as ordered by the health officer, a who refuses to allow the health officer to inspect any private premises where the animal is kept, is guilty of a misdemeanor. No animal shall be removed or released during the quarantine period without written permission of the health officer.\u003C\/li\u003E\u003Cli\u003EThe City Manager may charge a fee, as set forth in a resolution of the City Council or Board of Supervisors, for the City\u2019s and County\u2019s costs of quarantining animals and inspections for quarantine of animals. Any fee charged shall be paid by the owner or person who has legal custody of the animal. Such a fee shall be in addition to the actual costs of the health officer in housing, feeding and otherwise caring for a quarantined animal.\u003C\/li\u003E\u003Cli\u003EThe head of any animal that dies or is destroyed while under quarantine shall be submitted to the laboratory of the County Health Department for rabies examination.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"fd4dc69c-ef6f-4764-b4df-ccabe8fa0eb7","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/fe6a2720-98fc-4449-87f5-771c6a4cdeef","ref":{"parent":"7cafebcc-6a40-4de7-8a80-84f761cc59d9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-12-17","docId":"75","text":"8.01.060 Diseased Animals.","id":"fe6a2720-98fc-4449-87f5-771c6a4cdeef","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/fe6a2720-98fc-4449-87f5-771c6a4cdeef\/045a1fe4-12ef-4e7b-8f59-9403442f4a6d","ref":{"parent":"fe6a2720-98fc-4449-87f5-771c6a4cdeef","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-12-17-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe owner or person with the right to control any animal that the person knows to be infected with any disease transmittable to humans shall not permit that animal to remain within the County other than at a veterinary hospital approved by the health officer, unless the health officer expressly approves an alternate means of confinement.\u003C\/li\u003E\u003Cli\u003EThe animal control officer will seize any animal to be infected with any disease transmittable to humans. The animal control officer will keep such animal in a safe place for a period sufficient to observe examination and determined whether such animal is diseased. Animals found to be diseased may be destroyed.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"045a1fe4-12ef-4e7b-8f59-9403442f4a6d","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/bf6852f4-7f9d-47ae-a8b5-b9ac6a35de33","ref":{"parent":"7cafebcc-6a40-4de7-8a80-84f761cc59d9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-12-18","docId":"75","text":"8.01.070 Dead Animals.","id":"bf6852f4-7f9d-47ae-a8b5-b9ac6a35de33","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/bf6852f4-7f9d-47ae-a8b5-b9ac6a35de33\/38d447d6-eb7c-4a06-be61-94a5fa2898e9","ref":{"parent":"bf6852f4-7f9d-47ae-a8b5-b9ac6a35de33","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-12-18-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EUpon the death of any animal, the owner or person in charge thereof shall provide for the burial, incineration, or other disposition of the body of such animal. If the owner or person in charge of any dead animal is unable to provide for burial or other disposition, he or she may request the animal control officer to dispose of the body of such animal.\u003C\/li\u003E\u003Cli\u003EUpon learning that the body of a dead animal has not been disposed of in a safe and sanitary manner, the animal control officer will remove the animal\u2019s body immediately, provided, however, that the animal control officer shall not be required to remove and dispose of bodies of dead animals on state highways or on state property. Before disposing of the body of a dead animal, the animal control officer will give notice to the owner of the animal, if known, within seventy-two hours of the time that the dead animal is removed.\u003C\/li\u003E\u003Cli\u003EThe City Manager will collect a fee sufficient to defray the costs incident to removal and disposal of dead animals which shall be paid by the owner or person in charge thereof, if known; but no fee shall be charged to the owner or person in charge of a dead dog or cat if that person has attained the age of sixty-five years.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"38d447d6-eb7c-4a06-be61-94a5fa2898e9","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/df1e89ae-6cae-4682-8777-460f394caa20","ref":{"parent":"7cafebcc-6a40-4de7-8a80-84f761cc59d9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-12-19","docId":"75","text":"8.01.080 Abandoned Animals.","id":"df1e89ae-6cae-4682-8777-460f394caa20","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/df1e89ae-6cae-4682-8777-460f394caa20\/a6faad93-fc5d-4b35-ace6-e397b3afe751","ref":{"parent":"df1e89ae-6cae-4682-8777-460f394caa20","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-12-19-11","docId":"75","text":"\u003Cp\u003EIt is unlawful to abandon any animal in the City.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"a6faad93-fc5d-4b35-ace6-e397b3afe751","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/9fde01c0-132c-489a-8a5e-9d5a9a99c2d0","ref":{"parent":"7cafebcc-6a40-4de7-8a80-84f761cc59d9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-12-210","docId":"75","text":"8.01.090 Animals in City Buildings.","id":"9fde01c0-132c-489a-8a5e-9d5a9a99c2d0","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/9fde01c0-132c-489a-8a5e-9d5a9a99c2d0\/65578647-dbe3-4097-80ec-4b0dac459bce","ref":{"parent":"9fde01c0-132c-489a-8a5e-9d5a9a99c2d0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-12-210-11","docId":"75","text":"\u003Cp\u003ENo person having the control or care of any animal or animals shall suffer or permit any such animal to enter or remain in City-owned or managed buildings other than a building used for the purpose of care, detention, space control or treatment of animals, or a building used for training classes, shows or exhibitions, except persons who use a service animal as defined in the Americans with Disabilities Act, or persons expressly authorized by the City Manager. (Ord. 20-2214, 2020; Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"65578647-dbe3-4097-80ec-4b0dac459bce","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/e8fc7518-d318-4903-98bc-58646c308a34","ref":{"parent":"7cafebcc-6a40-4de7-8a80-84f761cc59d9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-12-211","docId":"75","text":"8.01.100 Authority of City Manager and Animal Control Officer.","id":"e8fc7518-d318-4903-98bc-58646c308a34","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/e8fc7518-d318-4903-98bc-58646c308a34\/50d0b830-0e7e-493a-a87e-74c6cc876a61","ref":{"parent":"e8fc7518-d318-4903-98bc-58646c308a34","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-12-211-11","docId":"75","text":"\u003Cp\u003EThe City Manager and animal control officer shall have the following power and authority:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ETo enforce the provisions of this title and State laws relating to the care, treatment, impounding and destruction of animals.\u003C\/li\u003E\u003Cli\u003ETo arrest any person who violates any provision of this title in the manner provided by Section 836.5 of the Penal Code.\u003C\/li\u003E\u003Cli\u003EAnimal control officer to issue citation pursuant to Section 607g of the Civil Code.\u003C\/li\u003E\u003Cli\u003ETo act as a public officer pursuant to Food and Agricultural Code Section 7.\u003C\/li\u003E\u003Cli\u003EThe City Manager may formulate rules and regulations in conformity with and for the purpose of carrying out the intent of this chapter. Such rules and regulations shall have the same force and effect as this ordinance when adopted by the City Council and any violation shall be deemed an infraction.\u003C\/li\u003E\u003Cli\u003EPursuant to Civil Code Section 607g, the City Manager may deputize as an animal control officer any humane officer of the Humane Society of Santa Clara Valley.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"50d0b830-0e7e-493a-a87e-74c6cc876a61","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/1b1db911-6e77-4ab3-9df6-36984c19785b","ref":{"parent":"7cafebcc-6a40-4de7-8a80-84f761cc59d9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-12-212","docId":"75","text":"8.01.110 Inspection by Animal Control Officer.","id":"1b1db911-6e77-4ab3-9df6-36984c19785b","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/1b1db911-6e77-4ab3-9df6-36984c19785b\/b76911c4-3280-46a8-bf06-945168ee9ff4","ref":{"parent":"1b1db911-6e77-4ab3-9df6-36984c19785b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-12-212-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe City Manager and\/or an animal control officer shall have the power to enter upon and inspect any premises where any animal is kept or harbored when such entry is necessary to enforce the provisions of this chapter. An inspection or search warrant will be obtained whenever required by law.\u003C\/li\u003E\u003Cli\u003EThis entry and inspection will be made only. after the occupant of the premises, if any, has been given written or oral notice of the inspection by the City Manager and\/or an animal control officer. If the land is unoccupied, the City Manager and\/or animal control officer will make a reasonable effort to locate the owner or other person having control of the property before making entry.\u003C\/li\u003E\u003Cli\u003ENotwithstanding the foregoing, if the City Manager and\/or an animal control officer has reasonable cause to believe the keeping or maintaining of any animal is so hazardous as to require an immediate inspection to save the animal or protect public health or safety, the City Manager and\/or animal control officer shall have the power to immediately enter and inspect the property with the use of reasonable force. If the property is occupied in such a circumstance, the City Manager and\/or an animal control officer will first attempt to notify the occupant and demand entry. Failure or refusal to permit such an inspection constitutes a misdemeanor.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"b76911c4-3280-46a8-bf06-945168ee9ff4","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/d2902275-4e59-4828-aa62-06380e6f8d74","ref":{"parent":"7cafebcc-6a40-4de7-8a80-84f761cc59d9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-12-213","docId":"75","text":"8.01.120 Poisoning and Abusing Dogs, Cats or Other Domestic Animals.","id":"d2902275-4e59-4828-aa62-06380e6f8d74","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/d2902275-4e59-4828-aa62-06380e6f8d74\/fd7f752d-d31d-4c06-a502-05b598500416","ref":{"parent":"d2902275-4e59-4828-aa62-06380e6f8d74","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-12-213-11","docId":"75","text":"\u003Cp\u003EIn addition to Penal Code Section 596, it shall be unlawful for any person to willfully administer poison to any dog, cat, or other domestic animal or to willfully place, expose or leave poisonous or harmful substances of any kind in any place with intent to injure or kill any dog, cat, or other domestic animal. Further, it shall be unlawful for any person to maliciously kill, maim, wound, mutilate, torment, torture, or physically abuse any animal.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"fd7f752d-d31d-4c06-a502-05b598500416","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/d01cf9da-7ddc-48f3-a2d9-e80675f344e7","ref":{"parent":"7cafebcc-6a40-4de7-8a80-84f761cc59d9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-12-214","docId":"75","text":"8.01.130 Public Nuisance.","id":"d01cf9da-7ddc-48f3-a2d9-e80675f344e7","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/d01cf9da-7ddc-48f3-a2d9-e80675f344e7\/a9384fb2-9c35-4f88-a4ec-7709747c71ba","ref":{"parent":"d01cf9da-7ddc-48f3-a2d9-e80675f344e7","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-12-214-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ENo person owning or having control of any animal shall permit the animal to do any of the following:\u003Col\u003E\u003Cli\u003EDefecate or urinate on private property (other than that of the owner or the person having control of the animal;\u003C\/li\u003E\u003Cli\u003EDefecate on public property without immediately removing the excrement to a proper receptacle;\u003C\/li\u003E\u003Cli\u003EPermit an animal to obstruct or interfere with the reasonable and comfortable use of property by chasing vehicles, molesting passersby, barking, howling, baying, or making any other noise;\u003C\/li\u003E\u003Cli\u003EPermit unsanitary conditions to exist on the premises where that animal is kept that would cause odors, attract flies or vermin, or otherwise be injurious to public health and safety, or be indecent, or offensive to the senses, or be such an obstruction to the free use of property so as to interfere with the comfortable enjoyment of life or property by other persons.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EThe animal control officer may seize and impound any animal causing or creating a public nuisance.\u003C\/li\u003E\u003Cli\u003EA violation of this section is hereby declared to be a public nuisance.\u003C\/li\u003E\u003Cli\u003EAny private person may maintain an action under Civil Code Section 3493 for enforcement of this section declaring certain acts a public nuisance, if such acts are specifically injurious to that person. Any person who violates the provisions of this section shall be guilty of an infraction and upon conviction thereof shall be punished as provided in Chapter 1.12.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 09-2041, 2009; Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"a9384fb2-9c35-4f88-a4ec-7709747c71ba","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/ebf98dd6-381a-4481-88d4-08b2491d44bd","ref":{"parent":"7cafebcc-6a40-4de7-8a80-84f761cc59d9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-12-215","docId":"75","text":"8.01.140 Animals and Vehicles.","id":"ebf98dd6-381a-4481-88d4-08b2491d44bd","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/ebf98dd6-381a-4481-88d4-08b2491d44bd\/0473bfa7-2350-4894-b619-b61a9295c1be","ref":{"parent":"ebf98dd6-381a-4481-88d4-08b2491d44bd","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-12-215-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EOther than an individual then actually in the process of working a dog or other animal for ranching purposes, no person shall transport or carry an animal in a motor vehicle, unless the animal is safely enclosed within the vehicle by means of a container, cage, or other device that will prevent the animal from falling from, jumping from, or being thrown from the motor vehicle.\u003C\/li\u003E\u003Cli\u003ENo person shall leave any dog or other animal in an unattended motor vehicle without adequate ventilation or in such a manner as to subject the animal to extreme temperatures that may adversely affect the health or well-being of the animal.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0473bfa7-2350-4894-b619-b61a9295c1be","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/3d12d8f2-ba77-4949-b826-1ec612761b3e","ref":{"parent":"7cafebcc-6a40-4de7-8a80-84f761cc59d9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-12-216","docId":"75","text":"8.01.150 Reserved.","id":"3d12d8f2-ba77-4949-b826-1ec612761b3e","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/3d12d8f2-ba77-4949-b826-1ec612761b3e\/2271f68a-ca79-41a1-81e3-afc4f1978554","ref":{"parent":"3d12d8f2-ba77-4949-b826-1ec612761b3e","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-12-216-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"2271f68a-ca79-41a1-81e3-afc4f1978554","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/cee9fb3f-e473-4dd2-a2d4-d486c19ca3e1","ref":{"parent":"7cafebcc-6a40-4de7-8a80-84f761cc59d9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-12-217","docId":"75","text":"8.01.160 Use of Steel Traps in Urban Service Areas Prohibited.","id":"cee9fb3f-e473-4dd2-a2d4-d486c19ca3e1","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/cee9fb3f-e473-4dd2-a2d4-d486c19ca3e1\/224db8ee-aacd-4b71-9c07-c29e3fe733c5","ref":{"parent":"cee9fb3f-e473-4dd2-a2d4-d486c19ca3e1","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-12-217-11","docId":"75","text":"\u003Cp\u003ENo person shall use a leg-hold steel jawed trap, steel jawed trap, or steel leg-hold trap, as defined in Fish and Game Code Section 4004, in any urban service area boundary, as defined in Government Code Section 56080.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"224db8ee-aacd-4b71-9c07-c29e3fe733c5","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/cd9f819e-a9ed-43cf-b4f5-c0db3b6e44f5","ref":{"parent":"7cafebcc-6a40-4de7-8a80-84f761cc59d9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-12-218","docId":"75","text":"8.01.170 Penalty.","id":"cd9f819e-a9ed-43cf-b4f5-c0db3b6e44f5","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7cafebcc-6a40-4de7-8a80-84f761cc59d9\/cd9f819e-a9ed-43cf-b4f5-c0db3b6e44f5\/6fcd6436-6513-47ff-945a-88930e2ae106","ref":{"parent":"cd9f819e-a9ed-43cf-b4f5-c0db3b6e44f5","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-12-218-11","docId":"75","text":"\u003Cp\u003EExcept where otherwise specified, any person who violates any of the provisions of this chapter shall be guilty of a misdemeanor and, upon conviction thereof, shall be punished as provided in Chapter 1.12.\u003Cbr\u003E (Ord. 1886, (part), 2001)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"6fcd6436-6513-47ff-945a-88930e2ae106","prev_id":null}]}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9","ref":{"parent":"04eb8158-de18-4e01-842e-004517c865c6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"19-13","docId":"75","text":"CHAPTER 8.02: IMPOUNDMENT OF ANIMALS","id":"ef565f9d-a247-40d6-96c6-c04f265e52c9","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/574dd4c1-bf47-4328-bf21-7fbbd3ab5aaa","ref":{"parent":"ef565f9d-a247-40d6-96c6-c04f265e52c9","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-13-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"574dd4c1-bf47-4328-bf21-7fbbd3ab5aaa","prev_id":null},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/15414773-df09-4d1e-97cf-cf73745f5137","ref":{"parent":"ef565f9d-a247-40d6-96c6-c04f265e52c9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-13-12","docId":"75","text":"8.02.010 Fees for Impounding and Keeping.","id":"15414773-df09-4d1e-97cf-cf73745f5137","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/15414773-df09-4d1e-97cf-cf73745f5137\/a4616a6c-1581-4cfb-a6ee-285705f510f5","ref":{"parent":"15414773-df09-4d1e-97cf-cf73745f5137","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-13-12-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EAn impoundment fee shall be charged to the owner of animal impounded, in an amount fixed by resolution of the City Council.\u003C\/li\u003E\u003Cli\u003EIn addition, a fee for keeping an impounded animal shall be charged in an amount sufficient to defray the costs of keeping the animal, as determined by the City Manager.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"a4616a6c-1581-4cfb-a6ee-285705f510f5","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/5ba1e856-3177-4d76-8f3c-65d32130bf64","ref":{"parent":"ef565f9d-a247-40d6-96c6-c04f265e52c9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-13-13","docId":"75","text":"8.02.020 Redemption of Impounded Animals.","id":"5ba1e856-3177-4d76-8f3c-65d32130bf64","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/5ba1e856-3177-4d76-8f3c-65d32130bf64\/fb00038a-1dce-455e-94cf-a5f47df65a1c","ref":{"parent":"5ba1e856-3177-4d76-8f3c-65d32130bf64","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-13-13-11","docId":"75","text":"\u003Cp\u003EThe City Manager or animal control officer may permit an owner or other person entitled to custody of an impounded animal to redeem the animal. No animal may be redeemed without payment of the fees for impounding and keeping the animal, and without compliance with the licensing provision of this chapter.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"fb00038a-1dce-455e-94cf-a5f47df65a1c","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/3f7848dc-b44f-4cd0-9054-21f2e9a98b15","ref":{"parent":"ef565f9d-a247-40d6-96c6-c04f265e52c9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-13-14","docId":"75","text":"8.02.030 Notification of Impoundment.","id":"3f7848dc-b44f-4cd0-9054-21f2e9a98b15","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/3f7848dc-b44f-4cd0-9054-21f2e9a98b15\/47edd1b1-cb1d-4462-87df-781077149b98","ref":{"parent":"3f7848dc-b44f-4cd0-9054-21f2e9a98b15","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-13-14-11","docId":"75","text":"\u003Cp\u003EThe animal control officer shall give notice of impoundment to the owner of every animal impounded, if he or she is known.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"47edd1b1-cb1d-4462-87df-781077149b98","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/0ede9295-fb83-40d7-9f7f-85b24bc5e388","ref":{"parent":"ef565f9d-a247-40d6-96c6-c04f265e52c9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-13-15","docId":"75","text":"8.02.040 Disposition of Impounded Animals.","id":"0ede9295-fb83-40d7-9f7f-85b24bc5e388","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/0ede9295-fb83-40d7-9f7f-85b24bc5e388\/49187064-8399-4641-a620-36c687960198","ref":{"parent":"0ede9295-fb83-40d7-9f7f-85b24bc5e388","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-13-15-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ENo animal may be disposed of until seventy-two hours have elapsed from the time of impoundment, exclusive of the day of impoundment and the days that the impounding facility is closed to the public.\u003C\/li\u003E\u003Cli\u003ENotwithstanding anything to the contrary, an animal which has been determined by a veterinarian licensed by the State of California or by other authorized personnel to be diseased or injured to the extent that emergency veterinary care will not alleviate intense suffering will be destroyed in accordance with all State and County humane laws as soon as possible.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"49187064-8399-4641-a620-36c687960198","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/ae191dca-e34b-4005-8c0d-df485ec20cd5","ref":{"parent":"ef565f9d-a247-40d6-96c6-c04f265e52c9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-13-16","docId":"75","text":"8.02.050 Reserved.","id":"ae191dca-e34b-4005-8c0d-df485ec20cd5","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/ae191dca-e34b-4005-8c0d-df485ec20cd5\/8005f297-779d-4705-aae4-785f4e8cceae","ref":{"parent":"ae191dca-e34b-4005-8c0d-df485ec20cd5","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-13-16-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"8005f297-779d-4705-aae4-785f4e8cceae","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/362ef024-1d1f-4d4b-bb70-92ef7ebb82eb","ref":{"parent":"ef565f9d-a247-40d6-96c6-c04f265e52c9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-13-17","docId":"75","text":"8.02.060 Summary Seizure and Post-seizure Hearing.","id":"362ef024-1d1f-4d4b-bb70-92ef7ebb82eb","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/362ef024-1d1f-4d4b-bb70-92ef7ebb82eb\/8b80e64b-03ef-4ee1-8efd-9eccff62be0b","ref":{"parent":"362ef024-1d1f-4d4b-bb70-92ef7ebb82eb","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-13-17-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EExcept as provided in Section 8.01.040, an animal control officer may seize and impound an animal for violation of any provision of this title or State law prior to a hearing in any of the following situations where the owner is not present and where the officer reasonably believes it is necessary:\u003Col\u003E\u003Cli\u003ETo protect health, safety and property; or\u003C\/li\u003E\u003Cli\u003ETo protect an animal that is injured, sick, or starving and should be cared for.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EEven when the person owning or having the right to control any animal is present, an animal control officer may seize or impound any animal that the officer reasonably believes to be infected with disease transmittable to humans or to be potentially dangerous or dangerous so as to be a threat to public health, safety or property. Such seizure or impoundment may be made even though the animal is confined at the time of the seizure or impoundment.\u003C\/li\u003E\u003Cli\u003EIf the owner or person with the right to control the animal wishes to challenge the seizure or impoundment, he or she shall so advise the City Manager, in writing, within seventy-two hours after the seizure or impoundment.\u003C\/li\u003E\u003Cli\u003EThe City Manager will promptly set the time and place for the hearing and will cause notice of such hearing to be mailed to the requesting party no later than five days before the hearing.\u003C\/li\u003E\u003Cli\u003EThe hearing will be conducted as set forth in Section 8.02.080.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"8b80e64b-03ef-4ee1-8efd-9eccff62be0b","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/06052ea8-413f-4589-9da4-58be7237fe0d","ref":{"parent":"ef565f9d-a247-40d6-96c6-c04f265e52c9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-13-18","docId":"75","text":"8.02.070 Hearing Prior to Animal Deprivation.","id":"06052ea8-413f-4589-9da4-58be7237fe0d","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/06052ea8-413f-4589-9da4-58be7237fe0d\/7742d7b9-e5b7-4383-ba4e-388c9baf7171","ref":{"parent":"06052ea8-413f-4589-9da4-58be7237fe0d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-13-18-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EExcept as provided in Section 8.02.060, the City Manager or animal control officer may not seize or impound any animal, without the consent of the owner or person entitled to custody of the animal, unless a post-seizure appeal hearing is scheduled and held as set forth in Section 8.02.080.\u003C\/li\u003E\u003Cli\u003EIf the owner or person who has a right to control an animal refuses to consent to an impoundment of his or her animal, the animal control officer may issue a notice commanding the person to appear before the City Manager at a set time. Failure of a person to appear at the hearing may result in the animal control officer immediately seizing and impounding the animal.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"7742d7b9-e5b7-4383-ba4e-388c9baf7171","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/1ec001be-b703-4e1c-add0-96f7002e99dd","ref":{"parent":"ef565f9d-a247-40d6-96c6-c04f265e52c9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-13-19","docId":"75","text":"8.02.080 Appeal Hearing.","id":"1ec001be-b703-4e1c-add0-96f7002e99dd","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/1ec001be-b703-4e1c-add0-96f7002e99dd\/fb79b1b2-4543-4b80-912d-134d7eed3a03","ref":{"parent":"1ec001be-b703-4e1c-add0-96f7002e99dd","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-13-19-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EAt the appeal hearing, the petitioner and the City may be represented by counsel, may present oral and written evidence, and may cross-examine witnesses. Technical rules of evidence shall not apply. Any relevant evidence may be admitted as determined by the hearing officer.\u003C\/li\u003E\u003Cli\u003EAfter submission of all the evidence, and not more than fifteen days after the hearing, the City Manager may order the animal released without conditions, may designate the animal potentially dangerous or dangerous and order release with conditions, may order the animal destroyed, or may make other orders as the Manager determines appropriately fulfills the needs of the animal and the safety of the public based on the weight of the evidence. The decision of the City Manager shall be final. Any release conditions imposed by the City Manager, which may include but shall not be limited to spaying and neutering, shall be solely in the interest of protecting public health, safety, and property.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"fb79b1b2-4543-4b80-912d-134d7eed3a03","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/3f23ca8e-6a89-4dbc-9379-b6cb2777b653","ref":{"parent":"ef565f9d-a247-40d6-96c6-c04f265e52c9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-13-210","docId":"75","text":"8.02.090 Failure to Appeal Impoundment.","id":"3f23ca8e-6a89-4dbc-9379-b6cb2777b653","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/3f23ca8e-6a89-4dbc-9379-b6cb2777b653\/c813e332-c69e-4ab6-8967-56352e81ec88","ref":{"parent":"3f23ca8e-6a89-4dbc-9379-b6cb2777b653","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-13-210-11","docId":"75","text":"\u003Cp\u003EAny person who fails to appeal any seizure or impoundment by the animal control officer under this chapter within seventy-two hours from impoundment as specified in Section 8.02.060 shall forfeit all rights of ownership and control of the animal. All rights of ownership and control shall be transferred to the City. Final disposition of the animal shall be determined in accordance with the provisions of this title and State law.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"c813e332-c69e-4ab6-8967-56352e81ec88","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/c12a8754-bc64-4f85-ada3-681ac14a239c","ref":{"parent":"ef565f9d-a247-40d6-96c6-c04f265e52c9","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-13-211","docId":"75","text":"8.02.100 Adoption of Animals.","id":"c12a8754-bc64-4f85-ada3-681ac14a239c","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/ef565f9d-a247-40d6-96c6-c04f265e52c9\/c12a8754-bc64-4f85-ada3-681ac14a239c\/b3d14e46-2e97-4a42-ab47-4e759fbf6d30","ref":{"parent":"c12a8754-bc64-4f85-ada3-681ac14a239c","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-13-211-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EAny person adopting an unspayed or unneutered dog or cat from any humane society animal shelter, public pound or society for the prevention of cruelty to animals shelter in the County of Santa Clara shall have the animal spayed or neutered on or before a date specified in the adoption agreement unless a licensed veterinarian states in writing that the date specified in the adoption agreement is inappropriate for the animal in question. On submission of such written statement to the person at such shelter or pound responsible for ensuring compliance with this section, the adoption agreement will be modified accordingly.\u003C\/li\u003E\u003Cli\u003EAs a condition for adoption, the person adopting an animal may be required to deposit with the pound or shelter an amount sufficient to cover the cost of spaying or neutering such animal by a veterinarian or spaying or altering clinic designated by the person adopting the animal. The deposit shall be forwarded to the veterinarian or clinic upon receipt by the pound or shelter of a notice from the veterinarian or clinic that the cat or dog has been spayed or neutered.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E","id":"b3d14e46-2e97-4a42-ab47-4e759fbf6d30","prev_id":null}]}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd","ref":{"parent":"04eb8158-de18-4e01-842e-004517c865c6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"19-14","docId":"75","text":"CHAPTER 8.03: DOGS AND CATS","id":"3345addc-d769-48c2-970f-ab72eafee3dd","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/d5bb603d-dbf8-4c7f-9b3f-a23b6ee6eb47","ref":{"parent":"3345addc-d769-48c2-970f-ab72eafee3dd","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-14-11","docId":"75","text":"8.03.010 Restraint of Dogs.","id":"d5bb603d-dbf8-4c7f-9b3f-a23b6ee6eb47","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/d5bb603d-dbf8-4c7f-9b3f-a23b6ee6eb47\/efa30860-8fd6-4776-832c-086e46107ee0","ref":{"parent":"d5bb603d-dbf8-4c7f-9b3f-a23b6ee6eb47","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-14-11-11","docId":"75","text":"\u003Cp\u003EThe owner or person with the right to control any dog shall keep such dog under his or her own physical restraint by means of a leash or shall keep such dog confined behind a fence not less than six feet high except for any of the following:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EGuide dogs for the blind or deaf while performing their duties;\u003C\/li\u003E\u003Cli\u003EDogs participating in field or obedience trials or conformation exhibitions;\u003C\/li\u003E\u003Cli\u003EDogs assisting their owner\/handler in legal hunting activities or in the herding of livestock;\u003C\/li\u003E\u003Cli\u003EDogs assisting a security guard or assisting a peace officer engaged in law enforcement activities;\u003C\/li\u003E\u003Cli\u003EDogs assisting in search and rescue activities;\u003C\/li\u003E\u003Cli\u003EDogs participating in City- authorized events or programs; and\u003C\/li\u003E\u003Cli\u003EDogs being trained for any of the above described purposes on private property with the permission of the landowner, so long as these dogs are under the direct control of the trainer\/handler. Any person who violates the provisions of this section shall be guilty of an infraction and upon conviction thereof shall be punished as provided in Chapter 1.12.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 13-2105, \u00a7 1, 2013; Ord. 09-2041, 2009; Ord. 1886, (part), 2001; Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"efa30860-8fd6-4776-832c-086e46107ee0","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/7170e15c-058f-4e92-9899-35bb459d5e9c","ref":{"parent":"3345addc-d769-48c2-970f-ab72eafee3dd","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-14-12","docId":"75","text":"8.03.020 Maximum Number of Dogs, Cats or Litters.","id":"7170e15c-058f-4e92-9899-35bb459d5e9c","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/7170e15c-058f-4e92-9899-35bb459d5e9c\/613e0368-fb5b-4302-bc3d-7c65e9d5e70d","ref":{"parent":"7170e15c-058f-4e92-9899-35bb459d5e9c","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-14-12-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ENo person shall keep or maintain more than two dogs over four months of age. No person shall keep or maintain more than three cats over four months of age. In no event shall there be more than one unspayed cat over four months old and one unspayed dog over four months of age on any premises. This restriction shall not apply to premises maintained by a veterinarian licensed by the State of California for the practice of veterinary medicine or premises with a valid permit from the City Manager for a private kennel, commercial kennel, pet shop, animal menagerie, or animal shelter. A female dog or cat shall be rebuttably presumed to be unspayed unless the owner provides evidence of spaying. Written certification from a licensed veterinarian that an animal cannot be spayed for health reasons or is incapable of breeding shall be deemed a satisfactory substitution for a certificate showing an animal is spayed.\u003C\/li\u003E\u003Cli\u003ENo person shall allow the parturition and rearing of more than one litter of dogs or cats in any one calendar year from females owned by him or her or maintained on his or her premises without a valid permit from the City Manager for a private kennel, commercial kennel, or animal shelter.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"613e0368-fb5b-4302-bc3d-7c65e9d5e70d","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/b9336ffa-96df-463d-92d6-e9228e3be83c","ref":{"parent":"3345addc-d769-48c2-970f-ab72eafee3dd","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-14-13","docId":"75","text":"8.03.030 Vaccination of Dogs and Cats.","id":"b9336ffa-96df-463d-92d6-e9228e3be83c","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/b9336ffa-96df-463d-92d6-e9228e3be83c\/b5cf3606-22df-4284-bb6a-c31bd6f82730","ref":{"parent":"b9336ffa-96df-463d-92d6-e9228e3be83c","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-14-13-11","docId":"75","text":"\u003Cp\u003EEvery owner of a dog or a cat over four months of age shall cause such dog or cat to be vaccinated with an anti-rabies vaccine approved by the State Department of Public Health. Revaccination shall be made at such intervals of time as may be prescribed by the State Department of Public Health. Compliance with the provision of this section shall be a condition to the issuance or renewal of dog and cat licenses.\u003Cbr\u003E (Ord. 1886, (part), 2001; Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"b5cf3606-22df-4284-bb6a-c31bd6f82730","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/22d1c4aa-8440-4ebe-bc9c-4c44531d62e3","ref":{"parent":"3345addc-d769-48c2-970f-ab72eafee3dd","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-14-14","docId":"75","text":"8.03.035 Keeping of Dangerous and Potentially Dangerous Dogs.","id":"22d1c4aa-8440-4ebe-bc9c-4c44531d62e3","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/22d1c4aa-8440-4ebe-bc9c-4c44531d62e3\/f7c158eb-ea6d-4481-80ff-3d09372b9fcd","ref":{"parent":"22d1c4aa-8440-4ebe-bc9c-4c44531d62e3","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-14-14-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe owner or person with the right to control any dangerous or potentially dangerous dog shall:\u003Col\u003E\u003Cli\u003EKeep the dog under his or her own physical restraint and control by means of a leash not to exceed six feet in length. In addition, a dangerous dog must be muzzled; and\u003C\/li\u003E\u003Cli\u003EPost a sign advising of the presence of a dangerous or potentially dangerous dog at the entrance to every place where any such dog is confined. The sign shall be capable of being understood by a child with the normal reading skills of a second grader.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EIn addition to subsection (A) of this section, the owner or person with the right to control a dangerous dog shall:\u003Col\u003E\u003Cli\u003EMaintain for the dog an enclosed and locked pen or kennel having secured sides and a secured top attached to the sides, and having a secure bottom or floor attached to the sides, or with the sides embedded not less than two feet into the ground, behind a fence not less than six feet high, except where the dangerous dog is kept in an apartment or condominium; and\u003C\/li\u003E\u003Cli\u003EEnsure that when the dog is in a house, apartment, building or similar structure, that the windows and doors of same are secured to prevent the dog from exiting without the assistance of the owner or person with the right to control such dog.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1886, (part), 2001)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f7c158eb-ea6d-4481-80ff-3d09372b9fcd","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/a7ecaac1-ff35-40d2-aaa9-46aa2fc3897c","ref":{"parent":"3345addc-d769-48c2-970f-ab72eafee3dd","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-14-15","docId":"75","text":"8.03.040 Registration of Dangerous Dogs.","id":"a7ecaac1-ff35-40d2-aaa9-46aa2fc3897c","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/a7ecaac1-ff35-40d2-aaa9-46aa2fc3897c\/bbf8a6e4-0642-42e8-9845-bf8f33ead567","ref":{"parent":"a7ecaac1-ff35-40d2-aaa9-46aa2fc3897c","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-14-15-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EEvery owner of a dangerous dog over four months of age shall register such dog with the City Manager. Such registration shall be renewed on an annual basis. A registration fee, and a fee to be charged for multiple inspections of required confinement facilities for such dogs, shall be fixed by resolution of the City Council.\u003C\/li\u003E\u003Cli\u003EEvery owner of a dangerous dog over four months of age shall obtain a public liability insurance policy from an insurer licensed to practice in the State of California, a single-incident amount of not less than fifty thousand dollars. Such owner shall give written notice to the City Manager of any cancellation or material change in such policy at least thirty days prior to the date of such cancellation or material change.\u003C\/li\u003E\u003Cli\u003EOwners of dangerous dogs unable to meet the requirements of subsection or A or B of this section, shall surrender the dogs to the City Manager for humane destruction or other disposition, by discretion of the City Manager.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1886, (part), 2001; Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"bbf8a6e4-0642-42e8-9845-bf8f33ead567","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/717c13a9-e159-4983-a3e3-f095adb450bf","ref":{"parent":"3345addc-d769-48c2-970f-ab72eafee3dd","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-14-16","docId":"75","text":"8.03.050 License Required.","id":"717c13a9-e159-4983-a3e3-f095adb450bf","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/717c13a9-e159-4983-a3e3-f095adb450bf\/9f530141-afd4-4a6e-8a1b-361c2377c862","ref":{"parent":"717c13a9-e159-4983-a3e3-f095adb450bf","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-14-16-11","docId":"75","text":"\u003Cp\u003ENo person shall maintain or board any dog or cat four months of age or older that has not been licensed pursuant to the provisions of this title, except:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EA license shall not be required for an animal owned or under the control of a nonresident of the City, and that is to be kept in the City for less than thirty days in any twelve-month period.\u003C\/li\u003E\u003Cli\u003EA license shall not be required for dogs or cats temporarily brought into the City for entry into an event, show, or exhibition scheduled not more than ten days thereafter.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"9f530141-afd4-4a6e-8a1b-361c2377c862","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/3b9dd358-29a8-4515-a022-9989e133d403","ref":{"parent":"3345addc-d769-48c2-970f-ab72eafee3dd","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-14-17","docId":"75","text":"8.03.060 License Fees.","id":"3b9dd358-29a8-4515-a022-9989e133d403","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/3b9dd358-29a8-4515-a022-9989e133d403\/45b9c1cf-1759-42dd-909c-3b1704d760ee","ref":{"parent":"3b9dd358-29a8-4515-a022-9989e133d403","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-14-17-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ELicense fees for each dog or cat within the City, including reduced fees for spayed females or neutered males, shall be fixed by resolution of the City Council. Dog and cat license fees shall not be refundable.\u003C\/li\u003E\u003Cli\u003EThe City Manager may require the submission of a certificate of a licensed veterinarian stating that a dog or cat has been spayed or neutered, or cannot be spayed or neutered for health reasons and is incapable of breeding, or is biologically incapable of breeding, prior to issuance of a license of a lesser fee.\u003C\/li\u003E\u003Cli\u003EA late fee may be charged in accordance with other fees and charges adopted by resolution.\u003C\/li\u003E\u003Cli\u003ELicenses and tags for dogs used principally for the purpose of guiding persons who are blind or deaf, and for dogs used in law enforcement by governmental agencies shall be issued upon request without charge.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"45b9c1cf-1759-42dd-909c-3b1704d760ee","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/fb83baaf-aaad-40d6-be3b-bfc5a9c314d3","ref":{"parent":"3345addc-d769-48c2-970f-ab72eafee3dd","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-14-18","docId":"75","text":"8.03.070 Issuance of License.","id":"fb83baaf-aaad-40d6-be3b-bfc5a9c314d3","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/fb83baaf-aaad-40d6-be3b-bfc5a9c314d3\/0ececbec-0e51-4e84-b6e5-87b3a09073bb","ref":{"parent":"fb83baaf-aaad-40d6-be3b-bfc5a9c314d3","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-14-18-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EUpon payment of the license fee, presentation of a valid certificate of vaccination by a duly licensed doctor of veterinary medicine and when required, presentation of a dangerous dog registration and a valid certificate of public liability insurance from an insurer licensed to practice in the State of California, the City Manager will issue a license stating the name and residence of the person to whom the license is issued, the amount paid, the date of issuance thereof, the date of expiration of the vaccination, the date of expiration of the dangerous dog registration, the date of expiration of the public liability insurance, and a description of the dog or cat for which the license is issued, together with the number of the metallic tag accompanying the same.\u003C\/li\u003E\u003Cli\u003EOwners of dangerous dogs shall notify the City Manager, in writing, of any changes of address within fourteen days of the date of such change.\u003C\/li\u003E\u003Cli\u003ENotwithstanding subsection A of this section, the Manager, in the Manager\u2019s discretion, may refuse to issue or renew a license for a period of not more than two years when such refusal is deemed reasonably necessary to protect public health, safety and property.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0ececbec-0e51-4e84-b6e5-87b3a09073bb","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/5d742801-3d47-487c-b0d0-de409da29aba","ref":{"parent":"3345addc-d769-48c2-970f-ab72eafee3dd","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-14-19","docId":"75","text":"8.03.080 Metal Tags.","id":"5d742801-3d47-487c-b0d0-de409da29aba","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/5d742801-3d47-487c-b0d0-de409da29aba\/adbf378d-2ec9-4091-a2f8-8a3b0c93d64d","ref":{"parent":"5d742801-3d47-487c-b0d0-de409da29aba","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-14-19-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EWith each dog or. cat license, the City Manager will issue a metal tag bearing an identifying number. Each dog or cat shall wear the metal tag issued for it at all times except when being shown at a dog or cat show, exhibition or event or when it is in a fully enclosed structure in the owners premises. In the event it is necessary to issue a duplicate tag, a fee set by the City Council shall be charged to the owner.\u003C\/li\u003E\u003Cli\u003EIt shall be unlawful for any person to attach a metal tag issued pursuant to this section to any dog or cat other than the dog or cat for which it is issued.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"adbf378d-2ec9-4091-a2f8-8a3b0c93d64d","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/a6a35268-0214-4f97-8138-c551f815d0a0","ref":{"parent":"3345addc-d769-48c2-970f-ab72eafee3dd","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-14-210","docId":"75","text":"8.03.090 License Period.","id":"a6a35268-0214-4f97-8138-c551f815d0a0","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/a6a35268-0214-4f97-8138-c551f815d0a0\/64ff5a69-15c0-46b1-93f7-a076af53f21f","ref":{"parent":"a6a35268-0214-4f97-8138-c551f815d0a0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-14-210-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe term of any dog or cat license issued hereunder shall commence on the date of the issuance of the license and shall terminate six months or twelve months or twenty-four months from the date or thirty-six months from date of issue dependent on license fee and or vaccination status tendered.\u003C\/li\u003E\u003Cli\u003EDog and cat licenses shall be renewed upon expiration. When a license is renewed after the expiration date, the new license period shall begin on the expiration date of the previous period.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"64ff5a69-15c0-46b1-93f7-a076af53f21f","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/266469d3-59ee-479f-877e-5b7a0cbe5325","ref":{"parent":"3345addc-d769-48c2-970f-ab72eafee3dd","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-14-211","docId":"75","text":"8.03.100 Record of Licenses.","id":"266469d3-59ee-479f-877e-5b7a0cbe5325","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/266469d3-59ee-479f-877e-5b7a0cbe5325\/506c2108-8f72-4dda-b99a-ce58389c6e6a","ref":{"parent":"266469d3-59ee-479f-877e-5b7a0cbe5325","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-14-211-11","docId":"75","text":"\u003Cp\u003EThe City Manager will keep a record of all licenses issued by him or her, together with a description of the dog or cat for which such license is issued.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"506c2108-8f72-4dda-b99a-ce58389c6e6a","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/024fc43a-f331-43cd-a5a1-629616cdcefc","ref":{"parent":"3345addc-d769-48c2-970f-ab72eafee3dd","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-14-212","docId":"75","text":"8.03.110 Presentation of License on Request.","id":"024fc43a-f331-43cd-a5a1-629616cdcefc","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/024fc43a-f331-43cd-a5a1-629616cdcefc\/9a863d75-53d9-4289-9c15-a36dbe793550","ref":{"parent":"024fc43a-f331-43cd-a5a1-629616cdcefc","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-14-212-11","docId":"75","text":"\u003Cp\u003EUpon request of any authorized animal control employee or any peace officer, the owner or person having control of a dog or cat shall present the dog\u2019s or cat\u2019s license to that person.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"9a863d75-53d9-4289-9c15-a36dbe793550","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/b1be863c-6ed1-46e7-97a2-cd02b707f0cd","ref":{"parent":"3345addc-d769-48c2-970f-ab72eafee3dd","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-14-213","docId":"75","text":"8.03.120 Veterinarian Responsibilities.","id":"b1be863c-6ed1-46e7-97a2-cd02b707f0cd","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/b1be863c-6ed1-46e7-97a2-cd02b707f0cd\/54f2c7f6-6217-4b8d-8902-cda605736c27","ref":{"parent":"b1be863c-6ed1-46e7-97a2-cd02b707f0cd","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-14-213-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EEvery veterinarian who vaccinates or causes or directs to be vaccinated in the County any dog or cat with anti-rabies vaccine shall use a form provided by the City to certify that such animal has been vaccinated.\u003C\/li\u003E\u003Cli\u003EEvery veterinarian provide to the animal owner a copy of the anti-rabies vaccination form for use in obtaining a license for the animal.\u003C\/li\u003E\u003Cli\u003EEvery veterinarian operating a business within the City of Cupertino shall conspicuously display a sign to notify dog and cat owners that their animals must be licensed.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"54f2c7f6-6217-4b8d-8902-cda605736c27","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/ff914b28-1f93-4d8f-8359-f141e82afe95","ref":{"parent":"3345addc-d769-48c2-970f-ab72eafee3dd","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-14-214","docId":"75","text":"8.03.130 Penalty.","id":"ff914b28-1f93-4d8f-8359-f141e82afe95","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/3345addc-d769-48c2-970f-ab72eafee3dd\/ff914b28-1f93-4d8f-8359-f141e82afe95\/d6c0f528-5eec-4d43-8a00-47e0d43f7299","ref":{"parent":"ff914b28-1f93-4d8f-8359-f141e82afe95","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-14-214-11","docId":"75","text":"\u003Cp\u003EExcept where otherwise specified, any person who violates any of the provisions of this chapter shall be guilty of a misdemeanor and, upon conviction thereof, shall be punished as provided in Chapter 1.12.\u003Cbr\u003E (Ord. 1886, (part), 2001)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d6c0f528-5eec-4d43-8a00-47e0d43f7299","prev_id":null}]}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7c01ae28-a2b6-48d7-95b6-f2db9f4272bf","ref":{"parent":"04eb8158-de18-4e01-842e-004517c865c6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h3"},"pos":"19-15","docId":"75","text":"CHAPTER 8.04: (RESERVED)","id":"7c01ae28-a2b6-48d7-95b6-f2db9f4272bf","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7c01ae28-a2b6-48d7-95b6-f2db9f4272bf\/f1429937-4fed-4a52-b881-8c2ff4329d37","ref":{"parent":"7c01ae28-a2b6-48d7-95b6-f2db9f4272bf","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-15-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"f1429937-4fed-4a52-b881-8c2ff4329d37","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0","ref":{"parent":"04eb8158-de18-4e01-842e-004517c865c6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"19-16","docId":"75","text":"CHAPTER 8.05: ANIMAL ESTABLISHMENTS","id":"50c18b4b-ac66-401d-8a45-3d921e7da4f0","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/28bb9819-4b07-42fa-8f4a-1fcee9b40f05","ref":{"parent":"50c18b4b-ac66-401d-8a45-3d921e7da4f0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-16-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"28bb9819-4b07-42fa-8f4a-1fcee9b40f05","prev_id":null},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/13effaba-9cb1-4b71-9a25-b10697197fd5","ref":{"parent":"50c18b4b-ac66-401d-8a45-3d921e7da4f0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-16-12","docId":"75","text":"8.05.010 Permit Required.","id":"13effaba-9cb1-4b71-9a25-b10697197fd5","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/13effaba-9cb1-4b71-9a25-b10697197fd5\/d10c257b-4a47-4d39-bd79-f05475f78076","ref":{"parent":"13effaba-9cb1-4b71-9a25-b10697197fd5","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-16-12-11","docId":"75","text":"\u003Cp\u003ENo person shall conduct, operate or keep any pet shop, commercial kennel, private kennel, pet grooming parlor, animal menagerie, animal shelter, or horse establishment without first obtaining an appropriate permit from the City Manager. The annual permit fee for the above animal facilities shall be fixed by resolution of the City Council.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"d10c257b-4a47-4d39-bd79-f05475f78076","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/2b4ede0c-735c-4aba-b1c6-1f7c5649d434","ref":{"parent":"50c18b4b-ac66-401d-8a45-3d921e7da4f0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-16-13","docId":"75","text":"8.05.020 Application for Permit.","id":"2b4ede0c-735c-4aba-b1c6-1f7c5649d434","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/2b4ede0c-735c-4aba-b1c6-1f7c5649d434\/74886889-b38b-4ab3-8e89-0f3ba8f3b323","ref":{"parent":"2b4ede0c-735c-4aba-b1c6-1f7c5649d434","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-16-13-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EAn application for a permit to operate and keep a pet shop, commercial kennel, private kennel, pet grooming parlor, animal menagerie, animal shelter, horse establishment, or dangerous animal shall be in writing on a form approved by the City Manager. The applicant shall furnish a list of the types of animals to be maintained or used for any purpose, together with the approximate number of animals of each type.\u003C\/li\u003E\u003Cli\u003EThe City Manager may establish regulations and standards relating to:\u003Col\u003E\u003Cli\u003EThe maximum number and species of animals to be kept or maintained on the premises;\u003C\/li\u003E\u003Cli\u003EThe construction, sanitation and maintenance of facilities; and\u003C\/li\u003E\u003Cli\u003EAny other regulations and standards in conformity with and for the purpose of carrying out the intent of this title.\u003Cbr\u003E \u003Cbr\u003E Compliance with such rules and regulations shall be prerequisite to the issuance and continued validity of any permit provided pursuant to this title when approved by the City Council.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EPermittee shall maintain a record of the names and addresses of persons from whom animals are received and to whom the animals are sold, traded or given. This shall be available to the City Manager upon request.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"74886889-b38b-4ab3-8e89-0f3ba8f3b323","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/0c4d681a-e634-4226-8cd7-9f9bbb79cd13","ref":{"parent":"50c18b4b-ac66-401d-8a45-3d921e7da4f0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-16-14","docId":"75","text":"8.05.030 Conditions Relating to Animal Facilities.","id":"0c4d681a-e634-4226-8cd7-9f9bbb79cd13","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/0c4d681a-e634-4226-8cd7-9f9bbb79cd13\/f9ebaeaf-0736-4477-b590-d2ebb68e12e2","ref":{"parent":"0c4d681a-e634-4226-8cd7-9f9bbb79cd13","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-16-14-11","docId":"75","text":"\u003Cp\u003EEvery person who owns, conducts, manages or operates any commercial kennel, private kennel, pet shop, pet grooming parlor, animal menagerie, animal shelter, or horse establishment shall comply with each of the following conditions:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EHousing.\u003Col\u003E\u003Cli\u003EHousing facilities for animals shall be structurally sound and shall be maintained in good repair to protect animals from injury and restrict entrance of other animals or the escape of animals so contained therein.\u003C\/li\u003E\u003Cli\u003EEvery building or enclosure wherein animals are maintained shall be properly ventilated to prevent drafts and to remove odors; heating and cooling shall be provided as required, according to the physical need of the animals, with sufficient light to allow observation of animals.\u003C\/li\u003E\u003Cli\u003EAll animal rooms, cages, kennel, runs, stalls and corrals shall be sufficient size to provide adequate and proper accommodation and protection from the weather for the animals kept therein.\u003C\/li\u003E\u003Cli\u003EAll animal facilities shall be constructed and operated in a manner that reasonably protects public health and safety and safety of the animals.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003ESanitation. All animal facilities shall be maintained and operated at all times in a clean and sanitary condition, and in a manner that avoids causing odors or attraction of flies and vermin, and excessive noise.\u003C\/li\u003E\u003Cli\u003ECare of Animals.\u003Col\u003E\u003Cli\u003EAll animals shall be supplied with a quantity of wholesome food suitable for the species and age of the respective animals, as often as the feeding habits of such animals require, sufficient to maintain a reasonable level of nutrition. All animals shall have available to them sufficient potable water. Food and water shall be served in separate, clean receptacles.\u003C\/li\u003E\u003Cli\u003ENo animal, except those animal(s) in a pasture provided with adequate feed and water, shall be without attention for more than twenty-four consecutive hours. The name, address and telephone number of a person responsible for the animal shall be posted in a conspicuous place, visible from outside the facility or at the main gate of a pasture where animals are kept, unless the owner or attendant of the animal(s) is immediately available on the premises.\u003C\/li\u003E\u003Cli\u003EAll sick, diseased or injured animals shall be isolated from healthy animals at all times and shall be given proper medical treatment. The City Manager may order the operator of the facility to immediately seek licensed veterinarian treatment for any animal.\u003C\/li\u003E\u003Cli\u003EAll animals shall be treated in an humane manner.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003ECompliance.\u003Col\u003E\u003Cli\u003EThe City Manager shall have the authority to enter the animal facility when he or she has reason to believe that the provisions of the permit, this title or applicable State law, are being violated. The failure of the operator to consent to the entry shall be deemed just cause for the revocation of the permit.\u003C\/li\u003E\u003Cli\u003EFailure of an applicant or a permit holder to comply with any of the provisions of the permit, this title, or applicable State law, shall be deemed just cause for the denial of any permit, either original or renewal, or for revocation of a permit.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f9ebaeaf-0736-4477-b590-d2ebb68e12e2","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/c1e765f2-ecd7-418d-a2c6-bb575967c898","ref":{"parent":"50c18b4b-ac66-401d-8a45-3d921e7da4f0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-16-15","docId":"75","text":"8.05.040 Expiration and Renewal of Permit.","id":"c1e765f2-ecd7-418d-a2c6-bb575967c898","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/c1e765f2-ecd7-418d-a2c6-bb575967c898\/2f74b5af-201e-4b6b-8eeb-c10b72659bed","ref":{"parent":"c1e765f2-ecd7-418d-a2c6-bb575967c898","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-16-15-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003EAny permit issued under this chapter shall expire twelve months from the date of issuance. The procedure for the renewal of a permit shall be the same as for an original permit.\u003C\/li\u003E\u003Cli style=\u0022margin-left: 0px;\u0022\u003EUpon failure to make application for the renewal of a permit within thirty days of the expiration of a permit, or prior thereto, the applicant shall pay interest and late penalties as proscribed by the City.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp style=\u0022margin-left:0px\u0022\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"2f74b5af-201e-4b6b-8eeb-c10b72659bed","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/3df01a75-aff9-4801-bd69-75ac3fad27ad","ref":{"parent":"50c18b4b-ac66-401d-8a45-3d921e7da4f0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-16-16","docId":"75","text":"8.05.050 Inspection.","id":"3df01a75-aff9-4801-bd69-75ac3fad27ad","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/3df01a75-aff9-4801-bd69-75ac3fad27ad\/0a6d1812-8521-4dc2-9023-d57ee492b067","ref":{"parent":"3df01a75-aff9-4801-bd69-75ac3fad27ad","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-16-16-11","docId":"75","text":"\u003Cp\u003EAs a condition to the issuance or renewal of a permit under this title, the City Manager or authorized representative shall have the authority to inspect an animal facility subject to this chapter at any reasonable time.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0a6d1812-8521-4dc2-9023-d57ee492b067","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/1eb2a445-46c5-4c59-b3ec-ba5f66a8ccbc","ref":{"parent":"50c18b4b-ac66-401d-8a45-3d921e7da4f0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-16-17","docId":"75","text":"8.05.060 Denial or Revocation of Permit.","id":"1eb2a445-46c5-4c59-b3ec-ba5f66a8ccbc","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/1eb2a445-46c5-4c59-b3ec-ba5f66a8ccbc\/f214531e-b1e8-403b-8f3f-7b7a67aa4bd2","ref":{"parent":"1eb2a445-46c5-4c59-b3ec-ba5f66a8ccbc","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-16-17-11","docId":"75","text":"\u003Cp\u003EThe City Manager may deny or revoke any permit issued pursuant to this chapter in the following situations:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EWhenever determined by inspection that any animal facility fails to meet any of the conditions of the permit, this title, or applicable State law.\u003C\/li\u003E\u003Cli\u003EWhenever there is reason to believe that the applicant or permit holder has willfully withheld or falsified any information required for a permit.\u003C\/li\u003E\u003Cli\u003EIf the applicant or permit holder has been convicted by a court of law of more than two violations in a twelve-month period of this title, or State laws relating to animals or public nuisance caused by animals, or has been convicted of cruelty to animals in this or any other State within the previous five years. For the purposes of this section, a bail forfeiture shall be deemed to be a conviction of the offense charged.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f214531e-b1e8-403b-8f3f-7b7a67aa4bd2","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/16531ea1-b496-4563-b9e2-b81170d75836","ref":{"parent":"50c18b4b-ac66-401d-8a45-3d921e7da4f0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-16-18","docId":"75","text":"8.05.070 Appeal from Denial or Revocation of Permit.","id":"16531ea1-b496-4563-b9e2-b81170d75836","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/16531ea1-b496-4563-b9e2-b81170d75836\/314018cc-8929-426c-adca-9cb90cba54d6","ref":{"parent":"16531ea1-b496-4563-b9e2-b81170d75836","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-16-18-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EPrior to denial or revocation of a permit, the City Manager shall notify the applicant in writing of the intent to deny or revoke the permit, the reasons for such denial or revocation, and that the applicant may make a written request for a hearing to the City Manager within five days after receipt of such notice if the applicant wishes, to challenge the denial or revocation.\u003C\/li\u003E\u003Cli\u003EThe City Manager shall set the time and place for hearing and cause notice of such hearing to be mailed to the person requesting such hearing at least five days before the date of the hearing. The hearing shall be conducted according to Section 8.02.080.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"314018cc-8929-426c-adca-9cb90cba54d6","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/7e3bdb4a-2a1f-485c-8236-bd4524d85514","ref":{"parent":"50c18b4b-ac66-401d-8a45-3d921e7da4f0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-16-19","docId":"75","text":"8.05.080 No New Permit after Denial or Revocation.","id":"7e3bdb4a-2a1f-485c-8236-bd4524d85514","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/7e3bdb4a-2a1f-485c-8236-bd4524d85514\/ed04b3a3-6bdf-4998-9905-42ec56a4667a","ref":{"parent":"7e3bdb4a-2a1f-485c-8236-bd4524d85514","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-16-19-11","docId":"75","text":"\u003Cp\u003EIf a permit has been denied or revoked, the City Manager will not accept a new permit application from the same person for the same activity at the same location less than six months after such denial or revocation, unless the applicant shows, and the City Manager finds, by inspection and\/or investigation, that the grounds upon which the first application was denied or the permit revoked no longer exist.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"ed04b3a3-6bdf-4998-9905-42ec56a4667a","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/e77a147c-11a4-4255-bfb1-6c5c98187c21","ref":{"parent":"50c18b4b-ac66-401d-8a45-3d921e7da4f0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-16-210","docId":"75","text":"8.05.090 Permit Not Transferable.","id":"e77a147c-11a4-4255-bfb1-6c5c98187c21","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/e77a147c-11a4-4255-bfb1-6c5c98187c21\/70ba4d58-78d6-4b5c-88b2-96437bd68ca8","ref":{"parent":"e77a147c-11a4-4255-bfb1-6c5c98187c21","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-16-210-11","docId":"75","text":"\u003Cp\u003EPermits issued pursuant to the provisions of this chapter shall not be transferable.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"70ba4d58-78d6-4b5c-88b2-96437bd68ca8","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/d3c399f7-429f-4563-9a17-11caebf5a890","ref":{"parent":"50c18b4b-ac66-401d-8a45-3d921e7da4f0","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-16-211","docId":"75","text":"8.05.100 Penalty.","id":"d3c399f7-429f-4563-9a17-11caebf5a890","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/50c18b4b-ac66-401d-8a45-3d921e7da4f0\/d3c399f7-429f-4563-9a17-11caebf5a890\/253de249-d8fb-40e6-a3a8-8dd451209c40","ref":{"parent":"d3c399f7-429f-4563-9a17-11caebf5a890","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-16-211-11","docId":"75","text":"\u003Cp\u003EExcept where otherwise specified, any person who violates any of the provisions of this chapter shall be guilty of a misdemeanor and, upon conviction thereof, shall be punished as provided in Chapter 1.12.\u003Cbr\u003E (Ord. 1886, (part), 2001)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"253de249-d8fb-40e6-a3a8-8dd451209c40","prev_id":null}]}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/bd72452c-1e66-4f9d-94bd-28205c4f0729","ref":{"parent":"04eb8158-de18-4e01-842e-004517c865c6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"19-17","docId":"75","text":"CHAPTER 8.06: DANGEROUS ANIMALS","id":"bd72452c-1e66-4f9d-94bd-28205c4f0729","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/bd72452c-1e66-4f9d-94bd-28205c4f0729\/79d2acc5-cdda-4c1e-bd38-bf4bf487c0d2","ref":{"parent":"bd72452c-1e66-4f9d-94bd-28205c4f0729","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-17-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"79d2acc5-cdda-4c1e-bd38-bf4bf487c0d2","prev_id":null},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/bd72452c-1e66-4f9d-94bd-28205c4f0729\/f2a2cb02-2666-4e5a-85cc-ffe7d9b5db2f","ref":{"parent":"bd72452c-1e66-4f9d-94bd-28205c4f0729","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-17-12","docId":"75","text":"8.06.010 Permit for Dangerous And\/or Vicious Animals.","id":"f2a2cb02-2666-4e5a-85cc-ffe7d9b5db2f","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/bd72452c-1e66-4f9d-94bd-28205c4f0729\/f2a2cb02-2666-4e5a-85cc-ffe7d9b5db2f\/e386a3e9-182a-47bc-b470-651dfc6dcbb7","ref":{"parent":"f2a2cb02-2666-4e5a-85cc-ffe7d9b5db2f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-17-12-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ENo person shall keep, have, maintain, sell, trade, or let for hire a dangerous and\/or vicious animal without first obtaining a permit from the City Manager. The application for a permit, permit conditions, inspection, denial, revocation, and appeal shall be in accord with the provisions of this chapter.\u003C\/li\u003E\u003Cli\u003ENo permit shall be required of any zoo, university, college, governmental research agency or other bona fide scientific institutions, as determined by the City Manager, engaging in scientific or public health research. For the purposes of this title, a zoo shall be considered any organization that exhibits animals to the general public at regular specified hours, equaling at least thirty hours a week for thirty-six weeks a year, and whose animals, whether maintained for exhibit purposes or not, are not for sale to private individuals.\u003C\/li\u003E\u003Cli\u003EThe owner of a vicious and\/or dangerous animal shall post at the entrances to the property where the animal is kept with a legible sign at least twelve inches square, warning persons of a vicious and\/or dangerous animal.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"e386a3e9-182a-47bc-b470-651dfc6dcbb7","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/bd72452c-1e66-4f9d-94bd-28205c4f0729\/34d7cc56-23f5-41ce-955f-c40673f104ac","ref":{"parent":"bd72452c-1e66-4f9d-94bd-28205c4f0729","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-17-13","docId":"75","text":"8.06.020 Permit Denial.","id":"34d7cc56-23f5-41ce-955f-c40673f104ac","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/bd72452c-1e66-4f9d-94bd-28205c4f0729\/34d7cc56-23f5-41ce-955f-c40673f104ac\/1b5b177d-4e25-4039-8294-ded78a81715e","ref":{"parent":"34d7cc56-23f5-41ce-955f-c40673f104ac","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-17-13-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ENotwithstanding anything to the contrary, the City Manager may deny or revoke a permit to keep or maintain any dangerous animal when, in his or her opinion:\u003Col\u003E\u003Cli\u003EAny such animal may not be kept or maintained without endangering the. safety of any person(s) or property; or\u003C\/li\u003E\u003Cli\u003EThe keeping of the animal would constitute a public nuisance; or\u003C\/li\u003E\u003Cli\u003EThe animal would be subject to suffering, neglect, cruelty or abuse.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003EThe City Manager in his or her discretion may require any such animal to be properly caged, tethered, or restrained in zoo-type facilities that meet or are in addition to, or more restrictive than, State guidelines issued under the provisions of Section 671 of Title 14 of the California Code of Regulations and federal standards issued under Chapter 1 of Title 9 of the Code of Federal Regulations.\u003C\/li\u003E\u003Cli\u003ENothing in this chapter shall be construed to permit the keeping of dangerous animals where zoning provisions or State law would prohibit such keeping.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"1b5b177d-4e25-4039-8294-ded78a81715e","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/bd72452c-1e66-4f9d-94bd-28205c4f0729\/46898496-a9ce-458e-b706-7b895509d97b","ref":{"parent":"bd72452c-1e66-4f9d-94bd-28205c4f0729","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-17-14","docId":"75","text":"8.06.030 Permit Period and Fee.","id":"46898496-a9ce-458e-b706-7b895509d97b","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/bd72452c-1e66-4f9d-94bd-28205c4f0729\/46898496-a9ce-458e-b706-7b895509d97b\/5fc54ed5-d453-4cde-bc28-e5641319e74c","ref":{"parent":"46898496-a9ce-458e-b706-7b895509d97b","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-17-14-11","docId":"75","text":"\u003Cp\u003EThe fee for a permit to keep or maintain one or more dangerous animals shall be for a twelve-month term, and shall be set by resolution of the City Council. The permit shall expire and be renewable as set forth in Section 8.05.040.\u003C\/p\u003E\u003Cp\u003E(Ord. 21-2234, Att. A (\u00a7 7), 2021; Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"5fc54ed5-d453-4cde-bc28-e5641319e74c","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/bd72452c-1e66-4f9d-94bd-28205c4f0729\/863c5865-ccb3-4812-8210-03500500315f","ref":{"parent":"bd72452c-1e66-4f9d-94bd-28205c4f0729","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-17-15","docId":"75","text":"8.06.040 Penalty.","id":"863c5865-ccb3-4812-8210-03500500315f","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/bd72452c-1e66-4f9d-94bd-28205c4f0729\/863c5865-ccb3-4812-8210-03500500315f\/fa92f479-7c62-495e-a155-a5799ee6f49b","ref":{"parent":"863c5865-ccb3-4812-8210-03500500315f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-17-15-11","docId":"75","text":"\u003Cp\u003EExcept where otherwise specified, any person who violates any of the provisions of this chapter shall be guilty of a misdemeanor and, upon conviction thereof, shall be punished as provided in Chapter 1.12.\u003Cbr\u003E (Ord. 1886, (part), 2001)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"fa92f479-7c62-495e-a155-a5799ee6f49b","prev_id":null}]}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/9f7b5201-709c-4e32-bfa3-f56245b3d821","ref":{"parent":"04eb8158-de18-4e01-842e-004517c865c6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"19-18","docId":"75","text":"CHAPTER 8.07: BEEKEEPING","id":"9f7b5201-709c-4e32-bfa3-f56245b3d821","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/9f7b5201-709c-4e32-bfa3-f56245b3d821\/ba4c3468-7248-4747-8c29-9df6fcc3b2c5","ref":{"parent":"9f7b5201-709c-4e32-bfa3-f56245b3d821","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-18-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"ba4c3468-7248-4747-8c29-9df6fcc3b2c5","prev_id":null},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/9f7b5201-709c-4e32-bfa3-f56245b3d821\/6bd6c778-548d-460e-8287-a81cf07644e4","ref":{"parent":"9f7b5201-709c-4e32-bfa3-f56245b3d821","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-18-12","docId":"75","text":"8.07.010 Purpose.","id":"6bd6c778-548d-460e-8287-a81cf07644e4","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/9f7b5201-709c-4e32-bfa3-f56245b3d821\/6bd6c778-548d-460e-8287-a81cf07644e4\/cd41b6cc-5a1d-4ffa-a662-b98a15a430a7","ref":{"parent":"6bd6c778-548d-460e-8287-a81cf07644e4","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-18-12-11","docId":"75","text":"\u003Cp\u003EThis chapter is enacted to provide for beekeeping, including urban beekeeping, activities within the City while minimizing impacts to surrounding properties through the establishment of beekeeping regulations.\u003Cbr\u003E (Ord. 16-2158, \u00a7 1, 2016)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"cd41b6cc-5a1d-4ffa-a662-b98a15a430a7","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/9f7b5201-709c-4e32-bfa3-f56245b3d821\/a22ed2af-e3af-4b27-a5e9-7f4af8717097","ref":{"parent":"9f7b5201-709c-4e32-bfa3-f56245b3d821","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-18-13","docId":"75","text":"8.07.020 Definitions.","id":"a22ed2af-e3af-4b27-a5e9-7f4af8717097","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/9f7b5201-709c-4e32-bfa3-f56245b3d821\/a22ed2af-e3af-4b27-a5e9-7f4af8717097\/eac21035-9b65-4b98-94d6-ab16299d73f2","ref":{"parent":"a22ed2af-e3af-4b27-a5e9-7f4af8717097","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-18-13-11","docId":"75","text":"\u003Cp\u003EFor the purposes of this chapter, the following definitions apply, unless it is apparent from the context that a different meaning is intended.\u003Cbr\u003E \u201cApiary\u201d means a collection of bees, hives, and any accessory appliances.\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003E\u201cAgricultural Apiary\u201d means an apiary kept as a principal use on any property.\u003C\/li\u003E\u003Cli\u003E\u201cUrban Apiary\u201d means an apiary kept as an accessory use pursuant to Section 19.100.020, Accessory Uses and Facilities.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E\u201cBees\u201d means any state of the common domestic honey-producing insects of the species apis mellifera.\u003Cbr\u003E \u201cHive\u201d means any receptacle, container or structure used to house bees.\u003Cbr\u003E \u201cLocation\u201d means any premises upon which an apiary is located.\u003Cbr\u003E (Ord. 16-2158, \u00a7 1 (part), 2016; Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"eac21035-9b65-4b98-94d6-ab16299d73f2","prev_id":null}]}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/01d634b6-d59b-4f1c-bb75-4736cc0f2273","ref":{"parent":"04eb8158-de18-4e01-842e-004517c865c6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"19-19","docId":"75","text":"8.07.030 Location, Number, Maintenance and Registration of Apiaries.","id":"01d634b6-d59b-4f1c-bb75-4736cc0f2273","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/01d634b6-d59b-4f1c-bb75-4736cc0f2273\/cf761617-0b4e-4159-9069-12ca81ce1476","ref":{"parent":"01d634b6-d59b-4f1c-bb75-4736cc0f2273","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-19-11","docId":"75","text":"\u003Cp\u003EAny person may keep and maintain apiaries in accordance to the following regulations:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ELocation:\u003Col\u003E\u003Cli\u003EAgricultural apiaries as permitted in Chapter 19.20;\u003C\/li\u003E\u003Cli\u003EUrban apiaries in all zoning districts;\u003C\/li\u003E\u003Cli\u003EMinimum setbacks:\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:lower-roman\u0022\u003E\u003Cli\u003EFront property line and\/or any public or private street: 20 feet; and\u003C\/li\u003E\u003Cli\u003ESide or rear property lines and\/or driveway easements: Eight (8) feet, unless property owners of adjacent properties or beneficiaries of driveway easements have given written permission to locate hives at a closer distance.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003ENumber: Only two hives may be kept or maintained on parcels less than 5,000 square feet in size.\u003C\/li\u003E\u003Cli\u003EMaintenance:\u003Col\u003E\u003Cli\u003EA constant supply of fresh water adequate in quantity for the apiary should be provided and maintained on the location.\u003C\/li\u003E\u003Cli\u003EAny apiaries abandoned by beekeepers or disused apiaries shall be promptly dismantled and removed from the location.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/li\u003E\u003Cli\u003ERegistration: All apiaries must be registered with the Santa Clara County Agricultural Commissioner as required by Division 13: Bee Management and Honey Production of the California Food and Agricultural Code commencing at Section 29000, and or as thereafter may be amended.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 16-2158, \u00a7 1 (part), 2016; Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"cf761617-0b4e-4159-9069-12ca81ce1476","prev_id":null},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/01d634b6-d59b-4f1c-bb75-4736cc0f2273\/2b23e1de-7be0-4c8d-8005-1701c9fa9604","ref":{"parent":"01d634b6-d59b-4f1c-bb75-4736cc0f2273","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-19-12","docId":"75","text":"8.07.040 Nuisance.","id":"2b23e1de-7be0-4c8d-8005-1701c9fa9604","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/01d634b6-d59b-4f1c-bb75-4736cc0f2273\/2b23e1de-7be0-4c8d-8005-1701c9fa9604\/79711352-2d5c-4ced-be69-620a7d5db0a4","ref":{"parent":"2b23e1de-7be0-4c8d-8005-1701c9fa9604","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-19-12-11","docId":"75","text":"\u003Cp\u003EThe maintenance or use of any real property in violation of this chapter, or which creates a condition as defined in Section 1.09.030, is hereby declared a public nuisance, is prohibited and is subject to code enforcement and all other enforcement remedies as provided for in this Code.\u003Cbr\u003E (Ord. 16-2158, \u00a7 1 (part), 2016; Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"79711352-2d5c-4ced-be69-620a7d5db0a4","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/01d634b6-d59b-4f1c-bb75-4736cc0f2273\/15867c99-da6b-4bca-8e91-fe9172ba4355","ref":{"parent":"01d634b6-d59b-4f1c-bb75-4736cc0f2273","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-19-13","docId":"75","text":"8.07.050 Enforcement.","id":"15867c99-da6b-4bca-8e91-fe9172ba4355","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/01d634b6-d59b-4f1c-bb75-4736cc0f2273\/15867c99-da6b-4bca-8e91-fe9172ba4355\/6b22405c-a9ae-480c-90a3-136cb084a5fb","ref":{"parent":"15867c99-da6b-4bca-8e91-fe9172ba4355","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-19-13-11","docId":"75","text":"\u003Cp\u003EAny person who violates any provision of this chapter shall be subject to administrative fines and\/or penalties pursuant to Chapter 1.10. In addition, any person who violates any of the provisions of this chapter shall be guilty of a misdemeanor and, upon conviction thereof, shall be punished as provided in Chapter 1.12.\u003Cbr\u003E (Ord. 16-2158, \u00a7 1 (part), 2016; Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"6b22405c-a9ae-480c-90a3-136cb084a5fb","prev_id":null}]}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/207a223c-3625-429e-a3d2-91ffabcee146","ref":{"parent":"04eb8158-de18-4e01-842e-004517c865c6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h3"},"pos":"19-210","docId":"75","text":"CHAPTER 8.08: (RESERVED)","id":"207a223c-3625-429e-a3d2-91ffabcee146","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/207a223c-3625-429e-a3d2-91ffabcee146\/ace041c8-9f70-4aa9-b7c7-4645c9cea164","ref":{"parent":"207a223c-3625-429e-a3d2-91ffabcee146","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-210-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"ace041c8-9f70-4aa9-b7c7-4645c9cea164","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7ece0698-3a6c-43e5-ae47-5a15589ddd13","ref":{"parent":"04eb8158-de18-4e01-842e-004517c865c6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"19-211","docId":"75","text":"CHAPTER 8.09: SALE OF ANIMALS","id":"7ece0698-3a6c-43e5-ae47-5a15589ddd13","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7ece0698-3a6c-43e5-ae47-5a15589ddd13\/35cd0158-9762-4fd3-a133-900b3477ff2e","ref":{"parent":"7ece0698-3a6c-43e5-ae47-5a15589ddd13","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-211-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"35cd0158-9762-4fd3-a133-900b3477ff2e","prev_id":null},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7ece0698-3a6c-43e5-ae47-5a15589ddd13\/7a53766b-ad50-4dd9-9c6b-83726e3de71c","ref":{"parent":"7ece0698-3a6c-43e5-ae47-5a15589ddd13","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-211-12","docId":"75","text":"8.09.010 Sale of Cats or Dogs.","id":"7a53766b-ad50-4dd9-9c6b-83726e3de71c","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7ece0698-3a6c-43e5-ae47-5a15589ddd13\/7a53766b-ad50-4dd9-9c6b-83726e3de71c\/e5723255-f836-4a2e-96d7-ec3bd0a4c639","ref":{"parent":"7a53766b-ad50-4dd9-9c6b-83726e3de71c","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-211-12-11","docId":"75","text":"\u003Cp\u003ENo person or establishment other than a licensed or County-operated animal shelter shall sell, exchange or barter any cat or dog under eight weeks of age. Proof of age of the dog or cat may be required by the City Manager. Proof of age may include but not be limited to a certification by a licensed veterinarian attesting to the animal\u2019s age.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"e5723255-f836-4a2e-96d7-ec3bd0a4c639","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7ece0698-3a6c-43e5-ae47-5a15589ddd13\/d7651c5d-38b3-46dd-8579-f0db2fa9ace3","ref":{"parent":"7ece0698-3a6c-43e5-ae47-5a15589ddd13","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-211-13","docId":"75","text":"8.09.020 Immunization.","id":"d7651c5d-38b3-46dd-8579-f0db2fa9ace3","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7ece0698-3a6c-43e5-ae47-5a15589ddd13\/d7651c5d-38b3-46dd-8579-f0db2fa9ace3\/65abccf6-e81f-46f3-a037-5bac83fc32f7","ref":{"parent":"d7651c5d-38b3-46dd-8579-f0db2fa9ace3","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-211-13-11","docId":"75","text":"\u003Cp\u003EAll cats or dogs over eight weeks of age, before they are sold, shall be immunized against common diseases in the case of dogs against distemper; in the case of cats against panleukopenia. The seller of a dog or cat shall provide to the buyer at the time of sale a signed statement from the seller attesting to the date of vaccination and the seller\u2019s knowledge of the animal\u2019s health. Such statement shall also include the animal\u2019s immunization history, and the record of any known disease, sickness or internal parasites that the animal is afflicted with at the time of transfer of ownership, including treatment and medication.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"65abccf6-e81f-46f3-a037-5bac83fc32f7","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7ece0698-3a6c-43e5-ae47-5a15589ddd13\/fcc70cc3-4159-47f6-b38f-cb98baf0567c","ref":{"parent":"7ece0698-3a6c-43e5-ae47-5a15589ddd13","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-211-14","docId":"75","text":"8.09.030 Return of Dog or Cat.","id":"fcc70cc3-4159-47f6-b38f-cb98baf0567c","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7ece0698-3a6c-43e5-ae47-5a15589ddd13\/fcc70cc3-4159-47f6-b38f-cb98baf0567c\/22266a08-44a6-44e7-aeae-f9b9f8f28b7b","ref":{"parent":"fcc70cc3-4159-47f6-b38f-cb98baf0567c","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-211-14-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EAny person purchasing a dog or cat from a person or establishment required to be licensed or registered pursuant to this title may, within five days of such purchase, cause such animal to be examined by a veterinarian licensed by the State of California; and, if such examination reveals clinical signs of a contagious or infectious disease or serious congenital defects, not otherwise disclosed to the purchaser as required by Section 8.09.020, the purchaser may, within one day of the examination, return such animal to the seller. When returned, such animal must be accompanied with a certificate signed by the examining veterinarian stating examination findings. Upon return of such animal for the reasons stated in this section, the seller shall reimburse the purchaser for the cost of the animal.\u003C\/li\u003E\u003Cli\u003EIf the seller refuses to reimburse the purchaser for the cost of the animal upon purchaser\u2019s offer to return it, the purchaser may file a complaint with any judge of the municipal court stating a cause of action for violation of this section.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"22266a08-44a6-44e7-aeae-f9b9f8f28b7b","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7ece0698-3a6c-43e5-ae47-5a15589ddd13\/cf7a3231-cf18-4261-98f5-dd23d4d89ed0","ref":{"parent":"7ece0698-3a6c-43e5-ae47-5a15589ddd13","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-211-15","docId":"75","text":"8.09.040 Penalty.","id":"cf7a3231-cf18-4261-98f5-dd23d4d89ed0","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/7ece0698-3a6c-43e5-ae47-5a15589ddd13\/cf7a3231-cf18-4261-98f5-dd23d4d89ed0\/32676627-6d0c-4028-bd56-5e7cd7308141","ref":{"parent":"cf7a3231-cf18-4261-98f5-dd23d4d89ed0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-211-15-11","docId":"75","text":"\u003Cp\u003EExcept where otherwise noted, any person who violates any of the provisions of this chapter shall be guilty of a misdemeanor and, upon conviction thereof, shall be punished as provided in Chapter 1.12. Notwithstanding the above, the City Attorney may commence a civil action pursuant to California Health and Safety Code Section 122045 et seq. as an alternative to, or in conjunction with, the aforementioned penalty.\u003Cbr\u003E (Ord. 1886, (part), 2001)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"32676627-6d0c-4028-bd56-5e7cd7308141","prev_id":null}]}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/127ff899-7f79-49d4-a029-d3373e3cecfb","ref":{"parent":"04eb8158-de18-4e01-842e-004517c865c6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h3"},"pos":"19-212","docId":"75","text":"CHAPTER 8.10: (RESERVED)","id":"127ff899-7f79-49d4-a029-d3373e3cecfb","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/127ff899-7f79-49d4-a029-d3373e3cecfb\/c3266f50-32c0-4d18-b4e8-93d260e8902c","ref":{"parent":"127ff899-7f79-49d4-a029-d3373e3cecfb","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-212-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"c3266f50-32c0-4d18-b4e8-93d260e8902c","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2","ref":{"parent":"04eb8158-de18-4e01-842e-004517c865c6","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"19-213","docId":"75","text":"CHAPTER 8.11: HORSES","id":"184717ec-cc93-4b7a-ac98-2ac7b7219ee2","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/0ee390e6-5556-431d-9b94-dc5a8af01d7b","ref":{"parent":"184717ec-cc93-4b7a-ac98-2ac7b7219ee2","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-213-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"0ee390e6-5556-431d-9b94-dc5a8af01d7b","prev_id":null},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/06afd068-0887-471b-9b7d-fbb7c74f1304","ref":{"parent":"184717ec-cc93-4b7a-ac98-2ac7b7219ee2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-213-12","docId":"75","text":"8.11.010 Keeping as Pets.","id":"06afd068-0887-471b-9b7d-fbb7c74f1304","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/06afd068-0887-471b-9b7d-fbb7c74f1304\/257d453a-4346-4d64-8cd6-2f65f5c40272","ref":{"parent":"06afd068-0887-471b-9b7d-fbb7c74f1304","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-213-12-11","docId":"75","text":"\u003Cp\u003EHorses may be kept as pets in any zone in the City, subject to the regulations of this chapter and other applicable provisions of the Cupertino Municipal Zoning Code.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"257d453a-4346-4d64-8cd6-2f65f5c40272","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/c9c685c3-67c3-4a88-9957-7b7a667e2d27","ref":{"parent":"184717ec-cc93-4b7a-ac98-2ac7b7219ee2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-213-13","docId":"75","text":"8.11.020 Holding Amateur Horse Events.","id":"c9c685c3-67c3-4a88-9957-7b7a667e2d27","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/c9c685c3-67c3-4a88-9957-7b7a667e2d27\/62a36e26-e3a0-44a5-a936-06c3bfc98fc2","ref":{"parent":"c9c685c3-67c3-4a88-9957-7b7a667e2d27","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-213-13-11","docId":"75","text":"\u003Cp\u003EAmateur horse events may be held in any zone in the City, subject to the zoning regulations of this chapter and other provisions of the Cupertino Municipal Zoning Code.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"62a36e26-e3a0-44a5-a936-06c3bfc98fc2","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/00c7eee2-c1b5-4287-ab12-a74325bc2980","ref":{"parent":"184717ec-cc93-4b7a-ac98-2ac7b7219ee2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-213-14","docId":"75","text":"8.11.030 Land Area Requirements.","id":"00c7eee2-c1b5-4287-ab12-a74325bc2980","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/00c7eee2-c1b5-4287-ab12-a74325bc2980\/68436da7-fa52-4c76-ac6d-30f96b5bdf47","ref":{"parent":"00c7eee2-c1b5-4287-ab12-a74325bc2980","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-213-14-11","docId":"75","text":"\u003Cp\u003EOn parcels of land having an area of forty thousand square feet or more, a horse barn or shelter may be constructed pursuant to the requirements of this chapter and one pet horse may be kept for each twenty thousand square feet of area, plus one pet horse. The foal, under nine months of age, of a mare lawfully kept on the premises is not counted in determining the number of pet horses that may be kept.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"68436da7-fa52-4c76-ac6d-30f96b5bdf47","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/b18d29bd-d609-423f-b890-7e3ad41ee20f","ref":{"parent":"184717ec-cc93-4b7a-ac98-2ac7b7219ee2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-213-15","docId":"75","text":"8.11.040 Location of Horse Facilities.","id":"b18d29bd-d609-423f-b890-7e3ad41ee20f","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/b18d29bd-d609-423f-b890-7e3ad41ee20f\/b883ddad-3f10-4fba-8c28-b30bf5102067","ref":{"parent":"b18d29bd-d609-423f-b890-7e3ad41ee20f","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-213-15-11","docId":"75","text":"\u003Cp\u003ERegardless of whether a permit is required for keeping pet horses:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EHorse barns and shelters shall be located at least thirty feet from the rear and side property lines, at least twenty-five feet from any dwelling on the same premises, and at least sixty feet from any dwelling or swimming pool on adjacent premises if such dwelling or swimming pool exists when the horse barn or shelter is built.\u003C\/li\u003E\u003Cli\u003ECorrals and pens shall be located at least three feet from any property line and at least sixty feet from any dwelling or swimming pool on adjacent property, if such dwelling or swimming pool exists when the corral or pen is built.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"b883ddad-3f10-4fba-8c28-b30bf5102067","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/aa6f6f84-a0f5-4d88-b82f-d703f145a715","ref":{"parent":"184717ec-cc93-4b7a-ac98-2ac7b7219ee2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-213-16","docId":"75","text":"8.11.050 Structural Requirements for Horse Barns and Shelters.","id":"aa6f6f84-a0f5-4d88-b82f-d703f145a715","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/aa6f6f84-a0f5-4d88-b82f-d703f145a715\/09520ff6-b756-4fc0-8aa2-b323d220631d","ref":{"parent":"aa6f6f84-a0f5-4d88-b82f-d703f145a715","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-213-16-11","docId":"75","text":"\u003Cp\u003EHorse barns and shelters shall meet the following requirements:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThey shall not be over twenty-two feet high.\u003C\/li\u003E\u003Cli\u003EAll exterior materials shall be nonreflective.\u003C\/li\u003E\u003Cli\u003EAll plumbing fixtures shall be served by a two-inch diameter building drain. Building drains in excess of two inches in diameter may be approved by the City upon good cause shown.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"09520ff6-b756-4fc0-8aa2-b323d220631d","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/b97237da-6a31-419f-9345-8819f57de686","ref":{"parent":"184717ec-cc93-4b7a-ac98-2ac7b7219ee2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-213-17","docId":"75","text":"8.11.060 Limitations on Amateur Horse Events.","id":"b97237da-6a31-419f-9345-8819f57de686","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/b97237da-6a31-419f-9345-8819f57de686\/b62b739e-56aa-4393-8091-65b4cdc540ae","ref":{"parent":"b97237da-6a31-419f-9345-8819f57de686","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-213-17-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EAmateur horse events shall not be held on parcels of land having less than five acres area, nor for more than twelve days on any single parcel of land in one calendar year.\u003C\/li\u003E\u003Cli\u003EThe keeping of pet horses on the same premises as, and incidental to the use of a singlefamily residence is allowed without permit. Pet horses may be kept under other circumstances only when a permit to keep them has been issued by the City or when a conditional use permit authorizing them to be kept has been issued under the rules of the zone where the parcel is located, if the rules of the zone provide for a conditional use permit. Amateur horse events may be held only when a permit for the specific event has been issued by the City.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"b62b739e-56aa-4393-8091-65b4cdc540ae","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/3990bc95-cf01-4ff8-bde5-9c693e147441","ref":{"parent":"184717ec-cc93-4b7a-ac98-2ac7b7219ee2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-213-18","docId":"75","text":"8.11.070 Applications\u2013Contents.","id":"3990bc95-cf01-4ff8-bde5-9c693e147441","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/3990bc95-cf01-4ff8-bde5-9c693e147441\/4b48d46a-1c28-4330-839f-8d82e578258e","ref":{"parent":"3990bc95-cf01-4ff8-bde5-9c693e147441","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-213-18-11","docId":"75","text":"\u003Cp\u003EThe City may require that applications for permits required by this chapter contain plot plans and elevations of any structures, proposed or existing, to the extent reasonably necessary to show what conditions the animals will be subjected to, and what effects keeping them, and human activities associated with their keeping, will have on the community.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"4b48d46a-1c28-4330-839f-8d82e578258e","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/f4603e2e-e2b9-41da-afce-ee17792ff0f0","ref":{"parent":"184717ec-cc93-4b7a-ac98-2ac7b7219ee2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-213-19","docId":"75","text":"8.11.080 Same\u2013submission to and Review by Health Officer.","id":"f4603e2e-e2b9-41da-afce-ee17792ff0f0","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/f4603e2e-e2b9-41da-afce-ee17792ff0f0\/1577425c-576f-4124-8105-eece4c527de3","ref":{"parent":"f4603e2e-e2b9-41da-afce-ee17792ff0f0","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-213-19-11","docId":"75","text":"\u003Cp\u003EThe City shall promptly send a complete copy of any application for a permit required by this division to the health officer for review and shall not issue a permit until the City Manager receives and considers the advice of the health officer.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"1577425c-576f-4124-8105-eece4c527de3","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/7f7f4fe2-8ad6-45c9-b05c-4c346c9a1557","ref":{"parent":"184717ec-cc93-4b7a-ac98-2ac7b7219ee2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-213-210","docId":"75","text":"8.11.090 Same\u2013Notification.","id":"7f7f4fe2-8ad6-45c9-b05c-4c346c9a1557","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/7f7f4fe2-8ad6-45c9-b05c-4c346c9a1557\/8cb2f697-027b-4863-becc-ae23662480e0","ref":{"parent":"7f7f4fe2-8ad6-45c9-b05c-4c346c9a1557","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-213-210-11","docId":"75","text":"\u003Cp\u003EAt least ten days before granting any application for a permit required by this division, the City shall give written notices describing the application. The notice shall be posted in one location readily visible to the public on, or reasonably near to the parcel of land where the animals are proposed to be kept, and mailed addressed to the owner of each other parcel of land any part of which is within three hundred feet of the parcel of land where the animals are proposed to be kept. The mailed notices shall be addressed to the owners of neighboring parcels as shown on the latest County equalized assessment roll.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"8cb2f697-027b-4863-becc-ae23662480e0","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/5e1115ad-bbb8-4dab-9989-6bbc68ec2ba6","ref":{"parent":"184717ec-cc93-4b7a-ac98-2ac7b7219ee2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-213-211","docId":"75","text":"8.11.100 Standards for Issuance.","id":"5e1115ad-bbb8-4dab-9989-6bbc68ec2ba6","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/5e1115ad-bbb8-4dab-9989-6bbc68ec2ba6\/6b82054e-c0f6-441d-88d0-520ce645dba9","ref":{"parent":"5e1115ad-bbb8-4dab-9989-6bbc68ec2ba6","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-213-211-11","docId":"75","text":"\u003Cp\u003EThe City Manager will issue a permit for keeping pet horses other than on the same premises as, and incidental to the use of a single-family residence, or for holding an amateur horse event if the City Manager finds, after taking into account:\u003C\/p\u003E\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EThe size and location of the premises where the horses would be kept or the event held,\u003C\/li\u003E\u003Cli\u003EThe character of the neighborhood,\u003C\/li\u003E\u003Cli\u003EThe number of horses involved,\u003C\/li\u003E\u003Cli\u003EThe facilities existing and to be provided on the premises,\u003C\/li\u003E\u003Cli\u003EIn appropriate instances, the provision for parking for guests or spectators so that the horses will be treated safely and humanely and that there will be no adverse effects on the safety or health of persons and that there will be no detrimental effect on or change of character of the neighborhood, nor any disturbance of persons in the peaceful enjoyment of their property. If the City Manager does not so find, the permit shall not be issued.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"6b82054e-c0f6-441d-88d0-520ce645dba9","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/aaff3577-602b-447e-a41e-cee4c42f765a","ref":{"parent":"184717ec-cc93-4b7a-ac98-2ac7b7219ee2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-213-212","docId":"75","text":"8.11.110 Contents.","id":"aaff3577-602b-447e-a41e-cee4c42f765a","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/aaff3577-602b-447e-a41e-cee4c42f765a\/5c466457-2899-4028-932b-9b89eed16c92","ref":{"parent":"aaff3577-602b-447e-a41e-cee4c42f765a","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-213-212-11","docId":"75","text":"\u003Cp\u003EThe City Manager may include such conditions in the permit as are reasonably necessary to assure that the standards of Section 8.11.070 are met. When the permit is for an event, it shall specify the date of the event. When reasonably necessary to fulfill the standards of Section 8.11.070, the permit shall contain an expiration date, and specify the terms, if any, on which renewal will be permitted.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"5c466457-2899-4028-932b-9b89eed16c92","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/5bde97a0-c86a-4aed-b04f-da131ed20050","ref":{"parent":"184717ec-cc93-4b7a-ac98-2ac7b7219ee2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-213-213","docId":"75","text":"8.11.120 Modification or Revocation.","id":"5bde97a0-c86a-4aed-b04f-da131ed20050","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/5bde97a0-c86a-4aed-b04f-da131ed20050\/ab242043-bd2b-4440-a7af-64853ae9d058","ref":{"parent":"5bde97a0-c86a-4aed-b04f-da131ed20050","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-213-213-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003EAt any time when the City Manager has reasonable cause to believe that a permit issued under this article ought to be modified or revoked, the City Manager shall give mailed notice to the permittee and the owners of neighboring land specified in Section 8.11.090, in the manner specified in Section 8.11.090, for mailed notice, except that such notice period shall be fifteen days. Before modifying or revoking a permit, the City Manager shall consider all evidence presented by the permittee and any other person.\u003C\/li\u003E\u003Cli\u003EThe City Manager shall revoke or modify a permit when the City Manager finds that such revocation or modification is necessary to amend the standards specified in Section 8.11.090.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"ab242043-bd2b-4440-a7af-64853ae9d058","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/ac30007f-a566-4089-8477-b0cd082beb3e","ref":{"parent":"184717ec-cc93-4b7a-ac98-2ac7b7219ee2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-213-214","docId":"75","text":"8.11.130 Appeal.","id":"ac30007f-a566-4089-8477-b0cd082beb3e","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/ac30007f-a566-4089-8477-b0cd082beb3e\/55d880c7-ef32-4fa7-bb40-dcbd90018c51","ref":{"parent":"ac30007f-a566-4089-8477-b0cd082beb3e","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-213-214-11","docId":"75","text":"\u003Cp\u003EAny interested person may appeal a decision of the City Manager under this chapter by filing an appeal with the City Council in the manner provided in Section 8.02.080 of the Municipal Code.\u003Cbr\u003E (Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"55d880c7-ef32-4fa7-bb40-dcbd90018c51","prev_id":null}]},{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/d5ba90c2-d025-4df1-93c0-f46006974d2a","ref":{"parent":"184717ec-cc93-4b7a-ac98-2ac7b7219ee2","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"19-213-215","docId":"75","text":"8.11.140 Penalty.","id":"d5ba90c2-d025-4df1-93c0-f46006974d2a","children":[{"path":"\/04eb8158-de18-4e01-842e-004517c865c6\/184717ec-cc93-4b7a-ac98-2ac7b7219ee2\/d5ba90c2-d025-4df1-93c0-f46006974d2a\/e41303da-d0eb-4639-87fb-fb04dff9ff0b","ref":{"parent":"d5ba90c2-d025-4df1-93c0-f46006974d2a","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"19-213-215-11","docId":"75","text":"\u003Cp\u003EExcept where otherwise specified, any person who violates any of the provisions of this chapter shall be guilty of a misdemeanor and, upon conviction thereof, shall be punished as provided in Chapter 1.12.\u003Cbr\u003E (Ord. 1886, (part), 2001; Ord. 1644, \u00a7 2 (part), 1994)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"e41303da-d0eb-4639-87fb-fb04dff9ff0b","prev_id":null}]}]}]}]