c-b5ae-3a32a8da14db","prev_id":null}]}]}]},{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/c47f6b40-56c5-4201-8648-15cb1f20df43","ref":{"parent":"d3ef8742-594e-4e92-bb0d-0fbb09d855bd","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"220-210","docId":"75","text":"CHAPTER 19.32: RESIDENTIAL DUPLEX (R-2) ZONES","id":"c47f6b40-56c5-4201-8648-15cb1f20df43","children":[{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/c47f6b40-56c5-4201-8648-15cb1f20df43\/3a4520c2-cb6d-4aba-8a83-3e1cef69a402","ref":{"parent":"c47f6b40-56c5-4201-8648-15cb1f20df43","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"220-210-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"3a4520c2-cb6d-4aba-8a83-3e1cef69a402","prev_id":null},{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/c47f6b40-56c5-4201-8648-15cb1f20df43\/dc244e86-5c70-4819-ab47-1bf0b9bb5d7c","ref":{"parent":"c47f6b40-56c5-4201-8648-15cb1f20df43","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"220-210-12","docId":"75","text":"19.32.010 Purpose.","id":"dc244e86-5c70-4819-ab47-1bf0b9bb5d7c","children":[{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/c47f6b40-56c5-4201-8648-15cb1f20df43\/dc244e86-5c70-4819-ab47-1bf0b9bb5d7c\/f92a569b-e101-42b8-998a-1adc1c7eae82","ref":{"parent":"dc244e86-5c70-4819-ab47-1bf0b9bb5d7c","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"220-210-12-11","docId":"75","text":"\u003Cp\u003EThe residential duplex zoning district is intended to allow a second dwelling unit under the same ownership as the initial dwelling unit. The residential duplex district is intended to increase the variety of housing opportunities within the community while maintaining the existing neighborhood character.\u003C\/p\u003E\u003Cp\u003E(Ord. 16-2149, \u00a7 7, 2016; Ord. 2085, \u00a7 2 (part), 2011; Ord. 1601, Exh. A (part), 1992)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f92a569b-e101-42b8-998a-1adc1c7eae82","prev_id":null}]},{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/c47f6b40-56c5-4201-8648-15cb1f20df43\/0fc8f7e5-48eb-45a7-8b1d-a2998aae731e","ref":{"parent":"c47f6b40-56c5-4201-8648-15cb1f20df43","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"220-210-13","docId":"75","text":"19.32.020 Applicability of Regulations.","id":"0fc8f7e5-48eb-45a7-8b1d-a2998aae731e","children":[{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/c47f6b40-56c5-4201-8648-15cb1f20df43\/0fc8f7e5-48eb-45a7-8b1d-a2998aae731e\/7a655985-b73f-480d-b90b-45aa55c00194","ref":{"parent":"0fc8f7e5-48eb-45a7-8b1d-a2998aae731e","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"220-210-13-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ENo building, structure or land shall be hereafter erected, structurally altered or enlarged in an R-2 residential duplex district other than in conformance with the provisions of this chapter and other applicable provisions of this title.\u003C\/li\u003E\u003Cli\u003EReasonable Accommodation: Notwithstanding 19.32.020(A) above, a request for reasonable accommodation may be made by any person with a disability, when the strict application of the provisions in this chapter, acts as a barrier to fair housing opportunities, pursuant to Chapter 19.52.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 2085, \u00a7 2 (part), 2011; Ord. 2056, (part), 2010; Ord. 1601, Exh. A (part), 1992)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"7a655985-b73f-480d-b90b-45aa55c00194","prev_id":null}]},{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/c47f6b40-56c5-4201-8648-15cb1f20df43\/ceb0b178-0f0d-4ac5-83dd-ad58821d693c","ref":{"parent":"c47f6b40-56c5-4201-8648-15cb1f20df43","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"220-210-14","docId":"75","text":"19.32.030 Permitted, Conditional and Excluded Uses.","id":"ceb0b178-0f0d-4ac5-83dd-ad58821d693c","children":[{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/c47f6b40-56c5-4201-8648-15cb1f20df43\/ceb0b178-0f0d-4ac5-83dd-ad58821d693c\/0bc3d896-3fcf-4d41-bdab-a1a5b021585b","ref":{"parent":"ceb0b178-0f0d-4ac5-83dd-ad58821d693c","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"220-210-14-11","docId":"75","text":"\u003Cp\u003EPermitted, Conditional and Excluded Uses that may be conducted from property zoned Residential Duplex (R-2), are identified in Section 19.20.020.\u003C\/p\u003E\u003Cp\u003E(Ord. 2085, \u00a7 2 (part), 2011)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"0bc3d896-3fcf-4d41-bdab-a1a5b021585b","prev_id":null}]},{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/c47f6b40-56c5-4201-8648-15cb1f20df43\/98f6c1b5-f7f1-4006-8c42-2474ab73fb2a","ref":{"parent":"c47f6b40-56c5-4201-8648-15cb1f20df43","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"220-210-15","docId":"75","text":"19.32.040 Permits Required for Development.","id":"98f6c1b5-f7f1-4006-8c42-2474ab73fb2a","children":[{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/c47f6b40-56c5-4201-8648-15cb1f20df43\/98f6c1b5-f7f1-4006-8c42-2474ab73fb2a\/322e5f75-9cc0-4079-9a24-cac2fb6e5487","ref":{"parent":"98f6c1b5-f7f1-4006-8c42-2474ab73fb2a","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"220-210-15-11","docId":"75","text":"\u003Cp\u003ENo building, structure or sign shall be erected, structurally altered, or enlarged, nor shall any landscaping or parking plan be implemented or modified in an R-2 zone, without permits pursuant to Chapter 19.12 and 19.168 of the municipal code.\u003C\/p\u003E\u003Cp\u003E(Ord. 2085, \u00a7 2 (part), 2011)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"322e5f75-9cc0-4079-9a24-cac2fb6e5487","prev_id":null}]},{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/c47f6b40-56c5-4201-8648-15cb1f20df43\/ac95cf73-91e8-4d9f-99c2-7c6d35a1afb4","ref":{"parent":"c47f6b40-56c5-4201-8648-15cb1f20df43","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h4"},"pos":"220-210-16","docId":"75","text":"19.32.050 Site Development Regulations.","id":"ac95cf73-91e8-4d9f-99c2-7c6d35a1afb4","children":[{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/c47f6b40-56c5-4201-8648-15cb1f20df43\/ac95cf73-91e8-4d9f-99c2-7c6d35a1afb4\/eeeed0c5-3ac2-42e7-9653-45565ca5d411","ref":{"parent":"ac95cf73-91e8-4d9f-99c2-7c6d35a1afb4","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"220-210-16-11","docId":"75","text":"\u003Cp\u003ETable 19.32.050 sets forth the rules and regulations pertaining to the site development of property zoned residential duplex (R-2).\u003C\/p\u003E","id":"eeeed0c5-3ac2-42e7-9653-45565ca5d411","prev_id":null},{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/c47f6b40-56c5-4201-8648-15cb1f20df43\/ac95cf73-91e8-4d9f-99c2-7c6d35a1afb4\/a7ccd9f7-2595-47e8-a1f0-f3ad8d91f8c3","ref":{"parent":"ac95cf73-91e8-4d9f-99c2-7c6d35a1afb4","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h5"},"pos":"220-210-16-12","docId":"75","text":"Table 19.32.050: Site Development Regulations","id":"a7ccd9f7-2595-47e8-a1f0-f3ad8d91f8c3","children":[{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/c47f6b40-56c5-4201-8648-15cb1f20df43\/ac95cf73-91e8-4d9f-99c2-7c6d35a1afb4\/a7ccd9f7-2595-47e8-a1f0-f3ad8d91f8c3\/f3332f63-1c6e-4194-9298-b32028e55763","ref":{"parent":"a7ccd9f7-2595-47e8-a1f0-f3ad8d91f8c3","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"220-210-16-12-11","docId":"75","text":"\u003Ctable\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Ctd colspan=\u00222\u0022 style=\u0022background-color:#f9f9f9\u0022\u003EA. Lot size:\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003Cp style=\u0022margin-left:40px\u0022\u003E1. Minimum lot size\u003C\/p\u003E\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E8,500 square feet\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp style=\u0022margin-left:40px\u0022\u003E2. Minimum lot size by zoning district symbol:\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003ELot area shall correspond to the number (multiplied by two thousand square feet) following the R-2 symbol.Example: R2-4.25: Minimum lot size of 8,500 square feet (4.25 * 2,000 s.f.)\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd colspan=\u00222\u0022\u003EB. Alternative standards to 19.32.060 (A)\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp style=\u0022margin-left:40px\u0022\u003E1. Legal non-conforming lots\u003C\/p\u003E\u003C\/td\u003E\u003Ctd\u003EExisting legal lots of record must be 7,500 square feet and fulfill all other applicable requirements of this title.\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003Cp style=\u0022margin-left:40px\u0022\u003E2. If 50% of more of net lot area is adjacent to a curvilinear street\u003C\/p\u003E\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003EReduction in minimum lot size of no more 5% of the net lot area is permitted\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd colspan=\u00222\u0022 style=\u0022background-color:#f9f9f9\u0022\u003EC. Lot Width at building setback line\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003Cp style=\u0022margin-left:40px\u0022\u003E1. Minimum width\u003C\/p\u003E\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E70 feet\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp style=\u0022margin-left:40px\u0022\u003E2. Lots with 9,000 square feet or more and which front a cul-de-sac\u003C\/p\u003E\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E60 feet\u003C\/td\u003E\u003C\/tr\u003E\u003C\/tbody\u003E\u003C\/table\u003E\u003Cp\u003E(Ord. 2085, \u00a7 2 (part), 2011)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"f3332f63-1c6e-4194-9298-b32028e55763","prev_id":null}]}]},{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/c47f6b40-56c5-4201-8648-15cb1f20df43\/a65ce45b-4855-41d9-9ca9-7b4d11662e54","ref":{"parent":"c47f6b40-56c5-4201-8648-15cb1f20df43","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h4"},"pos":"220-210-17","docId":"75","text":"19.32.060 Building Development Regulations.","id":"a65ce45b-4855-41d9-9ca9-7b4d11662e54","children":[{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/c47f6b40-56c5-4201-8648-15cb1f20df43\/a65ce45b-4855-41d9-9ca9-7b4d11662e54\/dc0066e7-d8b8-4e2d-b22c-9ba9cd847ada","ref":{"parent":"a65ce45b-4855-41d9-9ca9-7b4d11662e54","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"220-210-17-11","docId":"75","text":"\u003Cp\u003ETable 19.32.060 sets forth the rules and regulations pertaining to the development of structures on property zoned residential duplex (R-2).\u003C\/p\u003E","id":"dc0066e7-d8b8-4e2d-b22c-9ba9cd847ada","prev_id":null},{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/c47f6b40-56c5-4201-8648-15cb1f20df43\/a65ce45b-4855-41d9-9ca9-7b4d11662e54\/b84e59fd-0f2f-44bc-bd31-f7b2fece2889","ref":{"parent":"a65ce45b-4855-41d9-9ca9-7b4d11662e54","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h5"},"pos":"220-210-17-12","docId":"75","text":"Table 19.32.060: Building Development Regulations","id":"b84e59fd-0f2f-44bc-bd31-f7b2fece2889","children":[{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/c47f6b40-56c5-4201-8648-15cb1f20df43\/a65ce45b-4855-41d9-9ca9-7b4d11662e54\/b84e59fd-0f2f-44bc-bd31-f7b2fece2889\/95edb6f4-38bd-4ee0-9d02-368b3ed2e3a1","ref":{"parent":"b84e59fd-0f2f-44bc-bd31-f7b2fece2889","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"220-210-17-12-11","docId":"75","text":"\u003Ctable\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#f9f9f9\u0022\u003EA. Maximum Lot Coverage by all permanent buildings\u003C\/td\u003E\u003Ctd colspan=\u00222\u0022 rowspan=\u00221\u0022 style=\u0022background-color:#f9f9f9\u0022\u003E40% of net lot area\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd colspan=\u00223\u0022\u003EB. Maximum Height\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp style=\u0022margin-left:40px\u0022\u003Ea. Buildings\u003C\/p\u003E\u003C\/td\u003E\u003Ctd colspan=\u00222\u0022 rowspan=\u00221\u0022\u003ETwo stories, not exceeding 30 feet\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003Cp style=\u0022margin-left:40px\u0022\u003Eb. Zoning districts with \u0022i\u0022 suffix *\u003C\/p\u003E\u003C\/td\u003E\u003Ctd colspan=\u00222\u0022 rowspan=\u00221\u0022 style=\u0022background-color:#ffffff\u0022\u003ELimited to one story (not to exceed 18 feet)\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Cp style=\u0022margin-left:40px\u0022\u003Ec. Accessory Structures\u003C\/p\u003E\u003C\/td\u003E\u003Ctd colspan=\u00222\u0022 rowspan=\u00221\u0022\u003ELimited to one story (not to exceed 15 feet) and must comply with all other regulations in Chapter 19.100\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003EC. Fences\u003C\/td\u003E\u003Ctd colspan=\u00222\u0022 rowspan=\u00221\u0022\u003EMust comply with regulations in Chapter 19.48\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#f9f9f9\u0022\u003ED. Parking\u003C\/td\u003E\u003Ctd colspan=\u00222\u0022 rowspan=\u00221\u0022 style=\u0022background-color:#f9f9f9\u0022\u003EMust comply with regulations in Chapter 19.124\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd\u003EE. Minimum Setbacks\u003C\/td\u003E\u003Ctd\u003EFirst Floor\u003C\/td\u003E\u003Ctd\u003ESecond Floor\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003Cp style=\u0022margin-left:40px\u0022\u003Ea. Front Yard\u003C\/p\u003E\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003Cp style=\u0022margin-left:80px\u0022\u003Ei. Minimum Setback\u003C\/p\u003E\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E20 feet\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E20 feet\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003Cp style=\u0022margin-left:80px\u0022\u003Eii. Side entering garage with curved driveway\u003C\/p\u003E\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E15 feet\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E20 feet\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003Cp style=\u0022margin-left:40px\u0022\u003Eb. Side yard\u003C\/p\u003E\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003Cp style=\u0022margin-left:80px\u0022\u003Ei. Interior side\u003C\/p\u003E\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E20% of lot width measured at front setback line and not less than six feet\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003EAt least three feet more than first floor setback\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003Cp style=\u0022margin-left:80px\u0022\u003Eii. Street side\u003C\/p\u003E\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E12 feet\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E15 feet\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003Cp style=\u0022margin-left:40px\u0022\u003Ec. Rear yard\u003C\/p\u003E\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E20 feet or no less than 20% of the lot depth, whichever is greater. May be reduced to 10 feet provided that the required rear-yard setback area is no less than eight hundred fifty square feet or twenty times of the lot width.\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E20% of lot depth\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd colspan=\u00223\u0022 style=\u0022background-color:#f9f9f9\u0022\u003EF. Second Story Decks and Patios Minimum Setbacks\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003Cp style=\u0022margin-left:40px\u0022\u003Ea. Front Yard\u003C\/p\u003E\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E-\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E17 feet\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003Cp style=\u0022margin-left:40px\u0022\u003Eb. Side Yard\u003C\/p\u003E\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E-\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E15 feet\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003Cp style=\u0022margin-left:40px\u0022\u003Ec. Rear Yard\u003C\/p\u003E\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E-\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E20 feet\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd colspan=\u00223\u0022 style=\u0022background-color:#f9f9f9\u0022\u003EG. Permitted Encroachments into a required yard setback area\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003Cp style=\u0022margin-left:40px\u0022\u003Ea. Cornices, canopies, coves, decks (more than 18 inches above finished grade) and other architectural features\u003C\/p\u003E\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003ENo more than 2 feet 6 inches\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff; white-space:nowrap\u0022\u003ENo more than 2 feet 6 inches\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003Cp style=\u0022margin-left:40px\u0022\u003Eb. Unenclosed patio covers in a rear-yard\u003C\/p\u003E\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003EAs allowed by Chapter 19.100 (Accessory Structures)\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E-\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd colspan=\u00223\u0022 style=\u0022background-color:#f9f9f9\u0022\u003E\u003Cstrong\u003ENotes:\u003C\/strong\u003E* - Pertains to all buildings in a designated area as prescribed by the City Council by affixing the designation \u0022i\u0022 to the zoning district symbol.\u003C\/td\u003E\u003C\/tr\u003E\u003C\/tbody\u003E\u003C\/table\u003E\u003Cp\u003E(Ord. 2085, \u00a7 2 (part), 2011)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"95edb6f4-38bd-4ee0-9d02-368b3ed2e3a1","prev_id":null}]}]}]},{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/77a78802-fde8-45ee-80bb-96a80f7f5cee","ref":{"parent":"d3ef8742-594e-4e92-bb0d-0fbb09d855bd","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":1,"tag":"h3"},"pos":"220-211","docId":"75","text":"CHAPTER 19.36: MULTIPLE-FAMILY RESIDENTIAL (R-3) ZONES","id":"77a78802-fde8-45ee-80bb-96a80f7f5cee","children":[{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/77a78802-fde8-45ee-80bb-96a80f7f5cee\/77a88fb7-07b9-469f-abab-8bc615badb1b","ref":{"parent":"77a78802-fde8-45ee-80bb-96a80f7f5cee","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"220-211-11","docId":"75","text":"\u003Cp\u003E\u003C\/p\u003E","id":"77a88fb7-07b9-469f-abab-8bc615badb1b","prev_id":null},{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/77a78802-fde8-45ee-80bb-96a80f7f5cee\/ba932002-9bfd-448b-965e-67911d7a424d","ref":{"parent":"77a78802-fde8-45ee-80bb-96a80f7f5cee","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"220-211-12","docId":"75","text":"19.36.010 Purpose.","id":"ba932002-9bfd-448b-965e-67911d7a424d","children":[{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/77a78802-fde8-45ee-80bb-96a80f7f5cee\/ba932002-9bfd-448b-965e-67911d7a424d\/bad84307-fb0d-4d62-bfd9-883c84e43292","ref":{"parent":"ba932002-9bfd-448b-965e-67911d7a424d","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"220-211-12-11","docId":"75","text":"\u003Cp\u003EThe purpose of this chapter is to provide a zoning district permitting medium, medium-high, and high density multiple-family residential uses and to establish the regulations pertaining thereto. These regulations are intended to guide future development and ensure a healthy functional environment for future residents within the proposed development and for and between adjoining parcels. The R-3 zoning district may be combined with the townhome (TH) zoning district in accordance with Chapter 19.46.\u003C\/p\u003E\u003Cp\u003E(Ord. 2085, \u00a7 2 (part), 2011; Ord. 1601, Exh. A (part), 1992; Ord. 24-2261, \u00a7 1 (part), 2024)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"bad84307-fb0d-4d62-bfd9-883c84e43292","prev_id":null}]},{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/77a78802-fde8-45ee-80bb-96a80f7f5cee\/f25c0d73-1890-4d8f-8de4-7173697532c5","ref":{"parent":"77a78802-fde8-45ee-80bb-96a80f7f5cee","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"220-211-13","docId":"75","text":"19.36.020 Applicability of Regulations.","id":"f25c0d73-1890-4d8f-8de4-7173697532c5","children":[{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/77a78802-fde8-45ee-80bb-96a80f7f5cee\/f25c0d73-1890-4d8f-8de4-7173697532c5\/c491a754-ef1f-4fe5-9544-e5105d6acd22","ref":{"parent":"f25c0d73-1890-4d8f-8de4-7173697532c5","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"220-211-13-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ENo building, structure, or land shall be used, and no building or structure shall be hereafter erected, structurally altered, or enlarged in a R-3 zoning district other than in conformance with the provisions of this chapter and other applicable provisions of this title.\u003C\/li\u003E\u003Cli\u003EReasonable Accommodation: Notwithstanding 19.36.020(A) above, a request for reasonable accommodation may be made by any person with a disability, when the strict application of the provisions in this chapter acts as a barrier to fair housing opportunities, pursuant to Chapter 19.52.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 2085, \u00a7 2 (part), 2011; Ord. 2056, (part), 2010; Ord. 1601, Exh. A (part), 1992; Ord. 24-2261, \u00a7 1 (part), 2024)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"c491a754-ef1f-4fe5-9544-e5105d6acd22","prev_id":null}]},{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/77a78802-fde8-45ee-80bb-96a80f7f5cee\/8bb10090-0218-4d60-903c-d6b652a3d69a","ref":{"parent":"77a78802-fde8-45ee-80bb-96a80f7f5cee","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"220-211-14","docId":"75","text":"19.36.030 Permitted, Conditional and Excluded Uses.","id":"8bb10090-0218-4d60-903c-d6b652a3d69a","children":[{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/77a78802-fde8-45ee-80bb-96a80f7f5cee\/8bb10090-0218-4d60-903c-d6b652a3d69a\/73ff5e61-ab51-4da4-89d9-ee9a05cea32b","ref":{"parent":"8bb10090-0218-4d60-903c-d6b652a3d69a","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"220-211-14-11","docId":"75","text":"\u003Cp\u003EPermitted, Conditional, and Excluded Uses on property zoned R-3 are identified in Section 19.20.020.\u003C\/p\u003E\u003Cp\u003E(Ord. 2085, \u00a7 2 (part), 2011; Ord. 24-2261, \u00a7 1 (part), 2024)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"73ff5e61-ab51-4da4-89d9-ee9a05cea32b","prev_id":null}]},{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/77a78802-fde8-45ee-80bb-96a80f7f5cee\/3e721314-1c53-4c68-b1d3-65fb0e584f98","ref":{"parent":"77a78802-fde8-45ee-80bb-96a80f7f5cee","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"220-211-15","docId":"75","text":"19.36.040 Development Plan Required.","id":"3e721314-1c53-4c68-b1d3-65fb0e584f98","children":[{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/77a78802-fde8-45ee-80bb-96a80f7f5cee\/3e721314-1c53-4c68-b1d3-65fb0e584f98\/72f8406f-6ed2-4733-b6ef-28b3c5619d86","ref":{"parent":"3e721314-1c53-4c68-b1d3-65fb0e584f98","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"220-211-15-11","docId":"75","text":"\u003Cp\u003EAn application for development on a parcel presently zoned R-3 shall require submittal of all materials identified in Chapter 19.12. The Community Development Director may establish development plan application requirements beyond those required by Chapter 19.12.\u003C\/p\u003E\u003Cp\u003E(Ord. 2085, \u00a7 2 (part), 2011; Ord. 24-2261, \u00a7 1 (part), 2024)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"72f8406f-6ed2-4733-b6ef-28b3c5619d86","prev_id":null}]},{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/77a78802-fde8-45ee-80bb-96a80f7f5cee\/393bc053-2f28-4042-bdff-e5704851f08e","ref":{"parent":"77a78802-fde8-45ee-80bb-96a80f7f5cee","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"220-211-16","docId":"75","text":"19.36.050 Permit Required for Development.","id":"393bc053-2f28-4042-bdff-e5704851f08e","children":[{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/77a78802-fde8-45ee-80bb-96a80f7f5cee\/393bc053-2f28-4042-bdff-e5704851f08e\/e4e89335-9d00-4560-8e81-f49fc507c5f6","ref":{"parent":"393bc053-2f28-4042-bdff-e5704851f08e","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"220-211-16-11","docId":"75","text":"\u003Col class=\u0022default-style\u0022 style=\u0022list-style-type:upper-alpha\u0022\u003E\u003Cli\u003ENo building permit may be issued for development on a parcel presently zoned R-3 until a development plan is approved as part of a development permit pursuant to Chapters 19.12 and 19.156. Housing development projects on Priority Housing Sites considered by-right pursuant to state law shall be processed as identified in Table 19.12.030.\u003C\/li\u003E\u003Cli\u003ESigns, landscaping or parking plans and minor modifications to buildings may not be erected, structurally altered, enlarged or modified without permits pursuant to Chapters 19.12 and 19.168.\u003C\/li\u003E\u003C\/ol\u003E\u003Cp\u003E(Ord. 2085, \u00a7 2 (part), 2011; Ord. 24-2261, \u00a7 1 (part), 2024)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"e4e89335-9d00-4560-8e81-f49fc507c5f6","prev_id":null}]},{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/77a78802-fde8-45ee-80bb-96a80f7f5cee\/34abb8d9-9087-402f-9567-dbf90f4016df","ref":{"parent":"77a78802-fde8-45ee-80bb-96a80f7f5cee","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"220-211-17","docId":"75","text":"19.36.060 Site Development Regulations.","id":"34abb8d9-9087-402f-9567-dbf90f4016df","children":[{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/77a78802-fde8-45ee-80bb-96a80f7f5cee\/34abb8d9-9087-402f-9567-dbf90f4016df\/4d85fd17-2f08-4630-ba1a-a4fde386c839","ref":{"parent":"34abb8d9-9087-402f-9567-dbf90f4016df","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"220-211-17-11","docId":"75","text":"\u003Cp\u003ETable 19.36.060 sets forth the rules and regulations pertaining to the Development Regulations for the development of property zoned multiple-family residential (R-3).\u003C\/p\u003E\u003Ctable border=\u00221\u0022 style=\u0022width:800px\u0022\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Ctd colspan=\u00222\u0022 style=\u0022background-color:#dddddd\u0022\u003ETable 19.36.060 Site Development Regulations\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#f9f9f9\u0022\u003EA. Density \u2013 Maximum number of units cannot exceed that allowed by the General Plan\u003C\/td\u003E\u003Ctd style=\u0022background-color:#f9f9f9\u0022\u003E\u003Col\u003E\u003Cli\u003EMaximum as designated in the General Plan.\u003C\/li\u003E\u003Cli\u003EDevelopment on sites with a minimum density shall meet the minimum density established on the General Plan Land Use map.\u003C\/li\u003E\u003C\/ol\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E\u003Cp\u003EB. Minimum Net Lot Area\u003C\/p\u003E\u003C\/td\u003E\u003Ctd style=\u0022background-color:#ffffff\u0022\u003E9,300 square feet\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#f9f9f9\u0022\u003EC. Minimum Lot Width (measured at front building setback line)\u003C\/td\u003E\u003Ctd style=\u0022background-color:#f9f9f9\u0022\u003E70 feet\u003C\/td\u003E\u003C\/tr\u003E\u003C\/tbody\u003E\u003C\/table\u003E\u003Cp\u003E(Ord. 2085, \u00a7 2 (part), 2011; Ord. 24-2261, \u00a7 1 (part), 2024)\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"4d85fd17-2f08-4630-ba1a-a4fde386c839","prev_id":null}]},{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/77a78802-fde8-45ee-80bb-96a80f7f5cee\/806f3600-e7c7-47b5-868f-042708e0b3db","ref":{"parent":"77a78802-fde8-45ee-80bb-96a80f7f5cee","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h4"},"pos":"220-211-18","docId":"75","text":"19.36.070 Building Development Regulations.","id":"806f3600-e7c7-47b5-868f-042708e0b3db","children":[{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/77a78802-fde8-45ee-80bb-96a80f7f5cee\/806f3600-e7c7-47b5-868f-042708e0b3db\/be15cbd2-5082-467c-887d-6287cebee136","ref":{"parent":"806f3600-e7c7-47b5-868f-042708e0b3db","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"220-211-18-11","docId":"75","text":"\u003Cp\u003ETable 19.36.070 sets forth the rules and regulations pertaining to the development of structures on property zoned multiple-family residential (R-3).\u003C\/p\u003E\u003Ctable border=\u00221\u0022 cellpadding=\u00221\u0022 cellspacing=\u00221\u0022 style=\u0022width:1000px\u0022\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Ctd style=\u0022background-color:#dddddd; text-align:center\u0022\u003E\u003Cstrong\u003E\u003Cspan style=\u0022color:#000000\u0022\u003ETable 19.36.070: Building Development Regulations\u003C\/span\u003E\u003C\/strong\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003C\/tbody\u003E\u003C\/table\u003E\u003Ctable border=\u00221\u0022 cellspacing=\u00220\u0022 style=\u0022border-collapse:collapse; width:1000px\u0022\u003E\u003Cthead\u003E\u003C\/thead\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Cth style=\u0022background-color:#dddddd; border-color:#000000; height:13px; vertical-align:top; width:120px\u0022\u003E\u003Cp\u003E\u003C\/p\u003E\u003C\/th\u003E\u003Cth colspan=\u00223\u0022 style=\u0022background-color:#dddddd; border-color:#000000; vertical-align:top; width:400px\u0022\u003E\u003Cp align=\u0022center\u0022 style=\u0022text-align:center\u0022\u003E\u003Cstrong\u003E\u003Cspan style=\u0022color:#000000\u0022\u003EProjects with up to four units\u003C\/span\u003E\u003C\/strong\u003E\u003C\/p\u003E\u003C\/th\u003E\u003Cth colspan=\u00223\u0022 style=\u0022background-color:#dddddd; border-color:#000000; vertical-align:top; width:400px\u0022\u003E\u003Cp align=\u0022center\u0022 style=\u0022text-align:center\u0022\u003E\u003Cstrong\u003E\u003Cspan style=\u0022color:#000000\u0022\u003EProjects with five or more units\u003C\/span\u003E\u003C\/strong\u003E\u003C\/p\u003E\u003C\/th\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022border-bottom:1.0px solid #000000; border-left:1.0px solid #000000; border-right:1.0px solid #000000; border-top:1.0px solid #000000; height:26.0px; vertical-align:top; width:120.0px\u0022\u003E\u003Cp\u003E\u003Cspan style=\u0022color:#000000\u0022\u003EA. Maximum Lot Coverage\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd colspan=\u00223\u0022 style=\u0022border-bottom:1.0px solid #000000; border-left:1.0px solid #000000; border-right:1.0px solid #000000; border-top:1.0px solid #000000; height:26.0px; vertical-align:top; width:185.0px\u0022\u003E\u003Cp\u003E\u003Cspan style=\u0022color:#000000\u0022\u003E50% of net lot area, unless inconsistent with Govt. Section 65913.11\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd colspan=\u00223\u0022 style=\u0022border-bottom:1.0px solid #000000; border-left:1.0px solid #000000; border-right:1.0px solid #000000; border-top:1.0px solid #000000; height:26.0px; vertical-align:top; width:212.0px\u0022\u003E\u003Cp\u003E\u003Cspan style=\u0022color:#000000\u0022\u003E55% of net lot area, unless inconsistent with Govt. Section 65913.11\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003C\/tr\u003E\u003Ctr\u003E\u003Ctd style=\u0022border-bottom:1.0px solid #000000; border-left:1.0px solid #000000; border-right:1.0px solid #000000; border-top:1.0px solid #000000; height:26.0px; vertical-align:top; width:120.0px\u0022\u003E\u003Cp\u003E\u003Cspan style=\u0022color:#000000\u0022\u003EB. Maximum Height\u003C\/span\u003E\u003C\/p\u003E\u003C\/td\u003E\u003Ctd colspan=\u00223\u0022 style=\u0022border-bottom:1.0px solid #000000; border-left:1.0px solid #000000; border-right:1.0px solid #000000; border-top:1.0px solid #000000; height:26.0px; vertical-align:top; width:185.0px\u0022\u003E\u003Cp\u003E\u003Cspan style=\u0022color:#000000\u0022\u003