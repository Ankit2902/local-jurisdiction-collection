fRVMlM\/mB+Ln\/AAQt\/by+KPwxtNDvPg5JcTaHf\/aLeV\/GWgySakZTKZ553e8LvKf3Y3O5ODgdOPGU\/wCDZH9ulXaZvgcskshO7PjDw8CMnOQRfepr+uSiso0krovnZ\/Jn4S\/4NoP23pPEOnw6v8EphpSSkSN\/wm2gkwKRjeAL4kkcHGD0rW8ef8Gyf7Y8N1PHoXwduLiAyW5EknjHQw0uYx5rHN6OVfOOO\/Ga\/q2oodGN7g5u1j+U\/wAK\/wDBtR+2doWtadv+Dk8lgsxnuo28YaDsZlKsuQLzkEqhxzjb713fiL\/g37\/bM17TEtL34OJqUNq8wjVvFWhxK8e\/eiALeAKhbBI9VGa\/p1orKrg6c5KT6GcVZ3R\/JLq3\/Bsj+2+2q3T23wMU2srkxIfGOgHywR93JvskDoM9K\/cr\/g2e\/YP+KP8AwT0\/YN8U+C\/i34YPhPxNqvju71uCzOpWl\/vtZNP06FZPMtpZUGXt5RtLBhtzjBBP6IUV0pWLcrhRRRTJP\/\/Z\u0022 width=\u0022288\u0022\u003E\u003C\/a\u003E\u003C\/span\u003E\u003C\/span\u003E\u003C\/p\u003E\u003Cp\u003E\u003C\/p\u003E","id":"84190a51-12d5-43c6-a489-3f35feb76543","prev_id":null}]},{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/5299dbbe-f86d-44d4-91de-518c1565ca8e\/3e5980c9-309a-490e-8f07-058d594cecb8\/b515b8b0-c2f0-4b71-9763-7792eb5ec305","ref":{"parent":"3e5980c9-309a-490e-8f07-058d594cecb8","name":"subsection"},"li_attr":{"dataTag":"subsection","hasChildren":2,"tag":"h5"},"pos":"220-19-14-16","docId":"75","text":"Italian Villa Style","id":"b515b8b0-c2f0-4b71-9763-7792eb5ec305","children":[{"path":"\/d3ef8742-594e-4e92-bb0d-0fbb09d855bd\/5299dbbe-f86d-44d4-91de-518c1565ca8e\/3e5980c9-309a-490e-8f07-058d594cecb8\/b515b8b0-c2f0-4b71-9763-7792eb5ec305\/ef47bb61-264f-4290-9399-5e482dc9c538","ref":{"parent":"b515b8b0-c2f0-4b71-9763-7792eb5ec305","name":"subsection"},"li_attr":{"dataTag":"BodyM","hasChildren":0},"pos":"220-19-14-16-11","docId":"75","text":"\u003Cp\u003EDISTINGUISHING FEATURES\u003C\/p\u003E\u003Cp\u003EItalian Villa Style homes are characterized in the Bay Area a wide variety of forms and details drawn from a variety of common Italian styles. They are frequently formal in their facade design, and often symmetrical with accentuated windows and entries.\u003C\/p\u003E\u003Col\u003E\u003Cli\u003ELow pitched hip roof\u003C\/li\u003E\u003Cli\u003EWide roof eaves, often with formal supporting brackets\u003C\/li\u003E\u003Cli\u003ESymmetrical or asymmetrical front facade window patterns well-organized around a projecting formal entry with Italianate columns\u003C\/li\u003E\u003Cli\u003ETall first floor windows\u003C\/li\u003E\u003Cli\u003EDeep set windows in grouped patterns\u003C\/li\u003E\u003Cli\u003EArched window heads and\/or accentuated trim above the windows\u003C\/li\u003E\u003Cli\u003EProjecting or recessed entries with Italianate columns and\/or trim\u003C\/li\u003E\u003Cli\u003EProjecting window heads, jambs and sills\u003C\/li\u003E\u003Cli\u003EArticulated belt and trim courses\u003C\/li\u003E\u003C\/ol\u003E\u003Cp class=\u0022MsoBodyText\u0022 style=\u0022margin-bottom:12px; margin-left:12px; margin-right:12px; margin-top:12px\u0022\u003E\u003Cspan style=\u0022font-size:12pt\u0022\u003E\u003Cspan style=\u0022font-family:Cambria,serif\u0022\u003E\u003Ca\u003E\u003Cimg alt=\u0022\u0022 height=\u0022278\u0022 src=\u0022data:image\/jpeg;base64,\/9j\/4AAQSkZJRgABAQEAYABgAAD\/2wBDAAIBAQIBAQICAgICAgICAwUDAwMDAwYEBAMFBwYHBwcGBwcICQsJCAgKCAcHCg0KCgsMDAwMBwkODw0MDgsMDAz\/2wBDAQICAgMDAwYDAwYMCAcIDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAz\/wAARCAF1AagDASIAAhEBAxEB\/8QAHwAAAQUBAQEBAQEAAAAAAAAAAAECAwQFBgcICQoL\/8QAtRAAAgEDAwIEAwUFBAQAAAF9AQIDAAQRBRIhMUEGE1FhByJxFDKBkaEII0KxwRVS0fAkM2JyggkKFhcYGRolJicoKSo0NTY3ODk6Q0RFRkdISUpTVFVWV1hZWmNkZWZnaGlqc3R1dnd4eXqDhIWGh4iJipKTlJWWl5iZmqKjpKWmp6ipqrKztLW2t7i5usLDxMXGx8jJytLT1NXW19jZ2uHi4+Tl5ufo6erx8vP09fb3+Pn6\/8QAHwEAAwEBAQEBAQEBAQAAAAAAAAECAwQFBgcICQoL\/8QAtREAAgECBAQDBAcFBAQAAQJ3AAECAxEEBSExBhJBUQdhcRMiMoEIFEKRobHBCSMzUvAVYnLRChYkNOEl8RcYGRomJygpKjU2Nzg5OkNERUZHSElKU1RVVldYWVpjZGVmZ2hpanN0dXZ3eHl6goOEhYaHiImKkpOUlZaXmJmaoqOkpaanqKmqsrO0tba3uLm6wsPExcbHyMnK0tPU1dbX2Nna4uPk5ebn6Onq8vP09fb3+Pn6\/9oADAMBAAIRAxEAPwD90fjh8YtL+APwu1TxdrMF9cabpPledHZojzN5kyRLtDsqn5pATlhxnr0r5o0P\/gtd8Mdfvr22i8KfEyOaxWVnWTTLQF\/LOG2gXJJ\/z0r0H\/gqW0K\/sI+OjcWq3sQ\/s\/dC1u9wH\/4mNt\/AnzHB546Yz0Ffj54T8Vy+E\/Fmr6XqFvpniiGKZ4pLJrtrLULR