                        <p class="CellBody"><span class="bold">Key&nbsp;&nbsp;R = Rural Edge Treatment&nbsp;&nbsp;C = Curb Edge Treatment&nbsp;&nbsp;RB = Ribbon Curb (18&quot;)</span></p>

                        <p class="CellBody"><span class="bold">&nbsp;&nbsp;P = Permitted&nbsp;&nbsp;S = When Authorized by Staff&nbsp;&nbsp;-- = Not Permitted</span></p>

          </td>
        </tr>
