        <tr>
          <td style="padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">Master Valves &ndash; required on main line of irrigation system</p>

          </td>
          <td style="padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">Less than 2&quot;: Griswold Master Valve</p>

                        <p class="CellBody">- a pressure reducing valve is required</p>

                        <p class="CellBody">2&quot; or larger: Singer Model No. 106-PR-SC24V</p>

          </td>
        </tr>
        <tr>
          <td style="padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">Flow Sensor</p>

          </td>
          <td style="padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">Compatible with MaxiCom System. Required on main line of irrigation system.</p>

          </td>
        </tr>
      </table>
            <p class="HistoryNote">(Ord. 2017-22, Rep&amp;ReEn, 07/05/2017)</p>

