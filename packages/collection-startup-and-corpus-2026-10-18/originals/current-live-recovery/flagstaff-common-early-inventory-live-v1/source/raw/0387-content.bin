        </tr>
        <tr>
          <td style="padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">&nbsp;</p>

          </td>
          <td style="padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">PVC Cement: medium bodied, primer required</p>

          </td>
        </tr>
        <tr>
          <td style="padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">&nbsp;</p>

          </td>
          <td style="padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">Copper tubing shall be K copper</p>

          </td>
        </tr>
        <tr>
          <td style="padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">&nbsp;</p>

          </td>
          <td style="padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">Poly drip tubing: allowed only after emitters</p>

          </td>
        </tr>
        <tr>
          <td style="padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">Manual Valves</p>

          </td>
          <td style="padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">Shall be resilient seated ball valve</p>

          </td>
