        </tr>
        <tr>
          <td style="padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">Piping</p>

          </td>
          <td style="padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">PVC pipes and fittings shall be schedule 40</p>

