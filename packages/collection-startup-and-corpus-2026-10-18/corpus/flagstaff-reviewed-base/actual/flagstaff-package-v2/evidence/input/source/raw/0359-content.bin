        <tr>
          <th style="border-left: 1px solid #000000; border-right: 1px solid #000000; border-top: 1px solid #000000; padding: 4pt 2pt 2pt 3pt; vertical-align: middle; width: 210.0pt">
                        <p class="CellHeading">Sieve size (square openings) </p>

          </th>
          <th style="border-left: 1px solid #000000; border-right: 1px solid #000000; border-top: 1px solid #000000; padding: 4pt 2pt 2pt 3pt; vertical-align: middle; width: 210.0pt">
                        <p class="CellHeading">Percent by weight passing sieve</p>

          </th>
        </tr>
     </thead>
     <tbody>
        <tr>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
