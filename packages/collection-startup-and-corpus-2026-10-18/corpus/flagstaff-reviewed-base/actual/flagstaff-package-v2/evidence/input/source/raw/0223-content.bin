                        <p class="CellBodyC">5%</p>

          </td>
        </tr>
        <tr>
          <td style="border-bottom: 1px solid #000000; border-left: 0px; border-right: 0px; border-top: 1px solid #000000; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">2. Simplified Letter and/or Logo Copy</p>

          </td>
          <td style="border-bottom: 1px solid #000000; border-left: 0px; border-right: 0px; border-top: 1px solid #000000; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC">15%</p>

          </td>
          <td style="border-bottom: 1px solid #000000; border-left: 0px; border-right: 0px; border-top: 1px solid #000000; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
