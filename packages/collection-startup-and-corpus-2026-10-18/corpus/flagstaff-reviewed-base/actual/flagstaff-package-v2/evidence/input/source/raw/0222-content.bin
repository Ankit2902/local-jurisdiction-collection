        <tr>
          <td style="border-bottom: 1px solid #000000; border-left: 0px; border-right: 1px solid #000000; border-top: 1px solid #000000; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">Passive recreation</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC" style="white-space:nowrap">Yes</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC" style="white-space:nowrap">Yes</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC" style="white-space:nowrap">Yes</p>

          </td>
          <td style="border-bottom: 1px solid #000000; border-left: 1px solid #000000; border-right: 0px; border-top: 1px solid #000000; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC" style="white-space:nowrap">Yes</p>

          </td>
        </tr>
        <tr>
          <td style="border-bottom: 1px solid #000000; border-left: 0px; border-right: 1px solid #000000; border-top: 1px solid #000000; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">Picnic area</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC" style="white-space:nowrap">Yes</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC" style="white-space:nowrap">Yes</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC" style="white-space:nowrap">No</p>

          </td>
          <td style="border-bottom: 1px solid #000000; border-left: 1px solid #000000; border-right: 0px; border-top: 1px solid #000000; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC" style="white-space:nowrap">Yes</p>

          </td>
        </tr>
        <tr>
          <td style="border-bottom: 1px solid #000000; border-left: 0px; border-right: 0px; border-top: 1px solid #000000; padding: 4pt 2pt 2pt 3pt; vertical-align: top" colspan="5">
                        <p class="CellBodyBold" style="white-space:nowrap">Other</p>

          </td>
        </tr>
        <tr>
          <td style="border-bottom: 1px solid #000000; border-left: 0px; border-right: 1px solid #000000; border-top: 1px solid #000000; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody" style="white-space:nowrap">Drainage</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC" style="white-space:nowrap">Yes</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC" style="white-space:nowrap">Yes</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC" style="white-space:nowrap">No</p>

          </td>
          <td style="border-bottom: 1px solid #000000; border-left: 1px solid #000000; border-right: 0px; border-top: 1px solid #000000; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC" style="white-space:nowrap">Yes</p>

          </td>
        </tr>
        <tr>
          <td style="border-bottom: 1px solid #000000; border-left: 0px; border-right: 1px solid #000000; border-top: 1px solid #000000; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">Landscape buffer (see Division <a href="../Flagstaff10/Flagstaff1050060.html#10.50.60">10-50.60</a>, Landscaping Standards)</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC" style="white-space:nowrap">Yes</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC" style="white-space:nowrap">Yes</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC" style="white-space:nowrap">Yes</p>

          </td>
          <td style="border-bottom: 1px solid #000000; border-left: 1px solid #000000; border-right: 0px; border-top: 1px solid #000000; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC" style="white-space:nowrap">Yes</p>

          </td>
        </tr>
        <tr>
          <td style="border-bottom: 1px solid #000000; border-left: 0px; border-right: 1px solid #000000; border-top: 1px solid #000000; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">Utilities (includes service lines)</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC" style="white-space:nowrap">Yes</p>

