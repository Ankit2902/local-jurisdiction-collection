                        <p class="CellBodyC">1 per Lot or Parcel</p>

          </td>
        </tr>
        <tr>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyR">&nbsp;</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC">0.5 &ndash; 1 acre</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC">2</p>

          </td>
        </tr>
        <tr>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyR">&nbsp;</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC">&gt; 1 acre</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC">1 per additional acre</p>

          </td>
        </tr>
        <tr>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyR">Less than 45&#39; in height mounted on light poles</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top" colspan="2">
                        <p class="CellBodyC" style="white-space:nowrap">Unlimited</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">&nbsp;</p>

