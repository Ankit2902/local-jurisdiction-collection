                        <p class="CellBodyBold">No. of AWES</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top; width: 94.1393pt">
                        <p class="CellBody">&nbsp;</p>

          </td>
        </tr>
        <tr>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyR">More than 45&#39; in height</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC">&lt;0.5</p>

          </td>
