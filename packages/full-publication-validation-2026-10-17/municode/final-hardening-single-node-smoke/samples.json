    "content": {
      "Docs": [
        {
          "DocType": 1,
          "IsAmended": false,
          "IsUpdated": false,
          "CompareStatus": 4,
          "DocOrderId": 2044,
          "AmendedBy": [],
          "Notes": [],
          "Drafts": [],
          "ChunkGroupStartingNodeId": "TIT15BUCO_CH15.33BLRE",
          "NodeDepth": 3,
          "TitleHtml": "<div class=\"chunk-title\">15.33.130 - Performance standards.</div>",
          "ShouldShowMiniToc": false,
          "Id": "TIT15BUCO_CH15.33BLRE_15.33.130PEST",
          "Title": "15.33.130 - Performance standards.",
          "Content": "<div class=\"chunk-content\">\n            <p class=\"incr0\">\n               A.\n               </p>\n            \t\t\n            <p class=\"content1\">\n               <span class=\"ital\">Blast scheduling.</span>\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               1.\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Blasting contractors are required to request a blast time for each blast. Blasts shall\n               be scheduled by the building and fire safety department. The department shall issue\n               such scheduling rules as the fire chief and building official deem necessary and appropriate.\n               The scheduling rules may be modified by the fire chief and building official, whenever\n               necessary. Notice of modifications shall be sent to the blasting contractors regularly\n               conducting business in Henderson at least seven days prior to the effective date of\n               the modifications.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               2.\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Blasting-related drilling may be conducted between the hours of 6:00 a.m. and 6:00\n               p.m. during the period beginning on October 1 and ending on March 31 and non-proximate\n               blasting-related drilling may be conducted between the hours of 5:00 a.m. and 6:00\n               p.m. during the period beginning on April 1 and ending on September 30.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               3.\n               </p>\n            \t\t\n            <p class=\"content2\">\n               All blasting shall be conducted between the hours of 8:00 a.m. to 4:00 p.m., Monday\n               through Friday, excluding state observed holidays (NRS-236). The fire chief and building\n               official may approve alternative time periods for blasting, at their sole discretion,\n               as deemed appropriate.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               4.\n               </p>\n            \t\t\n            <p class=\"content2\">\n               The blasting contractor shall notify fire department dispatch using a non-emergency\n               telephone number a minimum of one hour prior to each blast.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               B.\n               </p>\n            \t\t\n            <p class=\"content1\">\n               <span class=\"ital\">Seismograph monitoring location(s).</span> Seismographs shall be placed at the nearest building(s) to the blast site in accordance\n               with Table 1. Seismographs shall be provided in sufficient numbers, distances, and\n               directions that will provide ground motion and airblast records representative of\n               the maximum impacts on the surrounding neighborhoods. The fire chief and building\n               and fire safety director may require additional seismographs as deemed necessary to\n               obtain additional attenuation data.\n               </p>\n            \t\t\n            <div>\n               <div class=\"\" style=\"width:100%\">\n                  <table class=\"thead3 table  left\" cellpadding=\"3\" cellspacing=\"0\" border=\"1\" rules=\"all\">\n                     <colgroup class=\"std\">\n                        <col width=\"33.333333333333336%\">\n                        <col width=\"33.333333333333336%\">\n                        <col width=\"33.333333333333336%\">\n                     </colgroup>\n                     <tbody>\n                        <tr style=\" font-weight:bold; font-style:italic; \">\n                           <td colspan=\"3\" class=\" top \">\n                              Table 1\n                              <br>\n                              Number of Seismographs Required\n                              </td>\n                        </tr>\n                        <tr style=\" font-weight:bold; font-style:italic; \">\n                           <td class=\" top \"></td>\n                           <td colspan=\"2\" class=\" top \">\n                              Pounds of Explosives per Delay\n                              </td>\n                        </tr>\n                        <tr style=\" font-weight:bold; font-style:italic; \">\n                           <td class=\" top \">\n                              Distance (feet)\n                              </td>\n                           <td class=\" top \">\n                              ;lte; 100\n                              </td>\n                           <td class=\" top \">\n                              ;gt; 100\n                              </td>\n                        </tr>\n                        <tr>\n                           <td class=\" top \">\n                              ;lte; 1,000\n                              </td>\n                           <td class=\" top \">\n                              1\n                              </td>\n                           <td class=\" top \">\n                              2\n                              </td>\n                        </tr>\n                        <tr>\n                           <td class=\" top \">\n                              ;gt; 1,000\n                              </td>\n                           <td class=\" top \">\n                              2\n                              </td>\n                           <td class=\" top \">\n                              3\n                              </td>\n                        </tr>\n                     </tbody>\n                  </table>\n               </div>\n               <p>&nbsp;</p>\n            </div>\n            <p class=\"incr0\">\n               C.\n               </p>\n            \t\t\n            <p class=\"content1\">\n               <span class=\"ital\">Seismograph monitoring equipment.</span>\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               1.\n               </p>\n            \t\t\n            <p class=\"content2\">\n               The ground vibration and airblast measuring systems shall have a flat response between\n               two and 200 Hz.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               2.\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Ground vibrations and airblast shall be monitored with blasting seismographs that\n               meet the current International Society of Explosives Engineer's guideline entitled\n               \"Performance Specifications for Blasting Seismographs\" (www.isee.org) and approved\n               by the fire chief and building and fire safety director.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               3.\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Blasting seismographs shall be deployed in the field according to the current International\n               Society of Explosive Engineers guidelines entitled \"Field Practice Guidelines for\n               Blasting Seismographs\" (www.isee.org).\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               D.\n               </p>\n            \t\t\n            <p class=\"content1\">\n               <span class=\"ital\">Ground vibration.</span>\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               1.\n               </p>\n            \t\t\n            <p class=\"content2\">\n               At all blasting operations, the frequency-based maximum ground vibrations shall not\n               exceed the limitations specified in Figure 1 at any building or utility.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               2.\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Compliance shall be verified by employing blasting-type seismographs to record particle\n               velocity time histories (full wave forms) and the frequency content of the time histories\n               for three mutually perpendicular components of ground motions.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               3.\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Ground vibrations shall be reported in terms of the peak particle velocity (PPV) and\n               the frequency at the PPV.\n               </p>\n            \t\t\n            <p class=\"bc1\">\n               <span class=\"bold\">FIGURE 1</span>\n               </p>\n            <p class=\"b1\">\n               <a href=\"https://mcclibrary.blob.core.usgovcloudapi.net/codecontent/14896/475955/15.33.130-188.png\" target=\"_blank\" data-image-filename=\"15.33.130-188.png\"><img id=\"img_2\" src=\"https://mcclibrary.blob.core.usgovcloudapi.net/codecontent/14896/475955/15.33.130-188.png\" alt=\"\" width=\"530\" height=\"410\" data-image-filename=\"15.33.130-188.png\"></a>\n               \n               </p>\n            <p class=\"incr0\">\n               E.\n               </p>\n            \t\t\n            <p class=\"content1\">\n               <span class=\"ital\">Airblast.</span> Airblast shall not exceed the maximum limit of 120 dBL sound pressure level equivalent\n               of air pressure measured on a linear-weighted scale at the location of any building.\n               </p>\n            \t\t\n            <p class=\"b0\">\n               Exception: The maximum limit may be raised to 133 dBL with written permission of all\n               building owner(s) within the distance as shown in Figure 2.\n               </p>\n            <p class=\"incr0\">\n               F.\n               </p>\n            \t\t\n            <p class=\"content1\">\n               <span class=\"ital\">Fly rock.</span> Fly rock traveling in the air or along the ground shall not be projected beyond the\n               permit area.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               G.\n               </p>\n            \t\t\n            <p class=\"content1\">\n               <span class=\"ital\">Reports.</span> All reports required by this section shall be submitted with the required reports\n               attached via email to an address designated by the building and fire safety department.\n               </p>\n            \t\t\n            <p class=\"b0\">\n               The permittee shall provide written notification to the fire chief and building and\n               fire safety director of any incident, damage claim, or neighbor annoyance report brought\n               to the permittee's attention. Such notification shall be provided within 24 hours\n               after a report of an incident, damage, or annoyance.\n               \n               <p class=\"incr1\">\n                  1.\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">Seismograph reports.</span> A seismograph report shall be provided to the city within 48 hours after every blast.\n                  The report shall include:\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  a.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Date and time of recording(s);\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  b.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Name of the person and firm taking the reading;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  c.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Name of the person and firm analyzing the seismographic record;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  d.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Type of instrument, serial number and calibration signal or certification of annual\n                  calibration;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  e.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Trigger levels used for the ground motion and airblast (ground motion trigger levels\n                  at distances over 300 feet shall be set at 0.03 in/sec);\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  f.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Show location on a scaled map for each seismograph by address, if applicable;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  g.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  GPS location, distance and direction from the blast of each seismograph;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  h.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Ground motion time histories for three mutually perpendicular components;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  i.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Airblast time history;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  j.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Peak particle velocity (PPV) and the frequency at the PPV;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  k.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Peak airblast in decibels (dB) and pounds per square foot (psi) and the frequency\n                  at the peak;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  l.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Maximum pounds of explosives per eight millisecond (ms) delay.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  2.\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">Blasting report.</span> The operator shall retain a record of all blasts for a minimum of three years. At\n                  the request of the fire chief and building and fire safety director, the blasting\n                  operator shall provide to the City of Henderson a copy of the blasters log or report\n                  within 24 hours after the blast. The blasting log shall include the following:\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  a.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Name and signature of the operator and blaster conducting the blast;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  b.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Date, time and location of the blast;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  c.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  GPS coordinates of the blast;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  d.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Type of material blasted;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  e.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Total number of drill holes;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  f.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Diameter and depth of holes (maximum, minimum and average depth);\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  g.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Burden, and spacing used in the blasting pattern;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  h.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Subdrill depth;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  i.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Type and length of stemming (minimum, maximum and average);\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  j.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Total pounds of each type of explosive used;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  k.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Initiation system and delay periods used in design;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  l.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Schematic showing the drill hole pattern and detonation timing of each blast hole;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  m.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Weather conditions, including those which may cause possible adverse blasting effects;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  n.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  The maximum weight of explosives detonated in an 8-millisecond period;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  o.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Type and size of any fly rock protection devices used, if any;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  p.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Distances to and addresses of all closest buildings to the blast site in all directions;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  q.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Reasons and conditions for each unscheduled blast.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  3.\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">Noncompliant incident report.</span> When a blast exceeds established limits as specified herein, the permittee shall\n                  file a written noncompliant incident report with the building and fire safety department\n                  within 24 hours of the event. The incident report shall state:\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  a.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  What specified limit was exceeded;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  b.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Why the specified limit was exceeded;\n                  </p>\n               \t\t\n               <p class=\"incr2\">\n                  c.\n                  </p>\n               \t\t\n               <p class=\"content3\">\n                  Corrective measures taken to prevent similar future occurrences.\n                  </p>\n               \t\t\n               \n            <p class=\"historynote0\">\n               (Ord. No. <a class=\"ordinance-link\" href=\"\" data-product-id=\"14896\" data-ordinance-id=\"1374668\">4101</a>, § 4, 9-2-2025; Ord. 2388, § 3 (part), 2005)\n               </p></div>",
