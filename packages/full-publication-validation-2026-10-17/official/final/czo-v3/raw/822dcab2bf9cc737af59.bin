			<p>Section 20.3.OO</p>
			</td>
		</tr>
		<tr>
			<td style="width:354px;">
			<p>Planned Development</p>
			</td>
			<td style="width:150px;">
			<p align="center">C</p>
			</td>
			<td style="width:144px;">
			<p>Article 5</p>
			</td>
		</tr>
