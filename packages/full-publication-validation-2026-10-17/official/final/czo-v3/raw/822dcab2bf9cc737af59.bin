			</th>
			<th rowspan="2" style="width: 126px;">
			<p align="center"><strong>USE STANDARDS</strong></p>
			</th>
		</tr>
		<tr>
			<th style="width: 57px;">
			<p align="center"><strong>S-B1<sup><span style="font-size: 10.5px;">5</span></sup></strong></p>
			</th>
			<th style="width: 57px;">
			<p align="center"><strong>S-B2<sup>6</sup></strong></p>
			</th>
			<th style="width: 57px;">
			<p align="center"><strong>S-LB1<sup>5&amp;7</sup></strong></p>
			</th>
			<th style="width: 46px;">
			<p align="center"><strong>S-LB2<sup>5&amp;8</sup></strong></p>
			</th>
			<th style="width: 46px; text-align: center;">S-LC<sup>9</sup></th>
			<th style="width: 56px;">
			<p align="center"><strong>S-MU</strong></p>
			</th>
		</tr>
	</thead>
	<tbody>
		<tr>
			<th colspan="8" style="width: 602px;">
			<p><strong>RESIDENTIAL USE</strong></p>
			</th>
		</tr>
		<tr>
