<span class="utilities">
  <a href="/Print.aspx?printpath=/Article-24/24-13/24-13-D/24-13-D-1&amp;classname=nola.ordinance" target="_blank" data-toggle="tooltip" data-placement="top" title="Print this section">
         <span class="glyphicon glyphicon-print"></span></a>
  &nbsp;&nbsp;
  <a href="#" class="copy-link" data-html="true" data-content="&lt;input type='text' value='http://czo.nola.gov/Article-24#24-13-D-1'&gt;&lt;/input&gt;">
