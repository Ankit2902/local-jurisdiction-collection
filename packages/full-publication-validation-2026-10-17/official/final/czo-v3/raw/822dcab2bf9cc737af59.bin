			<th><span style="display: none;">&nbsp;</span>PERMITTED TEMPORARY USE</th>
			<th>DISTRICT</th>
			<th>TIMEFRAME</th>
			<th>HOURS OF OPERATIONS</th>
			<th>TEMPORARY USE STANDARDS</th>
		</tr>
