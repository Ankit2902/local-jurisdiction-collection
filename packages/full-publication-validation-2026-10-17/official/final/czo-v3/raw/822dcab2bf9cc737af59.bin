			<td style="width: 129px;">
			<p>15’</p>
			</td>
			<td style="width: 192px;">
			<p>10’<sup>1</sup></p>
			</td>
		</tr>
		<tr>
			<td style="width: 179px;">
			<p><strong>REAR YARD</strong></p>
			</td>
			<td style="width: 129px;">
			<p>20’</p>
			</td>
			<td style="width: 192px;">
			<p>20’, unless rear yard abuts a waterway, then none required<sup>1</sup></p>
			</td>
		</tr>
	</tbody>
