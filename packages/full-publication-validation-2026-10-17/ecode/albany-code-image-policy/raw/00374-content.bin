    <label class="selectionLabel" id="33430398_label" for="33430398_input">
  <div class="titleLinkContainer">
    <a href="#33430398"
       class="titleLink"
    >
    <span class="titleNumber">
      § 375-301
    </span>
    <span class="titleTitle"
          data-guid="33430398"
    >
General.    </span>
