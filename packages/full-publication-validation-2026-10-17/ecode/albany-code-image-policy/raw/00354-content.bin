s="para" style="margin-left:0px;">Philip Street</div></td><td align="left" class="entry borderBottom" startcol="2" style="border-color:#e0e0e0;" valign="top"><div class="para" style="margin-left:0px;">Park Avenue to Warren Street</div></td></tr><tr class=""><td align="left" class="entry borderRight borderBottom" startcol="1" style="border-color:#e0e0e0;" valign="top"><div class="para" style="margin-left:0px;">Grand Street</div></td><td align="left" class="entry borderBottom" startcol="2" style="border-color:#e0e0e0;" valign="top"><div class="para" style="margin-left:0px;">Park Avenue to Myrtle Avenue</div></td></tr><tr class=""><td align="left" class="entry borderRight borderBottom" startcol="1" style="border-color:#e0e0e0;" valign="top"><div class="para" style="margin-left:0px;">Grand Street</div></td><td align="left" class="entry borderBottom" startcol="2" style="border-color:#e0e0e0;" valign="top"><div class="para" style="margin-left:0px;">Myrtle Avenue to Wilbur Street</div></td></tr><tr class=""><td align="left" class="entry borderRight borderBottom" startcol="1" style="border-color:#e0e0e0;" valign="top"><div class="para" style="margin-left:0px;">Grand Street</div></td><td align="left" class="entry borderBottom" startcol="2" style="border-color:#e0e0e0;" valign="top"><div class="para" style="margin-left:0px;">Wilbur Street to Elm Street</div></td></tr><tr class=""><td align="left" class="entry borderRight borderBottom" startcol="1" style="border-color:#e0e0e0;" valign="top"><div class="para" style="margin-left:0px;">Grand Street</div></td><td align="left" class="entry borderBottom" startcol="2" style="border-color:#e0e0e0;" valign="top"><div class="para" style="margin-left:0px;">Elm Street to Madison Avenue</div></td></tr><tr class=""><td align="left" class="entry borderRight borderBottom" startcol="1" style="border-color:#e0e0e0;" valign="top"><div class="para" style="margin-left:0px;">Green Street</div></td><td align="left" class="entry borderBottom" startco