                <article>
                <header>
  <div data-component="h2"
       class="contentTitle barTitle sectionTitle 7680210"
      id="7680210"
      data-guid="7680210"
      data-position="2016"
      data-full-title="§ 48-1: Establishment."
      data-code-content-type="section"
  >
    <span class="selectionBox material-icons material-symbols-outlined material-symbols-and-filled md-24"
         title="Select this content"
         aria-label="Select this content"
    >
      <input type="checkbox" class="selectionBoxInput" id="7680210_input"/>
    </span>
    <label class="selectionLabel" id="7680210_label" for="7680210_input">
  <div class="titleLinkContainer">
    <a href="#7680210"
       class="titleLink"
    >
    <span class="titleNumber">
      § 48-1
    </span>
    <span class="titleTitle"
          data-guid="7680210"
    >
Establishment.    </span>
    </a>
