<div class="article_content content" id="7685232_content" title-footnotes="0"><div class="footnotes"></div></div>                <article>
                <header>
  <div data-component="h3"
       class="contentTitle barTitle sectionTitle 7685233 child"
      id="7685233"
      data-guid="7685233"
      data-parent-guid="7685232"
      data-position="7743"
      data-full-title="§ 345-23: Purpose."
      data-code-content-type="section"
  >
    <span class="selectionBox material-icons material-symbols-outlined material-symbols-and-filled md-24"
         title="Select this content"
         aria-label="Select this content"
    >
      <input type="checkbox" class="selectionBoxInput" id="7685233_input"/>
