                <article>
                <header>
  <div data-component="h2"
       class="contentTitle barTitle sectionTitle 46257650"
      id="46257650"
      data-guid="46257650"
      data-position="2325"
      data-full-title="§ 50-4: Adopted; purpose; applicability."
      data-code-content-type="section"
  >
    <span class="selectionBox material-icons material-symbols-outlined material-symbols-and-filled md-24"
         title="Select this content"
         aria-label="Select this content"
    >
      <input type="checkbox" class="selectionBoxInput" id="46257650_input"/>
    </span>
