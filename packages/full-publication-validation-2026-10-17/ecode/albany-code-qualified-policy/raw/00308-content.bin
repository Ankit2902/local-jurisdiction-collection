                <article>
                <header>
  <div data-component="h2"
       class="contentTitle barTitle sectionTitle 7684426"
      id="7684426"
      data-guid="7684426"
      data-position="6711"
      data-full-title="§ 313-11: Legislative findings; intent."
      data-code-content-type="section"
  >
    <span class="selectionBox material-icons material-symbols-outlined material-symbols-and-filled md-24"
