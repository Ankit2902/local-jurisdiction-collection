      § 30-193
    </span>
    <span class="titleTitle"
          data-guid="7678609"
    >
Deposition may be read in evidence; when.    </span>
    </a>
  </div>
      
  <div class="schemeIcons">
  </div>
  </div>
  <div 
       class="contentTitle barTitle sectionTitle 7678610"
      id="7678610_title"
      data-guid="7678610"
      data-position="541"
      data-full-title="§ 30-194: Effect of deposition."
      data-code-content-type="section"
  >
    <span class="selectionBox material-icons material-symbols-outlined material-symbols-and-filled md-24"
         title="Select this content"
         aria-label="Select this content"
