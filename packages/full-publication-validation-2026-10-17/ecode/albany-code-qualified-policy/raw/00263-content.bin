  <div class="titleLinkContainer">
    <a href="#7682711"
       class="titleLink"
    >
    <span class="titleNumber">
      § 211-26
    </span>
    <span class="titleTitle"
          data-guid="7682711"
    >
Prior inconsistent ordinance.    </span>
    </a>
  </div>
      </label>
  </div>
                </header>
        <div class="notes" id="notes-7682711" data-guid="7682711"></div>
        <div id="questions-7682711" data-guid="7682711" class="questions"></div>


<div class="section_content content" id="7682711_content" title-footnotes="0"><div class="para">This chapter shall supersede any existing ordinance theretofore enacted which is in conflict with or contrary to the provisions of this chapter.</div><div class="footnotes"></div></div>                </article>
                <article>
                <header>
  <div data-component="h2"
       class="contentTitle barTitle sectionTitle 7682712"
      id="7682712"
      data-guid="7682712"
      data-position="5045"
      data-full-title="§ 211-27: Diagrams."
