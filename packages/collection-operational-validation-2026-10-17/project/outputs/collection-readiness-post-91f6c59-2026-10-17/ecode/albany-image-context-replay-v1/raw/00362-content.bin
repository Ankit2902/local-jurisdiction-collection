        <div class="notes" id="notes-51420525" data-guid="51420525"></div>
        <div id="questions-51420525" data-guid="51420525" class="questions"></div>


<div class="section_content content" id="51420525_content" title-footnotes="0"><div class="para">This article shall apply to all actions occurring on or after the effective date of this article.</div><div class="footnotes"></div></div>                </article>
      </div>
  </div>

