    >
      <input type="checkbox" class="selectionBoxInput" id="7681741_input"/>
    </span>
    <label class="selectionLabel" id="7681741_label" for="7681741_input">
  <div class="titleLinkContainer">
    <a href="#7681741"
       class="titleLink"
    >
    <span class="titleNumber">
      § 151-37
    </span>
    <span class="titleTitle"
          data-guid="7681741"
    >
Sewage drainage system.    </span>
