gn="left" charoff="50" class="entry" startcol="1" valign="top"><div class="para" style="margin-left:0px;"></div></td><td align="left" charoff="50" class="entry" startcol="2" valign="top"><div class="para" style="margin-left:0px;">Skilled Laborer </div></td><td align="center" charoff="50" class="entry" startcol="3" valign="top"><div class="para" style="margin-left:0px;">$5,000.00</div></td></tr><tr class=""><td align="left" charoff="50" class="entry" startcol="1" valign="top"><div class="para" style="margin-left:0px;"></div></td><td align="left" charoff="50" class="entry" startcol="2" valign="top"><div class="para" style="margin-left:0px;">General Utility Man </div></td><td align="center" charoff="50" class="entry" startcol="3" valign="top"><div class="para" style="margin-left:0px;">$5,000.00</div></td></tr><tr class=""><td align="left" charoff="50" class="entry" startcol="1" valign="top"><div class="para" style="margin-left:0px;"></div></td><td align="left" charoff="50" class="entry" startcol="2" valign="top"><div class="para" style="margin-left:0px;">Permit Clerk </div></td><td align="center" charoff="50" class="entry" startcol="3" valign="top"><div class="para" style="margin-left:0px;">$5,000.00</div></td></tr></tbody></table></div><div class="footnotes"></div></div>                </article>
