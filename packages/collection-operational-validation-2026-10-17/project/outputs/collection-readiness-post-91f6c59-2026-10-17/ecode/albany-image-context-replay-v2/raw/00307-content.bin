  <div class="titleLinkContainer">
    <a href="#7684424"
       class="titleLink"
    >
    <span class="titleNumber">
      § 313-10
    </span>
    <span class="titleTitle"
          data-guid="7684424"
    >
Repealer.    </span>
    </a>
  </div>
      </label>
  </div>
                </header>
        <div class="notes" id="notes-7684424" data-guid="7684424"></div>
        <div id="questions-7684424" data-guid="7684424" class="questions"></div>


<div class="section_content content" id="7684424_content" title-footnotes="0"><div class="para">All provisions of the ordinance providing for the removal of garbage in the City of Albany passed by the Common Council December 15, 1933, are hereby repealed.</div><div class="footnotes"></div></div>                </article>
      </div>
  </div>

            </div>
          </div>
        </main>
