      <a rel="cgi/extract.pl?page=Burlington27/Burlington2701.html" href="/VT/Burlington/#!/Burlington27/Burlington2701.html" class="basic">
        <img src="/VT/Burlington/html/images/prev.gif" alt="Previous" border="0">
