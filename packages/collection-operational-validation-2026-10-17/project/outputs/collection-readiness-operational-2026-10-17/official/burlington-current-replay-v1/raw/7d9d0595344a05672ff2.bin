        <img src="/VT/Burlington/html/images/prev.gif" alt="Previous" border="0">
      </a>
      <a rel="cgi/extract.pl?page=Burlington13/Burlington1302.html" href="/VT/Burlington/#!/Burlington13/Burlington1302.html" class="basic">
