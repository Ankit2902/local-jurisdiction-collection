                        <p class="CellHeading">&nbsp;</p>

          </td></table><table class="hovercraft" style="margin: 0px; position: absolute; border-spacing: 0px; background: white; z-index: 1; top: 0px; left: 109.266px; height: 27.2969px; width: 42.1719px; table-layout: fixed; border-style: none; border-width: 0px; border-color: rgb(33, 37, 41);"><td style="height: 27.2969px; width: 42.1719px; padding: 4px 2.66667px 2.66667px; vertical-align: bottom; background: rgba(0, 0, 0, 0);">
                        <p class="CellHeading"><span class="italic">Major</span></p>

          </td></table><table class="hovercraft" style="margin: 0px; position: absolute; border-spacing: 0px; background: white; z-index: 1; top: 0px; left: 151.438px; height: 27.2969px; width: 61.75px; table-layout: fixed; border-style: none; border-width: 0px; border-color: rgb(33, 37, 41);"><td style="height: 27.2969px; width: 61.75px; padding: 4px 2.66667px 2.66667px; vertical-align: bottom; background: rgba(0, 0, 0, 0);">
                        <p class="CellHeading"><span class="italic">Collector</span></p>

          </td></table><table class="hovercraft" style="margin: 0px; position: absolute; border-spacing: 0px; background: white; z-index: 1; top: 0px; left: 213.188px; height: 27.2969px; width: 40.5469px; table-layout: fixed; border-style: none; border-width: 0px; border-color: rgb(33, 37, 41);"><td style="height: 27.2969px; width: 40.5469px; padding: 4px 2.66667px 2.66667px; vertical-align: bottom; background: rgba(0, 0, 0, 0);">
                        <p class="CellHeading"><span class="italic">Local</span></p>

          </td></table></table><div id="cluetip-waitimage" style="position: absolute; display: none;"></div><div id="cluetip" style="position: absolute; display: none;"><div class="cluetip-outer" style="position: relative; z-index: 97;"><h3 class="cluetip-title ui-widget-header ui-cluetip-header"></h3><div class="cluetip-inner ui-widget-content ui-cluetip-content"></div></div><div class="cluetip-extra"></div></div></div><div id="navBottom">
