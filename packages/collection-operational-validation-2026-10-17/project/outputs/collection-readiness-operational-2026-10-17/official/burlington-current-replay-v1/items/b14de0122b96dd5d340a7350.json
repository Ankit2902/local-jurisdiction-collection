      "publication": "Burlington Code of Ordinances including Charter and appendices"
    },
    {
      "html": "<p class=\"P1\">Private vehicles are prohibited from parking in areas marked \"taxi\", \"carrier\", \"buses\", or \"limo\".</p>\n<p class=\"HistoryNote\">(Res. of 3-24-97)</p>",
      "text": "Private vehicles are prohibited from parking in areas marked \"taxi\", \"carrier\", \"buses\", or \"limo\". (Res. of 3-24-97)",
