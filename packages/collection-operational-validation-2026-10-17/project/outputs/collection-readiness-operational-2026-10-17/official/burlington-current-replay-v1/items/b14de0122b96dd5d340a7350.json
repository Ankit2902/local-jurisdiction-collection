      ],
      "source_url": "https://www.codepublishing.com/VT/Burlington/#!/BurlingtonAxE/BurlingtonAxE0202.html#2.1",
      "unit": "legal_section",
      "document_id": "https://www.codepublishing.com/VT/Burlington/#!/BurlingtonAxE/BurlingtonAxE0202.html",
