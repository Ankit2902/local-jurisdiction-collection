    },
    {
      "html": "<p class=\"P1\">Parking in pedestrian crosswalks is prohibited.</p>\n<p class=\"HistoryNote\">(Res. of 3-24-97)</p>",
      "text": "Parking in pedestrian crosswalks is prohibited. (Res. of 3-24-97)",
