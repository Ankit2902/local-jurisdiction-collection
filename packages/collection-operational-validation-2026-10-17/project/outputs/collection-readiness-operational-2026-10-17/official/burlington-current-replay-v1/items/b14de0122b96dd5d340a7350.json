      "links": [],
      "assets": [],
      "image_placeholder_count": 0,
      "notes": [],
      "superscripts": [],
      "id": "https://www.codepublishing.com/VT/Burlington/#!/BurlingtonAxE/BurlingtonAxE0202.html::html-id:2.4",
      "heading": "[Parking in taxi, etc., areas.]",
      "path": [
        "",
        "",
        "ARTICLE II. GENERAL PARKING REGULATIONS"
      ],
      "source_url": "https://www.codepublishing.com/VT/Burlington/#!/BurlingtonAxE/BurlingtonAxE0202.html#2.4",
