      "publication": "Burlington Code of Ordinances including Charter and appendices"
    },
    {
      "html": "<p class=\"P1\">Leaving a motor vehicle unattended at curbside in front of the terminal is prohibited.</p>\n<p class=\"HistoryNote\">(Res. of 3-24-97)</p>",
      "text": "Leaving a motor vehicle unattended at curbside in front of the terminal is prohibited. (Res. of 3-24-97)",
      "tables": [],
      "links": [],
      "assets": [],
      "image_placeholder_count": 0,
      "notes": [],
      "superscripts": [],
      "id": "https://www.codepublishing.com/VT/Burlington/#!/BurlingtonAxE/BurlingtonAxE0202.html::html-id:2.2",
      "heading": "[Leaving vehicles unattended.]",
      "path": [
        "",
        "",
        "ARTICLE II. GENERAL PARKING REGULATIONS"
      ],
      "source_url": "https://www.codepublishing.com/VT/Burlington/#!/BurlingtonAxE/BurlingtonAxE0202.html#2.2",
      "unit": "legal_section",
      "document_id": "https://www.codepublishing.com/VT/Burlington/#!/BurlingtonAxE/BurlingtonAxE0202.html",
      "raw_ref": "raw/0ba2420f8de9f86b4101.bin",
