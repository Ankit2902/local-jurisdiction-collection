      "jurisdiction": "Burlington",
      "state": "VT",
      "publication": "Burlington Code of Ordinances including Charter and appendices"
    },
    {
      "html": "<p class=\"P1\">A vehicle may not enter any area that is closed to vehicular traffic by barricades or other traffic control devices.</p>\n<p class=\"HistoryNote\">(Res. of 3-24-97)</p>",
      "text": "A vehicle may not enter any area that is closed to vehicular traffic by barricades or other traffic control devices. (Res. of 3-24-97)",
      "tables": [],
      "links": [],
      "assets": [],
      "image_placeholder_count": 0,
      "notes": [],
      "superscripts": [],
      "id": "https://www.codepublishing.com/VT/Burlington/#!/BurlingtonAxE/BurlingtonAxE0202.html::html-id:2.3",
      "heading": "[Entering areas closed to traffic.]",
      "path": [
        "",
        "",
        "ARTICLE II. GENERAL PARKING REGULATIONS"
      ],
      "source_url": "https://www.codepublishing.com/VT/Burlington/#!/BurlingtonAxE/BurlingtonAxE0202.html#2.3",
      "unit": "legal_section",
      "document_id": "https://www.codepublishing.com/VT/Burlington/#!/BurlingtonAxE/BurlingtonAxE0202.html",
