  "records": [
    {
      "html": "<p class=\"P1\">Parking or standing is prohibited on all airport roads or highways, except in designated parking areas.</p>\n<p class=\"HistoryNote\">(Res. of 3-24-97)</p>",
      "text": "Parking or standing is prohibited on all airport roads or highways, except in designated parking areas. (Res. of 3-24-97)",
      "tables": [],
      "links": [],
      "assets": [],
      "image_placeholder_count": 0,
      "notes": [],
      "superscripts": [],
