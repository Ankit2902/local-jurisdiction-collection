        <img src="/VT/Burlington/html/images/toc.gif" alt="Home" border="0">
      </a>
      <a rel="cgi/extract.pl?page=BurlingtonCH/BurlingtonCH03.html" href="/VT/Burlington/#!/BurlingtonCH/BurlingtonCH03.html" class="basic">
        <img src="/VT/Burlington/html/images/prev.gif" alt="Previous" border="0">
      </a>
      <a rel="cgi/extract.pl?page=BurlingtonCH/BurlingtonCH05.html" href="/VT/Burlington/#!/BurlingtonCH/BurlingtonCH05.html" class="basic">
        <img src="/VT/Burlington/html/images/next.gif" alt="Next" border="0">
      </a>
    </div></div>
	<div id="pgFooter"> 


<p id="current">The Burlington Code of Ordinances is current through Ord. 8-3-26, passed August 3, 2026.</p>
