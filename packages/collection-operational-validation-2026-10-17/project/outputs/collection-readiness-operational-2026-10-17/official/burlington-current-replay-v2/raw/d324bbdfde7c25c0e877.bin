                        <p class="CellBody">(1)</p>

          </td>
          <td style="padding: 3pt 2pt 2pt 2pt; vertical-align: top; width: 188.949pt" colspan="2">
                        <p class="CellBody">Elmwood Avenue and Grant Street:</p>

          </td>
        </tr>
        <tr>
          <td style="padding: 3pt 2pt 2pt 2pt; vertical-align: top; width: 25.78116pt">
                        <p class="CellBody">&nbsp;</p>

          </td>
          <td style="padding: 3pt 2pt 2pt 2pt; vertical-align: top; width: 130.56876pt">
                        <p class="CellBody">Per month&nbsp;&nbsp;&nbsp;&nbsp;</p>

          </td>
          <td style="padding: 3pt 2pt 2pt 2pt; vertical-align: bottom; width: 58.38024pt">
                        <p class="CellBodyR">$55.00*</p>

          </td>
        </tr>
        <tr>
          <td style="padding: 3pt 2pt 2pt 2pt; vertical-align: top">
                        <p class="CellBody">(2)</p>

          </td>
          <td style="padding: 3pt 2pt 2pt 2pt; vertical-align: top" colspan="2">
                        <p class="CellBody">Main Street adjacent to the metered parking lot located on the N.E. corner Main and Winooski:</p>

          </td>
        </tr>
        <tr>
          <td style="padding: 3pt 2pt 2pt 2pt; vertical-align: top">
                        <p class="CellBody">&nbsp;</p>

          </td>
          <td style="padding: 3pt 2pt 2pt 2pt; vertical-align: top">
                        <p class="CellBody">Per month&nbsp;&nbsp;&nbsp;&nbsp;</p>

          </td>
          <td style="padding: 3pt 2pt 2pt 2pt; vertical-align: bottom">
                        <p class="CellBodyR">$60.00</p>

