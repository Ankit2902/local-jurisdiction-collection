<!--for the saved search alerts -->
<div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="savealert">
<div class="modal-dialog">
	<div class="modal-content">
	<div class="modal-header">
		<h5 id="savealert-text">Your search has been saved</h5>
		<button type="button" class="close" data-dismiss="modal" aria-label="Close">
			<span aria-hidden="true">×</span>
		</button>
	</div>
	<div class="modal-body">
		You can find it under the "Advanced Search" pane.
	</div>
	<div class="modal-footer">
