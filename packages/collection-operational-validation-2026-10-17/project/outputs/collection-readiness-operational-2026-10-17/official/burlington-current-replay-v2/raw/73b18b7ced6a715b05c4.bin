        <tr><td><p class="CellBody">6035</p></td><td><p class="CellBodyR"><a rel="cgi/extract.pl?page=html/Burlington31/Burlington3101.html&amp;anchor=31-12" href="/VT/Burlington/#!/Burlington31/Burlington3101.html#31-12" class="basic">31-12</a></p></td></tr>
        <tr><td><p class="CellBody">6036</p></td><td><p class="CellBodyR"><a rel="cgi/extract.pl?page=html/Burlington31/Burlington3101.html&amp;anchor=31-13" href="/VT/Burlington/#!/Burlington31/Burlington3101.html#31-13" class="basic">31-13</a></p></td></tr>
        <tr><td><p class="CellBody">6037</p></td><td><p class="CellBodyR"><a rel="cgi/extract.pl?page=html/Burlington13/Burlington1301.html&amp;anchor=13-11" href="/VT/Burlington/#!/Burlington13/Burlington1301.html#13-11" class="basic">13-11</a></p></td></tr>
        <tr><td><p class="CellBody">6038</p></td><td><p class="CellBodyR"><a rel="cgi/extract.pl?page=html/Burlington31/Burlington3101.html&amp;anchor=31-14" href="/VT/Burlington/#!/Burlington31/Burlington3101.html#31-14" class="basic">31-14</a></p></td></tr>
