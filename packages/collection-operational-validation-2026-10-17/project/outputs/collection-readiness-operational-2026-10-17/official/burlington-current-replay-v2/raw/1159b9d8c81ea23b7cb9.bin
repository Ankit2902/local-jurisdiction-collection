          <td style="border: 1px solid black; padding: 3pt 2pt 2pt 2pt; vertical-align: top">
                        <p class="CellBody">Ch. 18</p>

          </td>
          <td style="border: 1px solid black; padding: 3pt 2pt 2pt 2pt; vertical-align: top">
                        <p class="CellBody" style="white-space:nowrap">Housing</p>

          </td>
