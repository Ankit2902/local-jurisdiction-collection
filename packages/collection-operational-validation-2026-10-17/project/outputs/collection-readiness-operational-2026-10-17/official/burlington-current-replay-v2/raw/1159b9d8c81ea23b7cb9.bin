          <td style="border: 1px solid black; padding: 3pt 2pt 2pt 2pt; vertical-align: top">
                        <p class="CellBody">Abandoned iceboxes</p>

          </td>
        </tr>
        <tr>
          <td style="border: 1px solid black; padding: 3pt 2pt 2pt 2pt; vertical-align: top">
                        <p class="CellBody">§&nbsp;<a rel="cgi/extract.pl?page=html/Burlington21/Burlington2101.html&amp;anchor=21-17" href="/VT/Burlington/#!/Burlington21/Burlington2101.html#21-17" class="basic">21-17</a></p>

          </td>
