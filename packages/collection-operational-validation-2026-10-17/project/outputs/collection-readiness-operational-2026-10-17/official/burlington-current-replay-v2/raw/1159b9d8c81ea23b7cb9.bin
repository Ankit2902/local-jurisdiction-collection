      <a rel="cgi/extract.pl?page=Burlington18/Burlington1801.html" href="/VT/Burlington/#!/Burlington18/Burlington1801.html" class="basic">
        <img src="/VT/Burlington/html/images/prev.gif" alt="Previous" border="0">
