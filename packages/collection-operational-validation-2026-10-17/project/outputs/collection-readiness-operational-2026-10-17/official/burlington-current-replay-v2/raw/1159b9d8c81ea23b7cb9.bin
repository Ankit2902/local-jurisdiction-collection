          <td style="border: 1px solid black; padding: 3pt 2pt 2pt 2pt; vertical-align: top">
                        <p class="CellBody">§&nbsp;<a rel="cgi/extract.pl?page=html/Burlington13/Burlington1301.html&amp;anchor=13-1" href="/VT/Burlington/#!/Burlington13/Burlington1301.html#13-1" class="basic">13-1</a></p>

          </td>
          <td style="border: 1px solid black; padding: 3pt 2pt 2pt 2pt; vertical-align: top">
                        <p class="CellBody">The Vermont Fire Protection Building Code</p>

          </td>
        </tr>
        <tr>
          <td style="border: 1px solid black; padding: 3pt 2pt 2pt 2pt; vertical-align: top">
                        <p class="CellBody">Ch. 14</p>

          </td>
          <td style="border: 1px solid black; padding: 3pt 2pt 2pt 2pt; vertical-align: top">
                        <p class="CellBody">Solid Waste</p>

          </td>
        </tr>
