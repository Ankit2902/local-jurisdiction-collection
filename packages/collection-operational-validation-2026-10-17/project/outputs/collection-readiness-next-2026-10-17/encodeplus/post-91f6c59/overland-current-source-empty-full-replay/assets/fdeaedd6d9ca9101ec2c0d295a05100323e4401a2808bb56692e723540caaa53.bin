<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Unexpected Error</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <style>
        :root {
            --brand-dark: #0A2342;   /* Deep navy */
            --brand-accent: #1E88E5;
            --brand-gold: #F2B632;
            --bg: #0A2342;           /* Page background */
            --card-bg: #0A2342;      /* Card background (dark) */
            --text: #ffffff;
            --subtle: #d0d6e0;
            --shadow: rgba(0, 0, 0, 0.6);
        }

        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                         Helvetica, Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
        }

        .card {
            background: var(--card-bg);
            padding: 48px 40px;
            max-width: 520px;
            width: 100%;
            border-radius: 12px;
            box-shadow: 0 4px 24px var(--shadow);
            text-align: center;
            border-top: 6px solid var(--brand-accent);
        }

        /* The wrapper that fixes the logo visibility */
        .logo-wrapper {
            padding: 16px 24px;
            border-radius: 10px;
            display: inline-block;
            margin-bottom: 1.5rem;
        }

        .logo {
            width: 180px;
            display: block;
        }

        h1 {
            margin-top: 0;
            font-size: 1.9rem;
            font-weight: 600;
            color: var(--brand-gold);
        }

        p {
            margin: 0.75rem 0;
            color: var(--subtle);
            line-height: 1.55;
        }

        .code {
            display: inline-block;
            margin-top: 1.2rem;
            padding: 8px 14px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 6px;
            font-family: Consolas, monospace;
            font-size: 0.9rem;
            color: var(--brand-gold);
        }

        .footer {
            margin-top: 2rem;
            font-size: 0.8rem;
            color: var(--subtle);
        }
    </style>
</head>
<body>
    <div class="card">

        <!-- Logo wrapper ensures white “enCode” text is visible -->
        <div class="logo-wrapper">
            <div class="logo">
