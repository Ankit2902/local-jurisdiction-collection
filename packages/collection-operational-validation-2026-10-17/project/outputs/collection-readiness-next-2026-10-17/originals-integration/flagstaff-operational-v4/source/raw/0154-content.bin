    <div id="mainContent">
      <h2 class="CH"><a name="9.05"></a>CHAPTER 9-05<br />BICYCLES</h2>
            <p class="digCH">SECTIONS:</p>

            <p class="CiteTOC"><a href="../Flagstaff09/Flagstaff0905000.html#9.05.001.0001">9-05-001-0001</a>&nbsp;&nbsp;&nbsp;&nbsp;APPLICATION OF PROVISIONS</p>

            <p class="CiteTOC"><a href="../Flagstaff09/Flagstaff0905000.html#9.05.001.0002">9-05-001-0002</a>&nbsp;&nbsp;&nbsp;&nbsp;DEFINITIONS</p>

            <p class="CiteTOC"><a href="../Flagstaff09/Flagstaff0905000.html#9.05.001.0003">9-05-001-0003</a>&nbsp;&nbsp;&nbsp;&nbsp;TRAFFIC LAWS APPLY</p>

