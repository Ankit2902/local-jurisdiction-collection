  <p class=MsoNormal><span style='font-size:12.0pt;font-family:"Arial",sans-serif;
  letter-spacing:-.1pt'>&nbsp;</span></p>
  </td>
  <td width=276 valign=top style='width:207.0pt;border-top:none;border-left:
  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:12.0pt;font-family:"Arial",sans-serif;
  letter-spacing:-.1pt'>&nbsp;</span></p>
  </td>
 </tr>
 <tr>
  <td width=288 colspan=2 valign=top style='width:3.0in;border:solid windowtext 1.0pt;
  border-top:none;padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:12.0pt;font-family:"Arial",sans-serif;
  letter-spacing:-.1pt'>For one to ten units, inclusive</span></p>
  </td>
  <td width=24 colspan=2 valign=top style='width:.25in;border-top:none;
  border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:12.0pt;font-family:"Arial",sans-serif;
  letter-spacing:-.1pt'>&nbsp;</span></p>
  </td>
  <td width=276 valign=top style='width:207.0pt;border-top:none;border-left:
  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:12.0pt;font-family:"Arial",sans-serif;
  letter-spacing:-.1pt'>200.00 per year or 100.00 per 6 mos.</span></p>
  </td>
 </tr>
 <tr>
  <td width=288 colspan=2 valign=top style='width:3.0in;border:solid windowtext 1.0pt;
  border-top:none;padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:12.0pt;font-family:"Arial",sans-serif;
  letter-spacing:-.1pt'>For more than ten units</span></p>
  </td>
  <td width=24 colspan=2 valign=top style='width:.25in;border-top:none;
  border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:12.0pt;font-family:"Arial",sans-serif;
  letter-spacing:-.1pt'>&nbsp;</span></p>
  </td>
  <td width=276 valign=top style='width:207.0pt;border-top:none;border-left:
  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:12.0pt;font-family:"Arial",sans-serif;
  letter-spacing:-.1pt'>400.00 per year or 200.00 per 6 mos.</span></p>
  </td>
 </tr>
 <tr>
  <td width=288 colspan=2 valign=top style='width:3.0in;border:solid windowtext 1.0pt;
  border-top:none;padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoToaHeading><span style='font-size:12.0pt;font-family:"Arial",sans-serif;
  letter-spacing:-.1pt'>Carnivals</span></p>
  </td>
  <td width=24 colspan=2 valign=top style='width:.25in;border-top:none;
  border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:12.0pt;font-family:"Arial",sans-serif;
  letter-spacing:-.1pt'>&nbsp;</span></p>
  </td>
  <td width=276 valign=top style='width:207.0pt;border-top:none;border-left:
  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:12.0pt;font-family:"Arial",sans-serif;
  letter-spacing:-.1pt'>&nbsp;</span></p>
  </td>
 </tr>
 <tr>
  <td style='border:none;padding:0in 0in 0in 0in' width=1><p class='MsoNormal'>&nbsp;</td>
  <td width=288 colspan=2 valign=top style='width:3.0in;border:solid windowtext 1.0pt;
  border-top:none;padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:12.0pt;font-family:"Arial",sans-serif;
  letter-spacing:-.1pt'>For one to ten units, inclusive</span></p>
  </td>
  <td width=23 valign=top style='width:17.4pt;border-top:none;border-left:none;
  border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:12.0pt;font-family:"Arial",sans-serif;
  letter-spacing:-.1pt'>&nbsp;</span></p>
  </td>
  <td width=276 valign=top style='width:207.0pt;border-top:none;border-left:
  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:12.0pt;font-family:"Arial",sans-serif;
  letter-spacing:-.1pt'>40.00 per day</span></p>
  </td>
 </tr>
 <tr>
  <td style='border:none;padding:0in 0in 0in 0in' width=1><p class='MsoNormal'>&nbsp;</td>
  <td width=288 colspan=2 valign=top style='width:3.0in;border:solid windowtext 1.0pt;
  border-top:none;padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:12.0pt;font-family:"Arial",sans-serif;
  letter-spacing:-.1pt'>For more than ten units</span></p>
  </td>
  <td width=23 valign=top style='width:17.4pt;border-top:none;border-left:none;
  border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:12.0pt;font-family:"Arial",sans-serif;
  letter-spacing:-.1pt'>&nbsp;</span></p>
  </td>
  <td width=276 valign=top style='width:207.0pt;border-top:none;border-left:
  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt'>
  <p class=MsoNormal><span style='font-size:12.0pt;font-family:"Arial",sans-serif;
  letter-spacing:-.1pt'>100.00 per day</span></p>
  </td>
 </tr>
 <tr height=0>
  <td width=1 style='border:none'></td>
  <td width=287 style='border:none'></td>
  <td width=1 style='border:none'></td>
