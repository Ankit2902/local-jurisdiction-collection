        </tr>
        <tr>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">Machinery</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">Transportation equipment</p>

          </td>
        </tr>
        <tr>
