        <tr>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">Fabrics and sewing supplies</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">Sporting goods and equipment</p>

          </td>
        </tr>
        <tr>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">Feed stores</p>

