<body lang=EN-US link=blue vlink=purple style='word-wrap:break-word'>

<div class=WordSection1>

<p class=MsoBodyText2 align=center style='text-align:center'><b><span
style='font-size:12.0pt;letter-spacing:-.1pt'>Title 19A</span></b></p>

<p class=MsoBodyText2 align=center style='text-align:center'><b><span
style='font-size:12.0pt;letter-spacing:-.1pt'>LAND SEGREGATION</span></b></p>

<p class=MsoBodyText2><span style='font-size:12.0pt;letter-spacing:-.1pt'>&nbsp;</span></p>

<p class=MsoNormal align=center style='text-align:center'><b><span
style='font-size:12.0pt;font-family:"Arial",sans-serif;letter-spacing:-.1pt'>UPDATED: 
May 9, 2025</span></b></p>

<p class=MsoBodyText2><span style='font-size:12.0pt;letter-spacing:-.1pt'>&nbsp;</span></p>

<p class=MsoTocHeading style='margin-top:0in;line-height:normal'><span
style='font-size:12.0pt;font-family:"Arial",sans-serif'>Chapters:</span></p>

