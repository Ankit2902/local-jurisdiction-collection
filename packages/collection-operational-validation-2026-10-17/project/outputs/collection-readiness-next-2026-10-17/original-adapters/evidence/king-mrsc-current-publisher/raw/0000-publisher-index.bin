<script>
window.addEventListener('load', function(e) {
    const searchUrl = "/search-results"

    function go() {
        const q = document.getElementById('txtSearch').value || "";
        window.location.href = `${searchUrl}?q=${encodeURIComponent(q)}`;
    }

    document.getElementById('btnMainSearch').addEventListener('click', go);
    document.getElementById('txtSearch').addEventListener('keydown', (e) => { if (e.key === 'Enter') go(); });

})
</script>
    
    
    
