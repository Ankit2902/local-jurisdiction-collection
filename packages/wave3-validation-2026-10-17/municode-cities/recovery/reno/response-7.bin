{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":150,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PT2READCO_TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 1.01.010. - Designation and citation.</div>","ShouldShowMiniToc":false,"Id":"PT2READCO_TIT1GEPR_CH1.01COINCO_S1.01.010DECI","Title":"Sec. 1.01.010. - Designation and citation.","Content":"<div class=\"chunk-content\">\n            <p class=\"b0\">\n               The ordinances embraced in this and the following chapters and sections shall constitute\n               and be designated the \"Reno Municipal Code\" and may be so cited.\n               </p>\n            <p class=\"historynote0\">\n               (Code 1966, § 1.01.010)\n               </p>\n            <p class=\"refcharter0\" block_type=\"hang\"><b>Charter reference— </b>\n               Codification authority, <a href=\"\" data-chunk-id=\"PT1RECH_ARTIILEDE_S2.120COORPUCO\" class=\"section-link\" data-product-id=\"14160\">§ 2.120</a>.\n               </p>\n            <p class=\"refstatelaw0\" block_type=\"hang\"><b>State Law reference— </b>\n               Codification authority, NRS 268.014.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PT2READCO_TIT1GEPR_CH1.01COINCO","Heading":"CHAPTER 1.01. - CODE INTERPRETATION AND CONSTRUCTION","NodeDepth":2,"HasChildren":true,"ParentId":"PT2READCO_TIT1GEPR","DocOrderId":149,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PT2READCO_TIT1GEPR_CH1.01COINCO_S1.01.020DE","Heading":"Sec. 1.01.020. - Definitions.","NodeDepth":3,"HasChildren":false,"ParentId":"PT2READCO_TIT1GEPR_CH1.01COINCO","DocOrderId":151,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"C