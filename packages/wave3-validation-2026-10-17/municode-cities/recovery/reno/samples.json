    "content": {
      "Docs": [
        {
          "DocType": 1,
          "IsAmended": false,
          "IsUpdated": false,
          "CompareStatus": 4,
          "DocOrderId": 151,
          "AmendedBy": [],
          "Notes": [],
          "Drafts": [],
          "ChunkGroupStartingNodeId": "PT2READCO_TIT1GEPR",
          "NodeDepth": 3,
          "TitleHtml": "<div class=\"chunk-title\">Sec. 1.01.020. - Definitions.</div>",
          "ShouldShowMiniToc": false,
          "Id": "PT2READCO_TIT1GEPR_CH1.01COINCO_S1.01.020DE",
          "Title": "Sec. 1.01.020. - Definitions.",
          "Content": "<div class=\"chunk-content\">\n            <p class=\"b0\">\n               The following definitions shall be observed unless it shall be otherwise expressly\n               provided in any section or unless inconsistent with the manifest intent of the city\n               council or unless the context clearly requires otherwise:\n               \n               <p class=\"incr1\">\n                  (1)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">\"Board of health\"</span> shall mean the county district board of health.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (2)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">\"Charter\"</span> is deemed to mean and refer to the Charter of Reno, Nevada.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (3)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">\"City\"</span> means the city of Reno, in the State of Nevada.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (4)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">\"Code\"</span> shall mean the Reno Municipal Code, as amended.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (5)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">\"Council\"</span> means the city council consisting off six (6) councilmembers and a mayor of the city.\n                  \"All its members\" or \"all councilmembers\" mean the total number of councilmembers\n                  and the mayor as provided for by the Charter of Reno, Nevada.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (6)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">\"County\"</span> shall mean Washoe County, Nevada.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (7)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">\"Health department\"</span> shall mean the county district health department of the board of health.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (8)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">\"Health officers\"</span> shall mean the county district health officer or health administrator of the board\n                  of health or their designee.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (9)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">\"Person\"</span> includes a corporation, firm, partnership, association, as well as individuals. It\n                  shall also include an executor, administrator, trustee, receiver or other representative\n                  appointed according to law.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (10)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">\"Public officer\"</span> as used in this Code shall mean a person elected or appointed to a position which\n                  is created by the Charter or ordinance.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (11)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">\"May\"</span> is permissive.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (12)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">\"Must\"</span> and <span class=\"ital\">\"shall.\"</span> Each is mandatory.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (13)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">\"NRS.\"</span> The abbreviation \"NRS\" shall mean the Nevada Revised Statutes, as amended.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (14)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">\"Officers, departments, board, and commission.\"</span> Except as otherwise specifically provided, whenever any officer, department, board,\n                  commission or their agency is referred to by title alone, such reference shall be\n                  construed as if followed by the words \"of the City of Reno, Nevada.\" Whenever in accordance\n                  with the provisions of this Code any specific act is required to be done by any designated\n                  officer or official of the city, such act may be performed by any duly authorized\n                  member of his department.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (15)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">\"Or, and.\"</span> \"Or\" may read \"and,\" and \"and\" may be read \"or\" if the sense requires it.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (16)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"ital\">\"State.\"</span> The word \"the state\" or \"this state\" shall be construed to mean the State of Nevada.\n                  </p>\n               \t\t\n               \n            <p class=\"historynote0\">\n               (Code 1966, § 1.04.020)\n               </p></div>",
          "SortDate": null,
          "Footnotes": null
        }
      ],
