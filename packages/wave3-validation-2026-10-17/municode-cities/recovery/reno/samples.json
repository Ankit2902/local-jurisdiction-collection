    "content": {
      "Docs": [
        {
          "DocType": 1,
          "IsAmended": false,
          "IsUpdated": false,
          "CompareStatus": 4,
          "DocOrderId": 152,
          "AmendedBy": [],
          "Notes": [],
          "Drafts": [],
          "ChunkGroupStartingNodeId": "PT2READCO_TIT1GEPR",
          "NodeDepth": 3,
          "TitleHtml": "<div class=\"chunk-title\">Sec. 1.01.030. - Grammatical interpretation.</div>",
          "ShouldShowMiniToc": false,
          "Id": "PT2READCO_TIT1GEPR_CH1.01COINCO_S1.01.030GRIN",
          "Title": "Sec. 1.01.030. - Grammatical interpretation.",
          "Content": "<div class=\"chunk-content\">\n            <p class=\"b0\">\n               The following grammatical rules shall apply in the ordinances of the city:\n               \n               <p class=\"incr1\">\n                  (1)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"bold\">Gender.</span> When any subject matter, party or person is described or referred to by words importing\n                  the masculine, female as well as males, and associations and bodies corporate as well\n                  as individuals, shall be deemed to be included.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (2)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"bold\">Singular and plural.</span> The singular number includes the plural and the plural includes the singular.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (3)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"bold\">Tenses.</span> Words used in the present tense include the past and the future tenses and vice versa,\n                  unless manifestly inapplicable.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (4)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  <span class=\"bold\">Use of words and phrases.</span> Words and phrases not specifically defined shall be construed according to the context\n                  and approved usage of the language.\n                  </p>\n               \t\t\n               \n            <p class=\"historynote0\">\n               (Code 1966, § 1.04.050)\n               </p></div>",
          "SortDate": null,
          "Footnotes": null
        }
      ],
