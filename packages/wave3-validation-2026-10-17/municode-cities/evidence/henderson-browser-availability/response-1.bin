.timeline {
  position: relative;
  list-style: none;
  padding: 20px 0 0 0;
  left: 50%;
}
.timeline:before {
  top: 0;
  bottom: 0;
  position: absolute;
  content: " ";
  width: 4px;
  background-color: #0c0c0c;
  opacity: 0.15;
  left: 0;
  margin-left: -2px;
}
.timeline-hairline.timeline:before {
  width: 2px;
  margin-left: -1px;
}
.timeline li {
  position: relative;
  display: block;
  width: 50%;
  left: -50%;
  white-space: nowrap;
  min-height: 30px;
  -moz-box-sizing: border-box;
  -webkit-box-sizing: border-box;
  box-sizing: border-box;
}
.timeline-entry {
  position: relative;
  display: inline-block;
  width: 100%;
  padding: 0;
  vertical-align: top;
  margin: 0 -3px 0 0;
  white-space: normal;
}
