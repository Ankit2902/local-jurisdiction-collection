}
.fullservice_xhtml div.chunk-content > ol.wide-marker,
.fullservice_xhtml div.chunk-content td > ol.wide-marker,
.fullservice_xhtml div.chunk-content > ul.wide-marker,
.fullservice_xhtml div.chunk-content td > ul.wide-marker {
  margin-left: 11rem;
}
.fullservice_xhtml div.chunk-content ol ol,
.fullservice_xhtml div.chunk-content ol ul,
.fullservice_xhtml div.chunk-content ul ol,
.fullservice_xhtml div.chunk-content ul ul {
  margin-left: 2.5rem;
}
.fullservice_xhtml div.chunk-content ol.custom-incrementors > li[data-incr]::marker {
  content: attr(data-incr);
  counter-increment: none;
}
@supports (hanging-punctuation: first) and (-webkit-appearance: none) {
  .fullservice_xhtml div.chunk-content ol.custom-incrementors > li[data-incr] {
    position: relative;
  }
  .fullservice_xhtml div.chunk-content ol.custom-incrementors > li[data-incr]::before {
    content: attr(data-incr);
    counter-increment: none;
    position: absolute;
    right: 100%;
    margin-right: 0.25rem;
  }
}
.fullservice_xhtml div.chunk-content p[data-type='refcaselaw']:before {
  content: 'Case law reference(s)\2014';
  font-weight: bold;
}
.fullservice_xhtml div.chunk-content p[data-type='refcaselawanno']:before {
  content: 'Case law annotation(s)\2014';
  font-weight: bold;
}
.fullservice_xhtml div.chunk-content p[data-type='refcharter']:before {
  content: 'Charter reference(s)\2014';
  font-weight: bold;
}
