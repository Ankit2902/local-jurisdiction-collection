.alert.alert-callout {
  position: relative;
  padding-left: 20px;
  background: #fff;
  color: hsl(208.61538462, 3%, 20%);
  border-radius: 3px;
  border-color: hsla(208.61538462, 3%, 33.5%, 0.15);
}
.alert.alert-callout:before {
  content: '';
  position: absolute;
  display: block;
  width: 4px;
  left: -1px;
  top: -1px;
  bottom: -1px;
  background: red;
}
.alert-callout.alert-success:before {
  background: #208822;
}
.alert-callout.alert-info:before {
  background: #096fcc;
}
.alert-callout.alert-warning:before {
  background: #FF9800;
}
.alert-callout.alert-danger:before {
  background: #d0291c;
}
