}
#menubar.animate {
  -webkit-transition: width 0.5s cubic-bezier(0.15, 0.99, 0.18, 1.01);
  -o-transition: width 0.5s cubic-bezier(0.15, 0.99, 0.18, 1.01);
  transition: width 0.5s cubic-bezier(0.15, 0.99, 0.18, 1.01);
}
