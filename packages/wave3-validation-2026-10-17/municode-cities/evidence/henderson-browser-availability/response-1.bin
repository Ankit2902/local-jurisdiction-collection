#base {
  overflow: hidden;
  padding-left: 64px;
  width: 100%;
  min-height: 100%;
}
#base > .backdrop {
  position: fixed;
  z-index: 1031;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: block;
  background-color: rgba(12, 12, 12, 0.33);
}
#base.hide-backdrop > .backdrop {
  display: none;
  position: relative;
}
#content {
  position: relative;
  width: 100%;
  left: 0;
  padding-top: 70px;
}
