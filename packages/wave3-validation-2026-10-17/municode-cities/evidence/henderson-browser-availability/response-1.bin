.fullservice_xhtml div.chunk-content .center {
  text-align: center;
}
.fullservice_xhtml div.chunk-content ol,
.fullservice_xhtml div.chunk-content ul {
  list-style-type: "";
  list-style-position: outside;
}
.fullservice_xhtml div.chunk-content ol li,
.fullservice_xhtml div.chunk-content ul li {
  padding-left: 0.5rem;
}
.fullservice_xhtml div.chunk-content ol li figure,
.fullservice_xhtml div.chunk-content ul li figure {
  text-align: left !important;
  margin: 13px 0 !important;
}
.fullservice_xhtml div.chunk-content ol li figure img,
.fullservice_xhtml div.chunk-content ul li figure img {
  margin: 0 !important;
}
