  content: 'Cross reference(s)\2014';
  font-weight: bold;
}
.fullservice_xhtml div.chunk-content p[data-type='refeditor']:before {
  content: "Editor's note(s)\2014";
  font-weight: bold;
}
.fullservice_xhtml div.chunk-content p[data-type='refgeneric']:before {
  content: 'Reference(s)\2014';
  font-weight: bold;
}
.fullservice_xhtml div.chunk-content p[data-type='refmanual']:before {
  content: none;
}
.fullservice_xhtml div.chunk-content p[data-type='refnote']:before {
  content: 'Note(s)\2014';
  font-weight: bold;
}
.fullservice_xhtml div.chunk-content p[data-type='refstateconst']:before {
  content: 'State constitution reference(s)\2014';
  font-weight: bold;
}
.fullservice_xhtml div.chunk-content p[data-type='refstatelaw']:before {
  content: 'State law reference(s)\2014';
  font-weight: bold;
}
.fullservice_xhtml div.chunk-content p[data-type='refmanual'],
.fullservice_xhtml div.chunk-content p[data-type='refeditor'],
.fullservice_xhtml div.chunk-content p[data-type='refcharter'],
.fullservice_xhtml div.chunk-content p[data-type='refstatelaw'],
.fullservice_xhtml div.chunk-content p[data-type='refcross'],
.fullservice_xhtml div.chunk-content p[data-type='refstateconst'],
.fullservice_xhtml div.chunk-content p[data-type='refcaselaw'],
.fullservice_xhtml div.chunk-content p[data-type='refcaselawanno'],
.fullservice_xhtml div.chunk-content p[data-type='refnote'],
.fullservice_xhtml div.chunk-content p[data-type='refgeneric'] {
  margin-top: 0pt;
  /*  WEK: Was 10pt */
}
.fullservice_xhtml div.chunk-content p[data-type='refmanualfn'],
.fullservice_xhtml div.chunk-content p[data-type='refeditorfn'],
.fullservice_xhtml div.chunk-content p[data-type='refcharterfn'],
.fullservice_xhtml div.chunk-content p[data-type='refcrossfn'],
.fullservice_xhtml div.chunk-content p[data-type='refstatelawfn'],
.fullservice_xhtml div.chunk-content p[data-type='refstateconstfn'],
.fullservice_xhtml div.chunk-content p[data-type='refcaselawfn'],
.fullservice_xhtml div.chunk-content p[data-type='refcaselawannofn'],
.fullservice_xhtml div.chunk-content p[data-type='refnotefn'],
.fullservice_xhtml div.chunk-content p[data-type='refgenericfn'] {
  margin-top: 0pt /*12pt*/;
  font-weight: normal;
}
.fullservice_xhtml div.chunk-content span[data-lf='.']:before {
  content: ". . . . . . . . . . . . . . . . . . . . . . . . ";
}
.fullservice_xhtml div.chunk-content span[data-lf='_']:before {
  content: "__________________________";
}
.fullservice_xhtml div.chunk-content span[data-lf='-']:before {
  content: "------------------------------";
}
.fullservice_xhtml div.chunk-content span[data-lf='\2014']:before {
  content: '\2014\2014\2014\2014\2014';
}
.fullservice_xhtml div.chunk-content span[data-lf=' ']:before {
  content: "                               ";
}
.fullservice_xhtml div.chunk-content span.title,
.fullservice_xhtml div.chunk-content li.title {
  font-weight: bold;
  font-style: normal;
}
.fullservice_xhtml div.chunk-content dfn {
  font-weight: bold;
  font-style: normal;
}
