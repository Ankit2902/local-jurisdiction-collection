{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":3,"DocOrderId":161,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"CHGEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1 - How Code designated and cited.</div>","ShouldShowMiniToc":false,"Id":"CH1GEPR_S1-1HOCODEC","Title":"Sec. 1-1 - How Code designated and cited.","Content":"<div class=\"chunk-content\">\n                  \n                  <p>The ordinances embraced in the following chapters and sections shall constitute and\n                     be designated the \"Code of Ordinances, Lexington-Fayette Urban County Government,\"\n                     and may be\n                     so cited.\n                  </p>\n                  <p data-type=\"historynote\">(Ord. No. 89-74, § 1, 5-30-74)</p>\n                  <p data-type=\"refcharter\">Merger of county and city governments, § 1.01.</p>\n               </div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"CHGEPR","Heading":"Chapter 1 - General Provisions","NodeDepth":1,"HasChildren":true,"ParentId":"17500","DocOrderId":160,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":3,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"CH1GEPR_S1-2DERUC","Heading":"Sec. 1-2 - Rules of construction.","NodeDepth":2,"HasChildren":false,"ParentId":"CHGEPR","DocOrderId":162,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":3,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}