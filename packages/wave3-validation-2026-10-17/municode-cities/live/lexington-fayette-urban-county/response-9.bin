{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":3,"DocOrderId":163,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"CHGEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-3 - Catchlines of sections.</div>","ShouldShowMiniToc":false,"Id":"CH1GEPR_S1-3CAS","Title":"Sec. 1-3 - Catchlines of sections.","Content":"<div class=\"chunk-content\">\n                  \n                  <p>The catchlines of the several sections of this Code printed in boldface type are intended\n                     as mere catchwords to indicate the contents of the sections and shall not be deemed\n                     or\n                     taken to be the titles of such sections, nor as any part of the sections; nor, unless\n                     expressly so provided, shall they be so deemed when any of such sections, including\n                     the catchlines, are amended or reenacted.\n                  </p>\n               </div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"CH1GEPR_S1-2DERUC","Heading":"Sec. 1-2 - Rules of construction.","NodeDepth":2,"HasChildren":false,"ParentId":"CHGEPR","DocOrderId":162,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":3,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"CH1GEPR_S1-4EFROR","Heading":"Sec. 1-4 - Effect of repeal of ordinances.","NodeDepth":2,"HasChildren":false,"ParentId":"CHGEPR","DocOrderId":164,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":3,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}