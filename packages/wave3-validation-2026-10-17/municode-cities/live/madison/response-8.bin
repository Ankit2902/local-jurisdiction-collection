{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":3,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COORMAWIVOICH1--10_CH1COEFORTHPU","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">1.02 - WHEN THESE RULES OF CONSTRUCTION SHALL NOT APPLY.</div>","ShouldShowMiniToc":false,"Id":"COORMAWIVOICH1--10_CH1COEFORTHPU_1.02WHTHRUCOSHNOAP","Title":"1.02 - WHEN THESE RULES OF CONSTRUCTION SHALL NOT APPLY.","Content":"<div class=\"chunk-content\">\n            <p class=\"runin\">\n               The rules of construction set forth in this chapter shall not be applied to any ordinance\n               which shall contain any express provision excluding such construction, or when the\n               subject matter or context of such ordinance may be repugnant thereto.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"COORMAWIVOICH1--10_CH1COEFORTHPU_1.01COOR","Heading":"1.01 - CONSTRUCTION OF ORDINANCES.","NodeDepth":2,"HasChildren":false,"ParentId":"COORMAWIVOICH1--10_CH1COEFORTHPU","DocOrderId":2,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"COORMAWIVOICH1--10_CH1COEFORTHPU_1.03RETICHSEONOR","Heading":"1.03 - REFERENCES TO TITLES, CHAPTERS, OR SECTIONS - CONFLICTING ORDINANCES.","NodeDepth":2,"HasChildren":false,"ParentId":"COORMAWIVOICH1--10_CH1COEFORTHPU","DocOrderId":4,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}