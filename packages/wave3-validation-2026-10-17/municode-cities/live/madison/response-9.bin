{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":4,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COORMAWIVOICH1--10_CH1COEFORTHPU","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">1.03 - REFERENCES TO TITLES, CHAPTERS, OR SECTIONS - CONFLICTING ORDINANCES.</div>","ShouldShowMiniToc":false,"Id":"COORMAWIVOICH1--10_CH1COEFORTHPU_1.03RETICHSEONOR","Title":"1.03 - REFERENCES TO TITLES, CHAPTERS, OR SECTIONS - CONFLICTING ORDINANCES.","Content":"<div class=\"chunk-content\">\n            <p class=\"runin\">\n               In addition to the rules of construction specified in Section <a href=\"\" data-chunk-id=\"COORMAWIVOICH1--10_CH1COEFORTHPU_1.01COOR\" class=\"section-link\" data-product-id=\"50000\">1.01</a>, the following rules shall be observed in the construction of these ordinances:\n               </p>\n            <p class=\"incr1\">\n               (1)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               All references to titles, chapters, or sections are to the titles, chapters and sections\n               of these ordinances unless otherwise specified.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (2)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               If the provisions of different chapters of these ordinances conflict with or contravene\n               each other, the provisions of each chapter shall prevail as to all matters and questions\n               growing out of the subject matter of such chapter.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (3)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               If conflicting provisions be found in different sections of the same chapter the provisions\n               of the section which is last in numerical order shall prevail unless such construction\n               be inconsistent with the meaning of such chapter.\n               </p>\n            \t\t</div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"COORMAWIVOICH1--10_CH1COEFORTHPU_1.02WHTHRUCOSHNOAP","Heading":"1.02 - WHEN THESE RULES OF CONSTRUCTION SHALL NOT APPLY.","NodeDepth":2,"HasChildren":false,"ParentId":"COORMAWIVOICH1--10_CH1COEFORTHPU","DocOrderId":3,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"COORMAWIVOICH1--10_CH1COEFORTHPU_1.04ORHETAEF","Heading":"1.04 - ORDINANCES - WHEN TO TAKE EFFECT.","NodeDepth":2,"HasChildren":false,"ParentId":"COORMAWIVOICH1--10_CH1COEFORTHPU","DocOrderId":5,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}