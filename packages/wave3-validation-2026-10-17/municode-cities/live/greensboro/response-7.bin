{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":237,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COOR_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1. - How Code designated and cited.</div>","ShouldShowMiniToc":false,"Id":"COOR_CH1GEPR_S1-1HOCODECI","Title":"Sec. 1-1. - How Code designated and cited.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The laws embraced in the following chapters and sections shall constitute and be designated\n               and cited as the \"Greensboro Code of Ordinances.\"\n               </p>\n            <p class=\"historynote0\">\n               (Code 1961, § 1-1)\n               </p>\n            <p class=\"refcharter0\" block_type=\"hang\"><b>Charter reference— </b>\n               Authority of city to codify, <a href=\"\" data-chunk-id=\"CH_CHIIIMACO_SUBCHAPTER_CCOORPR_S3.43COOR\" class=\"section-link\" data-product-id=\"10736\">§ 3.43</a>.\n               </p>\n            <p class=\"refstatelaw0\" block_type=\"hang\"><b>State Law reference— </b>\n               Authority of city to codify, G.S. § 160A-77.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"COOR_CH1GEPR","Heading":"Chapter 1 - GENERAL PROVISIONS","NodeDepth":1,"HasChildren":true,"ParentId":"10736","DocOrderId":236,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"COOR_CH1GEPR_S1-2RUCO","Heading":"Sec. 1-2. - Rules of construction.","NodeDepth":2,"HasChildren":false,"ParentId":"COOR_CH1GEPR","DocOrderId":238,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}