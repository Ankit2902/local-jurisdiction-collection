{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":108,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">1.02.020 - Provisions deemed as continuations of existing ordinances.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1.02ESEFCO_1.02.020PRDECOEXOR","Title":"1.02.020 - Provisions deemed as continuations of existing ordinances.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The provisions of this Code, insofar as they are substantially the same as legislation\n               previously adopted by the city relating to the same subject matter, shall be construed\n               as restatements and continuations thereof and not as new enactments.\n               </p>\n            <p class=\"historynote0\">\n               (Ord. No. <a class=\"ordinance-link\" href=\"\" data-product-id=\"14896\" data-ordinance-id=\"655671\">3173</a>, § 1, 6-17-2014)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1.02ESEFCO_1.02.010TI","Heading":"1.02.010 - Title.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.02ESEFCO","DocOrderId":107,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1.02ESEFCO_1.02.030CODONOAFPROFRI","Heading":"1.02.030 - Code does not affect prior offenses or rights.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.02ESEFCO","DocOrderId":109,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}