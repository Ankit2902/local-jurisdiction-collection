{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":127,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PTIICOOR_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1. - How Code designated and cited.</div>","ShouldShowMiniToc":false,"Id":"PTIICOOR_CH1GEPR_S1-1HOCODECI","Title":"Sec. 1-1. - How Code designated and cited.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The ordinances embraced in this and the following chapters and sections shall constitute\n               and be designated the \"Code of Ordinances, City of Plano, Texas,\" and may be so cited.\n               \n               <p class=\"refcharter0\" block_type=\"hang\"><b>Charter reference— </b>\n                  Authority of council to have ordinances codified, <a href=\"\" data-chunk-id=\"PTIHORUCH_ART3THCO_S3.11PRPAOR\" class=\"section-link\" data-product-id=\"10327\">§ 3.11</a>.\n                  </p>\n               \n               <p class=\"refstatelaw0\" block_type=\"hang\"><b>State Law reference— </b>\n                  Authority of city to adopt a civil and criminal Code of Ordinances, Vernon's Ann.\n                  Civ. St., art. 1176a.\n                  </p>\n               </div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PTIICOOR_CH1GEPR","Heading":"Chapter 1 - GENERAL PROVISIONS","NodeDepth":1,"HasChildren":true,"ParentId":"10327","DocOrderId":126,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PTIICOOR_CH1GEPR_S1-2CASE","Heading":"Sec. 1-2. - Catchlines of sections.","NodeDepth":2,"HasChildren":false,"ParentId":"PTIICOOR_CH1GEPR","DocOrderId":128,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}