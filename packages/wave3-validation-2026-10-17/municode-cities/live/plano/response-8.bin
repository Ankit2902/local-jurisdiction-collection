{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":128,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PTIICOOR_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-2. - Catchlines of sections.</div>","ShouldShowMiniToc":false,"Id":"PTIICOOR_CH1GEPR_S1-2CASE","Title":"Sec. 1-2. - Catchlines of sections.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The catchlines of the several sections of this Code printed in boldface type are intended\n               as mere catchwords to indicate the contents of the section and shall not be deemed\n               or taken to be titles of such sections, nor as any part of the section, nor, unless\n               expressly so provided, shall they be so deemed when any of such sections, including\n               the catchlines, are amended or reenacted.\n               \n               <p class=\"refstatelaw0\" block_type=\"hang\"><b>State Law reference— </b>\n                  Captions not part of statute, Vernon's Ann. Civ. St., art. 5429b-2, <a href=\"\" data-chunk-id=\"PTIHORUCH_ART3THCO_S3.04CO\" class=\"section-link\" data-product-id=\"10327\">§ 3.04</a>.\n                  </p>\n               </div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PTIICOOR_CH1GEPR_S1-1HOCODECI","Heading":"Sec. 1-1. - How Code designated and cited.","NodeDepth":2,"HasChildren":false,"ParentId":"PTIICOOR_CH1GEPR","DocOrderId":127,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PTIICOOR_CH1GEPR_S1-3RUCODE","Heading":"Sec. 1-3. - Rules of construction and definitions.","NodeDepth":2,"HasChildren":false,"ParentId":"PTIICOOR_CH1GEPR","DocOrderId":129,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}