{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":5,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"CH1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">§ 1-2. - Territorial applicability.</div>","ShouldShowMiniToc":false,"Id":"CH1GEPR_ARTIADCO_S1-2TEAP","Title":"§ 1-2. - Territorial applicability.","Content":"<div class=\"chunk-content\">\n            <p class=\"b0\">\n               The Code shall refer only to the omission or commission of acts within the territorial\n               limits of the city and to that territory outside the city over which the city has\n               jurisdiction or control by virtue of any constitutional or Charter provisions or any\n               law.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"CH1GEPR_ARTIADCO_S1-1AD1995CO","Heading":"§ 1-1. - Adoption of 1995 Code.","NodeDepth":3,"HasChildren":false,"ParentId":"CH1GEPR_ARTIADCO","DocOrderId":4,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"CH1GEPR_ARTIADCO_S1-3COSUPROR","Heading":"§ 1-3. - Code supersedes prior ordinances.","NodeDepth":3,"HasChildren":false,"ParentId":"CH1GEPR_ARTIADCO","DocOrderId":6,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}