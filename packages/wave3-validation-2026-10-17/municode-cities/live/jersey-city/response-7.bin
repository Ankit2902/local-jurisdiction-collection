{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":4,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"CH1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">§ 1-1. - Adoption of 1995 Code.</div>","ShouldShowMiniToc":false,"Id":"CH1GEPR_ARTIADCO_S1-1AD1995CO","Title":"§ 1-1. - Adoption of 1995 Code.","Content":"<div class=\"chunk-content\">\n            <p class=\"b0\">\n               Pursuant to <span class=\"ulsingle\">N.J.S.A.</span> 40:49-4, the ordinances of the City of Jersey City of a general and permanent nature\n               adopted by the Council of the City of Jersey City, as revised, codified and consolidated\n               into chapters and sections by General Code Publishers Corp., and consisting of <a href=\"\" data-chunk-id=\"CH1GEPR\" class=\"section-link\" data-product-id=\"16093\">Chapters 1</a> through 346, together with an Appendix, are hereby approved, adopted, ordained and\n               enacted as the \"Code of the City of Jersey City,\" hereinafter known and referred to\n               as the \"Code.\"\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"CH1GEPR_ARTIADCO","Heading":"ARTICLE I - Adoption of Code","NodeDepth":2,"HasChildren":true,"ParentId":"CH1GEPR","DocOrderId":3,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"CH1GEPR_ARTIADCO_S1-2TEAP","Heading":"§ 1-2. - Territorial applicability.","NodeDepth":3,"HasChildren":false,"ParentId":"CH1GEPR_ARTIADCO","DocOrderId":5,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}