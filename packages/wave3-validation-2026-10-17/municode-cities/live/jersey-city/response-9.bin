{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":6,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"CH1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">§ 1-3. - Code supersedes prior ordinances.</div>","ShouldShowMiniToc":false,"Id":"CH1GEPR_ARTIADCO_S1-3COSUPROR","Title":"§ 1-3. - Code supersedes prior ordinances.","Content":"<div class=\"chunk-content\">\n            <p class=\"b0\">\n               This ordinance and the Code shall supersede all general and permanent ordinances enacted\n               prior to the enactment of this Code, except such ordinances as are hereinafter expressly\n               saved from repeal or continued in force.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"CH1GEPR_ARTIADCO_S1-2TEAP","Heading":"§ 1-2. - Territorial applicability.","NodeDepth":3,"HasChildren":false,"ParentId":"CH1GEPR_ARTIADCO","DocOrderId":5,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"CH1GEPR_ARTIADCO_S1-4WHEF","Heading":"§ 1-4. - When effective.","NodeDepth":3,"HasChildren":false,"ParentId":"CH1GEPR_ARTIADCO","DocOrderId":7,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}