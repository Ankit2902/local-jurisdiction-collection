{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":420,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TITIICICO_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1.03. - Provisions Considered as Continuations of Existing Ordinances.</div>","ShouldShowMiniToc":false,"Id":"TITIICICO_CH1GEPR_S1.03PRCOCOEXOR","Title":"Sec. 1.03. - Provisions Considered as Continuations of Existing Ordinances.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The provisions appearing in this Code, so far as they are the same as those of ordinances\n               existing at the time of the effective date of this Code, shall be considered as continuations\n               thereof and not as new enactments.\n               </p>\n            <p class=\"historynote0\">\n               (Ord. of 10-11-1982, Doc. #17335)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TITIICICO_CH1GEPR_S1.02RUCO","Heading":"Sec. 1.02. - Rules of Construction.","NodeDepth":2,"HasChildren":false,"ParentId":"TITIICICO_CH1GEPR","DocOrderId":419,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TITIICICO_CH1GEPR_S1.04EFREOR","Heading":"Sec. 1.04. - Effect of Repeal of Ordinances.","NodeDepth":2,"HasChildren":false,"ParentId":"TITIICICO_CH1GEPR","DocOrderId":421,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}