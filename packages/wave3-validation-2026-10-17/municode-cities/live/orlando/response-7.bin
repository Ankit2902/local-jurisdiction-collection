{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":418,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TITIICICO_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1.01. - How Code Designated and Cited.</div>","ShouldShowMiniToc":false,"Id":"TITIICICO_CH1GEPR_S1.01HOCODECI","Title":"Sec. 1.01. - How Code Designated and Cited.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The ordinances embraced in the following Chapters and sections shall constitute and\n               be designated the \"Code of the City of Orlando, Florida,\" and may be so cited.\n               </p>\n            <p class=\"historynote0\">\n               (Code 1948, § 1.01; Ord. of 10-11-1982, Doc. #17335)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TITIICICO_CH1GEPR","Heading":"Chapter 1 - GENERAL PROVISIONS","NodeDepth":1,"HasChildren":true,"ParentId":"13349","DocOrderId":417,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TITIICICO_CH1GEPR_S1.02RUCO","Heading":"Sec. 1.02. - Rules of Construction.","NodeDepth":2,"HasChildren":false,"ParentId":"TITIICICO_CH1GEPR","DocOrderId":419,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}