{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":222,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PTIICOOR_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-3. - Supplementation of Code; ordinances of limited interest or transitory nature; setting fees.</div>","ShouldShowMiniToc":false,"Id":"PTIICOOR_CH1GEPR_S1-3SUCOORLIINTRNASEFE","Title":"Sec. 1-3. - Supplementation of Code; ordinances of limited interest or transitory nature; setting fees.","Content":"<div class=\"chunk-content\">\n            <p class=\"incr0\">\n               (a)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               By contract or by municipal personnel, supplements to this Code shall be prepared\n               and printed whenever authorized or directed by the city. A supplement to the Code\n               shall include all substantive permanent and general parts of ordinances passed by\n               the city council during the period covered by the supplement and all changes made\n               thereby in the Code, and such supplement may also include amendments to the Charter.\n               The pages of a supplement shall be so numbered that they will fit properly into the\n               Code and will, where necessary, replace pages which have become obsolete or partially\n               obsolete, and the new pages shall be so prepared that, when they have been inserted,\n               the Code will be current through the date of the adoption of the latest ordinance\n               included in the supplement.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (b)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               In preparing a supplement to this Code, all portions of the Code which have been repealed\n               shall be excluded from the Code by the omission thereof from reprinted pages.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (c)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               When preparing a supplement to this Code, the codifier (meaning the person authorized\n               to prepare the supplement) may make formal, nonsubstantive changes in ordinances and\n               parts of ordinances included in the supplement, insofar as it is necessary to do so\n               to embody them into a unified code. For example, the codifier may:\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (1)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Organize the ordinance material into appropriate subdivisions;\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (2)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Provide appropriate catchlines, headings and titles for sections and other subdivisions\n               of the Code printed in the supplement, and make changes in such catchlines, headings\n               and titles;\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (3)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Assign appropriate numbers to sections and other subdivisions to be inserted in the\n               Code and, where necessary to accommodate new material, change existing section or\n               other subdivision numbers;\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (4)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Change the words \"this ordinance\" or words of the same meaning to \"this chapter,\"\n               \"this article,\" \"this division,\" etc., as the case may be, or to \"sections _______\n               to _______\" (inserting section numbers to indicate the sections of the Code which\n               embody the substantive sections of the ordinance incorporated into the Code); and\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (5)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Make other nonsubstantive changes necessary to preserve the original meaning of ordinance\n               sections inserted into the Code; but, in no case, shall the codifier make any change\n               in the meaning or effect of ordinance material included in the supplement or already\n               embodied in the Code.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (d)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               The following ordinances, including ordinances renewing, extending, or amending such\n               ordinances, are not to be codified:\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (1)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Ordinances that set dates, times, or locations of regular city council meetings, including\n               work session meetings, when all of such meetings will occur within 13 months of the\n               adoption of the ordinance.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (2)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Ordinances that will have no effect after 13 months from the adoption of the ordinance.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (3)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Ordinances that promise or guarantee the payment of money by or for the city, or authorize\n               the issuance of bonds of the city or evidence of the city's indebtedness.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (4)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Ordinances that authorize a contract or the assumption of an obligation by the city.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (5)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Ordinances that make an appropriation.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (6)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Ordinances that provide for local improvements or that impose assessments therefor.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (7)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Ordinances that accept a plat or subdivision.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (8)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Ordinances that change the boundaries of the city.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (9)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Ordinances that set the rate for ad valorem property taxes.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (10)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Capital project ordinances and grant project ordinances.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (11)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Ordinances that name streets.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (12)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Budget ordinances.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (e)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               The following ordinances, including ordinances renewing, extending, or amending such\n               ordinances, are to be codified as technical ordinances and shall be published separately\n               from this Code:\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (1)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Franchises granted pursuant to section 67 et seq. of the Charter or pursuant to G.S.\n               160A-76.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (2)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Ordinances that set tax rates, except for ad valorem property taxes and privilege\n               license taxes.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (3)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               The emergency operations plan adopted pursuant to section 22-21.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (4)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               The Unified Development Ordinance.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (f)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               The following ordinances, including ordinances renewing, extending, or amending such\n               ordinances, shall be codified by entry upon official lists or schedules:\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (1)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Ordinances that set rates for utility or other public enterprise services.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (2)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Ordinances that set fees to be charged by the city.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (3)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Ordinances that set fares, rates, and charges that may be charged by passenger vehicles\n               for hire.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (4)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Except to the extent the city council otherwise provides, and except as provided in\n               other subsections of this section, ordinances that regulate or set any rates, deposits,\n               fees, fares, and charges imposed by any person, including the city, and including\n               credits granted by the city; provided, however, that ordinances setting a charge that\n               is denominated as a \"civil penalty\" will be in this Code instead of on an official\n               list or schedule.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (g)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               Unless provided otherwise, fees referred to in ordinances will be set by the city\n               council from time to time.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (h)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               The technical ordinances referred to in subsection (e)(2) and the official lists and\n               schedules referred to in subsection (f) are referred to in this subsection as the\n               \"fee schedule.\" From time to time the city manager shall, in consultation with the\n               city attorney, prepare and revise the fee schedule as appropriate to accurately reflect\n               decisions by the city council regarding fees, fares, rates, charges, etc. set by such\n               technical ordinances and official lists and schedules (referred to collectively as\n               \"fee schedule charges\"). The intent is that the fee schedule is to be kept current\n               to show fee schedule charges in effect when the schedule is revised. In general, repealed\n               fee schedule charges shall be removed from the schedule, but in the city manager's\n               discretion historical information may be provided in the fee schedule if it is labeled\n               or arranged so that readers are not likely to be confused regarding which schedule\n               charges are in effect. Without limiting the foregoing authority, the city manager\n               may make non-substantive changes to decisions by the city council, insofar as it is\n               necessary to do so to embody them in the fee schedule. For example, the city manager\n               may in consultation with the city attorney:\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (1)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Reorganize the material into appropriate subdivisions, including parts, sections,\n               and chapters, including designating which departments, divisions, offices, etc. are\n               primarily responsible for particular schedule charges.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (2)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Assign and change captions.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (3)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Assign and change numbers of subdivisions.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (4)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Write and change references to ordinances, resolutions, chapters, sections, articles,\n               divisions, etc. to communicate the meaning of the council's decisions being embodied\n               in the schedule.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (5)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Make other non-substantive changes as necessary to preserve the meaning of the council's\n               decisions being embodied in the schedule.\n               </p>\n            \t\t\n            <p class=\"historynote0\">\n               (Code 1982, § 1-3; Ord. No. 13574, Pt. 1, 4-7-2008; Ord. No. 13575, § 4, 4-7-2008;\n               Ord. No. 14415, § 1, 4-1-2013; Ord. No. 14416, § 1, 4-1-2013)\n               </p>\n            <p class=\"refstatelaw0\" block_type=\"hang\"><b>State Law reference— </b>\n               Code of Ordinances, G.S. 160A-77.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PTIICOOR_CH1GEPR_S1-2DERUCO","Heading":"Sec. 1-2. - Definitions and rules of construction.","NodeDepth":2,"HasChildren":false,"ParentId":"PTIICOOR_CH1GEPR","DocOrderId":221,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PTIICOOR_CH1GEPR_S1-4CAHINORE","Heading":"Sec. 1-4. - Captions; history notes and references.","NodeDepth":2,"HasChildren":false,"ParentId":"PTIICOOR_CH1GEPR","DocOrderId":223,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}