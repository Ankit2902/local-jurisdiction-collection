{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":220,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PTIICOOR_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1. - How Code designated and cited.</div>","ShouldShowMiniToc":false,"Id":"PTIICOOR_CH1GEPR_S1-1HOCODECI","Title":"Sec. 1-1. - How Code designated and cited.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The provisions of this and the following chapters shall constitute and be designated\n               the \"Code of Ordinances, City of Durham, North Carolina,\" which may also be cited\n               as the \"Durham City Code,\" \"City Code,\" \"Code of the City of Durham,\" or phrase of\n               like nature.\n               </p>\n            <p class=\"historynote0\">\n               (Code 1982, § 1-1)\n               </p>\n            <p class=\"refstatelaw0\" block_type=\"hang\"><b>State Law reference— </b>\n               Codification required, G.S. 160A-77; admission into evidence of Code, G.S. 160A-79.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PTIICOOR_CH1GEPR","Heading":"Chapter 1 - GENERAL PROVISIONS","NodeDepth":1,"HasChildren":true,"ParentId":"19967","DocOrderId":219,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PTIICOOR_CH1GEPR_S1-2DERUCO","Heading":"Sec. 1-2. - Definitions and rules of construction.","NodeDepth":2,"HasChildren":false,"ParentId":"PTIICOOR_CH1GEPR","DocOrderId":221,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}