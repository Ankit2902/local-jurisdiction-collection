{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":7,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PTICH_CH1INBO","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">§ 1.01. - Incorporation.</div>","ShouldShowMiniToc":false,"Id":"PTICH_CH1INBO_S1.01IN","Title":"§ 1.01. - Incorporation.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The inhabitants of the territory comprised within the limits of the city of Richmond,\n               as the same now are or may hereafter be established by law, shall continue to be a\n               body politic and corporate under the name of the city of Richmond and as such shall\n               have perpetual succession, may sue and be sued, contract and be contracted with and\n               may have a corporate seal which it may alter, renew or amend at its pleasure.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PTICH_CH1INBO","Heading":"Chapter 1. - Incorporation and Boundaries","NodeDepth":2,"HasChildren":true,"ParentId":"PTICH","DocOrderId":6,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PTICH_CH1INBO_S1.02BO","Heading":"§ 1.02. - Boundaries.","NodeDepth":3,"HasChildren":false,"ParentId":"PTICH_CH1INBO","DocOrderId":8,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}