{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":436,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COOR_CH1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1. - Adoption of Code.<sup>[3]</sup></div>","ShouldShowMiniToc":false,"Id":"COOR_CH1GEPR_ARTIADCO_S1-1ADCO","Title":"Sec. 1-1. - Adoption of Code.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\" style=\"font-size:14px;\">\n               The Code of Ordinances, consisting of §<a href=\"\" data-chunk-id=\"COOR_CH1GEPR_ARTIADCO_S1-1ADCO\" class=\"section-link\" data-product-id=\"13324\">§ 1-1</a> through 2-54 inclusive\n<!-- fnLinkEnd = fn_149 -->\n<sup>[4]</sup>\n               \n               , is hereby adopted and enacted as the \"Code of Ordinances, City of Stamford, Connecticut,\"\n               and shall be treated and considered as a new and original comprehensive ordinance\n               which shall supersede all other general and permanent ordinances passed by the Board\n               of Representatives on or before May 1, 1985, to the extent provided in <a href=\"\" data-chunk-id=\"COOR_CH1GEPR_ARTIADCO_S1-2REOR\" class=\"section-link\" data-product-id=\"13324\">§ 1-2</a> hereof.\n               \n               </p><div class=\"footnote-content\"><div style=\"font-weight:bold;\">Footnotes: </div> --- (<b>3</b>) ---\n            \n            <p class=\"refmanualFN\">\n               Amended 9-8-86.\n               </p>\n            <br> --- (<b>4</b>) ---\n            \n            <p class=\"refmanualFN\">\n               Editor's note—The use of §§ 1-1 through 2-54 refers to the original manuscript numbering prior to publication. This\n               reference should now be to Chapters 1 to 250.\n               </p>\n            <br></div></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"COOR_CH1GEPR_ARTIADCO","Heading":"ARTICLE I. - ADOPTION OF 