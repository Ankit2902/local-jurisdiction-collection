{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":437,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COOR_CH1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-2. - Repeal of ordinances.</div>","ShouldShowMiniToc":false,"Id":"COOR_CH1GEPR_ARTIADCO_S1-2REOR","Title":"Sec. 1-2. - Repeal of ordinances.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               All provisions of such Code shall be in full force and effect from and after December\n               2, 1985, and all ordinances of a general and permanent nature of the City of Stamford,\n               Connecticut, enacted on final passage on or before May 1, 1985, and not included in\n               such Code or recognized and continued in force by reference therein are hereby repealed\n               from and after December 2, 1985, except as hereinafter provided.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"COOR_CH1GEPR_ARTIADCO_S1-1ADCO","Heading":"Sec. 1-1. - Adoption of Code.","NodeDepth":3,"HasChildren":false,"ParentId":"COOR_CH1GEPR_ARTIADCO","DocOrderId":436,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"COOR_CH1GEPR_ARTIADCO_S1-3ORSARE","Heading":"Sec. 1-3. - Ordinances saved from repeal.","NodeDepth":3,"HasChildren":false,"ParentId":"COOR_CH1GEPR_ARTIADCO","DocOrderId":438,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}