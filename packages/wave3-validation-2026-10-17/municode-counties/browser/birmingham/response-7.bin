{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":7,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PT1THCOGEOR_TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1-1. - How Code designated and cited.</div>","ShouldShowMiniToc":false,"Id":"PT1THCOGEOR_TIT1GEPR_CH1USCOPE_S1-1-1HOCODECI","Title":"Sec. 1-1-1. - How Code designated and cited.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The ordinances embraced in this and the following titles and sections shall together\n               constitute and be designated \"The General Code of the City of Birmingham, Alabama,\"\n               and may be so cited. This Code may also be cited as the \"General City Code\" or, for\n               the purpose of prosecutions in the municipal court, as \"GCC.\"\n               \n            </p>\n            <p class=\"historynote0\">\n               (Code 1980, § 1-1-1)\n               \n            </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PT1THCOGEOR_TIT1GEPR_CH1USCOPE","Heading":"CHAPTER 1. - USE, CONSTRUCTION AND PENALTIES","NodeDepth":2,"HasChildren":true,"ParentId":"PT1THCOGEOR_TIT1GEPR","DocOrderId":6,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PT1THCOGEOR_TIT1GEPR_CH1USCOPE_S1-1-2DERUCO","Heading":"Sec. 1-1-2. - Definitions and rules of construction.","NodeDepth":3,"HasChildren":false,"ParentId":"PT1THCOGEOR_TIT1GEPR_CH1USCOPE","DocOrderId":8,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}