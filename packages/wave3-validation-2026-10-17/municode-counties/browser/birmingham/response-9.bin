{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":9,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PT1THCOGEOR_TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1-3. - Applicability of Code.</div>","ShouldShowMiniToc":false,"Id":"PT1THCOGEOR_TIT1GEPR_CH1USCOPE_S1-1-3APCO","Title":"Sec. 1-1-3. - Applicability of Code.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               Every section contained in this Code, whether expressed to apply \"within the city\"\n               or \"in the city,\" or not so expressed, shall apply and have full force and effect\n               within the corporate limits of the city and within the police jurisdiction thereof\n               and within the territorial limits of any property or right-of-way owned by the city,\n               wheresoever situated; provided, that any such section shall not apply within that\n               police jurisdiction if the violation thereof is expressly exempted from the application\n               of<a href=\"\" data-chunk-id=\"PT1THCOGEOR_TIT1GEPR_CH1USCOPE_S1-1-6GEPE\" class=\"section-link\" data-product-id=\"10444\"> section 1-1-6</a>, or if the same cannot legally be made to apply in that police jurisdiction, or if\n               the same cannot physically apply in that police jurisdiction, or if the same, otherwise\n               than by use of such terms as \"in the city\" or \"within the city,\" contains clear inherent\n               evidence of intent that it shall not apply in such police jurisdiction.\n               \n            </p>\n            <p class=\"historynote0\">\n               (Code 1964, § 1-3; Code 1980, § 1-1-3)\n               \n            </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PT1THCOGEOR_TIT1GEPR_CH1USCOPE_S1-1-2DERUCO","Heading":"Sec. 1-1-2. - Definitions and rules of construction.","NodeDepth":3,"HasChildren":false,"ParentId":"PT1THCOGEOR_TIT1GEPR_CH1USCOPE","DocOrderId":8,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PT1THCOGEOR_TIT1GEPR_CH1USCOPE_S1-1-4EFREORRE","Heading":"Sec. 1-1-4. - Effect of repeal of ordinances; revival.","NodeDepth":3,"HasChildren":false,"ParentId":"PT1THCOGEOR_TIT1GEPR_CH1USCOPE","DocOrderId":10,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}