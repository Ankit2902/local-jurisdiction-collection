{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":8,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1MUPAOR_CH1GOBO","NodeDepth":4,"TitleHtml":"<div class=\"chunk-title\">Sec. 1:2.1 - Introduction of ordinances and resolutions required.</div>","ShouldShowMiniToc":false,"Id":"TIT1MUPAOR_CH1GOBO_PTIRUPR_S1_2.1INORRERE","Title":"Sec. 1:2.1 - Introduction of ordinances and resolutions required.","Content":"<div class=\"chunk-content\">\n            <p class=\"incr0\">\n               (a)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               Except for the items listed in subsection (b), no matter shall be added for discussion\n               and no ordinance or resolution may be adopted at the same meeting at which it was\n               introduced, but must be read by title a first time and a time, not less than six (6)\n               days after such introduction, fixed, at which the metropolitan council or a committee\n               thereof shall hold a public hearing on the matter.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (b)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               Exceptions.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (i)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               In cases of emergency declared by two-thirds (⅔) vote of the metropolitan council,\n               an ordinance or resolution may be adopted at the same meeting at which it was introduced.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               (ii)\n               </p>\n            \t\t\n            <p class=\"content2\">\n               Any item that is a change order, final acceptance, and acceptances of low bid for\n               a public works construction or procurement may be adopted at the same meeting at which\n               it was introduced.\n               </p>\n            \t\t\n            <p class=\"historynote0\">\n               (Ord. No. 16442, § 1, 3-8-17; Ord. No. 16827, § 1, 5-23-18)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1MUPAOR_CH1GOBO_PTIRUPR_S1_2ORBUREMEAG","Heading":"Sec. 1:2. - Order of business at regular meetings; agenda.","NodeDepth":4,"HasChildren":false,"ParentId":"TIT1MUPAOR_CH1GOBO_PTIRUPR","DocOrderId":7,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1MUPAOR_CH1GOBO_PTIRUPR_S1_3SPMENO","Heading":"Sec. 1:3. - Special meetings; notices.","NodeDepth":4,"HasChildren":false,"ParentId":"TIT1MUPAOR_CH1GOBO_PTIRUPR","DocOrderId":9,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}