{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":6,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1MUPAOR_CH1GOBO","NodeDepth":4,"TitleHtml":"<div class=\"chunk-title\">Sec. 1:1. - Regular meetings; budget meetings; organizational meetings; zoning meetings.</div>","ShouldShowMiniToc":false,"Id":"TIT1MUPAOR_CH1GOBO_PTIRUPR_S1_1REMEBUMEORMEZOME","Title":"Sec. 1:1. - Regular meetings; budget meetings; organizational meetings; zoning meetings.","Content":"<div class=\"chunk-content\">\n            <p class=\"incr0\">\n               (a)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               Until otherwise provided, regular meetings of the council shall be held on the second\n               and fourth Wednesdays of each month, in room 348 of the governmental building, in\n               the City of Baton Rouge, Louisiana. Except as hereinafter provided, the meetings of\n               the council shall commence at 4:00 p.m. Presentations and special recognitions shall\n               begin at <a href=\"\" data-chunk-id=\"TIT3PARE_CH2FEREFA_S3_30FEBEESREPACOCI\" class=\"section-link\" data-product-id=\"10107\">3:30</a> p.m. for regularly scheduled full council and council zoning meetings. Should the\n               date fixed for any regular meeting fall on a holiday, the regular meeting scheduled\n               therefor shall be held at the hour and place mentioned above on the next succeeding\n               business day. If required for the purpose of adopting the budget, as provided in the\n               plan of government, a meeting may be held for this purpose on the fourteenth day of\n               December each year, which meeting shall also be fixed and designated in the event\n               of its being so held as a regular meeting of the council; provided, however, that\n               where a regular meeting as hereinabove fixed falls on the fourteenth day of December,\n               it shall not be necessary to have an additional meeting for budget purposes only.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (b)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               The organizational meeting of the council required by Section 2.07 of the Plan of\n               Government to be held on the second day of January, 1985, and the second day of January\n               every fourth year thereafter, shall be held at the place designated by the council\n               as its place of meeting for that specific occasion. If such meeting is held at the\n               place hereinabove set forth as the regular meeting place of the council, then no further\n               designation shall be required or necessary.\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (c)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               Notwithstanding any other subsections of this section to the contrary, there shall\n               be a regularly scheduled zoning meeting of the council for the purpose of conducting\n               any and all public hearings dealing with zoning. These meetings shall be referred\n               to as the regular zoning meetings. The regular zoning meetings shall be held on the\n               third Wednesday of each month, commencing at 4:00 p.m. The regular zoning meetings\n               shall be held at the same place as the regular meetings referred to in subsection\n               (a) of this section. The rules prescribed in <a href=\"\" data-chunk-id=\"TIT1MUPAOR_CH1GOBO_PTIRUPR_S1_2ORBUREMEAG\" class=\"section-link\" data-product-id=\"10107\">sections 1:2</a>, <a href=\"\" data-chunk-id=\"TIT1MUPAOR_CH1GOBO_PTIRUPR_S1_5QU\" class=\"section-link\" data-product-id=\"10107\">1:5</a>, <a href=\"\" data-chunk-id=\"TIT1MUPAOR_CH1GOBO_PTIRUPR_S1_6JOPRPU\" class=\"section-link\" data-product-id=\"10107\">1:6</a>, <a href=\"\" data-chunk-id=\"TIT1MUPAOR_CH1GOBO_PTIRUPR_S1_7COMEPUHE\" class=\"section-link\" data-product-id=\"10107\">1:7</a>, <a href=\"\" data-chunk-id=\"TIT1MUPAOR_CH1GOBO_PTIRUPR_S1_8RUPOOR\" class=\"section-link\" data-product-id=\"10107\">1:8</a>, <a href=\"\" data-chunk-id=\"TIT1MUPAOR_CH1GOBO_PTIRUPR_S1_9VO\" class=\"section-link\" data-product-id=\"10107\">1:9</a> and <a href=\"\" data-chunk-id=\"TIT1MUPAOR_CH1GOBO_PTIRUPR_S1_10SUWIDO\" class=\"section-link\" data-product-id=\"10107\">1:10</a> shall apply to the regular zoning meetings as applicable.\n               </p>\n            \t\t\n            <p class=\"historynote0\">\n               (City Code 1951, Title 1, § 1; Parish Code 1962, Title 1, § 1; Ord. No. 8383, § 1,\n               4-8-87; Ord. No. 8895, § 1, 4-26-89; Ord. No. 15598, § 1, 10-23-13)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1MUPAOR_CH1GOBO_PTIRUPR","Heading":"PART I. - RULES OF PROCEDURE","NodeDepth":3,"HasChildren":true,"ParentId":"TIT1MUPAOR_CH1GOBO","DocOrderId":5,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1MUPAOR_CH1GOBO_PTIRUPR_S1_2ORBUREMEAG","Heading":"Sec. 1:2. - Order of business at regular meetings; agenda.","NodeDepth":4,"HasChildren":false,"ParentId":"TIT1MUPAOR_CH1GOBO_PTIRUPR","DocOrderId":7,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}