{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":44,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COOR_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-3. - Provisions considered as continuation of existing ordinances.</div>","ShouldShowMiniToc":false,"Id":"COOR_CH1GEPR_S1-3PRCOCOEXOR","Title":"Sec. 1-3. - Provisions considered as continuation of existing ordinances.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The provisions appearing in this Code, so far as they are the same as those of the\n               1979 Code and all ordinances adopted subsequent to the 1979 Code and included herein,\n               shall be considered as continuations thereof and not as new enactments.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"COOR_CH1GEPR_S1-2DERUCO","Heading":"Sec. 1-2. - Definitions and rules of construction.","NodeDepth":2,"HasChildren":false,"ParentId":"COOR_CH1GEPR","DocOrderId":43,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"COOR_CH1GEPR_S1-4JUCOOR","Heading":"Sec. 1-4. - Jurisdiction of Code and ordinances.","NodeDepth":2,"HasChildren":false,"ParentId":"COOR_CH1GEPR","DocOrderId":45,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}