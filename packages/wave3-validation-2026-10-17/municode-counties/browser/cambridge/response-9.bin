{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":7,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">1.04.010 - Designation and citation of code.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1.04GEPR_1.04.010DECICO","Title":"1.04.010 - Designation and citation of code.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The ordinances of the City of Cambridge, Massachusetts, embraced in this and the following\n               chapters shall constitute and be designated and cited as \"The Code of the City of\n               Cambridge, 1987.\" The code may also be cited as \"Cambridge City Code\" or, in the provisions\n               which follow as \"this code.\"\n               </p>\n            <p class=\"historynote0\">\n               (Prior code § 1-1)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1.04GEPR","Heading":"Chapter 1.04 - GENERAL PROVISIONS","NodeDepth":2,"HasChildren":true,"ParentId":"TIT1GEPR","DocOrderId":6,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1.04GEPR_1.04.020PRCOEXOR","Heading":"1.04.020 - Provisions as continuation of existing ordinances.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.04GEPR","DocOrderId":8,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}