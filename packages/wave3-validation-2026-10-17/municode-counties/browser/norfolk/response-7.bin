{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":209,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COCI_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1. - How Code designated and cited.</div>","ShouldShowMiniToc":false,"Id":"COCI_CH1GEPR_S1-1HOCODECI","Title":"Sec. 1-1. - How Code designated and cited.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The ordinances embraced in this and the following chapters and sections shall constitute\n               and be designated the \"Code of the City of Norfolk, Virginia, 1979,\" and may be so\n               cited. Said Code may also be cited as the \"Norfolk City Code, 1979\".\n               \n               <p class=\"refcharter0\" block_type=\"hang\"><b>Charter reference— </b>\n                  Codification of ordinances, <a href=\"\" data-chunk-id=\"CH_THCO_S16REORRE\" class=\"section-link\" data-product-id=\"10121\">§ 16</a> (note).\n                  </p>\n               \n               <p class=\"refstatelaw0\" block_type=\"hang\"><b>State Law reference— </b>\n                  Authority of city to codify and recodify its ordinances, Code of Virginia, § 15.1-37.3.\n                  </p>\n               </div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"COCI_CH1GEPR","Heading":"Chapter 1 - GENERAL PROVISIONS","NodeDepth":1,"HasChildren":true,"ParentId":"10121","DocOrderId":208,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"COCI_CH1GEPR_S1-2RUCODE","Heading":"Sec. 1-2. - Rules of construction and definitions.","NodeDepth":2,"HasChildren":false,"ParentId":"COCI_CH1GEPR","DocOrderId":210,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}