{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":157,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR_CH1.01COAD","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">1.01.010 - Reenactment.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1.01COAD_1.01.010RE","Title":"1.01.010 - Reenactment.","Content":"<div class=\"chunk-content\">\n            <p class=\"runin\">\n               There is hereby reenacted the Los Angeles County Code, together with those secondary\n               codes adopted by reference, except those portions of the secondary codes that are\n               deleted or modified by the adopting ordinances now in effect.\n               </p>\n            <p class=\"historynote0\">\n               (Ord. 87-0052 § 1, 1987: Ord. 81-0001 § 1, 1981.)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1.01COAD","Heading":"Chapter 1.01 -         CODE ADOPTION        ","NodeDepth":2,"HasChildren":true,"ParentId":"TIT1GEPR","DocOrderId":156,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1.01COAD_1.01.020TIITEF","Heading":"1.01.020 - Title—Citation—Reference.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01COAD","DocOrderId":158,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}