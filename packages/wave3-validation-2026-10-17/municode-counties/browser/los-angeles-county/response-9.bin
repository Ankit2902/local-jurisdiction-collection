{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":160,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR_CH1.01COAD","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">1.01.040 - Ordinances passed prior to code adoption.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1.01COAD_1.01.040ORPAPRCOAD","Title":"1.01.040 - Ordinances passed prior to code adoption.","Content":"<div class=\"chunk-content\">\n            <p class=\"runin\">\n               The last ordinance included in this code is Ordinance No. 86-0202Z, adopted November\n               25, 1986. The following ordinances, adopted subsequent to Ordinance No. 86-0202Z,\n               remain in full force and effect, and if inconsistent with any section of this code\n               shall control:\n               </p>\n            <p class=\"p0\">\n               Ordinances: 86-0203 through 87-0051Z.\n               </p>\n            <p class=\"historynote0\">\n               (Ord. 87-0052 § 4, 1987: Ord. 81-0001 § 4, 1981.)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1.01COAD_1.01.030COODAU","Heading":"1.01.030 - Contents—Codification authority.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01COAD","DocOrderId":159,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1.01COAD_1.01.050EFCOAD","Heading":"1.01.050 - Effect of code adoption.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01COAD","DocOrderId":161,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}