{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":158,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR_CH1.01COAD","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">1.01.020 - Title—Citation—Reference.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1.01COAD_1.01.020TIITEF","Title":"1.01.020 - Title—Citation—Reference.","Content":"<div class=\"chunk-content\">\n            <p class=\"runin\">\n               This code shall be known as the \"Los Angeles County Code,\" and it shall be sufficient\n               to refer to said code as \"the Los Angeles County Code\" in any prosecution for the\n               violation of any provision thereof, or in any other proceeding. It shall be sufficient\n               to designate any ordinance adding to, amending, correcting or repealing all or any\n               part of the code as an addition, amendment to, correction or repeal of the \"Los Angeles\n               County Code.\"\n               </p>\n            <p class=\"historynote0\">\n               (Ord. 87-0052 § 2, 1987: Ord. 81-0001 § 2, 1981.)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1.01COAD_1.01.010RE","Heading":"1.01.010 - Reenactment.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01COAD","DocOrderId":157,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1.01COAD_1.01.030COODAU","Heading":"1.01.030 - Contents—Codification authority.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01COAD","DocOrderId":159,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}