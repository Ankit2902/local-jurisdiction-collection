{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":8,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">1.01.030 - File.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1.01CO_1.01.030FI","Title":"1.01.030 - File.","Content":"<div class=\"chunk-content\">\n            <p class=\"runin\">\n               At least three official copies of the Clark County Code shall at all times be on file\n               and available for inspection by the general public at the office of the Clark County\n               clerk.\n               </p>\n            <p class=\"historynote0\">\n               (Ord. 268 § 3, 1967)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1.01CO_1.01.020AMSU","Heading":"1.01.020 - Amendments and supplements.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01CO","DocOrderId":7,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1.01CO_1.01.040GEPE","Heading":"1.01.040 - General penalty.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01CO","DocOrderId":9,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}