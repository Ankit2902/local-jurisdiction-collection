{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":6,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">1.01.010 - Adoption.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1.01CO_1.01.010AD","Title":"1.01.010 - Adoption.","Content":"<div class=\"chunk-content\">\n            <p class=\"runin\">\n               From and after June 20, 1967, the Clark County Code, prepared by Book Publishing Company,\n               codifiers, and approved and accepted, shall be the official code of all the ordinances\n               of a general and permanent character of the county of Clark, state of Nevada.\n               </p>\n            <p class=\"historynote0\">\n               (Ord. 268 § 1, 1967)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1.01CO","Heading":"Chapter 1.01 - CODE","NodeDepth":2,"HasChildren":true,"ParentId":"TIT1GEPR","DocOrderId":5,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1.01CO_1.01.020AMSU","Heading":"1.01.020 - Amendments and supplements.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01CO","DocOrderId":7,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}