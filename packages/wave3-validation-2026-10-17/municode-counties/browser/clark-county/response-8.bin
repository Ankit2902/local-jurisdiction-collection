{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":7,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">1.01.020 - Amendments and supplements.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1.01CO_1.01.020AMSU","Title":"1.01.020 - Amendments and supplements.","Content":"<div class=\"chunk-content\">\n            <p class=\"runin\">\n               There is adopted, as a method of perpetual codification, the loose-leaf type of binding\n               together with the continuous supplemental service whereby each newly adopted ordinance\n               of a general nature amending, altering, adding to, or deleting provisions of the Clark\n               County Code is identified by the proper title or catchline and, following preparation\n               by Book Publishing Company, is inserted in the proper place in each of the official\n               copies. Supplements to the Clark County Code of newly adopted ordinances amending,\n               altering, adding to, or deleting provisions thereof shall be furnished at least once\n               a year.\n               </p>\n            <p class=\"historynote0\">\n               (Ord. 268 § 2, 1967)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1.01CO_1.01.010AD","Heading":"1.01.010 - Adoption.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01CO","DocOrderId":6,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1.01CO_1.01.030FI","Heading":"1.01.030 - File.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01CO","DocOrderId":8,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}