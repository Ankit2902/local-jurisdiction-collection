{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":29,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIDM","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 1.2. - Amendment Procedure.</div>","ShouldShowMiniToc":false,"Id":"TIDM_CH1ADCOIN_S1.2AMPR","Title":"Sec. 1.2. - Amendment Procedure.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               This Code shall be amended by ordinance. The title of each amendatory ordinance, adapted\n               to the particular circumstances and purposes of the amendment, shall be substantially\n               as follows:\n               \n               <p class=\"incr1\">\n                  (1)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  To amend any Section:\n                  </p>\n               \t\t\n               <p class=\"b2\">\n                  AN ORDINANCE TO AMEND SECTION _____ (or SECTIONS _____\n                  \n                  AND _____) OF CHAPTER _____\n                  \n                  OF TITLE _____ OF THE CODE OF THE CITY OF GRAND RAPIDS.\n                  </p>\n               \n               <p class=\"incr1\">\n                  (2)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  To insert a new Section, Chapter or Title:\n                  </p>\n               \t\t\n               <p class=\"b2\">\n                  AN ORDINANCE TO AMEND THE CODE OF THE CITY OF GRAND RAPIDS BY ADDING A NEW SECTION\n                  _____ (NEW SECTIONS, A NEW CHAPTER, OR A NEW TITLE, AS THE CASE MAY BE) WHICH NEW\n                  SECTION (SECTIONS, CHAPTER OR TITLE) SHALL BE DESIGNATED AS SECTION _____ (SECTIONS\n                  _____ AND _____) OF CHAPTER _____ OF TITLE _____ (or proper designation if a Chapter\n                  or Title is added) OF SAID CODE.\n                  </p>\n               \n               <p class=\"incr1\">\n                  (3)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  To repeal a Section, Chapter or Title:\n                  </p>\n               \t\t\n               <p class=\"b2\">\n                  AN ORDINANCE TO REPEAL SECTION _____ (SECTIONS _____ AND _____), CHAPTER _____, TITLE\n                  _____, (as the case may be) OF THE CODE OF THE CITY OF GRAND RAPIDS.\n                  </p>\n               </div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIDM_CH1ADCOIN_S1.1PUDICO","Heading":"Sec. 1.1. - Publication and Distribution of Code.","NodeDepth":3,"HasChildren":false,"ParentId":"TIDM_CH1ADCOIN","DocOrderId":28,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIDM_CH1ADCOIN_S1.3PUDIAM","Heading":"Sec. 1.3. - Publication and Distribution of Amendments.","NodeDepth":3,"HasChildren":false,"ParentId":"TIDM_CH1ADCOIN","DocOrderId":30,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}