{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":28,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIDM","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 1.1. - Publication and Distribution of Code.</div>","ShouldShowMiniToc":false,"Id":"TIDM_CH1ADCOIN_S1.1PUDICO","Title":"Sec. 1.1. - Publication and Distribution of Code.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               Publication of this codification is hereby ordered. This Code shall be made available\n               to the public for examination at no cost to the office of the City Clerk. The Code\n               shall be available for purchase from the City Clerk at a price to be determined by\n               the Clerk. Each City officer noted below shall receive a City Code and be responsible\n               for its maintenance and up-dating:\n               \n               <p class=\"b1\">\n                  Mayor\n                  </p>\n               \n               <p class=\"b1\">\n                  Each City Commissioner\n                  </p>\n               \n               <p class=\"b1\">\n                  City Manager\n                  </p>\n               \n               <p class=\"b1\">\n                  Each Deputy and Assistant City Manager\n                  </p>\n               \n               <p class=\"b1\">\n                  Each Service Group Director\n                  </p>\n               \n               <p class=\"b1\">\n                  City Clerk\n                  </p>\n               \n               <p class=\"b1\">\n                  City Attorney\n                  </p>\n               \n               <p class=\"b1\">\n                  City Treasurer\n                  </p>\n               \n               <p class=\"b1\">\n                  Assessor\n                  </p>\n               \n               <p class=\"b1\">\n                  City Comptroller\n                  </p>\n               \n            <p class=\"p0\">\n               Additional copies shall be provided at a cost to be determined by the City Clerk to\n               such other City officers and employees as are necessary for the effective and efficient\n               operation of the City. Any officer or employee to whom a City Code is issued shall\n               be responsible for its maintenance and upkeep.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIDM_CH1ADCOIN","Heading":"Chapter 1 - ADOPTION, CONTENTS AND INTERPRETATION","NodeDepth":2,"HasChildren":true,"ParentId":"TIDM","DocOrderId":27,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIDM_CH1ADCOIN_S1.2AMPR","Heading":"Sec. 1.2. - Amendment Procedure.","NodeDepth":3,"HasChildren":false,"ParentId":"TIDM_CH1ADCOIN","DocOrderId":29,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}