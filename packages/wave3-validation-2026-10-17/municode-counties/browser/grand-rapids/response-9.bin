{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":30,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIDM","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 1.3. - Publication and Distribution of Amendments.</div>","ShouldShowMiniToc":false,"Id":"TIDM_CH1ADCOIN_S1.3PUDIAM","Title":"Sec. 1.3. - Publication and Distribution of Amendments.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               Amendments to the Code shall be published as required by the Charter of the City of\n               Grand Rapids and not less than fifty (50) copies of each amendment shall be published\n               in looseleaf form suitable for insertion in the looseleaf copies of the Code. The\n               City Clerk shall distribute such copies to the officers of the City having copies\n               of the Code assigned to them. Each officer assigned a copy of the Code shall be responsible\n               for maintaining the same and for the proper insertion of amendatory pages as received.\n               Each copy of said Code shall remain the property of the City and shall be turned over\n               by each officer having custody thereof upon expiration of his or her term of office\n               to his or her successor or to the City Clerk, in case he or she shall have no successor.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIDM_CH1ADCOIN_S1.2AMPR","Heading":"Sec. 1.2. - Amendment Procedure.","NodeDepth":3,"HasChildren":false,"ParentId":"TIDM_CH1ADCOIN","DocOrderId":29,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIDM_CH1ADCOIN_S1.4COCO","Heading":"Sec. 1.4. - Contents of Code.","NodeDepth":3,"HasChildren":false,"ParentId":"TIDM_CH1ADCOIN","DocOrderId":31,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}