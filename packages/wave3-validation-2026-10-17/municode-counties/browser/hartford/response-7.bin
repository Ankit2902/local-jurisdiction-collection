{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":147,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PTIIMUCO_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1. - How Code designated and cited.</div>","ShouldShowMiniToc":false,"Id":"PTIIMUCO_CH1GEPR_S1-1HOCODECI","Title":"Sec. 1-1. - How Code designated and cited.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The ordinances embraced in the following chapters and sections shall constitute and\n               be designated \"The Municipal Code of Hartford\" and may be so cited. The Code may also\n               be cited as \"Hartford City Code\".\n               </p>\n            <p class=\"historynote0\">\n               (Code 1977, § 1-1)\n               </p>\n            <p class=\"refcharter0\" block_type=\"hang\"><b>Charter reference— </b>\n               Codification required, Ch. III, <a href=\"\" data-chunk-id=\"PTICHHACO_LEACPEHAOTSPCHAMAPCH_INGE_S13SAEAAB\" class=\"section-link\" data-product-id=\"10895\">§ 13</a>.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PTIIMUCO_CH1GEPR","Heading":"Chapter 1 - GENERAL PROVISIONS","NodeDepth":1,"HasChildren":true,"ParentId":"10895","DocOrderId":146,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PTIIMUCO_CH1GEPR_S1-2DERUCO","Heading":"Sec. 1-2. - Definitions; rules of construction.","NodeDepth":2,"HasChildren":false,"ParentId":"PTIIMUCO_CH1GEPR","DocOrderId":148,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}