{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":149,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PTIIMUCO_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-3. - Liberal construction of Code.</div>","ShouldShowMiniToc":false,"Id":"PTIIMUCO_CH1GEPR_S1-3LICOCO","Title":"Sec. 1-3. - Liberal construction of Code.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               All general provisions, terms, phrases and expressions in the Code and ordinances\n               shall be liberally construed in order that the true intent and meaning of the council\n               may be fully carried out.\n               </p>\n            <p class=\"historynote0\">\n               (Code 1977, § 1-3; Ord. No. 20-86, 6-23-86)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PTIIMUCO_CH1GEPR_S1-2DERUCO","Heading":"Sec. 1-2. - Definitions; rules of construction.","NodeDepth":2,"HasChildren":false,"ParentId":"PTIIMUCO_CH1GEPR","DocOrderId":148,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PTIIMUCO_CH1GEPR_S1-4GEPECOVI","Heading":"Sec. 1-4. - General penalty; continuing violations.","NodeDepth":2,"HasChildren":false,"ParentId":"PTIIMUCO_CH1GEPR","DocOrderId":150,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}