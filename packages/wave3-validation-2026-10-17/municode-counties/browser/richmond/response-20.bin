{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":198,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PTIICICO_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-3. - Continuation of existing ordinances.</div>","ShouldShowMiniToc":false,"Id":"PTIICICO_CH1GEPR_S1-3COEXOR","Title":"Sec. 1-3. - Continuation of existing ordinances.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The sections appearing in this Code, so far as they are in substance the same as those\n               of the 2020 Code, and all ordinances adopted subsequent to the 2020 Code and included\n               in this Code, shall be considered as continuations of the 2020 Code and not as new\n               enactments.\n               </p>\n            <p class=\"historynote0\">\n               (Code 1993, § 1-3; Code 2004, § 1-3; Code 2015, § 1-3; Code 2020, § 1-3)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PTIICICO_CH1GEPR_S1-2DERUCO","Heading":"Sec. 1-2. - Definitions and rules of construction.","NodeDepth":2,"HasChildren":false,"ParentId":"PTIICICO_CH1GEPR","DocOrderId":197,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PTIICICO_CH1GEPR_S1-4MIORNOAFCO","Heading":"Sec. 1-4. - Miscellaneous ordinances not affected by Code.","NodeDepth":2,"HasChildren":false,"ParentId":"PTIICICO_CH1GEPR","DocOrderId":199,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}