{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":196,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PTIICICO_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-1. - Designation and citation of Code.</div>","ShouldShowMiniToc":false,"Id":"PTIICICO_CH1GEPR_S1-1DECICO","Title":"Sec. 1-1. - Designation and citation of Code.","Content":"<div class=\"chunk-content\">\n            <p class=\"incr0\">\n               (a)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               The ordinances embraced in this and the following chapters and sections shall constitute\n               and be designated the \"Code of the City of Richmond, Virginia, 2026\" and may be so\n               cited. Such ordinances may also be cited \"Richmond Code.\"\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               (b)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               All references to the 2020 Code, or prior Codes, or ordinances in or on all forms,\n               notices, and signs promulgated by the city shall be deemed to reference successor\n               provisions in this Code.\n               </p>\n            \t\t\n            <p class=\"historynote0\">\n               (Code 1993, § 1-1; Code 2004, § 1-1; Code 2015, § 1-1; Code 2020, § 1-1)\n               </p>\n            <p class=\"refcharter0\" block_type=\"hang\"><b>Charter reference— </b>\n               Codification, <a href=\"\" data-chunk-id=\"PTICH_CH4CO_S4.13REPUOR\" class=\"section-link\" data-product-id=\"16118\">§ 4.13</a>.\n               </p>\n            <p class=\"refstatelaw0\" block_type=\"hang\"><b>State Law reference— </b>\n               Authority of City to codify and recodify its ordinances, Code of Virginia, § 15.2-1433.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PTIICICO_CH1GEPR","Heading":"Chapter 1 - GENERAL PROVISIONS","NodeDepth":1,"HasChildren":true,"ParentId":"16118","DocOrderId":195,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PTIICICO_CH1GEPR_S1-2DERUCO","Heading":"Sec. 1-2. - Definitions and rules of construction.","NodeDepth":2,"HasChildren":false,"ParentId":"PTIICICO_CH1GEPR","DocOrderId":197,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}