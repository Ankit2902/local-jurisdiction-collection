{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":322,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PTIIADCO_CH205THCO","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 205.01. - County of Westchester: territory, powers, obligations, etc.</div>","ShouldShowMiniToc":false,"Id":"PTIIADCO_CH205THCO_S205.01COWETEPOOBET","Title":"Sec. 205.01. - County of Westchester: territory, powers, obligations, etc.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The County of Westchester as now existing shall continue under the same name and with\n               the same territory and boundaries, and the county shall have such powers and rights\n               and shall be subject to such obligations and liabilities as are in existence at the\n               effective date of this act and/or as may be hereafter lawfully granted or imposed.\n               </p>\n            <p class=\"historynote0\">\n               (§ 3 of the Laws of 1948, Ch. 852)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PTIIADCO_CH205THCO","Heading":"Chapter 205 - THE COUNTY","NodeDepth":2,"HasChildren":true,"ParentId":"PTIIADCO","DocOrderId":321,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PTIIADCO_CH205THCO_S205.11COSE","Heading":"Sec. 205.11. - County Seal.","NodeDepth":3,"HasChildren":false,"ParentId":"PTIIADCO_CH205THCO","DocOrderId":323,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}