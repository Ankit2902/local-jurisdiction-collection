    "content": {
      "Docs": [
        {
          "DocType": 1,
          "IsAmended": false,
          "IsUpdated": false,
          "CompareStatus": 4,
          "DocOrderId": 320,
          "AmendedBy": [],
          "Notes": [],
          "Drafts": [],
          "ChunkGroupStartingNodeId": "PTIIADCO_CH201SHTIGEDE",
          "NodeDepth": 3,
          "TitleHtml": "<div class=\"chunk-title\">Sec. 201.11. - Definitions.</div>",
          "ShouldShowMiniToc": false,
          "Id": "PTIIADCO_CH201SHTIGEDE_S201.11DE",
          "Title": "Sec. 201.11. - Definitions.",
          "Content": "<div class=\"chunk-content\">\n            <p class=\"incr0\">\n               1.\n               </p>\n            \t\t\n            <p class=\"content1\">\n               Wherever used in this act, unless otherwise expressly stated, or unless the context\n               or subject matter otherwise requires:\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               a.\n               </p>\n            \t\t\n            <p class=\"content2\">\n               The term \"county\" shall mean the County of Westchester.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               b.\n               </p>\n            \t\t\n            <p class=\"content2\">\n               The term \"Charter\" and \"County Charter\" shall mean the form of government for the\n               County of Westchester adopted November 2, 1937, pursuant to Chapter 617 of the Laws\n               of 1937, as amended.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               c.\n               </p>\n            \t\t\n            <p class=\"content2\">\n               The term \"County Board\" shall mean the Board of Supervisors of the County of Westchester\n               as now existing, or other legislative governing body of the county hereafter created.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               d.\n               </p>\n            \t\t\n            <p class=\"content2\">\n               The term \"municipal corporation\" or \"municipality\" shall mean or include the towns,\n               villages, cities and/or districts contained in the county as the context requires.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               e.\n               </p>\n            \t\t\n            <p class=\"content2\">\n               The terms \"real property\", \"real estate\", \"land\" and \"property\" shall be construed\n               to signify and embrace all lands, improvements, structures, works and any facilities\n               in, over or under the same and/or rights derived therefrom, or appurtenant thereto,\n               including all rights and interests therein other or less than a fee title.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               f.\n               </p>\n            \t\t\n            <p class=\"content2\">\n               The term \"person\" includes a natural person and also a public or private corporation,\n               the state and a political subdivision thereof, and any association, authority, commission,\n               board, board of managers or trustees in charge of or having control of any of the\n               charitable or other institutions of the state.\n               </p>\n            \t\t\n            <p class=\"incr1\">\n               g.\n               </p>\n            \t\t\n            <p class=\"content2\">\n               The term \"public purpose\" or \"county purpose\" shall mean and include the term \"public\n               use.\"\n               </p>\n            \t\t\n            <p class=\"incr0\">\n               2.\n               </p>\n            \t\t\n            <p class=\"content1\">\n               All words and phrases contained in this act are used according to their accepted and\n               ordinary meaning except where another meaning is specifically indicated or manifest.\n               Words used in the singular number shall extend to and include the plural number, and\n               words used in the plural number shall extend to and include the singular number. Words\n               used in the masculine gender shall extend to and include the feminine.\n               </p>\n            \t\t\n            <p class=\"historynote0\">\n               (§ 2 of the Laws of 1948, Ch. 852)\n               </p></div>",
          "SortDate": null,
          "Footnotes": null
        }
      ],
