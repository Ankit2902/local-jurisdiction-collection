          "Content": "<div class=\"chunk-content\">\n            <p class=\"incr0\">\n               (a)\n               </p>\n            \t\t\n            <p class=\"content1\">\n               The minimum size of parking spaces and access aisles, in feet, shall be as follows:\n               </p>\n            \t\t\n            <div>\n               <div class=\"\" style=\"width:100%\">\n                  <table class=\"thead1 table b1 \" cellpadding=\"3\" cellspacing=\"0\" border=\"1\" rules=\"all\">\n                     <colgroup class=\"std\">\n                        <col width=\"12.5%\">\n                        <col width=\"12.5%\">\n                        <col width=\"12.5%\">\n                        <col width=\"12.5%\">\n                        <col width=\"12.5%\">\n                        <col width=\"12.5%\">\n                        <col width=\"12.5%\">\n                        <col width=\"12.5%\">\n                     </colgroup>\n                     <tbody>\n                        <tr>\n                           <td class=\" top \">\n                              <span class=\"ital\">Category</span>\n                              </td>\n                           <td class=\" top \">\n                              <span class=\"ital\">Stall Width</span>\n                              </td>\n                           <td class=\" top \">\n                              <span class=\"ital\">(A) Stall Width Parallel to Aisle</span>\n                              </td>\n                           <td class=\" top \">\n                              <span class=\"ital\">(B) Stall Depth to Wall</span>\n                              </td>\n                           <td class=\" top \">\n                              <span class=\"ital\">(C) Stall Depth to Interlock</span>\n                              </td>\n                           <td class=\" top \">\n                              <span class=\"ital\">(D) Aisle Width</span>\n                