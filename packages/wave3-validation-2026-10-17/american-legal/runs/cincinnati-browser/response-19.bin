{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":121,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"THADCO_ARTIGE","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 2. - Designation to Perform Duties Where Office Title Discontinued.</div>","ShouldShowMiniToc":false,"Id":"THADCO_ARTIGE_S2DEPEDUWHOFTIDI","Title":"Sec. 2. - Designation to Perform Duties Where Office Title Discontinued.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               Whenever in the ordinances of the city of Cincinnati it is provided that anything\n               shall be done by an officer therein designated by a title which no longer exists as\n               used therein, the duty or authority to do such thing shall rest upon such officer\n               as may be designated by ordinance or by order of the city manager as the successor\n               in such duty or authority of the officer originally referred to.\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"THADCO_ARTIGE_S1PRAPOF","Heading":"Sec. 1. - Principal Appointive Officers.","NodeDepth":3,"HasChildren":false,"ParentId":"THADCO_ARTIGE","DocOrderId":120,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"THADCO_ARTIGE_S3ADORDE","Heading":"Sec. 3. - Administrative Organization of Departments.","NodeDepth":3,"HasChildren":false,"ParentId":"THADCO_ARTIGE","DocOrderId":122,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}