          "ShouldShowMiniToc": false,
          "Id": "THADCO_ARTIGE_S1PRAPOF",
          "Title": "Sec. 1. - Principal Appointive Officers.",
          "Content": "<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The city manager, the assistant city managers, the city solicitor and the police chief\n               shall be the principal appointive executive officers as contemplated by Sections 124.11\n               and 733.68 of the Ohio Revised Code.\n               </p>\n            <p class=\"historynote0\">\n               (Repealed and reordained by Ord. No. 183-1981, eff. June 12, 1981; a. Ord. No. 103-2003,\n               § 1, eff. April 9, 2003; Emer. Ord. No. 0006-2015, § 1, eff. Jan. 14, 2015)\n               </p></div>",
          "SortDate": null,
          "Footnotes": null
        }
