{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":120,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"THADCO_ARTIGE","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Sec. 1. - Principal Appointive Officers.</div>","ShouldShowMiniToc":false,"Id":"THADCO_ARTIGE_S1PRAPOF","Title":"Sec. 1. - Principal Appointive Officers.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The city manager, the assistant city managers, the city solicitor and the police chief\n               shall be the principal appointive executive officers as contemplated by Sections 124.11\n               and 733.68 of the Ohio Revised Code.\n               </p>\n            <p class=\"historynote0\">\n               (Repealed and reordained by Ord. No. 183-1981, eff. June 12, 1981; a. Ord. No. 103-2003,\n               § 1, eff. April 9, 2003; Emer. Ord. No. 0006-2015, § 1, eff. Jan. 14, 2015)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"THADCO_ARTIGE","Heading":"ARTICLE I. - GENERAL","NodeDepth":2,"HasChildren":true,"ParentId":"THADCO","DocOrderId":119,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"THADCO_ARTIGE_S2DEPEDUWHOFTIDI","Heading":"Sec. 2. - Designation to Perform Duties Where Office Title Discontinued.","NodeDepth":3,"HasChildren":false,"ParentId":"THADCO_ARTIGE","DocOrderId":121,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}