{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":8,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"FACOCO_CH1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Section 1-1-3. - Acts by deputy or designee.</div>","ShouldShowMiniToc":false,"Id":"FACOCO_CH1GEPR_ART1GEPR_S1-1-3ACDEDE","Title":"Section 1-1-3. - Acts by deputy or designee.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               Whenever a power is granted to or a duty is imposed upon a public officer or employee,\n               the power may be performed by any authorized deputy or designee or by any person duly\n               authorized, unless this Code expressly provides otherwise.\n               </p>\n            <p class=\"historynote0\">\n               (1976.)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"FACOCO_CH1GEPR_ART1GEPR_S1-1-2DERUCO","Heading":"Section 1-1-2. - Definitions and rules of construction.","NodeDepth":3,"HasChildren":false,"ParentId":"FACOCO_CH1GEPR_ART1GEPR","DocOrderId":7,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"FACOCO_CH1GEPR_ART1GEPR_S1-1-4COPRCOEXOR","Heading":"Section 1-1-4. - Code provisions as continuance of existing ordinances.","NodeDepth":3,"HasChildren":false,"ParentId":"FACOCO_CH1GEPR_ART1GEPR","DocOrderId":9,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}