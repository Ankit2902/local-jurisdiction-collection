{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":6,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"FACOCO_CH1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">Section 1-1-1. - Designation and citation of Code.<sup>[1]</sup></div>","ShouldShowMiniToc":false,"Id":"FACOCO_CH1GEPR_ART1GEPR_S1-1-1DECICO","Title":"Section 1-1-1. - Designation and citation of Code.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The provisions embraced in this and following Chapters, Articles and Sections shall\n               constitute and be designated \"The Code of the County of Fairfax, Virginia, 1976\" and\n               may be so cited. The Code may also be cited as the \"County Code\" or in the provisions\n               which follow, as \"This Code.\"\n               <sup>\n                  2\n                  </sup>\n               (1954 Code, vol. 1, § 1-1; 1961 Code, § 1-1.)\n<!-- fnLinkEnd = fn_2 -->\n<sup>[2]</sup>\n               \n               </p><div class=\"footnote-content\"><div style=\"font-weight:bold;\">Footnotes: </div> --- (<b>1</b>) ---\n            \n            <p class=\"refmanualFN\">\n               1. Editor's note: Fairfax County is governed under the Urban County Executive form\n               of government as set out in Va. Code Ann., Sec. 15.2-800 thru Sec. 15.2-858. The decision\n               to adopt this form was made by voters at referendum in the fall of 1966, and the change\n               became effective January 1, 1968.\n               </p>\n            <br> --- (<b>2</b>) ---\n            \n            <p class=\"refmanualFN\">\n               2. As to codification and recodification of ordinances generally, see Va. Code Ann.,\n               Sec. 15.2-1433.\n               </p>\n            <br></div></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"FACOCO_CH1GEPR_ART1GEPR","Heading":"ARTICLE 1. - General Provisions.","NodeDepth":2,"HasChildren":true,"ParentId":"FACOCO_CH1GEPR","DocOrderId":5,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"FACOCO_CH1GEPR_ART1GEPR_S1-1-2DERUCO","Heading":"Section 1-1-2. - Definitions and rules of construction.","NodeDepth":3,"HasChildren":false,"ParentId":"FACOCO_CH1GEPR_ART1GEPR","DocOrderId":7,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}