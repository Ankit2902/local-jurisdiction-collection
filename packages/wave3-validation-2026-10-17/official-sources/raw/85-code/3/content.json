{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":424,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"PTIICICO_CH1GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Sec. 1-3. - Provisions considered continuations of existing ordinances.</div>","ShouldShowMiniToc":false,"Id":"PTIICICO_CH1GEPR_S1-3PRCOCOEXOR","Title":"Sec. 1-3. - Provisions considered continuations of existing ordinances.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The provisions appearing in this Code, so far as they are the same as those of the\n               City Code and ordinances existing at the time of adoption of this Code, shall be considered\n               as a continuation thereof and not as new enactments.\n               </p>\n            <p class=\"historynote0\">\n               (Code 1986, § 1-3)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"PTIICICO_CH1GEPR_S1-2DERUCO","Heading":"Sec. 1-2. - Definitions and rules of construction.","NodeDepth":2,"HasChildren":false,"ParentId":"PTIICICO_CH1GEPR","DocOrderId":423,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"PTIICICO_CH1GEPR_S1-4CASE","Heading":"Sec. 1-4. - Catchlines of sections.","NodeDepth":2,"HasChildren":false,"ParentId":"PTIICICO_CH1GEPR","DocOrderId":425,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}