{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":370,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">1.01.010. - Code adopted.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1.01COAD_1.01.010COAD","Title":"1.01.010. - Code adopted.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The Code entitled \"Revised Code of the City of Saint Louis, 2020, Annotated\" published\n               by Municipal Code Corporation, consisting of Titles 1 through 26 is adopted. The Code\n               embraces ordinances of a general and permanent nature enacted on or before December\n               31, 2019. The Revised Code herein provided for shall also contain the Charter of the\n               City of St. Louis, as amended, the \"Scheme of Separation of the City of St. Louis\n               and the County of St. Louis,\" annotations, cross-reference tables to previous codes,\n               ordinance disposition tables, and index.\n               </p>\n            <p class=\"historynote0\">\n               (Ord. No. <a class=\"ordinance-link\" href=\"\" data-product-id=\"16330\" data-ordinance-id=\"1061489\">71259</a>, § 2, 12-18-2020.)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1.01COAD","Heading":"Chapter 1.01 - CODE ADOPTION","NodeDepth":2,"HasChildren":true,"ParentId":"TIT1GEPR","DocOrderId":369,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1.01COAD_1.01.020COKEREIS","Heading":"1.01.020 - Code kept by Register—Distribution.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01COAD","DocOrderId":371,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}