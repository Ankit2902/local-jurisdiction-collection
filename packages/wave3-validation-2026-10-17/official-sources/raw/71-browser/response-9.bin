{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":371,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT1GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">1.01.020 - Code kept by Register—Distribution.</div>","ShouldShowMiniToc":false,"Id":"TIT1GEPR_CH1.01COAD_1.01.020COKEREIS","Title":"1.01.020 - Code kept by Register—Distribution.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The new Revised Code of the City of Saint Louis, 2020, Annotated, as herein adopted,\n               shall be kept in the Office of the Register of the City of Saint Louis, as a part\n               of the ordinance codified in this chapter and there kept for public record as provided\n               for ordinances of the City; and copies of such code that shall have been printed on\n               authority of the City of Saint Louis, shall be kept by the Register and distributed\n               according to law, and attested as such according to RSMo 82.200, by authentication\n               of the Register, and bear the Seal of the City of Saint Louis.\n               </p>\n            <p class=\"historynote0\">\n               (Ord. No. <a class=\"ordinance-link\" href=\"\" data-product-id=\"16330\" data-ordinance-id=\"1061489\">71259</a>, § 2, 12-18-2020.)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT1GEPR_CH1.01COAD_1.01.010COAD","Heading":"1.01.010. - Code adopted.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01COAD","DocOrderId":370,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT1GEPR_CH1.01COAD_1.01.030COPRORFFAD","Heading":"1.01.030 - Code as proof of ordinances—Effect of adoption.","NodeDepth":3,"HasChildren":false,"ParentId":"TIT1GEPR_CH1.01COAD","DocOrderId":372,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}