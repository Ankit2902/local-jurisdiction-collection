    <div id="mainContent">
      <h2 class="CH"><a name="6.06"></a>CHAPTER 6-06<br />LITTERING</h2>
            <p class="digCH">SECTIONS:</p>

            <p class="CiteTOC"><a href="../Flagstaff06/Flagstaff0606000.html#6.06.001.0001">6-06-001-0001</a>&nbsp;&nbsp;&nbsp;&nbsp;DEFINITIONS:</p>

