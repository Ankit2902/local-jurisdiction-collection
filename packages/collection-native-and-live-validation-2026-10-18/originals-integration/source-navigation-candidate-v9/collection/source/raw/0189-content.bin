        <tr>
          <td style="border-bottom: 1px solid #000000; border-left: 1px solid #000000; border-right: 0px; border-top: 1px solid #000000; padding: 3pt 2pt 2pt 2.5pt; vertical-align: top; width: 21.2776pt">
