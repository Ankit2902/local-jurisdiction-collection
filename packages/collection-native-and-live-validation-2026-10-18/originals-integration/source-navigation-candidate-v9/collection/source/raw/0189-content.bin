          <td style="background-color: transparent; border-bottom: 1px solid #000000; border-left: 0px; border-right: 0px; border-top: 1px solid #000000; padding: 3pt 2pt 2pt 2pt; vertical-align: top; width: 76.9042pt" rowspan="2">
                        <p class="CellBody">2 stories min.; 5 stories max.</p>

          </td>
          <td style="background-color: transparent; border-bottom: 1px solid #000000; border-left: 0px; border-right: 0px; border-top: 1px solid #000000; padding: 3pt 2pt 2pt 2pt; vertical-align: middle; width: 11.8153pt" rowspan="2">
                        <p class="CellBodyC"><img class="Default" src="../images/flagstaff104040.159.1.116.272126.jpg" width="15" height="17"  alt="" title="" /></p>

