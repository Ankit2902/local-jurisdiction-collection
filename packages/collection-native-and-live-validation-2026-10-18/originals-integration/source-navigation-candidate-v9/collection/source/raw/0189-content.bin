      <table class="header1" style="border:1px solid black; margin-bottom: 6.0pt; margin-left: 0.0pt; margin-top: 6.0pt; text-align: right; width: 229.0974pt" cellspacing="0" summary="">
     <thead>
        <tr>
          <th style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top; width: 229.0974pt" colspan="2">
                        <p class="CellBodyBold"><span class="bold">Key</span></p>

          </th>
        </tr>
     </thead>
     <tbody>
        <tr>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top; width: 39.5481pt">
                        <p class="CellBody">P</p>

          </td>
          <td style="border: 1px solid black; padding: 4pt 2pt 2pt 3pt; vertical-align: top; width: 189.5493pt">
                        <p class="CellBody">Permitted Use</p>

          </td>
        </tr>
        <tr>
