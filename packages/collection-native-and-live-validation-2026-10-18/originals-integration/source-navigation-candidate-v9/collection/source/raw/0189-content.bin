                        <p class="CellBody">&nbsp;</p>

          </td>
        </tr>
        <tr>
          <td style="border-bottom: 0px; border-left: 0px; border-right: 0px; border-top: 0px; padding: 3pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyP2">Property Line</p>

          </td>
          <td style="border-bottom: 0px; border-left: 0px; border-right: 0px; border-top: 0px; padding: 3pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">0&#39; max.</p>

          </td>
          <td style="background-color: transparent; border-bottom: 0px; border-left: 0px; border-right: 0px; border-top: 0px; padding: 3pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC">&nbsp;</p>

          </td>
          <td style="border-bottom: 0px; border-left: 0px; border-right: 0px; border-top: 0px; padding: 3pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyP2">&le; 2,000 sf</p>

          </td>
          <td style="border-bottom: 0px; border-left: 0px; border-right: 0px; border-top: 0px; padding: 3pt 2pt 2pt 3pt; vertical-align: top" colspan="2">
                        <p class="CellBody">No spaces required</p>

          </td>
        </tr>
        <tr>
          <td style="border-bottom: 1px solid #000000; border-left: 0px; border-right: 0px; border-top: 0px; padding: 3pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyP2">Rear Lane or Alley</p>

          </td>
          <td style="border-bottom: 1px solid #000000; border-left: 0px; border-right: 0px; border-top: 0px; padding: 3pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBody">3&#39; max.</p>

          </td>
          <td style="background-color: transparent; border-bottom: 0px; border-left: 0px; border-right: 0px; border-top: 0px; padding: 3pt 2pt 2pt 3pt; vertical-align: top">
                        <p class="CellBodyC">&nbsp;</p>

