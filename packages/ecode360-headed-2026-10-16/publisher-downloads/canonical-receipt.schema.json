{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline canonical receipt for an actual publisher-generated download",
  "type": "object",
  "required": [
    "source_url",
    "jurisdiction",
    "publication",
    "selection_scope",
    "retrieved_at",
    "artifact_kind",
    "acquisition_mode",
    "edition_evidence",
    "artifact_sha256",
    "artifact_bytes",
    "upstream_receipt_path",
    "upstream_receipt_sha256",
    "acquisition_script_path",
    "acquisition_script_sha256",
    "download_status",
    "selected_citations"
  ],
  "properties": {
    "source_url": {
      "type": "string",
      "description": "Actual observed HTTPS publisher source/action URL, without credentials; no constructed endpoint."
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "publication": {
      "type": "string",
      "minLength": 1
    },
    "selection_scope": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifact_kind": {
      "const": "publisher-export"
    },
    "acquisition_mode": {
      "enum": [
        "unattended-standalone",
        "operator-browser-download",
        "retained-replay"
      ]
    },
    "edition_evidence": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "upstream_receipt_path": {
      "type": "string",
      "description": "Local receipt path relative to this canonical receipt."
    },
    "upstream_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "acquisition_script_path": {
      "type": "string",
      "description": "Retained actual executed script, local path relative to this receipt."
    },
    "acquisition_script_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "download_status": {
      "const": "acquired"
    },
    "selected_citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "format": {
      "enum": [
        "pdf",
        "html",
        "txt",
        "rtf"
      ]
    },
    "sample_pdf_pages": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "currentness_check": {
      "type": "object",
      "properties": {
        "expected_export_text": {
          "type": "string"
        },
        "source_evidence": {
          "type": "string"
        }
      }
    },
    "selected_guid": {
      "type": "string",
      "description": "Required by export_selected_section.py to locate the independently compared source DOM body; not substituted into PDF text."
    }
  }
}
