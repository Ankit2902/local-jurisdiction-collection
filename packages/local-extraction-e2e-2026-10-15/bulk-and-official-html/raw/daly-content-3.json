{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":2109,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT17ZO_CH17.02GEPR","NodeDepth":2,"TitleHtml":"<div class=\"chunk-title\">Chapter 17.02 - GENERAL PROVISIONS</div>","ShouldShowMiniToc":false,"Id":"TIT17ZO_CH17.02GEPR","Title":"Chapter 17.02 - GENERAL PROVISIONS","Content":"<div class=\"chunk-content\"><br></div>","SortDate":null,"Footnotes":null},{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":2110,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT17ZO_CH17.02GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">17.02.010 - Adoption of zoning plan.</div>","ShouldShowMiniToc":false,"Id":"TIT17ZO_CH17.02GEPR_17.02.010ADZOPL","Title":"17.02.010 - Adoption of zoning plan.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               There is adopted a zoning plan for the city; said zoning plan being a section of the\n               master plan of the city.\n               </p>\n            <p class=\"historynote0\">\n               (Ord. 635 § 1, 1965)\n               </p></div>","SortDate":null,"Footnotes":null},{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":2111,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT17ZO_CH17.02GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">17.02.020 - Purpose.</div>","ShouldShowMiniToc":false,"Id":"TIT17ZO_CH17.02GEPR_17.02.020PU","Title":"17.02.020 - Purpose.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The purpose of this title is to provide for the systematic execution of the land use\n               element of the plan, for the physical development of the city, and to promote the\n               public health, safety, convenience and general welfare.\n               </p>\n            <p class=\"historynote0\">\n               (Ord. 635 § 2, 1965)\n               </p></div>","SortDate":null,"Footnotes":null},{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":2112,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"TIT17ZO_CH17.02GEPR","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">17.02.030 - Compliance.</div>","ShouldShowMiniToc":false,"Id":"TIT17ZO_CH17.02GEPR_17.02.030CO","Title":"17.02.030 - Compliance.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               No structure shall be erected, or land shall be used except as is specifically permitted\n               by the terms of this title. The erection, reconstruction, enlargement, alteration\n               or moving of any structure which does not meet the minimum requirements of this title,\n               shall constitute a violation of this title and shall be subject to all penalties and\n               processes applicable under the terms of this title.\n               </p>\n            <p class=\"historynote0\">\n               (Ord. 635 § 6, 1965)\n               </p></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"TIT17ZO","Heading":"Title 17 - ZONING","NodeDepth":1,"HasChildren":true,"ParentId":"16311","DocOrderId":2108,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"TIT17ZO_CH17.04DE","Heading":"Chapter 17.04 - DEFINITIONS","NodeDepth":2,"HasChildren":true,"ParentId":"TIT17ZO","DocOrderId":2113,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}