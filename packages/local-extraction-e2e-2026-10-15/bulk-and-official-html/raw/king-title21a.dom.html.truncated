  </td>
  <td width="144" valign="top" style="width:1.5in;border-top:none;border-left:none;
  border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0in 5.4pt 0in 5.4pt">
  <p class="MsoNormal"><span style="font-family:&quot;Arial&quot;,sans-serif">R-1</span></p>
  <p class="MsoNormal"><span style="font-family:&quot;Arial&quot;,sans-serif">RA</span></p>
  </td>
  <td width="324" valign="top" style="width:243.2pt;border-top:none;border-left:
  none;border-bottom:solid windowtext 1.0pt;border-right:double windowtext 2.25pt;
  padding:0in 5.4pt 0in 5.4pt">
  <p class="MsoNormal"><span style="font-family:&quot;Arial&quot;,sans-serif">Only in
  designated urban areas</span></p>
  <p class="MsoNormal"><span style="font-family:&quot;Arial&quot;,sans-serif">In areas not
  designated urban</span></p>
  </td>
 </tr>
 <tr>
  <td width="144" valign="top" style="width:107.8pt;border-top:none;border-left:
  double windowtext 2.25pt;border-bottom:solid windowtext 1.0pt;border-right:
  solid windowtext 1.0pt;padding:0in 5.4pt 0in 5.4pt">
  <p class="MsoNormal"><span style="font-family:&quot;Arial&quot;,sans-serif">SE, S-C</span></p>
  </td>
